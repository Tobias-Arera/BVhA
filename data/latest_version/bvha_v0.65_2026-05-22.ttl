  dct:modified "2021-01-22T16:11:42.000"^^xsd:dateTime;
  :broaderByFunction :c_4708d89a .

:c_59bd3f09 a skos:Concept;
  skos:definition "Hochhaus, allg. ein Haus mit mehr als fünf Geschossen, in den 1880er Jahren in den USA entwickelt für Bürohäuser (House-Insurance-Gebäude in Chicago ab 1883 von W.L. Lenney gebaut); in Europa erst nach 1918 als Bürohaus, seltener für Wohnhäuser, Hotels und Krankenhäuser, diese vermehrt erst seit den 1950er Jahren. Stahlrahmen- und Stahlbetonkonstruktionen mit vertikaler Erschließung durch Fahrstühle. Das H. ist entweder als Turm- bzw. Punkth. auf annähernd quadrat. Grundriss oder als Scheibenh. bis zu 300 m Länge gestaltet. Durch H.bebauung wird die Stadtsilhouette geprägt. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_c8a571d9;
  skos:prefLabel "skyscraper"@en, "maison élevée"@fr, "výšková stavba"@cs, "edificio multipiano"@it,
    "edificio alto"@es, "Hochhaus"@de;
  skos:broader :c_1c8ef562;
  skos:narrower :c_2fe0469b, :c_32d389b2;
  dct:created "2019-09-09T18:21:45.000"^^xsd:dateTime;
  dct:modified "2021-01-27T13:17:07.000"^^xsd:dateTime .

:c_2fe0469b a skos:Concept;
  skos:definition "Wolkenkratzer, ein Gebäude von überdurchschnittl. Höhe, ähnl. dem Hoch- bzw. Turmhaus. Die aus Amerika stammende Bezeichnung (Skyscraper) wird hauptsächl. für amerikan. Hochhäuser verwendet. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_c8a571d9;
  skos:prefLabel "gratte-ciel"@fr, "mrakodrap"@cs, "grattacielo"@it, "sky-scraper"@en,
    "rascacielos"@es, "Wolkenkratzer"@de;
  skos:broader :c_59bd3f09;
  dct:created "2019-09-11T13:46:12.000"^^xsd:dateTime;
  dct:modified "2021-01-26T23:15:49.000"^^xsd:dateTime .

:c_32d389b2 a skos:Concept;
  skos:definition "Ein moderner Wohnhaustyp, bei dem um ein zentrales Treppenhaus mehrere Wohnungen radial angeordnet sind. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
