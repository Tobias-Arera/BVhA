  dct:modified "2021-01-27T21:32:30.000"^^xsd:dateTime;
  :broaderByShape :c_b908427f .

:c_febc0478 a skos:Concept;
  skos:scopeNote "Altan, ein unterbauter, nicht überdeckter Austritt in einem Obergeschoss im Gegensatz zu dem auskragenden und überdeckten Erker. [Koepf / Binding 2016]"@de,
    "Balkon, bei dem die Stützen der Kragplatte auf dem Boden ruhen. [Koch 2009]"@de,
    "Altan, Altane, Söller, im Gegensatz zum frei vorkragenden Balkon ein bis zum Erdboden mit Säulen, Pfeilern oder Mauern unterbauter, mit einer Brüstung versehener hölzerner oder steinerner Austritt an oberen Etagen, teilweise in Verbindung mit Freitreppen. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_8c0441f9, :conceptScheme_1d7ba54b;
