:c_dec6f7ce a skos:Concept;
  skos:scopeNote "Ein Ereignis ist die konkrete, lokal wie temporal einzugrenzende Manifestation eines an sich abstrakten Vorgangs, einer Handlung oder eines Prozesses. Concepts unter \"Historisches Ereignis\" können als Instanzen für allgemeine Begriffe unter dem Top Concept \"Vorgang\" angesehen werden. So stellt das Concept „Wiederaufbau nach dem Zweiten Weltkrieg“ ein zeitlich wie räumlich klar zu fassendes historisches Ereignis dar, wohingegen das Concept „Wiederaufbau“ den allgemeinen Vorgang des Wiederaufbauens, der an unterschiedlichen Orten zu unterschiedlichen Zeitpunkten stattfinden kann, meint."@de;
  skos:inScheme :conceptScheme_7816b346;
  skos:prefLabel "Historisches Ereignis"@de;
  skos:broader :c_1672bfe8, :c_84a02e00;
  skos:narrower :c_040cf1b6, :c_4875764f, :c_d46f648c, :c_7ba78211, :c_cb3deaa3, :c_f203c4ff,
    :c_211aa3f8, :c_dl5bae0w, :c_ocrgmb3c;
  dct:created "2019-12-18T14:03:33.000"^^xsd:dateTime;
  dct:modified "2020-10-26T16:40:09.000"^^xsd:dateTime .

