:c_d1a705c6 a skos:Concept;
  skos:definition "Kasel f, Messgewand n, auch Planeta f, casula, (in vorkarolingischer Zeit auch) amphibalus: aus der römischen Paenula entstandener Mantel, bis zum 13. Jh. weit und lang und vorwiegend aus einfarbigem Stoff gefertigt (—> Glockenkasel); danach zunehmend schmaler geschnitten und im Ganzen verkürzt; etwa vom 16. Jh. an ein knielanger, seitlich offener Überwurf über Brust und Rücken, präzisierend auch als Skapulierkasel f bezeichnet; als Material werden meist Seide und andere kostbare Stoffe verwendet, daneben auch, vor allem in vorkarolingischer Zeit, Wolle und Leinen, im 18. Jh. vereinzelt Leder; die Kasel ist das eigentliche Messgewand und unterliegt dem Farbenkanon. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "chasuble"@en, "casula"@la, "Kasel"@de, "kázule"@cs, "chasuble"@fr;
  skos:altLabel "infula"@la, "Messgewand"@de, "Planeta"@de, "kasule"@cs, "planète"@fr,
    "amphibalus"@la, "paenula"@en;
  skos:broader :c_cb3125a1, :c_aa790c5e, :c_3e0c1197, :c_5f0a70dc, :c_581497e3;
  skos:narrower :c_eece1baa, :c_eb7449d1, :c_568d3fbb, :c_ba937f2d, :c_b5210b7d;
  skos:related :c_ef40cc12, :c_52e9e4b7, :c_c751b179, :c_c08338d7;
  dct:created "2020-03-03T13:52:36.000"^^xsd:dateTime;
  dct:modified "2021-01-24T17:53:42.000"^^xsd:dateTime .

:c_364933bc a skos:Concept;
  skos:definition "Manipel m und f, mappa, mappula, manipulus, fano: aus einem gefalteten römischen Etikettetuch entstandenes Ornatstück; ein schmaler Stoffstreifen (meist Seide) mit einem Kreuz in der Mitte und oft auch auf den verzierten Enden. Der Manipel wurde ursprünglich in der linken Hand, später um den linken Unterarm geschnürt getragen; er unterlag dem Farbenkanon und war liturgische Insignie der Geistlichen vom Subdiakon an; aufgrund der neueren Liturgie-Reform abgeschafft --> Stola. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "maniple"@en, "Manipel"@de, "manipul"@cs, "manipule"@fr, "mappa"@la;
  skos:altLabel "mappula"@la, "fano"@la, "fanon"@fr, "manipulus"@la;
  skos:broader :c_86c8b719, :c_cb3125a1, :c_aa790c5e, :c_0a18e053, :c_581497e3, :c_3dc28fc5;
  skos:narrower :c_0ed0c8e1;
  skos:related :c_9f74e321, :c_ef40cc12, :c_b41dc3bb, :c_00a23a75, :c_02a23ef2;
  dct:created "2020-03-03T13:54:04.000"^^xsd:dateTime;
  dct:modified "2021-01-24T17:45:19.000"^^xsd:dateTime .

:c_b41dc3bb a skos:Concept;
  skos:definition "Stola f, veraltet Orarium n: etwa 2,5 m langer, in der Mitte und oft an den Enden mit einem Kreuz bezeichneter Seiden- oder Leinenstreifen, dessen Enden oft durch Fransen oder Quasten geschmückt sind; die Stola ist liturgische Insignie der Diakone, Priester und Bischöfe und unterliegt dem Farbenkanon; --> Manipel. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "Stola"@de, "stole"@en, "štola"@cs, "étole"@fr, "orarium"@la;
  skos:altLabel "oraire"@fr, "tippet"@en, "Orarium"@de;
  skos:broader :c_aced96c4, :c_cb3125a1, :c_aa790c5e, :c_0a18e053, :c_581497e3;
  skos:narrower :c_a5cc62f1, :c_2f833bf7, :c_afa0418d, :c_3446b27e, :c_b1dec01f, :c_e44edb45,
    :c_1a6a67ee, :c_ca36b91a, :c_a805b939;
  skos:related :c_e3ddd266, :c_86c8b719, :c_9f74e321, :c_ef40cc12, :c_364933bc, :c_594edc09;
  dct:created "2020-03-03T13:54:26.000"^^xsd:dateTime;
  dct:modified "2021-01-24T17:45:59.000"^^xsd:dateTime .

:c_c529c13a a skos:Concept;
  skos:definition "Mitra f, Inful f, auch Bischofsmütze f, Infel f, infula: aus dem Phrygium entstandene pontifikale Kopfbedeckung; zunächst eine kegelförmige oder runde Haube mit Infulae und Zierbesatz am unteren Rand (mitra cum aurifrisio in circulo); im Laufe des 12. Jh. wird sie eingebuchtet, so dass sich zwei zunächst höckerartige, später  hörnerähnliche Seitenteile ausbilden, wobei die Vertiefung oft durch eine von vorn nach hinten verlaufende Zierborte betont wird (mitra cum aurifrisio in titulo); in der Folge wird die Mitra größer und so aufgesetzt, daß sich die zunächst dreieckigen, später schildförmigen Teile über der Stirn und dem Hinterkopf des Trägers erheben. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "mitre"@fr, "infula"@la, "Mitra"@de, "mitra"@cs, "mitre"@en;
  skos:altLabel "infule"@fr, "miter"@en, "Inful"@de, "Bischofsmütze"@de, "Infel"@de;
  skos:broader :c_cb3125a1, :c_aa790c5e, :c_64dd3656, :c_33612946;
  skos:narrower :c_262f7dbe, :c_e019cf31, :c_d96146d9, :c_b8248b61, :c_ba0426b4;
  skos:related :c_16b837ff, :c_444992fe, :c_ef40cc12, :c_465873a0, :c_952d41bc, :c_0502b606,
    :c_b22a4b85;
  dct:created "2020-03-03T16:05:57.000"^^xsd:dateTime;
  dct:modified "2021-01-23T13:45:12.000"^^xsd:dateTime .

:c_73a34358 a skos:Concept;
  skos:definition "Pontifikalhandschuhe m pl, Bischofshandschuhe m pl, auch Chirotecae f pl: ursprünglich aus Leinen, etwa vom 12. Jh. an aus Seide gefertigte Fingerhandschuhe, häufig mit weiten, verzierten Stulpen (manicalia); sie unterliegen dem Farbenkanon, sind jedoch nie schwarz. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "Pontifikalhandschuh"@de, "pontifikální rukavice"@cs, "gant pontifical"@fr,
    "manicae"@la, "pontifical glove"@en;
  skos:altLabel "gants épiscopaux"@fr, "chirotecae"@fr, "chirothecae"@en, "Bischofshandschuhe"@de,
    "Chirotecae"@de, "liturgischer Handschuh"@de, "Chirothek"@de, "chirotecae"@la, "wanti"@la;
  skos:broader :c_cb3125a1, :c_aa790c5e, :c_64dd3656, :c_a947dad3;
  skos:related :c_e3ddd266, :c_ef40cc12, :c_b059e4e2, :c_9c418238;
  dct:created "2020-03-03T16:07:00.000"^^xsd:dateTime;
  dct:modified "2021-01-23T13:48:18.000"^^xsd:dateTime .

:c_de98fc61 a skos:Concept;
  skos:definition "Pontifikalschuhe m pl, campagi, sandalia: zunächst sandalenartige, später geschlossene, oft mit Seide verarbeitete und mit einem Kreuz bestickte, pantoffelartige Schuhe des Bischofs; sie unterliegen dem Farbenkanon. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "sandale liturgique"@fr, "pontifical sandal"@en, "Pontifikalschuh"@de,
    "sandalia"@la;
  skos:altLabel "chaussure pontificale"@fr, "sandale pontificale"@fr, "campage pontifical"@fr,
    "mules f pl (pape)"@fr, "liturgical sandal"@en, "campagi"@la;
  skos:broader :c_cb3125a1, :c_aa790c5e, :c_64dd3656;
