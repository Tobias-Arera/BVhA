  dct:modified "2020-09-07T15:04:34.000"^^xsd:dateTime .

:c_df439cb0 a skos:Concept;
  skos:definition "Ebener, waagerechter, zumeist hölzerner Boden, der zum Aufschnüren von Zimmermanns- und Schreinerarbeiten in natürl. Größe dient. [Koepf / Binding 2016]"@de;
