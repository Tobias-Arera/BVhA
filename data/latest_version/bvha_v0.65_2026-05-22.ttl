:c_28ffc18a a skos:Concept;
  skos:definition "Řec. músa. Řecké bohyně ochraňující umění a vědy, v Aténách se původně uctívala pouze jedna Múza: Mnemosyne, bohyně paměti, později bylo devět Múz, které bývaly od dob helénismu zobrazovány se svými atributy: Erato (vážná milostná lyrika): kithara - Euterpe (hudba, lyrika): flétna - Kalliope (epika): kniha a svitek - Kleio (historie, filozofie, epika): svitek - Melpomene (tragédie): tragická maska - Polymnia (též Polyhymnia, píseň): bez atributu - Terpsichore (tanec): lyra -Thalia (též Thalie, komedie): komická maska - Urania (astronomie): glóbus. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_37522b74;
  skos:prefLabel "Muse (griechisch)"@de, "múza"@cs;
  skos:broader :c_8d64873c;
  skos:narrower :c_05acef64, :c_4669fb81, :c_d3743c5f, :c_c46287aa, :c_b2bdeff5, :c_d4558d8a,
    :c_abedfb8f, :c_8ec63f8a, :c_57c5fc72;
  dct:created "2020-08-11T10:19:58.000"^^xsd:dateTime;
  dct:modified "2021-01-21T11:30:35.000"^^xsd:dateTime .

