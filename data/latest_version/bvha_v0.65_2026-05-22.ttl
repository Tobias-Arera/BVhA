:c_44167bbe a skos:Concept;
  skos:definition "Gewölbe, das entsteht, wenn sich zwei oder mehrere Gewölbe kreuzen oder ineinander übergehen und dabei eine neue Form ausbiIden, z. B. das Kreuzgewölbe oder das Klostergewölbe. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "voûtes à intersections"@fr, "intersecting vaults"@en, "Durchdringungsgewölbe"@de,
    " klenba vzniklá průnikem různých klenebních útvarů "@cs;
  skos:altLabel "compound vault"@en, "voûtes à penetrations"@fr;
  skos:broader :c_049c4c22;
