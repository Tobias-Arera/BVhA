:c_109ebb52 a skos:Concept;
  skos:definition "Senkrechte Bleisprosse. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Bleihöhensprosse"@de;
  skos:broader :c_be713e0d;
