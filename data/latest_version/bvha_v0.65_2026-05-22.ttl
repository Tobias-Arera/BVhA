  skos:definition "Bogenstellung im Obergeschoss einer Kirche, oft mit dahinterliegendem Gang. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
