  skos:broader :c_a2025113;
  dct:created "2019-02-18T18:22:31.000"^^xsd:dateTime;
  dct:modified "2021-01-22T13:32:32.000"^^xsd:dateTime .

:c_40fd9bd2 a skos:Concept;
  skos:definition "Ein seitl. der Apsis oder des Chors am Übergang zum Chorjoch auf jeder Seite beigestellter Turm, zumeist quadrat., aber auch rund, seit Anfang des 11. Jhs. bekannt, bes. bei den stauf. Kirchen im Rheinland. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "Chorflankenturm"@de, "chórová flankovací věž"@cs;
  skos:broader :c_56d01309;
  dct:created "2019-02-18T18:22:46.000"^^xsd:dateTime;
