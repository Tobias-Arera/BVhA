:c_d0d83a5e a skos:Concept;
  skos:definition "Kelchlöffelchen, ein Löffelchen zur Entnahme des dem Wein beizufügenden Wassers. [RDK Labor]"@de,
    "Kelchlöffelchen n; heiliger Löffel m; Cochlearium n (lat.): ein langstieliger, meist siIbervergoldeter Löffel, mit dem bei der Messe dem Messwein einige Tropfen Wasser beigefügt werden. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd, :conceptScheme_cf792a3c;
  skos:prefLabel "Kelchlöffel"@de, "lžička"@cs, "cuiller eucharistique"@fr, "cochlear"@la,
    "eucharistic spoon "@en;
