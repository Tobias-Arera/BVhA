:c_4e8b5931 a skos:Concept;
  skos:definition "Durch Beimengung von Gerberlohe, die beim Brennen Hohlräume hinterlässt, bes. leichter Backstein, in der Gotik für Gewölbe verwendet. [Koch 2009]"@de,
    "Velmi lehká cihla, vzniklá přimísením koželužského třísla, které při vypalování zanechává dutiny, používaná v gotice ke stavbu klenby. [Koch 2008]"@cs,
    "Lohstein, got. Gewölbestein aus gebranntem Ton (Backstein), bes. leicht durch Beimengung von Gerberlohe, die durch den Brennvorgang zerstört wird und dadurch Hohlräume entstehen lässt. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel " brique tanisée"@fr, "tříslová cihla"@cs, "perforated brick"@en, "pietra artificialmente porosa"@it,
    " ladrillo artificialmente poroso"@es, "Lohstein"@de;
  skos:broader :c_1aa7935c;
  dct:created "2019-08-19T13:35:12.000"^^xsd:dateTime;
  dct:modified "2021-03-19T18:30:44.000"^^xsd:dateTime .

