:c_a80d827a a skos:Concept;
  skos:definition "Řezná plocha, která vznikne, jestliže se okno vyříz­ne šikmo do zdi. [Koch 2008]"@cs,
    "Schnittfläche, die entsteht, wenn ein Fenster oder Portal schräg in die Wand geschnitten wird. Durch senkrechten Einschnitt entsteht eine Laibung (Leibung). Das romanische und gotische Gewändeportal ist oft reich verziert und mit Gewändefiguren ausgestattet. [Koch 2009]"@de,
    "Die schräg geführte Mauerfläche (Laibung) seitl. eines Fensters (Fensterschräge) oder Portals. Das G. kann profiliert sein (Stab, Hohlkehle), manchmal stehen in den Abtreppungen des G.s auch Säulen oder Skulpturen (Stufenportal). [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "Gewände"@de, "šikmé ostění"@cs;
  skos:broader :c_e46f17d9;
  skos:narrower :c_0a9d9ee3, :c_20f05fbb, :c_6d7e4f14;
  skos:related :c_4badff1b;
  dct:created "2020-03-16T14:56:51.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:34:16.000"^^xsd:dateTime .

