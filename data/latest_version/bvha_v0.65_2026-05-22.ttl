:c_808d370a a skos:Concept;
  skos:scopeNote "Beim Antwerpener Schema schließen Schrein und Retabelflügel auf einer Höhe ab. Der Schrein verfügt über einen Fries. [Gliesmann 2011]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_9fcb19ed;
