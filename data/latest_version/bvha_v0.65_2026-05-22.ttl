:c_59332eac a skos:Concept;
  skos:definition "Nischenartiger, meist offener oder nur durch einen Vorhang abgetrennter fensterloser Nebenraum eines Hauptraumes, der meist zur Aufstellung eines Bettes dient. [Schrader / Voigt 2003]"@de,
    "ALKOVNA (arab. al kubbe = klenba, dutina), přístěnek bez oken, většinou jako místo na spaní. [Koch 2008]"@cs,
    "Alkoven (arab. al-qobbah = Gewölbe, das Hohle), fensterlose Raumnische, meist als Schlafstelle. [Koch 2009]"@de,
    "Alkoven (span. alcoba, nach arab. al kubbe: das Hohle), durch eine große Wandöffnung mit dem Wohnraum verbundener, kleiner, fensterloser Nebenraum, in dem das Bett steht. Die aus dem arab. Wohnhaus stammende Anordnung kam über Spanien, wie der Name, seit der Mitte des 17. Jhs. in fast allen europ. Ländern in Gebrauch. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_c8a571d9, :conceptScheme_37522b74, :conceptScheme_8c0441f9, :conceptScheme_5bf6bcac;
  skos:prefLabel "Alkoven"@de, "alkovna"@cs;
  skos:broader :c_bfa40c59;
  dct:created "2020-08-03T09:59:48.000"^^xsd:dateTime;
  dct:modified "2021-01-27T01:27:02.000"^^xsd:dateTime .

:c_e7c93cea a skos:Concept;
  skos:definition "Okrasná nika předstírající další vedení otvoru (okno aj.) v řadě (např. románská horní okenní stěna). [Koch 2008]"@cs,
    "Ziernische, täuscht die Weiterführung einer Öffnung (Fenster o. ä.) in einer Reihe vor (z. B. romanischer Obergaden). [Koch 2009]"@de,
    "Blendnische, eine Nische, die durch die Mauerstruktur oder durch Art und Farbe des Steinmaterials stärker betont wird. Die B. kommt hauptsächl. in spätroman. Zeit vor. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_c8a571d9, :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "Blendnische"@de, "slepá nika"@cs;
  skos:broader :c_bfa40c59;
  dct:created "2020-08-03T15:46:34.000"^^xsd:dateTime;
  dct:modified "2021-01-27T01:27:46.000"^^xsd:dateTime .

