:c_3ffe9d93 a skos:Concept;
  skos:definition "Bußkapelle, kleine, meist rechteckige Kapelle an der O.-Seite des Querschiffs (Querhauskapelle) oder Chors einer Zisterzienserkirche, bestimmt für die Bußübungen der Mönche. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
