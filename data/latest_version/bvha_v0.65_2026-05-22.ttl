  dct:modified "2021-01-25T16:29:41.000"^^xsd:dateTime .

:c_e8b8196b a skos:Concept;
  skos:definition "Custodia f (lat.): eine spanische Sonderform der Monstranz, ein oft mehrgeschossiges, turmartiges Gehäuse, eine Art Sakramentshaus, das in einer festen Kapsel oder tragbarem Gerät verborgen ist und bei Prozessionen auf einem Wagen mitgeführt wird. Beispiel: die 3,33m hohe silberne Custodia der Kathedrale von Sevilla. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_cf792a3c;
  skos:prefLabel "ostensoir monumental"@fr, "monumental monstrance"@en, "Custodia (eucharistische Monstranz)"@de;
