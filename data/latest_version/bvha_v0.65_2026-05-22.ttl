:c_79461992 a skos:Concept;
  skos:definition "Schub, Seitenschub, horizontale Komponente eines Kraftverlaufs innerhalb des Mauerwerks, der durch Gewölbe oder Dachkonstruktionen hervorgerufen wird. Man begegnet dem S. durch Verstärkung des Mauerwerks oder im Innenraum durch Anordnen von Ankern. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_84fc24e6;
  skos:prefLabel "poussée"@fr, "smyk"@cs, "spinta"@it, "push"@en, "empuje"@es, "Schub"@de;
