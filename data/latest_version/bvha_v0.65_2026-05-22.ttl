:c_caa7efac a skos:Concept;
  skos:definition "Eine mit dem Stockhammer ausgeführte Oberflächenbearbeitung. [BVHA]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ef0a8695, :conceptScheme_f10222e0;
