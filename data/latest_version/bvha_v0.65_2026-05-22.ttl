:c_9b45ab52 a skos:Concept;
  skos:definition "Ein aus Werksteinen (Quadersteinen) bestehendes Mauerwerk. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
