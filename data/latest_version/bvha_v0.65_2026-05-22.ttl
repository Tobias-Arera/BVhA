:c_e7f71aca a skos:Concept;
  skos:definition "Mastaba mit abgestuftem Baukörper. Der Grundriss der S. ist im Gegensatz zu dem einer Stufenpyramide rechteckig. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "pyramide à gradins"@fr, "Stufenmastaba"@de, "mastaba escalonada"@es,
    "mastaba a gradini"@it, "stepped mastaba"@en;
  skos:broader :c_9c6b2b51;
  dct:created "2020-08-11T13:17:19.000"^^xsd:dateTime;
  dct:modified "2021-01-12T17:01:45.000"^^xsd:dateTime .

:c_5ba5763a a skos:Concept;
  skos:definition "Englischer Stil zu den Regierungszeiten des Königs Wilhelm von Oranien, 1689-1702, und der Königin Anne, 1702-14. [Koch 2009]"@de,
    "Anglický sloh za vlády krále Viléma III. Oranžského (1689-1702) a královny Anny Stuartovny (1702-14). [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9;
  skos:prefLabel "Queen Anne style"@de, "Queen Anne style"@cs;
  skos:broader :c_6uazz5qx;
  dct:created "2020-08-11T14:05:38.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:15:08.000"^^xsd:dateTime .

:c_cb5d8135 a skos:Concept;
  skos:definition "Stuckdekoration islamischer Herkunft als Sgraffito oder in der Form von Stalaktiten. Manchmal bemalt. [Koch 2009]"@de,
    "Štukový dekor islámského původu jako sgrafito, nebo ve tvaru stalaktitů, často zdobeno malbou. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9;
  skos:prefLabel "Yeseria"@de, "yesería"@cs;
  skos:broader :c_2b831ad9;
  dct:created "2020-08-12T10:33:11.000"^^xsd:dateTime;
  dct:modified "2021-01-25T13:42:41.000"^^xsd:dateTime .

:c_569be6c1 a skos:Concept;
  skos:definition "Rolandsäule, vom 14. bis 18. Jh. etwa zwischen Weser und Prag, südlich bis Dubrovnik verbreitete Bildsäule aus Holz oder Stein auf dem städtischen Hauptplatz. Stellt einen Ritter, im Barock einen römischen Krieger mit aufrecht gehaltenem Schwert dar. Vermutlich Symbol der städtischen Gerechtsame. [Koch 2009]"@de,
    "Rolandův sloup, dřevěná nebo kamenná socha umístěná na hlavním náměstí města, rozšířená od 14. do 18. stol. v oblastech mezi řekou Vezerou a Prahou, na jihu až k Dubrovníku; představuje rytíře, v baroku římského vojáka s taseným mečem, patrně symbol městských privilegií. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9;
  skos:prefLabel "Rolandsäule"@de, "roland"@cs;
  skos:altLabel "Roland"@de;
  skos:broader :c_9278284e;
  dct:created "2020-08-11T14:27:02.000"^^xsd:dateTime;
  dct:modified "2020-09-05T18:37:02.000"^^xsd:dateTime .

:c_193ae91f a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe;
  skos:prefLabel "Wirbelrosette"@de, "vířivá rozeta"@cs;
  skos:broader :c_66851976;
  dct:created "2020-08-12T10:32:05.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:06:15.000"^^xsd:dateTime .

:c_d3ef3b6b a skos:Concept;
  skos:definition "Beliebtes Ziermotiv an Fachwerkbauten der dt. Renaissance in Form einer Halbkreisscheibe, die mit einer halben Rosette bzw. mit einer verschiedenfarbigen, fächerartig gefalteten Innengliederung gefüllt ist und meist in der Zone der Fußstreben vorkommt; erstmals um 1530 im Harzgebiet nachgewiesen. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "Fächerrosette"@de;
  skos:broader :c_66851976;
  dct:created "2020-09-08T14:56:37.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:06:06.000"^^xsd:dateTime .

:c_e2da6bd0 a skos:Concept;
  skos:definition "Die geistige Haltung in den germanischen Ländern in der 1. Hälfte des 19. Jhs., die dem rational gerichteten Klassizismus eine oft schwärmerische Natur- und Gefühlsbetonung entgegensetzt. Sie bringt keinen eigenen umfassenden Kunststil zustande. Ihre Begeisterung für die Geschichte versucht ohne Glück, vergangene Architektur-Stile neu zu beleben (Historismus). [Koch 2009]"@de,
    "Kulturní směr první poloviny 19. stol., který proti racionálně zaměřeného klasicismu staví často až vášnivé zdůrazňování přírody a citů; nevytvořil žádný vlastní celkový umělecký sloh, jeho nadšení pro historii vyústilo v neúspěšné pokusy o oživení historických architektonických slohů (viz historismus). [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9;
  skos:prefLabel "Romantik"@de, "romantismus"@cs;
  skos:broader :c_66eeb4d6;
  skos:related :c_qojdlphd;
  dct:created "2020-08-11T15:29:49.000"^^xsd:dateTime;
  dct:modified "2021-01-15T15:31:52.000"^^xsd:dateTime .

:c_b2ca74b2 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8;
  skos:prefLabel "Deutscher Werkbund"@de;
  skos:broader :c_66eeb4d6;
  dct:created "2020-08-11T14:46:18.000"^^xsd:dateTime;
