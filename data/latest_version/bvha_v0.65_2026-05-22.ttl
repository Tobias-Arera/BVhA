:c_aff6afbf a skos:Concept;
  skos:definition "Kurzform für einen Allesbrand-Dauerbrand- Ofen, der die Verbrennung sämtlicher festen Brennstoffe ermöglicht. [Schrader / Voigt 2003]"@de,
    "Jeder Ofen, der die Verbrennung sämtlicher festen, im Hausbrand üblichen Brennstoffe mit gutem Wirkungsgrad ermöglicht. Dies sind insbesondere Steinkohle und Briketts, aber auch Torf und Holz. [Schrader / Voigt 2003]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_5bf6bcac;
  skos:prefLabel "Allesbrand-Dauerbrand-Ofen"@de;
  skos:altLabel "Allesbrenner"@de;
  skos:broader :c_808e8e8b;
  dct:created "2020-11-20T16:34:08.000"^^xsd:dateTime;
  dct:modified "2021-01-31T00:41:13.000"^^xsd:dateTime .

