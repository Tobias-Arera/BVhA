:c_417da9ae a skos:Concept;
  skos:definition "Gewölbe mit vorwiegend dekorativer Form, figurierte Gewölbe wie Netz-/Flechtrippengewölbe unter Verwendung von Zierrippen, die keine tragende Funktion haben, vorwiegend in der Spätgotik verwandt. [Koepf / Binding 2016]"@de,
    "Složitější klenební obrazce jsou klenby, jeiichž žebra vytvářejí obrazce (hvězdové a síťové klenby pozdní gotiky). Žebra hvězdové (též hvězdicové) klenby vytvářejí hvězdicovité obrazce. Rozdělení polí zůstává zachováno. Zrušením rozdělení na jednotlivá klenební pole vznikají řady. [Koch 2008]"@cs,
    "Gewölbe mit reicher dekorativer Ausgestaltung. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_37522b74, :conceptScheme_1f14b4dd;
  skos:prefLabel "Ziergewölbe"@de, "bóveda ornamental"@es, "složitější klenební obrazec"@cs,
    "voûte décorative"@fr, "ornamental vault"@en;
  skos:altLabel "decorative vault"@en, "voûte à trace décoratif "@fr, "voûte ornamentale"@fr,
    "figuriertes Gewölbe"@de;
  skos:broader :c_049c4c22;
  skos:narrower :c_ec52d929;
  dct:created "2019-12-10T15:10:47.000"^^xsd:dateTime;
  dct:modified "2021-01-19T13:13:27.000"^^xsd:dateTime;
  :broaderByShape :c_049c4c22 .

:c_ec52d929 a skos:Concept;
  skos:definition "Gewölbe mit dekorativen, der Leibung aufgelegten, nicht tragenden Rippen, die ein geometrisches oder auch pflanzliches Muster ausbilden, z. B. Ziersterne. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "lierne vault"@en, "voûte à nervures décoratives"@fr, "Zierrippengewölbe"@de;
  skos:altLabel "vault with ribs largely non-structural"@en;
  skos:broader :c_417da9ae;
  skos:narrower :c_7115f1d1, :c_d958e410;
  dct:created "2019-12-10T15:15:42.000"^^xsd:dateTime;
  dct:modified "2020-04-22T14:18:04.000"^^xsd:dateTime .

:c_7115f1d1 a skos:Concept;
  skos:definition "Zierrippengewölbe, das noch durch schwebende Rippen ergänzt wird, die wie in einer zweiten Schicht unter der Leibung liegen. Zu unterscheiden vom mehrschaligen Gewölbe. [Glossarium Artis]"@de,
    "Gewölbeform der Spätgotik, unter deren figurierter Gewölbeschale noch eine von dieser losgelöste Rippenfiguration vorhanden ist. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_1f14b4dd;
  skos:prefLabel "Zweischichtengewölbe "@de, "bóveda de dos capas"@es, "volta gotica a doppio guscio"@it,
    "voûte à nervures adossées et pendantes"@fr, "tracery vault with flying ribs"@en;
  skos:broader :c_049c4c22, :c_ec52d929;
  dct:created "2019-12-10T15:19:29.000"^^xsd:dateTime;
  dct:modified "2021-01-19T13:13:59.000"^^xsd:dateTime;
  :broaderByConstruction :c_049c4c22 .

:c_1a068990 a skos:Concept;
  skos:definition "Diagonalrippe, Kreuzrippe; Gewölberippe an einem Diagonalbogen. [Koepf / Binding 2016]"@de;
