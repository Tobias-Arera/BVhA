  dct:created "2019-02-18T19:15:00.000"^^xsd:dateTime;
  dct:modified "2021-01-22T19:22:59.000"^^xsd:dateTime .

:c_ab2c77c8 a skos:Concept;
  skos:definition "Wand, urspr. Bezeichnung für ein Flechtwerk aus Ruten, d.h. für die lehmverschmierten Flechtwerkwände; heute Raumabschluss oder Raumtrennung aus Holz, Fachwerk oder Glas im Gegensatz zur massiven Mauer, im allg. Sprachgebrauch wird aber häufig jeder Raumabschluss als W. bezeichnet, zumindest die Innen-Ansichtsfläche. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
