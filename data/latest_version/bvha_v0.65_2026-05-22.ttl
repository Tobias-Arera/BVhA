:c_25d5f91f a skos:Concept;
  skos:scopeNote "Unter Vorgang werden allgemeine Begriffe für Handlungen und Prozesse zusammengefasst, die an unterschiedlichen Orten und zu unterschiedlichen Zeitpunkten auftreten können. Ist die Handlung auf einen konkreten Ort und einen Zeitpunkt bezogen, ist sie als ein Ereignis unter dem Top Konzept Zeitpunkt zu verstehen, zum Beispiel stellt \" Wiederaufbau nach dem Zweiten Weltkrieg\" ein konkretes und zeitlich wie lokal eingegrenztes Ereignis dar, wohingegen der Begriff \"Wiederaufbau\" den Vorgang im Allgemeinen beschreibt."@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_315cf028,
    :conceptScheme_ef0a8695, :conceptScheme_b16d0aff;
  skos:prefLabel "Vorgang"@de;
  skos:broader :c_d2736b68;
  skos:narrower :c_6fd46e6e, :c_1df9f722, :c_9b16fed3, :c_f4d7166e, :c_2b7c3aa1, :c_56bde5f8,
