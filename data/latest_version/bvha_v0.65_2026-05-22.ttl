  dct:created "2020-04-06T23:05:05.000"^^xsd:dateTime;
  dct:modified "2021-01-15T16:43:47.000"^^xsd:dateTime .

:c_zafa5lop a skos:Concept;
  skos:definition "Scheitelstein, 1. der Stein im Scheitelpunkt eines Bogens, falls keine Scheitelfuge vorhanden ist. 2. Stein am Hauptknotenpunkt der Rippeneines Gewölbes. Die Rippenquerschnitte sind noch teilweise an den meist kreisrunden und figurierten S. angearbeitet. Seltener kommt der ringförmige S. mit offenem Scheitelloch vor, während der hängende S.(Abhängling) eine Sonderform ist. [Koepf / Binding 2016]"@de,
    "Oberster Stein in einem Bogen oder in einem Kreuzrippengewölbe. In der Sakralarchitektur ist dieser Stein oft besonders gestaltet und durch Bauskulptur geschmückt. Im Burgenbau ist dies seltener der Fall, doch kommt es vor, dass die Sch.e mit Wappenschildern versehen sind (Burg Lauf BY). B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen]"@de,
    "1. Der im Scheitel eines Bogens oder Knotenpunkts von Rippen sitzende Stein, auch als Knauf ausgebildet; 2. Abhängling, Hängeknauf, spätgotische Form des Schlusssteins: herabhängender Knauf. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_8c0441f9;
  skos:prefLabel "závěrečný klenák"@cs, "Schlussstein"@de, "apex stone"@en, "serraglia"@it,
    "piedra angular"@es, "clef d\\'arc"@fr;
  skos:altLabel "keystone"@en, "clef de voûte"@fr, "svorník"@cs, "závěrný klenák"@cs,
    "vrcholový klenák"@cs, "klenák z přírodní břidlice"@cs, "chiave di volta"@it, "clave de arco"@es,
    "Gewölbeschlusstein"@de, "Hängeknauf (Schlussstein)"@de, "chiave d\\'arco"@it;
  skos:broader :c_3e25acca, :c_fadb7f3f;
  skos:narrower :c_b4dbeb90, :c_c9eb50a0;
  dct:created "2019-12-10T14:55:40.000"^^xsd:dateTime;
  dct:modified "2021-01-22T17:24:15.000"^^xsd:dateTime;
  :broaderByFunction :c_fadb7f3f;
  :broaderByPosition :c_3e25acca .

