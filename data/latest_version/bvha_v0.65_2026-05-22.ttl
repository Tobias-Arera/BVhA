  skos:related :c_e33d855d;
  dct:created "2020-03-16T15:56:33.000"^^xsd:dateTime;
  dct:modified "2021-01-12T17:37:03.000"^^xsd:dateTime .

:c_e33d855d a skos:Concept;
  skos:definition "Archivolte (ital. archivolto: Ober-, Vorderbogen), 1. der Faszienbogen (Vignola), dann die durch künstler. Behandlung ausgezeichnete Stirnseite eines Bogens, von der Antike in die Renaissance übernommen. 2. Als A.n werden auch die Bogen im Gewände roman. und got. Portale bezeichnet, die hier die Fortsetzung der Gewändegliederung bilden und häufig mit Skulpturen (Archivoltenfiguren) besetzt sind. [Koepf / Binding 2016]"@de,
    "l. Čelo a líc půlkruhového oblouku, vlastně architráv nad podporami ohnutý do půlkruhu (antika, románský sloh, renesance, baroko). 2. U románského a gotického portálu s šikmým ostěním každý oblouk, který pokračuje v členění šikmého ostění, v románském slohu často v podobě oblounu. Tyto archivolty jsou často osazeny pásovými vlysy (zvl. v románské době) nebo figurami (gotika). [Koch 2008]"@cs,
    "Ursprünglich ein architravartig profilierter Bogen wie der Faszienbogen, im weiteren Sinne jeder durch besondere künstlerische Gestaltung (Steinsetzung, Profilierung, Ornamentierung) ausgezeichnete, über einem Durchgang gespannte Bogen. Die Bezeichnung gilt auch den in die Tiefe gestaffelten, oft mit Figuren geschmückten Bogenläufen an romanischen und gotischen Portalen, die gelegentlich, ohne dass ein Kämpfergesims ausgebildet wäre, unmittelbar in die Säulen und Pfosten des Gewändes übergehen. Man spricht dann auch von einem durchlaufenden Bogen. [Glossarium Artis]"@de,
    "Archivolte (ital. vorderer Bogen), 1. die Stirn und die Laibung eines Rundbogens, als ein zum Halbkreis gebogener Architrav über Stützen zu verstehen (Antike, Romanik, Renaissance, Barock); 2. im romanischen und gotischen Gewändeportal jeder Bogenlauf, der die Gliederung der Gewände fortsetz, in der Romanik oft in Form eines Rundstabes. Diese Archivolten sind häufig mit Bänderfriesen (besonders in der Romanik) oder Figuren (Gotik) besetzt. [Koch 2009]      "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9, :conceptScheme_1f14b4dd;
  skos:prefLabel "archivolta"@cs, "Archivolte"@de, "archivolte"@fr, "arcus volutus"@la,
    "archivolt"@en;
  skos:altLabel "compound arch"@en, "archivault"@en;
  skos:broader :c_09462c92, :c_8916f563;
  skos:related :c_acd8564c;
  dct:created "2019-10-21T11:57:42.000"^^xsd:dateTime;
  dct:modified "2021-01-22T17:11:57.000"^^xsd:dateTime .

