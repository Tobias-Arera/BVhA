:c_6cc4cec2 a skos:Concept;
  skos:definition "Hirtenstab m; Pastoralstab m; auch Pastorale n (lat.); Stab m; Iat. baculus pastoralis; virga; pedum; cambuta etc.: ein langer Stab als Amtsinsigne hoher kirchlicher Würdenträger (Bischöfe, Äbte und Äbtissinnen; seit 5. Jh.). Er bestand zunächst aus Holz, später aus Edelmetall, Elfenbein oder Fischbein (vom Bartenwal) und endigt entweder in einer einfachen Biegung oder volutenförmig (präzis. Krummstab m; lat. baculus ad volutam), manchmal auch mit einem Querholz (Taustab). [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "Hirtenstab"@de, "crosier"@en, "bâton pastoral"@fr, "baculus pastoralis"@la;
  skos:altLabel "pedum"@la, "Stab"@de, "crozier"@en, "pastoral staff"@en, "crosse pastorale"@fr,
    "Pastoralstab"@de, "Pastorale"@de, "virga"@la, "cambuta"@la;
  skos:broader :c_86c8b719;
  skos:narrower :c_db732d1e, :c_d0c849fe, :c_7715254c, :c_860ffcaf, :c_f7b76b93, :c_6ee62aa1;
  skos:related :c_2bfa4b5f;
  dct:created "2020-08-07T17:36:29.000"^^xsd:dateTime;
  dct:modified "2021-01-23T13:33:59.000"^^xsd:dateTime .

