:c_3b13806e a skos:Concept;
  skos:definition "Lierne (frz.), Zwischenrippe im Fächer- und Netzgewölbe, die weder von einem Kämpfer noch von einem zentralen Schlussstein ausgeht. [Koepf / Binding 2016]"@de,
    "Doplňkové ozdobné žebro. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_37522b74;
