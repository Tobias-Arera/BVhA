  dct:modified "2021-01-27T11:45:31.000"^^xsd:dateTime .

:c_f38c1c22 a skos:Concept;
  skos:definition "Gürtel-Reliquie f; lat. Sancta Zona Beatae Virginis: eine Marienreliquie, die in der ChaIkopateiakirche (in Byzanz seit 5. Jh.), in Prato (seit 12. Jh.), in Aachen, in Puy-Notre-Dame, England und an anderen Orten verehrt wird. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "Ceinture de la Vierge"@fr, "Our Lady\\'s Girdle"@en, "Gürtel-Reliquie"@de,
    "Sancta Zona Beatae Virginis"@la;
  skos:broader :c_a72f9d02;
  dct:created "2020-09-25T18:11:33.000"^^xsd:dateTime;
  dct:modified "2021-01-27T11:45:54.000"^^xsd:dateTime .

:c_86450643 a skos:Concept;
  skos:definition "Marienkleid n; Marienhemd n; lat. camisia Mariae; Sancta Camisia: ein aus orientalischer Baumwolle gefertigtes Gewand der Mutter Gottes, das im Marienschrein des Aachener Domes bewahrt wird. Albrecht Dürer berichtet, dass er 1520 in Aachen \"unser Frauen Hemd und Gürtel\" gesehen habe. Weitere Stätten der Verehrung sind u. a. Chartres, Sens und Rom (seit 9. Jh.). [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "Chemise de la Vierge"@fr, "Chemise of the Virgin"@en, "Marienkleid"@de,
    "camisia Mariae"@la;
  skos:altLabel "Sancta Camisia"@la, "Marienhemd"@de;
  skos:broader :c_a72f9d02;
  dct:created "2020-09-26T14:31:59.000"^^xsd:dateTime;
  dct:modified "2021-01-27T11:46:05.000"^^xsd:dateTime .

:c_ffbb0543 a skos:Concept;
  skos:definition "Makkabäische-Brüder Reliquien f pl: die Überreste der sieben Brüder und ihrer Mutter, die sich geweigert hatten, die jüdischen Speisegesetze zu brechen und unter König Antiochus IV Epiphanes das Martyrium erlitten haben. Die Kirchenväter verehrten sie als Protomärtyrer, in der Ostkirche sind sie heiliggesprochen. Reliquientranslationen erfolgten aus Antiochien nach Rom und Konstantinopel und von Mailand 1164 nach Köln (Makkabäerschrein in St. Andreas). [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "reliques des sept frères Macchabées"@fr, "relics of the seven brothers Maccabees"@en,
    "Makkabäische-Brüder-Reliquie"@de;
  skos:broader :c_c42bedc9;
  dct:created "2020-09-26T14:29:24.000"^^xsd:dateTime;
  dct:modified "2021-01-27T11:46:32.000"^^xsd:dateTime .

