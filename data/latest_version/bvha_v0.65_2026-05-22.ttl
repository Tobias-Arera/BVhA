:c_31f07b04 a skos:Concept;
  skos:definition "Grabbauten ägypt. Pharaonen. Über quadrat. Grundfläche errichteter Baukörper mit unter einem Neigungswinkel von rund 50° allseitig geböschten Oberflächen. Die P. ist wohl aus der Mastaba, Stufenmastaba und Stufenp. entstanden. Die Abtreppung einer Stufenp. ist jedoch nicht durch Aufstockung, sondern durch Ummantelung zu erklären. Eine Sonderform ist die Knickp. mit gebrochenem Neigungswinkel. In Ägypten sind alle Formen der P.  Pharaonengräber. Dagegen tragen die Stufenp.n Babyloniens (Zikkurat, Stufenberg) Hochtempel, die wie die Tempel auf den Stufenbergen Altamerikas meist zur Beobachtung von Himmelskörpern (Sonnenp., Mondp.) dienten. Auf Stufenbergen stehen auch einige Tempel (Prang) in Hinterindien. [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel " pyramide"@fr, "pyramida"@cs, " pyramid"@en, "piramide"@it, "pirámide"@es,
    "Pyramide"@de;
  skos:altLabel "jehlan"@cs;
  skos:broader :c_619f25e9;
  skos:narrower :c_6e181ba5, :c_0fbb4da6, :c_18d29162, :c_4a97516b;
  dct:created "2020-08-11T13:04:00.000"^^xsd:dateTime;
  dct:modified "2021-01-12T17:02:28.000"^^xsd:dateTime;
  :narrowerByFunction :c_0fbb4da6, :c_4a97516b;
  :narrowerByShape :c_6e181ba5, :c_18d29162 .

