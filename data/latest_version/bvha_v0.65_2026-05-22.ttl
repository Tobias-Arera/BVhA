  dct:created "2020-08-21T09:31:25.000"^^xsd:dateTime;
  dct:modified "2021-01-26T15:30:46.000"^^xsd:dateTime .

:c_ab6fe16c a skos:Concept;
  skos:definition "Gleichhohe Schicht eines Mauerwerks bzw. Folge von Dachziegeln, die in derselben Reihe liegen. [Koepf / Binding 2016]"@de,
    "Schar, die in derselben Reihe liegenden Steine eines Mauerwerks. [Koepf /Binding 2016]"@de;
