:c_8c4b6def a skos:Concept;
  skos:definition "Leuchterweibchen sind die weltliche Spielart von Muttergottesleuchtern, wobei eine weibliche Halbfigur, oft mit Fischschwanz, die Muttergottes ersetzt. Bes. im 16. Jh. [Koch 2009]"@de,
    "Jsou světskou variantou předcházejícího lustru, Pannu Marii nahrazuje ženská polofigura, často s rybím ocasem, zvl. v 16. stol. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9, :conceptScheme_1f14b4dd;
  skos:prefLabel "Leuchterweibchen"@de, "lustr s ženskou postavou"@cs;
  skos:broader :c_fe6ee255;
  dct:created "2020-08-04T14:17:19.000"^^xsd:dateTime;
  dct:modified "2021-01-30T22:46:57.000"^^xsd:dateTime .

:c_8a46bd69 a skos:Concept;
  skos:definition "Für die Karwoche; schmiedeeiserner Fuß mit dreieckigem oder dreiteiligem Aufsatz, im späten Mittelalter mit 12-15 Lichtern, je eines für Christus, die Apostel und manchmal die 3 Marien. [Koch 2009]"@de,
    "Svícen pro velikonoční týden; kovaná noha s trojúhelníkovým nebo trojdílným nástavcem, v pozdním středověku s 12 -15 světly, po jednom za Krista, apoštoly, a někdy za tři Marie. [Koch 2008]"@cs,
    "Tenebraeleuchter m (lat. tenebrae \"Finsternis\"); auch Mettenleuchter m; Teneberleuchter m; Triangel f; lat. hersia triangularis; candelabrum triangulare; tenebrae candelabrum: ein dreieckiger Leuchter mit hohem Schaft. Er wird an der Epistelseite des Altares aufgestellt und nur an des letzten drei Tagen der Karwoche benützt. Er trägt 15 (oder nur 13) Kerzen, welche die elf Apostel, die drei Marien (oder nur die Mutter Gottes) und Christus symbolisieren. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_37522b74, :conceptScheme_1f14b4dd;
  skos:prefLabel "Teneberleuchter"@de, "velikonoční svícen"@cs, "herse"@fr, "hersia triangularis"@la,
    "hearse"@en;
  skos:altLabel "herse à cierges"@fr, "chandelier des ténèbres"@fr, "chandelier triangulaire"@fr,
    "Tenebrae-Candelabra"@en, "Tenebraeleuchter"@de, "Mettenleuchter"@de, "Triangel"@de,
    "candelabrum triangulare"@la, "tenebrae candelabrum"@la;
  skos:broader :c_438111ab;
  dct:created "2020-08-04T14:17:30.000"^^xsd:dateTime;
  dct:modified "2021-01-30T22:51:30.000"^^xsd:dateTime .

:c_ae5e6a76 a skos:Concept;
  skos:definition "Exedra (gr. abgelegener Sitz), urspr. eine halbrunde oder rechteckige Nische mit erhöhten Sitzplätzen in antiken Wohnhäusern, Säulengängen und an öffentl. Plätzen- [Koepf / Binding 2016]"@de,
    "Řec. sedadlo stranou. Zadní síň antického obytného domu. [Koch 2008]"@cs, "Exedra (griech. abgelegener Sitz), rückwärtiger Saal des antiken Wohnhauses. [Koch 2009]"@de;
