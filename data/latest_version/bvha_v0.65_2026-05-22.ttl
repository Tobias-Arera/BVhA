:c_2f44313c a skos:Concept;
  skos:definition "Von zahlreichen, nebeneinander gestellten, parallelen Bogenstellungen gegliederte Halle. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c8a571d9,
    :conceptScheme_1f14b4dd;
