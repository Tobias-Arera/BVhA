:c_b8d9d8ae a skos:Concept;
  skos:definition "Abstand zwischen den Säulenachsen. [Koepf / Binding 2016]"@de, "Osová vzdálenost mezi dvěma sloupy dělená dolním průměrem sloupu = 2 moduly; ten se tak stává měrnou jednotkou interkolumnia; interkolumnium určuje v podstatné míře působivost sloupořadí. [Koch 2008]"@cs,
    "Der Abstand zwischen den Mittelachsen benachbarter Säulen. [Glossarium Artis]"@de,
    "Interkolumnium (lat.), Abstand zweier Säulen, von Achse zu Achse gemessen und durch den unteren Säulendurchmesser = 2 Moduli (s. Model) geteilt. Dieser wird so zur Maßeinheit für das Interkolumnium. Das Interkolumnium bestimmt wesentlich die Wirkung einer Säulenreihe. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "entrecolonnement "@fr, "interkolumnium"@cs, "intercolumnation "@en,
    "intercolunnio"@it, "intercolumnio"@es, "Interkolumnie "@de;
  skos:altLabel "entrecolonne"@fr, "osová vzdálenost sloupů"@cs, "Interkolumnium "@de,
    "Säulenweite"@de;
  skos:broader :c_58d336a8, :c_9dcb728d;
  skos:narrower :c_aabda1d3;
  skos:related :c_13ca858d;
  dct:created "2020-03-30T13:07:37.000"^^xsd:dateTime;
  dct:modified "2021-01-15T17:54:50.000"^^xsd:dateTime .

