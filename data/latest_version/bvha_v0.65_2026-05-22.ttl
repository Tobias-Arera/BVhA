:c_f83bd8ed a skos:Concept;
  skos:definition "Wehrkirche, eine zu Verteidigungszwecken eingerichtete Kirche. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
