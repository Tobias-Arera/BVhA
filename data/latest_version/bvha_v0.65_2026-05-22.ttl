:c_4ecacc8f a skos:Concept;
  skos:definition "Rauchfass n; Weihrauchfass n; auch Räucherfass n; veraltet Weihrauchbecken m; lat. incensorium; fumigatorium; thuribulum; turiferarium; thymiaterium; suffitorium: ein an drei Tragketten hängendes, schwenkbares Becken aus Kupfer, Bronze, Messing oder Eisen, gelegentlich auch aus Edelmetall, mit einem niedrigen Standfuß und einem an einer Kette aufziehbaren, durchbrochen gearbeiteten Deckel. Es kommt in vielen unterschiedlichen Formen vor, häufig in architektonischer Gestaltung. Bei den liturgischen Inzensationen werden Weihrauchkörner verbrannt, wobei Weihrauch entsteht. Das Rauchfass wird entweder kreuzförmig (lat. in modum crucis) oder kreisförmig (lat. in modum circuli) geschwenkt. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "censer"@en, "Rauchfass"@de, "turibolo"@it, "kadidelnice"@cs, "incensorium"@la,
    "incensario"@es, "wierookvat"@nl, "encensoir"@fr;
  skos:altLabel "thurible"@en, "Weihrauchfass"@de, "Räucherschwenker"@de, "Räucherkessel"@de,
    "Schwenkräuchergefäß"@de, "Räucherfass"@de, "Weihrauchbecken"@de, "thuriferarium"@de,
    "turibulum"@la, "fumigatorium"@la, "turiferarium"@la, "thymiaterium"@la, "suffitorium"@la;
  skos:broader :c_17d46f99;
  skos:related :c_fff0cce8, :c_b9d55f6c, :c_01901a66;
  dct:created "2020-02-25T09:45:06.000"^^xsd:dateTime;
  dct:modified "2021-01-24T14:56:52.000"^^xsd:dateTime .

