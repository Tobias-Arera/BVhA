:c_cdbad89b a skos:Concept;
  skos:definition "Als Giebelstocksparren stockhoch abgebunden im mehrstöckig abgebundenen Giebel. [Eißing et al. 2012]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_19d56a39;
