  :broaderByShape :c_f4e2bee8 .

:c_ea2b41ae a skos:Concept;
  skos:definition "Turmdächer mit geschweifter Kontur werden Haubendach oder Kuppeldach genannt. Hierzu gehören die Welsche Haube, das Zwiebeldach und – bei kreisförmiger Grundfläche – das Glockendach. [Eißing et al. 2012]"@de;
  skos:scopeNote "Glockendach, Dachform, die oben konvex, unten konkav ausschwingt und hauptsächl. bei Turmbekrönungen vorkommt. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_19d56a39;
  skos:prefLabel "coupole campanulée"@fr, "zvonová střecha"@cs, "bell roof"@en, "tetto a campana"@it,
    "techo acampanado"@es, "Glockendach"@de;
  skos:altLabel "Glockenhelm"@de, "toit en cloche"@fr;
  skos:broader :c_cee0b345;
  dct:created "2019-05-18T12:37:19.000"^^xsd:dateTime;
  dct:modified "2020-09-30T10:24:27.000"^^xsd:dateTime .

:c_cee0b345 a skos:Concept;
  skos:definition "Das mit einem eigenen Gerüst versehene Dach über einer Kuppel, auch die Kuppel selbst bzw. die Außenkuppel, die mit einer Dachhaut bedeckt sein kann. Gelegentlich wurden Kuppeldächer abgetreppt, z. B. bei denTrulli in Kalabrien und bei den von Guarini entworfenen Kuppeln. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "roof of a dome"@en, " Kuppeldach "@de, "kopule, báň"@cs, "toit d\\'une coupole"@fr;
  skos:broader :c_f4e2bee8;
  skos:narrower :c_ea2b41ae, :c_bc0b19ce;
  dct:created "2020-03-05T17:12:12.000"^^xsd:dateTime;
  dct:modified "2020-11-09T22:50:05.000"^^xsd:dateTime;
  :broaderByShape :c_f4e2bee8 .

:c_995ec809 a skos:Concept;
  skos:definition "Hängedach, Seildach, durchhängendes Dach, dessen Konstruktionsteile nur auf Zug beansprucht werden. Daher ist die stützenfreie Überdeckung großer Spannweiten mit geringem Aufwand möglich. Gleichzeitig entsteht darunter ein Raum mit von den Rändern zur Mitte abnehmender Höhe. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Hängedach"@de, "zavěšená střecha"@cs;
  skos:broader :c_f4e2bee8;
  dct:created "2019-05-18T12:37:40.000"^^xsd:dateTime;
  dct:modified "2020-09-30T10:10:43.000"^^xsd:dateTime;
  :broaderByShape :c_f4e2bee8 .

