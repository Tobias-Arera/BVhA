  dct:modified "2021-01-21T11:05:02.000"^^xsd:dateTime .

:c_0d61c8f3 a skos:Concept;
  skos:definition "Stilphase des französischen Barock. [Koch 2009]"@de, "Slohová fáze francouzského baroka přibližně v letech 1700-1730, název odvozen z „regentství\" Ludvíka Filipa Orleánského. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_37522b74,
