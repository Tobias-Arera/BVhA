:c_9765e150 a skos:Concept;
  skos:definition "Wärmedurchgangskoeffizient einer Haustür. [Pax - Fenster & Türen Fachbegriffe]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_c7b144d0, :conceptScheme_315cf028;
