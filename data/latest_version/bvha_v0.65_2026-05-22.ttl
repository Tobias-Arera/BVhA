  dct:created "2020-05-20T17:55:17.000"^^xsd:dateTime;
  dct:modified "2021-01-24T16:20:36.000"^^xsd:dateTime .

:c_a0458ce6 a skos:Concept;
  skos:definition "Aussetzungsthron m; Expositionsthron m; lat. thronus: ein aus Basis und Rückwand bestehendes, reich ornamentiertes und manchmal von einem Baldachin überwölbtes Gestell zur Aussetzung des Allerheiligsten in der Monstranz. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
