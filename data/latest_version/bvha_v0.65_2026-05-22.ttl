:c_b6d6a21c a skos:Concept;
  skos:definition "Silberweißes, leichtes Metall, das schmiedbar, streckbar und hämmerbar ist und sich zu Drähten und Blechen ausformen lässt. In reiner Form ist es gegen Sauerstoff und Luftfeuchtigkeit äußerst unempfindlich. Beim Übergang der Einfachverglasung zur Isolierverglasung bei Fenstern und Türen in den 195oer und 196oer Jahren ersetzte dieses dauerhafte, aber leichte Material erstmals den traditionellen Rahmen aus Holz. [Schrader / Voigt 2003]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_5bf6bcac;
  skos:prefLabel "Aluminium"@de;
  skos:broader :c_rmmuddmz;
  dct:created "2020-11-20T18:28:04.000"^^xsd:dateTime;
  dct:modified "2020-11-20T18:30:02.000"^^xsd:dateTime .

