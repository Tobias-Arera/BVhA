:c_471ed7a6 a skos:Concept;
  skos:definition "Auslandender unterer Teil eines Fenstergitters. [Koepf / Binding 2016]"@de,
    "Od dob renesance umělecky kovaná mříž podobná koši před okny. [Koch 2008]"@cs, "Seit der Renaissance oft kunstvoll geschmiedetes, korbartiges Gitter vor den Fenstern. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
