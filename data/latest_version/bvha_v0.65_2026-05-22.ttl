:c_4320b17f a skos:Concept;
  skos:definition "Eine Bauwerksgruppe ist eine identifizierbare Aggregation aus zwei oder mehr → Bauwerken und gegebenenfalls zugehörigen architektonischen → Räumen, die aufgrund formaler oder funktionaler Zusammenhänge als Einheit wahrgenommen oder definiert wird. [BVhA, Tobias Arera-Rütenik]"@de,
    "A group of built works is an identifiable aggregation of two or more → built works and, where applicable, associated architectural → spaces that is perceived or defined as a unit on the basis of formal or functional relationships. [BVhA, Tobias Arera-Rütenik]"@en;
  skos:scopeNote "Eine wahrnehmbare Zusammenstellung mehrerer → Bauwerke, gegebenenfalls mit zugehörigen → Räumen."@de,
    "A perceivable grouping of multiple → built works, where applicable with associated → spaces."@en;
  skos:example "Beispiele sind → Gebäudekomplexe, → Klosteranlagen, → Tempelbezirke, → Festungsensembles oder historische → Hofanlagen."@de,
    "Examples include → building complexes, → monastic compounds, → temple precincts, → fortress ensembles or historic → courtly complexes."@en;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_50ec0c5e, :conceptScheme_c8a571d9, :conceptScheme_176fcff1, :conceptScheme_be46b94e;
  skos:prefLabel "Bauwerksgruppe"@de, "group of built works"@en;
  skos:broader :c_e10016de;
  skos:narrower :c_8fc667ec, :c_b320e26f, :c_080560d3, :c_17adccf2, :c_c4fce86c, :c_31d9ffe0,
    :c_09fa8d6f, :c_03116c9d, :c_39d14375, :c_688d0ce5, :c_e11e1543, :c_1776bfa5, :c_5888f6d5,
    :c_8e6f9337, :c_ad106f42;
  dct:created "2020-08-12T12:51:21.000"^^xsd:dateTime;
  dct:modified "2026-03-31T12:56:53"^^xsd:dateTime;
  :narrowerByFunction :c_8e6f9337;
  :isComposedOfType :c_a01edf9f, :c_08aeb6b0;
  :shortNote "Eine wahrnehmbare Zusammenstellung mehrerer → Bauwerke, gegebenenfalls mit zugehörigen → Räumen."@de,
    "A perceivable grouping of multiple → built works, where applicable with associated → spaces."@en .

