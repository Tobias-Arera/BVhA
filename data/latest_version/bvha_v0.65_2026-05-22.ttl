:c_a2f5fc82 a skos:Concept;
  skos:definition "Gebrannte, meist glasierte Tonfliese als Wand-, Fußboden- oder Ofenbelag. Berühmt sind die kobaltblau bemalten Delfter Kacheln, die islamisch-spanischen Azulejos (span. azul = blau, arab. al zulaich = kleiner Stein) und die Kacheln des englischen Mittelalters. [Koch 2009]"@de,
    "Pálená, většinou glazovaná keramická dlaždice používaná k obkladu stěn, podlah nebo kamen; proslulé jsou delftské kachle v kobaltové modři, islámsko-španělské azulejos (špaň. azul = modrý, arab. al culaich = kamínek), a kachle anglického středověku. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9;
  skos:prefLabel "Kachel"@de, "kachel"@cs;
  skos:broader :c_6c7aaf05;
  skos:narrower :c_c435cb0f, :c_3760a879, :c_be8e5275, :c_19ead827, :c_1002d8ed;
  dct:created "2020-08-03T13:39:57.000"^^xsd:dateTime;
  dct:modified "2020-08-24T09:01:54.000"^^xsd:dateTime .

:c_c435cb0f a skos:Concept;
  skos:definition "Azulejos, (span. v. arab. azul: blau), vielfarbig gemusterte Fayenceplatten, deren Herstellung und Verwendung als Wandfliesen im 14. Jh. von den Mauren in Spanien eingeführt wurde (Baukeramik). [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Azulejo"@de, "azulejo"@cs;
  skos:broader :c_a2f5fc82;
