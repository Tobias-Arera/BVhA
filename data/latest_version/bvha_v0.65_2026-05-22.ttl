:c_dcec1fc0 a skos:Concept;
  skos:definition "Reliquienkreuz n; lat. crux reliquiarum: ein plastisches Kreuz, vielfach ein Kruzifix, das Reliquien birgt. Zu unterscheiden von der Staurothek. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
