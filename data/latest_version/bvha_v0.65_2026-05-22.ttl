:c_472af199 a skos:Concept;
  skos:definition "Tragender Balken, der andere Bauteile (Balken, Decke) trägt und aus Holz, Stein, Stahl oder Stahlbeton ausgeführt sein kann. Es gibt T. über zwei und T. über mehreren Auflagern (Durchlauft.). T. können als Unterzug oder als Überzug ausgebildet sein. 2. Tragwerk aus Holz (Dachkonstruktion) oder Stahl (Binder 2). Nach der Konstruktion werden Blecht., Gitterträger, Fachwerkt., Parallelt., Parabelt. u.a. unterschieden. 3. Räumliches Tragwerk. 4. Walzprofil (T-T. und Doppel T-T. mit durch einen Steg verbundenen Flanschen). [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "poutrelle"@fr, "(supporting) beam"@en, "trave di sostegno"@it, "Träger (Statik)"@de;
  skos:altLabel "poutre"@fr, "viga"@es, "girder"@en;
  skos:broader :c_3k6eiowx;
  dct:created "2020-08-10T10:03:11.000"^^xsd:dateTime;
  dct:modified "2020-08-31T15:32:55.000"^^xsd:dateTime .

:c_fd1dbcb4 a skos:Concept;
  skos:definition "Befestigungssystem, Festungsumriss, bes. der Verlauf der Hauptkampflinie sowie die Umwallung, der Verlauf der Defenslinien bei den Außenwerken und vorgeschobenen Stellungen. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_50ec0c5e;
  skos:prefLabel "Tracé"@de, "trazado"@es, "tracciato"@it, "tracé"@fr, "layout"@en;
  skos:altLabel "ground-plan"@en, "line"@en;
  skos:broader :c_bb7837f9;
  dct:created "2020-08-10T10:11:13.000"^^xsd:dateTime;
  dct:modified "2021-01-27T12:08:51.000"^^xsd:dateTime .

:c_d9bcb756 a skos:Concept;
  skos:definition "Befestigungssystem mit Trennung von Fern- und Nahverteidigung. Das P. verzichtet auf die Längsflankierung entlang des Walls und die Brechung der Walllinien und ist auf die niedrige Flankierung aus Kasematten und Grabenwehren angewiesen. [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_50ec0c5e;
  skos:prefLabel " système polygonal"@fr, "polygonální system opevnění"@cs, " polygonal system"@en,
    " sistema poligonale"@it, " sistema defensivo poligonal"@es, "Polygonalsystem"@de;
  skos:broader :c_bb7837f9;
  dct:created "2020-08-25T09:53:23.000"^^xsd:dateTime;
  dct:modified "2021-01-27T12:08:32.000"^^xsd:dateTime .

:c_1cbe5738 a skos:Concept;
  skos:definition "Von dem frz. Baumeister Vauban entwickeltes Befestigungssystem mit Sternschanzen. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_50ec0c5e;
  skos:prefLabel "vaubansches System"@de, "Vaubanův opevňovací system"@cs;
  skos:broader :c_bb7837f9;
  dct:created "2020-08-25T09:55:05.000"^^xsd:dateTime;
  dct:modified "2021-01-27T12:09:11.000"^^xsd:dateTime .

:c_e11b7d02 a skos:Concept;
  skos:definition "Titulus m (lat.); präzis. Kreuztitulus m: eine Tafel über dem Haupt des Gekreuzigten, meist mit der Inschrift INRI (Jesus Nazarenus Rex Judaeorum (Joh 19,19). [Glossarium Artis]"@de,
    "Inschrift auf einer Tafel oder Platte, dann wegen der Tafel mit Angaben des Besitzers über dem Hauseingang Bezeichnung für frühchristl. Gemeindehäuser in Rom, im 4. Jh. auf die dort errichteten Basiliken übertragen mit gleichzeitigem Austausch der Besitzernamen gegen Heiligennarnen, später allg. der Weihe-T., d.h. die auf den Namen eines HI. vollzogene Weihe der Kirche. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "titre de la croix"@fr, "inscription of the cross"@en, "Titulus"@de,
    "titulus"@la;
  skos:altLabel "Kreuztitulus"@de, "title of the cross"@en;
  skos:broader :c_2e6f0e40;
  dct:created "2020-08-10T15:33:18.000"^^xsd:dateTime;
  dct:modified "2021-01-22T11:26:44.000"^^xsd:dateTime .

:c_d6e112fb a skos:Concept;
  skos:definition "Ein kleines Gebäude zur Aufbewahrung von Weihegaben einer Stadt oder eines Landes im Temenos gr. Kultstätten. [Koepf / Binding 2016]"@de,
    "Schatzhaus im gr. Tempelbezirk. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "trésor"@fr, "pokladnice"@cs, "treasury"@en, "tesoro"@it, "cámara del tesoro"@es,
    "Thesauros"@de;
  skos:altLabel "Schatzhaus"@de, "trésorerie"@fr;
  skos:broader :c_ceec0c04;
  dct:created "2020-08-10T15:52:19.000"^^xsd:dateTime;
  dct:modified "2021-01-27T11:54:29.000"^^xsd:dateTime .

:c_9359a6eb a skos:Concept;
  skos:definition "Urspr. ein venezian. Estrich aus Kalk und Steinstückchen, der in mehreren Schichten aufgetragen werden muss. Heute wird der Begriff auch für zementgebundene Kunststeinestriche verwandt. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "terrazzo"@fr, "teraco"@cs, "terrazzo"@en, "terrazzo"@it, "piso veneciano"@es,
    "Terrazzo"@de;
  skos:broader :c_59bca020;
  dct:created "2020-08-10T16:14:56.000"^^xsd:dateTime;
  dct:modified "2020-11-30T19:25:43.000"^^xsd:dateTime .

:c_9af0d6ac a skos:Concept;
  skos:definition "Ein Haus, dessen Geschosse stufenförmig versetzt sind, so dass jedes Stockwerk eine Dachterrasse hat. Das T. kommt meist bei Hanglage im Vorderen Orient, in Mesopotamien und in Indien vor. Auch die Pueblos der altamerikan. Kultur sind ähnl. ausgebildet. Das T. wird auch im modernen Wohnbau verwandt. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_c8a571d9;
  skos:prefLabel "maison en terrasses"@fr, "terasovitý dům"@cs, "terrace hause"@en,
    "casa a gradoni"@it, "edificio escalonado en terrazas"@es, "Terrassenhaus"@de;
  skos:altLabel "dům s terasami"@cs;
  skos:broader :c_1c8ef562;
  dct:created "2020-08-10T16:37:37.000"^^xsd:dateTime;
  dct:modified "2021-01-26T23:12:54.000"^^xsd:dateTime .

