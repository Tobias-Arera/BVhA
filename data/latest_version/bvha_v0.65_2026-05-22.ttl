:c_703140dc a skos:Concept;
  skos:definition "Versuch der Wiederherstellung des urspr. Aussehens eines abgebrochenen oder durch Umbau stark veränderten Bauwerks. Die R. kann durch eine R.szeichnung oder durch Instandsetzung bzw. Wiederaufbau erfolgen, doch ist eine zu weitgehende R. dann nicht zu empfehlen, wenn sie nicht ganz gesichert ist oder nur noch unbedeutende originale Reste erhalten sind. [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_e452ec87,
    :conceptScheme_ef0a8695;
  skos:prefLabel "Rekonstruktion"@de, "rekonstrukce"@cs;
  skos:altLabel "přestavba"@cs;
  skos:broader :c_25d5f91f;
  skos:narrower :c_375f3a7d;
