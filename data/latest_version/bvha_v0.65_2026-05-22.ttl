:c_6f7181ac a skos:Concept;
  skos:definition "Hostie f (2); präzis, große Meßhostie f; Zelebrationshostie f; Konzelebrationshostie f; lat. hostia: eine Hostie mit einem Durchmesser von 10-14 cm. Sie ist für mehrere, gemeinsam zelebrierende Priester oder zur Spendung bei einer Gruppenmesse gedacht. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "hostia"@la, "vénérable"@fr, "Host (large)"@en, "Messhostie"@de;
  skos:altLabel "große Hostie"@de, "Zelebrationshostie"@de, "Konzelebrationshostie"@de,
    "grande hostie"@fr;
  skos:broader :c_b6b48d98;
  skos:related :c_d28a68ed;
  dct:created "2020-07-22T17:10:36.000"^^xsd:dateTime;
  dct:modified "2021-01-15T17:35:55.000"^^xsd:dateTime .

:c_0d483041 a skos:Concept;
  skos:definition "Lunula f (lat.): zwei meist halbmondförmige, seltener runde oder dreieckige Zwingen, Augen (n pl), welche die Hostie im Schaugehäuse der Monstranz halten. Die Basis der Lunula, Lunulaschlitten (m), wird auf eine Schiene am Boden des Schaugehäuses geschoben. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "lunule"@fr, "lunette (monstrance)"@en, "Lunula "@de, "lunula"@cs;
  skos:broader :c_76528fa1;
  skos:related :c_d28a68ed, :c_bc9e5156;
  dct:created "2020-07-25T16:33:43.000"^^xsd:dateTime;
  dct:modified "2021-01-24T15:08:52.000"^^xsd:dateTime .

:c_44be141b a skos:Concept;
  skos:definition "Ein Ostensorium ist ein Schaugefäß, in dem ein Gegenstand zur religiösen Verehrung gezeigt oder bei einer Prozession mitgeführt werden kann. "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8;
