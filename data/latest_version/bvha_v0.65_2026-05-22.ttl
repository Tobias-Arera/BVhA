  :broaderByPosition :c_43e35ceb .

:c_937c4934 a skos:Concept;
  skos:definition "Eine nur in Jubeljahren geöffnete heilige Tür. Das Vorbild von Babylon (Etemenanki) wurde später in Rom (St. Peter) übernommen. [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Porta sancta"@de;
  skos:broader :c_43e35ceb;
