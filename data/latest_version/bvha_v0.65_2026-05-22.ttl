    :c_kx6houci;
  skos:related :c_b41dc3bb;
  dct:created "2020-03-03T17:03:24.000"^^xsd:dateTime;
  dct:modified "2021-01-23T13:32:48.000"^^xsd:dateTime .

:c_6d545cca a skos:Concept;
  skos:definition "Tragkreuz n; auch Vortragekreuz n; lat. crux portabiIis: ein Kreuz auf einem langen Schaft, das geistlichen Würdenträgern vorangetragen und bei Umzügen mitgeführt wird, z. B. das Prozessionskreuz. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8;
  skos:prefLabel "croix portative"@fr, "portable cross"@en, "Vortragekreuz"@de, "crux portatiblis"@la;
