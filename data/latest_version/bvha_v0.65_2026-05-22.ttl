:c_97ba69bf a skos:Concept;
  skos:definition "Blütenkapitell, weitausladendes Kapitell mit geöffneten Blütenblättern, im Gegensatz zum geschlossenen Knospenkapitell. [?]"@de,
    "Blütenkapitell, Blatt-Kapitell, dessen Kelch mit Blüten geschmückt ist. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "floriated capital"@en, "chapiteau fleuronné"@fr, "Blütenkapitell"@de;
