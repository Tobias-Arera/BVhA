:c_b2269f42 a skos:Concept;
  skos:definition "Fastenvelum n, Hungertuch n, auch Fastentuch n, velum quadragesimale: zweiteiliges, häufig mit Passionsmotiven besticktes oder bemaltes violettes Tuch, das in manchen Gegenden während der Fastenzeit zwischen Chor und Langschiff aufgehängt wird; zu unterscheiden vom Passionsvelum und Ostertuch. [Glossarium Artis]"@de,
    "Hungertuch, Palmtuch, Fastenvelum, in Niedersachsen und Rheinland »S(ch)machtlappen«, ein großes Leinentuch, das in quadratischen Feldern mit Passionsszenen oder Passionswerkzeugen bemalt, bedruckt oder gewirkt ist. Zur Fastenzeit wird es zwischen Chor und Schiff aufgehängt (14.-18. Jh., heute selten). [Koch 2009]"@de,
    "Také postní rouška, postní velum, v Dolním Sasku a Porýní lidově ,,hladový hadr\", velký kus plátna, na kterém byly do čtvercových polí namalovány, vytištěny nebo vyšity pašijové scény nebo nástroje Kristova utrpení; v postní době se zavěšovalo mezi chór a loď (14.-18. stol., dnes zřídka). [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_8c0441f9, :conceptScheme_1f14b4dd;
  skos:prefLabel "Fastenvelum"@de, "postní sukno"@cs, "tenture de carême "@fr, "velum quadragesimale"@la,
    "lenten veil"@en;
  skos:altLabel "cortina"@la, "sindon"@la, "parament de carême "@fr, "voile de carême"@fr,
    "Hungertuch"@de, "Fastentuch"@de, "Palmtuch"@de, "velum templi"@la, "velamen quadragesimale"@la,
    "hladové plátno"@cs, "postní plátno"@cs, "vélum postní"@cs;
  skos:broader :c_69593e2e;
  skos:related :c_b6fa4613;
  dct:created "2020-04-09T17:29:09.000"^^xsd:dateTime;
  dct:modified "2021-01-24T16:27:12.000"^^xsd:dateTime .

:c_d93f2c91 a skos:Concept;
  skos:definition "Passionsvelum n, velum crucifixi et imaginis: violettes Tuch, mit dem Kreuze und Bildwerke während der Passionszeit verhüllt werden; zu unterscheiden vom Fastenvelum. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
