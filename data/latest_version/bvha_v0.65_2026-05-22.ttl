:c_311b221e a skos:Concept;
  skos:definition "Votivtafel, Votivbild (lat. votum = Gelübde), Tafel, die auf Grund eines Gelübdes (»ex voto«) oder als Dank für die Erhörung eines Gebets an einem Wallfahrtsort oder an der Stelle aufgehängt wird, an der das betreffende Ereignis geschah. Mit Text, oft auch Heiligenfiguren oder einer Darstellung des Ereignisses bemalt. Votivgaben sind Gegenstände, die mit einer bestimmten Gebetsmeinung oder -erhörung zusammenhängen, z.B. Krücken, Schiffsmodelle, Plastiken von Körpergliedern usw. [Koch 2009]"@de,
    "Votivbild n; Votivtafel f; lat. tabula votiva: eine kleine Tafel aus Holz oder auch aus Wachs mit der Darstellung des Stiftungsgrundes. In WaIIfahrtskirchen finden sich oft zahlreiche Votivbilder. Beispiel: die WalIfahrtskirche Mariae Himmelfahrt von 1629 in Sammerei/ Niederbayern mit einer großen Anzahl von Votivtafeln aus dem 17. und 18. Jh. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_8c0441f9,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "Votivbild"@de, "ex voto"@cs, "image votive"@fr, "tabula votiva"@la,
    "votive image"@en;
  skos:altLabel "Votivtafel"@de, "ex voto"@de, "votivní deska"@cs;
  skos:broader :c_0e073b8b;
  skos:narrower :c_81965ae6, :c_1ccce979;
  skos:related :c_4e5633e8;
  dct:created "2020-08-04T14:23:33.000"^^xsd:dateTime;
  dct:modified "2021-01-27T10:57:20.000"^^xsd:dateTime .

:c_4e5633e8 a skos:Concept;
  skos:definition "VotivschiId n; auch Inschrifttafel f; Rüstungsschild n: einer Votivgabe beigefügtes Schild, auf dem der Stiftungsgrund, der Name des Stifters und sein Dank vermerkt sind. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "Votivtafel"@de, "placard de dévotation"@fr, "devotional sign"@en;
  skos:altLabel "Inschrifttafel"@de, "Rüstungsschild"@de;
  skos:broader :c_0e073b8b, :c_67af79ce;
  skos:related :c_311b221e;
  dct:created "2020-09-29T16:05:57.000"^^xsd:dateTime;
  dct:modified "2021-01-27T21:44:47.000"^^xsd:dateTime .

