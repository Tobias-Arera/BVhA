  dct:modified "2021-01-22T15:34:07.000"^^xsd:dateTime;
  :broaderByFunction :c_e14684ea .

:c_621601ad a skos:Concept;
  skos:definition "Triforium, dessen Rückwand durchfenstert ist, so dass die Fensterzone bis auf die Seitenschiffgewölbe heruntergezogen scheint; mögl. durch die Abwalmung der Seitenschiffdächer. Seit ca. 1225/30 in Mittelfrankreich ausgebildet und von dort verbreitet. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "durchlichtetes Triforium"@de, "glazed triforium"@en;
  skos:broader :c_435ea8f2;
  dct:created "2020-03-07T13:24:02.000"^^xsd:dateTime;
  dct:modified "2021-01-22T18:15:02.000"^^xsd:dateTime .

:c_e9406dac a skos:Concept;
  skos:definition "Sestává ze slepých arkád bez chodby. [Koch 2008]"@cs, "Blendtriforium, Gliederung der Hochschiffwand zwischen den Seitenschiffarkaden und den Fenstern in der Form eines Triforiums, aber ohne dahinter liegenden Laufgang. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_37522b74;
  skos:prefLabel "Blendtriforium"@de, "slepé triforium"@cs;
  skos:broader :c_435ea8f2;
  dct:created "2020-08-03T15:47:34.000"^^xsd:dateTime;
  dct:modified "2021-01-22T18:09:38.000"^^xsd:dateTime .

:c_307446d8 a skos:Concept;
  skos:definition "Zwischen Arkaden und Obergadenfenstern einer dreischiffigen Basilika in den Dachraum der Seitenschiffe geöffnete Arkaden. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "triforium simulé"@fr, "blind triforium"@en, "Scheintriforium"@de,
    "triforio simulado"@es;
  skos:altLabel "triforium aveugle"@fr;
  skos:broader :c_435ea8f2;
  dct:created "2020-08-20T15:12:03.000"^^xsd:dateTime;
  dct:modified "2021-01-22T18:16:20.000"^^xsd:dateTime .

:c_6311d660 a skos:Concept;
  skos:definition "Triforium, dessen Öffnungen in einheitl. Ausbildung und Folge von Dienst zu Dienst reichen, in Burgund aus antiken Motiven entwickelt und auf der Ile-de-France verbreitet. [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Reihentriforium"@de;
  skos:broader :c_435ea8f2;
  dct:created "2020-08-21T13:58:16.000"^^xsd:dateTime;
  dct:modified "2021-01-22T18:16:08.000"^^xsd:dateTime .

:c_d4f43f81 a skos:Concept;
  skos:definition "Triforium, bei dem die zumeist unter Blendbogen oder Blendgiebel gekuppelten Zwillings- oder Drillinisarkaden in die Mauer eingeschnitten sind, in der Normandie ausgebildet und mit der Kathedrale von Amiens um 1240 und deren Einfluss verbreitet. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Gruppentriforium"@de;
  skos:broader :c_435ea8f2;
  dct:created "2020-09-30T09:17:01.000"^^xsd:dateTime;
  dct:modified "2021-01-22T18:15:57.000"^^xsd:dateTime .

