:c_491eeb0c a skos:Concept;
  skos:definition "Walmsparren/Walmrofen: Sparren/Rofen, der innerhalb einer Walmfläche von der Basis bis zum Walmansatz verläuft.  (Eißing et al. 2012) "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_19d56a39;
