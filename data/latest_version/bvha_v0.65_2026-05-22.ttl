:c_1e42be05 a skos:Concept;
  skos:definition "Pozdně gotický ozdobný motiv ze sukovitých větví bez listí, Chemnitz, zvl. v Německu, Španělsku a Francii 1480 až 1525. [Koch 2008]"@cs,
    "Astwerk ist eine besondere Art des gotischen Ornaments und dessen letzte Erscheinungsform. Es trägt seinen Namen nach dem charakteristischsten Bestandteil, dem laublosen Ast. [RDK Labor]"@de,
    "Spätgotisches Dekorationsmotiv aus unbelaubten, knorrigen Ästen. Besonders in Deutschland, Spanien, Frankreich zwischen 1480 und 1525. [Koch 2009]"@de,
    "Astwerk, aus knorrigen, mit zahlr. Stümpfen besetzten laublosen Ästen bestehendes Dekorationsmotiv der Spätgotik, häufig anstelle von Maßwerk an Baldachinen, Taufbecken, Kanzeln, Sakramentshaus und Kirchenportalen, vereinzelt auch an Gewölberippen vorkommend. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_37522b74, :conceptScheme_8c0441f9, :conceptScheme_cf792a3c;
  skos:prefLabel "bois mort"@fr, "větvoví"@cs, "branchwork"@en, "intreccio di rami"@it,
    "Astwerk"@de, "lofwerk"@nl;
  skos:altLabel "branch tracery"@en, "branchage"@fr;
  skos:broader :c_d1a8ce66;
  skos:related :c_935d2fc3;
  dct:created "2020-02-26T10:36:13.000"^^xsd:dateTime;
  dct:modified "2021-01-26T10:59:39.000"^^xsd:dateTime .

:c_5ca32d4c a skos:Concept;
  skos:definition "Auskragende, auch von Konsolen getragene, meist polygonale, kunstreiche Überdachungen von Figuren an Portalen, Pfeilern, Strebepfeilern zu deren Schutz und Zier angebracht, die häufig Architekturformen nachahmen. [Koepf / Binding 2016]. "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "Figurenbaldachin"@de;
