:c_69d6210a a skos:Concept;
  skos:definition "Dreifaltigkeit, Trinität. Gott Vater, Sohn ( = Christus) und Heiliger Geist (»in 3 Personen ein Einziger«) werden seit dem frühen Mittelalter verschieden dargestellt: als 3 nebeneinander sitzende Personen (seit 10. Jh.); als eine Gestalt mit 3 Köpfen oder 3 Gesichtern (seit 13. Jh.); später als 2 Personen mit Taube (= für den Heiligen Geist) oder symbolisch als 3 Kreise, die sich schneiden, oder als gleichseitiges Dreieck mit dem Auge in der Mitte (nach 15. Jh.). [Koch 2009]"@de,
    "Bůh Otec, Syn (= Kristus) a Duch svatý (,,jeden jediný Bůh ve třech osobách\") byli od raného středověku zobrazováni různě: jako tři postavy sedící vedle sebe (od 10. stol.), jako jedna postava s třemi hlavami, nebo třemi tvářemi (od 13. stol.), později jako dvě postavy s holubicemi (= Duch svatý), nebo symbolicky jako 3 kruhy, které se protínají, nebo jako rovnostranný trojúhelník s okem uprostřed (po 15. stol.). [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9;
  skos:prefLabel "Heilige Dreifaltigkeit"@de, "Nejsvětější trojice"@cs;
  skos:altLabel "Dreifaltigkeit"@de, "Trinität"@de;
  skos:broader :c_546cb22f;
  skos:related :c_786d0b37, :c_eef3ed7d, :c_1a9644a7, :c_eieuwx7k;
  dct:created "2020-05-27T12:24:16.000"^^xsd:dateTime;
  dct:modified "2021-01-15T16:14:28.000"^^xsd:dateTime .

:c_546cb22f a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8;
  skos:prefLabel "christlicher Gott"@de;
  skos:broader :c_1cd246d8;
