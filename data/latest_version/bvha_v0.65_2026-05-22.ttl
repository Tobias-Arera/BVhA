  dct:created "2020-08-18T14:35:44.000"^^xsd:dateTime;
  dct:modified "2020-11-02T13:59:20.000"^^xsd:dateTime .

:c_6a6e078a a skos:Concept;
  skos:definition "Unten angesetzter Teil eines stehenden Holzes oder dessen Metallfassung. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "sabot"@fr, "botka"@cs, "shoe"@en, "scarpa"@it, "zapata"@es, "Schuh"@de;
