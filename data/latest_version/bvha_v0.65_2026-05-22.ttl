:c_4a7d7cff a skos:Concept;
  skos:definition "Balkenstück im Dachwerk, das der Mauerschwelle aufgekämmt und mittels einer Fußstrebe (als senkrechtes Holz Sparrenknecht) mit den Sparren im Dreieck verbunden ist. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_167cb98f;
