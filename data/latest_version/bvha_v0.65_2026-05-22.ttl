:c_14e5aa91 a skos:Concept;
  skos:definition "Karfreitagskreuzkissen n: mit Samt und Seide bezogenes und mit Goldstickerei geschmücktes Kissen. Unterlage für das am Karfreitag auf den Boden gelegte Adorationskruzifix. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
