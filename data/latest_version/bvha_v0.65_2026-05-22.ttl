  dct:created "2020-06-18T17:05:52.000"^^xsd:dateTime;
  dct:modified "2021-01-24T16:06:06.000"^^xsd:dateTime .

:c_d545435b a skos:Concept;
  skos:definition "Tuch aus weißem Leinen, das den Kredenztisch auf allen Seiten bis zum Boden bedeckt. Auf diesem kleinen Tisch auf der Epistelseite des Altares stehen Brot, Wein und Wasser für die Messe bereit, ebenso wie andere für den Gottesdienst erforderlicher liturgischer Geräte. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "housse de credence"@fr, "credence cloth"@en, "Kredenztischdecke"@de;
  skos:broader :c_88d62dda;
