    :conceptScheme_8c0441f9;
  skos:prefLabel "Gravieren"@de, "gravírování"@cs;
  skos:broader :c_1df9f722;
  dct:created "2020-08-05T12:04:57.000"^^xsd:dateTime;
  dct:modified "2021-01-18T13:56:32.000"^^xsd:dateTime .

:c_d44a416f a skos:Concept;
  skos:definition "Kunsthandwerkliche Verarbeitung von Eisen, aus Mittelalter und Renaissance besonders als Tür- und Truhenbeschläge, Standleuchter, Kaminböcke, Laternen, Gitter erhalten. Die Waffenschmiedekunst wendet zur Verzierung auch das Gravieren und Ätzen an. Hauptleistungen der sakralen Schmiedekunst sind die barocken Chorgitter (Doxale - Chor) des 17. und 18. Jhs. [Koch 2009]"@de,
    "Uměleckořemeslné zpracování železa, ze středověku a renesance se zachovalo zvl. jako kování dveří a truhel, svícny, kozlíky ke krbu, lucerny a mříže. Umělecké zbrojířství používalo k výzdobě též gravírování a leptání. Nejvýznamnějšími výrobky sakrálního uměleckého kovářství jsou barokní chórové mříže (doxale - viz chór) ze 17. a 18. stol. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9, :conceptScheme_1f14b4dd;
  skos:prefLabel "umělecké kovářství"@cs, "Schmiedekunst"@de, "opus fabrile"@la;
  skos:broader :c_1df9f722;
  skos:narrower :c_9ecfe12c, :c_a8d91455, :c_0bff99b5, :c_552d3e37;
  dct:created "2020-08-11T17:25:22.000"^^xsd:dateTime;
  dct:modified "2021-01-18T14:12:17.000"^^xsd:dateTime .

