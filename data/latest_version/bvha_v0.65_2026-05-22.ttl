:c_ad998e03 a skos:Concept;
  skos:definition "ProzessionsIaterne f: eine Laterne, die auf einer langen Stange montiert ist und bei feierlichen Umzügen mitgeführt wird. Sie wird präzis. auch Stablaterne (f) oder Stocklaterne (f) genannt. Bei theophorischen Prozessionen sollen vier Laternen auf zwei Meter langen Stangen getragen werden. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "lanterne de procession"@fr, "processional lantern"@en, "Prozessionslaterne"@de;
  skos:altLabel "Stablaterne"@de, "Stocklaterne"@de;
  skos:broader :c_c0330300;
  dct:created "2020-07-29T16:22:39.000"^^xsd:dateTime;
  dct:modified "2021-01-30T22:42:06.000"^^xsd:dateTime .

:c_e728b1d4 a skos:Concept;
  skos:definition "Handlaterne f: eine Laterne, die an einem Henkel getragen wird. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "lanterne à main"@fr, "hand-lantern"@en, "Handlaterne"@de;
  skos:broader :c_c0330300;
