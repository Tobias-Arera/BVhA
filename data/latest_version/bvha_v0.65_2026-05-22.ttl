:c_d1bbaea0 a skos:Concept;
  skos:definition "Laie m; lat. laicus: im kirchlichen Verständnis ein getaufter Christ, der kein Geistlicher ist, dem der Bischof aber die Ausübung bestimmter Funktionen übertragen kann, z. B. die Durchführung eines Wortgottesdienstes. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "laïque"@fr, "layman"@en, "Laie"@de, "laicus"@la;
