  dct:modified "2021-01-19T12:09:51.000"^^xsd:dateTime;
  :broaderByShape :c_5f9418c5 .

:c_a011c664 a skos:Concept;
  skos:definition "Kreuzgewölbe, dessen Scheitellinien zur Mitte hin gerade ansteigen, dessen Stichhöhe also größer ist als es seiner Norm entspricht. Es wird aus den Abschnitten steigender Tonnen gebildet. Bei ungleicher Spannweite kann man durch das Stechen der Kappen erreichen, dass der enge Bogen halbkreisförmig bleibt. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "surmounted cross vault"@en, "überhöhtes Kreuzgewölbe "@de, "voûte d\\'ogives (ou: d\\'arètes) à sommet surhaussé"@fr;
  skos:altLabel "domical cross vault"@en, "Kreuzgewölbe mit Stich"@de, "erhöhtes Kreuzgewölbe"@de;
  skos:broader :c_5f9418c5;
  dct:created "2019-10-28T09:00:38.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:11:36.000"^^xsd:dateTime;
  :broaderByShape :c_5f9418c5 .

:c_08a962e0 a skos:Concept;
  skos:definition "Ziergewölbe mit Rippen, die in den verschiedenen Maßwerkformen profiliert sind. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
