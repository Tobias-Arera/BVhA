:c_177bf288 a skos:Concept;
  skos:scopeNote "Dachgebälk, Gesamtheit aller Dachbalken. [Koepf / Binding 2016]"@de,
    "Dachstuhl, beim Sparren- oder Pfettendach die Gesamtheit der parallel zum First angeordneten Stützkonstruktionen aus Säulen mit ihren zumeist verstrebten Schwellen und Stuhlrähmen (Rähm) oder Pfetten, die zusammen den Längsverband einer Dachkonstruktion bilden; stehender Stuhl, Konstruktion mit senkrechter Stellung der Stuhlsäulen, entweder in der Mitte unter dem First (einfach stehender Stuhl) oder seitl. symmetr. (doppelt stehender Stuhl) oder kombiniert (mehrfach stehender Stuhl}; liegender Stuhl, Konstruktion, bei dem die Stuhlsäulen schräg, mit ihrem Fußpunkt zu den Außenwänden angeordnet stehen. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Dachstuhl"@de, "krov"@cs;
  skos:altLabel "Stuhl"@de, "Dachgebälk"@de;
  skos:broader :c_f4e2bee8;
  skos:narrower :c_3fba2315, :c_baae88fe, :c_01c9a748, :c_b0b5fcfc;
  dct:created "2020-08-11T12:53:22.000"^^xsd:dateTime;
  dct:modified "2020-09-06T16:51:09.000"^^xsd:dateTime .

:c_3a4425c0 a skos:Concept;
  skos:definition "Auch Mönch-und-Nonnen-Dach, besonders in Süd-Europa übliche Anordnung halbrunder Dachziegel. Die unteren Ziegel heißen Nonnen, sind breit und liegen eng, die Fuge wird von einem schmaleren »Mönch« bedeckt. Mönch und Nonne in einem Stück gebacken ergeben die Klosterpfanne. [Koch 2009]"@de,
    "Uspořádání půlkruhových střešních tašek používané zvl. v jižní Evropě; spodní tašky se nazývají „korýtka\" (N Nonne), jsou široké a leží těsně vedle sebe, mezeru mezi nimi zakrývá užší „hák\" (N Monch); korýtko a hák vypálené v jednom kusu tvoří tzv. klášterní tašku. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9;
  skos:prefLabel "Priependach"@de, "prejzová střecha"@cs;
  skos:altLabel "Mönch-und-Nonnen-Dach"@de;
  skos:broader :c_f4e2bee8;
  dct:created "2020-08-11T13:25:49.000"^^xsd:dateTime;
  dct:modified "2020-09-02T15:23:48.000"^^xsd:dateTime .

:c_6c3a38e2 a skos:Concept;
  skos:definition "Durchhängendes Dach, dessen Konstruktion nur auf Zug beansprucht wird. Die lichte Höhe des darunterliegenden Raumes nimmt nach der Raummitte ab. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "toit suspendu à câbles"@fr, "střecha nesená lany"@cs, "cable(-suspended) roof"@en,
    "copertura a vela in tensione"@it, "techo colgante suspendido por cables"@es, "Seildach"@de;
