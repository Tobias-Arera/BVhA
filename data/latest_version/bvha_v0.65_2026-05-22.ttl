  dct:modified "2021-01-19T12:39:00.000"^^xsd:dateTime;
  :broaderByConstructionMaterial :c_049c4c22 .

:c_4ac7d139 a skos:Concept;
  skos:definition "Ein aus Kragsteinen errichtetes Scheingewölbe. Da die Aufstandsflächen horizontal sind, entsteht kein Seitenschub. Teilweise werden die Steine verzahnt oder erhalten einen Aufguss von Zement. Der Gewölbescheitel wird durch Auflage eines Kragsturzes abgesichert. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "voûte en tas-de-charge"@fr, "corbel vault"@en, "Kraggewölbe"@de;
  skos:altLabel "voûte en encorbellement"@fr, "corbeled vault"@en, "Kragsteingewölbe"@de,
    "Kragwölbung"@de;
  skos:broader :c_053d8697;
  skos:narrower :c_37f74dbd;
  skos:related :c_baad22f3, :c_2fce538c;
  dct:created "2019-12-12T16:09:14.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:51:30.000"^^xsd:dateTime;
  :broaderByConstruction :c_053d8697 .

:c_2fce538c a skos:Concept;
  skos:definition "Ein scheitrechter Steinbalken, der ein Kraggewölbe oder eine Kragkuppel abdeckt. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
