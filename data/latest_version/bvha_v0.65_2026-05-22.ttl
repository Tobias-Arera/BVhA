:c_edb7d77d a skos:Concept;
  skos:definition "Firmung f; Firmungssakrament n; Konfirmation f; ostk. Myronsalbung f; gr. hagion myron; lat. confirmatio \"Befestigung\"; sacramentum confirmationis; russ. miropomazanie: das Sakrament, durch das der Getaufte vom Hl. Geist im Glauben bestärkt und gefestigt werden soll. Dies geschieht durch Handauflegung und Salbung durch den Bischof oder einen von ihm Beauftragten. Das Sakrament der Firmung bestätigt die Taufe und eröffnet die Zulassung zum Abendmahl und zum Patenamt. Während die Firmung  in den westlichen Kirchen in der Regel getrennt vom Taufakt und zeitlich meist wesentlich später vollzogen wird, erfolgt in den Ostkirchen die Myronsalbung unmittelbar nach der Taufe. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "confirmatio"@la, "confirmation"@fr, "hagion myron"@el, "Confirmation"@en,
    "miropomazanie"@ru, "Firmungssakrament"@de;
  skos:altLabel "sacrement de confirmation"@fr, "sacrament of Confirmation"@en, "Firmung"@de,
    "Konfirmation"@de, "Myronsalbung"@de, "sacramentum confirmationis"@la;
  skos:broader :c_c5c22822, :c_dihjrxws;
  skos:related :c_1ddd1454;
  dct:created "2020-04-05T15:09:21.000"^^xsd:dateTime;
  dct:modified "2021-01-15T17:20:36.000"^^xsd:dateTime .

