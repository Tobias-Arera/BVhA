  skos:altLabel "Schiffchen"@de, "Rauchschiff"@de, "Rauchschiffchen "@de, "Nachen"@de,
    "navicella"@it, "nacelle à encense"@fr, "navicula"@la, "navicella"@la, "naveta"@la,
    "navicula"@en;
  skos:broader :c_17d46f99, :c_f490a4dd;
  skos:related :c_5fceea54, :c_4ecacc8f, :c_4b34be9f;
  dct:created "2020-02-25T14:17:59.000"^^xsd:dateTime;
  dct:modified "2021-01-24T13:06:35.000"^^xsd:dateTime .

:c_01901a66 a skos:Concept;
  skos:definition "Löffelchen zum Aufstreuen des Weihrauchs. [RDK Labor]"@de, "WeihrauchIöffelchen n; auch Inzensschaufel f; lat. cochlearium: ein kleiner, geweihter Löffel, mit dem die Weihrauchkörner dem Behälter entnommen und in das Rauchfaß gelegt werden. [Glossarium Artis]"@de;
