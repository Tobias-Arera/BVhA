:c_f9425a8d a skos:Concept;
  skos:definition "Buße f; Bußsakrament n; gr. metanoia; lat. sacramentum satisfactionis; russ. pokajanie: das Sakrament, in dem der Priester als Stellvertreter Gottes einengetauften Christen mit der Kirche aussöhnt, indem er ihm seine Sünden vergibt, ihn von den ewigen Strafen losspricht (Absolution f) und ihn wieder in den Stand der Gnade versetzt. Der Gläubige leistet dazu die contritio cordis (Reue), die confessio oris (Beichte) und die satisfactio operis (Buße). [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "sacramentum satisfactionis"@la, "pénitence "@fr, "metanoia"@el, "Penance"@en,
    "pokajanie"@ru, "Bußsakrament (katholisch)"@de;
  skos:altLabel "sacrement de pénitence"@fr, "sacrement de réconciliation"@fr, "sacrament of Penance"@en,
    "Buße"@de;
  skos:broader :c_c5c22822;
  skos:related :c_6ca61a95, :c_1a6a67ee;
  dct:created "2020-04-05T15:09:38.000"^^xsd:dateTime;
  dct:modified "2021-01-15T17:37:36.000"^^xsd:dateTime .

