:c_973079e1 a skos:Concept;
  skos:definition "Ein unten konvex und oben konkav geschwungenes Haubendach. [Koepf/Binding 2016]"@de,
    "Předchůdce cibulové střechy, ale v dolní části konkávní, často má více zakřivených pater, které jsou někdy zakončeny lucernou (baroko). [Koch 2008]"@cs,
    "Welsche Haube, Haubendach, Dachhelm; Turmdach mit geschweifter Kontur. [Koepf / Binding 2016]"@de,
    "Vorform des Zwiebeldachs, aber im Unterteil konkav; oft Unterbau für mehrfach geschweifte Aufbauten, die gelegentlich in einer Laterne enden (Barock). [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "Welsche Haube"@de, "techo imperial"@es, "tetto ad elmo"@it, "vlašská helmice"@cs,
    "toit en oignon"@fr;
  skos:altLabel "tetto a bulbo"@it, "t. a cipolla"@it, "Zwiebeldach"@de, "Haubendach"@de,
    "Kaiserdach"@de, "tejado imperial"@es, "t. persa"@es, "comble à l\\'impériale"@fr,
    "toit à l\\'impériale"@fr, "tetto all\\'imperiale"@it;
  skos:broader :c_f4e2bee8;
  dct:created "2019-05-22T13:24:38.000"^^xsd:dateTime;
  dct:modified "2020-09-30T10:07:45.000"^^xsd:dateTime;
  :broaderByConstruction :c_f4e2bee8 .

:c_e1f2b6eb a skos:Concept;
  skos:definition "Dachtraufe, Traufe, Dachfuß; der untere, waagerechte Rand einer geneigten Dachfläche, über den das Regenwasser abtropft. [Koepf / Binding 2016]"@de,
    "Dachtraufe, Traufkante, Dachbord, Saum, Schlagbrett; untere, waagerechte Begrenzung der Dachfläche parallel zum First, zugl. Ablaufkante des Regenwassers, entweder als Traufkante oder in Rinnen, die sichtbar entlang der T. (Hängerinne) oder verdeckt (Stand- oder Kastenrinne) angebracht sind; das Wasser wird durch Wasserspeier oder Fallrohre abgeleitet. Bei Walmdächern läuft die T. in einheitl.Höhe um das ganze Haus. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_19d56a39;
  skos:prefLabel "canalón"@es, "Traufe"@de, "okap"@cs, "grondaia"@it, "égout"@fr;
  skos:altLabel "gronda"@it, "alero"@es, "Saum"@de, "Dachtraufe"@de, "Traufkante"@de,
    "Dachbord"@de, "Schlagbrett"@de, "Dachfuß"@de, "socarrén"@es, "tejaroz"@es, "gouttière"@fr,
    "chéneau"@fr, "eaves"@en;
  skos:broader :c_1a53f70e;
  dct:created "2019-05-22T13:36:35.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:00:02.000"^^xsd:dateTime .

