  skos:inScheme :conceptScheme_7816b346, :conceptScheme_1f14b4dd;
  skos:prefLabel "croix fleurdelisée"@fr, "fleury cross"@en, "Lilienkreuz"@de, "liliový kříž"@cs;
  skos:altLabel "croix en fleur de lys"@fr, "flory cross"@en, "Alkantarakreuz"@de;
  skos:broader :c_46483b7b;
  skos:related :c_26a4d697;
  dct:created "2020-07-06T10:41:19.000"^^xsd:dateTime;
  dct:modified "2021-01-22T18:56:41.000"^^xsd:dateTime;
  :broaderByShape :c_46483b7b .

:c_bb3a951a a skos:Concept;
  skos:definition "Kreuz n, gestuftes; gestaffeltes auch Treppenkreuz n: ein Kreuz, dessen Arme sich in regelmäßigen Absätzen verbreitern. [Glossarium Artis]"@de;
