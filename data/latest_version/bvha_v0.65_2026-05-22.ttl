  skos:definition "Reliquienglas n: ein mit Deckel verschlossenes Glasgefäß verschiedener Form als Reliquienbehälter (ab 14. Jh.). [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
