  dct:created "2020-08-11T14:30:34.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:05:57.000"^^xsd:dateTime .

:c_985e43ef a skos:Concept;
  skos:definition "Griechisches und römisches Mäander-Ornament. [Koch 2009]"@de, "Řecký a římský meandrový ornament. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "Wellenband"@de, "vlnovka"@cs;
  skos:broader :c_298d4e12;
  dct:created "2020-08-12T10:26:35.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:07:10.000"^^xsd:dateTime .

:c_41f8c985 a skos:Concept;
  skos:definition "Spiralförmig gewundenes Ornament, bes. die Voluten eines ion. oder korinth. Kapitells, häufig mit einer Scheibe im Zentrum (S.nauge). [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "scroll"@en, "corne de bélier"@fr, "Schnecke"@de, "závitnice voluty"@cs;
  skos:altLabel "volute"@fr, "voluta"@cs, "volute"@en, "voluta"@it, "voluta"@es, "Volute"@de,
    "limaçon"@fr;
  skos:broader :c_298d4e12;
  dct:created "2020-08-19T17:09:23.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:06:41.000"^^xsd:dateTime .

:c_37b4d7c5 a skos:Concept;
  skos:definition "Ein aus skelettierten Ochsen- (oder Stier) schädeln bestehender Fries eines röm. Tempels. [Koepf/Binding 2016]"@de,
    "Bukranion (gr. Rindsschädel), Aaskopf, dem Schädelskelett der Opfertiere nachgebildetes Schmuckmotiv an hellenist. und röm. Altären, Grabmälern und Metopen, meist mit Blumen und Bändern verziert. Häufig sind mehrere solcher Schädel nebeneinandergereiht und durch Girlanden verbunden oder mit Rosetten in den Zwischenräumen zu einem Fries vereinigt, dem Bukranienfries. Das Motiv wurde in der Renaissance wieder aufgenommen und auch im Barock noch gelegentl. verwendet. [Koepf / Binding 2016]"@de,
    "Aaskopf, Bukranion, Nachbildung eines Tierschädels als Bauornament, bes. an Tempelgebälken und Sarkophagen. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "Bukranion"@de, " friso bucráneo"@es, " (fregio a) bucranio"@it, "bukranion"@cs,
    " bucrane"@fr;
  skos:altLabel "Aaskopf"@de, "Ochsenschädel"@de, "teschio di bue"@it;
  skos:broader :c_298d4e12;
  dct:created "2020-08-22T15:57:17.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:03:41.000"^^xsd:dateTime .

:c_ea168d37 a skos:Concept;
  skos:definition "Ballenblume, oft plast., knospenähnl. Ornament in Hohlkehlen von ma. Portalgewänden und Gesimsen. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "Ballenblume (vegetabiles Ornament)"@de;
  skos:broader :c_70af57f2;
  dct:created "2020-08-25T12:08:06.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:03:22.000"^^xsd:dateTime .

:c_ae88877d a skos:Concept;
  skos:definition "Kleine, aneinandergereihte, in der Form von Edelsteinfacetten ausgemeißelte Ornamentform an Baugliedern, auch zu Friesen zusammengefügt, bes. in der Spätromanik, Renaissance und im Barock. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "Diamantierung (Ornament)"@de;
  skos:broader :c_298d4e12;
  dct:created "2020-09-01T10:33:08.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:03:50.000"^^xsd:dateTime .

:c_8985a1e6 a skos:Concept;
  skos:definition "Entrelacs (frz.), Ornamentformen, denen ein fortlaufendes Bandgeflecht oder Geschlinge zugrunde liegt: reine Bandornamente wie Flechtband, Mäander oder Beschlagwerk mit den daraus abgeleiteten Formen und alle vegetabilen, fortlaufenden Ornamentfriese, die von fortlaufenden Bändern oder bandartigen Gebilden durchzogen sind. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "Entrelac"@de;
  skos:broader :c_298d4e12;
  dct:created "2020-09-07T14:18:25.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:04:12.000"^^xsd:dateTime .

:c_07ab5833 a skos:Concept;
  skos:definition "Bandförmiges Ornament aus einem oder mehreren Streifen, die sich in sich oder miteinander verschlingen, wahrscheinl. aus der Flechttechnik entwickelt. Das F. kommt bereits in vorgeschichtl. Zeit als Ziermotiv vor, wird in der Antike gern als Randverzierung (z.B. von röm. Mosaikfußböden) verwendet und tritt in der Holz- und Steinarchitektur des MAs hauptsächl. an Balken, Friesen, Bändern, Gesimsen und Kapitellen auf. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "Flechtband"@de;
  skos:broader :c_298d4e12;
  dct:created "2020-09-25T10:12:05.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:04:26.000"^^xsd:dateTime .

:c_81999c36 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe;
  skos:prefLabel "Maßwerkfenster"@de, "kružbové okno"@cs;
  skos:broader :c_4708d89a;
  dct:created "2019-12-10T12:03:53.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:12:43.000"^^xsd:dateTime;
  :broaderByConstruction :c_4708d89a .

:c_67db5a9d a skos:Concept;
  skos:definition " Tonnengewölbe, dessen Scheitellinie im Gegensatz zur Längstonne quer zur Hauptachse eines Raums verläuft. [Koepf/Binding 2016]"@de,
    "Tonnengewölbe, dessen Achse rechtwinklig zur Raumachse des Bauwerkes verläuft. [Glossarium Artis]"@de;
