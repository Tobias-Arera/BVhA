:c_d45f1406 a skos:Concept;
  skos:definition "Drehbares, oft ornamental verziertes Blechstück das auf Türmen oder dem First eines Gebäudes die Windrichtung anzeigt. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "Wetterfahne"@de, "girouette"@fr, "korouhev  "@cs, "weathervane"@en,
    "banderuola"@it, "veleta"@es;
  skos:altLabel "korouhvička"@cs;
  skos:broader :c_9f0be38f;
  dct:created "2020-08-04T10:28:27.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:02:00.000"^^xsd:dateTime .

:c_ad937aa6 a skos:Concept;
  skos:definition "Totenacker, Gottesacker, Kirchhof; Begräbnisplatz und Stätte der Totenverehrung, urspr. außerhalb der Siedlungen; die Christen nutzten neben Kirchen und Kapellen in Rom auch die Katakomben zu Bestattung. Im MA grundsätzl. an der Pfarrkirche gelegen und von einer Mauer umgeben, im späteren MA auch getrennt; zu Beginn des 20. Jhs. parkähnl. Zentralfriedhöfe am Großstadtrand, als Sonderform der Camposanto. [Koepf / Binding 2016]"@de,
    "Označení pro hřbitov. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_50ec0c5e, :conceptScheme_37522b74, :conceptScheme_176fcff1;
  skos:prefLabel "hřbitov"@cs, "cimitero, camposanto"@it, "Friedhof"@de;
  skos:altLabel "Gottesacker"@de;
  skos:broader :c_17adccf2;
  skos:narrower :c_2b436b03, :c_ce1ecabe, :c_2b5cb460, :c_b2ed564c;
  dct:created "2020-08-04T10:32:39.000"^^xsd:dateTime;
  dct:modified "2021-01-22T15:51:43.000"^^xsd:dateTime .

:c_2b436b03 a skos:Concept;
  skos:definition "Campo Santo (ital. heiliges Feld), Friedhof, bes. wenn es sich wie in Italien um eine Anlage von regelmäßigem Grundriss handelt, die von Arkaden umgeben sein kann, meist jedoch nur von mächtigen Mauern für Wandbestattungen umschlossen ist. [Koepf / Binding 2016] "@de,
    "Campo santo (it. heiliger Acker), Bezeichnung für Friedhof. [Koch 2009] "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_50ec0c5e, :conceptScheme_8c0441f9;
  skos:prefLabel "Campo Santo"@de;
  skos:broader :c_ad937aa6;
  dct:created "2020-09-29T10:37:22.000"^^xsd:dateTime;
  dct:modified "2021-01-22T15:25:18.000"^^xsd:dateTime .

:c_ce1ecabe a skos:Concept;
  skos:definition "Gräberstadt, Totenstadt (gr. Nekropole), ist ein Friedhof mit architektonisch gestalteten Gräbern oder mit Grabbauten, die oft noch gruppiert oder um größere Grabbauten regelmäßig angeordnet sind. G.e kommen hauptsächl. bei den Ägyptern, aber auch bei den Moslems vor. Auch die Etrusker legten ihre Totenstädte um Straße und Wege geordnet an (Gräberstraße). [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_50ec0c5e;
  skos:prefLabel "Gräberstadt"@de;
  skos:broader :c_ad937aa6;
  dct:created "2020-09-29T15:12:19.000"^^xsd:dateTime;
  dct:modified "2021-01-22T15:25:29.000"^^xsd:dateTime .

:c_2b5cb460 a skos:Concept;
  skos:definition "Der alte etrusk. Brauch, Tote in Grabbauten bzw. unter Grabdenkmälern zu bestatten, die an beiden Seiten einer Straße aufgereiht sind, wurde später auch von den Römern in ähnl. Form übernommen. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_50ec0c5e;
  skos:prefLabel "Gräberstraße"@de;
  skos:broader :c_ad937aa6;
  dct:created "2020-09-29T15:17:27.000"^^xsd:dateTime;
  dct:modified "2021-01-22T15:25:39.000"^^xsd:dateTime .

:c_0e8d8cf2 a skos:Concept;
  skos:definition "Columbarium (lat. columba = Taube), Begräbnisstätte mit taubenschlagähnlichen Wandnischen, in denen Leichen, Knochenreste, Aschenurnen beigesetzt werden. Seit frühchristlicher Zeit bis heute, bes. im südlichen Europa. [Koch 2009]"@de,
    "Lat. columba = holub. 1. Holubník (Les Beaux v Provence). 2. Hrobka s nikami ve zdi podobnými holubníku, v nichž jsou pohřbeny mrtvoly, kosterní pozůstatky a urny s popelem, od raně křesťanských dob až dodnes, zvl. v jižní Evropě, katakomby. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "Columbarium"@de, "kolumbárium"@cs;
  skos:broader :c_3da3c0b4;
  skos:related :c_9cb3d277;
  dct:created "2020-08-04T10:34:30.000"^^xsd:dateTime;
  dct:modified "2021-01-19T10:50:00.000"^^xsd:dateTime .

:c_a3310d78 a skos:Concept;
  skos:definition "Ein in einer Nische liegendes Wandgrab, bes. in unterird. Grabanlagen (Katakomben). Das in einer rechteckigen Nische liegende N. heißt Mensagrab, das N. in einer Bogennische Arcosolium (Arkosol). [Koepf/Binding 2016]"@de,
    "Arcosolium, Arkosol (lat. arcus: Bogen, solium: Sarg), Bogengrab, Loculus, Nischengrab, eine bes. in unterird. Grabanlagen des frühen Christentums häufige Form des Wandgrabs, bei dem sich über dem kastenförmig in das Gesteinsmassiv gehauenen, mit einer flachen Platte geschlossenen Grabtrog eine Bogennische wölbt. Das A. war schon im vorderen Orient, dort auch als freistehender Baldachin (Baldachingrabmal) über einem Sarkophag, gebräuchl., ehe es im 3. Jh. in den Katakomben Roms Eingang fand. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel " enfeu"@fr, "nikový hrob"@cs, " loculus"@en, "loculo"@it, " loculus"@es,
    "Nischengrab"@de;
  skos:altLabel "arcosolium"@fr, "arcosolium"@cs, "Loculus"@de, "Arkosol"@de, "Arcosolium"@de;
  skos:broader :c_010385b6;
  skos:related :c_9cb3d277;
  dct:created "2020-09-16T11:27:55.000"^^xsd:dateTime;
  dct:modified "2021-01-19T10:56:54.000"^^xsd:dateTime .

:c_6e472fd1 a skos:Concept;
  skos:definition "Grabbau eines Sultans, Wesirs oder eines anderen Würdenträgers. Die T. ist ein Zentralbau mit Kuppel- oder Kegeldach. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Türbe"@de;
  skos:broader :c_a5e97b87;
  dct:created "2020-08-05T17:58:50.000"^^xsd:dateTime;
  dct:modified "2021-01-12T17:05:20.000"^^xsd:dateTime .

:c_7efa1bdd a skos:Concept;
  skos:definition "Turmähnl. Grabbau mit pyramidenförmigem Abschluss. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Turmgrab"@de;
  skos:broader :c_b42aa49a;
  dct:created "2020-08-05T18:03:06.000"^^xsd:dateTime;
  dct:modified "2021-01-12T17:05:29.000"^^xsd:dateTime .

:c_bcea69ad a skos:Concept;
  skos:definition "Grabhügel auf kreisrundem Grundriss. Die Grundform des T. kommt hauptsächl. bei myken. Gräbern, Grabhügeln in der Gegend von Pergamon, bei etrusk. und röm. Gräbern vor. [Koepf / Binding 2016]"@de,
    "Mohyla s kruhovým půdorysem, zvl. v mykénské, pergamské, etruské a římské kultuře, Augustovo mauzoleum. [Koch 2008]"@cs,
    "Grabhügel mit kreisförmigem Grundriss, besonders in der mykenischen, pergamenischen, etruskischen, römischen Kultur. [Koch 2009]"@de;
