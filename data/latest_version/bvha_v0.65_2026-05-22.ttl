  :broaderByPosition :c_9c69c39b .

:c_8fdb50da a skos:Concept;
  skos:definition "Eine unter Verwendung von Gußeisen, später von Schmiedeeisen, Stahl und Stahlbeton errichtete gewölbte Decke. Vorläufer waren Brückenbauten. [Glossarium Artis] "@de;
