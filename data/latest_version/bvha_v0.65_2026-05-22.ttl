  skos:prefLabel "Confessio"@de, "confesio"@cs;
  skos:broader :c_2d93c3e7;
  skos:related :c_bc31cf9b;
  dct:created "2020-08-04T10:46:00.000"^^xsd:dateTime;
  dct:modified "2021-01-30T12:57:27.000"^^xsd:dateTime .

:c_d3291904 a skos:Concept;
  skos:definition "Horizontalschub, nach außen gerichteter Schub, horizontale Komponente des schräg nach unten gerichteten Kämpferdrucks eines Bogens, eines Gewölbes oder einer Dachkonstruktion, der durch anschließendes Mauerwerk, Zugbalken, oder Zuganker aufgenommen wird. [Koepf / Binding 2016]"@de;
