:c_58ce5d69 a skos:Concept;
  skos:definition "Paramentenstoffe m pl:Gewebe, aus denen Paramente angefertigt werden, z. B. Leinen oder Hanf, Baumwolle, Seide, Brokat und Samt etc. Die kath. Kirche hat für das Material einiger Paramenteverbindliche Vorschriften erlassen. Amikt, Albe, Palla, Purifikatorium und Korporale müssenaus Leinen sein, Kasel, Schultervelum, Stola, Manipel, Kelchvelum, Bursa und Conopeumaus Seide. Die Institutio generalis missalis romani von 1969 erlaubt die Verarbeitung vonlandesüblichen Naturfasern. Neuerdings dürfen auch bestimmte Kunstfasern verarbeitetwerden, vorausgesetzt, sie entsprechen der Würde der heiligen Handlung und demgeistlichen Rang des Zelebrierenden. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_1f14b4dd;
  skos:prefLabel "étoffes des paraments"@fr, "parament fabrics"@en, "Paramentenstoff"@de;
  skos:broader :c_afc235ed;
  skos:narrower :c_e3ddd266, :c_9f74e321, :c_4af9e2a9, :c_1734c443, :c_1165389d, :c_4cb4556e;
  dct:created "2020-06-16T22:11:39.000"^^xsd:dateTime;
  dct:modified "2020-06-16T22:13:24.000"^^xsd:dateTime .

:c_45e079ca a skos:Concept;
  skos:definition "Altartuch n, auch Altartwele f, pallium, linteamen altaris, pannus altaris, mappa, palla, tunica altaris, mensale: schlichtes, weißes Leinentuch, das während der Messe die Mensa bedeckt; es liegen immer drei Altartücher auf, wobei die beiden unteren genau die Größe der Mensa haben, während das oberste an den Schmalseiten der Mensa bis zum Boden herabreicht. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "pallium"@la, "linge d\\'autel"@fr, "Altartuch"@de, "oltářní ubrus"@cs;
