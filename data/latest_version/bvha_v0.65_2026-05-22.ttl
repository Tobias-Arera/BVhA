  dct:created "2020-07-27T18:35:18.000"^^xsd:dateTime;
  dct:modified "2021-01-30T23:48:37.000"^^xsd:dateTime .

:c_3c9979c8 a skos:Concept;
  skos:definition "Totenglocke f; auch Grabglocke f: eine Glocke für das Grabgeläute und zum Gedenken an einen Verstorbenen. [Glossarium Artis]"@de;
