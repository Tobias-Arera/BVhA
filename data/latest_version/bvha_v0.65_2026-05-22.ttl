:c_b60e8f39 a skos:Concept;
  skos:definition "[..] durch das Aushauen mit einem Zweispitz entstandenen Schrotgräben [..]. Die Abbautechnik ist typisch für Sandsteinbrüche,in denen die Schrotgräben zwischen den Abbaureihen in ca. 10 - 15 cm Breite ausgebildet sind. [Voelkle 2016] "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_f10222e0;
  skos:prefLabel "Schrotgraben"@de;
  skos:broader :c_162d82c1;
  dct:created "2019-12-03T10:38:27.000"^^xsd:dateTime;
  dct:modified "2021-03-19T13:23:44.000"^^xsd:dateTime .

:c_bfe84c57 a skos:Concept;
  skos:definition "Die typischen Spuren des Abkeilens [von Steinblöcken] vom Untergrund [im Steinbruch]. [Voelkle 2016]"@de;
  skos:scopeNote "[M]an [haute] mit dem Zweispitz oder Spitz- und Schlageisen an der vorgesehenen Stelle im Abstand von etwa 10 - 20 cm Keillöcher- die sogenannten Keiltaschen - ein. Diese müssen exakt den gleichen Winkel wie die verwendeten Keile besitzen, da sich nur dann die gewünschte Keilwirkung entfalten kann. Die Keile werden nach dem Ansetzen mit einem großen Hammer gleichmäßig in die Keillöcher getrieben [...]. [Voelkle 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_f10222e0;
  skos:prefLabel "Keiltasche"@de;
  skos:broader :c_162d82c1;
  dct:created "2019-12-03T10:42:45.000"^^xsd:dateTime;
  dct:modified "2021-03-19T13:28:13.000"^^xsd:dateTime .

:c_c84f245c a skos:Concept;
