    "basilical pavillon"@en;
  skos:altLabel "Basilikaschirm"@de, "umbellina"@en;
  skos:broader :c_69593e2e;
  dct:created "2020-06-18T16:30:34.000"^^xsd:dateTime;
  dct:modified "2021-01-24T17:30:44.000"^^xsd:dateTime .

