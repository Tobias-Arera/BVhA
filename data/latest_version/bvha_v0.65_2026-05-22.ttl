  dct:modified "2021-01-22T12:34:11.000"^^xsd:dateTime;
  :broaderByFunction :c_b5206255 .

:c_cbb1847c a skos:Concept;
  skos:definition "Camarin (span.), kleine Kapelle hinter oder über dem Hochaltar span. Kirchen, abgeleitet von dem dort aufgestellten Heiligenschrein bzw. Reliquienaltar. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
