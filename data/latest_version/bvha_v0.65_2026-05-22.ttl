  dct:created "2020-05-20T17:39:01.000"^^xsd:dateTime;
  dct:modified "2021-01-24T16:09:49.000"^^xsd:dateTime .

:c_390076ce a skos:Concept;
  skos:definition "Vorsatzvelum n, auch Vorsetzfähnchen n, Sakramentsfähnchen n: kleine Kirchenfahne oder auf einen Rahmen gespanntes Tuch, das bei Predigten vor dem ausgesetzten Allerheiligsten die Monstranz verbirgt. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
