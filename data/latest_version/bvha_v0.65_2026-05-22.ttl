:c_b421a34a a skos:Concept;
  skos:definition "Kreuz n, gekerbtes: ein Kreuz, dessen Balkenenden spitz eingeschnitten sind, z. B. das Malteserkreuz. Bei zwei Einschnitten spricht man von einem doppelt gekerbten Kreuz (n), bei mehreren Einschnitten von einem endgezahnten Kreuz (n). [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_1f14b4dd;
  skos:prefLabel "croix à huit pointes"@fr, "indented cross"@en, "gekerbtes Kreuz"@de,
    "vrubový kříž"@cs;
  skos:altLabel "eingekerbtes Kreuz"@de, "notched cross "@en;
  skos:broader :c_46483b7b;
  skos:narrower :c_40432698, :c_303b2d58;
  dct:created "2020-07-06T11:30:31.000"^^xsd:dateTime;
  dct:modified "2021-01-22T18:46:16.000"^^xsd:dateTime;
  :broaderByShape :c_46483b7b .

:c_40432698 a skos:Concept;
  skos:scopeNote "Doppelt gekerbtes Kreuz, Kreuz dessen Balkenenden zweifach spitz eingeschnitten sind. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_1f14b4dd;
  skos:prefLabel "doppelt gekerbtes Kreuz"@de;
