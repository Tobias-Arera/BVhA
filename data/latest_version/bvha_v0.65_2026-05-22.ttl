:c_1a4ab90a a skos:Concept;
  skos:definition "BenediktusmedaiIle f; auch Benediktuspfennig m: eine geweihte Medaille, die als Schutzzeichen gilt (seit 14. Jh.). Sie trägt auf einer Seite das Bild des hl. Benedikt und die Worte: Eius in obitu nostro praesentia muniamur. Auf der anderen Seite zeigt sie ein Kreuz, auf dessen Längsbalken die Anfangsbuchstaben des Benediktussegens stehen: C(rux) S(acra) S(it) M(ihi) L(ux). Der Querbalken trägt die Buchstaben n(on) d(raco) s(it) m(ihi) d(ux). [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "médaille de Saint-Benoît"@fr, "medal of St. Benedict"@en, "Benediktusmedaille"@de;
  skos:altLabel "Benediktuspfennig"@de;
  skos:broader :c_68626186;
  skos:related :c_d7d2cec4;
  dct:created "2020-09-27T19:35:31.000"^^xsd:dateTime;
  dct:modified "2021-01-24T14:44:22.000"^^xsd:dateTime .

:c_68626186 a skos:Concept;
  skos:definition "Heiligenmedaille f: eine Gedenkmünze zur Erinnerung an einen Heiligen, z. B. die Quirinuspfennige und die Leonhardsmedaille. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "médaille d\\'un Saint"@fr, "medal of a Saint"@en, "Heiligenmedaille"@de;
  skos:broader :c_1f8af5be;
  skos:narrower :c_1a4ab90a;
  dct:created "2020-09-27T20:07:27.000"^^xsd:dateTime;
  dct:modified "2021-01-24T14:44:12.000"^^xsd:dateTime .

