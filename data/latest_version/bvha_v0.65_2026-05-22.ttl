:c_ae0ee61b a skos:Concept;
  skos:scopeNote "Altarstaffel, der auf der Mensa aufsitzende Sockel eines Altarretabels oder des Schreins eines Flügelaltars, meist mit Malereien oder Bildwerken geschmückt oder als Reliquienbehälter. [Koepf/Binding 2016]"@de,
    "Oltářní stupeň na mense jako hranolový podstavec retabula nebo skříně křídlového oltáře. [Koch 2008]"@cs,
    "Altarstaffel auf der Mensa als Unterbau für ein Retabel oder für den Schrein eines Flügelaltars. [Koch 2009]"@de,
    "Altarstaffel, Predella, Zwischenstück zwischen Mensa und Altarretabel (Flügelaltar). [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel " prédelle"@fr, "predela"@cs, "predella"@en, "predella"@it, "predela"@es,
    "Predella"@de;
  skos:altLabel "Altarstaffel"@de;
  skos:broader :c_c72822bd;
  dct:created "2020-01-10T17:49:51.000"^^xsd:dateTime;
  dct:modified "2021-01-31T00:05:45.000"^^xsd:dateTime .

:c_a9c95311 a skos:Concept;
  skos:definition "Feingliedriger, holzgeschnitzter Aufbau aus Baldachinen, Fialen und Laubwerk über dem Retabel eines Flügelaltars. Das G. ist charakterist. für spätgot. Altarschreine und übertrifft in vielen Fällen den Altarschrein an Höhe. Oft sind auch Skulpturen im G. zu finden. [Koepf / Binding 2016]"@de;
  skos:scopeNote "Reich geschnitzter hölzerner Aufsatz aus Wimpergen, Maßwerk, Blattwerk, Krabben, Fialen und Kreuzblumen seitlich und über den Retabelflügeln, manchmal mit Figurenschmuck. [Koch 2009]"@de,
    "Pozdně gotické skříně nesly oltářní nástavec. Ozdobný průhledný systém tenkých tyčí, fiál osazených kraby a rovněž konzolových figur pod baldachýny. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_37522b74;
  skos:prefLabel "Gesprenge"@de, "oltářní nástavec"@cs;
  skos:altLabel "Auszug"@de;
  skos:broader :c_c72822bd;
  dct:created "2020-01-10T17:51:18.000"^^xsd:dateTime;
  dct:modified "2021-01-31T00:05:27.000"^^xsd:dateTime .

:c_75f33258 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe;
  skos:prefLabel "Corpus"@de, "korpus"@cs;
