  skos:altLabel "Schlafsaal"@de;
  skos:broader :c_419fa770;
  dct:created "2020-08-04T12:30:38.000"^^xsd:dateTime;
  dct:modified "2021-01-25T16:23:44.000"^^xsd:dateTime .

:c_97c7dd32 a skos:Concept;
  skos:scopeNote "Oft neben der Kirche gelegener Versammlungsraum. [Koch 2009]"@de;
