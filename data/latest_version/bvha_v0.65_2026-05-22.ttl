:c_c10d78d5 a skos:Concept;
  skos:definition "Kreuz (lat. crux), seit ältesten Zeiten in vielen Kulturen vorkommende Symbol- oder Zierform, im Christentum Sinnbild des Leidens bzw. der Person Christi. Bei der Darstellung seiner Kreuzigung (Kruzifix) wird der Kreuzstamm mit der Inschrifttafel (INRI = Iesus Nazarenus Rex Iudaeorum) und oft mit dem Suppedaneum (Fußstütze) versehen. [Koch 2009]"@de,
    "Lat. crux. Objevuje se od nejstarších dob v mnoha kulturách jako symbolický nebo výzdobný prvek, v křesťanství symbol utrpení resp. osoby Ježíše Krista. Při zobrazení Kristova ukřižování je kříž doplněn o nápis INRI (= Iesus Nazarenus Rex Iudaeorum) a často také suppedaneum (opěrku pro nohy). [Koch 2008]"@cs,
    "Kreuz n; gr. stauros; stawrion; sphragis; lat. crux; russ. krest: eine Figur bzw. ein graphisches Zeichen aus zwei oder mehreren sich schneidenden Geraden, als Symbol und Zierform schon seit vorgeschichtlicher Zeit in den verschiedensten Kulturen und Religionen verbreitet. Im Christentum Symbol des Opfertodes Christi und, in Verbindung mit der Auferstehung Jesu, christliches Heilszeichen. Als heraldisches Insigne kirchlicher Würdenträger ist das Kreuzzeichen von großer Bedeutung und reicher Formenvielfalt. Plastische Nachbildungen des Kreuzes und des Kruzifixes aus wertvollen Materialien und in reich verzierter Ausführung sind wichtige, selbständige liturgische Geräte. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_57be8ee8, :conceptScheme_37522b74, :conceptScheme_8c0441f9, :conceptScheme_1f14b4dd;
  skos:prefLabel "cross"@en, "kříž"@cs, "Kreuz"@de, "krest"@ru, "croix"@fr, "crux"@la,
    "stauros"@el;
  skos:altLabel "stawrion"@el, "sphragis"@el;
  skos:broader :c_d1818f4d;
  skos:narrower :c_e2f2b077, :c_f79b65f5, :c_3866550a, :c_f44143f9, :c_17880941, :c_a68e332b,
    :c_0e3eba54, :c_f34b4089, :c_c0fcf667, :c_42b785c8, :c_963cca63, :c_dbf5131c, :c_0f7a0db9,
    :c_d363c854, :c_6216e686, :c_dcec1fc0, :c_6d545cca, :c_9f043547, :c_a014710c, :c_d61dc0e6,
    :c_a26e1c3f, :c_be874dfa, :c_ef753180, :c_0523a71b, :c_11f92abe, :c_0b259164, :c_80fdcf4d,
    :c_0fb477cf, :c_086fd5cb, :c_465eead5, :c_970ba827, :c_1abf0e04, :c_10d5b064;
  skos:related :c_19ce0a27, :c_9f6f4d68;
  dct:created "2019-09-11T12:26:47.000"^^xsd:dateTime;
  dct:modified "2021-03-19T23:21:10.000"^^xsd:dateTime .

:c_b4ffaac7 a skos:Concept;
  skos:scopeNote "Ein mit dem Chor durch offene Bogenstellungen verbundener Umgang. Seit der Romanik vorkommend. An den Chorumgang angeschlossen sind oft als halbrunder Kapellenkranz angeordnete Chorkapellen. "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
