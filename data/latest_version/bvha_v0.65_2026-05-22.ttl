  dct:modified "2020-11-10T11:11:09.000"^^xsd:dateTime .

:c_d3acb180 a skos:Concept;
  skos:definition "Achse (lat. axis), eine gedachte Gerade, die in horizontaler (Längs- oder Quera.) oder vertikaler Richtung durch eine Bauanlage, einen Baukörper oder Bauteil gezogen werden kann und als Gestaltungs- und Ordnungsmittel benutzt wird. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Achse"@de, "eje"@es, "asse"@it, "axe"@fr, "axis"@en;
  skos:broader :c_58d336a8;
  skos:narrower :c_83fae99e, :c_d11fb9cf, :c_8e885a46, :c_62f18be3, :c_26ba71a1, :c_c8ba5ef5;
  dct:created "2019-05-14T12:11:28.000"^^xsd:dateTime;
  dct:modified "2021-01-12T17:39:23.000"^^xsd:dateTime .

:c_7ca43ff0 a skos:Concept;
  skos:definition "Rippe, die zu beiden Seiten dem Verlauf des Gewölbegurtes bzw. der Scheidarkade folgt oder als Schildrippe den Schildbogen markiert. [Koch 2009]"@de,
    "Žebro přimykající ke klenebnímu pasu, resp. dělicí arkádě, nebo jako čelní žebro sledující čelní oblouk. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9;
  skos:prefLabel "Ortrippe"@de, "přízední žebro"@cs;
