  dct:modified "2020-06-24T08:57:46.000"^^xsd:dateTime .

:c_3f268134 a skos:Concept;
  skos:definition "Rippe, die entlang der Scheitellinie eines Gewölbes verläuft. Die S. kommt meistens beim Fächer-, Strahlen- und Palmengewölbe der engl. Baukunst vor. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe;
  skos:prefLabel "Scheitelrippe"@de, "arista del vértice"@es, "nervatura di chiave"@it,
    "vrcholové žebro (klenby)"@cs, "nervure de sommet"@fr;
  skos:altLabel "ridge rib"@en;
  skos:broader :c_b1f9411d;
  dct:created "2019-12-11T14:41:09.000"^^xsd:dateTime;
  dct:modified "2020-11-27T08:32:02.000"^^xsd:dateTime;
  :broaderByPosition :c_b1f9411d .

:c_0853357b a skos:Concept;
  skos:definition "Grob oder glatt behauene Werksteine an Gebäudeecken mit wechselweiser Überlagerung der Schmal- und Breitseiten, zunächst zur Kantenfestigung bei Bruchsteinmauern, später auch architekton. Gestaltungsmittel. [Koepf / Binding 2016]"@de,
    "Ein Eckquader ist eine Quader mit zwei sichtbaren Flächen im Mauerverband [BHVA]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_f10222e0;
  skos:prefLabel "Eckquader"@de;
  skos:broader :c_0a02c60b;
  dct:created "2019-12-12T11:40:23.000"^^xsd:dateTime;
  dct:modified "2021-01-22T15:47:31.000"^^xsd:dateTime .

:c_6b5a3572 a skos:Concept;
  skos:definition "Quader, dessen Sichtseite glatt abgearbeitet ist, also keinen Buckel oder eine sonstige Erhebung aufweist. G. erscheinen ab dem 11. Jh. in Zusammenhang mit dem Handquader, finden sich aber noch im 13. und 14. Jh., gelegentlich zusammen mit Buckelquaderwänden ( Buckelquader). J. Z. [Wörterbuch der Burgen, Schlösser und Festungen]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_50ec0c5e,
    :conceptScheme_1d7ba54b;
  skos:prefLabel "Glattquader"@de;
  skos:broader :c_0a02c60b;
  dct:created "2020-07-03T14:06:30.000"^^xsd:dateTime;
  dct:modified "2021-01-27T16:14:06.000"^^xsd:dateTime .

:c_a04114a3 a skos:Concept;
  skos:definition "Kleine Glattquader, die lediglich Längen von 20–40 cm und Höhen von 10–20 cm erreichen (max. 30 ─ 50 cm), d. h. handliche Formate. H. kennzeichnen das Mauerwerk an Burgen des 11. und 12. Jh.s (bis etwa 1180), wobei es auch später noch vereinzelt Mauerwerke mit H.n gibt. Manche Burgen des späten 12. und 13. Jh.s zeigen außen große Glattquader oder Buckelquader, innen dagegen H.; sie illustrieren dadurch den Übergang bzw. Wechsel in den Steinformaten. J. Z. [Wörterbuch der Burgen, Schlösser und Festungen]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_50ec0c5e,
    :conceptScheme_1d7ba54b;
  skos:prefLabel "Handquader"@de;
  skos:broader :c_0a02c60b;
  dct:created "2020-07-03T14:36:11.000"^^xsd:dateTime;
  dct:modified "2021-01-27T16:14:48.000"^^xsd:dateTime .

:c_258840c4 a skos:Concept;
  skos:definition "Quader mit polsterförmig ausgebildeter Bosse. [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "chaflán"@es, "pierre de coussin"@fr, "kvádr s polštářovitou bosou"@cs,
    "chamfered stone"@en, "bugna arrotondata"@it, "Polsterquader"@de;
  skos:altLabel "corps de coussin"@fr, " chamfered rustication"@en, "bugna arrotondata cuscino"@it;
  skos:broader :c_0a02c60b;
  dct:created "2020-08-25T10:03:00.000"^^xsd:dateTime;
  dct:modified "2021-01-22T15:48:06.000"^^xsd:dateTime .

:c_6326b2c4 a skos:Concept;
  skos:definition "Diamantquader heißen Quader, deren Ansichtsfläche (Bosse) einem geschliffenen Diamanten ähnl. bearbeitet ist. Die D. sind eine Erfindung der ital. Renaissance, wurden nördl. der Alpen bes. zur Fassadengliederung (Sockel) verwendet und kommen auch noch im Barock vor. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Diamantquader"@de;
  skos:broader :c_0a02c60b;
  dct:created "2020-09-07T09:21:55.000"^^xsd:dateTime;
  dct:modified "2021-01-22T15:47:21.000"^^xsd:dateTime .

