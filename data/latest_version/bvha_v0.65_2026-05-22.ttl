:c_769bf0f8 a skos:Concept;
  skos:definition "Mit dem Spitzeisen werden in der Regel die groben Vorarbeiten ausgeführt, es dient in erster Linie dem schnellen Materialabtrag. [...] Entsprechend seinem Einsatz sind die Spitzhiebe sehr unterschiedlich. Sie können in Bahnen, gemustert oder sehr unregelmäßig ausgebildet sein. […] Die Länge der Spitzeisen dürfte etwa 20 - 30 cm betragen haben, der Durchmesser zwischen 1,0 und 2,0 cm. Die Form der Spitze war abhängig vom Material: Je weicher der Stein, desto schlanker wurde die Spitze ausgeschmiedet. Der Kopf dürfte in der Regel konisch als sog. »Schlägelkopf« ausgebildet worden sein. [Voelkle 2016]"@de,
    "Werkzeug zur Steinbearbeitung. Die Werksteine der frühen Burgen sind entweder mit dem Zweispitz, einem beidhändig geführten Hauwerkzeug, oder mit dem S., das mit dem Klöpfel geschlagen wird, bearbeitet. Durch die Sprengwirkung des Eisens auf dem Stein werden größere Steinstücke abgesprengt. Zwischen den so entstehenden Hiebrillen bleiben Wulste stehen. Im 11. Jh. wird diese Wirkung für einfache Muster auf den Steinoberflächen genutzt. Wird die Oberfläche weiterbearbeitet, bleiben vom S. eher punktförmige, unregelmäßige Bearbeitungsspuren übrig. Das S. muss im 12. Jh. weitgehend der Fläche weichen, die eine glattere Steinoberfläche zulässt. B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_f10222e0;
  skos:prefLabel "Spitzeisen"@de, "špičák"@cs;
  skos:altLabel "Schroteisen (CH)"@de, "Spitzyseren"@sw, "Schröteisen"@sw;
  skos:broader :c_ffc581ab;
  dct:created "2019-05-14T11:44:11.000"^^xsd:dateTime;
  dct:modified "2020-07-03T15:33:36.000"^^xsd:dateTime .

:c_62f18be3 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Querachse"@de, "příčná osa"@cs;
  skos:broader :c_d3acb180;
