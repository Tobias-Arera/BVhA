:c_12b25711 a skos:Concept;
  skos:definition "Haustyp von Bürgern einer Stadt, die neben ihrem städtischen Beruf Landwirtschaft zu Selbstversorgung betrieben. Im Erdgeschoss befanden sich die landwirtschaftlichen Einrichtungen wie Tenne, Stall und Scheuer, während das oberste Vollgeschoss zum Wohnendiente. [Schrader / Voigt 2003]"@de,
    "Ackerbürgerhaus, ein zum bäuerl. Erwerb ausgestattetes Bürgerhaus in einer geschlossenen Ortschaft/Stadt, geprägt von dem mehr oder weniger großen Anteil der für die landwirtschaftl. Nutzung notwendigen Räumlichkeiten. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_c8a571d9, :conceptScheme_5bf6bcac;
  skos:prefLabel "Ackerbürgerhaus"@de;
  skos:broader :c_5ec7bdb5;
  dct:created "2020-01-17T15:13:11.000"^^xsd:dateTime;
  dct:modified "2021-01-27T00:39:33.000"^^xsd:dateTime;
  :broaderByFunction :c_5ec7bdb5 .

