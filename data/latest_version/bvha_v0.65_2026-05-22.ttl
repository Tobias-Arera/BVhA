:c_8e43c202 a skos:Concept;
  skos:definition "Kerzenanzünder m: eine Stange, an der oben eine brennende Kerze befestigt ist, mit der man die Kerzen auf den Leuchtern anzünden kann. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
