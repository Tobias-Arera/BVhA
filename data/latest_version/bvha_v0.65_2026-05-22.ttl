:c_00f5862c a skos:Concept;
  skos:definition "Kantoniert sind Pfeiler oder Mauern, deren abgefasten Kanten Halb- oder Dreiviertelsäulen vorgelegt sind. [Koch 2009]"@de,
    "Kantonované jsou pilíře nebo zdi, před jejichž okosenými hranami jsou předsazeny polosloupy nebo tříčtvrteční sloupy. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "kantoniert"@de, "kantonované"@cs;
  skos:broader :c_189aad73;
  dct:created "2020-08-05T14:38:35.000"^^xsd:dateTime;
