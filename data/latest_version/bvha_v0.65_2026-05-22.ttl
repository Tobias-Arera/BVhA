:c_55d76ca9 a skos:Concept;
  skos:definition "Massivdecke aus Stahlbeton. Die an der Untersicht vortretenden Balken und die quer darüber verlegte Deckenplatte bilden eine stat. Einheit. Werden schlankere Balken (Rippen) in geringeren Abständen angeordnet, spricht man von Rippendecke. [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "plancher de poutres en T"@fr, " solaio pieno su travi di c.c.a."@it,
