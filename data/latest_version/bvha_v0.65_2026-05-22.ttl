:c_fecf6c8a a skos:Concept;
  skos:definition "Crescent (engl.), halbmondförmig zurückschwingende Häuserreihe, ein großzügiges städtebaul. Motiv, das weitausgreifend die Landschaft umfasst. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_c8a571d9;
  skos:prefLabel "Crescent"@de;
  skos:broader :c_1c562633;
  dct:created "2020-08-28T16:05:56.000"^^xsd:dateTime;
  dct:modified "2021-01-27T11:26:39.000"^^xsd:dateTime .

:c_f465973d a skos:Concept;
  skos:definition "Gehöft, Gruppierung von verschiedenen Baukörpern, hauptsächl. bei landwirtschaftl. Gebäuden, die nach ihren Funktionen - Wohnhaus, Stall, Scheune - differenziert und meist U-förmig um einen Hof gruppiert sind. Die wichtigsten G.formen des Bauernhauses sind das mitteldt. und das fränk. G., die jedoch in verschiedenen Varianten vorkommen, wobei Wohnteil und Stall manchmal auch in einem Baukörper liegen können. An der Straßenfront ist meist ein kleineres Tor für die Bewohner neben einer größeren Wageneinfahrt angeordnet. Eine Sonderform des G.s ist der Vierkanthof (hauptsächl. in Österreich). [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_c8a571d9;
  skos:prefLabel "Gehöft"@de;
  skos:broader :c_a1094d45;
  dct:created "2020-09-29T12:05:18.000"^^xsd:dateTime;
  dct:modified "2021-01-27T11:29:16.000"^^xsd:dateTime .

:c_e2b446a1 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c8a571d9;
