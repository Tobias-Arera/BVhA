:c_4d92835d a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ef0a8695, :conceptScheme_ec8c77bf;
  skos:prefLabel "Zement"@de, "cement"@en;
  skos:note "An inorganic binder, used for the preparation of mortars, plasters, renders and concrete. [EwaGlos]"@en,
    "Ein anorganisches Bindemittel zur Herstellung von Mörtel, Putzen und Beton. [EwaGlos]"@de;
  skos:broader :c_bbe43d47;
  dct:created "2019-05-22T17:59:47.000"^^xsd:dateTime;
  dct:modified "2021-01-30T15:01:31.000"^^xsd:dateTime .

:c_18c8a9dc a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ec8c77bf;
  skos:prefLabel "sable"@fr, "sand"@en, "Sand"@de, "písek"@cs;
  skos:note "Natural fine granular material primarily composed of silica (silicon dioxide), usually in the form of quartz. [EwaGlos]"@en,
    "Natürliches, feinkörniges Material, hauptsächlich aus Silikaten und Siliziumdioxid, in der Regel in Form von Quarz. [EwaGlos]"@de,
    "Feinkörniges Sediment, namentlich aus quarzhaltigem Gestein entstanden, welches durch Witterungseinflüsse zerfallenen ist. Sand wird zur Mörtelbereitung verwendet, ist Zuschlagstoff bei Betonmischungen etc. [Glossarium Artis, Bd. 3, Bögen und Mauerwerk]"@de;
  skos:broader :c_d0f56cb6;
  dct:created "2019-05-22T18:00:23.000"^^xsd:dateTime;
  dct:modified "2020-07-30T14:46:09.000"^^xsd:dateTime .

:c_7f5c1093 a skos:Concept;
  skos:definition "Lockere, durch Wassereinwirkung gerundete Gesteinsstücke, meist für Füllmauerwerk verwendet. [Glossarium Artis, Bd. 3, Bögen und Mauerwerk]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_1f14b4dd, :conceptScheme_ec8c77bf;
  skos:prefLabel "valoun"@cs, "gravier"@fr, "gravel"@en, "Kieselstein "@de;
  skos:altLabel "Kiesel"@de, "flint"@en;
  skos:broader :c_d0f56cb6;
  dct:created "2019-05-22T18:00:35.000"^^xsd:dateTime;
  dct:modified "2020-08-24T16:45:33.000"^^xsd:dateTime .

:c_35ef5894 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346;
  skos:prefLabel "Tierhaar"@de, "zvířecí srst"@cs;
  skos:broader :c_d0f56cb6;
  skos:narrower :c_09afd9f8, :c_2a250bed;
  dct:created "2019-05-22T18:00:42.000"^^xsd:dateTime;
