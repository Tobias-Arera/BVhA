:c_0710bc08 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ec8c77bf;
  skos:prefLabel "Phänomenologische Untersuchung"@de, "approccio fenomenologico"@it,
    "Феноменологичен подход"@bg, "phenomenological approach"@en, "jelenség kutatás"@hu,
    "etude phénoménologique"@fr, "fenomenološki pristup"@hr, "enfoque fenomenológico"@es,
    "fenomenolojik yaklaşım"@tr, "abordare fenomenologică"@ro, "podejście fenomenologiczne"@pl;
  skos:altLabel "olgusal yaklaşım"@tr;
  skos:note "Méthodologie consistant à rassembler des connaissances et des observations pertinentes dans le but d’identifier et d’étudier les phénomènes reliés aux problématiques de conservation d’un objet. (EwaGlos)"@fr,
    "A method through which one gathers relevant knowledge and observations in order to identify and study phenomena related to conservation issues. (EwaGlos)"@en,
    "Methode, mit der relevantes Wissen und Beobachtungen gesammelt werden, um Phänomene im Zusammenhang mit Erhaltungsfragen zu identifizieren und zu untersuchen. (EwaGlos) "@de;
  skos:broader :c_89b7da10;
  dct:created "2019-05-20T11:47:13.000"^^xsd:dateTime;
  dct:modified "2021-03-19T14:34:49.000"^^xsd:dateTime .

:c_6f16d0e9 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ec8c77bf;
  skos:prefLabel "Quellenrecherche"@de, "studio storico"@it, "Историческо проучване"@bg,
    "historical investigation"@en, "történeti kutatás"@hu, "étude historique"@fr, "povijesno istraživanje"@hr,
    "investigación histórica"@es, "tarihsel araştırma"@tr, "investigație istorică"@ro,
    "badania historyczne"@pl;
  skos:note "Collecte et analyse de documents relatifs à l’histoire matérielle d’une oeuvre et de son contexte environnemental au sens large. (EwaGlos)"@fr,
    "The collection and study of documents related to the material history of an artwork and its context. (EwaGlos)"@en,
    "Das Sammeln und Auswerten von Dokumenten, die in Zusammenhang mit der materiellen Geschichte eines Kunstwerkes und seines Kontextes stehen. (EwaGlos)"@de;
  skos:broader :c_89b7da10;
  dct:created "2019-05-20T13:02:49.000"^^xsd:dateTime;
  dct:modified "2021-03-19T14:33:05.000"^^xsd:dateTime .

:c_e659c8f6 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ec8c77bf;
  skos:prefLabel "Bauaufnahme"@de, "sondaggi sull’edificio e sul sito"@it, "Визуално проучване на сгради и забележителни места"@bg,
    "building and site survey"@en, "épület- és helyszínfelmérés"@hu, "étude diagnostic des bâtiments et sites (état sanitaire du bâti)"@fr,
    "pregled građevine i mjesta"@hr, "inspección de edificios y de su entorno"@es, "bina ve alan incelemesi"@tr,
    "monitorizarea sitului și a Ro monumentului"@ro, "oględziny budynku i otoczenia"@pl;
  skos:note "Evaluation de l’état de conservation d’un bâtiment ou d’un site et de son environnement à partir d’observations et de mesures simples. (EwaGlos)"@fr,
    "An assessment of the state of conservation of a building or site and a study of its environment, based on observations and simple measurements. (EwaGlos)"@en,
    "Eine Auswertung des Zustandes eines Gebäudes oder einer Stätte und eine Untersuchung ihrer Umgebung, die auf Beobachtungen und einfachen Messungen basiert. (EwaGlos)"@de;
  skos:broader :c_89b7da10;
  dct:created "2019-05-20T13:08:47.000"^^xsd:dateTime;
  dct:modified "2021-03-19T14:40:39.000"^^xsd:dateTime .

:c_b74200eb a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ec8c77bf;
  skos:prefLabel "éxamen structurel"@fr, "structural examination"@en, "Gefügeuntersuchung"@de;
  skos:altLabel "bautechnische Prüfung"@de, "statische Untersuchung"@de;
  skos:note "Constat d’état structurel de l’objet étudié et du bâtiment qui l’abrite. (EwaGlos)"@fr,
    "An assessment of the structural stability of the object under study and the surrounding building. (EwaGlos)"@en,
    "Untersuchung der Stabilität eines Objekts und des umgebenden Baus. (EwaGlos)"@de;
  skos:broader :c_89b7da10;
  dct:created "2019-05-20T13:15:38.000"^^xsd:dateTime;
  dct:modified "2021-03-19T14:37:25.000"^^xsd:dateTime .

:c_7ad18ec1 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ec8c77bf;
  skos:prefLabel "constat d’état"@fr, "object investigation"@en, "Befunduntersuchung"@de;
  skos:altLabel "Befundsicherung"@de, "Bestandsuntersuchung"@de, "Voruntersuchung"@de;
  skos:note "Étude visant à approfondir la connaissance de l’objet étudié dans sa forme originale, en caractérisant ses matériaux et son état de conservation. (EwaGlos)"@fr,
    "A study in which information regarding the original form, materials and state of conservation of an object is obtained. (EwaGlos)"@en,
    "Eine Untersuchung, die zu weiteren Erkenntnissen des Objektes und seiner Oberfläche führt. (EwaGlos)"@de;
  skos:broader :c_89b7da10;
  dct:created "2019-05-22T17:44:21.000"^^xsd:dateTime;
  dct:modified "2021-03-19T14:40:21.000"^^xsd:dateTime .

:c_862b4f38 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ec8c77bf;
  skos:prefLabel "site investigation"@en, " Kontextuntersuchung"@de;
  skos:altLabel "Baugrunderkundung"@de, "Geländeprüfung"@de, "Standortuntersuchung"@de,
    "Standorterkundung"@de;
  skos:note "Collecte de données après examen de la zone concernée pour recueillir des informations sur le contexte et l’environnement au sens large. (EwaGlos)"@fr,
    "Examination of the area surrounding an object to gather data regarding its geographic and environmental context. (EwaGlos)"@en,
    "Nach einer Untersuchung des Geländes sammelt man mit dieser Datenerfassung Informationen über den Kontext und die geografische Umgebung. EwaGlos)"@de;
  skos:broader :c_89b7da10;
  dct:created "2019-05-22T18:59:23.000"^^xsd:dateTime;
  dct:modified "2021-03-19T14:36:00.000"^^xsd:dateTime .

:c_d44c63bd a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ec8c77bf;
  skos:prefLabel "metric survey"@en, "měření"@cs, "Vermessung"@de;
  skos:altLabel "measured drawings"@en, "vyměřování"@cs, "proměřování"@cs, "zaměření území"@cs,
    "Aufmaß"@de, "Bauaufmaß"@de;
  skos:note "Any measurement that is performed on wall paintings, a building or its surroundings which is then presented as a collection of spatial information within a bi- (plans, cross-sections, elevations, etc.) or tri- (point cloud, polygonal mesh, etc.) dimensional representation. (EwaGlos)"@en,
    "Messungen, die an Wandmalereien, einem Bau oder seiner Umgebung vorgenommen werden und als Sammlung von räumlichen Informationen innerhalb einer zwei- (Ansichten, Querschnitte, Aufrisse etc.) oder drei- (Punktewolke, Polygonnetz etc.) dimensionalen Darstellung präsentiert werden. (EwaGlos)"@de,
    "Die Fundamente wurden nach den Bauplänen auf dem Baugelände (area) mit rechtwinklig (norma), kreuzförmig gespannten Richt - schnüren (linea, funiculus) und 12 oder 10 Fuß langen Messlatten (pertica, decempeda), auch mit der (durch Dehnung ungenauen) Messschnur, dem Bodenzirkel ( circinus) oder der Zirkelschnur eingemessen. Das aufgehende Mauerwerk wurde kontrolliert mit der geraden Holzlatte, dem Richtscheit (regula), dem seit Rivius 1548 so genannten Winkelhaken, der Setz- oder Lotwaage (libella) und dem Bleilot (perpendiculum), dessen Schnur durch ein Holzklötzchen geführt wurde. [Koepf / Binding 2016]"@de;
  skos:broader :c_89b7da10;
  skos:narrower :c_813ed136;
  dct:created "2019-05-22T19:49:25.000"^^xsd:dateTime;
  dct:modified "2021-03-19T14:31:08.000"^^xsd:dateTime .

:c_b635b875 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_315cf028,
    :conceptScheme_ec8c77bf;
  skos:prefLabel "building archaeology"@en, "stavebně historický průzkum"@cs, "Bauforschung"@de;
  skos:note "The investigation, documentation and interpretation of historic buildings and their fittings. [EwaGlos]"@en,
    "Untersuchung, Dokumentation und Interpretation von historischen Gebäuden einschließlich ihrer Ausstattung. [EwaGlos]"@de;
  skos:broader :c_509bbc31, :c_89b7da10;
  dct:created "2019-05-22T19:53:24.000"^^xsd:dateTime;
  dct:modified "2021-01-30T14:12:10.000"^^xsd:dateTime .

:c_ccf46723 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ec8c77bf;
  skos:prefLabel "recherche et étude de décors peints"@fr, "architectural paint research "@en,
    "Fassungsuntersuchung"@de, "arhitektonsko istraživanje boje"@hr;
  skos:altLabel "Polychromieuntersuchung"@de;
  skos:note "Recherche et étude documentée de décors ou traces de décors sur les façades et en intérieur. [EwaGlos]"@fr,
    "A systematic investigation and documentation of decorations or traces of decorations on façades and interior rooms. [EwaGlos]"@en,
    "Systematische Untersuchung und Dokumentation von Fassungen oder Fassungsresten am Außen- und Innenbau. [EwaGlos]"@de;
  skos:broader :c_89b7da10;
  dct:created "2019-06-04T14:19:34.000"^^xsd:dateTime;
  dct:modified "2021-03-19T14:37:48.000"^^xsd:dateTime .

:c_d3128179 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ec8c77bf;
  skos:prefLabel "stratigrafische Untersuchung"@de, "stratigraphic investigation"@en;
  skos:altLabel "Treppenschnitt"@de, "stratigrafische Freilegung"@de;
  skos:note "The stepwise removal of covering paint layers for analysis and determination of the chronological order of successive paint layers. [EwaGlos]"@en,
    "Stufenweise Freilegung von Malschichten zum Nachweis und zur Bestimmung der chronologischen Abfolge von aufeinander folgenden Malschichten. [EwaGlos]"@de;
  skos:broader :c_89b7da10;
  dct:created "2019-06-04T14:52:06.000"^^xsd:dateTime;
  dct:modified "2021-03-19T14:31:40.000"^^xsd:dateTime .

:c_ef621da7 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ec8c77bf;
  skos:prefLabel "Kartierung"@de, "mapping"@en;
  skos:note "Graphical representation of a single or several patterns on an architectural elevation or equivalent. [EwaGlos]"@en,
    "Grafische Darstellung eines oder mehrerer Phänomene auf einer Planzeichnung oder entsprechenden Vorlage. [EwaGlos]"@de;
  skos:broader :c_89b7da10;
  skos:narrower :c_027aa64d, :c_341911df, :c_e0fb72a6, :c_3c8587f9, :c_b1dedccc;
  dct:created "2019-06-04T15:17:36.000"^^xsd:dateTime;
  dct:modified "2021-03-19T14:36:54.000"^^xsd:dateTime .

:c_84c3d82b a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ec8c77bf;
  skos:prefLabel "scientific investigation"@en, "naturwissenschaftliche Untersuchung "@de;
  skos:note "A study which involves any number of professionals using a systematic approach and analytical tools to answer diverse questions concerning the conservation of wall paintings or decorative stone surfaces. [EwaGlos]"@en,
    "Untersuchung durch eine beliebige Anzahl von Fachleuten, die einen systematischen Ansatz und analytische Werkzeuge benutzen, um verschiedene Fragen über den Erhaltungszustand einer Wandmalerei oder dekorativer Steinoberflächen zu beantworten. [EwaGlos]"@de;
  skos:broader :c_89b7da10;
  dct:created "2019-06-04T15:20:22.000"^^xsd:dateTime;
  dct:modified "2021-03-19T14:35:10.000"^^xsd:dateTime .

:c_c5f52a8d a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ec8c77bf;
  skos:prefLabel "Restaurierungsdokumentation"@de, "conservation report"@en;
  skos:altLabel "Dokumentation"@de;
  skos:note "A document which gives brief information concerning the history of the building, the wall painting, conservation and past restoration campaigns and results arising from tests and scientific studies, as well as environmental aspects, mapping, building and site surveys etc. [EwaGlos]"@en,
    "Ein Dokument mit kurzen Informationen über die Geschichte des Gebäudes, die Wandmalerei, die Konservierung und vergangene Restaurierungskampagnen und über die Ergebnisse der Tests und naturwissenschaftlichen Untersuchungen, das auch Umweltgesichtspunkte, Kartierungen, Bauaufnahmen u.a. beinhaltet. [EwaGlos]"@de;
  skos:broader :c_89b7da10;
  dct:created "2019-06-04T15:23:50.000"^^xsd:dateTime;
  dct:modified "2021-03-19T14:32:38.000"^^xsd:dateTime .

:c_5545f6af a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ec8c77bf;
  skos:prefLabel "nicht-invasive Untersuchung"@de, "non-invasive investigation"@en;
  skos:altLabel "non-invasive Untersuchung"@de;
  skos:note "The gathering of information on site using techniques that do not modify or damage the material at the contact point between the instrument or the beam emitted by the instrument and the object surface. [EwaGlos]"@en,
    "Erfassung von Informationen vor Ort mit Techniken, die das Material am Kontaktpunkt zwischen Untersuchungsinstrument oder dem vom Instrument emittierten Strahl und der Oberfläche nicht verändern oder schädigen. [EwaGlos]"@de;
  skos:broader :c_89b7da10;
  dct:created "2019-06-04T15:26:42.000"^^xsd:dateTime;
  dct:modified "2021-03-19T14:35:00.000"^^xsd:dateTime .

:c_79a5f4fd a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ec8c77bf;
  skos:prefLabel "berührungsfreie Untersuchung"@de, "contactless investigation"@en;
  skos:note "Gathering of information on site using techniques that do not touch the surface of the wall painting. [EwaGlos]"@en,
    "Erfassen von Informationen vor Ort mit Techniken, die keinen Kontakt mit der Wandmalerei haben. [EwaGlos]"@de;
  skos:broader :c_89b7da10;
  dct:created "2019-06-04T15:29:30.000"^^xsd:dateTime;
  dct:modified "2021-03-19T14:40:11.000"^^xsd:dateTime .

:c_003c6ead a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ec8c77bf,
    :conceptScheme_3d4de19b;
  skos:prefLabel "photodocumentation"@en, "Fotodokumentation"@de, "fotodokumentace"@cs;
  skos:note "The collection of all available iconographic, historical, technical and scientific images that can shed light on the materials or aesthetics of an artwork. [EwaGlos]"@en,
    "Die Sammlung aller ikonografischen, historischen, technischen und wissenschaftlichen Abbildungen, die Aufschluss über Materialien und das Aussehen eines Kunstwerks geben. [EwaGlos]"@de;
  skos:broader :c_89b7da10, :c_8c1404d7;
  dct:created "2019-06-04T15:31:45.000"^^xsd:dateTime;
  dct:modified "2021-03-19T14:37:34.000"^^xsd:dateTime .

:c_8c1404d7 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_3d4de19b;
  skos:topConceptOf :conceptScheme_3d4de19b;
  skos:prefLabel "unpubliziertes Dokument"@de;
  skos:broader :c_5d4d5142;
  skos:narrower :c_003c6ead, :c_c2b8da81, :c_2b5e2cf4, :c_c99ce325, :c_cfd3c007, :c_ebee0ec4,
    :c_1db2770a, :c_dd059020, :c_790fa4c3, :c_2cde06e2, :c_864509aa, :c_54c87cc4;
  dct:created "2020-07-28T17:16:58.000"^^xsd:dateTime;
  dct:modified "2021-01-23T16:53:46.000"^^xsd:dateTime .

:c_c726ddab a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ec8c77bf;
  skos:prefLabel "raking light"@en, "Streifbelichtung"@de;
  skos:altLabel "Streiflicht"@de, "Seitenlicht"@de, "Schräglicht"@de;
  skos:note "The surface is lit, preferably using daylight-spots at a specific angle, in order to show the relief through shadow effects. [EwaGlos]"@en,
    "Um ihr Relief durch Schatteneffekte zu zeigen, wird die Oberfläche, am besten mit Tageslichtleuchten, in einem bestimmten Winkel beleuchtet. [EwaGlos]"@de;
  skos:broader :c_89b7da10;
  dct:created "2019-06-04T15:42:13.000"^^xsd:dateTime;
  dct:modified "2021-03-19T14:31:18.000"^^xsd:dateTime .

:c_ed19c994 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ec8c77bf;
  skos:prefLabel "wissenschaftliche Fotografie"@de, "scientific images"@en;
  skos:altLabel "wissenschaftliche Bildgebung"@de;
  skos:note "A part of photodocumentation consisting of dated photographs that give information on the technique, treatment/s and state of conservation of the studied object. [EwaGlos]"@en,
    "Teil der Fotodokumentation aus datierten Fotos, die über Technik, Maßnahmen und Zustand des Objektes Auskunft geben. [EwaGlos]"@de;
  skos:broader :c_89b7da10;
  dct:created "2019-06-04T15:46:02.000"^^xsd:dateTime;
  dct:modified "2021-03-19T14:30:48.000"^^xsd:dateTime .

:c_4f76a7bf a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ec8c77bf;
  skos:prefLabel "Probenahme"@de, "sampling"@en;
  skos:altLabel "Probeentnahme"@de, "Substanzentnahme"@de;
  skos:note "When material is extracted from a work of art or building for analysis or observation. [EwaGlos]"@en,
    "Wenn zur Analyse oder Beobachtung Substanz aus einem Kunstwerk oder einem Gebäude entnommen wird. [EwaGlos]"@de;
  skos:broader :c_89b7da10;
  dct:created "2019-06-04T15:48:34.000"^^xsd:dateTime;
  dct:modified "2021-03-19T14:33:28.000"^^xsd:dateTime .

:c_b54627b3 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ec8c77bf;
  skos:prefLabel "Bohrkernentnahme"@de, "drill core sampling"@en;
  skos:altLabel "Bohrkernerprobungen"@de, "Kernbohrungen"@de;
  skos:note "A technique that allows the extraction of materials from a certain depth by drilling. [EwaGlos]"@en,
    "Technik, mit der man durch eine Bohrung Materialien aus einer bestimmten Tiefe herausholen kann. [EwaGlos]"@de;
  skos:broader :c_89b7da10;
  dct:created "2019-06-04T15:51:02.000"^^xsd:dateTime;
  dct:modified "2021-03-19T14:39:16.000"^^xsd:dateTime .

:c_c06c2183 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ec8c77bf;
  skos:prefLabel "Probeaufbereitung"@de, "sample preparation"@en;
  skos:note "Any treatment of a sample in preparation for its study. [EwaGlos]"@en,
    "Behandlung einer Probe zur Vorbereitung ihrer Untersuchung. [EwaGlos]"@de;
  skos:broader :c_89b7da10;
  dct:created "2019-06-04T15:53:32.000"^^xsd:dateTime;
  dct:modified "2021-03-19T14:33:35.000"^^xsd:dateTime .

:c_b07f1ec0 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ec8c77bf;
  skos:prefLabel "Querschliff"@de, "cross section"@en;
  skos:altLabel "Kompaktschliff"@de;
  skos:note "Preparation of crosswise cut samples for observation by optical microscopy under reflected artificial daylight or UV light. [EwaGlos]"@en,
    "Herstellung von Querschliffen von Proben zur Untersuchung durch optische Mikroskopie mit reflektiertem, künstlichen Tageslicht oder UV-Licht. [EwaGlos]"@de;
  skos:broader :c_89b7da10;
  dct:created "2019-06-04T15:55:31.000"^^xsd:dateTime;
  dct:modified "2021-03-19T14:32:58.000"^^xsd:dateTime .

:c_488074d7 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ec8c77bf;
  skos:prefLabel "Dünnschliff"@de, "thin section"@en;
  skos:altLabel "Dünnschnitt"@de;
  skos:note "The preparation of very thin samples for observation under a petrographic microscope. [EwaGlos]"@en,
    "Präparation von sehr dünnen Proben zur Beobachtung unter einem petrografischen Mikroskop. [EwaGlos]"@de;
  skos:broader :c_89b7da10;
  dct:created "2019-06-04T16:07:01.000"^^xsd:dateTime;
  dct:modified "2021-03-19T14:38:40.000"^^xsd:dateTime .

:c_69ea170d a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ec8c77bf;
  skos:prefLabel "Materialuntersuchung"@de, "materialanalysis and examination"@en;
  skos:note "The observation and characterisation of wall painting materials or those making up architectural surfaces in order to give information on the composition of an object and its state of conservation and to provide information useful for dating or for choosing the best possible follow-up action. [EwaGlos]"@en,
    "Beobachtung und Beschreibung der Materialien, aus denen Wandmalereien und Architekturoberflächen bestehen, um Informationen über deren Zusammensetzung, Zustand, Datierung oder die beste Folgemaßnahme zu gewinnen. [EwaGlos]"@de;
  skos:broader :c_89b7da10;
  dct:created "2019-06-04T16:09:13.000"^^xsd:dateTime;
  dct:modified "2021-03-19T14:35:51.000"^^xsd:dateTime .

:c_bfb5df68 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ec8c77bf;
  skos:prefLabel "Pigmentanalyse"@de, "pigment analysis"@en;
  skos:note "Determination of the nature of fine coloured insoluble materials (known as pigments). [EwaGlos]"@en,
    "Die Bestimmung der Beschaffenheit von feinen, farbigen und unlöslichen Materialien (bekannt als Pigmente). [EwaGlos]"@de;
  skos:broader :c_89b7da10;
  dct:created "2019-06-04T16:11:53.000"^^xsd:dateTime;
  dct:modified "2021-03-19T14:33:54.000"^^xsd:dateTime .

:c_cc6bfb20 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ec8c77bf;
  skos:prefLabel "analysis of binding media"@en, " Bindemittelanalyse"@de;
  skos:note "Analysis of the continuous phase (“binder”) that holds inert particles together and adheres them to contiguous layers. [EwaGlos]"@en,
    "Untersuchung der kontinuierlichen Phase (“Bindemittel”), die inerte Partikel zusammenhält und zu zusammenhängenden Schichten verklebt. [EwaGlos]"@de;
  skos:broader :c_89b7da10;
  dct:created "2019-06-04T16:15:58.000"^^xsd:dateTime;
  dct:modified "2021-03-19T14:40:02.000"^^xsd:dateTime .

:c_d08efe57 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ec8c77bf;
  skos:prefLabel "biologische Untersuchung"@de, "biological examination"@en;
  skos:altLabel "mikrobiologische Untersuchung"@de;
  skos:note "Studies in the field and in the laboratory of biological and microbiological colonisation (including bacteria, algae, fungi, lichens) that sometimes grow on wall paintings or architectural surfaces. [EwaGlos]"@en,
    "Untersuchungen am Objekt und im Labor auf biologische und mikrobiologische Besiedelung (einschließlich Bakterien, Algen, Pilze, Flechten), die auf Wandmalereien oder Architekturoberflächen wachsen. [EwaGos]"@de;
  skos:broader :c_89b7da10;
  dct:created "2019-06-04T16:19:55.000"^^xsd:dateTime;
  dct:modified "2021-03-19T14:39:52.000"^^xsd:dateTime .

:c_2802355e a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ec8c77bf;
  skos:prefLabel "mineralogische Untersuchung"@de, "mineralogical examination"@en;
  skos:note "The characterisation and determination of natural inorganic substances known as minerals. [EwaGlos]"@en,
    "Beschreibung und Bestimmung von natürlichen, anorganischen Substanzen, bekannt als Mineralien. [EwaGlos]"@de;
  skos:broader :c_89b7da10;
  dct:created "2019-06-04T16:32:51.000"^^xsd:dateTime;
  dct:modified "2021-03-19T14:35:30.000"^^xsd:dateTime .

:c_e1043547 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ec8c77bf;
  skos:prefLabel "mikrochemische Untersuchung"@de, "spot test"@en;
  skos:altLabel " Tüpfelanalyse"@de;
  skos:note "Any simple and efficient technique which allows physico-chemical analyses on small areas under a magnifying glass or a microscope without using sophisticated instrumentation. [EwaGlos] "@en,
    "Einfache und effiziente Technik, die physikalisch-chemische Analysen an kleinen Bereichen unter der Lupe oder unter dem Mikroskop ohne aufwändigeres Instrumentarium erlaubt. [EwaGlos] "@de;
  skos:broader :c_89b7da10;
  dct:created "2019-06-04T16:36:58.000"^^xsd:dateTime;
  dct:modified "2021-03-19T14:35:42.000"^^xsd:dateTime .

:c_95bfc115 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ec8c77bf;
  skos:prefLabel "Musterfläche"@de, "treatment trials"@en;
  skos:note "Small areas of the object on which cleaning, consolidation, or reintegration tests are carried out. [EwaGlos]"@en,
    "Kleine Bereiche am Objekt, in denen Reinigungs-, Festigungs- oder Ergänzungsversuche ausgeführt werden. [EwaGlos]"@de;
  skos:broader :c_89b7da10;
  dct:created "2019-06-04T16:54:25.000"^^xsd:dateTime;
  dct:modified "2021-03-19T14:35:22.000"^^xsd:dateTime .

:c_dab8151e a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028;
  skos:prefLabel "absolute Chronologie"@de, "absolutní datování"@cs;
  skos:broader :c_89b7da10;
  dct:created "2020-08-21T16:53:49.000"^^xsd:dateTime;
  dct:modified "2021-03-19T14:41:00.000"^^xsd:dateTime .

