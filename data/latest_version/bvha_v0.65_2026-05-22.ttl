:c_abf8ae8c a skos:Concept;
  skos:definition "Erbauungsbuch n: der religiösen Andacht und Meditation dienende, häufig bebilderte Schrift. [Glossarium Artis]"@de;
  skos:scopeNote "Als Erbauungsbuch bezeichnet man gedruckte Bücher, die zur Vervollkommnung des christlichen Tugendlebens anleiten.  Als Erbauungsbücher gelten nicht die religiösen Quellenschriften wie die Bibel, Heiligenviten, einzelne liturgische Bücher und die Schriften der Mystiker. [RDK Labor]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd,
    :conceptScheme_cf792a3c;
  skos:prefLabel "devotional book"@en, "libro di edificazione"@it, "Erbauungsbuch"@de,
    "livre d\\'édification spirituelle"@fr;
  skos:altLabel "livre de dévotation"@fr, "livre d\\'édification"@fr;
  skos:broader :c_eee71711;
