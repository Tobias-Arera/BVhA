  dct:created "2019-10-09T15:27:12.000"^^xsd:dateTime;
  dct:modified "2021-01-18T14:06:17.000"^^xsd:dateTime .

:c_27f1971c a skos:Concept;
  skos:definition "Eine Anordnung von Spitzhieben auf einer Werksteinoberfläche. Diese folgen, je nach Herstellungswerkzeug, Bahnen in gerader oder gebogener und manchmal auch einer wilden Form. [BVHA]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ef0a8695, :conceptScheme_f10222e0;
  skos:prefLabel "Grobe Abspitzung"@de;
  skos:broader :c_a9f26611;
  dct:created "2019-12-12T14:31:33.000"^^xsd:dateTime;
  dct:modified "2021-01-30T16:10:59.000"^^xsd:dateTime .

:c_5a025ffb a skos:Concept;
  skos:definition "Die Steinmetze zerlegten [für die Bearbeitung] die Flächen [der Werksteinseiten] in kleine, unterteilte Bereiche mit verschiedenen Mustern von einfachen Dreiecken, Rauten, Fischgrat- und Schachbrettmustern; auch rund gearbeitete Musterungen kommen vor. [...] diese Spuren konnten nur mit dem Spitzeisen ausgeführt werden. [Voelkle 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ef0a8695, :conceptScheme_f10222e0;
  skos:prefLabel "Gemusterte Abspitzung"@de;
  skos:broader :c_a9f26611;
  dct:created "2019-12-12T14:52:35.000"^^xsd:dateTime;
  dct:modified "2021-01-30T16:10:48.000"^^xsd:dateTime .

:c_7c5f4d79 a skos:Concept;
  skos:definition "[Bei der Punktspitzung] handelte sich [...] um eine Bearbeitung, bei der die vorher grob abgespitzte oder geflächte Oberfläche mit dem Zweispitz fein aufgepickt wurde. Dabei wurde das Werkzeug senkrecht zur Oberfläche geführt, was die sehr feinen, punktförmigen Spuren ergab. [Voelkle 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ef0a8695, :conceptScheme_f10222e0;
  skos:prefLabel "Punktspitzung"@de;
  skos:altLabel "Pickung"@de;
  skos:broader :c_a9f26611;
  dct:created "2019-12-12T14:58:09.000"^^xsd:dateTime;
  dct:modified "2021-01-30T16:11:09.000"^^xsd:dateTime .

:c_954d8c63 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ef0a8695;
  skos:prefLabel "glatt gebeilt"@de;
  skos:broader :c_86697a5a;
  dct:created "2019-05-22T18:21:00.000"^^xsd:dateTime;
  dct:modified "2021-01-30T16:11:59.000"^^xsd:dateTime .

:c_9aced0f0 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ef0a8695;
  skos:prefLabel "zahngebeilt"@de;
  skos:broader :c_86697a5a;
  dct:created "2019-05-22T18:21:08.000"^^xsd:dateTime;
  dct:modified "2021-01-30T16:12:08.000"^^xsd:dateTime .

:c_6193f765 a skos:Concept;
  skos:definition "[Man überarbeitete] die Sichtfläche [des Werksteins] nach dem Abflächen mit dem etwa 4 - 5 cm breiten Breit- oder Scharriereisen, [...], das man mit einem Holzknüpfel schlug. [...] Durch die Hieb-an-Hieb-Führung entstanden oft deutlich sichtbare Bahnen, fast immer in einem Winkel von etwa 45 - 60° geführt. Die Hiebe waren, natürlich abhängig vom Material, meist recht breit und gleichmäßig und gaben damit der Oberfläche ein einheitliches Bild. [Voelkle 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ef0a8695, :conceptScheme_f10222e0;
  skos:prefLabel "Scharrierung"@de;
  skos:broader :c_162d82c1;
  skos:related :c_8d662389, :c_afd6d80d;
  dct:created "2019-05-22T18:20:36.000"^^xsd:dateTime;
  dct:modified "2021-03-19T13:23:59.000"^^xsd:dateTime .

:c_8d662389 a skos:Concept;
  skos:definition "Vor dem abschließenden Scharrieren wird die Oberfläche mit der Glattfläche abgearbeitet, wobei die Hiebe durchaus noch recht grob ausgeführt sein können und etwa 90° zur späteren Scharrierung liegen sollten. Das Scharrieren kann sowohl an horizontal als auch an schräg liegenden Oberflächen durchgeführt werden. Das Eisen wird in einem Winkel von etwa 60° zur Außenkante angesetzt und in Bahnen parallel zum Randschlag vorwärts geführt. Der Anstellwinkel der Schneide ist abhängig vom Gewicht und von der Schlagstärke des Knüpfels sowie der Materialhärte, wird aber so gewählt, dass das Eisen das anstehende Material durch den Schlag »schneidet«, wodurch die typisch weiche Form entsteht. [Voelkle 2016]"@de,
    "Oberflächenbehandlung der Steine mit einem Scharriereisen, wodurch schmale, parallele Rillen entstehen. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd,
    :conceptScheme_f10222e0;
  skos:prefLabel "ciseler"@fr, "rýhovat"@cs, "to drove"@en, "scalpellare sca nalature parallele"@it,
    "cincelar"@es, " Scharrieren"@de;
  skos:altLabel "charruer"@fr, "  to char"@en;
  skos:broader :c_1192c84c;
  skos:related :c_6193f765, :c_95302611, :c_afd6d80d;
  dct:created "2019-07-15T09:27:15.000"^^xsd:dateTime;
  dct:modified "2021-01-18T14:06:00.000"^^xsd:dateTime .

:c_95302611 a skos:Concept;
  skos:definition "Eine weitere Entwicklung Ende des 15. Jh. war das »Scharriereisen«. Dabei handelte es sich lediglich um ein etwas breiteres Schlageisen mit etwa 5 cm Schneidebreite. Heute spricht man bei einer Schneidebreite von 4 - 6 cm von »Vierteleisen«. Das klassische Scharriereisen hat eine Breite von10 -15 cm und kam erst ab der Mitte des 17. Jh. zum Einsatz. [Voelkle 2016]"@de,
    "Werkzeug zur Steinbearbeitung. Seit der Mitte des 15. Jhs. wird in Deutschland zur Endbearbeitung von Natursteinoberflächen hauptsächlich das Sch. eingesetzt. Es wird mit einem Klöpfel geschlagen und hat eine etwa 5 cm breite Schneide. Anders als mit der vorher geläufigen Fläche können mit dem S. gleichbleibend breite und exakt aneinander gereihte Hiebrillen gesetzt werden. B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd,
    :conceptScheme_f10222e0;
  skos:prefLabel "Scharriereisen"@de, "ciseau"@fr;
  skos:note "Ein Meißel mit sehr breiter Schneidebahn, mit dem die Oberfläche der Steine bearbeitet wird. [Glossarium Artis, Bd. 3, Bögen und Mauerwerk]"@de;
  skos:broader :c_ffc581ab;
  skos:related :c_8d662389;
  dct:created "2019-07-15T09:30:24.000"^^xsd:dateTime;
  dct:modified "2020-06-23T16:53:25.000"^^xsd:dateTime .

:c_29a75199 a skos:Concept;
  skos:definition "Etwa 2 cm breite, ebene Bahn, die längs der Kanten eines Werksteins angearbeitet ist und ein exaktes Versetzen der Steine ermöglicht. [Glossarium Artis, Bd. 3, Bögen und Mauerwerk]"@de,
    "Beim Randschlag handelt es sich um einen ersten Arbeitsgang [bei der Herstellung von Werksteinen], bei dem die Umrandung der jeweils zu bearbeitenden Fläche eingefasst wird. [...] Der Randschlag ist ein rein technischer Vorgang, um die Kanten zu sichern, und eine plane Fläche anzulegen. [Voelkle 2016]"@de,
    "Genaue Zurichtung der Kanten eines Quadersteins. [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_1f14b4dd, :conceptScheme_ef0a8695,
    :conceptScheme_f10222e0;
  skos:prefLabel "Randschlag"@de, " corte del borde"@es, "bordo del concio"@it, " refend"@fr,
    "recessed margin"@en;
  skos:altLabel "Kantenschlag"@de;
  skos:broader :c_162d82c1;
  dct:created "2019-05-22T18:21:27.000"^^xsd:dateTime;
  dct:modified "2021-03-19T13:24:07.000"^^xsd:dateTime .

:c_80c78b5b a skos:Concept;
  skos:definition "Der Abstand zweier aufeinanderfolgender Gurtbogen, von Bogenmitte zu Bogenmitte gemessen. Hieraus ergibt sich die Länge des Joches. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "entre-axe des doubleaux"@fr, "distance between two transverse arches"@en,
    "Gurtbogenweite"@de;
  skos:altLabel "Gurtweite"@de;
  skos:broader :c_9cd2be38;
  dct:created "2020-02-18T16:34:03.000"^^xsd:dateTime;
  dct:modified "2021-01-12T18:00:57.000"^^xsd:dateTime .

:c_f9d8858d a skos:Concept;
  skos:definition "Der zwischen vier Stützen liegende bzw. durch Gurtbogen und Scheidbogen begrenzte Abschnitt eines Gewölbes, der sich mehrfach wiederholt, z . B. bei einem gegliederten Tonnengewölbe. Im Deutschen bezeichnet Travée vorzugsweise das querrechteckige, schmale Joch der Hochgotik, oft unter Einbeziehung der Gewölbefelder und des Strebesystems der Seitenschiffe. Die Anzahl der Joche wird in Längsrichtung des Raumes gezählt. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe;
  skos:prefLabel "travée voutée"@fr, "vaulting bay"@en, "Gewölbejoch"@de, "klenebné pole"@cs;
  skos:altLabel "Gewölbefeld"@de, "Travée"@de, "überwölbtes Joch"@de;
  skos:broader :c_9cd2be38;
  dct:created "2020-02-18T16:46:04.000"^^xsd:dateTime;
  dct:modified "2021-01-12T18:00:45.000"^^xsd:dateTime .

:c_fe272bc6 a skos:Concept;
  skos:definition "Zwei gekuppelte Joche, die durch ihre Stützen geschieden, durch die Gewölbeform jedoch verbunden sind. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "double bay"@en, "travée double"@fr, " Doppeljoch "@de;
  skos:altLabel "travées jumelées"@fr;
  skos:broader :c_9cd2be38;
  dct:created "2020-02-18T17:09:45.000"^^xsd:dateTime;
  dct:modified "2021-01-12T17:59:57.000"^^xsd:dateTime .

