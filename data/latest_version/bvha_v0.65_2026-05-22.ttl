:c_656adb63 a skos:Concept;
  skos:definition "Scheibe in Glasmalerei mit dem Wappen einer Person oder Personengruppe als Stiftung an ein öffentliches Gebäude, mit einer Geldspende (»Bauschilling«) verbunden. Besonders in der Schweiz im 15. und 16. Jh. [Koch 2009]"@de,
    "Tabulka skla s namalovaným znakem určité osoby nebo skupiny osob jako donace pro veřejnou budovu, spjatá s určitým peněžním darem. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "Wappenscheibe"@de, "tabulka s erbem"@cs;
  skos:altLabel "štítek"@cs;
  skos:broader :c_3odynhrg;
  dct:created "2020-08-12T10:23:40.000"^^xsd:dateTime;
  dct:modified "2021-01-30T23:20:06.000"^^xsd:dateTime .

:c_a3363007 a skos:Concept;
  skos:definition "Allegorie der bösen Weltlust in Gestalt eines jungen Elegants, der als Verführer der Törichten Jungfrauen am Gewände der Brauttür der Gestalt Christi gegenübersteht, welcher die Klugen Jungfrauen anführt. [Koch 2009]"@de,
    "Alegorie zlé světské rozkoše v podobě mladého elegána, který jako svůdce pošetilých panen stojí u svatební brány proti postavě Krista, který vede moudré panny. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9;
  skos:prefLabel "Fürst der Welt"@de, "Kníže světa"@cs;
  skos:broader :c_dbac5de7;
  dct:created "2020-08-12T10:27:27.000"^^xsd:dateTime;
  dct:modified "2021-01-22T10:25:31.000"^^xsd:dateTime .

:c_a6531580 a skos:Concept;
  skos:definition "Balken, Überlager oder Unterzug aus Stein. S. wurden hauptsächl. in der ägypt„ gr. und röm. Baukunst verwandt. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "poutre en blocs"@fr, "kamenný nosník"@cs, "stone beam"@en, "architrave (di pietra)"@it,
    "viga de piedra"@es, "Steinbalken"@de;
  skos:altLabel "poutre en corps"@fr, "nosník vyzděný z kvádrů"@cs;
  skos:broader :c_74e816e3;
  dct:created "2020-08-12T10:41:03.000"^^xsd:dateTime;
  dct:modified "2021-01-22T19:28:46.000"^^xsd:dateTime .

:c_b25c3eda a skos:Concept;
  skos:definition "(lat. septem artes liberales), seit der karolingischen Zeit häufig dargestellte sieben weibliche Figuren mit Attributen. Sie personifizieren 1. das Trivium (daher »trivial«): Grammatik, Dialektik, Rhetorik, 2. das Quadrivium: Geometrie, Arithmetik, Musik, Astronomie. [Koch 2009]"@de,
    "Lat. artes liberales, od karolínské doby často znázorňovaná jako sedm ženských postav s atributy, které perzonifikují 1. trivium (odtud „triviální\"): gramatiku, dialektiku, rétoriku, 2. kvadrivium: geometrii, aritmetiku, hudbu a astronomii. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9;
  skos:prefLabel "Die Sieben Freien Künste"@de, "sedm svobodných umění"@cs;
  skos:broader :c_dbac5de7;
  dct:created "2020-08-12T13:07:29.000"^^xsd:dateTime;
  dct:modified "2021-01-22T10:23:56.000"^^xsd:dateTime .

