:c_63ed1a1b a skos:Concept;
  skos:definition "Krankenkelch m; lat. calix ad communicandos infirmos; Versehkelchm; lat. calix viaticus: der Kelch zur Spendung des konsekrierten Weines an Kranke (in der Devotions-Kommunion) oder an Sterbende (Viaticum) bei einer Kommunion unter beiderlei Gestalt. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "calice des malades"@fr, "viatic chalice"@en, "Krankenkelch"@de, "calix ad communicandos infirmos"@la;
  skos:altLabel "calix viaticus"@la, "chalice for communion of the sick"@en, "Versehkelch"@de;
  skos:broader :c_aced96c4, :c_06414fbb;
  dct:created "2020-07-28T16:44:27.000"^^xsd:dateTime;
  dct:modified "2021-01-24T13:03:01.000"^^xsd:dateTime .

:c_5889e16e a skos:Concept;
  skos:definition "Krankenpatene f; auch Versehpatene f; Iat. patenellus: ein silber vergoldetes Tellerchen von 66 mm Durchmesser mit einer kreisrunden, durch einen Deckel verschlossenen Vertiefung in der Mitte zur Aufnahme einiger kleiner Hostien. Die Krankenpatene wird in ein Corporale gehüllt, in eine Bursa gelegt und vom Priester bei Versehgängen mitgeführt. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
