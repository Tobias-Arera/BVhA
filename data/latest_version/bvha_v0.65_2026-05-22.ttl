:c_cd3a4921 a skos:Concept;
  skos:definition "Pallium n; ursprünglich ein etwa handbreites, langes Band aus weißer Wolle, mit zwei schwarzen (seltener roten) Kreuzen bestickt; später verkürzt, mit Nadeln gesteckt und mit mehreren Kreuzen verziert; heute ringförmig zusammengenäht und mit sechs schwarzen Kreuzen versehen. Das Pallium wird um die Schultern gelegt getragen, wobei die kurzen, bleibeschwerten und oft mit schwarzer Seide bezogenen Endstücke auf Brust und Rücken herabhängen; es gehört zur erzbischöflichen Pontifikalkleidung. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "pallium"@fr, "pallium"@en, "Pallium"@de, "pallium"@cs;
  skos:altLabel "pall"@en;
  skos:broader :c_cb3125a1, :c_aa790c5e, :c_64dd3656, :c_0a18e053;
  skos:related :c_03b52f24, :c_ca605999, :c_e58c5b19, :c_915fda25;
  dct:created "2020-03-03T13:59:45.000"^^xsd:dateTime;
  dct:modified "2021-01-23T13:48:05.000"^^xsd:dateTime .

:c_134351e7 a skos:Concept;
  skos:definition "Patriarch m; lat. patriarcha: Ehrentitel der Bischöfe auf einem der großen apostolischen Stühle von Rom, Konstantinopel, Alexandria, Antiochia und Jerusalem sowie einiger Erzbischöfe. [Glossarium Artis]"@de;
