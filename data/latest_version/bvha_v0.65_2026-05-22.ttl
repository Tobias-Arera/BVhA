  dct:created "2020-01-22T15:34:48.000"^^xsd:dateTime;
  dct:modified "2021-01-30T23:17:33.000"^^xsd:dateTime .

:c_e071714f a skos:Concept;
  skos:definition "Funeralwaffen (lat. funus = Leichenbegängnis), über einem Rittergrab angebrachte Waffen. Zu ihnen gehört der Totenschild, seit dem 13. Jh. bekannt. [Koch 2009]"@de,
    "Lat. funus= pohřbívání. Zbraně umístěné nad hrobem rytíře, patří k nim také pohřební štít, známý od 13. stol. [Koch 2008]"@cs;
