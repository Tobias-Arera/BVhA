  dct:modified "2021-01-22T12:17:06.000"^^xsd:dateTime .

:c_175c47b9 a skos:Concept;
  skos:definition "Kreuznimbus, Gloriole mit Kreuz um das Haupt Gottvaters, Christi oder der Taube des HI. Geistes. [Koch 2009]"@de,
    "Gloriola s křížem kolem hlavy Boha Otce, Krista, nebo holubice Ducha svatého. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_37522b74,
