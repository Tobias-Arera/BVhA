:c_41fa33ae a skos:Concept;
  skos:definition "Die der Vorhalle (Pronaos) entsprechende Halle zwischen den Anten der Cellarückseite des Doppelantentempels. [Koepf/Binding 2016]"@de,
    "Řec. zadní dům. U řeckého chrámu za cellou. [Koch 2008]"@cs, "Opisthodomos (griech.: Hinterhaus), beim griechischen Tempel der Raum hinter der Cella. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9;
  skos:prefLabel "Opisthodomos"@de, "opistodomos"@cs;
  skos:broader :c_b1fcd379;
  dct:created "2020-08-11T10:46:40.000"^^xsd:dateTime;
  dct:modified "2021-01-21T18:52:37.000"^^xsd:dateTime .

:c_338ae31c a skos:Concept;
  skos:definition "Schmale Halle zur Erschließung der Haupträume mancher antiken Wohnhäuser, öffnet sich zum Hof mit Säulen- oder Pfeilerstellungen. Pastashaus: Olynth; Prostashaus mit Pastas: Priene. [Koch 2009]"@de,
    "Úzká hala sloužící k přístupu do hlavních prostor četných antických obytných domů, vedoucí do nádvoří se sloupořadími a pilíři; pastasový dům: Olynt, prostasový dum s pastasem: Priene. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c8a571d9,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "Pastas"@de, "pastas"@cs;
  skos:broader :c_a7484f12;
  dct:created "2020-08-11T12:27:16.000"^^xsd:dateTime;
  dct:modified "2021-01-27T01:21:29.000"^^xsd:dateTime .

:c_fbe1e9a2 a skos:Concept;
  skos:definition "Andron (gr. Männergemach), Speisesaal für Gastmähler im altgr. Wohnhaus. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
