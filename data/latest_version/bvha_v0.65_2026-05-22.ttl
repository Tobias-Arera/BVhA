:c_3cc6bcc7 a skos:Concept;
  skos:definition "Osirispfeiler, Pfeiler, an dessen Stirnseite Osiris plast. dargestellt war. O. kommen im Neuen Reich Ägyptens vor (Totentempel Ramses\\' II. >Ramesseum< und Totentempel Ramses\\' III. in Theben-Medinet Habu). Sie stehen meist an der dem Königspalast gegenüberliegenden Seite des ersten Tempelhofs. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "pilier osirique"@fr, "Osiris pillar"@en, "Osirispfeiler"@de, "pilar de Osiris"@es;
