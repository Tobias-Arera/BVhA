:c_98e57caf a skos:Concept;
  skos:definition "Findling, errat. Block, durch Gletscher der Eiszeit fortgetragener Gesteinsblock mit abgeschliffener Oberfläche. F.e finden sich hauptsächl. in Norddeutschland, wo sie wegen ihrer Härte gern für Fundamente und im Bruchsteinmauerwerk verwendet werden. [Koepf / Binding 2016]"@de,
    "Feldstein, Klaub-, Lese-, Hand-, Rollstein, vom Boden gelesene oder aus geringer Tiefe gehobene Steine, nicht aber in Steinbrüchen gebrochen, auch Findlinge (Vlint-, Waldstein), kristalline Geschiebe der 2. und 3. Eiszeit von Skandinavien in Bewegung gesetzt und im nördl. Mittel- und Osteuropa abgelagert. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Feldstein"@de, "sbíraný kámen"@cs;
  skos:altLabel "valoun"@cs, "Fundstein"@de, "Findling"@de;
  skos:broader :c_9c69c39b;
  dct:created "2020-08-03T14:51:30.000"^^xsd:dateTime;
  dct:modified "2021-01-22T15:44:41.000"^^xsd:dateTime .

