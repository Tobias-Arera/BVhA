  skos:definition "Gebäude, dessen Fassadengestaltung von Bogenstellungen bestimmt ist. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
