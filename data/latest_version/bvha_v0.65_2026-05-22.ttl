  dct:modified "2021-01-26T23:48:27.000"^^xsd:dateTime .

:c_c985def5 a skos:Concept;
  skos:definition "Dachreiter über einem Giebel. Der G. kommt hauptsächl. bei städt. Profanbauten (Rathäuser u. dergl.) vor. [Koepf / Binding 2016]"@de;
