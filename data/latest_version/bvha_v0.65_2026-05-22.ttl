  dct:created "2020-08-11T10:16:45.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:29:38.000"^^xsd:dateTime .

:c_2e004f61 a skos:Concept;
  skos:definition "Ornamentik des niederländisch-deutschen Manierismus. [Koch 2009]"@de,
    "(Ohrmuschelstil), im 17. Jh. hauptsächl. in den german. Ländern vorkommende, pflanzenähnl. Dekoration, die an Knorpel (Knorpelwerk) bzw. Ohrmuscheln erinnert. [Koepf/Binding 2016]"@de,
    "Ornamentika nizozemsko-německého manýrismu. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_37522b74,
