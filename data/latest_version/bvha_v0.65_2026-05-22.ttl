:c_27e66676 a skos:Concept;
  skos:definition "Hängekrone f; auch Altarkrone f; lat. corona (altari superposita); corona pendens: ein über dem Altar oder über dem Eingang zum Chor hängender, oft mit Perlen und Edelsteinen besetzter Zierreifen, manchmal mit einem Hängekreuz in der Mitte. Hängekronen wurden oft von weltlichen Herrschern gestiftet (Votivkrone f) als Zeichen der Unterwerfung weltlicher Macht unter die göttliche. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "couronne suspendue "@fr, "hanging crown"@en, "Hängekrone"@de, "corona altari superposita"@la;
  skos:altLabel "corona pendens"@la, "pendent crown"@en, "Altarkrone"@de;
  skos:broader :c_0f62a529;
  skos:related :c_wyccl4ls;
  dct:created "2020-07-28T09:51:47.000"^^xsd:dateTime;
  dct:modified "2021-01-31T00:08:35.000"^^xsd:dateTime .

:c_241880a6 a skos:Concept;
  skos:definition "Hängepyxis f; Hängeziborium n: ein über dem Altar hängendes Hostiengefäß, das meist durch eine zeltartige Umhüllung dem Anblick entzogen ist. [Glossarium Artis]"@de;
