:c_dca4fc02 a skos:Concept;
  skos:definition "Der über die Seitenschiffdächer erhöhte, obere Teil (O.wand) des Mittelschiffs einer Basilika, in dem die Hochschifffenster (O.fenster) liegen. [Koepf/Binding 2016]"@de,
    "Horní část stěny s okny nad střední lodí baziliky, níže položený pás oken bočních lodí se nazývá dolní okenní stěna. [Koch 2008]"@cs,
    "Obergaden, Gaden, Lichtgaden; der über die Seitenschiffdächer erhöhte, obere Teil (Obergadenwand) des Mittelschiffs einer Basilika, in dem die Hochschifffenster (Obergadenfenster) liegen. [Koepf / Binding 2016]"@de,
    "Lichtgaden, Obergaden, der obere, durch die Hochschifffenster belichtete Wandabschnitt der Basilika. Die niedriger gelegene Fensterzone der Seitenschiffe heißt Untergaden. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_37522b74;
  skos:prefLabel "claraboya"@es, "clairevoie"@fr, "horní okenní stěna"@cs, "clerestory"@en,
    "claristorio"@it, "Obergadenwand"@de;
  skos:altLabel "étage clair"@fr, "cléristère"@fr, "sobretecho con ventanas laterales"@es,
    "Obergaden"@de, "Lichtgaden"@de, "Gaden"@de;
  skos:broader :c_ab2c77c8;
  dct:created "2020-01-28T14:06:14.000"^^xsd:dateTime;
  dct:modified "2021-01-22T19:43:48.000"^^xsd:dateTime;
  :broaderByPosition :c_ab2c77c8 .

