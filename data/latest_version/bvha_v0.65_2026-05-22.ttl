  skos:prefLabel "Opferputz"@de, "intonaco di sacrificio"@it, "Жертвена мазилка"@bg,
    "sacrificial render"@en, "áldozati vakolat"@hu, "enduit sacrificiel"@fr, "žrtvena žbuka"@hr,
    "mortero de sacrificio"@es, "koruma sıvası"@tr, "intonaco de sacrificiu"@ro, "zaprawa odsalająca"@pl;
  skos:altLabel "tynk tracony"@pl;
  skos:broader :c_9jb9am2u;
