:c_9c076c72 a skos:Concept;
  skos:scopeNote "Schmucksteine, oder Edelsteine, sind meist Minerale, Glasschmelzen, aber auch Stoffe organischer Herkunft wie Bernstein, Pechkohle oder kleinere formschöne Fossilien, die im allgemeinen als schön empfunden werden und zu Schmuck weiterverarbeitet werden. Perlen, Perlmutt und Korallen zählen nach der Definition der Confédération International de la Bijouterie, Joaillerie, Orfèvrerie des Diamantes, Perles et Pierres (CIBJO) auch zu den Schmucksteinen. [CIBJO]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_122038dc;
  skos:prefLabel "Schmuckstein"@de;
  skos:altLabel "Edelstein"@de;
  skos:broader :c_7f3a790b;
  skos:narrower :c_0278a1c2, :c_52077c22, :c_dfef1f2f, :c_024a9b32;
  skos:related :c_26ba1dc1, :c_915fda25, :c_d96146d9;
  dct:created "2020-04-04T17:19:04.000"^^xsd:dateTime;
  dct:modified "2025-11-04T23:23:50"^^xsd:dateTime .

