:c_d8acd826 a skos:Concept;
  skos:definition "Bible moralisée f: im 13. Jh. entstandene, typologisch-moralische Darstellung biblischer Szenen mit zahlreichen Bildern, welche in senkrechten Reihen angeordnet sind. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
