:c_fa78a1c4 a skos:Concept;
  skos:definition "1. Ausfüllung der Balkengefache einer Wand oder Decke mit Stakhölzern, die verflochten und mit Strohlehm umgeben sind. 2. Abkreuzung (Versteifung) von Balken durch kreuzweise angeordnete Stakhölzer (Kreuzstakung). [Koepf / Binding 2016]"@de,
    "Staken: meist gespaltene, halbrunde oder eckige Hölzer.\\n(Eißing et al. 2012)\\n"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe;
  skos:prefLabel "palancon"@fr, "výplň polí příhradoviny lepenicí s pruty a větvemi (pl.)"@cs,
    "pole"@en, "introduzione di torselli fra le travi"@it, "tapiar"@es, "Stake"@de;
  skos:altLabel "stake"@en, "polisson"@fr, "bois de clayonnage"@fr;
  skos:broader :c_6bbae62d, :c_f59d9141, :c_174d6ba6;
  skos:narrower :c_5ff5dad9;
  dct:created "2019-05-28T09:09:03.000"^^xsd:dateTime;
  dct:modified "2021-01-25T11:33:53.000"^^xsd:dateTime .

:c_421824f3 a skos:Concept;
  skos:definition "Lehmwickel: um einen Stecken gewickelte lehmgetränkte Stroh-, Riedgras- oder Schilfhalme. [Eißing et al. 2012]"@de,
    "Strohumwickelte und lehmbeschmierte Staken als Einschub zwischen die Deckenbalken. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_167cb98f;
