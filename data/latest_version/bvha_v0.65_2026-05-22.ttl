:c_4baf157f a skos:Concept;
  skos:definition "Bogen, der aus der Senkrechten heraus vor- oder zurückgeneigt ist, z. B. in einer anlaufenden Mauer oder bei Stichkappen. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "arc biais"@fr, "skew arch"@en, "schräger Bogen"@de;
