  skos:definition "Bilderfries der att. Ionischen Ordnung. [Koepf / Binding 2016]"@de,
    "Řec. nositel figur, figurálně zdobený vlys aticko-iónského a korintského řádu. [Koch 2008]"@cs,
    "Zophoros (griech. Figurenträger), figurengeschmückter Fries der attisch-ionischen und korinthischen Ordnung. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9;
