:c_1865d98e a skos:Concept;
  skos:definition "Bogenförmige Überdeckung einer Türöffnung. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "archway"@en, "arc de porte"@fr, "Torbogen"@de;
