  dct:created "2019-05-28T08:25:28.000"^^xsd:dateTime;
  dct:modified "2021-01-25T11:39:27.000"^^xsd:dateTime .

:c_fa12efc4 a skos:Concept;
  skos:definition "Schräg verlaufendes Holz, das an einem Ende geblattet und am anderen Ende gezapft ist. [Eißing et al. 2012]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_19d56a39;
  skos:prefLabel "Blattstrebe"@de;
