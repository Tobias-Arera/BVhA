:c_1b8982e9 a skos:Concept;
  skos:definition "Sägeschicht, im Mauerverband eine Steinschicht, bei der die Steine in der Art des Ährenwerks, d. h. schräg zur Mauerflucht verlegt sind; tritt eine S. in der Maueransicht in Erscheinung, so bildet sie einen Zahnfries, im norddt. Backsteinbau verbreitet. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Stromschicht"@de, "hilada de ladrillos en espiga"@es, "corso obliquo"@it,
    "úhlopříčně kladená vrstva zdiva"@cs, "diagonal bond"@en;
  skos:broader :c_c4eed245;
  dct:created "2020-08-11T14:58:50.000"^^xsd:dateTime;
  dct:modified "2021-01-29T15:46:47.000"^^xsd:dateTime .

:c_75ea0de4 a skos:Concept;
  skos:definition "Wandparalleles, zumeist auf Konsolen liegendes Holz, das als Auflager für eine Balkenlage dient.  [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_167cb98f;
  skos:prefLabel "Streichbalken (Auflager)"@de, "viga de retallo"@es, "dormiente"@it,
    "krajní rám "@cs, "poutre de bordure"@fr;
  skos:altLabel "poutre de rive"@fr, "linsoir"@fr, "krajní stropnice"@cs, "junta al muro"@es;
  skos:broader :c_993333c6;
  dct:created "2020-08-11T15:04:44.000"^^xsd:dateTime;
  dct:modified "2021-01-22T13:48:33.000"^^xsd:dateTime;
  :broaderByFunction :c_993333c6 .

:c_78a92730 a skos:Concept;
  skos:definition "Folge der Aufhebung der Zünfte im 19. Jh. mit wachsendem Neureichtum in Industrie und Handel durch zahlreiche florierende Firmengründungen in Deutschland, besonders nach dem Sieg von 1871. Sie sucht ihren künstlerischen Ausdruck in der Ablehnung des Klassizismus und in massiv-pompösem, missdeutendem Neubarock (Pariser Oper, Bankgebäude usw.). Der Gründerstil gehört zum Historismus des 19. Jhs. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_8c0441f9;
  skos:prefLabel "Gründerstil"@de;
  skos:altLabel "Gründerzeit"@de;
  skos:broader :c_qojdlphd;
  dct:created "2020-08-11T15:09:53.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:21:22.000"^^xsd:dateTime .

:c_e717d45d a skos:Concept;
  skos:definition "Neugotik, Neogotik, der Gotik nachempfundene Baugestaltung, in England um 1720 beginnend, seit 1750 als »Rokoko-Gotik« = 1. Phase des Gothic Revival in Mode, seit dem späten 18. Jh. als Bestandteil des Historismus in Europa verbreitet und vereinzelt bis in die jüngste Zeit fortlebend. [Koch 2009]"@de,
    "Též novogotika. Ztvárnění staveb v duchu gotiky, zač. kolem r. 1720 v Anglii, od r. 1750 jako „rokoková gotika\" = 1. fáze návratu gotiky, od konce 18. stol. jako součást historismu rozšířena v Evropě a v některých případech přežívá až do poslední doby. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9;
  skos:prefLabel "Neugotik"@de, "neogotika"@cs;
  skos:broader :c_qojdlphd;
  skos:narrower :c_1c99dd75;
  dct:created "2020-08-11T15:20:13.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:21:48.000"^^xsd:dateTime .

:c_1c99dd75 a skos:Concept;
  skos:definition "Middle Pointed style, viktorianische Bezeichnungen für den etwa 1250-1330 herrschenden englischen »Spitzbogenstil«. Er wird in der historisierenden Viktorianischen Neugotik zwischen 1840 und 1870 wiederbelebt als Folge der Schriften von A. Pugin, 1812-52. In der vorangehenden (seit 1820) und nachfolgenden Phase (bis Ende 19. Jh.) wird besonders der Perpendicular style nachgeahmt. [Koch 2009]"@de,
    "Také „middle pointed style\", viktoriánské označení angl. ,,slohu lomeného oblouku\" převládajícího v letech 1250-1330; v době historizující viktoriánské neogotiky 1840-1870 došlo ke znovuoživení tohoto slohu jako důsledek spisů A. Pugina (1812-52); v předcházející (od r. 1820) a v následující fázi (do konce 19. stol.) napodobována především perpendikulární gotika. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9;
  skos:prefLabel "Second Pointed"@de, "second pointed"@cs;
  skos:altLabel "Middle Pointed style"@de;
  skos:broader :c_48bd06fb, :c_e717d45d;
  dct:created "2020-08-11T17:31:01.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:17:05.000"^^xsd:dateTime .

:c_a6794005 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_1f14b4dd;
  skos:prefLabel "rechtsläufiges Hakenkreuz"@de;
  skos:broader :c_38f7356e;
