:c_027faf1b a skos:Concept;
  skos:definition "Läufer, im Mauerwerk der mit seiner Langseite parallel zur Mauerflucht liegende Stein, im Gegensatz zum Binder, dessen kurze Seite (Stirn, Haupt) in der Mauerfläche liegt. [Koepf / Binding 2016]"@de,
    "Běhoun obrací ve zdivu svou podélnou stranu ven. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_37522b74;
  skos:prefLabel "Läufer (Stein)"@de, " soga"@es, "běhoun (kámen)"@cs, " paneresse"@fr,
    "runner (stone)"@en;
  skos:altLabel "hilada"@es, " meule courante"@fr, " mattone di tascia"@it;
  skos:broader :c_2pqtnskw;
  dct:created "2019-05-07T16:56:09.000"^^xsd:dateTime;
  dct:modified "2021-01-29T15:42:31.000"^^xsd:dateTime .

:c_a392afad a skos:Concept;
  skos:definition "Vazník obrací ve zdivu svou úzkou stranu ven. [Koch 2008]"@cs, "Binder, im Mauerverband der mit seiner Schmalseite in der Mauerflucht liegende, in die Mauer >einbindende< Stein, im Gegensatz zum Läufer, dessen Langseite in der Mauerflucht liegt. [Koepf / Binding 2016]"@de;
