:c_93ed38cb a skos:Concept;
  skos:scopeNote "Speisesaal (Refektorium) einer Ordensburg des Deutschordens. [Koepf/Binding 2016]"@de,
    "Remter, refektář v klášteře Řádu německých rytířů. [Koch 2008]"@cs, "Speisesaal. Bei den Deutschordensrittern auch Remter genannt. [Koch 2009]"@de,
    "Speisesaal in einem Kloster. Das R. liegt in der Regel in dem der Kirche gegenüber liegenden Flügel des Kreuzgangs. Neben dem Kapitelsaal ist es bes. in Zisterzienserklöstern baukünstler. gestaltet; der längsrechteckige Raum ist häufig durch eine Säulenstellung und Kreuzgrat- bzw. Kreuzrippengewölbe zweischiffig geteilt und enthält ein Katheder mit Bet- und Lesepult, das auch in einer Mauernische erhöht angeordnet sein kann. Die Zisterzienser hatten im Westflügel der Klausur ein zweites R. für die Konversen. Im späten MA wurde neben dem R. auch ein beheizbares Winter-R. eingerichtet. Im Barock kann der Grundriss auch oval sein. Das R. in den orthodoxen Klöstern ist mit dem Katholikon (Kirche), einem genau bestimmten Bau- und Dekorationsprogramm, der zweitwichtigste Bau. Es liegt unmittelbar gegenüber dem Kirchenhauptportal, auch mit gemeinsamem Narthex. Seltener wird das R. als freistehender Sonderbau an die Klausur angefügt. Es ist ein flachgedeckter, selten gewölbter Saal, der im W in einer Apsis und zwei kleineren, seitl. Nischen für Weihrauch endet. Der Eingang befindet sich an der Ostseite. [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel " refectory"@en, "refektář"@cs, "Refektorium"@de, " réfectoire"@fr,
    " refectorio"@es, "redemtorium"@la, "refettorio"@it;
  skos:altLabel "Remter"@de, "remter"@cs, "jídelna v klášteřích"@cs;
  skos:broader :c_419fa770;
  dct:created "2020-08-06T10:43:09.000"^^xsd:dateTime;
  dct:modified "2021-01-25T16:24:57.000"^^xsd:dateTime .

