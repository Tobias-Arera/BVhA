  dct:modified "2020-01-15T11:49:21.000"^^xsd:dateTime .

:c_f3ee8e9d a skos:Concept;
  skos:definition "Hochbau, dessen runde Eckstäbe zusammen mit den Grund- und den Oberschwellen einen festen Rahmen bilden, in den senkrechte Bohlen eingespundet werden. Die bes. in Skandinavien verbreitete Bauweise erreichte bei den Stabkirchen ihre Vollendung. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "costruzione a traliccio"@it, "stave construction"@en, "Stabbau"@de,
    "construcción empalizada"@es;
  skos:broader :c_4a848d10;
  dct:created "2020-08-14T17:04:40.000"^^xsd:dateTime;
  dct:modified "2020-11-02T14:53:23.000"^^xsd:dateTime .

:c_4dc523cb a skos:Concept;
  skos:definition "Eine meist hölzerne Konstruktion zur Aufnahme großer Lasten bzw. zur Überbrückung großer Spannweiten. Beim S. wird der waagerechte Balken von zwei gegeneinander gelehnten Streben unterstützt. Bei größeren Spannweiten wird zwischen die Streben ein Spannriegel eingefügt. S.konstruktionen finden bei Dachkonstruktionen, v. a. aber bei Brückenbauten Anwendung. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "ferme à contrefiches"@fr, "vzpěradlo"@cs, "strutted frame"@en, "travatura con contraffissi"@it,
    "armadura con tirantes"@es, "Sprengwerk"@de;
  skos:altLabel "assemblage à contrefiches"@fr;
  skos:broader :c_4a848d10;
  skos:related :c_38b9faef;
  dct:created "2020-08-18T11:55:18.000"^^xsd:dateTime;
  dct:modified "2020-11-27T18:02:50.000"^^xsd:dateTime .

:c_38b9faef a skos:Concept;
  skos:definition "Der waagerechte, von Streben verspannte Balken eines Sprengwerks. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "rozpěra"@cs, "faux-entrait"@fr, "straining tie"@en, "briglia di collegarnento"@it,
    "riostra"@es, "Spannriegel"@de;
  skos:altLabel "tirantilla"@es;
  skos:broader :c_f99ea647;
