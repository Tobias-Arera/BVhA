:c_d71a2dfa a skos:Concept;
  skos:definition "Eine von Säulen (Säulenp.), seltener von Pfeilern getragene Vorhalle vor der Hauptfront eines Gebäudes. Bes. häufig kommt die P. in der klassizist. Architektur vor. Auch eine Säulenhalle mit geschlossener Rückwand (ähnlich der Stoa). [Koepf/Binding 2016]"@de,
    "Předstupující část stavby na straně hlavního vchodu, nesená sloupy nebo pilíři, často s trojúhelníkovým štítem, antika, renesance až klasicismus. [Koch 2008]"@cs,
    "Portikus m (lat., ›Säulenhalle‹), ein an den Seiten offener oder geschlossener, von Säulen getragener Raum vor dem Eingang oder der Mitte eines Gebäudes. Der aus dem römischen Tempelbau übernommene P. wird an Schlössern der Barockzeit (Schloss Pillnitz / Dresden S) und des Klassizismus (Schloss Rosenstein / Stuttgart BW) als offene Säulenhalle zur Betonung der Mitte verwendet. B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen]"@de,
    "Vorbau an der Haupteingangsseite, von Säulen oder von Pfeilern getragen, häufig mit Dreiecksgiebel. Antike, Renaissance bis Klassizismus. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9, :conceptScheme_1d7ba54b;
  skos:prefLabel "portikus"@cs, "portico"@en, " portique"@fr, "portico"@it, " pórtico"@es,
    "Portikus"@de;
  skos:broader :c_de30207d;
  skos:narrower :c_8604e637;
  dct:created "2020-01-21T17:14:13.000"^^xsd:dateTime;
  dct:modified "2021-01-22T13:55:08.000"^^xsd:dateTime;
  :broaderByShape :c_de30207d .

