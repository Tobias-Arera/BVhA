:c_xh1ezgu0 a skos:Concept;
  skos:definition "Steinernes Gehäuse zur Aufbewahrung der geweihten Hostie, meist auf der Evangelienseite neben dem Altar. Vergitterte Nische oder - in der Gotik - freistehendes zierliches Gebäude auf einem Sockel, mit reichem Gesprenge, bis 28 m hoch (Ulm). Das Tridentinum, 1545-63, ordnet die Unterbringung der Hostie im Tabernakel auf dem Altar an und macht das Sakramentshaus überflüssig. Das 2. Vaticanum, 1962-65, lässt seinen Gebrauch wieder zu. [Koch 2009]"@de,
    "SVATOSTÁNEK, kamenná schránka k uchovávání posvěcené hostie, většinou na evangelijní straně vedle oltáře; zamřížovaná nika, nebo - v gotice - samostatná ozdobná stavba na soklu s bohatým nástavcem, až 28 m vysoká (Ulm). Tridentský koncil (1545-63) nařídil uchovávat hostii v tabernáklu na oltáři, čímž se svatostánek stal zbytečný, Druhý vatikánský koncil (1962-65) jeho použití opět povolil. [Koch 2008]"@cs,
    "Sakramentshaus, ein turmartiges Bauwerk, das aus einem Fuß, einem Überleitungselement (Korb), dem Gehäuse und einem bekrönenden Baldachin besteht, seltener nur eine Wandnische (Sakramentsnische) an der Nordwand des Chorraums. Das S. diente zur Aufbewahrung der Hostien, Kelche und liturg. Gefäße und wurde in spätgot. Zeit bes. prunkvoll ausgebildet. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "Sakramentshaus"@de, "tabernacle"@fr, "svatostánek"@cs, "tabernacle"@en,
    "edicola del sacramento"@it, "sagrario"@es;
  skos:altLabel "tabernákl"@cs;
  skos:broader :c_0f62a529;
  skos:related :c_028abf0f, :c_e8b8196b;
  dct:created "2019-09-24T16:03:41.000"^^xsd:dateTime;
  dct:modified "2021-01-31T00:18:18.000"^^xsd:dateTime .

:c_pnlagwip a skos:Concept;
  skos:scopeNote "Kommentar. Im Unterschied zum Farbstoff, der im zugefügten flüssigen Material löslich ist, bleibt das Pigment in der Trägerflüssigkeit unlöslich und wird stattdessen in einer Suspension gehalten. Pigmente können nach Farbe, chemischer Zusammensetzung oder Herkunft (natürlich oder synthetisch) klassifiziert werden. [EwaGlos]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ef0a8695, :conceptScheme_ec8c77bf;
  skos:prefLabel "Pigment"@de, "pigment"@en;
  skos:altLabel "Farbkörper"@de;
  skos:note "Any relatively insoluble organic or inorganic, coloured or uncoloured powder, used as a colourant by the addition of a fluid material or binder. [EwaGlos]"@en,
    "Jedes unlösliche, organische oder anorganische, farbige oder farblose Pulver, das als Farbmittel verwendet wird, indem flüssiges Material oder Bindemittel zugefügt wird. [EwaGlos]"@de;
  skos:broader :c_028dc319;
  skos:narrower :c_34df71dd, :c_2d757dba, :c_4106aca3, :c_60b9ca7a, :c_818418bc, :c_175776bc;
  dct:created "2019-06-11T19:59:23.000"^^xsd:dateTime;
  dct:modified "2021-01-30T15:33:08.000"^^xsd:dateTime .

