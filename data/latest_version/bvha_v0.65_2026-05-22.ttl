:c_237462c0 a skos:Concept;
  skos:definition "Osterkerze f; lat. cereus paschalis: eine große, reich verzierte und mit fünf Weihrauchkörnern (Symbol der Wunden Christi) besteckte Wachskerze (seit 5. Jh.). Sie steht in der Osterzeit beim Hochaltar und brennt während der Messe. Früher wurde sie am Himmelfahrtsfest nach der Lesung aus dem Evangelium gelöscht und entfernt; jetzt geschieht dies erst am Abend des Pfingstfestes als dem Ende der Osterzeit. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "cierge pascal"@fr, "Paschal candle"@en, "Osterkerze"@de, "cereus paschalis"@la;
  skos:altLabel "Easter candle"@en;
  skos:broader :c_65b847bf;
  skos:related :c_50b90d6b, :c_f592f958;
  dct:created "2020-07-28T17:47:57.000"^^xsd:dateTime;
  dct:modified "2021-01-26T21:09:41.000"^^xsd:dateTime .

