  dct:created "2020-02-25T15:10:18.000"^^xsd:dateTime;
  dct:modified "2021-01-24T15:39:20.000"^^xsd:dateTime .

:c_0095e4ea a skos:Concept;
  skos:definition "Reliquiar n, redendes: ein Reliquienbehälter, dessen Form auf den in ihm enthaltenen Körperteil oder Gegenstand hinweist, z. B. Armreliquiar, Fußreliquiar und Rippenreliquiar. [Glossarium Artis]"@de;
  skos:scopeNote "Der Terminus \"redendes Reliquiar\" wird von der aktuellen Forschung kritisch betrachtet, da sog. \"redende Reliquiare\" nicht unbedingt Reliquien der Körperteile enthalten, die durch das Reliquiar abgebildet werden. Beispiel: Barbarossakopf, Cappenberg. Alternativ wird der Terminus \"Körperteilreliquiar\" verwendet. [S. Schmidt]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "reliquaire parlent"@fr, "topical reliquary"@en, "redendes Reliquiar"@de;
  skos:altLabel "reliquaire topique"@fr, "speaking reliquary"@en;
  skos:broader :c_b9eb688f;
  skos:related :c_2e3d5fc3, :c_7f2e2699;
  dct:created "2020-09-03T20:40:03.000"^^xsd:dateTime;
  dct:modified "2020-09-03T20:52:26.000"^^xsd:dateTime .

:c_7f2e2699 a skos:Concept;
  skos:definition "Statuenreliquiar n; auch Reliquienstatue f: eine Ganzkörperfigur, in der sich Reliquien befinden; in der Regel die Relikte des Dargestellten. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "statue-reliquaire"@fr, "statue-reliquary"@en, "Reliquienstatue"@de;
  skos:altLabel "Statuenreliquiar"@de;
  skos:broader :c_b9eb688f;
  skos:related :c_2e3d5fc3, :c_0095e4ea;
  dct:created "2020-09-24T19:08:13.000"^^xsd:dateTime;
  dct:modified "2020-09-24T19:10:29.000"^^xsd:dateTime .

:c_ff1964fa a skos:Concept;
  skos:definition "Röhrenreliquiar n; auch Zylinderreliquiar n: ein liegender oder stehender, meist auf einem Gestell montierter KristallzyIinder, in dem sich Reliquien befinden. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "reliquaire à cylindre"@fr, "reliquary with cylinder"@en, "Röhrenreliquiar"@de;
  skos:altLabel "Zylinderreliquiar"@de, "reliquair with cylinder"@en;
  skos:broader :c_b9eb688f, :c_b8a55fa4;
  dct:created "2020-02-25T15:12:36.000"^^xsd:dateTime;
  dct:modified "2021-01-24T15:56:37.000"^^xsd:dateTime .

:c_ae7d443e a skos:Concept;
  skos:definition "Scheibenreliquiar n: 1. eine dünne, oft als Vierpass geformte und mit Blattgold bekleidete Holzscheibe mit einem Behälter für die Reliquie in der Mitte (seit 12. Jh.). Beispiel: das Reliquiar des hl. Franz von Assisi in Limoges, um 1228. 2. eine Reliquienmonstranz mit rundem Schaugefäß. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "reliquaire discoïdal"@fr, "disc-shaped reliquary"@en, "Scheibenreliquiar"@de;
  skos:broader :c_b9eb688f, :c_b8a55fa4;
  dct:created "2020-02-25T15:13:01.000"^^xsd:dateTime;
  dct:modified "2021-01-24T15:56:50.000"^^xsd:dateTime .

:c_0258a8f2 a skos:Concept;
  skos:definition "Turmreliquiar n; lat. turris: ein von Türmchen und Fialen flankiertes Schaugehäuse mit einer Reliquie. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "tourelle-reliquaire"@fr, "turret-reliquary"@en, "Turmreliquiar "@de;
  skos:altLabel "reliquaire à tourelles"@fr;
  skos:broader :c_b8a55fa4, :c_00ddac7b;
  dct:created "2020-09-23T19:12:29.000"^^xsd:dateTime;
  dct:modified "2021-01-24T15:57:03.000"^^xsd:dateTime .

:c_00ddac7b a skos:Concept;
  skos:definition "Reliquiar n, architektonisches: ein Reliquienbehältnis, das die Form eines Sakralbaues hat oder in einer entsprechenden Fassung untergebracht ist. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "reliquaire architectural "@fr, "architectural type of a reliquary"@en,
    "architektonisches Reliquiar"@de;
  skos:broader :c_b9eb688f;
  skos:narrower :c_2d0b73c7, :c_0258a8f2, :c_16727c46;
  dct:created "2020-09-01T19:42:40.000"^^xsd:dateTime;
  dct:modified "2020-09-03T20:39:34.000"^^xsd:dateTime .

:c_83f353c5 a skos:Concept;
  skos:definition "Kopfreliquiar n; auch Hauptreliquiar n; Schädelreliquiar n; lat. caput; capitum: ein Reliquienbehälter in Gestalt des Hauptes eines Heiligen, oft nahezu in Lebensgröße, manchmal aber auch als Miniatur. Beispiel: die Häupter von 29 hl. Jungfrauen in St. Andreas zu Basel. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8;
  skos:prefLabel "chef-reliquaire"@fr, "head-reliquary"@en, "Kopfreliquiar"@de, "caput"@la;
  skos:altLabel "capitum"@la, "Hauptreliquiar"@de, "Schädelreliquiar"@de;
  skos:broader :c_2e3d5fc3;
  dct:created "2020-02-25T15:11:07.000"^^xsd:dateTime;
  dct:modified "2021-01-24T15:55:57.000"^^xsd:dateTime .

:c_3134d8af a skos:Concept;
  skos:definition "Büstenreliquiar n; auch Reliquienbüste f; Brustreliquiar n: ein in der Regel aus Edelmetall gefertigtes, mit kostbaren Steinen geschmücktes plastisches Brustbild, das Reliquien des Dargestellten birgt; neben dem Brustbild waren auch Halbfiguren und halbe Doppelfiguren gebräuchlich. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "bust-reliquary"@en, "buste-reliquaire"@fr, "Büstenreliquiar"@de;
  skos:altLabel "Reliquienbüste"@de, "Brustreliquiar"@de;
  skos:broader :c_2e3d5fc3;
  dct:created "2020-02-25T15:11:13.000"^^xsd:dateTime;
  dct:modified "2021-01-24T15:54:40.000"^^xsd:dateTime .

:c_42d5541f a skos:Concept;
  skos:definition "Armreliquiar n; auch Brachiarium n; lat. brachium; brachialium: ein Reliquienbehälter in Gestalt eines Armes mit Hand. Man unterscheidet das einärmelige und das seltener vorkommende, aus zwei übereinander liegenden Armen bestehende doppelärmelige Armreliquiar (seit 10. Jh.). [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "Armreliquiar"@de, "relikviář paže"@cs, "bras-reliquaire"@fr, "brachium"@la,
    "arm-reliquary"@en;
  skos:altLabel "reliquaire en bras"@fr, "Brachiarium"@de, "brachialium"@la;
  skos:broader :c_2e3d5fc3;
  skos:narrower :c_78fbacc7, :c_bc39b3bd;
  dct:created "2020-02-25T15:11:19.000"^^xsd:dateTime;
  dct:modified "2021-01-24T15:39:35.000"^^xsd:dateTime .

:c_0ca3e75f a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8;
  skos:prefLabel "Ganzkörperreliquiar"@de;
  skos:broader :c_2e3d5fc3;
