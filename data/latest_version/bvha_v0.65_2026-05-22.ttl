:c_abbae577 a skos:Concept;
  skos:definition "Alles, was in den Bauhütten des Mittelalters für den Kathedralbau im Sinne der Bauplastik geschaffen wurde. Dazu muss man auch die Bauplastik seit der frühen Romanik zählen, die noch meist von Mönchen stammt. In Frankreich mehr auf Portal und Fassade, in Deutschland stärker in die Kirche hinein verlagert. [Koch 2009]"@de,
    "Vše, co bylo vytvořeno ve středověkých stavebních hutích pro stavbu katedrál ve smyslu architektonické plastiky. K tomu je třeba připočíst raně románskou architektonickou plastiku, kterou ještě většinou vytvářeli mniši; ve Francii více na portálu a průčelí, v Německu více v interiéru kostela. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "Hüttenskulptur"@de, "hutní skulptura"@cs;
  skos:altLabel "Hüttenplastik"@de, "hutní plastika"@cs;
  skos:broader :c_54244140;
  dct:created "2020-08-05T13:41:39.000"^^xsd:dateTime;
  dct:modified "2021-01-30T23:03:08.000"^^xsd:dateTime .

:c_85430700 a skos:Concept;
  skos:definition "Wasserbecken im Atrium des römischen Wohnhauses. [Koch 2009]"@de,
