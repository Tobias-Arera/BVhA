:c_541e0193 a skos:Concept;
  skos:definition "Glasziegel, Glaspfanne, Dachziegel aus Glas zur Belichtung eines Dachbodens. Der G. hat die Form normaler Dachziegel, um genau im Verband eingesetzt werden zu können. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Glasziegel"@de;
  skos:broader :c_7becmxjs;
