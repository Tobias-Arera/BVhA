:c_de80f1c2 a skos:Concept;
  skos:definition "Eine Bauwerksoberfläche ist die geometrisch definierte Grenzfläche eines → Bauwerkselements oder einer → Bauwerkskomponente, die als topologisches Interface angrenzende architektonische → Räume definiert, voneinander trennt oder miteinander vermittelt. [BVhA, Tobias Arera-Rütenik]"@de,
    "A structural surface is the geometrically defined boundary surface of a → structural element or → structural component that acts as a topological interface defining, separating or mediating adjacent architectural → spaces. [BVhA, Tobias Arera-Rütenik]"@en;
  skos:scopeNote "Eine Grenzfläche, die als räumliches Interface wirkt."@de, "A boundary surface acting as a spatial interface."@en;
  skos:example "Beispiele sind → Fassaden, → Wandflächen, → Dachflächen oder → Laibungen."@de,
    "Examples include → façades, → wall surfaces, → roof surfaces or → reveals."@en;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe;
  skos:prefLabel "povrch "@cs, "Bauwerksoberfläche"@de, "structural surface"@en;
  skos:altLabel "Architekturfläche"@de, "Oberfläche"@de;
  skos:broader :c_e10016de;
  skos:narrower :c_73f6375a, :c_c8df0cc0, :c_4bd3aa19, :c_053a6f99, :c_94c0de9d, :c_40a320cd,
    :c_4badff1b, :c_6a63acb6, :c_edf64b50, :c_3e9f23db, :c_411ed726;
  dct:created "2020-12-08T13:34:23"^^xsd:dateTime;
  dct:modified "2026-03-31T15:38:39"^^xsd:dateTime;
  :formsPartOfType :c_1b21ae94, :c_6d1689d0;
  :shortNote "Eine Grenzfläche, die als räumliches Interface wirkt."@de, "A boundary surface acting as a spatial interface."@en .

