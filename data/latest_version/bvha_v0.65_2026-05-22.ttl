  dct:created "2019-10-16T10:33:04.000"^^xsd:dateTime;
  dct:modified "2025-11-04T22:40:13"^^xsd:dateTime .

:c_e275aea3 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ef0a8695;
  skos:prefLabel "Farbstoff"@de;
  skos:broader :c_028dc319;
  dct:created "2020-05-18T12:47:19.000"^^xsd:dateTime;
  dct:modified "2021-01-30T15:32:43.000"^^xsd:dateTime .

:c_e8a68dff a skos:Concept;
  skos:definition "Ein in Alkohol oder Terpentin gelöstes pflanzliches Farbmittel, das zur Patinierung und Lasierung dient. [Schrader / Voigt 2003]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_5bf6bcac, :conceptScheme_ef0a8695;
  skos:prefLabel "Aloe"@de;
  skos:broader :c_028dc319;
  dct:created "2020-11-20T16:43:39.000"^^xsd:dateTime;
  dct:modified "2021-01-30T15:32:28.000"^^xsd:dateTime .

:c_3abd0746 a skos:Concept;
  skos:definition "Tempera-Malerei (lat. temperare = im Mittelalter Bezeichnung für das Mischen von Farben und Bindemittel), gelöst in Wasser oder Öl oder Lack. Bindemittel: Eigelb, Honig, Leim, Feigenmilch usw. Bis zum 15. Jh. für fast alle mittelalterlichen Tafelbilder (auf Holztafeln, besonders Altartafeln), dann allmählich von Ölmalerei verdrängt. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_8c0441f9;
  skos:prefLabel "Temperamalerei"@de;
  skos:broader :c_7acece55;
  dct:created "2020-05-18T13:29:37.000"^^xsd:dateTime;
  dct:modified "2021-01-18T14:01:44.000"^^xsd:dateTime .

:c_5c24d03f a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8;
  skos:prefLabel "Pastellmalerei"@de;
  skos:broader :c_7acece55;
  dct:created "2020-05-18T13:29:48.000"^^xsd:dateTime;
  dct:modified "2021-01-18T14:01:12.000"^^xsd:dateTime .

:c_3b7818fa a skos:Concept;
  skos:definition "Aquarellmalerei (lat. aqua = Wasser), lasierende Malereitechnik (lässt den Grund durchscheinen) mit wasserlöslichen Farben ohne Weiß. Bindemittel: Gummi arabicum. Am Bau für Fresko-Malerei (sh. dort). [Koch 2009]"@de,
    "Akvarel (lat. aqua = voda), průhledná malba (prosvěcuje podklad) vodou ředitelnými barvami kromě bílé, pojivo: arabská guma, v architektuře při malbě fresek. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9;
  skos:prefLabel "Aquarellmalerei"@de, "akvarel"@cs;
  skos:broader :c_7acece55;
  dct:created "2020-05-18T13:30:05.000"^^xsd:dateTime;
  dct:modified "2021-01-18T13:58:58.000"^^xsd:dateTime .

:c_9b3850f1 a skos:Concept;
  skos:definition "Das farbige »Fassen« = Bemalen bzw. Vergolden von Stein- und Holzplastiken, um sie zu schmücken und zu konservieren. Das Holz wird vor dem Fassen mit Gips- oder Kreidegrundierung oder mit Leinwand überzogen, gelegentlich auch direkt mit Ölfarbe bemalt. Die Fassmalerei ist mit wenigen Ausnahmen (Riemenschneider!) bis zum Ende des Barocks allgemein üblich und der Beruf des Fassmalers entsprechend verbreitet. [Koch 2009]"@de,
    "Pomalování, resp. pozlacení kamenných a dřevěných plastik sloužící jejich výzdobě a konzervaci; před malbou se dřevo potáhlo podkladem ze sádry nebo křídy, příp. plátnem, v některých případech Je přímo pomalováno olejovou barvou. Štafírování bylo až na výjimky zcela běžné až do konce baroka a povolání štafíře bylo velmi rozšířené. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9;
  skos:prefLabel "Fassmalerei"@de, "štafírování"@cs;
  skos:broader :c_7acece55;
  dct:created "2020-08-05T09:34:19.000"^^xsd:dateTime;
  dct:modified "2021-01-18T13:59:24.000"^^xsd:dateTime .

:c_3e966bbf a skos:Concept;
  skos:definition "Gouache-Malerei (ital. guazzo = Lache, Wasser), wasserlösliche Deckfarben (mit Weiß), mit Gummi gebunden. [Koch 2009]"@de,
    "Ital. guazzo = louže, voda), krycí barvy ředitelné vodou (včetně bílé), pojivo: arabská guma. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9;
  skos:prefLabel "Gouachemalerei"@de, "kvaš"@cs;
  skos:broader :c_7acece55;
  dct:created "2020-08-05T12:19:41.000"^^xsd:dateTime;
  dct:modified "2021-01-18T13:59:46.000"^^xsd:dateTime .

:c_0a6636f8 a skos:Concept;
  skos:definition "Grisaille (frz. gris = grau), Malerei aus grauen Farbtönen, häufig zur raffiniert vorgetäuschten Darstellung von Plastiken und Stuck verwendet. [Koch 2009]"@de,
    "Franc. gris = šedý. Malba v šedých barevných tónech, často rafinovaně předstírající plastiky nebo štuk. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9;
  skos:prefLabel "Grisaille"@de, "grisaille"@cs;
  skos:broader :c_7acece55;
  dct:created "2020-08-05T12:35:26.000"^^xsd:dateTime;
  dct:modified "2021-01-18T13:59:53.000"^^xsd:dateTime .

:c_fc121fad a skos:Concept;
  skos:definition "Lackmalerei (Lack: indisch lakh = 100.000, gemeint ist die Vielzahl der Lackschildläuse, die Bäume zur Schellackabsonderung veranlassen), Lösung von harzigen Bindemitteln (Kolophonium, Kopal, Kunstharze) und Öl (bei Öllack) in flüchtigen Ölen (Terpentinöl) oder Ersatzstoffen. Trocknet ähnlich wie Ölfarbe. In China seit 1. Jahrtausend v. Chr., in Europa seit 17. Jh. nachgeahmt. Viele Techniken. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_8c0441f9;
  skos:prefLabel "Lackmalerei"@de, "laková malba"@cs;
  skos:broader :c_7acece55;
  dct:created "2020-08-06T12:12:56.000"^^xsd:dateTime;
  dct:modified "2021-01-18T14:00:10.000"^^xsd:dateTime .

:c_faaf9c18 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8;
  skos:prefLabel "Malerei auf Holz"@de;
  skos:broader :c_7acece55;
  skos:narrower :c_be46c0fa;
  dct:created "2020-10-27T12:30:37.000"^^xsd:dateTime;
  dct:modified "2021-01-18T14:00:27.000"^^xsd:dateTime .

:c_2882bcb6 a skos:Concept;
  skos:definition "Lüstertechnik:Malen mit durchscheinenden Farben und Goldimitation mit Hilfe von Goldlacken über Zinn schildern Theophilus [2] I, 27 und Heraclius III, 13 [1, S. 221] für die Malerei. Außenlüsterung beschreibt Watin: „Ist das Gold oder das Silber auf die Mixtion (das Goldanlegeöl) getragen, und trocken geworden, so koloriere man den Gegenstand ... mit solchen Farben, die eine Lasur gewähren. Also (roter) Lack für Rosenfarbe, Berlinerblau für Blau, Schüttgelb, Berlinerblau und Grünspan für das Grün, Schüttgelb und Kölner Erde (van Dyckbraun) für die Fugen, Schatten etc. Alle diese Farben haben keinen Bestand, sie lasieren folglich Gold und Silber und beides in ihrer Grundfarbe transparent. Man reibe sie mit Nußöl ab und vermische sie dann mit gutem fettem Leinöl und Terpentinessenz(öl).“ Die Technik ist unter Verwendung von Gold und Silber als Unterlage sowohl in Poliment- als in Öltechnik bis ins 19. Jh. gleich geblieben mit zarten rosa Lüsterungen. Vom MA bis zum Barock dominierten Lüsterungen in den einfachen Grundfarben Lackrot und Kupfergrün (das Blau ist stets vergrünt), mit der Entdeckung des Berlinerblau zu Beginn des 18. Jh. kamen leuchtend blaue und vielfach nuancierte Lüsterungen auf. Mitunter trennte man korrespondierende Metallpartien, indem silberne Teile zartblau, goldene dagegen grün konturiert wurden. Typisch für die 1. H. 18. Jh. sind blau gelüsterte Säulen im Farbton des Lapis Lazuli; Hochaltarretabel in der Klosterkirche Rheinau, 1723). [RDK Labor]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_cf792a3c;
  skos:prefLabel "Lüstertechnik"@de;
  skos:broader :c_7acece55;
  dct:created "2020-12-19T16:48:38.000"^^xsd:dateTime;
  dct:modified "2021-01-18T14:00:19.000"^^xsd:dateTime .

:c_eb0f6a4b a skos:Concept;
  skos:definition "Sie spielt eine Rolle bei der F. von Retabeln (vor allem im Barock) und konnte lokalfarbig bunt, doch auch in sehr differenzierten Tonabstufungen ausgeführt sein. In Rücksichtnahme auf den Aufstellungsort der Bildwerke wurde sie unterschiedlich aufgebaut. Cröker S. 136–38 schildert folgende Techniken: Leim-F.: 1. Leimtränke, 2. Kreidegrund, für blauen Marmor 3. eine Kreide-Indigo-Mischung, 4. darüber weißer Anstrich, 5. wie 3., 6. Durchschaben der weißen Adern mit einem Messer, 7. Glättung mit Schachtelhalm, 8. Politur mit einem Zahn, 9. buntere Marmorierung sollte mit rotem Kugellack und Schüttgelb schattiert werden; Öl-F. für „nasse Orte“: 1. Tränkung mit warmem Leinöl und Firnis, zwei- bis dreimal, 2. Ölfarbengrundierung, 3. F. in Ölfarbe. – Ähnliche Arbeitsvorgänge gelten weißer Marmor-F. Die Marmorierung von Lackarbeiten schildert Cröker S. 269. Ein eigenartiges Rezept für Danziger grüne Koffer und Schatullen gibt er S. 110: auf einen Anstrich von Leim und Schwarz wird mit dem Pinsel eine Mischung von Leim, Kreide und Schwefel aufgespritzt und diese nach dem Trocknen mit Grünspan und Leinölfirnis lackiert. Genau diese Effekte zeigen Retabel Ivo Strigels. [RDK Labor]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_cf792a3c;
  skos:prefLabel "Marmorierung"@de;
  skos:broader :c_7acece55;
  dct:created "2020-12-19T17:06:43.000"^^xsd:dateTime;
  dct:modified "2021-01-18T14:00:42.000"^^xsd:dateTime .

:c_04442aef a skos:Concept;
  skos:definition "Gewölbe, in dem Flechtrippen die bestimmende Rippenfiguration sind. Außer den Scheitelrippen sind meist auch Diagonalrippen vorhanden. (Glossarium Artis)"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "lierne vaulting"@en, "voûte à liernes et à tiercerons doublés"@fr,
    "Flechtrippengewölbe"@de;
  skos:altLabel "tierceron vault"@en, "tierceron star vault"@en, "voûte d\\'ogives à liernes et à tiercerons doublés "@fr;
  skos:broader :c_b505b3b9;
  dct:created "2019-10-16T11:28:22.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:46:30.000"^^xsd:dateTime;
  :broaderByShape :c_b505b3b9 .

:c_ae4e93a2 a skos:Concept;
  skos:definition "Opěrný stavební prvek s kruhovým, polygonálním nebo jinak profilovaným průřezem, původně nesl kladí, od římských dob také zdi nad oblouky, a byl používán i dekorativně, bez nosné funkce. Může stát samostatně, nebo je předsazený před pilíř nebo zeď, z nichž jen částečně vystupuje (čtvrtsloup, polosloup, tříčtvrteční sloup). Při větší výšce, ale menším průřezu se nazývá přípora. Základními součástmi jsou patka, dřík a hlavice, funkčně nezbytný je však pouze dřík. Může se zužovat směrem nahoru nebo dolů, mít entázi, nebo neměnnou tloušťku. Jednotlivé názvy odrážejí jeho tvary nebo seskupení: 1. monolitický sloup (z jednoho kusu), 2. sloup složený z tamburů (bubnovitých částí), 3. krétský (zužuje se směrem dolů), 4. kanelovaný (se svislými výžlabky, viz kandování), 5. přepásaný (s jedním nebo několika prstenci na dříku), 6.stáčený (tordovaný, spirálově zatočený,) 7. zauzlený, 8. hadovitý, 9. zoomorfní s šelmami, 10. kandelábrový (a jiné renesanční sloupy), 11. sdružené sloupy, 12. svazkový sloup. [Koch 2008]"@cs,
    "Einer Wand direkt aufgelegter Bogen; ein Dekorationsmotiv zur Wandgliederung. [Glossarium Artis]"@de,
    "Ein der Mauer dekorativ oder gliedernd vorgebauter Bogen, der jedoch keine Maueröffnung umschließt. Oft zur Blendarkade gereiht. [Koch 2009]"@de,
    "Blendbogen, ein Bogen, der keine Maueröffnung überbrückt und nicht als konstruktiver Entlastungsbogen in der Mauerfläche liegt, sondern der geschlossenen Wand nur vorgeblendet, d.h. aufgelegt ist. Der B. ist bes. in der roman. und got. Baukunst ein beliebtes Mittel zur Wandgliederung. In erweitertem Sinne wird der Begriff B. auch für eine Blendarkade verwendet. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9, :conceptScheme_1f14b4dd;
  skos:prefLabel "Blendbogen"@de, "arco mural de refuerzo"@es, "slepý oblouk"@cs, "arc aveugle"@fr,
    "blind arch"@en;
  skos:altLabel "čelní oblouk"@cs, "arc en orbevoie"@fr, "arc incorporé"@fr, "arc engagé"@fr,
    "arc mural"@fr, "blinder Bogen"@de, "Wandbogen"@de;
  skos:broader :c_eea5235b, :c_804ab319;
  dct:created "2019-10-16T14:06:27.000"^^xsd:dateTime;
  dct:modified "2021-01-22T19:33:52.000"^^xsd:dateTime;
  :broaderByPosition :c_eea5235b .

