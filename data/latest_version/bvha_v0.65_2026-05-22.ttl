:c_a8e4c4be a skos:Concept;
  skos:definition "Petrus-Kreuz, Petrus wurde kopfunter gekreuzigt. [Koch 2009]"@de,
    "Petruskreuz n; auch gestürztes Kreuz n: ein lateinisches Kreuz, dessen Querbalken im unteren Drittel des Kreuzstammes liegt. Diese Kreuzform wird nur in Verbindung mit dem Martyrium des Apostels Petrus dargestellt, der seinem Wunsch gemäß kopfüber gekreuzigt worden war. [Glossarium Artis]"@de,
    "Sv. Petr byl ukřižován hlavou dolů. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "croix de Saint-Pierre"@fr, "St. Peter\\'s cross"@en, "Petruskreuz"@de,
    "svatopetrský kříž"@cs;
  skos:altLabel "gestürztes Kreuz"@de;
