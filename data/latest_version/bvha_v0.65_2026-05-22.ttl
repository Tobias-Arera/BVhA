  skos:narrower :c_f375b47f;
  dct:created "2020-08-03T16:11:10.000"^^xsd:dateTime;
  dct:modified "2021-01-25T11:49:11.000"^^xsd:dateTime .

:c_121bfadb a skos:Concept;
  skos:definition "Ein kleiner Altarraum, der im Obergeschoss eines Bauwerks erkerartig aus der Mauerflucht auskragt und auf Konsolen oder einem Stützpfeiler ruht, er gehört zu einer Hauskapelle in Burgen, Pfalzen, Kurien, Patrizierhäusern, Rathäusern, aber auch zu sakralen Bauten wie Karnern, Klöstern oder Spitälern. In roman. Zeit ist das C. halbrund, in got. Zeit dreiseitig, seit der Spätgotik und in der Renaissance auch rechteckig. [Koepf / Binding 2016]"@de,
    "Vyvinul se z oltářního prostoru v hradní kapli (církev zakazuje, aby nad oltářem byly umístěny obytné místnosti); v době pozdní gotiky, renesance a neobaroka (19. stol) byl arkýř zvláště oblíben jako okrasný prvek domu. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_37522b74;
  skos:prefLabel "Chörlein"@de, "chórek"@cs;
  skos:broader :c_6975d802, :c_70f41797, :c_6d7fd588;
  dct:created "2020-08-04T09:48:27.000"^^xsd:dateTime;
  dct:modified "2021-01-22T12:27:20.000"^^xsd:dateTime .

:c_6d7fd588 a skos:Concept;
  skos:definition "Hauskapelle, private Kapelle eines Bürger- oder Patrizierhauses, die meist in einem Obergeschoss liegt. Sie springt manchmal in einem polygonalen Chörlein (Kapellenerker) über die Außenwand vor. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "Hauskapelle"@de, "cappella domestica"@it;
  skos:altLabel "Oratorium (Kapelle)"@de;
  skos:broader :c_b5206255;
  skos:narrower :c_121bfadb;
  dct:created "2020-07-23T12:43:56.000"^^xsd:dateTime;
  dct:modified "2021-01-22T12:35:37.000"^^xsd:dateTime;
  :broaderByPosition :c_b5206255 .

:c_76555515 a skos:Concept;
  skos:definition "Eine Reihe von Königsfiguren, wahrscheinlich Vorfahren Christi, die quer über die Westfassade einiger französischer und englischer Kathdralen verläuft. [Koch 2009]"@de,
    "Soch králů, patrně předků Kristových, která je umístěna napříč západní fasádou některých francouzských a anglických katedrál. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9;
  skos:prefLabel "Königsgalerie"@de, "královská galerie"@cs;
  skos:broader :c_6975d802;
  dct:created "2020-08-06T10:53:42.000"^^xsd:dateTime;
  dct:modified "2021-01-25T12:21:32.000"^^xsd:dateTime .

:c_0e9cca0e a skos:Concept;
  skos:definition "Freistehendes, offenes Maßwerk vor einer Wand oder Nische. [Koch 2009]"@de,
    "Samostatná volně stojící kružba před stěnou nebo nikou, anglická kružba. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9;
  skos:prefLabel "rideau de pierre"@fr, "Schleierwerk"@de, "tracería velada"@es, "závojová kružba"@cs;
  skos:altLabel "blind tracery"@en;
  skos:broader :c_6975d802;
  dct:created "2020-08-18T11:26:18.000"^^xsd:dateTime;
  dct:modified "2021-01-25T12:28:00.000"^^xsd:dateTime .

:c_0c1e821b a skos:Concept;
  skos:definition "Eine Blendtür im letzten Raum einer Mastaba, meist mit der Statue des Toten geschmückt. Hinter der S. führt ein Schacht in die eigentl. Grabkammer. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "porte feinte"@fr, "falešné dveře"@cs, "false door"@en, "fausse porte"@it,
    "puerta falsa"@es, "Scheintür"@de;
  skos:altLabel "slepé dveře"@cs, "zdánlivé dveře"@cs;
  skos:broader :c_6975d802, :c_c7343d66;
  dct:created "2020-08-20T15:10:21.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:33:10.000"^^xsd:dateTime .

:c_c6e285bf a skos:Concept;
  skos:definition "Ein in der röm. Antike und in der  Renaissance häufig vorkommender Architekturaufbau, bei dem die Bogen zwischen den Wandsäulen, die ein den Bogenscheitel berührendes Gebälk tragen, stehen. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Säulenbogenstellung"@de, "disposición de arcos entre columnas"@es;
  skos:altLabel "travée romaine"@fr;
  skos:broader :c_6975d802;
  dct:created "2020-08-21T11:31:57.000"^^xsd:dateTime;
  dct:modified "2021-01-25T12:27:27.000"^^xsd:dateTime .

:c_64362135 a skos:Concept;
  skos:definition "Band, 1. ein waagerechtes, mehr oder weniger ausladendes Bauglied mit rechteckigem Querschnitt zur horizontalen Gliederung, meist in Verbindung mit Hohlkehle, Rundstab und dergl. ein Gesims bildend. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Band (Gliederung)"@de;
  skos:broader :c_6975d802;
  dct:created "2020-08-25T12:16:49.000"^^xsd:dateTime;
  dct:modified "2021-01-25T11:48:01.000"^^xsd:dateTime .

:c_178f413c a skos:Concept;
  skos:definition "Blendrosette, Wandgliederung in Form einer Fensterrose ohne Maueröffnung (Blendfenster). [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Blendrosette"@de;
  skos:broader :c_6975d802;
  dct:created "2020-08-28T11:06:28.000"^^xsd:dateTime;
  dct:modified "2021-01-25T11:48:55.000"^^xsd:dateTime .

:c_61e8f2ab a skos:Concept;
  skos:definition "Vorspringender Dreiecks- oder Segmentgiebel über einem Fenster, urspr. zur Entlastung und vielleicht auch als Regenschutz gedacht, dann nur noch dekorativ angewandt, bes. zur Fassadengliederung an Palastbauten der ital. Renaissance (Fensterverdachung). [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_50ec0c5e, :conceptScheme_c8a571d9;
  skos:prefLabel "Fenstergiebel"@de;
  skos:broader :c_6975d802, :c_d6e98810;
  dct:created "2020-09-14T12:28:55.000"^^xsd:dateTime;
  dct:modified "2021-01-25T11:56:46.000"^^xsd:dateTime;
  :broaderByPosition :c_d6e98810 .

:c_baad22f3 a skos:Concept;
  skos:definition "(mhd.) Ein in die Mauer oder einen Pfeiler eingemauerter Stein, der als Auflager dient. Im Gegensatz zur Konsole bleibt er meist ohne Schmuck und hat mehr bautechnische Aufgaben. K.e dienen den Deckenbalken, teilweise auch den Dachsparren als Auflager oder tragen den Hocheingang eines Bergfrieds. Häufig sind auch Aborterker auf K.e aufgesetzt. B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen]"@de,
    "Kamenný nosník, který podpírá vystupující stavební prvky. [Koch 2008]"@cs, "Ein vorkragender Stein, der eine Last (Gurtbogen, Dienst, Rippe, Plastik etc.) aufnehmen kann. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_37522b74,
    :conceptScheme_1f14b4dd, :conceptScheme_1d7ba54b;
  skos:prefLabel "Kragstein"@de, "corbeau (pierre)"@fr, "corbel (stone)"@en, "krakorec"@cs;
  skos:altLabel "Tragstein"@de, "trusse"@fr, "tasseau"@fr, "pierre d\\'attente"@fr;
  skos:broader :c_9c69c39b;
  skos:narrower :c_964b67ec;
  skos:related :c_4ac7d139, :c_nskxcexd;
  dct:created "2020-03-05T16:35:37.000"^^xsd:dateTime;
  dct:modified "2021-01-22T15:45:43.000"^^xsd:dateTime;
  :broaderByFunction :c_9c69c39b .

:c_a5fccf1b a skos:Concept;
  skos:definition "Abkragung, Absenker, Gewölberippen aufnehmende Wandvorlagen (Dienst) werden auf Konsolen abgefangen, bes. in Zisterzienserkirchen, nicht nur zur Aufstellung von Chorgestühlen, sondern auch um den Wandcharakter des Pfeilers zu wahren. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Abkragung"@de;
  skos:altLabel "Absenker"@de;
  skos:broader :c_f415b5e9;
