:c_8b1ce8d2 a skos:Concept;
  skos:definition "Zentralbau über dem Grundriss eines regelmäßigen Achtecks. [Koepf/Binding 2016]"@de,
    "Řec. osmiúhelník. Objekt s půdorysem ve tvaru pravidelného osmiúhelníku, staroorientální a antický symbol dokonalosti kosmu: Atény, Věž větrů; Split, mauzoleum; Albenga, baptisterium; Cáchy, palácová kaple; Castel del Monte. [Koch 2008]"@cs,
    "Oktogon (griech. Achteck), Bauwerk, das über einem regelmäßigen Achteck errichtet ist. Altorientalisch-antikes Symbol für die Vollendung des Kosmos (Athen, Turm der Winde; Spalato, Mausoleum; Albenga, Baptisterium; Aachen, Pfalzkapelle; Castel del Monte). [Koch 2009]"@de,
    "Das regelmäßige A. (gr. Oktogon) ist eine wichtige geometr. Figur und wurde bei Zentralbauten als Grundrissfigur verwendet. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_c8a571d9, :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel " octogone"@fr, "oktogon (stavba)"@cs, " octagon"@en, " ottagono"@it,
    "octógono"@es, "Oktogon (Gebäude)"@de;
  skos:broader :c_040da54a;
  skos:related :c_b2ddfa45;
  dct:created "2020-08-18T12:36:04.000"^^xsd:dateTime;
  dct:modified "2021-01-27T14:21:45.000"^^xsd:dateTime .

