  dct:modified "2020-09-30T09:41:10.000"^^xsd:dateTime .

:c_04d502d8 a skos:Concept;
  skos:definition "Pyramidendach, über vieleckigem oder quadrat. Grundriss errichtetes, allseitig abgewalmtes Dach, dessen Flächen zu einer Spitze anstelle des Firsts zusammenlaufen. [Koepf / Binding 2016]"@de,
    "Jehlanový tvar, všechny valbové plochy se stýkají v jednom vrcholovém bodu, půdorys je čtvercový, obdélníkový, polygonální, při velké výšce ve vztahu k délce okapu se nazývá jehlanová střecha. [Koch 2008]"@cs,
    "Pyramidendach, die allseitigen Walmflächen treffen sich in einem Firstpunkt; quadratischer, rechteckiger, vieleckiger Grundriss. Bei großer Höhe im Verhältnis zur Traufenlänge heißt es Turmdach. [Koch 2009]"@de;
  skos:scopeNote "Pyramidendach, Zeltdach, Dach in Pyramidenform. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "comble en pavillon"@fr, "stanová střecha"@cs, "tent roof"@en, " tetto a piramide"@it,
    "techo piramidal"@es, "Pyramidendach"@de;
  skos:altLabel " comble pyramidal"@fr, " toit pyramidal"@fr, "pyramid roof"@en, "Zeltdach"@de,
    "Dachpyramide"@de, "pyramidová střecha"@cs;
  skos:broader :c_f4e2bee8;
  skos:narrower :c_7a0c6f8a;
  dct:created "2019-02-18T20:03:17.000"^^xsd:dateTime;
  dct:modified "2020-11-24T07:42:24.000"^^xsd:dateTime;
  :broaderByShape :c_f4e2bee8 .

:c_7a0c6f8a a skos:Concept;
  skos:definition "Eine besondere Form des Pyramidendaches ist das Spiraldach (gedrehter Helm), dessen Grate gewunden zur Spitze verlaufen. [Eißing et al. 2012]    "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_19d56a39;
  skos:prefLabel "Spiraldach"@de, "spirálová střecha"@cs;
  skos:broader :c_04d502d8;
  dct:created "2019-05-22T13:28:26.000"^^xsd:dateTime;
  dct:modified "2020-07-30T19:30:54.000"^^xsd:dateTime .

