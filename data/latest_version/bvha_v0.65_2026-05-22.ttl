  dct:modified "2021-01-19T13:21:10.000"^^xsd:dateTime .

:c_2bc45707 a skos:Concept;
  skos:definition "Die vordere Ansichtsfläche eines halboffenen oder offenen Gewölbes. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
