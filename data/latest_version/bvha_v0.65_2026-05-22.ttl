:c_3b2d288b a skos:Concept;
  skos:definition "Flachrelief, Basrelief, plast. Komposition, die sich schwach über den Hintergrund erhebt. [Koepf / Binding 2016]"@de,
    "Relief mit versenktem Hintergrund. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
