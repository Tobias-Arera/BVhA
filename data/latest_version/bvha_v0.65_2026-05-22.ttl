:c_157ae051 a skos:Concept;
  skos:definition "Lothringer Kreuz n: ein Kreuz mit zwei gleich langen Querbalken, die den Standbalken in drei gleiche Abschnitte gliedern. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346;
  skos:prefLabel "croix de Lorraine"@fr, "cross of Lorraine"@en, "Lothringer Kreuz"@de,
