:c_fcf03751 a skos:Concept;
  skos:definition "Dreikönigsreliquien f pl: die Gebeine der hl. Drei Könige, die von der Kaiserin Helena in der Stadt Saba entdeckt und nach Konstantinopel verbracht worden sein sollen. Kaiser Konstantin überließ sie dem Bischof von Mailand. Reinald von Dassel, der Reichskanzler Friedrich Barbarossas und Erzbischof von Köln, überführte sie 1164 in den Kölner Dom, wo sie im Dreikönigsschrein ruhen. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "reliques des Roies Mags"@fr, "relics of the Three Kings"@en, "Dreikönigsreliquie"@de;
  skos:broader :c_47d05be1;
  skos:related :c_da7e1cd3;
  dct:created "2020-09-25T17:57:41.000"^^xsd:dateTime;
