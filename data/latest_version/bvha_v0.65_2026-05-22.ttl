:c_5b12fab8 a skos:Concept;
  skos:definition "Heilsspiegel m, Speculum humanae salvationis n: Buch mit Text und Bilderfolgen (Holzschnitten), in dem das Erlösungswerk Christi dem Alten Testament typologisch gegenübergestellt wird; im 14. und 15. Jh. sehr verbreitet. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "miroir du Salut"@fr, "zrcadlo lidského spasení"@cs, "Heilsspiegel"@de;
  skos:altLabel "Speculum humanae salvationis"@de, "Speculum humanae salvationis"@fr;
  skos:broader :c_abf8ae8c;
  skos:related :c_42f07927, :c_239666df;
  dct:created "2020-05-26T17:34:36.000"^^xsd:dateTime;
  dct:modified "2021-01-23T16:20:31.000"^^xsd:dateTime .

:c_499e6829 a skos:Concept;
  skos:definition "Beim Steinguss wird ein Bildwerk aus pulverisiertem (meist Kalk-)Stein gegossen, so z.B. in der (süddeutschen) Spätgotik. [Koch 2009]"@de,
    "Guss von Bauteilen (Gewölberippen etc.) und Bildhauerarbeiten aus einer Masse aus Steinmehl und Bindemittel in Negativformen, v.a. um 1400 verbreitet. [Koepf / Binding 2016]"@de,
    "V případě kamenolitu se socha odlévá z práškového kamene (většinou vápence), např. v (jihoněmecké) pozdní gotice. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9;
  skos:prefLabel "Steinguss"@de, "fundición de piedra"@es, "kamenolit"@cs, "scultura a stampo"@it,
    "casting of imitated stone"@en;
  skos:altLabel "stucco"@it, "piedra colada"@es;
  skos:broader :c_d997b1c2;
  dct:created "2020-08-03T15:26:16.000"^^xsd:dateTime;
  dct:modified "2020-11-02T16:44:52.000"^^xsd:dateTime .

:c_12fa4eac a skos:Concept;
  skos:definition "Niello heißt eine Metallgravur, die mit erhitztem Schwefelsilber, Kupfer oder Blei ausgefüllt wird. [Koch 2009]"@de,
    "Kovová rytina, která je vyplněna horkým sirným stříbrem, mědí nebo olovem. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_37522b74,
