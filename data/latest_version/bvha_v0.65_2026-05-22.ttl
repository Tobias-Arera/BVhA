:c_799bd533 a skos:Concept;
  skos:definition "Verehrt werden auch die sogenannten Johannesschüsseln (f pl). Es handelt sich dabei um Schalen, die der seit dem 6. Jh. in der Grabeskirche zu Jerusalem aufbewahrten Schale nachgebildet wurden, auf der Salome das Haupt Johannes des Täufers ihrer Mutter Herodias überbracht haben soll (Mt 14,12). [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "Johannesschüssel"@de;
