:c_fc304d3c a skos:Concept;
  skos:definition "Querdach, quer zum Hauptfirst verlaufendes Dach, z.B. beim Zwerchhaus. [Koch 2009]"@de,
    "Vikýřová stříška procházející napříč k hlavnímu hřebenu střechy, např. u zastřešeného vikýře s obytným prostorem. [Koch 2008]"@cs,
    "Ein Dachaufbau in Flucht der Traufwand, dessen First quer zum First des Hauptdaches verläuft, heißt Querdach oder Zwerchdach. Liegt seine Traufe oberhalb der Traufe des Hauptdaches, so dass eine Seitenwand ausgebildet wird, spricht man vom Zwerchhaus. [Eißing et al. 2012]"@de,
    "Zwerchdach, 1. Lukarne. 2. Querdach, ein senkrecht zum Hauptdach ausgerichtetes, kleineres Dach, bes. bei got. Seitenschiffen verwandt, wo über jedem Joch ein Walm- oder Satteldach aufsitzt und sich damit eine Reihung ergibt, auch vereinzelt angewandt, dort auch als Ziergiebel. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9, :conceptScheme_19d56a39;
  skos:prefLabel "Zwerchdach"@de, "boční stříška"@cs;
  skos:altLabel "nižší příčná střecha se štítem u okapu sedlové střechy"@cs;
  skos:broader :c_f4e2bee8;
  skos:related :c_63d013eb;
  dct:created "2019-05-18T12:32:32.000"^^xsd:dateTime;
  dct:modified "2020-12-01T14:35:58.000"^^xsd:dateTime;
  :broaderByPosition :c_f4e2bee8 .

