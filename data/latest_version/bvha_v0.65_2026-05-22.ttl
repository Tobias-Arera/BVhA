:c_9e126cc6 a skos:Concept;
  skos:definition "Der Unterbau eines Gebäudes, einer Säule oder einer Statue. [Koepf / Binding 2016]"@de,
    "Lat. socculus = botka. 1. Spodní část zdiva, často oddělená soklovou římsou. 2. Podstavec sloupu, pilíře, sochy. [Koch 2008]"@cs,
    "Sockel (lat. socculus = kleiner Schuh), 1. unterer Mauerteil, oft durch ein Sockelgesirns (Gesims) abgesetzt; 2. Unterbau von Säule, Pfeiler, Skulptur. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "piédouche"@fr, "sokl"@cs, "pedestal"@en, "zoccolo"@it, "zócalo"@es,
    "Sockel"@de;
  skos:altLabel "socle"@fr, "podnož"@cs, "podezdívka"@cs;
