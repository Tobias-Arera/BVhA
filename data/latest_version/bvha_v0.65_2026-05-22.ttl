:c_61144b01 a skos:Concept;
  skos:definition "Altenteil, auch Auszug, Ausgedinge, Abnahme, Abschied, Leibzucht genannte, mehr oder weniger abgesonderte Räume für die Unterbringung der Alten im Bauernhaus, auch als Altenteilerhaus innerhalb des Hofs gebaut. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_c8a571d9;
  skos:prefLabel "Altenteil"@de;
