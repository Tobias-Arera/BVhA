:c_ea2aea7b a skos:Concept;
  skos:definition "Bei Holzverbindungen der Einschnitt eines Holzes, in den sich der Ausschnitt des anderen einfügt, z.B. Blattsasse. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Sasse"@de;
