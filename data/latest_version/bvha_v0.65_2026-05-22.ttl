:c_242f9f1a a skos:Concept;
  skos:definition " Saal, dessen längere Achse quer zur Hauptachse verläuft, z.B. die Säulensäle ägypt. Tempel (Tempelbau) und islam. Moscheen, german. Königshallen, Thermen u. dergl. [Koepf/Binding 2016]"@de,
    "Příčná místnost, sál, jehož příčná osa je delší než osa hlavní, např. ve falci, hradním paláci, mešitě. [Koch 2008]"@cs,
    "Querraum, ein Saal, dessen Querachse länger als die Hauptachse ist, z.B. in Pfalz; Palas; Moschee. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9;
  skos:prefLabel " salle transversale"@fr, "příčný sál"@cs, "transverse hall"@en, "sala transversale"@it,
    " sala transversal"@es, "Quersaal"@de;
  skos:altLabel "Querraum"@de;
  skos:broader :c_9b659a9d;
  dct:created "2020-08-11T14:10:22.000"^^xsd:dateTime;
  dct:modified "2021-01-21T18:35:17.000"^^xsd:dateTime .

:c_13ee3b31 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c8a571d9;
