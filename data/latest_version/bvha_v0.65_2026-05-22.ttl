:c_e3b4a571 a skos:Concept;
  skos:definition "Ein falsches Gewölbe aus unbehauenen, in Mörtel gebetteten Steinen (Pläner = in Platten brechender Bruchstein). [Koepf/Binding 2016]"@de,
    "Gewölbe aus Bruchsteinen, die grob keilförmig behauen und teilweise in Mörtel gebettet sind. [Glossarium Artis] "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "bóveda falsa"@es, "voûte en blocage"@fr, "klenba z lomového kamene"@cs,
    "rustic vault"@en, " falsa volta"@it, "Bruchsteingewölbe "@de;
  skos:altLabel "rubble vault"@en, "ragwork vault"@en, "voûte en pierres de carrière "@fr,
    "voûte en moellons bruts"@fr, "Plänergewölbe "@de;
  skos:broader :c_049c4c22;
  dct:created "2019-12-12T15:22:17.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:03:00.000"^^xsd:dateTime;
  :broaderByConstructionMaterial :c_049c4c22 .

:c_ef9286b9 a skos:Concept;
  skos:definition "Gewölbe über dem Chor einer Kirche, häufig ein mehrteiliges Kreuzgewölbe oder eine HaIbkuppel (Konche). [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "voûte du chevet"@fr, "apsidial vault"@en, "Chorhauptgewölbe"@de;
  skos:altLabel "Chorgewölbe "@de, " chevet vault "@en;
  skos:broader :c_049c4c22;
  dct:created "2019-12-12T15:24:25.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:03:17.000"^^xsd:dateTime;
  :broaderByPosition :c_049c4c22 .

:c_bc7b15b0 a skos:Concept;
  skos:definition "Gewölbe, das ein anderes Gewölbe in seiner Tragfunktion unterstützt und ihm also Lasten abnimmt. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "voûte de décharge"@fr, "discharging vault"@en, "Entlastungsgewölbe "@de;
  skos:altLabel "buttressing vault"@en;
  skos:broader :c_049c4c22, :c_a1443df3;
  dct:created "2019-12-12T15:31:25.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:13:09.000"^^xsd:dateTime;
  :broaderByFunction :c_049c4c22 .

:c_a1443df3 a skos:Concept;
  skos:definition "Gewölbe von untergeordneter Bedeutung, z.B. das Entlastungsgewölbe. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "voûte secondaire"@fr, "secondary vault"@en, "Nebengewölbe "@de;
  skos:broader :c_049c4c22;
  skos:narrower :c_bc7b15b0, :c_a80163c1;
  skos:related :c_80dac5bf;
  dct:created "2019-12-12T16:24:58.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:41:35.000"^^xsd:dateTime;
  :broaderByFunction :c_049c4c22 .

:c_80dac5bf a skos:Concept;
  skos:definition "Gewölbe, das neben anderen eine dominierende Stellung einnimmt, z.B. das Mittelschiffsgewölbe im Unterschied zu den Seitenschiffsgewölben. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "maîtresse-voûte"@fr, "main vault"@en, "Hauptgewölbe "@de;
  skos:altLabel "voûte principale"@fr, "voûte maîtresse"@fr;
  skos:broader :c_049c4c22;
  skos:related :c_a1443df3;
  dct:created "2019-12-12T16:00:30.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:22:45.000"^^xsd:dateTime;
  :broaderByFunction :c_049c4c22 .

:c_50ba1b47 a skos:Concept;
  skos:definition "Flüstergewölbe, Flüstergalerie, Bezeichnung für einen überwölbten Raum, in dem an einer Stelle geflüsterte Worte durch Reflexion an einer entfernten Stelle deutl. vernehmbar sind, während sie im übrigen Raum nicht und aus der Nähe kaum gehört werden. Diese Erscheinung kann zufällig sein oder auf einer raffiniert ausgeklügelten Planung beruhen (meist ellipt. Raumbegrenzungen, Sprecher und Hörer in den Brennpunkten). [Koepf / Binding 2016]"@de,
    "Gewölbe, dessen meist elliptische Begrenzungen Schallwellen reflektieren, so dass selbst ein leise gesprochenes Wort an entfernter Stelle im Raum deutlich hörbar ist. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_1f14b4dd;
  skos:prefLabel "voûte à écho"@fr, "whispering gallery"@en, "Flüstergewölbe "@de;
  skos:altLabel "voûte acoustique"@fr, "whispering dome"@en, "Klanggewölbe "@de, "Schallgewölbe "@de,
    "Echogewölbe"@de, "Sprachgewölbe"@de;
  skos:broader :c_049c4c22;
  dct:created "2019-12-12T15:33:43.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:13:36.000"^^xsd:dateTime;
  :broaderByFunction :c_049c4c22;
  :broaderByShape :c_049c4c22 .

:c_a0acee21 a skos:Concept;
  skos:definition "Unter der Erdgleiche liegendes Gewölbe, das als Unterbau für ein Gebäude dient. Zu unterscheiden vom Gegengewölbe. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "voûte de soubassement"@fr, "foundation vault"@en, "Fundamentgewölbe "@de;
  skos:altLabel "Grundgewölbe"@de, "Erdgewölbe "@de, "Gründungsgewölbe"@de;
  skos:broader :c_049c4c22;
  dct:created "2019-12-12T15:37:45.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:13:48.000"^^xsd:dateTime;
  :broaderByFunction :c_049c4c22 .

:c_5a9e3c16 a skos:Concept;
  skos:definition "Falsches Gewölbe, das von bogenförmigen oder geraden, gegeneinander gestemmten Stützbalken aus Stein gebildet wird. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "vault formed of beams"@en, "voûte en poutres"@fr, "gestemmtes Gewölbe"@de;
  skos:altLabel "voûte en linteaux échancrés"@fr, "voûte en poutres courbes"@fr, "vault formed of curved beams "@en;
  skos:broader :c_053d8697;
  dct:created "2019-12-12T15:40:49.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:50:56.000"^^xsd:dateTime;
  :broaderByConstruction :c_053d8697 .

:c_053d8697 a skos:Concept;
  skos:definition "Ein nicht aus Wölbsteinen gespanntes Gewölbe, zumeist aus Stuck oder Putzmörtel auf einem hölzernen Putzträger in Gewölbeform, seit der Mitte des 16. Jhs. verbreitet, bes. im Barock im 20. Jh. als untergehängtes Drahtgewebe (Rabitzgewebe). [Koepf / Binding 2016]"@de,
    "Eine nicht mit Wölbsteinen errichtete, jedoch einem Gewölbe gleichende Raumabdeckdung. [Glossarium Artis] "@de,
    "Unechtes Gewölbe, aus vorkragenden Steinschichten errichtetes Gewölbe. [Koch 2009]"@de,
    "Ein Gewölbe, das nur aus vorkragenden Steinen mit horizontalen Parallelfugen gemauert ist. [Koepf / Binding 2016] "@de,
    "Falsches Gewölbe, unechtes Gewölbe, horizontal aufgeschichtete Steinlagen, bei denen die jeweils folgende Schicht über die darunter befindl. auskragt und, zumeist ohne Mörtelbindung, ein unechtes Gewölbe erzeugt, bes. bei vor- und frühgeschichtl. Bauten im Mittelmeerraum. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_8c0441f9, :conceptScheme_1f14b4dd;
  skos:prefLabel "bóveda falsa"@es, "fausse voûte"@fr, "přečnělková klenba"@cs, "false vault"@en,
    "pseudovolta"@it, "Scheingewölbe"@de;
  skos:altLabel "blind vault"@en, "finta volta"@it, "unechtes Gewölbe"@de, "Pseudogewölbe"@de,
    "falsches Gewölbe"@de, "fingiertes Gewölbe "@de, "nepravá klenba"@cs, "falešná stropní klenba"@cs;
  skos:broader :c_049c4c22;
  skos:narrower :c_5a9e3c16, :c_b7d8c4dd, :c_4ac7d139, :c_8fdb50da, :c_022ba419;
  dct:created "2020-04-23T17:03:52.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:50:41.000"^^xsd:dateTime;
  :broaderByConstruction :c_049c4c22 .

:c_4e64402f a skos:Concept;
  skos:definition "Ebene, jedoch aus Keilsteinen gebildete Decke, vorwiegend über Fenstern oder Türen vorkommt. Es werden die für das echte Gewölbe üblichen Mauerverbände ausgeführt. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "voûte plate clavée"@fr, "flat vault"@en, "scheitrechtes Gewölbe"@de;
  skos:altLabel "plafond appareillé"@fr, "flaches Gewölbe"@de;
  skos:broader :c_049c4c22;
  dct:created "2019-12-12T15:55:12.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:52:20.000"^^xsd:dateTime;
  :broaderByConstruction :c_049c4c22 .

:c_28f3262e a skos:Concept;
  skos:definition "Gewölbe, das aus einer Gussmasse (Bruchstein in Mörtel eingebettet) besteht, die auf ein geschlossenes Lehrgerüst aufgebracht und dann durch eine Vormauerung verschalt wird. Bereits in römischer Kaiserzeit wurden weitgespannte Gewölbe dieser Art errichtet. [Glossarium Artis] "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "voûte coulée"@fr, "vault constructed of a brick shell covered with poured concrete "@en,
    "Gußmauergewölbe"@de;
  skos:altLabel "Gußgewölbe "@de;
  skos:broader :c_049c4c22;
  dct:created "2019-12-12T15:57:48.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:18:20.000"^^xsd:dateTime;
  :broaderByConstructionMaterial :c_049c4c22 .

:c_c876ba4d a skos:Concept;
  skos:definition "Gewölbe, das aus sorgfältig behauenen Natursteinen gefügt ist. [Glossarium Artis] "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "voûte en pierres de taille"@fr, " vauIt constructed of ashIars "@en,
    "Hausteingewölbe"@de;
  skos:broader :c_049c4c22;
  dct:created "2019-12-12T16:03:38.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:23:06.000"^^xsd:dateTime;
  :broaderByConstructionMaterial :c_049c4c22 .

:c_b7d8c4dd a skos:Concept;
  skos:definition "Gezimmertes Scheingewölbe, das den Eindruck eines echten Gewölbes erwecken soll. Man kann vor allem zwei Konstruktionsarten unterscheiden: Bei bogenförmiger Dachkonstruktion richtet sich die Gewölbeform nach dem Dachwerk oder aber das Gewölbe ist unabhängig von der Form des Dachwerks und wird in den Dachraum hochgezogen, dort eingehängt, gelattet und stuckiert. Das Holzgewölbe hat gegenüber dem Gewölbe aus Stein den Vorteil, dass auf der Lattendecke der Kalkputz zur Aufnahme der Freskogemälde besser haftet. [Glossarium Artis] "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "voûte en bois"@fr, "wooden vault"@en, "Holzgewölbe "@de;
  skos:broader :c_053d8697, :c_2623d3ff;
  skos:narrower :c_14d7eb62;
  dct:created "2019-12-12T16:04:49.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:39:14.000"^^xsd:dateTime;
  :broaderByConstructionMaterial :c_053d8697, :c_2623d3ff .

:c_2623d3ff a skos:Concept;
  skos:definition "Gewölbe von geringem Gewicht, z.B. aus porösem Naturstein. [Glossarium Artis] "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "voûte légère"@fr, "light-weight vault"@en, "Leichtgewölbe"@de;
  skos:broader :c_049c4c22;
  skos:narrower :c_b7d8c4dd, :c_6fdbbcb5, :c_3c4d43e8, :c_186ea4ad;
