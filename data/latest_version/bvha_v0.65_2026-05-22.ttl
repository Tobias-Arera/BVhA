:c_8d51703e a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_ec8c77bf;
  skos:prefLabel "palimpsest"@en, "palimpsest"@cs, "Palimpsest"@de;
  skos:note "Plaster and painting layers preserved under an existing wall painting. [EwaGlos]"@en,
    "Putz- und Malschichten, die unter einer bestehenden Wandmalerei erhalten geblieben sind. [EwaGlos]"@de;
  skos:broader :c_592dc406;
  dct:created "2019-07-24T18:54:40.000"^^xsd:dateTime;
