:c_51ee4840 a skos:Concept;
  skos:definition "Tempelform (vor allem der römischen Antike), bei der eine Ringhalle durch Säulen oder Halbsäulen an den Wänden der  Cella ersetzt wird. [Koch 2009]"@de,
    "(gr. falscher Peripteros), Tempel mit Wandsäulen anstelle eines Säulenkranzes. [Koepf/Binding 2016]"@de,
    "Typ chrámu (především v římské antice), kde je ochoz nahrazen sloupy nebo polosloupy na stěnách celly (Nimes), pseudodipteros (Magnesia). [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "Pseudoperipteros"@de, "pseudoperipteros"@cs;
  skos:broader :c_d91b6895;
  dct:created "2020-08-10T17:06:46.000"^^xsd:dateTime;
  dct:modified "2020-10-14T15:56:26.000"^^xsd:dateTime .

:c_ccc7d5e7 a skos:Concept;
  skos:definition "(gr. falscher Dipteros), 1. Tempel mit Wandsäulen (Pseudoperipteros) und umgebendem Säulenkranz. 2. Tempel mit doppeltbreitem Pteron, jedoch ohne die innere Stützenreihe eines Dipteros. [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
