  dct:modified "2021-01-25T15:50:29.000"^^xsd:dateTime .

:c_c72b7354 a skos:Concept;
  skos:definition "Eine  Konstruktion,  auf  der  ein Putz, eine Grundierung mit anschließender Farbschicht oder nur eine Farbschicht aufgetragen wird. Sie hat einen relativ ebenen Untergrund für die Malerei zu bilden, sie zu tragen und ihr Stabilität zu verleihen. [EwaGlos]"@de,
    "A structure on which a plaster or a ground with a subsequent paint layer, or just a paint layer, are applied. Its function is to provide a more or less even substratum for the painting, to carry it, and to give it physical stability. [EwaGlos]"@en;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_ec8c77bf;
  skos:prefLabel "support"@en, "Träger"@de;
  skos:altLabel "Bildträger"@de, "Putzträger"@de, "image carrier"@en;
  skos:broader :c_592dc406, :c_ab388abe;
  skos:narrower :c_8c21b07a, :c_50c7bdfe;
  dct:created "2019-05-07T17:53:16.000"^^xsd:dateTime;
  dct:modified "2021-01-25T15:54:58.000"^^xsd:dateTime .

