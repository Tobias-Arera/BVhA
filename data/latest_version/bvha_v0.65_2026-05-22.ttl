:c_6d1689d0 a skos:Concept;
  skos:definition "Eine Bauwerkskomponente ist die kleinste baulich identifizierbare sowie geometrisch und materiell fassbare Einheit innerhalb → expliziter baulicher Einheiten. Sie erfüllt eine begrenzte Teilfunktion und bildet die unmittelbar zusammensetzenden Bausteine eines → Bauwerkselements. [BVhA, Tobias Arera-Rütenik]"@de,
    "A structural component is the smallest built unit that can be identified and described geometrically and materially within → explicit built units. It fulfils a limited sub-function and forms the immediate building blocks of a → structural element. [BVhA, Tobias Arera-Rütenik]"@en;
  skos:scopeNote "Die kleinste funktionstragende bauliche Einheit innerhalb eines → Bauwerkselements."@de,
    "The smallest function-bearing built unit within a → structural element."@en;
  skos:example "Beispiele sind → Mauerwerksquader, → Säulentrommeln, → Kapitelle, → Profilglieder oder einzelne → Balken."@de,
    "Examples include → masonry blocks, → column drums, → capitals, → profile elements or individual → beams."@en;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_50ec0c5e, :conceptScheme_c8a571d9, :conceptScheme_167cb98f;
  skos:prefLabel "Bauwerkskomponente"@de, "structural component"@en;
  skos:altLabel "Bauwerkseinzelelement"@de;
  skos:broader :c_e10016de;
  skos:narrower :c_1a0d89ef, :c_bb13d443, :c_cdfab687, :c_3e25acca, :c_e14684ea, :c_24f6ab7f,
    :c_6bbae62d, :c_381f9e69, :c_4de0216a, :c_09462c92, :c_e46f17d9, :c_f4be0496, :c_d3971ceb,
    :c_bc441b2c, :c_e39b6c90, :c_ff300c4e, :c_9f6f4d68, :c_ed9d8fa3, :c_b8147738, :c_83195a38,
    :c_74e816e3, :c_bd6d14c6, :c_e4696b7d;
  dct:created "2020-12-15T10:16:18"^^xsd:dateTime;
  dct:modified "2026-03-31T15:34:14"^^xsd:dateTime;
  :formsPartOfType :c_1b21ae94, :c_689a00a2;
  :isComposedOfType :c_de80f1c2;
  :shortNote "Die kleinste funktionstragende bauliche Einheit innerhalb eines → Bauwerkselements."@de,
    "The smallest function-bearing built unit within a → structural element."@en .

