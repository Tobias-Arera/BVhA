:c_6c04f937 a skos:Concept;
  skos:definition "Crocia f, it.: von Kardinälen im Konklave und seit dem 16. Jh. von Angehörigen der römischen Kurie getragener, weiter Mantel mit halblangen, weiten Ärmeln und Kapuze, gefertigt aus scharlachrotem bzw. violettem Wollstoff, mit gleichfarbiger Seide gefüttert, am Kragen und an den Ärmeln mit Hermelin besetzt. Die Crocia wird vorne mit Bändern aus Spitze geschlossen, die den Nacken kragenartig umgeben und lang herunterhängen. Vor 1969 gehörte sie zur Kleidung der Sondergesandten des Papstes. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "crocia"@fr, "crocia"@en, "Crocia"@de;
  skos:broader :c_97eb3f17;
  skos:related :c_9f74e321, :c_b7584b90, :c_d5e19558, :c_e58c5b19;
  dct:created "2020-06-18T10:10:42.000"^^xsd:dateTime;
  dct:modified "2021-01-24T18:09:49.000"^^xsd:dateTime .

