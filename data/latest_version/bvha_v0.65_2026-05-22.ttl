:c_8c4d0a6c a skos:Concept;
  skos:definition "Bohlenwand, eine aus Bohlen bestehende Wand zwischen rechtwinklig miteinander verbundenem Fachwerkgerüst, d. h. Schwelle, Ständer und Rähm. Die Bohlen sind dicht aneinandergefügt, sie bilden die Wandfüllung, seitl. in Nuten der Ständer eingeschoben, bes. im süddt. Fachwerkbau des 15./16. Jhs. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Bohlenwand"@de, "pared de tablones"@es, "parete a graticcio tamponata con assicelle"@it,
    "paroi en madriers"@fr, "plank wall"@en;
  skos:broader :c_ab2c77c8;
  skos:related :c_e2d61e5c;
  dct:created "2020-06-09T20:09:04.000"^^xsd:dateTime;
  dct:modified "2021-01-22T19:39:39.000"^^xsd:dateTime;
  :broaderByConstruction :c_ab2c77c8 .

:c_bb86692b a skos:Concept;
  skos:definition "In einem Haus gelegener, verschließbarer, heizbarer und rauchfreier Wohnraum. Die S. ist gegenüber der weiten Diele relativ klein, sie hat dicht schließende Wände und eine feste, nicht zu hohe Decke und ist mit einem Ofen ausgestattet, der zumeist vom Vorraum beschickt wird und einen Schornstein besitzt. Die S. war der bevorzugte Wohn- und Arbeitsraum, der der engeren Familie vorbehalten war. Sie hat sich im nordeurop. Bauern- und Bürgerhaus im frühen und hohen MA ausgeformt und bis ins 20. Jh. gehalten. [Koepf / Binding 2016]"@de,
    "Stube f, beheizbarer Wohnraum mit dichten Wänden und meist niedriger Decke. Die Heizung erfolgt ab dem Hochmittelalter fast immer mit einem Ofen, der von einem ande-ren Raum aus befeuert wurde. Die S. ist meist mit einer Holzverkleidung versehen. Im Burgenbau kann sie auch innerhalb von Steingebäuden als Holzkonstruktion eingesetzt werden (Bohlen-S.). Charakteristisch ist dann die mehr oder weniger ausgeprägte Wöl-bung der Decke. Häufig dient eine Gruppe kleinerer, aber verschließbarer Fenster zur Belichtung. An der Wende zum 16. Jh. ist die S. Bestandteil eines Appartements. B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen] "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c8a571d9;
  skos:prefLabel "pièce"@fr, "světnice"@cs, "chamber"@en, "camera"@it, "habitación"@es,
    "Stube"@de;
  skos:altLabel "pokoj"@cs, "cuarto"@es, "pieza"@es, "jizba"@cs, "obytná místnost"@cs,
    "stanza"@it, "chambre"@fr, "room"@en;
  skos:broader :c_2d93c3e7;
  skos:narrower :c_8cab86dc;
  dct:created "2020-02-04T15:30:18.000"^^xsd:dateTime;
  dct:modified "2021-01-27T01:35:31.000"^^xsd:dateTime .

:c_bea40b31 a skos:Concept;
  skos:definition "Das Halbholz (Hälbling) entsteht durch Aufsägen oder Aufspalten eines vollholzigen Balkens. Viertelhölzer entstehen durch entsprechende Aufteilung der Halbhölzer. (Eißing et al. 2012)"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_19d56a39;
  skos:prefLabel "Hälbling"@de;
  skos:altLabel "Halbholz"@de;
  skos:broader :c_f99ea647;
  dct:created "2019-05-13T14:00:32.000"^^xsd:dateTime;
  dct:modified "2020-02-28T13:22:53.000"^^xsd:dateTime;
  :broaderByShape :c_f99ea647 .

