:c_e5979373 a skos:Concept;
  skos:definition "1. Die in ein Gewölbe einschneidenden Zwickel (Stichkappen). 2. Die zwischen einem Gewölbe und seinem Unterbau vermittelnden Wölbungen. [Koepf / Binding 2016]"@de,
    "Wölbfläche, die nur einen Ausschnitt aus einem voll ausgebildeten Gewölbe darstellt, z. B. Pendentif und Trompe, oder ein Gewölbe, das mit einem anderen Gewölbe konstruktiv eng verbunden ist, z. B. die Stichkappe. [Glossarium Artis] "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "Teilgewölbe"@de, "bóveda con pechinas"@es, "samostatně použitá část klenby"@cs,
    "voûte partielle"@fr, "partial vault"@en;
  skos:altLabel "squinch arch"@en, "dôme à pendentifs (courbes)"@fr;
  skos:broader :c_049c4c22, :c_3e25acca;
  skos:narrower :c_7b5c14e1, :c_09a12988, :c_d79317de, :c_06d02c77, :c_c2b699c5;
  dct:created "2019-12-13T13:31:46.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:56:27.000"^^xsd:dateTime .

