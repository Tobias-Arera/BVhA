  dct:modified "2021-01-22T15:35:51.000"^^xsd:dateTime .

:c_aecd6ab1 a skos:Concept;
  skos:definition "Mauer, die ein Gelände, z. B. einen Park oder einen Friedhof, umschließt. (Glossarium Artis, Bd. 3, Bögen und Mauerwerk)"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe;
  skos:prefLabel "Einfriedungsmauer"@de;
  skos:broader :c_5b828b5f;
