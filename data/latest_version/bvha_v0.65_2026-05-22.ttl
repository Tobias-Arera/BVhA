:c_2b3ed32b a skos:Concept;
  skos:definition "Ein aus Ton gefertigter, röhren- oder vasenförmiger Hohlkörper, der in die Gewölbeschale des Topfgewölbes eingegossen ist. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "terracotta-pot used for vaulting"@en, "Gewölbetopf"@de, "drain de poterie pour la construction d\\'une voûte "@fr;
  skos:broader :c_3e25acca;
  dct:created "2020-02-13T15:43:17.000"^^xsd:dateTime;
  dct:modified "2021-01-19T13:21:49.000"^^xsd:dateTime .

:c_297805bf a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "anchorage of a vault"@en, "Gewölbeverankerung"@de, "ancrage d\\'une voûte"@fr;
