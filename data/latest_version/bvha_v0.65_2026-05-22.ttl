  skos:definition "Eine altägyptische Tempelanlage ist eine → Tempelanlage, die im Kontext des altägyptischen Kulturraums entstanden ist. [BVhA, Tobias Arera-Rütenik]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe;
  skos:prefLabel "altägyptische Tempelanlage"@de;
  skos:broader :c_50c05cd7;
