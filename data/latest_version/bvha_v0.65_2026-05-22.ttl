:c_a2116ff9 a skos:Concept;
  skos:definition "Nachahmung ostasiatischer Dekorations- und Bauformen in der europäischen Architektur des 17. und 18. Jhs. [Koch 2009]"@de,
    "Chinoiserie (frz.), Bezeichnung für die Übernahme bzw. Nachahmung chines. oder überhaupt ostasiat. Formen durch die europ. Baukunst und Innenarchitektur des 17. und 18. Jhs. Chines. Zimmer mit chines. Lackmalerei und Seidenstickerei gibt es in den meisten Residenzen des Barock und des Rokoko, auch in Gärten und Parks wurden Pavillons und Pagoden in chines. Stil errichtet, bei denen man bes. die chines. Dachform nachbildete. [Koepf / Binding 2016]"@de,
    "Napodobení východoasijských dekoračních a architektonických prvků v evropské architektuře 17. a 18. stol. [Koch 2008] "@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_84fc24e6,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "Chinoiserie"@de, "chinoiserie"@cs;
  skos:broader :c_7c4af9bc, :c_bec61545, :c_6uazz5qx;
  skos:related :c_bec61545, :c_6uazz5qx;
  dct:created "2020-08-04T09:19:11.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:27:02.000"^^xsd:dateTime .

