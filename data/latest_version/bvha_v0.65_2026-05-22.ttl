  dct:modified "2021-01-26T11:02:06.000"^^xsd:dateTime .

:c_b0ef618a a skos:Concept;
  skos:definition "Firstbekrönung, Firstkamm, bes. im MA häufige, auf dem Dachfirst entlanglaufende Verzierung aus Stein oder Blei, die kammartig gesägt (Firstkamm, Dachkamm) und gitterartig durchbrochen sein kann (Firstgitter). F.en kommen auch an Reliquienschreinen und Sarkophagen vor, die Werken der Architektur nachgebildet sind. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "Firstbekrönung"@de;
  skos:altLabel "Firstkamm"@de, "Firstgitter"@de;
  skos:broader :c_d1a8ce66, :c_b08588ac;
  dct:created "2020-09-25T09:41:16.000"^^xsd:dateTime;
  dct:modified "2021-01-26T11:01:54.000"^^xsd:dateTime .

:c_9e3fea21 a skos:Concept;
  skos:scopeNote "Kleinformatige Retabel liegen in ihren Höhen- und Breitenmaßen unter den Standardmaßen des großformatigen Brabanter Retabels (Höhe 220cm, Breite 185cm) und zeichnen sich durch eine reduzierte Ikonographie aus. Die Definition bezieht sich vor allem auf den südniederländischen Raum. [Gliesmann 2011]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_9fcb19ed;
  skos:prefLabel "kleinformatiges Retabel"@de;
  skos:broader :c_d2c7cee1;
  skos:narrower :c_808d370a, :c_aa4112f7, :c_adf814f2;
  dct:created "2020-03-02T12:55:45.000"^^xsd:dateTime;
  dct:modified "2021-01-31T00:00:40.000"^^xsd:dateTime .

:c_82abd10e a skos:Concept;
  skos:scopeNote "Großformatige Retabel entsprechen den Standardmaßen des großformatigen Brabanter Retabels (Höhe 220cm, Breite 185cm) oder übertreffen diese. Die Definition gilt vor allem für Retabel aus dem südniederländischen Raum. [Gliesmann 2011]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_9fcb19ed;
  skos:prefLabel "großformatiges Retabel"@de, "velkoformátový retábl"@cs;
