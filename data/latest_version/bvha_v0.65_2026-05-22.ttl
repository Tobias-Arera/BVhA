:c_da40e328 a skos:Concept;
  skos:definition "Äolisches Kapitell, nach der altgr. Küstenlandschaft Äolis im nordwestl. Kleinasien, ihrem Fundgebiet, benannte Sonder- oder Vorform des ion. Kapitells aus dem 7. Jh. v. Chr. Über einem Kranz herabhängender Blätter (Helices) und einem Blattknauf erheben sich zwei aufwärtsgerichtete Voluten, zwischen denen eine Palmette herauswächst (Kapitell). [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "Äolisches Kapitell"@de, "capitel eoliano"@es, "capitello eolico"@it,
    "chapiteau éolien"@fr, "Aeolian capital"@en;
  skos:broader :c_utiejxdh;
  dct:created "2019-05-14T13:10:07.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:39:16.000"^^xsd:dateTime .

:c_3b583b21 a skos:Concept;
  skos:definition "Ein Kapitell, das eine Verbindung des ionischen Volutenkapitells mit dem korinthischen Blätterkapitell darstellt. [Glossarium Artis]"@de,
    "Kompositkapitell (lat. compositum: zusammengesetzt), aus verschiedenen, urspr. nicht zusammengehörenden Teilen bestehendes Kapitell. Bekannt v.a. das in der röm. Baukunst vorkommende K., das aus Teilen des ion. und des korinth. Kapitells zusammengesetzt ist und bei Antikenbezug späterer Stile wieder aufkommt. Die kleinen Stengelvoluten des korinth. Kapitells werden durch große Voluten über Eierstab des ion. Kapitells ersetzt, die jedoch diagonal gestellt die Ecken allansichtig betonen. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "Kompositkapitell"@de, "capitel compuesto"@es, "capitello composito"@it,
    "chapiteau composite"@fr, "compose capital"@en;
  skos:broader :c_utiejxdh;
  dct:created "2019-05-14T13:10:29.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:45:11.000"^^xsd:dateTime .

:c_93e804f0 a skos:Concept;
  skos:definition "Figurenkapitell, Bilderkapitell, Kapitell, an dem Figuren von Menschen, Tieren oder Fabelwesen erscheinen, oft zu ganzen Szenen vereint. Das F. kommt schon in der Spätantike vor, hat sich aber erst in der roman. Baukunst bes. Frankreichs voll entwickelt. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "chapiteau figuré"@fr, "figural capital"@en, "capitello istoriato"@it,
    "capitel con figuras"@es, "Figurenkapitell"@de, "figurální hlavice"@cs;
  skos:altLabel "Figuriertes Kapitell"@de, "Bilderkapitell"@de, "chapiteau anthropomorphe"@fr,
    "chapiteau zoomorphe"@fr;
  skos:broader :c_utiejxdh;
  dct:created "2019-05-14T13:10:57.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:43:09.000"^^xsd:dateTime .

:c_64b3c3bb a skos:Concept;
  skos:definition "Kapitell mit Stierköpfen über Blattkränzen und vier ansteigenden Volutenpaaren. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Persisches Kapitell"@de;
  skos:broader :c_utiejxdh;
  dct:created "2019-05-14T13:11:35.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:46:17.000"^^xsd:dateTime .

:c_cfbe7173 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Hathorkapitell"@de;
  skos:broader :c_utiejxdh;
  dct:created "2019-05-14T13:12:03.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:43:43.000"^^xsd:dateTime .

:c_04e5f22a a skos:Concept;
  skos:definition "Bestehend aus runden Polstern (Echinus) und quadrat. Deckplatte (Abakus); charakterist. Element der dorischen Ordnung. Die frühen D.K.e sind weit ausladend, bei den späteren schrumpft der Echinus zu einem umgekehrt flachen Kegelstumpf zusammen. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "chapiteau dorique"@fr, "doric capital"@en, "dorisches Kapitell"@de,
    "dórská hlavice"@cs;
  skos:broader :c_utiejxdh;
  dct:created "2019-05-14T13:12:25.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:42:03.000"^^xsd:dateTime .

:c_835d2dbc a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Tuscan capital"@en, "chapiteau toscan"@fr, "Toskanisches Kapitell"@de;
  skos:altLabel "Tuskisches Kapitell"@de;
  skos:broader :c_utiejxdh;
  dct:created "2019-05-14T13:12:55.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:51:27.000"^^xsd:dateTime .

:c_ea7f6ea5 a skos:Concept;
  skos:definition "Kapitell von kelchartiger Form, bes. häufig in der Gotik, teilweise mit vegetabilen Ornamenten geschmückt, die aber den Kapitellkörper teilweise sichtbar lassen (Kapitell). [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "chapiteau en forme de calice"@fr, "capital in the shape of a chalice"@en,
    "Kelchkapitell"@de, "kalichová hlavice"@cs;
  skos:broader :c_utiejxdh;
  skos:narrower :c_ccd1b8b9;
  dct:created "2019-05-14T13:13:21.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:44:30.000"^^xsd:dateTime .

:c_ccd1b8b9 a skos:Concept;
  skos:definition "Kelchblockkapitell, Kelchwürfelkapitell, eine aus Kelchkapitell und Würfelkapitell kombinierte Form, die bes. in stauf. Zeit allg. verbreitet war (Kapitell). Beim K. wird zumeist der Kapitellkörper vollständig von Ornamenten überdeckt. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "Kelchblockkapitell"@de;
  skos:broader :c_ea7f6ea5;
  dct:created "2019-05-14T14:41:39.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:44:43.000"^^xsd:dateTime .

:c_d7e67944 a skos:Concept;
  skos:definition " Form des Kapitells, die korb- bzw. kesselartig vom runden Säulenauflager zum quadrat. Abakus überleitet. Das K. kommt hauptsächl. in der frühbyzantinischen Baukunst vor. Es ist meist mit Flechtwerk, seltener mit figürl. Darstellungen versehen. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "basket capital"@en, "chapiteau en corbeille"@fr, "Korbkapitell"@de;
  skos:broader :c_utiejxdh;
  dct:created "2019-05-14T13:14:07.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:45:20.000"^^xsd:dateTime .

:c_78297bcb a skos:Concept;
  skos:definition "Ein mittelalterliches Kapitell, dessen stereometr. Grundform aus einer Halbkugel mit einem abgeschnittenen Segment als Säulenauflager gebildet wird, der ein Würfel so eingeschrieben wird, dass vier halbkreisförmige Ansichtsflächen entstehen, die glatt oder reliefiert sein können; häufig mit Halsring und Abakus. Sonderformen sind das sog. Doppelw., das in jeder Ansichtsfläche zweimal die Form des W.s zeigt, und das dem Trapezkapitell ähnl. sog. Backsteinw. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "chapiteau cubique"@fr, "krychlová hlavice"@cs, "cushion capital"@en,
    "capitello cubico"@it, "capitel cúbico"@es, "Würfelkapitell"@de;
  skos:altLabel "cubiform capital"@en, "cube capital"@en, "block capital"@en;
  skos:broader :c_utiejxdh;
  skos:narrower :c_dc1df56e, :c_b756f8ce;
  dct:created "2019-05-14T13:14:37.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:52:44.000"^^xsd:dateTime .

:c_dc1df56e a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "coupled cushion capitals"@en, "chapiteau cubique festonné"@fr, "Doppelwürfelkapitell"@de;
  skos:broader :c_78297bcb;
  dct:created "2019-05-14T13:15:11.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:53:19.000"^^xsd:dateTime .

:c_b756f8ce a skos:Concept;
  skos:definition "Aufgelockerte und reich dekorierte Form [des Würfelkapitells]. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "Blockkapitell"@de;
  skos:broader :c_78297bcb;
  dct:created "2020-02-20T15:21:04.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:53:06.000"^^xsd:dateTime .

:c_87c351cc a skos:Concept;
  skos:definition "Seltene Form des Kapitells, bestehend aus gebündelten und unten verjüngten Kegelstümpfen (Pfeifen). [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "chapiteau avec godrons"@fr, "laločnatá hlavice"@cs, "scalloped capital"@en,
    "capitello rudentato"@it, "capitel con gallones"@es, "Pfeifenkapitell"@de;
  skos:altLabel "Faltenkapitell"@de, "vícelaločna hlavice"@cs, "capitello scanalato"@it,
    "Tubakapitell"@de;
  skos:broader :c_utiejxdh;
  dct:created "2019-05-14T13:15:38.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:46:28.000"^^xsd:dateTime .

:c_6778cb83 a skos:Concept;
  skos:definition "Faltenkapitell, Sonderform eines Kapitells mit abwechselnd nach oben bzw. unten gerichteten, gefalteten Teilen, bes. bei anglo-normann. Bauten der Romanik. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "invected capital"@en, "chapiteau godronné"@fr, "Faltenkapitell"@de;
  skos:broader :c_utiejxdh;
  dct:created "2019-05-14T13:15:57.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:42:56.000"^^xsd:dateTime .

:c_d2f1eb37 a skos:Concept;
  skos:definition "Vom Bohlenblockbau spricht man, wenn die Wandstärken deutlich geringer als im Kantholzblockbau ausgebildet und die Ecken verzinkt sind. Es handelt sich meist um einräumige Bauten von maximal 4-5 m Seitenlänge.  (Eißing et al. 2012) "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c8a571d9,
    :conceptScheme_19d56a39;
  skos:prefLabel "Bohlenblockbau"@de;
  skos:broader :c_93fd7d9a;
  skos:related :c_f21c8182;
  dct:created "2019-05-15T09:04:44.000"^^xsd:dateTime;
  dct:modified "2021-01-26T23:16:28.000"^^xsd:dateTime;
  :broaderByConstruction :c_93fd7d9a .

:c_93fd7d9a a skos:Concept;
  skos:definition "Blockbau, bes. in Skandinavien, Russland und den Alpenländern verbreitete Art des Holzbaus, bei der die Wände aus waagerecht aufeinander geschichteten Balken (Blockhölzern) oder Stämmen (Rundhölzern) gebildet und die dabei entstehenden Fugen meist mit Moos, Lehm u. dergl. abgedichtet sind. An den Ecken sind die Querschnitte der Blockhölzer um die Hälfte in der Höhe versetzt und stehen über. Meist ruht die unterste Lage auf hölzernen oder steinernen Stützen oder auf einer Untermauerung, die vielfach Erdgeschosshöhe erreichen kann. Auch auf Steinsockel oder mit Fachwerkaufbau (Umgebindehaus). [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_c8a571d9;
  skos:prefLabel "Blockbau"@de;
  skos:broader :c_d6f572a5;
  skos:narrower :c_d2f1eb37, :c_439d7c1b, :c_b8663798, :c_5c0e060d, :c_84aedafe;
  dct:created "2020-08-28T11:08:54.000"^^xsd:dateTime;
  dct:modified "2021-01-26T23:16:18.000"^^xsd:dateTime .

:c_f21c8182 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8;
  skos:prefLabel "Bohlenblockbauweise"@de;
  skos:broader :c_feda08b4;
  skos:related :c_d2f1eb37;
  dct:created "2020-12-15T12:33:45.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:08:00.000"^^xsd:dateTime;
  :broaderByConstruction :c_feda08b4 .

:c_d6f572a5 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_50ec0c5e,
    :conceptScheme_c8a571d9;
  skos:prefLabel "Holzgebäude"@de, "dřevěná stavba"@cs;
  skos:altLabel "Holzbau"@de, "Holzbauwerk"@de, "stavba ze dřeva"@cs;
  skos:broader :c_6bbfbe49;
