  skos:prefLabel "Geisipodes"@de, "zhlaví trámu"@cs;
  skos:altLabel "Balkenkopf"@de;
  skos:broader :c_d3971ceb;
  dct:created "2020-08-03T13:46:35.000"^^xsd:dateTime;
  dct:modified "2020-08-21T15:01:33.000"^^xsd:dateTime .

:c_b5997041 a skos:Concept;
  skos:definition "Dielenkopf (lat. mutulus), viereckige Platte an der Unterseite des Geisons gr. Tempel (Dorische Ordnung), je eine über jeder Triglyphe und Metope, besetzt mit drei Reihen von je sechs zylindr. >Tropfen< (lat. guttae), deren Form auf den Holzbau zurückweist (Holznägel). [Koepf / Binding 2016]"@de,
    "Závěsná deska pod dórským geisonem s kapkami. [Koch 2008]"@cs, "Mutulus, Dielenkopf, Hängeplatte unter dem dorischen Geison. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "Dielenkopf"@de, "mutulus"@cs;
  skos:altLabel "Mutulus"@de;
  skos:broader :c_d3971ceb;
  dct:created "2020-08-04T11:53:19.000"^^xsd:dateTime;
  dct:modified "2020-09-07T09:34:41.000"^^xsd:dateTime .

:c_9f6a22e1 a skos:Concept;
  skos:definition "Antefixa, Antefix (lat. die angenagelten Dinge), 1. bemalte Platten aus gebranntem Ton, mit denen an den frühen dor. Tempeln Großgriechenlands (Süditalien und Sizilien) und an etrusk. Tempeln das Gebälk unter dem Traufrand verkleidet war. Die Verwendung der A. wurde wahrscheinl. aus dem Holzbau übernommen, wo sie das Gebälk gegen Feuchtigkeit schützten (Antepagmenta). 2. Stirnziegel. [Koepf / Binding 2016]"@de,
    "Antefix (lat. vorn befestigt), Mz. -a. 1. Stirnziegel; 2. bemalte Tonplatte, verkleidet das Gebälkunter dem Traufrand griechischer und etruskischer Tempel. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_8c0441f9;
  skos:prefLabel "Antefix (Gebälk)"@de;
  skos:altLabel "Antefixa"@de;
  skos:broader :c_d3971ceb;
  dct:created "2020-08-04T13:20:09.000"^^xsd:dateTime;
  dct:modified "2020-09-02T10:17:53.000"^^xsd:dateTime .

:c_cf68f381 a skos:Concept;
  skos:definition "Guttae (pl.; lat.), tropfenartige Gebilde der Dorischen Ordnung, die in drei Gruppen zu sechs Tropfen an den Mutuli (Dielenköpfen), außerdem sechs G. in einer Reihe unter den Regulae angebracht sind. [Koepf / Binding 2016]"@de,
    "Kapka(y), část dórského kladí. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_37522b74;
  skos:prefLabel "Gutta"@de, "guttae"@cs;
  skos:broader :c_d3971ceb;
  dct:created "2020-08-05T12:42:02.000"^^xsd:dateTime;
  dct:modified "2020-09-30T09:26:17.000"^^xsd:dateTime .

:c_9771463d a skos:Concept;
  skos:definition "Füllelement des griechischen Gebälks zum Zwecke der Kassettenbildung. [Koch 2009]"@de,
    "Výplňový prvek řeckého kladí vytvářející kazety. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_8c0441f9;
