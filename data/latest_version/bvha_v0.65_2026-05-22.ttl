  skos:broader :c_3eb67821;
  dct:created "2020-08-10T14:45:19.000"^^xsd:dateTime;
  dct:modified "2021-01-27T01:19:27.000"^^xsd:dateTime .

:c_81a62a56 a skos:Concept;
  skos:definition "Rechteckiger Hallenbau; weit gespannte, freitragende, hölzerne Dachkonstruktionen mit seitl. Emporen. Seit dem 17./18. Jh. häufig in fürstl. Residenzstädten für die Ausbildung der Reiter in stehenden Heeren, aber auch für Reiterspiele und Wettkämpfe des Hofadels. Seit dem 19. Jh. ausschließl. als Exerzierhäuser für berittene Truppenteile genutzt, in der Modeme für Sportzwecke. [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_c8a571d9;
  skos:prefLabel " manège couvert"@fr, "jízdárna"@cs, " riding house"@en, " maneggio coperto"@it,
    "picadero (cubierto)"@es, "Reithalle"@de;
  skos:broader :c_3eb67821;
  dct:created "2020-08-21T13:48:27.000"^^xsd:dateTime;
  dct:modified "2021-01-27T01:18:06.000"^^xsd:dateTime .

:c_c2e5f00d a skos:Concept;
  skos:definition "Ringsum oder an mehreren Seiten von Gebäuden, Gebäudeteilen oder Mauern umschlossener Freiraum. Der H. kann innerhalb (Innenh., Atrium), vor oder hinter einem größeren Gebäude liegen (Vorh., Hinterh.). Ist der Vorh. an der Eingangsseite offen, so spricht man von Straßenh., beim Barockschloss von Ehrenh. (Corps de Logis). Je nach Art der Gestaltung unterscheidet man den Arkaden- oder Laubenhof, den Säulenh. (Peristylhof), den Brunnen- oder Gartenh. Der Lichth. ist oft durch ein Glasdach geschlossen. Nach seiner Verwendung unterscheidet man Wohnh., Wirtschaftsh., Tournierh., Klosterh. [Koepf / Binding 2016]"@de,
    "Unbebaute Fläche zwischen zusammengehörenden Gebäuden. Im Burginnern waren H.e selten regelmäßig. Manche waren so klein, dass sie allein zur Belichtung und Belüftung der umliegenden Gebäude dienen konnten; in den größeren wurden auch alltägliche und gewerbliche Arbeiten verrichtet. Turniere fanden – entgegen landläufiger Meinung – in ihnen nicht statt (vgl. Turnierplatz). Erst im Schlossbau des 16. Jh.s beginnt nach dem Vorbild italienischer Palastbauten der H. regelmäßige Formen anzunehmen, kann ganz oder teilweise mit Arkaden umzogen sein und wird Schauplatz prachtvoller Aufzüge. Das Barockschloss, das je nach Anzahl seiner Flügel einen oder mehrere Innen-H.e umschließt, hebt besonders den Ehren-H. hervor. Dieser ist auf den Hauptflügel ausgerichtet und ganz auf repräsentativen Empfang von Gästen angelegt. Der Schloss-H. ist entweder allseitig bebaut (Ludwigsburg BW) oder auf einer Seite durch ein dekoratives Gitter wie in Versailles F geschlossen. Im Gegensatz zum Garten ist der H. nicht oder kaum bepflanzt. Der Boden ist mit Kies oder mit Natursteinplatten bedeckt. B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_50ec0c5e, :conceptScheme_c8a571d9, :conceptScheme_1d7ba54b;
  skos:prefLabel "Hof"@de, "dvůr"@cs;
  skos:broader :c_69367952;
  skos:narrower :c_1a5d144a, :c_a03ff29f, :c_a3901857;
  dct:created "2019-10-21T17:39:14.000"^^xsd:dateTime;
  dct:modified "2021-01-27T16:22:05.000"^^xsd:dateTime .

:c_a03ff29f a skos:Concept;
  skos:definition "Čestný dvůr obklopený 3 křídly na městské straně barokního zámku. [Koch 2008]"@cs,
    "Hof, Corps de logis und zwei weitere Flügel umfassen den Cour dhonneur oder E. einer Dreiflügelanlage. In ihm fuhren die Wagen vor das Hauptportal, wo die Gäste das Schloss betraten. Der E. war meist an der vierten Seite von einem Gitter abgeschlossen. B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen]"@de,
    "Von 3 Flügeln umschlossener Ehrenhof an der Stadtseite des Barockschlosses. [Koch 2009]"@de,
    "Cour d\\'honneur (frz.), der vom Corps de logis und den Communes (Nebenflügeln) dreiseitig umschlossene >Ehrenhof< eines Barock-Schlosses oder Hotelbaus, ausgebildet im frz. Renaissance-Schloss. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_50ec0c5e, :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "Cour d\\'honneur"@de, "cour d\\'honneur"@cs;
  skos:altLabel "Ehrenhof"@de, "čestný dvůr"@cs;
  skos:broader :c_c2e5f00d;
  dct:created "2020-07-16T10:55:20.000"^^xsd:dateTime;
  dct:modified "2021-01-27T16:22:32.000"^^xsd:dateTime .

:c_a3901857 a skos:Concept;
  skos:definition "Größerer, rings von Zuschauergalerien umgebener Hof. Im 13.-16. Jh. zur Abhaltung ma. Kampfspiele. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_50ec0c5e, :conceptScheme_c8a571d9;
  skos:prefLabel "tiltyard"@en, "campo del torneo"@it, "Turnierhof"@de, "liza"@es;
  skos:broader :c_c2e5f00d;
  dct:created "2020-08-05T16:51:52.000"^^xsd:dateTime;
  dct:modified "2021-01-27T16:24:20.000"^^xsd:dateTime .

:c_9d0b47e3 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe;
  skos:prefLabel "Arkadenreihe"@de;
  skos:broader :c_d744e1a4;
  dct:created "2020-04-28T08:53:28.000"^^xsd:dateTime .

:c_76706966 a skos:Concept;
  skos:definition "Blendarkaden, in denen Skulpturen aufgestellt sind. Eine verbreitete Form sind die sogenannten Königsgalerien, eine Folge von Königsstatuen unter Blendarkaden oder in Nischen an der Fassade gotischer Kathedralen, namentlich in Frankreich. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "figured arcade"@en, "arcade à figures"@fr, "Figurenarkade"@de;
  skos:altLabel "arcade à sculptures"@fr;
  skos:broader :c_d2b38caf;
  dct:created "2019-10-22T08:41:07.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:03:48.000"^^xsd:dateTime .

:c_b3fec374 a skos:Concept;
  skos:definition "Dreierarkade, die in einer byzantin. Kirche den Narthex vom Langhaus scheidet, dazwischen drei Vorhänge (trivela). [Koepf / Binding 2016]"@de;
