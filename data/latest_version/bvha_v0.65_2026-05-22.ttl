:c_4d2e0bec a skos:Concept;
  skos:definition "Gewölbe mit sphärisch überhöhten Gewölbekappen. [Glossarium Artis]"@de,
    "Převýšená klenba je taková klenba, jejíž kápě mírně stoupají, takže vrcholový bod křížové klenby leží výše než vrchol podélného a příčného pasu. Kupolovitě převýšená osmidílná žebrová klenba (4 křížová, 2 příčná žebra mezi packami a svorníkem, 2 úseky vrcholových žeber), se nazývá domikální klenba. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_37522b74, :conceptScheme_1f14b4dd;
  skos:prefLabel "voûte bombée "@fr, "domed vault with convex ridges"@en, "gebustes Gewölbe"@de,
    "převýšená klenba"@cs;
  skos:altLabel "domed vault"@en;
  skos:broader :c_049c4c22;
  skos:narrower :c_0422b318;
  dct:created "2020-04-09T13:50:31.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:14:29.000"^^xsd:dateTime;
  :broaderByShape :c_049c4c22 .

