:c_b7d6a6dd a skos:Concept;
  skos:definition "Fußpfette, Pfette, die Fußpunkt der Rofen oder Sparren abstützt, kann häufig zugleich den Rähm der Fachwerkwand bilden. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_1f14b4dd, :conceptScheme_19d56a39;
  skos:prefLabel "Fußpfette"@de, "correa inferior"@es, "arcareccio inferiore"@it, "panne sablière"@fr,
    "inferior purlin"@en;
  skos:altLabel "low purlin"@en, "panne inférieure"@fr, "Traufpfette"@de;
  skos:broader :c_c495fe17;
  dct:created "2019-11-05T10:13:58.000"^^xsd:dateTime;
  dct:modified "2019-11-05T10:29:47.000"^^xsd:dateTime .

:c_57423980 a skos:Concept;
  skos:definition "Zwischen Trauf- und Firstpfette angeordnetes Holz. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd,
    :conceptScheme_19d56a39;
  skos:prefLabel "side purlin"@en, "panne intermédiaire"@fr, "Zwischenpfette"@de;
