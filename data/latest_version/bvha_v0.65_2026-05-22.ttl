  dct:modified "2019-06-18T08:14:03.000"^^xsd:dateTime .

:c_82f0e276 a skos:Concept;
  skos:scopeNote "Unteres waagrechtes Holz eines Fenster- oder Flügelrahmens."@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Unterschenkel"@de;
  skos:broader :c_e4dee1e3;
  dct:created "2019-06-17T17:37:40.000"^^xsd:dateTime;
  dct:modified "2019-06-18T08:14:47.000"^^xsd:dateTime .

:c_ce1dbe72 a skos:Concept;
  skos:definition "Form der Innenkonstruktion im Fensterrahmen eines Schiebefensters, seit der Renaissance in Sachsen bekannt. Sie wird aus dem Querholz und einem halben Höhenholz gebildet. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "T-Stock"@de;
  skos:broader :c_8ddac41d;
  dct:created "2019-06-18T10:30:32.000"^^xsd:dateTime;
  dct:modified "2019-06-18T10:37:02.000"^^xsd:dateTime .

:c_ed63fdb9 a skos:Concept;
  skos:definition "Leiste zwischen Fußboden und Innenputz. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Sockelleiste"@de, "listón de! zócalo"@es, "battiscopa"@it, "antébois"@fr,
    "baseboard"@en;
  skos:altLabel "plinthe"@fr;
  skos:broader :c_8b0a1aab;
  dct:created "2020-08-18T16:00:13.000"^^xsd:dateTime;
  dct:modified "2020-11-02T12:42:44.000"^^xsd:dateTime .

:c_67a93b16 a skos:Concept;
  skos:definition "Obere oder untere Abschlussleiste an einem Türflügel oder Fensterladen zum Schutz des Hirnholzes gegen eindringende Feuchtigkeit.. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "fillet"@en, "listel"@es, "Saumleiste"@de;
  skos:broader :c_8b0a1aab, :c_6adde293;
  dct:created "2020-08-21T10:38:45.000"^^xsd:dateTime;
  dct:modified "2021-01-22T19:14:24.000"^^xsd:dateTime .

:c_f91c7dff a skos:Concept;
  skos:definition "Etwa 10 cm hohe Holzleiste zur Deckung der Fuge zwischen Wand und Fußboden und zum Schutz der Wand beim Bodenreinigen (Scheuerleiste). [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Fußleiste"@de;
  skos:broader :c_8b0a1aab;
  dct:created "2020-09-29T11:08:09.000"^^xsd:dateTime;
  dct:modified "2020-09-29T11:08:44.000"^^xsd:dateTime .

:c_57bbe500 a skos:Concept;
  skos:definition "Zum Schließen eines Glasfeldes wurden aus Sparsamkeitsgründen Flachglasreste ohne System mit Bleiruten verbunden. Die Glasreste wurden gerade geschnitten, deshalb ist das Notblei im Gegensatz zum Sprungblei i. d. R. gerade. Es wird auch dann verwendet, wenn ein Teil des gesprungenen Glases nicht mehr zu verwenden ist und durch ein neues ersetzt werden muss. Dann werden wie bei der Reparatursprosse beide Ränder gerade geschnitten und mit dem Notblei verbunden. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_315cf028,
    :conceptScheme_b41bd73a;
  skos:prefLabel "Notblei"@de;
  skos:broader :c_6e1ba7b5;
  dct:created "2019-06-18T08:06:08.000"^^xsd:dateTime;
  dct:modified "2021-03-19T14:55:44.000"^^xsd:dateTime .

:c_8d5beacc a skos:Concept;
  skos:definition "Wenn ein Tafelglas oder eine Glasscheibe im eingebauten Zustand beim Gebrauch des Fensters gesprungen ist und dieser Sprung sich nicht verzweigt hat, wurde aus Sparsamkeit oder auch Materialmangel das Glas aus dem Fenster- oder Flügelrahmen genommen und mit einer Bleirute, dem Sprungblei, repariert. Danach konnte das Glas wieder eingesetzt werden. Ein Sprungblei ist in der Regel nicht gerade, sondern dem Sprung folgend geformt, im Gegensatz zum Notblei. Es handelt sich dabei nur um eine Reparaturmaßnahme, das Sprungblei gehört deshalb nicht zum Fensterblei. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_315cf028,
    :conceptScheme_b41bd73a;
  skos:prefLabel "Sprungblei"@de;
  skos:broader :c_6e1ba7b5;
  dct:created "2019-06-18T08:48:17.000"^^xsd:dateTime;
  dct:modified "2021-03-19T14:55:33.000"^^xsd:dateTime .

:c_e1a6eab7 a skos:Concept;
  skos:definition "Bei der Verglasung mit Butzen, Tellerscheiben und rund zugeschnittenem Tafelglas je nach Anordnung zwischen den Ringen verbleibende drei- bzw. auch viereckige Restfelder, die dann mit zugeschnittenen Glasstücken geschlossen werden. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Zwickel (Fensterglas)"@de;
  skos:broader :c_f4ceb052;
  dct:created "2019-06-18T16:44:34.000"^^xsd:dateTime;
  dct:modified "2020-09-15T15:32:38.000"^^xsd:dateTime .

:c_5e1580f3 a skos:Concept;
  skos:definition "Eckverbindung eines Blendrahmens. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0,
    :conceptScheme_b41bd73a;
  skos:prefLabel "Schlitzzapfen"@de;
  skos:broader :c_194f23d8;
  dct:created "2019-06-18T17:02:38.000"^^xsd:dateTime;
  dct:modified "2019-10-15T14:29:21.000"^^xsd:dateTime .

:c_78ab2451 a skos:Concept;
  skos:definition "Verbleibendes Holz beiderseits eines Schlitzes. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Schlitzwangen"@de;
  skos:broader :c_194f23d8;
  dct:created "2019-06-18T17:04:36.000"^^xsd:dateTime;
  dct:modified "2019-06-18T17:05:09.000"^^xsd:dateTime .

:c_1ab7e15f a skos:Concept;
  skos:definition "Mittige, etwa ein Drittel der Stärke der Schenkel umfassende Ausnehmungen an den oberen und unteren Enden der Höhenschenkel. Sie sind das Gegenstück für die Zapfen an Ober- und Unterschenkel. Schlitze und Zapfen ergeben immer eine Eckverbindung, die Schlitzzapfen genannt und mit einem Holznagel gesichert wird, für Blendrahmen übliche Eckverbindung. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Schlitz"@de;
  skos:broader :c_194f23d8;
  dct:created "2019-10-15T10:01:35.000"^^xsd:dateTime;
  dct:modified "2019-10-15T10:02:22.000"^^xsd:dateTime .

:c_e6fbc506 a skos:Concept;
  skos:definition "Verbindungsart von meist im rechten Winkel aneinanderstoßenden Brettern und Leisten, z.B. Futterteilen. Die Schwalben des einen Futterteils werden in die Zinken des anderen Futterteils eingepaßt. [Pax - Fenster & Türen Fachbegriffe]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0;
  skos:prefLabel "Verzinkung (Fenster)"@de;
  skos:broader :c_194f23d8;
  dct:created "2019-10-15T14:48:57.000"^^xsd:dateTime;
  dct:modified "2019-10-15T14:49:45.000"^^xsd:dateTime .

:c_80cb42d9 a skos:Concept;
  skos:definition "Croûte de couleur grise à noire, habituellement fortement adhérente, et qui se développe en milieu urbain, dans des zones protégées de l’impact direct de la pluie ou des ruissellements d’eau. Les croûtes noires sont principalement constituées de particules provenant de l’atmosphère, piégées dans une matrice de gypse (CaSO4.2H2O). [ICOMOS-ISCS]"@fr,
    "Kind of crust developing generally on areas protected against direct rainfall or water runoff in urban environment. Black crusts usually adhere firmly to the substrate. They are composed mainly of particles from the atmosphere, trapped into a gypsum (CaSO4.2H2O). matrix.. [ICOMOS-ISCS]"@en,
    "Schwarze Krusten entwickeln sich allgemein im urbanen Umfeld auf Flächen, die vor direktem Regen und Ablaufwasser geschützt sind. Sie haften gewöhnlich sehr fest auf dem Substrat. Sie setzen sich hauptsächlich aus Partikeln aus der Luft zusammen, die in einer Gipsmatrix (CaSO4 * 2 H2O) fixiert sind. [ICOMOS-ISCS] "@de,
    "Druh krusty, vyvíjející se obecně v městskémprostředí na plochách chráněných před přímým deštěm nebostékáním vody. Černé krusty obvykle pevně lpí na substrátu.Jsou složeny hlavně z částic z atmosféry, zachycených do sádrovcovézákladní hmoty (CaSO4 . 2H2O). [ICOMOS-ISCS] "@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ef0a8695,
    :conceptScheme_34ca6582;
  skos:prefLabel "croûte noire"@fr, "black crust"@en, "Schwarze Kruste "@de, "černá krusta"@cs;
  skos:broader :c_0b71e4f3;
  dct:created "2019-06-19T10:38:11.000"^^xsd:dateTime;
  dct:modified "2021-01-30T16:46:53.000"^^xsd:dateTime .

:c_0f408aaa a skos:Concept;
  skos:definition "Croûte composée de sels solubles, qui se développe dans un contexte de forte teneur en sel, au gré des cycles d’humectation-dessiccation. [ICOMOS-ISCS]"@fr,
    "Crust composed of soluble salts, which develop in the presence of high salt levels, and form from wetting and drying cycles. [ICOMOS-ISCS] "@en,
    "Salzkrusten setzen sich aus löslichen Salzen zusammen und bilden sich in Gegenwart hoher Salzkonzentrationen durch Feucht-Trocken-Zyklen. [ICOMOS-ISCS] "@de,
    " Je složena z rozpustných solí. Vyvíjí se za přítomnosti vysokého obsahu solí a tvoří se při cyklickém střídání vlhnutí a vysýchání. [ICOMOS-ISCS] "@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ef0a8695,
    :conceptScheme_34ca6582;
  skos:prefLabel "croûte saline"@fr, "salt crust"@en, "Salzkruste"@de, "solná krusta"@cs;
  skos:altLabel "salt efflorescence"@en, "Salzausblühung "@de;
  skos:broader :c_0b71e4f3, :c_cbe4df8d;
  dct:created "2019-06-19T10:59:57.000"^^xsd:dateTime;
  dct:modified "2021-01-30T16:46:34.000"^^xsd:dateTime .

:c_9c6bb49b a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ef0a8695, :conceptScheme_ec8c77bf;
  skos:prefLabel "Festigungsmittel"@de, "consolidant"@en;
  skos:altLabel "Konsolidierungsmittel"@de, "Festiger"@de;
  skos:note "A substance introduced into friable material to strengthen it and to stabilise its structure. [EwaGlos]"@en,
    "Eine Substanz, die in ein bröckeliges Material eingebracht wird, um es zu stärken und sein Gefüge zu stabilisieren. [EwaGlos]"@de;
  skos:broader :c_9jb9am2u;
  skos:narrower :c_ec181a4b;
  dct:created "2019-06-20T17:25:03.000"^^xsd:dateTime;
  dct:modified "2021-01-30T15:44:33.000"^^xsd:dateTime .

:c_8c9ea27b a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ef0a8695;
  skos:prefLabel "nichtpigmentierter Malstoff"@de;
  skos:altLabel "farbloser Anstrich"@de;
  skos:broader :c_d26d92ce;
  skos:narrower :c_bci8b96z;
  dct:created "2020-05-18T11:47:07.000"^^xsd:dateTime;
  dct:modified "2021-01-30T15:42:19.000"^^xsd:dateTime .

:c_1d1124dc a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ef0a8695, :conceptScheme_ec8c77bf;
  skos:prefLabel "Injektionsmörtel"@de, "grout (injection)"@en;
  skos:altLabel "Verpressmörtel"@de, "Einspritzmörtel"@de, "Vergussmörtel"@de;
  skos:note "A thin, fluid, and diluted mortar (or paste) which can be poured or injected into small confined spaces such as cracks, joints, and cavities (also between a wall painting or a mosaic and the support). [EwaGlos]"@en,
    "Ein dünner, flüssiger und verdünnter Mörtel, der in enge Bereiche wie Risse, Fugen und Löcher (auch zwischen einer Wandmalerei oder einem Mosaik und dem Träger) gegossen oder eingespritzt (injiziert) werden kann. (EwaGlos)"@de;
  skos:broader :c_9jb9am2u;
  dct:created "2019-06-20T18:40:42.000"^^xsd:dateTime;
  dct:modified "2021-01-30T15:44:59.000"^^xsd:dateTime .

:c_1c7f7aaf a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd,
    :conceptScheme_ec8c77bf;
  skos:prefLabel "lime mortar"@en, "mortier de chaux"@fr, "Kalkmörtel"@de;
  skos:note "Powdered lime (which can be hydrated or hydraulic lime) or lime putty (rich/fat/lean lime), to which water, aggregates and fillers such as sand, marble, stone powder and sometimes fibres are added. Additives are sometimes also included. [EwaGlos]"@en,
    "Gemahlener Branntkalk (Weißkalkhydrat oder hydraulischer Kalk) oder Sumpfkalk, der mit Wasser, Zuschlag und Füllstoffen, wie Sand, Marmormehl, Steinmehl, und manchmal mit Fasern versetzt wird. Teilweise werden auch Zusatzmittel beigemischt. [EwaGlos]"@de;
  skos:broader :c_pjvitn4h;
  skos:narrower :c_9136af5c;
  dct:created "2019-06-20T19:39:44.000"^^xsd:dateTime;
  dct:modified "2021-01-22T15:57:36.000"^^xsd:dateTime .

:c_9136af5c a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd,
    :conceptScheme_ec8c77bf;
  skos:prefLabel "Kalkgipsmörtel"@de;
  skos:broader :c_1c7f7aaf;
  dct:created "2020-09-20T11:47:31.000"^^xsd:dateTime;
  dct:modified "2021-01-22T15:57:46.000"^^xsd:dateTime .

:c_54af5a6c a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ef0a8695, :conceptScheme_ec8c77bf;
  skos:prefLabel "Modellgips"@de, "plaster of Paris"@en;
  skos:altLabel "Formgips"@de, "Plaster of Paris"@de;
  skos:note "A white, fıne, inorganic and quicksetting powder that is made by heating gypsum to 120–180 °C in dry conditions (calcinated gypsum). It is composed of hemihydrate as well as impurities originating from the natural source, such as anhydrite. [EwaGlos]"@en,
    "Ein weißes, feines, anorganisches und schnell abbindendes Pulver, das beim Erhitzen von Gips bei 120–180 °C, unter trockenen Bedingungen, entsteht (kalzinierter Gips). Es besteht aus Halbhydrat und natürlichen Verunreinigungen, wie z.B. Anhydrit. [EwaGlos]"@de;
  skos:broader :c_b6prqhi5;
  dct:created "2019-07-05T20:21:29.000"^^xsd:dateTime;
  dct:modified "2021-01-30T14:59:15.000"^^xsd:dateTime .

:c_e3404b66 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_ec8c77bf;
  skos:prefLabel "tessera"@en, "tessera"@cs, "Tessera"@de;
  skos:altLabel "Tesserae (Plural)"@de, "Mosaikstein"@de, "Mosaiksteinchen"@de;
  skos:note "Cubic, polygonal or round pieces of a hard material used to create the decorative surface layer of mosaics. [EwaGlos]"@en,
    "Kubische, mehreckige oder runde Stücke aus einem harten Material, mit dem dekorative Oberflächen von Mosaiken hergestellt werden. [EwaGlos]"@de;
  skos:broader :c_389b7332;
  dct:created "2019-07-05T21:07:19.000"^^xsd:dateTime;
  dct:modified "2020-07-08T14:23:16.000"^^xsd:dateTime .

:c_4ad58c08 a skos:Concept;
  skos:definition "Musivische Arbeit, Einlegearbeit aus Steinen oder Glasstücken oder aus zurechtgeschnittenen und eingefassten Glasscherben. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
