:c_869fcd2d a skos:Concept;
  skos:definition "Sdružené jsou stavební prvky jednoho druhu, které jsou spojeny společným článkem, např. 2 sloupy se společnou patkou nebo abakem, půlkruhová segmentová okna se společným středním sloupkem. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_50ec0c5e, :conceptScheme_c8a571d9, :conceptScheme_37522b74, :conceptScheme_1d7ba54b,
