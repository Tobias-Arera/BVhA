:c_b72649ea a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ef0a8695, :conceptScheme_ec8c77bf;
  skos:prefLabel "Acrylat"@de, "acrylic"@en;
  skos:altLabel "Acrylsäureester"@de;
  skos:note "Synthetic polymers obtained from esters of acrylic or methacrylic acid (unsaturated organic acids). [EwaGlos]"@en,
    "Aus den Estern der Acrylsäure oder der Methacrylsäure (ungesättigte organische Säuren) gewonnene Kunststoffe. [EwaGlos]"@de;
  skos:broader :c_9jb9am2u;
