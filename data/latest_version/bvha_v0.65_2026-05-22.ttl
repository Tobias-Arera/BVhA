:c_f33a298f a skos:Concept;
  skos:definition "(Offener) Gartensaal eines Schlosses. [Koch 2009]"@de, "(Otevřený) zahradní sál zámku. [Koch 2008]"@cs,
    "Sala terrena (ital.), Gartensaal im Erdgeschoss eines Schlosses oder Palastes, meist im Mittelrisalit unter dem Hauptsaal als Übergang zum Park angeordnet. Die S.t. war urspr. offen und auch als Grotte ausgestaltet. [Koepf / Binding 2016]"@de,
    "Sala terrena f (ital., ›ebenerdiger Saal‹), zum Garten hin offener und manchmal als Grotte (Schloss Weißenstein / Pommersfelden BY) ausgebildeter Saal im barocken Schloss. Sie ist entweder unter dem Hauptsaal des Schlosses (Waldsteinpalais/Prag CZ) oder als Vorhalle zur Haupttreppe angelegt (Oberes Belvedere / Wien). B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_50ec0c5e, :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "Sala terrena"@de, "sala terrena"@cs;
  skos:broader :c_e329150d;
  dct:created "2019-09-24T15:59:32.000"^^xsd:dateTime;
  dct:modified "2021-01-30T13:15:58.000"^^xsd:dateTime;
  :broaderByFunction :c_e329150d .

:c_028abf0f a skos:Concept;
  skos:definition "Sakramentsnische, mit Gitter oder Tür verschlossene Mauernische in der Nordwand des Chors in der Nähe des Hauptaltars zur Aufbewahrung der Hostien, Kelche und liturg. Gefäße anstelle des Sakramenthauses. [Koepf / Binding 2016]"@de;
