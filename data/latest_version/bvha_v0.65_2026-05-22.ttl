  dct:modified "2021-01-26T23:12:29.000"^^xsd:dateTime .

:c_4186f7ec a skos:Concept;
  skos:definition "Atriumhaus, röm. Wohnhaus, dessen Räume um ein Atrium angeordnet sind, vom modernen Einfamilienhaus übernommen. [Koepf / Binding 2016]"@de;
