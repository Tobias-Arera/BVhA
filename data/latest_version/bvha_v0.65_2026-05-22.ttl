  dct:created "2020-09-03T16:48:05.000"^^xsd:dateTime;
  dct:modified "2021-01-24T15:55:05.000"^^xsd:dateTime .

:c_b7ec7117 a skos:Concept;
  skos:definition "Fußreliquiar n: ein als menschlicher Fuß geformtes Behältnis für eine Fußreliquie. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "pied-reliquaire"@fr, "foot-reliquary"@en, "Fußreliquiar"@de;
  skos:broader :c_2e3d5fc3;
  dct:created "2020-09-03T17:01:42.000"^^xsd:dateTime;
  dct:modified "2021-01-24T15:55:18.000"^^xsd:dateTime .

:c_355cb04f a skos:Concept;
  skos:definition "Handreliquiar n; lat. manus: ein Reliquienbehälter in Gestalt einer Hand. Bei früheren Formen sind die Finger ausgestreckt, spätere Beispiele zeigen die Hand oft im Segensgestus. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "maine-reliquaire"@fr, "hand-reliquary"@en, "Handreliquiar"@de, "manus"@la;
  skos:broader :c_2e3d5fc3;
  skos:related :c_059dd088;
  dct:created "2020-09-03T17:16:40.000"^^xsd:dateTime;
