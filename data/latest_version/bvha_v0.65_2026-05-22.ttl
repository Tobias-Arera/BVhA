:c_c72547db a skos:Concept;
  skos:definition "Aus Keilsteinen bzw. aus Backsteinen mit Keilfugen gespannter, waagerechter Abschluss einer Maueröffnung. Trotz horizontal verlaufender Untersicht bzw. innerer Leibung handelt es sich konstruktiv um einen Bogen, weil die Fugen zwischen den Wölbsteinen auf das Bogenzentrum hin ausgerichtet sind. Da dieser Bogen nicht sehr belastbar ist, wird oft ein Entlastungsbogen über ihm gespannt. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "flat arch"@en, "plate-bande"@fr, "Scheitrechter Bogen"@de, "přímý oblouk"@cs;
  skos:altLabel "Horizontalbogen"@de;
  skos:broader :c_eea5235b;
  dct:created "2019-02-18T20:24:04.000"^^xsd:dateTime;
  dct:modified "2020-07-29T19:48:10.000"^^xsd:dateTime;
  :broaderByShape :c_eea5235b .

:c_7b547b4e a skos:Concept;
  skos:definition "Bogen, dessen Bogenlinie die Form einer umgekehrt hängenden Kette zeigt; man spricht deshalb manchmal auch von einem umgekehrten Kettenbogen. Die Bogenschenkel bilden an den Kämpferpunkten immer einen stumpfen Winkel mit den senkrechten Stützen. [Glossarium Artis]"@de,
    "Bogen in Parabelform (Bogenformen). Der dem stat. Kräfteverlauf genau entsprechende P. wird v. a. in neuerer Zeit häufig verwendet. [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "arc parabolique"@fr, "parabolický oblouk"@cs, "parabolic arch"@en,
    "arco parabolico"@it, " arco parabólico"@es, "Parabelbogen"@de;
  skos:altLabel "catenary arch"@en, "arc en chaînette"@fr, "arc en parabole"@fr;
  skos:broader :c_2026364f;
  dct:created "2019-02-18T20:26:09.000"^^xsd:dateTime;
  dct:modified "2021-01-15T17:38:05.000"^^xsd:dateTime;
  :broaderByShape :c_2026364f .

:c_3f170982 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
