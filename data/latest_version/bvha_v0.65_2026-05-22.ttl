:c_1d77103a a skos:Concept;
  skos:definition "Die in einem großen Torflügel angebrachte kleine Tür für Fußgänger. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
