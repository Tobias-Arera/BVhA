:c_fda6b373 a skos:Concept;
  skos:definition "Westbau, architektonisch gestaltete Westfront einer Kirche. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "Westbau"@de, "fachada occidental"@es, "západní část kostela se dvěma věžemi"@cs,
