:c_bcd8cb72 a skos:Concept;
  skos:definition "Faszie (lat. fascia: Band, Mz. Faszien, Fasciae), leicht vorspringendes waagerechtes, bandartiges Bauglied am ionischen und korinthischen Architrav. [Koch 2009]"@de,
    "FASCIE (lat. fascia = pás), mírně vystupující vodorovný páskovitý architektonický článek na iónském a korintském architrávu. [Koch 2008]"@cs,
    "Faszien (lat. fasciae: Binden) heißen die drei, seltener zwei übereinanderliegenden, von unten nach oben leicht vorspringenden Streifen, die den Architrav der Ionischen und der Korinthischen Ordnung waagerecht unterteilen, auch auf Bogenstirn. [Koepf / Binding]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9, :conceptScheme_19d56a39;
  skos:prefLabel "fascia"@en, "fascie"@cs, "Faszie"@de, "banda de arquitrabe"@es, "fasce"@fr,
    "fascia"@la, "fascia"@it;
  skos:broader :c_d3971ceb;
  dct:created "2019-05-22T12:29:05.000"^^xsd:dateTime;
  dct:modified "2020-08-20T13:32:41.000"^^xsd:dateTime .

:c_5fea82d7 a skos:Concept;
  skos:definition "Stehende Hohlkehle mit vollem Überschlag, die in der Antike an Säulen und im Barock im Fensterbau üblich war. Vereinzelt wird auch fälschlicherweise der geradlinige Dreiviertelstab als Adlerschnabel bezeichnet. [Schrader / Voigt 2003]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
