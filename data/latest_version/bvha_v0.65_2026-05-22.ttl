:c_feaeb453 a skos:Concept;
  skos:definition "Kuppel der islam. Baukunst, die aus Stalaktitenformen zusammengesetzt ist. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
