:c_6a0e9676 a skos:Concept;
  skos:definition "Hammerartiges Werkzeug mit gezähnten Bahnen zur Feinbearbeitung weicher Steine. [Glossarium Artis, Bd. 3, Bögen und Mauerwerk]"@de,
    "Der Krönel kann als eine Weiterentwicklung der Zahnflächegesehen werden. Durch sein hohes Gewicht von bis zu über 5 kg und einer Schneidebreite von etwa 8 cm [...] ist er aber wesentlich effektiver im Abtragen von Material. Die Spitzen sind meist sehr schlank ausgeschmiedet.Heute werden etwa 14 - 20 Einzelspitzen in einerlänglichen Öffnung verkeilt. [...] Als Besonderheit hat der Kröne! einen Griff aus Eisen,[...]. Die etwas gröbere Variante mit dickeren, etwa 10 - 12 Einzelspitzen nennt man heute Spitzer. [Voelkle 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd,
    :conceptScheme_f10222e0;
  skos:prefLabel "marteau bretté"@fr, "roughing hammer"@en, "Krönel"@de, "zrnovák"@cs;
  skos:altLabel "brette"@fr, "bretture"@fr, "tooth axe"@en, "Kröneleisen"@de;
  skos:broader :c_7860420e;
  skos:related :c_a0a4566f, :c_d4ca725f;
  dct:created "2019-05-14T11:44:20.000"^^xsd:dateTime;
  dct:modified "2020-07-03T15:30:16.000"^^xsd:dateTime .

