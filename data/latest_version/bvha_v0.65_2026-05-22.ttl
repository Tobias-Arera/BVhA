:c_4a1d6816 a skos:Concept;
  skos:definition "Gewölbe, das nur einseitig vom Widerlager bis zum Scheitel aufgeführt ist, in der Regel eine Halbtonne. Es dient z.B. zur Überwölbung der Seitenschiffe mittelalterlicher Kirchen oder als Treppenunterwölbung. Zu unterscheiden vom Horngewölbe. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "demi-voûte "@fr, "half barrel vault"@en, "Einschenkliges Gewölbe"@de,
    "jednoramenná klenba"@cs;
  skos:altLabel "quadrant vault "@en;
  skos:broader :c_049c4c22;
