:c_6ca5bf7c a skos:Concept;
  skos:definition "Sheddach, Folge von parallel angeordneten Satteldächern über einem Baukörper, deren steiler angeordnete Flächen verglast sind. [Koepf / Binding 2016]"@de,
    "Též shedová, z angl. shed = kůlna, umožňuje dobře prosvětlené pracovní prostory. [Koch 2008]"@cs,
    "Sheddach, Dachform aus parallelen, einhüftigen Satteldächern, deren steilere Flächen verglast sind, bes. bei modernen Fabrik- und Ausstellungshallen. [Koepf / Binding 2016]"@de,
    "Sheddach (engl. shed = Schuppen), erlaubt lichtreiche Werkräume. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
