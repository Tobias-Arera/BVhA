:c_60639975 a skos:Concept;
  skos:definition "Putz mit rauer Oberfläche durch Verwendung grobkörniger Zuschlagstoffe oder auch durch spätere künstl. Aufrauung (Spritz- oder Graupelputz, Besenputz). Der R. dient meist als Unterputz (Anwurf), auf dem der Feinputz aufgetragen wird. [Koepf/Binding 2016] "@de,
    "Decorative surface and protective coating with a very rough surface, mainly used for exterior walls. [EwaGlos]"@en,
    "Dekorative Oberfläche und Schutzschicht mit einer sehr rauen Oberfläche, hauptsächlich für Außenwände. [EwaGlos]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_ec8c77bf;
  skos:prefLabel "crépi"@fr, "Rauputz"@de, "enlucido áspero"@es, "hrubá omítka"@cs,
    "rough cast"@en;
  skos:altLabel "intonaco rustico"@it, "Rauhputz"@de, "Strukturputz"@de, "Berapp"@de,
    "Grob(ver)putz"@de, "drsná omítka"@cs, "crépissure"@fr, "rough plaster"@en, "pebbledash"@en,
    "roughcast plaster"@en;
  skos:broader :c_wdriolje;
  dct:created "2019-05-07T18:06:30.000"^^xsd:dateTime;
  dct:modified "2021-01-25T15:53:58.000"^^xsd:dateTime .

:c_6a10351c a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_ec8c77bf;
  skos:prefLabel "ground"@en, "základní nátěr"@cs, "Grundierung"@de;
  skos:altLabel "grounding"@en;
  skos:note "The first preparatory coat applied to an image carrier, to build a fine surface for the painting. [EwaGlos]"@en,
    "Die erste vorbereitende Beschichtung eines Bildträgers, auf dessen feiner Oberfläche sich die Malerei aufbaut. [EwaGlos]"@de;
  skos:broader :c_ab388abe;
  dct:created "2019-05-07T18:14:47.000"^^xsd:dateTime;
  dct:modified "2021-01-25T15:58:30.000"^^xsd:dateTime .

:c_b4b6de6a a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_ec8c77bf;
  skos:prefLabel "underpaint"@en, "podmalba"@cs, "Untermalung"@de;
  skos:altLabel "undercoat"@en, "base coat"@en;
  skos:note "A preliminary layer of paint. It serves as a base for subsequent layers of paint and to define colour values for later painting details. It is always intended to be painted over. [EwaGlos]"@en,
    "Eine vorbereitende Malschicht. Sie dient nicht nur als Basis für darauffolgende Farbschichten, sondern auch dazu, Farbwerte späterer Malereidetails zu definieren. Sie ist immer dazu bestimmt, übermalt zu werden. [EwaGlos]"@de;
  skos:broader :c_ab388abe;
  dct:created "2019-05-07T18:15:12.000"^^xsd:dateTime;
  dct:modified "2021-01-25T16:00:56.000"^^xsd:dateTime .

:c_630e3a08 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_ec8c77bf;
  skos:prefLabel "glaze"@en, "lazura"@cs, "Lasur"@de;
  skos:note "A thin transparent or semi-transparent layer on a wall painting with the function of modifying the appearance of the underlying paint layer. [EwaGlos]"@en,
    "Eine dünne, transparente oder halbtransparente Schicht auf einer Wandmalerei, die die optische Wirkung der darunterliegenden Farbschicht verändern soll. [EwaGlos]"@de;
  skos:broader :c_ab388abe;
  dct:created "2019-05-07T18:15:30.000"^^xsd:dateTime;
  dct:modified "2021-01-25T15:58:40.000"^^xsd:dateTime .

:c_04d8687e a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_ec8c77bf;
  skos:prefLabel "painting stratigraphy"@en, "stratigrafie malby"@cs, "Fassungsaufbau"@de;
  skos:note "Layers of a paint consisting of pigments in a binder, sometimes with inorganic fillers or with an added protective coating. [EwaGlos]"@en,
    "Malschichten aus Pigmenten in einem Bindemittel, manchmal mit anorganischen Füllstoffen oder mit einer schützenden Beschichtung. [EwaGlos]"@de;
  skos:broader :c_ab388abe;
  dct:created "2019-05-07T18:20:43.000"^^xsd:dateTime;
  dct:modified "2021-01-25T15:58:09.000"^^xsd:dateTime .

:c_3736436c a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_ec8c77bf;
  skos:prefLabel "pentimento"@en, "pentimento"@cs, "Pentimento"@de;
  skos:altLabel "Korrekturen"@de, "Reuestriche"@de;
  skos:note "Correction of the painting done by the artist himself. [EwaGlos]"@en, "Vom Künstler selbst ausgeführte Korrektur an der Malerei. [EwaGlos]"@de;
  skos:broader :c_ab388abe;
  dct:created "2019-07-24T18:23:41.000"^^xsd:dateTime;
  dct:modified "2021-01-26T10:38:44.000"^^xsd:dateTime .

:c_d54caea2 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_ec8c77bf;
  skos:prefLabel "decorative application"@en, "dekorativní aplikace"@cs, "dekorative Applikationen"@de;
  skos:altLabel "Applikationen"@de, "dekorativní výplň"@cs;
  skos:note "Decoration and embellishing of wall paintings with the use of various materials (glass, stone fragments, metal foils, etc.), applied after completion. [EwaGlos]"@en,
    "Dekorieren und Verzieren von Wandmalereien nach deren Fertigstellung mit unterschiedlichen Materialien (Glas, Steinfragmenten, Blattmetall etc.). [EwaGlos]"@de;
  skos:broader :c_ab388abe;
  dct:created "2019-07-24T18:29:33.000"^^xsd:dateTime;
  dct:modified "2021-01-25T15:56:39.000"^^xsd:dateTime .

:c_b3d9b36f a skos:Concept;
  skos:definition "In der Freskomalerei verwendete Vorzeichnung, die direkt auf die Wand oder auf den Ausgleichsputz oder Arriccio/Grobputz platziert wird. [EwaGlos]"@de,
    "A preparatory drawing used in fresco painting placed directly onto the wall or on the levelling coat (floating coat) or arriccio. [EwaGlos]"@en;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_57be8ee8, :conceptScheme_ec8c77bf;
  skos:prefLabel "sinopia"@en, "sinopie"@cs, "Sinopie"@de;
  skos:altLabel "Sinopia"@de, "Rauputzzeichnung"@de, "Arricio-Vorzeichnung"@de;
  skos:broader :c_ab388abe, :c_3f0545b6;
  dct:created "2019-10-15T10:53:26.000"^^xsd:dateTime;
  dct:modified "2021-01-25T16:00:22.000"^^xsd:dateTime .

:c_3f0545b6 a skos:Concept;
  skos:definition "Malerei mit in Wasser angeriebenen, kalkbeständigen Farben auf frischem (ital. fresco), kurz vorher aufgetragenem Kalkputz. Die Farben dringen in die nasse Putzschicht ein und bleiben nach dem Trocknen unlösl. mit ihr verbunden. Da bei dieser Technik das einmal Begonnene noch am gleichen Tag vollendet sein muss, werden große Fresken abschnittsweise ausgeführt, was eine genaue Vorplanung des Ganzen erfordert. Als Hilfsmittel hierzu dienen Kartons mit Vorzeichnungen in der Größe des Originals, deren Umrisse auf die Wand übertragen werden. F. kannten bereits die Ägypter, Babylonier und Griechen, die Etrusker und v.a. die Römer. Im MA wurden ganze Kirchen in Freskotechnik ausgemalt, manchmal in Verbindung mit Seccomalerei. Einen bedeutenden Aufschwung nahm die F. in der Renaissance, bes. in Italien, wo fast alle großen Maler auch Fresken geschaffen haben. Sie erreichte ihren Höhepunkt in der Deckenmalerei des Barock (Decken-, Wand-, Architekturmalerei, Fassadenmalerei). [Koepf / Binding 2016]"@de,
    "(ital., ›frisch‹), Farbauftrag ohne jedes Bindemittel auf den noch feuchten Putz; es bildet sich an der Oberfläche eine harte, sehr stabile Schicht, die der Malerei größere Haltbarkeit verleiht als diejenige, die auf den trockenen Putz aufgetragen wurde. Bei dieser Technik kann nur jeweils so viel Putz aufgetragen werden, wie vor dem Abtrocknen bemalt werden kann (Tagewerk). Die F.-Technik ist bereits in der Antike verbreitet gewesen. Wandmalereien in Pfalzen und Burgen, die schon für die karolingische Zeit schriftlich überliefert sind, wurden aber meist trocken angebracht. Erst mit der Renaissance wurden auch in Schlössern wieder echte F.en angebracht. Stilbildend wirkte hier die Ausstattung des Schlosses Fontainebleau F durch italienische Künstler unter der Leitung von Rosso Fiorentino und Francesco Primaticcio ab 1530. Wand- und Decken-F.en, in denen häufig dem Bauherrn in einer Allegorie gehuldigt wurde, spielten vor allem im 18. Jh. eine große Rolle. Häufig wurden die F.en benutzt, um illusionistische Raumerweiterungen vorzunehmen (Wandmalerei). Eines der besten Beispiele dieser Kunst findet sich in der Residenz in Würzburg BY, wo Gian Battista Tiepolo 1751–53 die Decken des Treppenhauses und des Kaisersaales ausmalte. B. Sch.-W. . [Wörterbuch der Burgen, Schlösser und Festungen]"@de,
    "Fresko-Malerei (ital. fresco = frisch), Malerei mit laugenechten Wasserfarben auf frischem Kalkputz, der beim Abbinden ( = Trocknen bei gleichzeitiger Aufnahme von Kohlensäure aus der Luft) die Farben an den Grund bindet. Seit 1300; besonders im Barock als Deckenmalerei. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_84fc24e6, :conceptScheme_8c0441f9, :conceptScheme_1d7ba54b, :conceptScheme_ec8c77bf;
  skos:prefLabel "fresco"@en, "Freskotechnik"@de;
  skos:note "A wall painting technique in which pigments are mixed with clear water and applied to a fresh and still damp lime plaster (intonaco); pigments are fixed inside a thin layer of calcium carbonate formed on the plaster surface (carbonation). [EwaGlos]"@en,
    "Wandmalerei-Technik, bei der die Pigmente mit klarem Wasser vermischt und auf den noch frischen, feuchten Kalkputz (Intonaco) aufgetragen werden. Die Pigmente werden in einer dünnen Calciumcarbonatschicht gebunden, die sich in der Putzoberfläche bildet (Karbonatisierung). [EwaGlos]"@de;
  skos:broader :c_d6df06d8;
  skos:narrower :c_b3d9b36f, :c_9c8e3465, :c_f6504380;
  dct:created "2019-07-19T22:28:09.000"^^xsd:dateTime;
  dct:modified "2021-01-18T14:02:02.000"^^xsd:dateTime .

:c_c6760875 a skos:Concept;
  skos:definition "Ein Raster oder Muster von gitterartig, vertikal und horizontal (parallel) verlaufenden Linien zur Übertragung einer Komposition von der Skizze auf einen anderen Träger. [EwaGlos]"@de,
    "A framework or pattern of vertical and horizontal (parallel) lines used to transfer the composition from a sketch to another support. [EwaGlos]"@en;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_ec8c77bf;
  skos:prefLabel "grid"@en, "kvadratura"@cs, "Quadratur (Malschicht)"@de;
  skos:altLabel "Rastergitter"@de, "Quadratnetz"@de, "Koordinatennetz"@de, "Fadennetz"@de,
    "Quadratraster"@de, "čtvercová síť"@cs;
  skos:broader :c_ab388abe;
  dct:created "2019-10-15T11:12:43.000"^^xsd:dateTime;
  dct:modified "2021-01-25T15:59:42.000"^^xsd:dateTime .

:c_c579be33 a skos:Concept;
  skos:definition "Zeichnung, die vor der Ausführung des Werkes angelegt wird, worauf sich üblicherweise Ausführungen mit einem anderen Malmittel anschließen. [EwaGlos]"@de,
    "Drawing done before further work is undertaken, that is usually followed by work in adifferent medium. This is done on the intonaco in the case of murals. [EwaGlos]"@en;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_ec8c77bf;
  skos:prefLabel "preparatory drawing"@en, "náčrt"@cs, "Vorzeichnung"@de;
  skos:broader :c_ab388abe;
  dct:created "2019-10-15T11:19:14.000"^^xsd:dateTime;
  dct:modified "2021-01-26T10:38:03.000"^^xsd:dateTime .

:c_2ee6d7bf a skos:Concept;
  skos:definition "Design transfer from a cartoon onto a plaster employing a point or stylus (also called the stylus method). [EwaGlos]"@en,
    "Übertragung einer Zeichnungvom Karton auf einen Verputz mit einem spitzenGriffel oder einer Nadel. [EwaGlos]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_57be8ee8, :conceptScheme_ec8c77bf;
  skos:prefLabel "indirect incision"@en, "průtisk"@cs, "Durchdrückverfahren"@de;
  skos:altLabel "stylus method"@en;
  skos:broader :c_ab388abe, :c_7acece55;
  dct:created "2019-10-15T12:01:32.000"^^xsd:dateTime;
  dct:modified "2021-01-25T15:57:49.000"^^xsd:dateTime .

:c_7acece55 a skos:Concept;
  skos:definition "Die malerischen Techniken werden unterschieden: nach ihren Untergründen in Wandmalerei, Sgraffito, Mosaik, Glas-, Tafel-, Fass-, Buchmalerei, nach den Lösungsmitteln, mit denen die Farbpigmente streichfähig gemacht werden, bzw. nach den Bindemitteln, mit denen die Farbpigmente untereinander und auf ihren Untergrund gebunden werden. [Koch 2009]"@de,
    "Malířské techniky se rozlišují: podle podkladu na nástěnnou malbu (sgrafito, mozaiku), vitrail (malbu na skle), deskovou malbu, štafírování, knižní malbu a podle rozpouštědla, jímž se barevné pigmenty stávají natíratelnými, resp. podle pojiva, ktere spojuje barevné pigmenty navzájem a s jejich podkladem. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9;
  skos:prefLabel "Malereitechnik"@de, "malířské techniky"@cs;
  skos:altLabel "Malerei"@de, "Maltechnik"@de;
  skos:broader :c_1df9f722;
  skos:narrower :c_2ee6d7bf, :c_30d1288a, :c_d6df06d8, :c_89024b9b, :c_7f2526f3, :c_f687386b,
    :c_48a16263, :c_afccf351, :c_52ed134b, :c_79b87b82, :c_3abd0746, :c_5c24d03f, :c_3b7818fa,
    :c_9b3850f1, :c_3e966bbf, :c_0a6636f8, :c_fc121fad, :c_faaf9c18, :c_2882bcb6, :c_eb0f6a4b,
    :c_hvqjmvb3;
  dct:created "2019-10-16T10:39:39.000"^^xsd:dateTime;
  dct:modified "2021-01-18T13:58:37.000"^^xsd:dateTime .

:c_30d1288a a skos:Concept;
  skos:definition "Reproduktionstechnik für ein ornamentales Muster, bei der man eine Schablone als Vorlage verwendet. [EwaGlos]"@de,
    "Reproduction technique to produce an ornamental pattern, with the use of a template. [EwaGlos]"@en;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_57be8ee8;
  skos:prefLabel "stencil"@en, "šablonová malba"@cs, "Schablonenmalerei"@de;
  skos:broader :c_ab388abe, :c_7acece55;
  dct:created "2019-10-15T13:04:14.000"^^xsd:dateTime;
  dct:modified "2021-01-25T16:00:11.000"^^xsd:dateTime .

:c_d6df06d8 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_ec8c77bf;
  skos:prefLabel "nástěnná malba"@cs, "wall painting"@en, "Wandmalereitechnik"@de;
  skos:altLabel "mural painting"@en, "Wandmalerei"@de;
  skos:note "Painting executed directly on an architectural surface; can include various  painting techniques. [EwaGlos]"@en,
    "Malerei auf Architekturoberflächen, die in verschiedenen Maltechniken ausgeführt sein kann. [EwaGlos]"@de;
  skos:broader :c_36969a5d, :c_7acece55;
  skos:narrower :c_3f0545b6, :c_3b683e1f, :c_a98bf67f, :c_89024b9b, :c_7f2526f3;
  dct:created "2019-05-07T18:16:50.000"^^xsd:dateTime;
  dct:modified "2021-01-18T14:01:55.000"^^xsd:dateTime .

:c_3b683e1f a skos:Concept;
  skos:definition "Kratzputz, Putz aus mehreren farbig getönten Schichten. Durch Abkratzen der oberen Schichten stößt man auf die andersfarbigen unteren Schichten, wodurch man architekton„ figürl. oder ornamentale Dekorationen von großer Haltbarkeit erzielen kann. [Koepf / Binding 2016]"@de,
    "Ital. sgraffire = škrábat. Nástěnné malby odolné povětrnostním vlivům. Různobarevné vrstvy šlechtěné omítky ležící nad sebou jsou vyškrabovány do takové hloubky, že je vidět požadovaná barva; v italské renesanci bývala černá, šedivá nebo červená omítka přetřena bílou a obraz byl pak vyškrábán v čerstvém nátěru. [Koch 2008]"@cs,
    "Aus mehreren, farblich verschiedenen Schichten bestehender Putz, der in feuchtem Zustand mit einem gezähnten Werkzeug, dem sogenannten Kamm m, bearbeitet wird, um eine Musterung der Oberfläche zu erreichen. [Glossarium Artis, Bd. 3, Bögen und Mauerwerk]"@de,
    "Sgraffito (ital. sgraffiare = kratzen), Kratzputz, wetterbeständige Wandmalerei, bei der verschiedenfarbige, übereinanderliegende Edelputzschichten so tief herausgekratzt werden, bis die gewünschte Farbe sichtbar wird. In der italienischen Renaissance wird schwarzer, grauer oder roter Putz weiß übertüncht, die Zeichnung aus der frischen Tünche herausgekratzt. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9, :conceptScheme_1f14b4dd, :conceptScheme_ec8c77bf;
  skos:prefLabel "sgraffite"@fr, "sgrafito"@cs, "sgraffito"@en, "graffito"@it, "esgrafiado"@es,
    "Sgraffito"@de;
  skos:altLabel "Farbputz"@de, "Kratzputztechnik"@de, "Schabkunst"@de, "Kratzkunst"@de,
    "Ritzkunst"@de;
  skos:note "Multi-layer decoration technique executed by scratching the upper plaster layer to reveal parts of the underlying (e.g. dark plaster) layer. [EwaGlos]"@en,
    "Eine dekorative, mehrschichtige Dekorationstechnik, bei der durch Abkratzen der oberen Putzschicht Teile der darunterliegenden (z.B. dunkleren) Putzschicht freigelegt werden. [EwaGlos]"@de;
  skos:broader :c_e6f0e9cc, :c_d6df06d8;
  dct:created "2019-07-15T13:13:04.000"^^xsd:dateTime;
  dct:modified "2021-01-18T14:03:27.000"^^xsd:dateTime .

:c_a98bf67f a skos:Concept;
  skos:definition "Im Gegensatz zur Freskomalerei eine Wandmalerei auf trockener Putzfläche. [Koepf / Binding 2016]"@de,
    "(ital. al secco ›auf dem Trockenen‹) Malen auf trockenem Putz im Gegensatz zum Fresko, das auf den noch feuchten Putz gemalt wird. Da sie weniger haltbar ist, wurde S. vor allem in Innenräumen verwendet. Ihr Vorteil ist, dass auch vorhandene Flächen und andere Trägermaterialien (Holz, Leinwand, Stein) bemalt werden können. Gerade die im Burgenbau vorkommende Wandmalerei, etwa die Fugenmalerei, Fensterumrahmungen, gemalte Friese und Ornamentmalerei, wurde häufig als S. aufgebracht. Bei vielen barocken Deckenmalereien, die als Fresko aufgebracht wurden, wurden mit Hilfe der S. noch zusätzlich Lichter aufgesetzt und Feinheiten eingearbeitet. B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen]"@de,
    "Al-secco-Malerei (ital. secco = trocken), Wasserfarben auf trockener Wand. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_8c0441f9, :conceptScheme_ec8c77bf;
  skos:prefLabel "peinture à secco"@fr, "al secco"@cs, "secco"@en, "pittura a secco"@it,
    "pintura en seco"@es, "Secco"@de;
  skos:altLabel "Secco-Malerei"@de, "Trockenmalerei"@de, "Sekko-Technik"@de, "Seccomalerei"@de,
    "Al secco"@de, "secco painting"@en;
  skos:note "A wall painting technique where pigments mixed with an organic binder and /or lime are applied onto a dry plaster. [EwaGlos]"@en,
    "Bei dieser Wandmalereitechnik werden Pigmente in einem organischen Bindemittel und/oder in Kalk gebunden und auf einen trockenen Putz aufgetragen. [EwaGlos]"@de;
  skos:broader :c_d6df06d8;
  dct:created "2019-07-19T23:01:06.000"^^xsd:dateTime;
  dct:modified "2021-01-18T14:03:17.000"^^xsd:dateTime .

:c_89024b9b a skos:Concept;
  skos:definition "Ölmalerei, Farbpigmente in flüchtigen Ölen (Terpentinöl), Benzin usw. gelöst. Bindemittel: Lein-, Mohn-, Nussöl. Lasierend oder deckend aufgetragen. Trocknet durch Verdunsten des Lösungsmittels und Oxydation des Öls zu hygroskopischem Linoxyn. Seit 15. Jh., besonders für Tafelmalerei, zunächst nur auf Holz, später auf Leinen, auch Pappe, Kupfer, für Wandmalerei auf trockenen Putz. Bei den modernen Binderfarben werden Kunstharze als Bindemittel verwendet. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_8c0441f9, :conceptScheme_ec8c77bf;
  skos:prefLabel "Ölmalerei"@de, "oil painting"@en, "olejomalba"@cs;
  skos:note "A technique which uses pigments mixed with drying oils (e.g. linseed or walnut oil), sometimes with the addition of resin and siccative. [EwaGlos]"@en,
    "Eine Maltechnik, für die Pigmente, vermischt mit trocknenden Ölen (z.B. Leinöl oder Walnußöl), verwendet werden, die manchmal mit Harz und Sikkativ versetzt sind. [EwaGlos]"@de;
  skos:broader :c_7acece55, :c_d6df06d8;
  dct:created "2019-07-24T18:34:39.000"^^xsd:dateTime;
  dct:modified "2021-01-18T14:01:02.000"^^xsd:dateTime .

:c_7f2526f3 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8;
  skos:prefLabel "Temperatechnik"@de;
  skos:broader :c_7acece55, :c_d6df06d8;
  dct:created "2020-12-02T14:59:58.000"^^xsd:dateTime;
  dct:modified "2021-01-18T14:01:49.000"^^xsd:dateTime .

:c_badbbe3d a skos:Concept;
  skos:definition "Fissure traversant complètement une pierre. [ICOMOS-ISCS]"@fr, "Crack having the form of a star. Rusting iron ormechanical impact are possible causes of this type of damage. [ICOMOS-ISCS]"@en,
    "Die Risse haben das Aussehen von einem Stern. [ICOMOS-ISCS]"@de, "shluk trhlin ve tvaru hvězdicovitě se rozbíhajících paprsků. [ICOMOS-ISCS]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_315cf028,
    :conceptScheme_ef0a8695, :conceptScheme_34ca6582;
  skos:prefLabel "fissuration en étoile"@fr, "star crack"@en, "Rostsprengung"@de, "hvězdicovitá trhlina"@cs;
  skos:broader :c_a2e37af3, :c_jfpkvat1;
  dct:created "2019-05-08T17:05:18.000"^^xsd:dateTime;
  dct:modified "2021-01-30T17:37:26.000"^^xsd:dateTime .

:c_43ba4a89 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ec8c77bf, :conceptScheme_34ca6582;
  skos:prefLabel "Schadensursache"@de, "deterioration sources"@en;
  skos:broader :c_eb645b9b;
  skos:narrower :c_d7a0b51a, :c_776b5861, :c_a2e37af3, :c_25b71ee6, :c_5bb04825, :c_c2d76511,
    :c_63d87b7c, :c_a37cbf12, :c_9383da1e, :c_2d947252;
  dct:created "2019-05-15T17:47:14.000"^^xsd:dateTime;
  dct:modified "2025-11-04T15:30:44"^^xsd:dateTime .

:c_c299d5b5 a skos:Concept;
  skos:definition "Réseau de fissures peu ouvertes. Le termefaïençage n’est pas approprié pour la pierre : il décrit unréseau de fissures affectant un émail, un enduit. [ICOMOS-ISCS]"@fr,
    "Network of minor cracks also called crack network. The term crazing is not appropriate for stone, as thisterm should be used for describing the development of a cracknetwork on glazed terracotta. [ICOMOS-ISCS]"@en,
    "auch Rissnetz genannt, ist ein Netzwerk von kleineren Rissen. [ICOMOS-ISCS]"@de,
    "síť malých trhlin na povrchu kamene.  [ICOMOS-ISCS]"@cs;
  skos:scopeNote "Netzwerk aus kleinen Rissen, welche die Oberfläche überziehen. Der Begriff „Glasurrisse“ ist für Gesteine nicht geeignet, weil dieser Begriff nur benützt werden sollte, um die Bildung von Netzwerkrissen auf glasierter Terrakotta zu beschreiben.  [ICOMOS-ISCS] "@de,
    "Network of minor cracks also called crack network. The term crazing is not appropriate for stone, as this term should be used for describing the development of a crack network on glazed terracotta. [ICOMOS-ISCS] "@en;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ef0a8695,
    :conceptScheme_34ca6582;
  skos:prefLabel "craquellement"@fr, "craquele"@en, "Krakelee"@de, "krakelování"@cs;
  skos:altLabel "Craquelé"@de;
  skos:broader :c_jfpkvat1;
  dct:created "2019-05-08T17:23:46.000"^^xsd:dateTime;
  dct:modified "2021-01-30T17:36:41.000"^^xsd:dateTime .

:c_d2e2ffe3 a skos:Concept;
  skos:definition "Décrit le développement d’une cassure le long deplans de faiblesse tels que microfissures, couches argileuses,dans le cas où ces éléments structuraux sont orientés verticalement.Une pierre posée en délit, par exemple une colonne,peut se cliver le long des plans de litage si la charge qu’ellesupporte est trop importante. [ICOMOS-ISCS]"@fr,
    "Fracturing of a stone along planes of weaknesssuch as microcracks or clay/silt layers, in case where the structuralelements are orientated vertically. For instance, a columnmay split into several parts along bedding planes if the loadabove it is too high. [ICOMOS-ISCS]"@en,
    "Auseinanderbrechen eines Steins entlang Schwächezonen wie Mikrorissen oder Ton-/Siltlagen, wenn diese vertikal ausgerichtet sind. [ICOMOS-ISCS]"@de,
    "pukání kamene podél ploch oslabení jako jsou mikropukliny, laminy jílu a siltu v hornině, zejména u konstrukčních prvků orientovaných (osazených) vertikálně. [ICOMOS-ISCS]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_315cf028,
    :conceptScheme_ef0a8695, :conceptScheme_34ca6582;
  skos:prefLabel "clivage"@fr, "splitting"@en, "Spaltung"@de, "štěpení"@cs;
  skos:altLabel "Aufspaltung"@de;
  skos:broader :c_d7a0b51a, :c_jfpkvat1;
  dct:created "2019-05-08T17:40:15.000"^^xsd:dateTime;
  dct:modified "2021-01-30T17:38:24.000"^^xsd:dateTime .

:c_6dd37a1d a skos:Concept;
  skos:definition "Fissure d’ouverture inférieure à 0,1 mm. [ICOMOS-ISCS]"@fr, "Minor crack with width dimension < 0.1 mm [ICOMOS-ISCS]"@en,
    "Schmaler Riss mit einer Breite von < 0,1 mm. [ICOMOS-ISCS]"@de, "prasklina o šíři menší než 0,1 mm. [ICOMOS-ISCS]"@cs;
  skos:scopeNote "Sehr feiner Riss, von weniger als 1 mm Breite."@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ef0a8695,
    :conceptScheme_ec8c77bf, :conceptScheme_34ca6582;
  skos:prefLabel "Microfissure"@fr, "Hair crack"@en, "Haarriss"@de, "Vlasová trhlina"@cs;
  skos:altLabel "hairline crack"@en;
  skos:note "A minor, individual discontinuity that is visible on the surface. [EwaGlos]"@en,
    "Kleine, einzelne Unterbrechung/ Diskontinuität der Oberfläche. [EwaGlos]"@de;
  skos:broader :c_jfpkvat1;
  dct:created "2019-05-08T17:45:12.000"^^xsd:dateTime;
  dct:modified "2021-01-30T17:35:56.000"^^xsd:dateTime .

:c_9b20ce52 a skos:Concept;
  skos:definition "The detachment of surface layers of stone parallel to the stone surface (like fish scales). These are larger than flakes (flaking). [EwaGlos]"@en,
    "Separated, air-filled, raised hemispherical elevations on the face of stone resulting from the detachment of an outer stone layer. This detachment is not related to the stone structure. [ICOMOS-ISCS]"@en,
    "Détachement d’une couche superficielle de la pierresous forme d’un bombement creux plus ou moins fissuré,et de forme sub-hémisphérique. Ce détachementest indépendant de la structure interne de lapierre. [ICOMOS-ISCS]"@fr,
    "Das Ablösen der oberen Schichten vom Stein parallel zu dessen Oberfläche (wie Fischschuppen). Schalen sind größer als Schuppen. [EwaGlos]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ef0a8695,
    :conceptScheme_ec8c77bf, :conceptScheme_34ca6582;
  skos:prefLabel "blistering "@en, "boursourflure"@fr, "Schalenbildung"@de;
  skos:altLabel "cloque"@fr, "Abschalen"@de;
  skos:broader :c_ed43f447, :c_61354695;
  skos:narrower :c_be6dd5fa;
  dct:created "2019-05-08T18:23:05.000"^^xsd:dateTime;
  dct:modified "2021-01-30T16:30:32.000"^^xsd:dateTime .

:c_4ce49fc6 a skos:Concept;
  skos:definition "Perte locale de matière en surface de la pierre, dueà des pressions internes, se manifestant habituellementsous la forme d’un cratère à bords irréguliers. [ICOMOS-ISCS]"@fr,
    "Local loss of the stone surface from internal pressureusually manifesting in the form of an irregularlysidedcrater. [ICOMOS-ISCS]"@en,
    "Lokaler Verlust der Steinoberfläche durch inneren Druck, im Allgemeinen in Form eines ungleichmäßig begrenzten Kraters. [ICOMOS-ISCS]"@de,
    "lokální ztráta povrchu kamene v důsledku vnitřního tlaku, obvykle se projevující ve formě nepravidelných jamek (kráterů). [ICOMOS-ISCS]"@cs;
  skos:scopeNote "Bursting is sometimes preceded by star-shaped face-fractur ing. This deterioration pattern is due to the increase of vol ume of mineral inclusions (clays, iron minerals, etc.) naturally contained in the stone and situated near its surface. The corrosion of metallic reinforcing elements may also induce bur sting. [ICOMOS-ISCS]"@en;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ef0a8695,
    :conceptScheme_34ca6582;
  skos:prefLabel "eclatement"@fr, "bursting"@en, "Abplatzung"@de, "odštípnutý"@cs;
  skos:altLabel "break out"@en, "vylomeni"@cs, "Ausbruch"@de;
  skos:broader :c_61354695;
  dct:created "2019-05-08T18:39:15.000"^^xsd:dateTime;
  dct:modified "2021-01-30T16:23:36.000"^^xsd:dateTime .

:c_541a23f8 a skos:Concept;
  skos:definition "Détachement selon une orientation préexistanteconduisant à la dissociation d’une ou quelques couches(lamines). Il affecte les pierres présentant unlitage (pierres d’origine sédimentaire) ou des plansde schistosité (pierres d’origine métamorphique).L’épaisseur et la forme des couches sont variables. [ICOMOS-ISCS]"@fr,
    "Detachment process affecting laminated stones(most of sedimentary rocks, some metamorphicrocks...). It corresponds to a physical separation intoone or several layers following the stone laminae.The thickness and the shape of the layers are variable.The layers may be oriented in any direction withregards to the stone surface. [ICOMOS-ISCS]"@en,
    "Prozess der Gesteinsablösung, der geschichtete Gesteine angreift (zumeist Sedimentgesteine, einige metamorphe Gesteine). Schichtspaltung entspricht einer physikalischen Trennung in einer oder mehrere Lagen, welche der Gesteinsschichtung folgen. Die Dicke und Form der Schichten sind variabel. Die Schichten können in jeglicher Richtung bezüglich der Steinoberfläche orientiert sein. [ICOMOS-ISCS]"@de,
    "oddělování vrstev (delaminace) postihuje vrstevnaté horniny (většinu sedimentárních hornin a některé horniny metamorfované). odpovídá fyzickému oddělení jedné nebo několika vrstev podél horninové laminy. Mocnost a tvar vrstev jsou proměnné a vrstvy mohou být orientovány jakýmkoliv směrem vzhledem k povrchu kamene. [ICOMOS-ISCS]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ef0a8695,
    :conceptScheme_34ca6582;
  skos:prefLabel "délitage"@fr, "delamination"@en, " Schichtparalelle Ablösung "@de,
    " oddělení vrstev "@cs;
  skos:altLabel "délamination"@fr, "délitement"@fr, "layering"@en, "Schichtweise Ablösung "@de,
    "rozvrstvení"@cs;
  skos:broader :c_61354695;
  skos:narrower :c_43bd3094;
  dct:created "2019-05-08T18:53:06.000"^^xsd:dateTime;
  dct:modified "2021-01-30T16:33:32.000"^^xsd:dateTime .

:c_96916a56 a skos:Concept;
  skos:definition "Détachement de grains individuels ou d’agrégats degrains. Les particules du matériau ne sont plus liées. [ICOMOS-ISCS]"@fr,
    "Detachment of single grains or aggregates of grains. [ICOMOS-ISCS]"@en, "Ablösung von einzelnen Körnern oder Kornaggregaten. [ICOMOS-ISCS]"@de,
    "Oddělování zrn nebo shluků zrn. [ICOMOS-ISCS]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ef0a8695,
    :conceptScheme_34ca6582;
  skos:prefLabel "désagrégation"@fr, "disintegration"@en, " Desegregation "@de, "dezintegrace"@cs;
  skos:altLabel "Pulverisierung"@de, "loss of cohesion"@en;
  skos:broader :c_61354695;
  skos:narrower :c_0e66c7c6, :c_139610df, :c_b1b305ee, :c_a42a5521, :c_880cbd0e;
  dct:created "2019-05-08T19:12:36.000"^^xsd:dateTime;
  dct:modified "2021-01-30T16:24:32.000"^^xsd:dateTime .

:c_b58f9cbc a skos:Concept;
  skos:definition "Décollement partiel ou total d’une fine couche(épaisseur inframillimétrique à millimétrique) ayantl’aspect d’un film ou d’un revêtement appliqué sur lapierre. [ICOMOS-ISCS]"@fr,
    "The partial detachment of a superficial layer which often looks like a detached coating that has been applied to its surface. [EwaGlos]"@en,
    "Shedding, coming off, or partial detachment of asuperficial layer (thickness : submillimetric to millimetric)having the aspect of a film or coating whichhas been applied on the stone surface. [ICOMOS-ISCS]"@en,
    "Partielle Ablösung einer Oberfläche, was häufig so aussieht, als wenn sich eine Beschichtung von der Oberfläche abschälen würde. [EwaGlos] "@de,
    "Absondern, Abfallen oder teilweise Ablösung einer oberflächlichen Schicht (Schichtdicke weniger als ein Millimeter oder im Millimeterbereich), welche das Aussehen eines Films oder Überzugs hat, der auf die Oberfläche aufgebracht wurde. [ICOMOS-ISCS] "@de,
    "Odlupování, nebo částečné odtrhávání povrchovévrstvy kamene (mocnost: submilimetry až milimetry),mající vzhled povlaku nebo nátěru aplikovanéhona jeho povrch. [ICOMOS-ISCS] "@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ef0a8695,
    :conceptScheme_ec8c77bf, :conceptScheme_34ca6582;
  skos:prefLabel "pelage"@fr, "peeling"@en, "Schollenbildung"@de, "odlupování"@cs;
  skos:altLabel "ecaillage"@fr, "peeling off"@en, "Abschälen"@de, "sloupávání"@cs;
  skos:broader :c_ed43f447, :c_61354695;
  dct:created "2019-05-13T14:38:06.000"^^xsd:dateTime;
  dct:modified "2021-01-30T16:35:33.000"^^xsd:dateTime .

:c_3201517b a skos:Concept;
  skos:definition "Détachement d’écailles de pierre individuelles ou enpaquets indépendamment de toute structure orientéepréexistante. La desquamation se développeparallèlement à la surface ou en écailles de poisson.L’épaisseur des écailles est négligeable par rapportà leur extension. [ICOMOS-ISCS]"@fr,
    "Detachment of stone as a scale or a stack of scales,not following any stone structure and detaching likefish scales or parallel to the stone surface. The thicknessof a scale is generally of millimetric to centimetricscale, and is negligeable compared to its surfacedimension. [ICOMOS-ISCS]"@en,
    "Ablösung von Steinsubstanz in Form einer Schale oder eines Stapels von Schalen, welche nicht der Gesteinstextur folgen und sich wie Fischschuppen oder parallel zur Steinoberfläche ablösen. Die Dicke der Schalen beträgt allgemein zwischen einigen Millimetern und Zentimetern; sie ist wesentlich kleiner als die Fläche der Schale. [ICOMOS-ISCS] "@de,
    "odprýskávání a odtrhávání kousků kamene, nesledující žádné struktury v kameni. oddělování kousků kamene probíhá podobně jako oddělování rybích šupin nebo paralelně s povrchem kamene. tloušťka šupin obecně dosahuje milimetrů nebo centimetrů a je zanedbatelná vzhledem k plošnému rozměru. [ICOMOS-ISCS] "@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ef0a8695,
    :conceptScheme_34ca6582;
  skos:prefLabel "desquamation"@fr, "scaling"@en, "Schuppenbildung"@de, "odprýskávání"@cs;
  skos:broader :c_61354695;
  dct:created "2019-05-13T14:47:14.000"^^xsd:dateTime;
  dct:modified "2021-01-30T16:36:39.000"^^xsd:dateTime .

:c_be6dd5fa a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ef0a8695,
    :conceptScheme_ec8c77bf, :conceptScheme_34ca6582;
  skos:prefLabel "desquamation"@fr, "scaling"@en, "Abschuppen"@de, "odlupování tenkých vrstev"@cs;
  skos:altLabel "ecaillage"@fr, "desquamation"@en, "Abblättern (Naturstein)"@de, "šupinatost"@cs;
  skos:note "Détachement d’écailles de pierre individuelles ou en paquets indépendamment de toute structure orientée préexistante. La desquamation se développe parallèlement à la surface ou en écailles de poisson. L’épaisseur des écailles est négligeable par rapport à leur extension.[ICOMOS-ISCS]"@fr,
    "The detachment of small, flat, thin pieces of outer stone layers or other surfaces (e.g. mural paintings). Flakes are smaller than scales. [EwaGlos]"@en,
    "Detachment of stone as a scale or a stack of scales, not following any stone structure and detaching like fish scales or parallel to the stone surface. The thickness of a scale is generally of millimetric to centimetric scale, and is negligeable compared to its surface dimension. [ICOMOS-ISCS] "@en,
    "Das Ablösen kleiner, flacher, dünner Teilchen von der äußeren Steinschicht oder von anderen Oberflächen, wie z. B. Wandmalereien. Schuppen sind kleiner als Schalen. [EwaGlos]"@de,
    "Odlupování tenkých vrstev (šupinatost) v tenkýchzkroucených vrstvičkách o síle submilimetrů až milimetrů,uspořádaných jako rybí šupiny. [ICOMOS-ISCS] "@cs;
  skos:broader :c_9b20ce52;
  skos:narrower :c_2411ebe4, :c_bc1004ab, :c_7fe1d054;
  dct:created "2019-07-06T20:15:43.000"^^xsd:dateTime;
  dct:modified "2021-01-30T16:30:55.000"^^xsd:dateTime .

:c_5a5fb4af a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ec8c77bf;
