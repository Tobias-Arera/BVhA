  dct:modified "2021-01-30T22:43:53.000"^^xsd:dateTime .

:c_03ef367c a skos:Concept;
  skos:definition "m (lat. advocatus, ahd. fogat), ursprünglich ein Laie, der einen Geistlichen, eine Kirche, ein Kloster usw. in weltlichen Angelegenheiten nach außen vertrat, vor allem vor Gericht, aber auch das Kirchengut verwaltete. Seitdem die Kirchen Immunitäten und dadurch Gerichtsherrn geworden waren, übte der V. diese Gerichtsbarkeit aus und vertrat die von den kirchlichen Institutionen abhängigen Personen (z. B. Untertanen eines Klosters) vor Gericht. Zuweilen ließ der V. seine Vogtei von Stellvertretern (Untervögten) verwalten. Seit der Mitte des 9. Jhs. gelangte das Amt des V.es als erbliches Lehen in die Hand von Adeligen. Vereinzelt diente Adelsfamilien die Amtsbezeichnung V. als Bestandteil ihres Namens, so z. B. den im südlichen Oberschwaben begüterten V.en von Summerau BW oder den V.en von Hunolstein im Hunsrück RP. Im Hoch- und Spätmittelalter bedienten sich zahlreiche Territorialherrn der von ihnen wahrgenommenen Vogteirechte zum Aufbau ihrer Landesherrschaft und entfremdeten die Rechte und Ländereien der Kirche. J. F. [Wörterbuch der Burgen, Schlösser und Festungen]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8;
  skos:prefLabel "Vogt"@de;
  skos:broader :c_1f0a3ce6;
  dct:created "2020-04-28T11:31:29.000"^^xsd:dateTime;
  dct:modified "2021-01-21T11:15:34.000"^^xsd:dateTime .

:c_e1e98d82 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8;
