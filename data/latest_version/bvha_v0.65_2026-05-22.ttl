:c_e578e87b a skos:Concept;
  skos:definition "Choraltar, der im Chorraum einer Bischofs-, Kloster- oder Pfarrkirche stehende Hauptaltar im Unterschied zu den in den Seitenkapellen, am Lettner, im Kirchenschiff usw. aufgestellten Nebenaltären. Er ist durch Größe und Ausschmückung hervorgehoben. [Koepf / Binding 2016]"@de;
  skos:scopeNote "Der in der Liturgie am Häufigsten genutzte Altar. "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe;
  skos:prefLabel "Hauptaltar"@de;
  skos:altLabel "Choraltar"@de;
  skos:broader :c_wyccl4ls;
  skos:related :c_edb5b0ad, :c_5528bc85;
  dct:created "2020-01-10T18:28:22.000"^^xsd:dateTime;
  dct:modified "2021-01-30T23:53:57.000"^^xsd:dateTime .

:c_5528bc85 a skos:Concept;
  skos:scopeNote "Aus dem Chorraum zur Gemeinde hin herausgerückter freistehender Altar, der die Zelebration der Heiligen Messe verso populum ermöglicht. Neuerung der Liturgiereformen des 2. Vatikanischen Konzils. "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe;
  skos:prefLabel "Volksaltar"@de;
  skos:broader :c_wyccl4ls;
  skos:related :c_e578e87b;
  dct:created "2020-01-10T18:28:30.000"^^xsd:dateTime;
  dct:modified "2021-01-30T23:56:05.000"^^xsd:dateTime;
  :broaderByFunction :c_wyccl4ls .

:c_0660b156 a skos:Concept;
  skos:definition "Öllampe f; lat. butto; lucerna; lampa; luminare: eine Ton- oder Metallschale, in der zur Lichterzeugung Öl verbrannt wird . Vor dem Sakramentsaltar einer Kathedrale brannten üblicherweise fünf oder mehr Öllampen, vor einem Hochaltar drei und vor den Nebenaltären jeweils eine. Auch die Märtyrergräber in den Katakomben wurden durch Öllampen erhellt. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "Öllampe"@de, "oil-lamp"@en, "lampe à huile"@fr, "butto"@la;
  skos:altLabel "lucerna"@la, "lampa"@la, "luminare"@la;
  skos:broader :c_268de52b;
  skos:narrower :c_7df544d2, :c_bb1193ab;
  skos:related :c_edb5b0ad, :c_9cb3d277;
  dct:created "2020-08-07T08:21:20.000"^^xsd:dateTime;
  dct:modified "2021-01-30T22:40:20.000"^^xsd:dateTime .

