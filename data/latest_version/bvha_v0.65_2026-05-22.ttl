:c_977efc1d a skos:Concept;
  skos:definition "Eine otton. Sonderform des frühma. Kapitells, einer umgedrehten Basis ähnelnder Rotationskörper, der als Bossenform (Bosse) des korinth. Kapitells gedeutet werden kann, 950 bis 2. Hälfte des 11. Jhs. in Sachsen und im Niederrhein-Maasgebiet auftretend.[Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe;
  skos:prefLabel " capitello a fungo"@it, "Pilzkapitell"@de, " capitel con forma de hongo"@es,
    "hřibová hlavice"@cs;
