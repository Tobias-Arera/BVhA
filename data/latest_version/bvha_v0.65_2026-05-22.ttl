:c_8fc667ec a skos:Concept;
  skos:definition "Ein Gebäudekomplex ist eine in ihrem Umfang begrenzte Gruppe von eng miteinander in Beziehung stehenden → Bauwerken (i. d. Regel Gebäude) und architektonischen Räumen, die durch bauliche Mittel zusammengefasst werden, funktional aufeinander bezogen sind und eine deutlich wahrnehmbare Gesamteinheit bilden. [BVHA, Tobias Arera-Rütenik]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_50ec0c5e, :conceptScheme_c8a571d9, :conceptScheme_4fbab46c;
