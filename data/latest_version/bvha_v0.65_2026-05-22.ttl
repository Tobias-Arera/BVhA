  dct:created "2020-08-21T15:13:52.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:02:51.000"^^xsd:dateTime .

:c_57cb750d a skos:Concept;
  skos:definition "Konstruktion aus Holz oder Stahl, deren Tragelemente sich entsprechend dem Kräfteverlauf räuml. in der Längs-, Quer- und Diagonalrichtung erstrecken. [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "structure spatiale"@fr, "prostorová konstrukce"@cs, "space frame"@en,
    " struttura portante reticolare spaziale"@it, " estructura espacial"@es, "Räumliches Tragwerk"@de;
  skos:altLabel " spatial structure"@en, " structure tridimensionnelle"@fr, "estructura tridimensional"@es;
  skos:broader :c_3k6eiowx;
  skos:narrower :c_4e6b3a07, :c_40f7ac79;
  dct:created "2020-08-21T14:18:23.000"^^xsd:dateTime;
  dct:modified "2020-11-30T20:03:31.000"^^xsd:dateTime .

:c_4e6b3a07 a skos:Concept;
  skos:definition "Räuml. Tragwerk aus Stahlbeton, Spannbeton oder Stahlblech, das aus starren, ebenen Einzelplatten zusammengesetzt ist, bes. für weit gespannte Hallendächer verwendet. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Faltwerk (Tragwerk)"@de;
  skos:broader :c_57cb750d;
  dct:created "2020-09-08T15:11:35.000"^^xsd:dateTime;
  dct:modified "2020-09-08T15:12:17.000"^^xsd:dateTime .

:c_40f7ac79 a skos:Concept;
  skos:definition "Ein bogenförmig gekrümmtes Tragwerk mit je einem Gelenk an den beiden Kämpferpunkten. Der G. ist das einfachste, statisch unbestimmt gelagerte Fachwerksystem. Ein Tragwerk mit je einem Gelenk an den beiden Kämpferpunkten und einem dritten am Scheitel heißt Dreig. er ist statisch bestimmt und wird bei Brücken und großen Hallen verwendet. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Gelenkbogen"@de;
  skos:broader :c_57cb750d;
  dct:created "2020-09-29T12:19:57.000"^^xsd:dateTime;
  dct:modified "2020-09-29T12:20:52.000"^^xsd:dateTime .

:c_ae71d54e a skos:Concept;
  skos:definition "Einmaliges Bewerfen der Wandfläche mit Mörtel mittels einer Kelle (Kellenputz), mit welcher der R. auch notdürftig geglättet wird. R. wird in Kellern und Dachräumen, aber auch zweilagig am Außenbau verwandt. [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "enlucido áspero"@es, "intonaco rustico"@it, "Rappputz"@de, "sádrová omítka stažená Ižící"@cs,
    " enduit fouetté"@fr;
  skos:altLabel "hlazená omítka (lžící)"@cs, "arriccio"@it, "Kellenputz"@de;
  skos:broader :c_wdriolje;
  dct:created "2020-08-21T15:10:12.000"^^xsd:dateTime;
  dct:modified "2021-01-25T15:53:46.000"^^xsd:dateTime .

:c_cca0de59 a skos:Concept;
  skos:definition "In Windung ansteigende Rampe, auch in Türmen. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "sog. Eselstreppe"@de;
  skos:broader :c_62f9df73;
  dct:created "2020-09-07T14:52:21.000"^^xsd:dateTime;
  dct:modified "2020-09-07T14:52:55.000"^^xsd:dateTime .

:c_723a0fe7 a skos:Concept;
  skos:definition "1. Rahmenförmig geknicktes Tragwerk aus Holz, Stahl oder Stahlbeton, dessen Knickpunkte biegesteif ausgebildet sind. R. mit eingespannten Auflagern können durch den Einbau von Gelenken stat. bestimmbar werden; 2. R. und Füllung. [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Rahmen (Tragwerk)"@de, " telaio"@it, "rám"@cs, " cadre"@fr, "frame"@en;
  skos:altLabel "marco"@es, "sádka"@cs;
  skos:broader :c_3k6eiowx;
  skos:narrower :c_36c694fc;
  dct:created "2020-08-21T15:25:49.000"^^xsd:dateTime;
  dct:modified "2020-11-26T11:26:26.000"^^xsd:dateTime .

:c_36c694fc a skos:Concept;
  skos:definition "Ein Rahmen mit eingespannten Auflagern, der durch den Einbau eines beliebig angeordneten Gelenks für jedes eingespannte Auflager wieder stat. bestimmbar wird. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Gelenkrahmen"@de;
  skos:broader :c_723a0fe7;
  dct:created "2020-09-29T12:21:12.000"^^xsd:dateTime;
  dct:modified "2020-09-29T12:21:56.000"^^xsd:dateTime .

:c_b369f019 a skos:Concept;
  skos:definition "Eine Stadt, der ein System radial von einem Zentrum ausstrahlender Straßen zugrundeliegt (Idealstadt). Seit dem Ende des 19. Jhs. ist die durch Ring- und Gürtelstraßen ergänzte R. Modell einer funktionellen Gliederung des Stadtkörpers. [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_176fcff1;
  skos:prefLabel " ville radiale"@fr, "radiální město"@cs, "radial city"@en, " cittá radiale"@it,
