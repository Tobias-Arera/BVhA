    "crux decussata"@la, "St. Andrew\\'s cross"@en;
  skos:altLabel "croix en sautoir"@fr, "croix de Bourgogne"@fr, "saltire"@en, "Schrägkreuz"@de,
    "liegendes Kreuz"@de, "Schragenkreuz"@de, "Schragen"@de, "Burgundisches Kreuz"@de,
    "Schottisches Kreuz"@de, "saltarium"@la;
  skos:broader :c_0b7daa52, :c_46483b7b;
  skos:related :c_qilbfxdv;
  dct:created "2019-09-11T12:28:03.000"^^xsd:dateTime;
  dct:modified "2021-01-22T12:12:30.000"^^xsd:dateTime .

