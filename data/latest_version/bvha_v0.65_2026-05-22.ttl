:c_6686662d a skos:Concept;
  skos:definition "Die Mörtelschicht, in welche die Bausteine verlegt werden."@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
