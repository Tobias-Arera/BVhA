  dct:modified "2021-01-27T14:19:43.000"^^xsd:dateTime .

:c_5be8f6ec a skos:Concept;
  skos:definition "Mehrgeschossiger Steinbau in Kegelform aus vorgeschichtlicher Zeit (unechtes Gewölbe), hauptsächl. in Sardinien vorkommend. Eine Sonderform sind die Talayoten auf den Balearen. Ähnl. bis heute in Süditalien errichtete Wohnbauten heißen Trulli. [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_c8a571d9;
