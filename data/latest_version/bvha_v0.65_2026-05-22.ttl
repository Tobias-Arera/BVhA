  dct:created "2020-08-22T16:44:32.000"^^xsd:dateTime;
  dct:modified "2020-09-01T13:55:38.000"^^xsd:dateTime .

:c_7abd2a1d a skos:Concept;
  skos:definition "Ablaufrohr, das an der Hauswand befestigte, senkrechte Rohr zum Ableiten des Wassers von Dachrinnen. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
