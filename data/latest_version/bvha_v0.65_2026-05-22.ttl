:c_8095db87 a skos:Concept;
  skos:definition "Lesepult in Form eines Adlers (vielleicht nach dem Symbol des Evangelisten Johannes), dessen ausgebreitete Schwingen das Buch tragen. Im Chor, auf dem Lettner oder Ambo zu finden. [Koch 2009]"@de,
    "Pulpit ve tvaru orla (patrně podle symbolu evangelisty Jana), jehož rozevřené perutě nesou knihu. Umístěn v chóru, na lettneru, na amboně. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "Adlerpult"@de, "orlí pult"@cs;
  skos:broader :c_b908427f;
