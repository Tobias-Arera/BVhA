  dct:created "2020-08-21T15:32:57.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:12:19.000"^^xsd:dateTime .

:c_df848254 a skos:Concept;
  skos:definition "Stirnfläche eines Querhausarms. Bei dreischiffigen Querhausanlagen werden v. a. in der frz.Gotik reiche Fassaden ausgebildet, die ähnl. der Westfassade gegliedert sind. [Koepf/Binding 2016]"@de;
