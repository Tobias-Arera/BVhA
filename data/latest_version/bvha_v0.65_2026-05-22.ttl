  dct:modified "2021-01-30T16:40:03.000"^^xsd:dateTime .

:c_15a49383 a skos:Concept;
  skos:definition "Astkreuz nennt man eine von dem traditionellen Typus, dem glatt behauenen lateinischen Kreuz, abweichende Form des Kreuzes Christi, bei dem Stamm und Arme als Äste gebildet bzw. mit Aststümpfen besetzt sind. [RDK Labor]"@de,
    "Astkreuz n: ein Kreuz, dessen Balken wie stilisierte Baumstämme erscheinen. Eine Variante  ist das mit Blättern, Blüten und Früchten besetzte Baumkreuz (n), Symbol des Lebensbaumes. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_1f14b4dd, :conceptScheme_cf792a3c;
  skos:prefLabel "croix écotée"@fr, "raguly cross"@en, "Astkreuz"@de, "větvový kříž"@cs;
  skos:broader :c_46483b7b;
  skos:narrower :c_d4296225;
  dct:created "2020-02-05T17:34:12.000"^^xsd:dateTime;
  dct:modified "2021-01-13T14:39:18.000"^^xsd:dateTime;
  :broaderByShape :c_46483b7b .

:c_d4296225 a skos:Concept;
  skos:scopeNote "Lebensbaum mit Blättern, Blüten oder Früchten. [Koch 2009]"@de, "Baumkreuz, eine mit Früchten, Blättern und Blüten besetzte Variante des Astkreuzes. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_8c0441f9, :conceptScheme_1f14b4dd;
  skos:prefLabel "Baumkreuz"@de, "stromový kříž"@cs;
  skos:broader :c_15a49383;
  dct:created "2020-08-06T11:12:59.000"^^xsd:dateTime;
  dct:modified "2021-01-13T14:46:48.000"^^xsd:dateTime .

:c_65ea7409 a skos:Concept;
  skos:definition "Gabelkreuz n; auch Deichselkreuz n; Schächerkreuz n; lat. furca; crux deassala: ein Kreuz mit schräg aufwärtsgerichteten Querbalken; auf frühchristlichen und byzantinischen Darstellungen das Kreuz, an das die Schacher geschlagen wurden. Formvarianten sind das volle Gabelkreuz (n) oder Zweigkreuz (n), bei dem alle Balkenenden gespreizt sind und das Dreizinken-Gabelkreuz (n). [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_1f14b4dd;
  skos:prefLabel "Gabelkreuz"@de, "vidlicový, rozsochový kříž"@cs, "croix fourchée"@fr,
    "furca"@la, "forked cross"@en;
  skos:altLabel "pair-cross"@en, "Schächerkreuz"@de, "Deichselkreuz"@de, "crux deassala"@la;
  skos:broader :c_46483b7b;
  skos:narrower :c_e1c3d376, :c_f8e3d9a1;
  dct:created "2020-02-05T17:45:00.000"^^xsd:dateTime;
  dct:modified "2021-01-13T15:10:03.000"^^xsd:dateTime;
  :broaderByShape :c_46483b7b .

:c_e1c3d376 a skos:Concept;
  skos:scopeNote "Zweigkreuz, Variante des Gabelkreuzes, bei dem alle Balkenenden gespreizt sind. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_1f14b4dd;
  skos:prefLabel "Zweigkreuz"@de;
  skos:broader :c_65ea7409;
  dct:created "2020-08-10T22:49:53.000"^^xsd:dateTime;
