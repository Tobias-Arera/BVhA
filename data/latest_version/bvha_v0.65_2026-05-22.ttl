:c_b62415e5 a skos:Concept;
  skos:definition "Eine Decke mit durch vortretende Balken oder durch Stuckprofile gebildeter Felderteilung an der Untersicht. Sonderformen sind die Kassettendecke (Kassette) und die Spiegeldecke. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
