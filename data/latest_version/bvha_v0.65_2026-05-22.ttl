  dct:modified "2021-01-22T10:40:45.000"^^xsd:dateTime .

:c_baaa6fbd a skos:Concept;
  skos:definition "Buchreliquiar n; lat. capsa in modum libri: ein mit Edelsteinen und kostbaren Beschlägen verzierter Buchdeckel, der Reliquien birgt; z. B. der Prachteinband eines Codex (seit 11. Jh.). Man spricht präzis. von Plenarreliquiar (n) oder Reliquienplenar (n). [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "livre-reliquaire"@fr, "book-reliquary"@en, "Buchreliquiar"@de, "capsa in modum libri"@la;
  skos:altLabel "reliure-reliquaire"@fr, "Plenrarreliquiar"@de, "Reliquienplenar"@de;
  skos:broader :c_b9eb688f;
  dct:created "2020-09-01T20:10:52.000"^^xsd:dateTime;
  dct:modified "2021-01-22T19:48:10.000"^^xsd:dateTime .

:c_a41055e4 a skos:Concept;
  skos:definition "Kapselreliquiar n; auch Reliquienkapsel f; Phylakterium n; gr. phylaterion; lat. bulla; phyIacterium; theca; capsella: eine kleine, oft runde oder ovale Kapsel aus Edelmetall oder Kristallal Reliquienbehältnis, das wie ein Amulett um den Hals getragen wird und den Träger vor Gefahr schützen soll. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "phylacterium"@la, "Kapselreliquiar"@de, "phylakterion"@el, "capsule-reliquaire"@fr,
    "reliquary-pendant"@en;
  skos:altLabel "bulla"@la, "theca"@la, "bijou-reliquaire"@fr, "Reliquienkapsel"@de,
    "Phylakterium"@de, "capsella"@la;
  skos:broader :c_b9eb688f;
  skos:narrower :c_f5eca485;
  dct:created "2020-09-03T20:07:28.000"^^xsd:dateTime;
  dct:modified "2020-09-03T20:14:25.000"^^xsd:dateTime .

:c_3a4cd422 a skos:Concept;
  skos:definition "Reliquienhorn n; Hornreliquiar n; auch Olifant m; lat. cornu eburneum: ein aus Elfenbein gefertigtes Horn, ehemals ein Jagd- oder Signalhorn, das mit Beschlägen reich verziert ist und Reliquien birgt. Es steht oft auf einem Ständer oder hängt an Ketten. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "corne-reliquaire"@fr, "horn-reliquary"@en, "Reliquienhorn"@de, "cornu eburneum"@la;
  skos:altLabel "Hornreliquiar"@de, "Olifant"@de;
  skos:broader :c_b9eb688f;
  dct:created "2020-09-03T20:55:31.000"^^xsd:dateTime;
  dct:modified "2020-09-03T20:57:48.000"^^xsd:dateTime .

:c_a6d72230 a skos:Concept;
  skos:definition "Reliquienkästchen n; Kästchenreliquiar n; gr. pyxis; theke; lat. ladula; bursa; cista; cistula: ein kastenförmiger Reliquienbehälter, meist aus Eichenholz gefertigt und mit Elfenbeinplatten belegt. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "Reliquienkästchen"@de, "pyxis"@el, "cassette-reliquaire"@fr, "ladula"@la,
    "box-reliquary"@en;
  skos:altLabel "theke"@el, "Kästchenreliquiar"@de, "bursa"@la, "cista"@la, "cistula"@la;
  skos:broader :c_b9eb688f;
  dct:created "2020-09-03T20:58:08.000"^^xsd:dateTime;
  dct:modified "2020-09-03T21:01:47.000"^^xsd:dateTime .

:c_57765de4 a skos:Concept;
  skos:definition "Reliquiensarg m; Sargreliquiar n; lat. tumba, feretrum: ein rechteckiger Kasten aus Stein mit einem meist satteldachförmigem Deckel; die älteste Form des Reliquiars. Reliquiensärge wurden in einem Gewölbe unter dem Altar oder unmittelbar hinter dem Altar aufgestellt. Sie sind die frühen Vorläufer der barocken Glasschreine (m pI ), in denen ein Heiliger Leib ruht. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "cercueil-reliquaire"@fr, "coffin-reliquary"@en, "Reliquiensarg"@de;
  skos:altLabel "Sargreliquiar"@de;
  skos:broader :c_b9eb688f;
  skos:narrower :c_38c0059e, :c_0771773d;
  skos:related :c_b2d1eb06;
  dct:created "2020-09-23T19:55:23.000"^^xsd:dateTime;
  dct:modified "2020-09-23T20:10:52.000"^^xsd:dateTime .

:c_b2d1eb06 a skos:Concept;
  skos:definition "Heiliger Leib m: Bezeichnung für die in Glasschreinen ruhenden Leichname kanonisierter Heiliger und Seliger, die in der Regel sehr kostbar gewandet und kunstvoll gefasst sind. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "corps d\\'un saint"@fr, "body of a saint"@en, "Heiliger Leib"@de;
  skos:broader :c_49320237;
  skos:related :c_57765de4;
  dct:created "2020-09-25T19:02:18.000"^^xsd:dateTime;
  dct:modified "2021-01-27T11:47:09.000"^^xsd:dateTime .

:c_eb2e4d21 a skos:Concept;
  skos:definition "Reliquienschrein m; auch Schrein(chen)reliquiar n; Heiligenschrein m; lat. scrin(i)um; area (cum reliquiis); capsa; feretrum: bis etwa zum 12. Jh. ein kleinerer, tragbarer Reliquienbehälter mit einem sattel- oder walmdachförmigen Deckel, später meist ein ortsfester Schrein aus Holz oder Metall, der mit Edelsteinen verziert und oft auch architektonisch gestaltet ist. Die bevorzugte Form des Reliquiars. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "châsse"@fr, "feretory"@en, "Reliquienschrein"@de;
  skos:altLabel "shrine"@en, "écrin reliquaire"@fr, "Schreinreliquiar"@de, "Heiligenschrein"@de;
  skos:broader :c_b9eb688f;
  skos:narrower :c_df782664;
  skos:related :c_57226acf;
  dct:created "2020-09-23T20:11:50.000"^^xsd:dateTime;
  dct:modified "2020-09-23T20:21:39.000"^^xsd:dateTime .

:c_059578ce a skos:Concept;
  skos:definition "Schiffsreliquiar n; lat. liburum: ein Reliquienbehälter in Form eines kleinen Schiffsmodells, meist eines Segelschiffes. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "bâteau-reliquaire"@fr, "ship-reliquary"@en, "Schiffsreliquiar "@de,
    "liburum"@la;
  skos:broader :c_b9eb688f;
  dct:created "2020-09-24T17:19:59.000"^^xsd:dateTime;
  dct:modified "2020-09-24T17:21:38.000"^^xsd:dateTime .

:c_a75a17fe a skos:Concept;
  skos:definition "Stabreliquiar n; Hirtenstabreliquiar n: ein Reliquienbehälter in Form eines Hirtenstabes. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "Stabreliquiar"@de;
  skos:altLabel "Hirtenstabreliquiar"@de;
  skos:broader :c_b9eb688f;
  skos:narrower :c_6d1d40d8;
  dct:created "2020-09-24T17:22:00.000"^^xsd:dateTime;
  dct:modified "2020-09-24T17:23:14.000"^^xsd:dateTime .

:c_0c2a3183 a skos:Concept;
  skos:definition "Statuettenreliquiar n; auch Reliquienstatuette f: eine kleine plastische Figur als Reliquienbehälter. Sind mehrere Figuren dargestellt (z. B. Anna Selbdritt), spricht man präzis. von Gruppenreliquiar (n). [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "statuette-reliquaire"@fr, "statuette-reliquary"@en, "Statuettenreliquiar"@de;
  skos:altLabel "Reliquienstatuette"@de;
  skos:broader :c_b9eb688f;
  skos:narrower :c_ed75003e;
  dct:created "2020-09-24T17:52:17.000"^^xsd:dateTime;
  dct:modified "2020-09-24T18:12:39.000"^^xsd:dateTime .

:c_fa3670df a skos:Concept;
  skos:definition "Heilig-Grab-Reliquiar n: ein Reliquienbehälter mit der Darstellung des Heiligen Grabes bzw. des Tuguriums zu Jerusalem und den vor ihm zum Gebet versammelten Gläubigen. Beispiel: das Reliquiar im Schatz der Kathedrale zu Pamplona (um 1290). [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "reliquaire du Saint-Sépulcre"@fr, "reliquary of the Holy Tomb"@en,
    "Heilig-Grab-Reliquiar"@de;
  skos:broader :c_b9eb688f;
  dct:created "2020-09-24T18:17:04.000"^^xsd:dateTime;
  dct:modified "2020-09-24T19:07:11.000"^^xsd:dateTime .

:c_7b81c7bc a skos:Concept;
  skos:definition "Thronreliquiar n: ein Reliquienbehälter in Form einer bischöflichen Kathedra. Beispiel: die Sedia di San Marco (byzantinisch; 6. Jh.). [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "trône-reliquaire"@fr, "throne-reliquary"@en, "Thronreliquiar"@de;
  skos:broader :c_b9eb688f;
  dct:created "2020-09-24T19:34:49.000"^^xsd:dateTime;
  dct:modified "2020-09-24T19:35:43.000"^^xsd:dateTime .

:c_557acf28 a skos:Concept;
  skos:definition "Tierreliquiar n: ein Reliquienbehälter in Gestalt eines realen oder legendären Tieres mit symbolischer Bedeutung, z. B. Lamm, Taube, Drache, Greif, Fisch, Hahn, Kranich, Pelikan, Phönix, Hirsch und Löwe. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "reliquaire en forme d\\'animal"@fr, "animal-form reliquary"@en, "Tierreliquiar"@de;
  skos:broader :c_b9eb688f;
  dct:created "2020-09-24T19:36:00.000"^^xsd:dateTime;
  dct:modified "2020-09-24T19:37:13.000"^^xsd:dateTime .

:c_4a5777a3 a skos:Concept;
  skos:definition "Truhenreliquiar n; Reliquientruhe f; lat. capsa; scrin(i)um: ein Reliquienbehälter in Form einer kleinen, mit Elfenbein- oder Silberplatten bekleideten hölzernen Truhe mit einem gewölbten oder pyramidenstumpfförmigen Deckel. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "coffre-reliquaire"@fr, "chest-reliquary"@en, "Truhenreliquiar"@de;
  skos:altLabel "Reliquientruhe"@de, "coffret-reliquaire"@fr, "bahut-reliquaire"@fr;
  skos:broader :c_b9eb688f;
  dct:created "2020-09-24T19:37:34.000"^^xsd:dateTime;
  dct:modified "2020-09-24T19:39:41.000"^^xsd:dateTime .

:c_56496c38 a skos:Concept;
  skos:definition "Urnenreliquiar n; lat. urna reliquiarum: ein als Graburne gestalteter Reliquienbehälter. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "reliquaire en forme d\\'urne funéraire"@fr, "urn-reliquary"@en, "Urnenreliquiar"@de,
    "urna reliquiarum"@la;
  skos:broader :c_b9eb688f;
  dct:created "2020-09-24T19:40:00.000"^^xsd:dateTime;
  dct:modified "2020-09-24T19:41:46.000"^^xsd:dateTime .

:c_6910f3c3 a skos:Concept;
  skos:definition "Vasenreliquiar n; Reliquienvase f: ein meist aus Glas oder Silber gefertigter vasenförmiger Reliquienbehälter, vor allem in der Renaissance gebräuchlich. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "vase-reliquaire"@fr, "vasiform reliquary"@en, "Vasenreliquiar"@de;
  skos:altLabel "Reliquienvase"@de;
  skos:broader :c_b9eb688f;
  dct:created "2020-09-24T19:42:03.000"^^xsd:dateTime;
  dct:modified "2020-09-24T19:43:24.000"^^xsd:dateTime .

:c_ebd46d1c a skos:Concept;
  skos:scopeNote "Heiltumsstuhl, ein überdachtes und mit Behängen geschmücktes Holzgerüst, das im Mittelalter vor den Kirchen errichtet wurde und in dessen Galerien Heiltümer ausgestellt wurden. [Glossarium Artis]"@de;
