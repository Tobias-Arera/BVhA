:c_6cb99610 a skos:Concept;
  skos:definition "Gewölbe, bei dem zwischen Kämpfergesims und Beginn der Gewölbekrümmung mit dem ersten Keilstein ein kurzes, vertikales Mauerstück eingefügt ist. Die Gewölbelinie beginnt also erst einige Steine oberhalb des Auflagers. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "voûte surélevée"@fr, "stilted vault"@en, "gestelztes Gewölbe"@de;
  skos:altLabel "gebürstetes Gewölbe"@de, "gefußtes Gewölbe"@de, "überhobenes Gewölbe"@de;
  skos:broader :c_049c4c22;
  dct:created "2019-10-22T16:47:59.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:16:38.000"^^xsd:dateTime;
  :broaderByShape :c_049c4c22;
  :broaderByConstruction :c_049c4c22 .

:c_a7dd4d29 a skos:Concept;
  skos:definition "Gewölbe, dessen Form aus einer reinen Kugelfläche (Kugelsegment) abgeleitet werden kann, wie z. B. die Kuppeln. Die Wölbflächen sind Kugelflächen (auch Flächen eines Rotationsellipsoids), die man sich durch Drehen einer ebenen, regelmäßig gekrümmten Linie um eine feste Achse entstanden denken kann. Im Unterschied zu den zylindrischen Gewölben lassen sich sphärische Gewölbe nicht einschalen, sondern werden freihändig über Lehrbogen gemauert. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "voûte sphèrique"@fr, "spherical vault"@en, "sphärische Gewölbe"@de;
  skos:altLabel "dome"@en;
  skos:broader :c_049c4c22;
  dct:created "2019-10-23T09:28:33.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:53:29.000"^^xsd:dateTime;
  :broaderByShape :c_049c4c22 .

:c_21c44c0f a skos:Concept;
  skos:definition "Gewölbe, meist eine Tonne, mit senkrecht verlaufender Achse. Es dient z. B. zur Abstützung bei Terrassierungen. Zu unterscheiden vom steigenden Gewölbe.  [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "vertical vault"@en, "voûte verticale"@fr, "vertikales Gewölbe"@de;
  skos:altLabel "vault with a vertical axis"@en, "voûte à axe vertical"@fr, "voûte en berceau vertical"@fr;
  skos:broader :c_049c4c22;
  dct:created "2019-10-23T09:33:15.000"^^xsd:dateTime;
  dct:modified "2021-01-19T13:11:15.000"^^xsd:dateTime;
  :broaderByShape :c_049c4c22 .

:c_07dbc83b a skos:Concept;
  skos:definition "Gewölbe, das bei der Durchdringung oder Aneinanderreihung mehrerer gleichartiger oder unterschiedlicher Wölbungen entsteht. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "compound vault"@en, "voûte en cerce"@fr, "zusammengesetztes Gewölbe"@de;
  skos:altLabel "Kompositgewölbe"@de, "voûte composite"@fr;
  skos:broader :c_049c4c22;
  dct:created "2019-10-23T09:50:56.000"^^xsd:dateTime;
  dct:modified "2021-01-19T13:13:44.000"^^xsd:dateTime;
  :broaderByShape :c_049c4c22 .

:c_b07b4df3 a skos:Concept;
  skos:definition "Gewölbe über einer Grundfläche, die weder quadratisch noch rechteckig oder regelmäßig polygonal, sondern häufig trapezförmig ist. Es findet sich oft in Chorumgängen. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "voûte tournante"@fr, "broken rib vault"@en, "verzogenes Gewölbe"@de;
  skos:altLabel "voûte irrégulière"@fr;
  skos:broader :c_049c4c22;
  skos:narrower :c_1da3b071;
  dct:created "2019-10-23T10:00:39.000"^^xsd:dateTime;
  dct:modified "2021-01-19T13:11:34.000"^^xsd:dateTime;
  :broaderByShape :c_049c4c22 .

:c_1da3b071 a skos:Concept;
  skos:definition "Gewölbe über einer trapezförmigen Grundfläche. [BVHA]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "voûte trapézoïdale"@fr, "trapezoidal vault"@en, "trapezförmiges Gewölbe"@de;
  skos:broader :c_b07b4df3;
  dct:created "2019-10-23T10:08:07.000"^^xsd:dateTime;
  dct:modified "2021-01-19T13:11:54.000"^^xsd:dateTime .

:c_7912792c a skos:Concept;
  skos:definition "Hilfskonstruktion zur Aufmauerung von Bogen; ein vom Zimmermann gefertigtes Gestell aus übereinandergelegten, durch Spreizen abgestützten hölzernen Wölbscheiben in den Abmessungen der gewünschten Bogenlinie. An ihren Enden ist die Konstruktion durch Doppelkeile unterstützt, damit das Abrüsten durch langsames und vorsichtiges Entfernen der Keile erschütterungsfrei erfolgen kann. Die Römer errichteten Lehrbogen manchmal auf vorkragenden Kämpfergesimsen. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "centering"@en, "cintre"@fr, "Lehrbogen"@de;
  skos:altLabel "Bogenlehre"@de;
  skos:broader :c_1fd82f00;
  dct:created "2019-10-23T15:25:50.000"^^xsd:dateTime;
  dct:modified "2021-01-24T14:18:09.000"^^xsd:dateTime .

