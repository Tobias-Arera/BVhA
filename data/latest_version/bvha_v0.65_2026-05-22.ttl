:c_b8ea47ea a skos:Concept;
  skos:definition "Verbindung durch Übergriff verschiedener Elemente, Tafeln oder Bahnen des gleichen Materials. Aus Blech kann die hakenförmig ineinandergreifende Verbindung liegend oder stehend (Stehf.) angeordnet sein, bei Fenstern und Türen sind Rahmen und Flügel durch einen oder mehrere F.e, winkelförmige, rückspringende Ausarbeitung einer Kante, miteinander verbunden. [Koepf / Binding 2016]"@de,
    "Rechtwinkeliger Bruch einer Holzkante, meist zur Aufnahme eines entsprechend geformten Gegenstücks. Besondere Falzformen sind Quetschfalz, Klemmfalz, Kneiffalz oder Wolfsrachen, bei den kein rechter Winkel zugrunde liegt, sondern geschwungene Formen. [Pax - Fenster & Türen Fachbegriffe]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_19d56a39, :conceptScheme_c7b144d0, :conceptScheme_b41bd73a;
  skos:prefLabel "Falz"@de;
  skos:broader :c_78eff904, :c_7039254c, :c_b7ca4aa0;
  skos:narrower :c_74620c62, :c_46ccb7a3, :c_760c8dff, :c_e6692018, :c_7e1ba209, :c_638e4f46,
    :c_503471f6, :c_746de913;
  dct:created "2019-05-22T12:28:59.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:10:09.000"^^xsd:dateTime .

:c_b7ca4aa0 a skos:Concept;
