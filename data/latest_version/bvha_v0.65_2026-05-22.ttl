  skos:definition "Vorspringende Elemente zwischen den Kanneluren einer Säule. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
