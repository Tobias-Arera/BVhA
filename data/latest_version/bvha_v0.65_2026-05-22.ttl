:c_7ba78211 a skos:Concept;
  skos:definition "Ein Treffen der wichtigsten Bauhütten im deutschsprachigen Raum im Jahre 1459. [BVHA]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_f10222e0;
