  dct:modified "2019-10-21T14:05:59.000"^^xsd:dateTime .

:c_45ceb9d1 a skos:Concept;
  skos:definition "Aus konisch geformten Werksteinen gemauerter Bogen. Die Fugen zwischen den Steinen sind gleich breit und auf das Bogenzentrum hin ausgerichtet. [Glossarium Artis]"@de;
