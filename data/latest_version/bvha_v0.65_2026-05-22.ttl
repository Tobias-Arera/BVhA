:c_ca4e1c60 a skos:Concept;
  skos:definition "Schirmgewölbe, Gewölbe mit segelartig geblähten Kappen zwischen den Graten oder Rippen einer Kuppel. [Koepf / Binding 2016]"@de,
    "Schirmkuppel, Flachkuppel auf fächerförmigem Grundriss mit gebusten Kappen zwischen Graten oder Rippen, die den Eindruck geblähter Segel (Segelkuppel) vermitteln; zu unterscheiden vom Fächergewölbe. [Koepf /Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "voûte en forme de parasol"@fr, "umbrella vault"@en, "Segelgewölbe"@de,
    "bóveda con forma de quitasol"@es;
  skos:altLabel "volta a ombrello"@it, "sail vault"@en, "Schirmkuppel"@de, "umbrella dome"@en,
    "Schirmgewölbe"@de, "bóveda en paraguas"@es;
  skos:broader :c_049c4c22;
  dct:created "2020-08-19T13:23:54.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:53:00.000"^^xsd:dateTime .

:c_d050dc2c a skos:Concept;
  skos:definition "Eine Gewölbeform, hauptsächl. des Übergangsstils, bei der außer den vier Kreuzrippen noch zwei weitere Rippen quer zur Längsachse verlaufen, so dass sechs Kappen entstehen (Wandaufbau). [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "sechsteiliges Gewölbe"@de, "bóveda hexagonal"@es, "volta esapartita"@it,
