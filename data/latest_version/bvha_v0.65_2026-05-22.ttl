:c_c9dbc494 a skos:Concept;
  skos:definition "Kommunion f unter beiden Gestalten; lat. communio sub utraque: die Gabe von Brot und Wein bei der Eucharistie, bis zum 12.Jh. die übliche Form der Kommunion (Doppelkommunion f). In den prot. Kirchen und in den Ostkirchen wird das Abendmahl immer unter beiderlei Gestalt, Brotgestalt (f) und Weingestalt (f), gespendet. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "communion sous les deux espèces"@fr, "holy communion in both kinds "@en,
    "Kommunion unter beiden Gestalten"@de, "communio sub utraque"@la;
  skos:broader :c_b61960cd;
  skos:related :c_c1de9e31;
  dct:created "2020-07-22T17:52:33.000"^^xsd:dateTime;
  dct:modified "2021-01-15T16:46:55.000"^^xsd:dateTime .

