:c_1d636b0b a skos:Concept;
  skos:definition "Gewölbefeld, bei got. Kathedralen auch eine Einheit mit dem Strebewerk, abgeleitet von trabes = Jochbalken über zwei Zugtieren, dann Brückenjoch. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
