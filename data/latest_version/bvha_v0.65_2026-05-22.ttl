  dct:modified "2020-12-02T09:25:48.000"^^xsd:dateTime .

:c_e9fab383 a skos:Concept;
  skos:definition "Fensterbank, unterer Abschluss eines Fensters, meist aus Stein. Die S. muss nach vorne geneigt sein, über das Mauerwerk überstehen und eine Wassernase erhalten, am hinteren Ende läuft ein Falz, auf dem der Fensterrahmen aufsitzt. Innen wird die S. durch das Fensterbrett abgedeckt. [Koepf / Binding 2016]"@de,
    "Spodní vodorovná plocha ostění obou typů. [Koch 2008]"@cs, "Untere waagerechte Begrenzung der Fensteröffnung. [Noky 1996]"@de,
    "Fensterbank, 1. Sohlbank, untere Begrenzung des Fensters; 2. Sitzbank in einer Fensternische. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_37522b74;
  skos:prefLabel "banquette"@fr, "okenní parapet"@cs, "window sill"@en, "davanzale"@it,
    "solera de la ventana"@es, "Sohlbank"@de;
  skos:altLabel "Fensterbank"@de, "appui de fenêtre"@fr;
  skos:broader :c_b2356bd0, :c_e46f17d9;
  skos:narrower :c_cfc81af4;
  dct:created "2019-06-13T16:42:27.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:35:07.000"^^xsd:dateTime .

:c_3761c6c1 a skos:Concept;
  skos:definition "Fenstersturz, oberer waagerechter Abschluss eines Fensters als Balken, Stein oder scheitrechter Bogen. [Koepf / Binding 2016]"@de,
    "Též nadpraží, horní vodorovný ukončující prvek. [Koch 2008]"@cs, "Obere waagerechte Begrenzung einer Fensteröffnung. Sind die Höhen einer Werksteinrahmung profiliert, trägt auch der Sturz das gleiche Profil. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_37522b74, :conceptScheme_b41bd73a;
  skos:prefLabel "překlad"@cs, "lintel"@en, "Fenstersturz"@de;
  skos:altLabel "nadpraží"@cs;
  skos:broader :c_b2356bd0, :c_c55445fe;
  skos:narrower :c_e9f9bbef;
  dct:created "2019-06-13T16:43:20.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:35:49.000"^^xsd:dateTime .

:c_0a9d9ee3 a skos:Concept;
  skos:definition "Fenstergewände, schräg eingeschnittene, seitl. Begrenzung eines Fensters in Mauerdicke. [Koepf / Binding 2016]"@de,
    "Schräge Einschnittflächen der Fensteröffnungen in Mauern, heute in der Fachliteratur auch verwendet als Begriff für die äußere Rahmung in Werkstein, welche oft eine der Bauzeit entsprechende Profilierung aufweist. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_b41bd73a;
  skos:prefLabel "Fenstergewände"@de, "okenní šikmé ostění"@cs;
  skos:broader :c_b2356bd0, :c_a80d827a;
  dct:created "2019-06-13T16:46:50.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:34:31.000"^^xsd:dateTime;
  :broaderByPosition :c_a80d827a .

:c_cfc81af4 a skos:Concept;
  skos:definition "Innere Abdeckung der Brüstung eines Fensters. [Koepf / Binding 2016]"@de,
    "Holzbrett, das beim Blendrahmenfenster in Steinbauten die Fläche der Brüstung zur Fensteröffnung abdeckt; bei inneren Futterrahmen wird so das untere Brett bezeichnet. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_167cb98f, :conceptScheme_b41bd73a;
  skos:prefLabel "Fensterbrett"@de, "poprsní deska"@cs;
  skos:altLabel "Simsbrett"@de, "parapetní prkénko"@cs;
  skos:broader :c_b2356bd0, :c_ba70e9ab, :c_e9fab383;
  dct:created "2019-06-17T14:48:47.000"^^xsd:dateTime;
  dct:modified "2021-01-22T15:04:51.000"^^xsd:dateTime;
  :broaderByPosition :c_ba70e9ab .

:c_fa092080 a skos:Concept;
  skos:definition "Unter Wandanschluss (auch Maueranschluss) wird die Verbindung von Fenstern und Türen an das umgebende Material (z.B. Mauerwerk) verstanden. [Pax - Fenster & Türen Fachbegriffe]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0;
  skos:prefLabel "Wandanschluss"@de;
  skos:broader :c_b2356bd0;
  dct:created "2019-10-15T12:07:55.000"^^xsd:dateTime;
  dct:modified "2020-01-29T10:40:51.000"^^xsd:dateTime .

:c_f3e59e57 a skos:Concept;
  skos:definition "Fensterbekrönung, vorspringendes Bauglied über einer Fensteröffnung an der Außenwand, urspr. zur Entlastung und vielleicht als Regenschutz, meist aber rein dekorativ angewendet. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "Fensterverdachung"@de, "zastřešení okna (např. římsa)"@cs;
  skos:altLabel "Verdachung"@de;
  skos:broader :c_b2356bd0, :c_fddb0e6d, :c_b08588ac;
  dct:created "2020-08-05T09:43:35.000"^^xsd:dateTime;
  dct:modified "2021-01-19T11:33:30.000"^^xsd:dateTime .

:c_e56c1121 a skos:Concept;
  skos:definition "1. ausladendes Gesims in der Höhe einer Fensterbank an der Außenwand eines Gebäudes. 2. Eine Form der Fensterverdachung, die seit der ital. Renaissance meist nur noch als Mittel zur Belebung von Fassaden durch Schattenwirkung angewendet wird. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Fenstergesims"@de, "nadokenní římsa"@cs;
  skos:broader :c_b2356bd0, :c_01e49620;
  skos:narrower :c_b395f284;
  dct:created "2020-08-05T11:32:20.000"^^xsd:dateTime;
  dct:modified "2021-01-25T12:16:22.000"^^xsd:dateTime;
  :broaderByPosition :c_01e49620 .

:c_af1eb3a9 a skos:Concept;
  skos:definition "Querstab aus Holz oder Stein, der Fenster (oder Tür) unterteilt, bildet mit dem senkrecht teilenden Setzholz das Fensterkreuz. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_8c0441f9;
  skos:prefLabel "Kämpfer (Fenster)"@de;
  skos:broader :c_b2356bd0;
  dct:created "2020-08-17T09:38:08.000"^^xsd:dateTime;
  dct:modified "2020-08-17T09:39:35.000"^^xsd:dateTime .

:c_f096c112 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Fensterumrahmung"@de;
  skos:broader :c_b2356bd0;
  dct:created "2020-08-25T15:02:03.000"^^xsd:dateTime .

:c_65ce400b a skos:Concept;
  skos:definition "Äußere, die Fensteröffnung rahmende Zierglieder, oft von einer Fensterverdachung bekrönt und unten meist vom Fensterbankgesims abgeschlossen. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Fenstereinfassung"@de;
  skos:broader :c_b2356bd0;
  dct:created "2020-09-14T12:21:56.000"^^xsd:dateTime;
  dct:modified "2020-09-14T12:22:34.000"^^xsd:dateTime .

:c_1ddc5f4c a skos:Concept;
  skos:definition "In oder vor der Fensteröffnung angebrachtes, schmiedeeisernes Gitter, manchmal in seinem unteren Teil nach außen schwingend (Fensterkorb), damit man beim Hinauslehnen nicht behindert ist. Das F. ist oft verziert und bes. an seinem oberen Ende reich ausgeschmückt. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_50ec0c5e;
  skos:prefLabel "Fenstergitter"@de;
  skos:broader :c_b2356bd0, :c_3b768083;
  skos:narrower :c_471ed7a6;
  dct:created "2020-09-14T12:32:05.000"^^xsd:dateTime;
  dct:modified "2021-01-30T23:27:05.000"^^xsd:dateTime;
  :broaderByPosition :c_3b768083 .

:c_3b768083 a skos:Concept;
  skos:definition "Stabwerk aus Holz-, Eisen- oder Bronze-Stäben, die in einer Fläche liegen und sich entweder überkreuzen oder nebeneinander angeordnet sind. Gitter dienen als licht- und luftdurchlässige Abschlüsse vor Tür- und Fensteröffnungen, als Einfriedungen und Brüstungen. Die Form der Gitterstäbe ist mannigfaltig,besonders bei Schmiedeeisen-Gittern; Grundform sind Flach-, Rund- oder Vierkantstäbe. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_50ec0c5e;
  skos:prefLabel "grille"@fr, "mřížka"@cs, "inferriata"@it, "grate"@en, "enrejado"@es,
    "Gitter"@de;
  skos:altLabel "lattice"@en, "treillis"@fr;
  skos:broader :c_6768e926, :c_klbrisjd;
  skos:narrower :c_1ddc5f4c, :c_96306b6f, :c_93611457, :c_b9d3b3f4, :c_2bcfd130, :c_d64a4389;
  dct:created "2020-01-16T14:22:25.000"^^xsd:dateTime;
  dct:modified "2021-01-30T23:25:24.000"^^xsd:dateTime .

:c_8cd1bdb6 a skos:Concept;
  skos:definition "Um bei relativ kleinen Fensteröffnungen in dicken Mauern den Lichteinfall zu vergrößern oder das Fenster opt. größer erscheinen zu lassen, werden die Fenstereinschnitte nach innen, meist auch nach außen schräg geführt. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Fensterschräge"@de;
  skos:broader :c_b2356bd0;
  dct:created "2020-09-14T12:45:54.000"^^xsd:dateTime;
  dct:modified "2020-09-14T12:46:40.000"^^xsd:dateTime .

:c_f4ceb052 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe;
  skos:prefLabel "Fensterglaselement"@de;
  skos:broader :c_b2356bd0;
  skos:narrower :c_b4ff976b, :c_e1a6eab7;
  dct:created "2020-09-15T15:30:51.000"^^xsd:dateTime .

:c_eba7d6e7 a skos:Concept;
  skos:definition "Fensterbrüstung, die Mauer zwischen Fußboden und Fensterbrett. [Koepf / Binding 2016]"@de,
    "Wandfläche zwischen Fußboden und Fensteröffnung. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_b41bd73a;
  skos:prefLabel "Fensterbrüstung"@de;
  skos:broader :c_b2356bd0, :c_ad4ce2d6;
  skos:related :c_4319de49;
  dct:created "2020-09-29T16:19:35.000"^^xsd:dateTime;
  dct:modified "2020-09-29T16:20:44.000"^^xsd:dateTime .

:c_16c00524 a skos:Concept;
  skos:definition "Die Ebene eines Falzes, gegen die der Flügel beim Verschließen im Fensterrahmen schlägt. [Pax - Fenster & Türen Fachbegriffe]"@de,
    "Anschlag, bei Türen und Fenstern ein schmaler, rings um die Maueröffnung laufender Absatz (Falz), in den der hölzerne Blendrahmen eingefügt ist; allg. auch jede Fläche, gegen die ein anderer Teil, z.B. ein Fensterflügel oder Schlagladen schlägt. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_c7b144d0, :conceptScheme_b41bd73a;
  skos:prefLabel "Anschlag"@de;
  skos:broader :c_7039254c;
  dct:created "2019-05-22T18:53:20.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:12:38.000"^^xsd:dateTime .

:c_0d678652 a skos:Concept;
  skos:definition "Arkadenfenster, durch eine fortlaufende Reihe von Arkaden unterteiltes Fenster, häufig in Kreuzgängen und Königspfalzen der roman. Zeit. [Koepf / Binding 2016]"@de,
    "Durch Bogenstellung gegliedertes Fenster. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "fenêtre à arcades"@fr, "arcaded window"@en, "Arkadenfenster"@de;
  skos:broader :c_4708d89a;
  skos:narrower :c_277bb521;
  dct:created "2019-05-22T18:58:49.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:08:55.000"^^xsd:dateTime;
  :broaderByShape :c_4708d89a .

:c_277bb521 a skos:Concept;
  skos:definition "Schallfenster, Klangarkade, Schallloch; unverglaste, fensterartige Maueröffnung an Türmen in der Höhe des Glockenstuhls, häufig als gekuppelte Arkaden (Schallarkaden) oder maßwerkgefüllte Fenster (Schallfenster), zur Verbreitung des Schalls dienend. Um das Eindringen von Schnee und Regen zu verhindern, wird die S. mit Schallladen, Schallbrettern oder Schalldächern versehen. [Koepf / Binding 2016]"@de,
    "Durch Arkaden gegliederte Maueröffnung in der Höhe des Glockenstuhles von Türmen, vielfach als Zwillings- oder Drillingsarkade. Häufig schützen hölzerne Läden, Schalldächer oder Schallbretter die Öffnungen gegen Regen und Wind. [Glossarium Artis]"@de,
    "Schallöffnung in Arkadenform. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "Schallarkade"@de, "vano del campanario"@es, "rosa di campanile"@it,
    "ouïe de clocher"@fr, "bell-arcade"@en;
  skos:altLabel "baie de clocher"@fr, "louver window"@en, "Klangarkade"@de, "Schallfenster"@de,
    "Schallöffnung"@de, "Schallloch"@de;
  skos:broader :c_4708d89a, :c_b38a6b54, :c_0d678652;
  dct:created "2019-10-22T10:14:59.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:06:13.000"^^xsd:dateTime .

:c_de335971 a skos:Concept;
  skos:definition "Aufeinanderleimen von Brettern mit gegeneinander versetztem Faserverlauf, wodurch das \"Arbeiten\" des Holzes verhindert werden soll. [Pax - Fenster & Türen Fachbegriffe]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_c7b144d0, :conceptScheme_315cf028;
  skos:prefLabel "Aufdoppelung"@de;
  skos:broader :c_67c30860;
  dct:created "2019-05-22T19:00:09.000"^^xsd:dateTime;
  dct:modified "2021-01-22T10:14:05.000"^^xsd:dateTime .

:c_6e1ba7b5 a skos:Concept;
  skos:definition "Oberbegriff für Sprungblei und Notblei. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_315cf028,
    :conceptScheme_b41bd73a;
  skos:prefLabel "Reparaturblei"@de;
  skos:broader :c_67c30860, :c_d944cc16;
  skos:narrower :c_57bbe500, :c_8d5beacc;
  dct:created "2019-06-18T08:41:24.000"^^xsd:dateTime;
  dct:modified "2021-03-19T14:55:50.000"^^xsd:dateTime .

:c_d944cc16 a skos:Concept;
  skos:definition "Streifen aus Blei mit verschiedenen Profilen, durch die einzelne Glasscheiben und/oder kleinteilige Glasformate aus Flachglas zu Glasfeldern miteinander verbunden werden, wenn die zu verglasende Fläche größer als das Einzelglas ist. An den Berührungspunkten werden die Streifen miteinander verlötet. Es werden unterschieden: Bleiruten, Bleisprossen, Karniesblei und Umblei. Zum Fensterblei gehört auch die Bleihafte und das konstruktiv notwendige, allerdings nicht aus Blei bestehende Windeisen. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0,
    :conceptScheme_b41bd73a;
  skos:prefLabel "Fensterblei"@de;
  skos:broader :c_fd1a5740;
  skos:narrower :c_6e1ba7b5, :c_64444f2c, :c_be713e0d, :c_9d017b39, :c_fda33416, :c_078c106d,
    :c_79df618e;
  dct:created "2019-05-23T08:36:02.000"^^xsd:dateTime;
  dct:modified "2020-06-19T13:54:06.000"^^xsd:dateTime .

:c_09a35bc7 a skos:Concept;
  skos:definition "Eine auf den Schmalseiten mit einer Glasnut versehene schmale Holzleiste, mit der einzelne Glastafeln repariert wurden. Dazu wurde der von der Zerstörung verschont gebliebene Teil der Glastafel, nachdem er aus dem Fenster genommen wurde, gerade geschnitten und mit einem anderen Stück Glas auf das erforderliche Format mit Hilfe einer Reparatursprosse ergänzt und wieder eingebaut. Eine Reparatursprosse hat i. d. R. nicht die Stärke der Schenkel des Flügels. Während ein Sprungblei gebogen werden kann, muss für die Reparatursprosse das Glas immer gerade geschnitten werden. Sie wurde bis nach dem Zweiten Weltkrieg verwendet und ist heute noch zu finden. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_315cf028,
    :conceptScheme_b41bd73a;
  skos:prefLabel "Reparatursprosse"@de;
  skos:broader :c_67c30860, :c_cf039840;
  dct:created "2019-06-18T08:50:44.000"^^xsd:dateTime;
  dct:modified "2021-03-19T14:55:25.000"^^xsd:dateTime .

:c_cf039840 a skos:Concept;
  skos:definition "Schmale Holzleiste, welche mit dem Fenster- oder Flügelrahmen konstruktiv verbunden ist, aber nicht zur Rahmenkonstruktion gehört, sondern Teil des Glasfeldes ist. Sie ist profiliert (Lichtfase, Viertel- oder Halbrundstabe etc.) und hat entweder eine Glasnut oder einen Kittfalz. Holzsprossen unterteilen die Rahmenöffnung in i. d. R. gleichgroße Felder, die durch eine Verglasung geschlossen werden. Es gibt Höhensprossen und Quersprossen in Holz. [Noky 1996]"@de,
    "Schmale Holzleiste (ab ca. 15mm aufwärts), die die Fensterfläche innerhalb des Flügel- oder Blendrahmens konstruktiv unterteilt. Holzsprossen sind meist in der gleichen Art wie die Flügelrahmenhölzer innen profiliert und werden als Quer- oder Längssprossen bezeichnet. [Pax - Fenster & Türen Fachbegriffe]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0,
    :conceptScheme_b41bd73a;
  skos:prefLabel "Holzsprosse"@de;
  skos:broader :c_fbedadd4, :c_bf40c1bc;
  skos:narrower :c_09a35bc7, :c_1124e5fd, :c_8fc063d3, :c_585110dc, :c_4ffd4552, :c_e375fe62;
  dct:created "2019-05-23T08:52:32.000"^^xsd:dateTime;
  dct:modified "2019-06-18T10:21:08.000"^^xsd:dateTime .

:c_78b5a900 a skos:Concept;
  skos:definition "Der feststehende Pfosten (Setzholz) als Anschlag eines Flügelpaares entfällt. Der Pfostenteil ist in einem der beiden Flügel eingearbeitet und dient als Anschlag des anderen Flügels. [Pax - Fenster & Türen Fachbegriffe]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0,
    :conceptScheme_b41bd73a;
  skos:prefLabel "Aufgehender Pfosten"@de;
  skos:altLabel "Aufgehender Stock"@de, "Stulp"@de;
  skos:broader :c_be2985ad;
  dct:created "2019-05-22T19:00:51.000"^^xsd:dateTime;
  dct:modified "2019-06-12T17:23:30.000"^^xsd:dateTime .

:c_be2985ad a skos:Concept;
  skos:definition "Setzholz, senkrechte Gliederung eines Fensters. [Koepf / Binding 2016]"@de,
    "Senkrechtes Holz zwischen mehrflügeligen Fenstern als vertikaler Anschlag der Flügel. [Pax - Fenster & Türen Fachbegriffe]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_c7b144d0, :conceptScheme_b41bd73a;
  skos:prefLabel "Fensterpfosten"@de;
  skos:altLabel "Setzholz"@de, "Pfosten"@de, "Stock"@de;
  skos:broader :c_fbedadd4;
  skos:narrower :c_78b5a900, :c_bdd4abf3;
  dct:created "2019-06-12T15:12:08.000"^^xsd:dateTime;
  dct:modified "2020-09-14T12:43:06.000"^^xsd:dateTime .

:c_84ce464e a skos:Concept;
  skos:definition "Spezielle zweiteilige Verriegelung, die aus einem einarmigen Hebel auf Platte mit Griffolive sowie einem Haken auf Platte als Gegenstück besteht. Sie dient bei einem zweiflügeligen Fenster als Verschluss und ist in Griffhöhe etwa mittig auf beiden Fensterflügelrahmen befestigt. Wird häufig durch einen Vorreiber oben und unten ergänzt, die in den Fensterrahmen eingelassen sind. [Pax - Fenster & Türen Fachbegriffe]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0;
  skos:prefLabel "Aufreiber"@de;
  skos:broader :c_d936f79a;
  dct:created "2019-05-22T19:02:12.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:41:14.000"^^xsd:dateTime .

:c_d936f79a a skos:Concept;
  skos:definition "Beschläge, die durch ihre Funktion die Fensterflügel in geschlossenem Zustand im Fensterrahmen arretieren. Folgende Fensterverriegelungen sind bekannt: Ankettel, Reiber, Ruderverriegelung, Schubstange, Basküle und Espagnolette. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Fensterverriegelung"@de, "okenní zámek"@cs;
  skos:broader :c_152bb636;
  skos:narrower :c_84ce464e, :c_72c0390c, :c_28020056, :c_300bcb11, :c_18b9aa69, :c_3244cac9,
    :c_93b9ef28, :c_d4b29125, :c_d13900ea;
  dct:created "2019-06-13T16:54:13.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:41:05.000"^^xsd:dateTime .

:c_152bb636 a skos:Concept;
  skos:definition "Sammelbegriff für alle Metallteile an den Fenstern, außer Blei. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0,
    :conceptScheme_b41bd73a;
  skos:prefLabel "Fensterbeschlag"@de, "okenní kování"@cs;
  skos:broader :c_fd1a5740, :c_ff300c4e;
  skos:narrower :c_d936f79a, :c_618ff024, :c_83466008, :c_da676958, :c_c6e3b280, :c_0b04c274,
    :c_36853be0, :c_93275f33, :c_a26e50e3, :c_b8036099, :c_39fa2838, :c_452caf4a, :c_c4f800dd,
    :c_6dfd6e14, :c_cb8131a1, :c_b6cfa49f, :c_414c74d7, :c_97ab5350, :c_ae6a3c2b, :c_c52c2bba,
    :c_e46b7704, :c_c10a0de6, :c_f956b4f7, :c_c07e9947, :c_bcaca63b;
  dct:created "2019-05-22T19:02:46.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:40:44.000"^^xsd:dateTime;
  :broaderByPosition :c_ff300c4e .

:c_ff300c4e a skos:Concept;
  skos:definition "Beschlag, Baubeschlag, als Türb. zur Sicherung und Festigkeit als geschmiedetes Eisen in der Form flacher Bänder neben dem funktionell notwendigen Angelschienen (Angel) angebracht, zumeist waagerechte Bänder mit gespaltenen Enden, später weit ausschwingend und reich verziert. Früheste Belege um 1100, frz. Ausbildungen durch Zisterzienser in Deutschland und England verbreitet; im 15. Jh. die ganze Türfläche überziehend mit Ranken, Gitter, Maßwerk usw., seit dem 16. Jh. geringe Bedeutung. Zum B. zählen auch die Schlossbleche, Griffe, Türklopfer und Schlösser, die bis ins 19. Jh. Gegenstand künstler. Gestaltung blieben. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Beschlag"@de, "kování"@cs;
  skos:broader :c_6d1689d0;
  skos:narrower :c_152bb636, :c_afa66dbe, :c_ff863922, :c_c68fefae, :c_611acba3;
  dct:created "2020-06-16T18:24:50.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:38:41.000"^^xsd:dateTime .

:c_618ff024 a skos:Concept;
  skos:definition "Ausführung als zwei- oder mehrteiliges Band für die Beweglichkeit von Türen oder Fenstern. Wird zur Befestigung beidseitig eingebohrt, im Gegensatz zum Aufsatzband, das aufgeschraubt oder aufgenagelt wird. [Pax - Fenster & Türen Fachbegriffe]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0;
  skos:prefLabel "Einbohrband"@de;
  skos:broader :c_152bb636, :c_afa66dbe;
  dct:created "2019-05-23T08:15:37.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:40:28.000"^^xsd:dateTime .

:c_afa66dbe a skos:Concept;
  skos:definition "Fensterbeschlag und Türbeschlag, der bei einem Band mit Bandrolle sein Gegenstück in einem Kloben hat, bei einem Lappenband einen eingestemmten oder aufgeschraubten Lappen. Dementsprechend unterscheidet man auch zwischen einem Aufsatzband mit Bandrolle und Kloben, einem Einstemmband mit Lappen und einem Einbohrband mit Schraubgewinde. Je nach Form und Funktion gibt es z. B. das Winkelband, das Langband und das Fitschenband. [Schrader / Voigt 2003]"@de,
    "Befestigungselement aus Metall, an dem die Flügel am Rahmen beweglich gelagert sind. [Pax - Fenster & Türen Fachbegriffe]"@de,
    "Band, 3. Als Beschlagteil bildet das B. den Bewegungsbeschlag (Scharnierband) bei Türen und Fenstern, mit dessen Hilfe die Flügel bewegt und eingehängt werden. [Koepf / Binding 2016]"@de,
    "Bandeisen, kaltgewalzter Eisenstab von geringer Dicke. Der Begriff wird häufig für das Band an Türen oder Fenstern verwendet. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_5bf6bcac, :conceptScheme_c7b144d0, :conceptScheme_b41bd73a;
  skos:prefLabel "Band (Beschlag)"@de, "závěs (kování)"@cs;
  skos:altLabel "Bandeisen"@de;
  skos:broader :c_ff300c4e;
  skos:narrower :c_618ff024, :c_da676958, :c_fbe410d6;
  skos:related :c_82c2f528;
  dct:created "2019-06-12T14:04:24.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:38:57.000"^^xsd:dateTime .

:c_83466008 a skos:Concept;
  skos:definition "    (ähnl. Drahstifte) kleine Blechdreiecke zum Fixieren der Scheibe im Glasfalz (vor dem Verkitten)."@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Glaserecke"@de;
  skos:broader :c_152bb636;
  dct:created "2019-05-23T08:43:36.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:43:44.000"^^xsd:dateTime .

:c_da676958 a skos:Concept;
  skos:definition "Zwei mittels Dorn verbundene Rollen, die als Lappen endend verdeckt im Flügel- und Rahmenholz fixiert sind. [Pax - Fenster & Türen Fachbegriffe]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0,
    :conceptScheme_b41bd73a;
  skos:prefLabel "Fitschband"@de;
  skos:altLabel "Einstemmband"@de, "Fischband"@de, "Fitschenband"@de;
  skos:broader :c_152bb636, :c_afa66dbe, :c_9ae295fe;
  dct:created "2019-06-12T14:17:27.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:40:36.000"^^xsd:dateTime .

:c_9ae295fe a skos:Concept;
  skos:definition "Sammelbezeichnung für die Beschlagteile einer Tür, die dem beweglichen Anschlag einer Tür dienen. Das Türband besteht stets aus zwei Teilen, einem Kloben, der fest am Türrahmen angebracht ist, und dem beweglichen Band mit Bandrolle, welches an dem Türflügel angebracht wird, dem Langband oder Schippenband, oder aus zwei gleichen Bandlappen wie beim Fitschenband. Insbesondere können dies sein ein S-Band, Schippenband, Langband, Winkelband, Eckwinkelband, Kreuzband, Fitschenband, Aufsatzband, Einbohrband sowie Spezialbänder für eine Schiebetür oder Pendeltür. [Schrader / Voigt 2003]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_5bf6bcac;
  skos:prefLabel "Türband"@de;
  skos:broader :c_c68fefae;
  skos:narrower :c_da676958, :c_0b04c274, :c_b8036099, :c_f3f447a5, :c_c4758fa5;
  dct:created "2020-11-25T14:49:04.000"^^xsd:dateTime;
  dct:modified "2021-01-22T19:05:59.000"^^xsd:dateTime .

:c_c6e3b280 a skos:Concept;
  skos:definition "Blatt-, mondsichelartiges oder rautenförmiges Band. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Blattband"@de;
  skos:broader :c_152bb636, :c_fbe410d6;
  dct:created "2019-06-12T14:20:32.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:39:13.000"^^xsd:dateTime .

:c_fbe410d6 a skos:Concept;
  skos:definition "Oft dekorativ gestaltetes Türband oder Fensterband, das mit Schrauben oder Nägeln auf der Holzkonstruktion befestigt wird, im Gegensatz zum einfachen Einstemmband, das in das Holz eingelassen wird, und zum Einbohrband, das eingebohrt wird. Es kann sich um ein Langband, ein S-Band, ein Eckwinkelband oder ein Kreuzband handeln. [Pax - Fenster & Türen Fachbegriffe]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0;
  skos:prefLabel "Aufsatzband"@de;
  skos:altLabel "Aufschraubband"@de;
  skos:broader :c_afa66dbe;
  skos:narrower :c_c6e3b280, :c_0b04c274, :c_36853be0, :c_93275f33, :c_a26e50e3, :c_b8036099,
    :c_f3f447a5, :c_c4758fa5, :c_b89ef5f0;
  dct:created "2019-05-22T19:05:30.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:39:05.000"^^xsd:dateTime .

:c_0b04c274 a skos:Concept;
  skos:definition "Rechtwinklig geformtes Band, besonders in Verbindung mit einem Leistenflügel. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0,
    :conceptScheme_b41bd73a;
  skos:prefLabel "Winkelband"@de, "úhlový závěs"@cs;
  skos:broader :c_152bb636, :c_9ae295fe, :c_fbe410d6;
  dct:created "2019-06-12T14:33:32.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:40:20.000"^^xsd:dateTime .

:c_36853be0 a skos:Concept;
  skos:definition "Winkelband mit einem waagerechten und einem senkrechten Zierende. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Kreuzband (Beschlag)"@de, "křížový závěs"@cs;
  skos:broader :c_152bb636, :c_fbe410d6;
  dct:created "2019-06-12T14:36:17.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:39:35.000"^^xsd:dateTime .

:c_93275f33 a skos:Concept;
  skos:definition "Gerades, senkrechtes Band, oft mit Zierformen an den Enden. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Vertikalband"@de, "vertikální závěs"@cs;
  skos:broader :c_152bb636, :c_fbe410d6;
  dct:created "2019-06-12T14:38:12.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:40:12.000"^^xsd:dateTime .

:c_a26e50e3 a skos:Concept;
  skos:definition "Gerades, waagerechtes Band, oft mit Zierformen an den Enden. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Horizontalband"@de, "horizontální závěs"@cs;
  skos:broader :c_152bb636, :c_fbe410d6;
  dct:created "2019-06-12T14:38:39.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:39:26.000"^^xsd:dateTime .

:c_b8036099 a skos:Concept;
  skos:definition "Schmales, längliches Band, i.d.R. mit Zierform am Ende gegenüber der Rolle, nur in Verbindung mit einem Brettflügel, Laden, Tür oder Tor. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Langband (Beschlag)"@de, "dlouhý závěs"@cs;
  skos:altLabel "rovný závěs"@cs;
  skos:broader :c_152bb636, :c_9ae295fe, :c_fbe410d6;
  dct:created "2019-06-12T14:39:12.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:39:42.000"^^xsd:dateTime .

:c_39fa2838 a skos:Concept;
  skos:definition "Beschlag an den Höhenschenkeln der Fensterrahmen oder an den Höhenstücken der Fensterflügel (für Lüftungsflügel), in dessen Dorn die Rolle des Bandes am Fensterflügel gehangen wird. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Kloben"@de;
  skos:broader :c_152bb636;
  skos:narrower :c_74e7a266, :c_3dc21bc9, :c_20262d98;
  dct:created "2019-06-13T14:58:17.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:44:26.000"^^xsd:dateTime .

:c_452caf4a a skos:Concept;
  skos:definition "In Sachsen Bankeisen genannt. Eisen, mitunter als Einreiber geformt, das den Fensterrahmen im inneren Falz der äußeren Werksteinrahmung oder im Anschlag des Mauerwerks hält. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Halteisen"@de;
  skos:altLabel "Bankeisen"@de;
  skos:broader :c_152bb636;
  dct:created "2019-06-17T12:09:25.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:44:02.000"^^xsd:dateTime .

:c_c4f800dd a skos:Concept;
  skos:definition "Türen- und Fensterzubehör zum Öffnen beim einem Anschlag nach innen, und Schließen bei einem Anschlag nach außen, der vermutlich seit der Gotik bekannt ist. Er gilt als Standardbeschlag in der Renaissance und war noch bis in den Barock üblich. Danach wurde er vom Zugknauf abgelöst. [Schrader / Voigt 2003]"@de,
    "Vermutlich seit der Gotik bekannte, bis in den Barock reichende Form des Griffes zum Öffnen der Fensterflügel. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_5bf6bcac,
    :conceptScheme_b41bd73a;
  skos:prefLabel "Griffring"@de;
  skos:altLabel "Zugring"@de;
  skos:broader :c_152bb636, :c_ff863922;
  dct:created "2019-06-17T15:54:25.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:43:51.000"^^xsd:dateTime .

:c_ff863922 a skos:Concept;
  skos:definition "Bezeichnung für den Fenstergriff. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Handhabe"@de, "madlo, přítuha"@cs;
  skos:altLabel "Fenstergriff"@de;
  skos:broader :c_ff300c4e;
  skos:narrower :c_c4f800dd, :c_6dfd6e14, :c_8030b9c8;
  dct:created "2019-06-17T16:03:12.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:49:24.000"^^xsd:dateTime .

:c_6dfd6e14 a skos:Concept;
  skos:definition "Form des Fenstergriffes, zeitlich nach dem Griffring. Auf einem Schaft, oft mit Zierform, wird ein Eisenring mit dem Querschnitt einer Ellipse geschmiedet. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Knopf"@de;
  skos:altLabel "hlavice"@cs, "Knauf"@de;
  skos:broader :c_152bb636, :c_ff863922;
  dct:created "2019-06-17T16:59:43.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:45:03.000"^^xsd:dateTime .

:c_cb8131a1 a skos:Concept;
  skos:definition "Eisenteil, in den Werksteinrahmen mit einem Holzdübel eingesetzt, an den die Bänder des Fensterflügels eingehangen werden. Bei dieser Konstruktion gibt es keinen Fensterrahmen, die Flügel schlagen direkt an oder in einen Anschlagfalz des Werksteinrahmens. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Haspe"@de;
  skos:broader :c_152bb636;
  dct:created "2019-06-17T17:05:32.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:44:11.000"^^xsd:dateTime .

:c_b6cfa49f a skos:Concept;
  skos:definition "Kreuzförmiges Gebilde aus flachen Eisenstreifen. Das Kreuzeisen kann aus einem Stück oder zwei sich kreuzenden, einzelnen Streifen bestehen. An den Enden befinden sich i. d. R. Zierformen. Es dient der Aussteifung des Kreuzstockes. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Kreuzeisen"@de;
  skos:broader :c_152bb636;
  dct:created "2019-06-18T07:37:22.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:45:18.000"^^xsd:dateTime .

:c_414c74d7 a skos:Concept;
  skos:definition "Zierbeschlag in der Form einer Rose oder auch Blume. Die Rosette dient u. a. der Zier unter Griffringen und Knäufen und kann auch auf dem Kreuzeisen erscheinen. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0,
    :conceptScheme_b41bd73a;
  skos:prefLabel "Rosette (Beschlag)"@de;
  skos:broader :c_152bb636;
  dct:created "2019-06-18T09:01:28.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:45:33.000"^^xsd:dateTime .

:c_97ab5350 a skos:Concept;
  skos:definition "Nagel mit einem runden Kopf, welcher zur Zierde bei der Befestigung von Bändern, Kreuzeisen und Reibern verwendet wird. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Rundkopfnagel"@de;
  skos:broader :c_152bb636;
  dct:created "2019-06-18T09:06:57.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:45:42.000"^^xsd:dateTime .

:c_ae6a3c2b a skos:Concept;
  skos:definition "Beschlag, der der Aufhängung und Bewegung eines Fensterflügels am Fensterrahmen dient. Das Scharnier besteht aus zwei flachen Eisenteilen mit Rollen an den Enden, die ineinander gesteckt und mit einem Dorn zusammengehalten werden. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Scharnier"@de;
  skos:broader :c_152bb636;
  dct:created "2019-06-18T09:10:36.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:45:50.000"^^xsd:dateTime .

:c_c52c2bba a skos:Concept;
  skos:definition "Eisen, welches an den Enden von Pfosten und Querholz, dem Kreuzstock, und auf den Schenkeln aufgenagelt ist und neben einer Zier eine zusätzliche Sicherung der Verbindungen bringt.  [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Stockeisen"@de;
  skos:broader :c_152bb636;
  dct:created "2019-06-18T10:14:28.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:46:00.000"^^xsd:dateTime .

:c_e46b7704 a skos:Concept;
  skos:definition "Haken am nach außen aufschlagenden Fensterflügel, um den geöffneten Flügel windfest zu arretieren. Der Sturmhaken befindet sich i. d. R. am Flügel, am Fensterrahmen ist die Öse zur Aufnahme des Hakens befestigt. In Sachsen ist der Sturmhaken am von außen vorgesetzten Winterfenster zu finden. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Sturmhaken"@de;
  skos:broader :c_152bb636;
  dct:created "2019-06-18T10:28:04.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:46:13.000"^^xsd:dateTime .

:c_c10a0de6 a skos:Concept;
  skos:definition "Winkeleisen - (Scheinwinkel, Eckwinkel) dient als konstruktive Verstärkung der Ecken von Flügelrahmen. [Pax - Fenster & Türen Fachbegriffe]"@de,
    "Flacher Eisenwinkel, mit dem die Ecken von Flügelrahmen verstärkt werden, an denen nicht schon ein Winkelband angebracht ist. Die Enden des Winkeleisens weisen fast immer eine Zierform auf. Das Winkeleisen tritt nur in bestimmten Landschaften auf und hat neben der stabilisierenden Funktion eine gestalterische. Es ist konstruktiv nicht notwendig, weil die Schlitzzapfen der Eckverbindungen mit einem Holznagel gesichert sind. Winkeleisen wurden häufig für Reparaturen verwendet. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0,
    :conceptScheme_b41bd73a;
  skos:prefLabel "Winkeleisen"@de;
  skos:broader :c_152bb636;
  dct:created "2019-06-18T16:34:13.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:46:36.000"^^xsd:dateTime .

:c_f956b4f7 a skos:Concept;
  skos:definition "Blattähnliche Form eines Ziereisens, z. B. Drei- o. Vierblatt. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Zierblatt"@de;
  skos:broader :c_152bb636;
  dct:created "2019-06-18T16:39:34.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:46:46.000"^^xsd:dateTime .

:c_c07e9947 a skos:Concept;
  skos:definition "Beschlag ohne konstruktive Funktion, der u.a. unter dem Knauf nur zur Verzierung auf den Schenkel genagelt ist. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Ziereisen"@de;
  skos:broader :c_152bb636;
  dct:created "2019-06-18T16:40:38.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:49:17.000"^^xsd:dateTime .

:c_bcaca63b a skos:Concept;
  skos:definition "Spezieller Fensterbeschlag, der bei den ab 1860 üblichen Kastenfenstern am unteren  Rahmenholz angebracht ist, um das Aneinanderschlagen der inneren und äußeren Flügel in geöffnetem Zustand zu verhindern.[Schrader / Voigt 2003]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_5bf6bcac;
  skos:prefLabel "Flügelstopper"@de;
  skos:altLabel "Kastenfensterpuffer"@de, "Fensterpuffer"@de, "Abstandhalter"@de;
  skos:broader :c_152bb636;
  dct:created "2020-01-15T16:37:42.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:43:35.000"^^xsd:dateTime .

:c_82c2f528 a skos:Concept;
  skos:scopeNote "Aufgerolltes Endstück z.B. am Langband [Pax - Fenster & Türen Fachbegriffe]"@de,
    "Aufgerolltes Endstück einer Bandes, zur Lagerung auf dem Gegenstück, dem Kloben. Gibt es u. a. beim Langband, Schippenband und Kreuzband. [Schrader / Voigt 2003]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_5bf6bcac,
    :conceptScheme_c7b144d0;
  skos:prefLabel "Bandrolle"@de, "kotouček"@cs;
  skos:broader :c_f4be0496;
  skos:related :c_afa66dbe;
  dct:created "2019-05-22T19:07:22.000"^^xsd:dateTime;
  dct:modified "2020-11-25T17:19:28.000"^^xsd:dateTime .

:c_f3f447a5 a skos:Concept;
  skos:definition "Gegenüber dem S-Band ein deutlich kürzeres geschmiedetes Band, das aus einem rund-ovalen Lappen mit Bandrolle besteht. Die oft verzierte Platte dient der Schraubenbefestigung am Holz, das Gegenstück ist der Kloben, meist in Form eines Stützklobens. Es entwickelte sich aus Platzgründen mit dem Aufkommen der gestemmten Füllungstür mit schmalem Rahmen im Anschluss an die Brettertür und ähnelt formal dem Kreuzband. Es verdankt seinen Namen wohl der an eine Schaufel erinnernde Form seines Lappens und ist im 18. Jahrhundert und in der 1. Hälfte des 19. Jahrhunderts weit verbreitet. Der sichtbare, meist auf das Holz aufgelegte Bandlappen, hat entweder glatte oder gebrochene Kanten und kann auch Herz- oder andere Formen annehmen. [Schrader / Voigt 2003]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_5bf6bcac;
  skos:prefLabel "Schippenband"@de;
  skos:broader :c_9ae295fe, :c_fbe410d6;
  dct:created "2020-11-25T17:22:35.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:40:06.000"^^xsd:dateTime .

:c_c4758fa5 a skos:Concept;
  skos:definition "Speziell geformtes Band mit Bandrolle in geschweifter S-Form, das ähnlich wie das Langband in einen wandseitigen Kloben eingehängt wird. Es gilt als das typische Türband des Barocks. Einsatz an Tür, Fenster und Fensterladen. [Schrader / Voigt 2003]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_5bf6bcac;
  skos:prefLabel "S-Band"@de;
  skos:broader :c_9ae295fe, :c_fbe410d6;
  dct:created "2020-11-25T17:24:42.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:39:51.000"^^xsd:dateTime .

:c_c7033f9e a skos:Concept;
  skos:definition "Fußstück bzw. Verzierungselement, das am unteren Ende der Schlagleiste oder des Pfostens sitzt. [Pax - Fenster & Türen Fachbegriffe]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_c7b144d0;
  skos:prefLabel "Basis (Fenster)"@de;
  skos:broader :c_7039254c;
  dct:created "2019-05-22T19:09:38.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:12:48.000"^^xsd:dateTime .

:c_17ded52c a skos:Concept;
  skos:definition "Ursprüngliche französische Bezeichnung für Karniesprofil. [Pax - Fenster & Türen Fachbegriffe]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_c7b144d0;
  skos:prefLabel "Corniche (Fenster)"@de;
  skos:broader :c_7039254c;
  dct:created "2019-05-23T08:08:16.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:12:58.000"^^xsd:dateTime .

:c_993a4366 a skos:Concept;
  skos:definition "Dieses innere Befestigungsprofil gibt dem Fensterglas seinen Halt im Fensterrahmen bzw. Flügelrahmen. [Pax - Fenster & Türen Fachbegriffe]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_c7b144d0;
  skos:prefLabel "Glashalteleiste"@de, "zasklívací lišta"@cs;
  skos:broader :c_7039254c;
  dct:created "2019-05-23T08:45:36.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:13:46.000"^^xsd:dateTime .

:c_046d8d5e a skos:Concept;
  skos:definition "    Enge Nut eines Fenster- oder Flügelrahmens, in die die Glasscheibe gesteckt wird. Glasnuten werden meist bei Steckscheiben ohne Kittfase verwendet. [Pax - Fenster & Türen Fachbegriffe]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_c7b144d0, :conceptScheme_b41bd73a;
  skos:prefLabel "Glasnut"@de;
  skos:broader :c_7039254c;
  dct:created "2019-05-23T08:46:10.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:13:57.000"^^xsd:dateTime .

:c_f9706aee a skos:Concept;
  skos:definition "Hlavice sloupů, pilířů, pilastrů v místě styku podpory a břemene (kladí, klenba). Typy hlavic: akantová, almohadská, antová, bobulová, bosovaná, byzantská a raně křesťanská, cihlová kónusová, dórská, dórsko-etruská, fantastická, figurální, hřibová, ionizující, iónská, iónská rohová, kalichová, kompozitní, korintizující: karolínská, otonská, korintská, krychlová, krychlová s terči, laločnatá, listová s vypouklými listy, palmetová, papyrová, pilastrová, polygonální, renesanční, římsko-dórská, římsko-iónská, římsko-korintská, saská, stalaktitová, talířová, toskánská, volutová, yesería, zoomorfní s šelmami. Koch 2008]"@cs,
    "Meist verziertes Kopfstück, das am oberen Ende der (oft einer Säule vergleichbaren) Schlagleiste sitzt. [Pax - Fenster & Türen Fachbegriffe]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_37522b74, :conceptScheme_c7b144d0;
  skos:prefLabel "Kapitell (Fenster)"@de, "hlavice (okno)"@cs;
  skos:editorialNote "darf nicht unter Profilform stehen"@de;
  skos:broader :c_7039254c;
  skos:narrower :c_67267638;
  dct:created "2019-05-23T08:57:27.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:14:08.000"^^xsd:dateTime .

:c_3fbdefbc a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_c7b144d0;
  skos:prefLabel "Kehlung"@de;
  skos:broader :c_7039254c;
  dct:created "2019-05-23T09:00:43.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:14:44.000"^^xsd:dateTime .

:c_e8019b16 a skos:Concept;
  skos:definition "Teil des Fensterflügels, der in den Einschlagfalz des Fensterrahmens einschlägt bzw. auf den Fensterrahmen aufschlägt. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_b41bd73a;
  skos:prefLabel "Überschlag"@de;
  skos:broader :c_7039254c;
  skos:narrower :c_c05dd4af, :c_5105dab3;
  dct:created "2019-06-13T14:48:21.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:15:36.000"^^xsd:dateTime .

:c_b42ea22e a skos:Concept;
  skos:definition "Auch Schiebenut genannt. Eingehobelte Nut in die jeweils waagerecht gegenüber liegenden Hölzer des Fensterrahmens eines Schiebefensters, zwischen denen der Schiebeflügel beim Verschieben geführt wird. Der Schiebeladen läuft meist in einer Winkelleiste, die an den Fachwerkriegel angenagelt ist und mit diesem die Laufnut bildet. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_b41bd73a;
  skos:prefLabel "Laufnut"@de;
  skos:altLabel "Schiebenut"@de, "Führungsnut"@de;
  skos:broader :c_7039254c;
  dct:created "2019-06-18T07:53:39.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:14:53.000"^^xsd:dateTime .

:c_8ff576d4 a skos:Concept;
  skos:definition "Profilierung, die eine bestimmte Konstruktion oder Eigenschaft ermöglicht oder verbessert, im Gegensatz dazu das Zierprofil. Für den Fensterbau sind zu nennen: u. a. Einschlagfalz, Windfalz, Klemmfalz, Lichtfase, Glasnut, Kittfalz Wetterschenkel, Überschläge. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_b41bd73a;
  skos:prefLabel "Technisches Profil"@de;
  skos:broader :c_7039254c;
  dct:created "2019-06-18T08:22:38.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:15:10.000"^^xsd:dateTime .

:c_8b473c6b a skos:Concept;
  skos:definition "Dient als Verzierung und Auflockerung, hat keine funktionalen Aufgaben. Häufig als: Kämpferzierprofil, Sohlbankprofil, Schlagleistenprofil, Setzholzprofil, Flügelrahmenprofil (Karnies, Hohlkehle), inneres Sprossenprofil. [Pax - Fenster & Türen Fachbegriffe]"@de,
    "Profilierung nur zur Verzierung. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_b41bd73a;
  skos:prefLabel "Zierprofil"@de, "ornamentální profil"@cs;
  skos:broader :c_7039254c;
  dct:created "2019-06-18T08:23:10.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:16:14.000"^^xsd:dateTime .

:c_72c0390c a skos:Concept;
  skos:definition "Schubstangenverschluss bestehend aus zwei meist quadratischen Riegelstangen, die durch Drehung eines Griffes (Olive) nach oben und unten gegenläufig bewegt werden. Die Stangenenden greifen dabei in Kloben, die am Kämpfer bzw. am unteren und oberen Blendrahmen befestigt sind. [Pax - Fenster & Türen Fachbegriffe]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0,
    :conceptScheme_b41bd73a;
  skos:prefLabel "Basküle"@de;
  skos:altLabel "Basquille"@de;
  skos:broader :c_d936f79a;
  dct:created "2019-05-22T19:10:59.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:41:22.000"^^xsd:dateTime .

:c_39738fa5 a skos:Concept;
  skos:definition "Fensterscheibe, das mit Spielraum in den Fensterrahmen eingepasste Fensterglas. [Koepf / Binding 2016]"@de,
    "Flachglas in Form von Glasscheiben und Tafelglas der verschiedenen Technologien, die in den Fensterflügel oder Fensterrahmen (Festverglasung) eingesetzt werden. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Fensterglas"@de, "pane"@en;
  skos:altLabel "Fensterscheibe"@de;
  skos:broader :c_fd1a5740;
  skos:narrower :c_5ae16bcf, :c_bd280e01, :c_a2b6d884, :c_49472a70, :c_9d1a860e, :c_c3d5e0cd,
    :c_d0dddacf, :c_7dab2335, :c_efeb2340, :c_5e75794c, :c_784e3bf2, :c_7c1818c7, :c_2b98b873,
    :c_3cf635a2, :c_6c4e380a, :c_85db31a1, :c_6db938d1, :c_0c16593b, :c_a3280435, :c_f74db145,
    :c_72362dd4, :c_fe836405, :c_dc1aaa33, :c_66b5641d;
  dct:created "2019-05-22T19:12:13.000"^^xsd:dateTime;
  dct:modified "2020-08-31T09:35:42.000"^^xsd:dateTime .

:c_5ae16bcf a skos:Concept;
  skos:definition "Glas mit charakteristischem mittigem Heftnabel. Gesamtscheibe meist Durchmesser von ca. 12 cm, von der sog. Butze (dem Heftnabel) in der Materialstärke nach aussen hin abnehmend (1,3 -0,6 mm). [Pax - Fenster & Türen Fachbegriffe]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0;
  skos:prefLabel "Becherbutze"@de;
  skos:broader :c_39738fa5;
  dct:created "2019-05-22T19:12:25.000"^^xsd:dateTime;
  dct:modified "2019-06-11T17:34:06.000"^^xsd:dateTime .

:c_bd280e01 a skos:Concept;
  skos:definition "Jedes nicht klare Glas, dessen Farbe in Abhängigkeit von seinen Rohstoffen zwischen stark bräunlich und stark grünlich liegt. Wasserklares (sog. optisches) Glas kann nur mit ausgesuchten Zutaten und durch eine Beimengung von Chemikalien erreicht werden. [Pax - Fenster & Türen Fachbegriffe]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0;
  skos:prefLabel "Buntglas"@de;
  skos:broader :c_39738fa5;
  skos:related :c_hvqjmvb3;
  dct:created "2019-05-23T08:06:28.000"^^xsd:dateTime;
  dct:modified "2020-12-03T15:15:34.000"^^xsd:dateTime .

:c_a2b6d884 a skos:Concept;
  skos:definition "Butzenscheiben, kleine, runde, meist grünl. Glasscheiben mit einseitiger Verdickung in der Mitte (Butze), mit Bleistegen im Profanbau zu Fensterscheiben verbunden (15./16. Jh.) und in ma. Wiederaufnahme im 19./20. Jh. [Koepf / Binding 2016]"@de,
    "Většinou kruhová nazelenalá skleněná tabulka zasazená do olověného rámu, uprostřed zesílená (terčík, lidově „pucna\"), v 15. a 16. století jako zasklení oken. [Koch 2008]"@cs,
    "Butzenscheibe (und Mondscheibe) entsteht aus einem geweiteten, aufgetriebenen und geschleuderten Ballon oder Becher, wobei die Mondscheibe einer übergroßen Butze entspricht. [Pax - Fenster & Türen Fachbegriffe]"@de,
    "Glasscheibe, deren runde Form im Herstellungsprozess durch die Fliehkraft beim schnellen Drehen entsteht. In der Mitte bleibt die verdickte Bruchstelle des abgeschlagenen Hefteisens, der Butzen, der Rand ist meistens umgeschlagen. Die Butze ist nicht zu verwechseln mit Mondglas. [Noky 1996]"@de,
    "Meist runde, grünliche Glasscheibe in Bleifassung und mit einer Verdickung (»Butzen«) in der Mitte. Im 15./16. Jh. als Fensterverglasung. Daher noch heute Fenster-»Scheibe« auch für rechteckige Gläser. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9, :conceptScheme_c7b144d0, :conceptScheme_b41bd73a;
  skos:prefLabel "Butzenscheibe"@de, "skleněný terčík"@cs;
  skos:altLabel "Butze"@de;
  skos:broader :c_39738fa5;
  dct:created "2019-05-23T08:07:21.000"^^xsd:dateTime;
  dct:modified "2020-09-08T14:11:08.000"^^xsd:dateTime .

:c_49472a70 a skos:Concept;
  skos:definition "1902 erhielt der Belgier Fourcault das Patent auf ein neuartiges Glasherstellungsverfahren - das Ziehen von Flachglas aus einem Glasschmelzbehälter. Diese Technologie eröffnete damals auch der Architektur neue Wege für den Einsatz von Flachglas. So wurde nach dem Ersten Weltkrieg bis weit in die 60er Jahre das Fourcault-Glas zum Standardfensterglas. [Pax - Fenster & Türen Fachbegriffe]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0;
  skos:prefLabel "Fourcault-Glas"@de;
  skos:altLabel "Ziehglas"@de;
  skos:broader :c_39738fa5;
  dct:created "2019-05-23T08:40:28.000"^^xsd:dateTime;
  dct:modified "2019-06-11T17:34:54.000"^^xsd:dateTime .

:c_9d1a860e a skos:Concept;
  skos:definition "In speziellen Abmessungen quadratisch zugeschnittenes, flaches überfangglas mit den Maßen 10 x 10 cm bis 14 x 14 cm, bei dem partiell die obere dünne Schicht weggeschliffen wurde. Dadurch können verschiedene dekorative Muster zusammengestellt werden. Als Buntglasscheiben befinden sich Friesenecken beim Oberlicht von Haustüren seit der Mitte des 19. Jahrhunderts, später auch in Treppenhausfenstern, Glasabschlusstüren und seltener auch in Haustüren. Die häufigste Farbkombination war Rot-Blau im diagonalen Wechsel, wobei diese Ecken nur in Verbindung mit einer speziellen Ecksprossenunterteilung des Oberlichts vorkamen. Häufig waren auch Ornamente mit polierter Linse in der Mitte. [Pax - Fenster & Türen Fachbegriffe]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0;
  skos:prefLabel "Friesenecke"@de;
  skos:broader :c_39738fa5;
  dct:created "2019-05-23T08:41:44.000"^^xsd:dateTime;
  dct:modified "2019-06-11T17:35:35.000"^^xsd:dateTime .

:c_c3d5e0cd a skos:Concept;
  skos:definition "Fertige Verglasungseinheit bestehend aus zwei oder mehreren gleich oder verschiedenartigen Glasfeldern, die jeweils durch einen Zwischenraum voneinander getrennt sind. Der Raum zwischen den Scheiben ist entweder mit getrockneter Luft oder mit Spezialgasgemischen gefüllt. Die Einheiten sind am Rand luft- und feuchtigkeitsdicht durch spezielle Dichtmassen verbunden. [Pax - Fenster & Türen Fachbegriffe]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0;
  skos:prefLabel "Isolierglas"@de;
  skos:broader :c_39738fa5;
  dct:created "2019-05-23T08:54:21.000"^^xsd:dateTime;
  dct:modified "2019-06-11T17:35:58.000"^^xsd:dateTime .

:c_d0dddacf a skos:Concept;
  skos:definition "Gegossenes Flachglas (Gussglas) mit eingewalztem Ornament (Ornamentglas). Die Oberfläche ist unregelmäßig klein- oder großgehämmert. Es wird häufig für Kirchen- und Badezimmerfenster sowie als Füllung für Zimmer- und Möbeltüren verwendet. [Pax - Fenster & Türen Fachbegriffe]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0;
  skos:prefLabel "Kathedralglas"@de;
  skos:broader :c_39738fa5;
  dct:created "2019-05-23T08:59:41.000"^^xsd:dateTime;
  dct:modified "2019-06-11T17:36:13.000"^^xsd:dateTime .

:c_7dab2335 a skos:Concept;
  skos:definition "Glasfeld, welches nicht in einen Flügelrahmen eingesetzt ist, sondern direkt in den Fensterrahmen, also nicht geöffnet werden kann. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Festverglasung"@de;
  skos:altLabel "Festglasfeld"@de;
  skos:broader :c_f88a153a, :c_39738fa5;
  dct:created "2019-06-11T16:33:25.000"^^xsd:dateTime;
  dct:modified "2020-02-18T08:46:21.000"^^xsd:dateTime;
  :broaderByConstruction :c_f88a153a .

:c_efeb2340 a skos:Concept;
  skos:definition "Die heiße Glasmasse wird in eine Form gebracht, geglättet und gekühlt, schon im antiken Rom bekannt. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Gussglas"@de;
  skos:broader :c_39738fa5;
  skos:narrower :c_559aa52a;
  dct:created "2019-06-13T16:02:20.000"^^xsd:dateTime;
  dct:modified "2019-06-13T16:02:55.000"^^xsd:dateTime .

:c_5e75794c a skos:Concept;
  skos:definition "Durch Drehen wird, ähnlich wie bei der Herstellung der Butze, heiße Glasmasse aufgeschleudert, jedoch weit über die Größe der Butze hinaus. Es wird von Scheiben bis 90cm Durchmesser berichtet. Beim Drehen geht das Glas auf wie ein Mond. Diese Scheiben wurden dann zu Viereck-, Rauten- oder Sechseckgläsern geschnitten und mit Bleisprossen oder -ruten zu Glasfeldern zusammengesetzt. Der Ansatz des Hefteisens in der Mitte wurde wieder eingeschmolzen. Butzen- und Mondglasherstellung sind zwar ähnlich, beruhen aber auf unterschiedlichen Verfahren. Die Butze ist für den Glaser einbaufertig, das Mondglas muss noch in den Zuschnitt. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0,
    :conceptScheme_b41bd73a;
  skos:prefLabel "Mondglas"@de;
  skos:altLabel "Mondscheibe"@de;
  skos:broader :c_39738fa5;
  dct:created "2019-06-13T16:03:25.000"^^xsd:dateTime;
  dct:modified "2019-06-17T15:21:00.000"^^xsd:dateTime .

:c_784e3bf2 a skos:Concept;
  skos:definition "Zylinder- oder Walzenglas wird aus einem längs aufgeschnittenen und im Streckofen unter Wärmezufuhr plan gebügelten Zylinder gewonnen. [Pax - Fenster & Türen Fachbegriffe]"@de,
    "Mit der Methode des Zylinderverfahrens hergestelltes Tafelglas. Aus einem geblasenen und gestreckten Glaszylinder werden Glastafeln und kleinere Glasformate (Viereck, Raute, Sechseck) herausgeschnitten. Seit dem frühen Mittelalter in Mitteleuropa bekannt, aber nur im Kirchenbau verwendet, im Bürgerhaus seit der Spätrenaissance immer mehr Verbreitung findend. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0,
    :conceptScheme_b41bd73a;
  skos:prefLabel "Zylinderglas"@de;
  skos:altLabel "Walzenglas"@de;
  skos:broader :c_39738fa5;
  dct:created "2019-06-13T16:03:43.000"^^xsd:dateTime;
  dct:modified "2019-06-17T15:25:51.000"^^xsd:dateTime .

:c_7c1818c7 a skos:Concept;
  skos:definition "Eine besondere Herstellungsform des Zylinderglases, die aus einer geblasenen Kugel, die in einen Teller gedrückt wird, ein rundes Glas entstehen lässt. Es handelt sich nicht um eine Glasscheibe, weil das runde Glas nicht ursächlich aus dem Prozess der Formung der Glasmasse hervorgeht, sondern von einer Kugel abgesprengt wird. Das Tellerglas ist seit der Barockzeit in Sachsen bekannt und gebräuchlich bis etwa 1730."@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0,
    :conceptScheme_b41bd73a;
  skos:prefLabel "Tellerglas"@de;
  skos:broader :c_39738fa5;
  dct:created "2019-06-13T16:04:16.000"^^xsd:dateTime;
  dct:modified "2019-06-17T15:23:13.000"^^xsd:dateTime .

:c_2b98b873 a skos:Concept;
  skos:definition "Zweidimensionales Glas, Fensterglas. Es wird in den Glashütten neben dem Hohlglas (Trinkbecher, Flaschen, Gebrauchsgläser usw.) hergestellt. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Flachglas"@de;
  skos:broader :c_39738fa5;
  dct:created "2019-06-17T11:46:09.000"^^xsd:dateTime;
  dct:modified "2019-06-17T11:54:13.000"^^xsd:dateTime .

:c_3cf635a2 a skos:Concept;
  skos:definition "Aus einzelnen Glasscheiben, Glastafeln, aus zugeschnittenen kleinen Glasformaten (Raute, Viereck, Sechseck) oder Tellerglas zusammengesetzte Glasfläche, die durch das Fensterblei oder die Holzsprossen zusammengehalten und in Flügel- oder Fensterrahmen eingesetzt wird. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Glasfeld"@de;
  skos:broader :c_39738fa5;
  dct:created "2019-06-17T15:37:53.000"^^xsd:dateTime;
  dct:modified "2019-06-17T15:39:20.000"^^xsd:dateTime .

:c_6c4e380a a skos:Concept;
  skos:definition "Technologisch bedingtes, kreisförmiges Flachglas. Butzen und unzerteiltes Mondglas treten in Scheibenform aus der Herstellung hervor. Heute ist der Begriff Scheibe für Fensterglas weithin gebräuchlich, was letztendlich auf die große Verbreitung der Butzenscheibe bis zum Barock zurückzuführen ist. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Glasscheibe"@de;
  skos:altLabel "Scheibe"@de;
  skos:broader :c_39738fa5;
  dct:created "2019-06-17T15:42:59.000"^^xsd:dateTime;
  dct:modified "2019-06-17T15:45:12.000"^^xsd:dateTime .

:c_85db31a1 a skos:Concept;
  skos:definition "Am Ende des Herstellungsprozesses tritt das Glas im Gegensatz zur Glasscheibe als Tafel aus und kann für die notwendigen Formate zugeschnitten werden, Flachglas. Die älteste Technologie ist das Gussglas. Zum Tafelglas gehören weiterhin Zylinderglas und Tellerglas. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Tafelglas"@de;
  skos:altLabel "Glastafel"@de;
  skos:broader :c_39738fa5;
  dct:created "2019-06-17T15:46:22.000"^^xsd:dateTime;
  dct:modified "2019-06-17T15:50:51.000"^^xsd:dateTime .

:c_6db938d1 a skos:Concept;
  skos:definition "Plastische Masse zum Abdichten des mit Drahtstiften im Kittfalz des Fenster- oder Flügelrahmens befestigten Fensterglases. Seit der ersten Hälfte des 18. Jh. wird er aus Kreide und Leinölfirnis, teilweise unter Beigabe von Bleiweiß hergestellt. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0,
    :conceptScheme_b41bd73a;
  skos:prefLabel "Kitt"@de;
  skos:broader :c_39738fa5;
  dct:created "2019-06-18T07:11:04.000"^^xsd:dateTime;
  dct:modified "2019-06-18T07:13:31.000"^^xsd:dateTime .

:c_0c16593b a skos:Concept;
  skos:definition "Gussglas mit ein oder beidseitiger Oberflächenprägung (durchscheinend bis Durchsicht sperrend). Ornamentglas ist oft farbig. Wegen seiner verzierten Oberfläche wirkt es sehr dekorativ. Besondere Ornamentgläser sind zum Beispiel Kathedralglas, Drahtornamentglas oder Antikglas. [Pax - Fenster & Türen Fachbegriffe]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0;
  skos:prefLabel "Ornamentglas"@de;
  skos:broader :c_39738fa5;
  skos:narrower :c_559aa52a;
  dct:created "2019-06-18T08:16:35.000"^^xsd:dateTime;
  dct:modified "2019-06-18T08:17:08.000"^^xsd:dateTime .

:c_a3280435 a skos:Concept;
  skos:definition "Art der Verglasung. Um ein rundes Glas in der Mitte eines rechteckigen Glasfeldes (i. d. R. eine Butze, aber auch runde Gläser aus Mond- oder Zylinderglas ausgeschnitten) gruppieren sich vier Glasviertel, die zum runden Glas entsprechend ausgeschnitten sind. Die einzelnen Gläser sind mit Bleiruten verbunden. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Quartierscheiben"@de;
  skos:broader :c_39738fa5;
  dct:created "2019-06-18T08:27:10.000"^^xsd:dateTime;
  dct:modified "2019-06-18T08:28:21.000"^^xsd:dateTime .

:c_f74db145 a skos:Concept;
  skos:definition "Aus einem Tafelglas herausgeschnittenes, kreisförmiges Glas. Das Tellerglas kann aufgrund seiner Herstellung als Rundglas bezeichnet werden. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Rundglas"@de;
  skos:broader :c_39738fa5;
  dct:created "2019-06-18T09:05:32.000"^^xsd:dateTime;
  dct:modified "2019-06-18T09:06:22.000"^^xsd:dateTime .

:c_72362dd4 a skos:Concept;
  skos:definition "Glasklarer Kunststoff aus Polyacrylharzen, also thermoplastischen Kunststoffen, die ein optisch hochwertiges, in der Wärme biegsames und vielseitiges Produkt ergeben. Als Grundlage des Kunstharzes dienen Kohle und Kalk. Das Plexiglas ist klar wie Glas, aber leicht zu bearbeiten, mechanisch fester, biegsam und nicht spröde und besitzt eine hohe Widerstandsfähigkeit gegen chemische Einflüsse. [Schrader / Voigt 2003]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_5bf6bcac;
  skos:prefLabel "Acrylglas"@de;
  skos:altLabel "Plexiglas"@de;
  skos:broader :c_39738fa5;
  dct:created "2020-01-17T15:35:01.000"^^xsd:dateTime;
  dct:modified "2020-01-17T15:37:35.000"^^xsd:dateTime .

:c_fe836405 a skos:Concept;
  skos:definition "Komplett oder teilweise matte Glasoberfläche, die durch Ätzen mit Fluorverbindungen erzielt wird. Für dekoratives Ätzglas wird die Oberfläche zunächst mit einer säurefesten, leicht abschabbaren schützenden Schicht, wie z.B. Bienenwachs, bekleidet, in die Figuren und Ornamente eingeritzt werden. Danach setzt man den Glaskörperder Einwirkung von Säure aus. Ton-in-Ton Ätzungen können mit verschiedenen Ätzsalzen in mehreren Arbeitsgängen erreicht werden. [Schrader / Voigt 2003]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_5bf6bcac;
  skos:prefLabel "Ätzglas"@de;
  skos:broader :c_39738fa5;
  dct:created "2020-01-17T16:17:32.000"^^xsd:dateTime;
  dct:modified "2020-09-15T15:31:51.000"^^xsd:dateTime .

:c_dc1aaa33 a skos:Concept;
  skos:definition "Durch Zerspaltung von tafelförmigem Gips entstandenes perlmuttglänzendes und durchscheinendes Material, das vor der Erfindung von Glas häufig als Fensterverschluss, ähnlich wie Glimmer oder Pergament, eingesetzt wurde. [Schrader / Voigt 2003]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_5bf6bcac;
  skos:prefLabel "Alabaster"@de, "yeso cristalino"@es, "mica"@it, " gypse cristallin"@fr,
    "mica"@en;
  skos:altLabel "Marienglas"@de, "Jungfernglas"@de, " mica"@es, "espejuelo"@es, "selenite"@it,
    " gypse en fer de lance"@fr, "selenite"@en;
  skos:broader :c_39738fa5, :c_65fe071d;
  skos:narrower :c_9549f7aa;
  dct:created "2020-01-17T16:43:10.000"^^xsd:dateTime;
  dct:modified "2020-12-02T08:14:08.000"^^xsd:dateTime .

:c_65fe071d a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ef0a8695;
  skos:prefLabel "Mineral"@de;
  skos:broader :c_f841829c;
  skos:narrower :c_dc1aaa33, :c_c28d15ee, :c_d2b6d03c, :c_df203efb, :c_6b793f46, :c_69b00eaa,
    :c_b6prqhi5, :c_59aaa1b6;
  dct:created "2020-01-17T16:55:40.000"^^xsd:dateTime;
  dct:modified "2025-11-04T22:39:10"^^xsd:dateTime .

:c_66b5641d a skos:Concept;
  skos:definition "Betonglas besteht aus dicken, durchgefärbten Glasstücken, die nicht mit Blei gefasst, sondern deren Zwischenräume mit Beton oder Kunststoff ausgegossen werden. 20. Jh. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_8c0441f9;
  skos:prefLabel "Betonglas"@de;
  skos:broader :c_39738fa5;
  dct:created "2020-08-14T09:34:36.000"^^xsd:dateTime;
  dct:modified "2020-08-14T09:34:51.000"^^xsd:dateTime .

:c_bd51d5d0 a skos:Concept;
  skos:definition "Flacher, häufig mit einem Zierprofil abschließender Holzrahmen auf der inneren oder äußeren Wandfläche, der die Fensteröffnung einfasst und gleichzeitig die Fuge zwischen Wand und Fenster- oder Futterrahmen abdeckt. [Noky 1996]"@de,
    "Bekleidung, 2. Holzverschalung der Laibungen von Türen, Fenstern u. dergl. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_c7b144d0, :conceptScheme_b41bd73a;
  skos:prefLabel "Bekleidung (Fenster)"@de;
  skos:broader :c_537f5b30;
  dct:created "2019-05-22T19:13:11.000"^^xsd:dateTime;
  dct:modified "2020-09-04T14:10:10.000"^^xsd:dateTime .

:c_64444f2c a skos:Concept;
  skos:definition "Kurze Bleistreifen zur Befestigung der Glasfelder an den Windeisen, die an die Bleiruten oder Bleisprossen angelötet werden. [Noky 1996]"@de,
    "Kleine Bleistücke, die zur Befestigung kleinerer Glasfelder an den Windeisen auf die Bleisprossen angelötet werden (haften). [Pax - Fenster & Türen Fachbegriffe]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0,
    :conceptScheme_b41bd73a;
  skos:prefLabel "Bleihafte"@de, "olověný úchyt"@cs;
  skos:broader :c_d944cc16;
  dct:created "2019-05-22T19:14:17.000"^^xsd:dateTime;
  dct:modified "2020-08-11T22:53:15.000"^^xsd:dateTime .

:c_813ed136 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028;
  skos:prefLabel "Photogrammetrie"@de, "fotogrammetrie"@cs;
  skos:altLabel "Bildmessung"@de;
  skos:broader :c_d44c63bd;
  dct:created "2020-08-24T15:21:41.000"^^xsd:dateTime;
  dct:modified "2021-03-19T14:30:57.000"^^xsd:dateTime .

:c_4da5b007 a skos:Concept;
  skos:definition "Fensterrahmen-Typ in Holz- und Steinbauten, bei dem die Schenkel und die Innenkonstruktion einen den Leisten der Flügelrahmen nahezu gleichen querrechteckigen Querschnitt haben. Es ist ein leichter Fensterrahmen, der mit dem Gefüge der Wand konstruktiv nicht verbunden ist. In Sachsen ist der Blendrahmen die bisher einzige nachweisbare Form des Fensterrahmens, sie kann bis ins 16. Jh. zurückverfolgt werden. [Noky 1996]"@de,
    "Blendrahmen, fest mit der Mauer verbundener Holzrahmen, an dem bei Türen und Fenstern die Flügel mit Beschlägen befestigt sind. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_c7b144d0, :conceptScheme_b41bd73a;
  skos:prefLabel "Blendrahmen (Fenster)"@de;
  skos:broader :c_537f5b30;
  dct:created "2019-05-23T08:00:05.000"^^xsd:dateTime;
  dct:modified "2020-09-29T14:58:56.000"^^xsd:dateTime .

:c_884f9a03 a skos:Concept;
  skos:definition "Fenstertyp (im Fachwerkbau), bei dem alle Hölzer einschließlich Pfosten und Kämpfer das gleiche Tiefenmaß besitzen, wobei diese Tiefe dem Maß der anliegenden Fachwerkwand entspricht. [Pax - Fenster & Türen Fachbegriffe]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0;
  skos:prefLabel "Blockrahmen (Fenster)"@de;
  skos:broader :c_537f5b30;
  dct:created "2019-05-23T08:01:00.000"^^xsd:dateTime;
  dct:modified "2020-09-29T14:58:40.000"^^xsd:dateTime .

:c_7e0fd312 a skos:Concept;
  skos:definition "Variante von einem Fensterrahmen und Türrahmen. Entwicklungsgeschichtlich eine Zwischenform zwischen Blockrahmen und Zargenrahmen, der sich vom konstruktiven Fachwerkgerüst getrennt hat und bei dem die einzelnen Hölzer differenzierte Querschnitte bekommen. Die Blockzarge wird in die lichte Maueröffnung gesetzt und sie ist tiefer als breit, im Gegensatz zum Blendrahmen, der breiter als tief ist. Vorteile sind beim Fenster geringerer Holzverbrauch und größere Lichtausbeute. [Schrader / Voigt 2003] "@de,
    "Fenstertyp  (im Fachwerkbau), bei dem die Rahmenhölzer das gleiche Tiefenmaß der anliegenden Fachwerkwand haben, jedoch Pfosten und Kämpfer deutlich zierlicher sein können. [Pax - Fenster & Türen Fachbegriffe]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_5bf6bcac,
    :conceptScheme_c7b144d0;
  skos:prefLabel "  Blockzargenrahmen (Fenster)"@de;
  skos:broader :c_537f5b30;
  dct:created "2019-05-23T08:02:16.000"^^xsd:dateTime;
  dct:modified "2020-09-29T15:00:48.000"^^xsd:dateTime .

:c_6836c935 a skos:Concept;
  skos:definition "Die in einer Öffnung angebrachte innere Verkleidung, bes. als hölzerner Futterrahmen bei Türen und Fenstern. [Koepf / Binding 2016]"@de,
    "Futter- (Futterrahmen) Rahmen aus Holzbrettern, die in die Laibung gesetzt werden. Häufig in Zusammenhang mit einem Blendrahmen- oder Kastenfenster zu finden. [Pax - Fenster & Türen Fachbegriffe]"@de,
    "Rahmen aus brettstarken Schenkeln, der die Fensteröffnung in einer Fachwerk- oder Blockwand i. d. R. von innen auskleidet. [Noky 1996] "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_c7b144d0, :conceptScheme_b41bd73a;
  skos:prefLabel "Futter"@de;
  skos:altLabel "Futterrahmen"@de;
  skos:broader :c_537f5b30;
  dct:created "2019-05-23T08:42:54.000"^^xsd:dateTime;
  dct:modified "2020-09-29T11:12:03.000"^^xsd:dateTime .

:c_6a2b5c14 a skos:Concept;
  skos:definition "Aus den Höhenschenkeln, einem Ober- und Unterschenkel und ggf. der Innenkonstruktion gebildeter Rahmen, der mit einem lichtdurchlässigen Material geschlossen ist. Die Schenkel sind als Leisten ausgeführt. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Flügelrahmen"@de;
  skos:altLabel "Leistenrahmen"@de;
  skos:broader :c_537f5b30;
  dct:created "2019-06-17T13:46:54.000"^^xsd:dateTime;
  dct:modified "2019-06-17T13:50:27.000"^^xsd:dateTime .

:c_8374abb2 a skos:Concept;
  skos:definition "Rahmenartige, hölzerne Einfassung von Türen und Fenstern (Zargenfenster) aus Bohlen oder Vierkantholz; die Z. ist bündig mit der äußeren Mauerflucht versetzt und wird beim Aufführen des Mauerwerks mit eingemauert. [Koepf / Binding 2016]"@de,
    "Eine Tür- oder Fensterumrahmung, die eine Breite aufweist, die der Dicke der umgebenden Mauer entspricht. Zargen aus Holz verfügen auf der Rückseite häufig über zwei Nuten zur Aufnahme von Putzabschlußprofilen. [Pax - Fenster & Türen Fachbegriffe]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0;
  skos:prefLabel "zárubeň"@cs, "telaio fisso"@it, "surround (of doors, windows)"@en,
    "cerco de una ventana"@es, "Zarge"@de, "dormant (d\\'attente)"@fr;
  skos:altLabel "prédormant"@fr, "marco de una ventana"@es;
  skos:broader :c_537f5b30;
  dct:created "2019-10-15T11:55:31.000"^^xsd:dateTime;
  dct:modified "2020-12-01T13:33:18.000"^^xsd:dateTime .

:c_ca4da84f a skos:Concept;
  skos:definition "Fest mit dem Mauerwerk verbundener Rahmen eines Fensters. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Fensterstock"@de;
  skos:broader :c_537f5b30;
  dct:created "2020-09-25T09:05:33.000"^^xsd:dateTime;
  dct:modified "2020-09-25T09:06:25.000"^^xsd:dateTime .

:c_c88c91c7 a skos:Concept;
  skos:definition "Eine Fensterkonstruktion in einem Holzgerüst, dessen äußere Rahmenhölzer bohlenstark sind und fast die gesamte Laibung bedecken, während Pfosten und Querholz eine deutlich geringere Tiefe aufweisen und nur auf der Außenseite bündig mit der Wand liegen, so dass die Lichtausbeute besonders gut ist. Anders als der Blockrahmen ist der Blockzargenrahmen nicht mehr Teil des konstruktiven Gefüges, sondern ein separat gefertigtes Bauteil, das nachträglich stumpf in die Öffnung eingestellt werden kann. [Pax - Fenster & Türen Fachbegriffe]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0;
  skos:prefLabel "Blockzargenrahmenfenster"@de;
  skos:broader :c_f88a153a;
  dct:created "2019-05-23T08:04:01.000"^^xsd:dateTime;
  dct:modified "2020-02-18T08:41:15.000"^^xsd:dateTime;
  :broaderByConstruction :c_f88a153a .

:c_7d464cc4 a skos:Concept;
  skos:definition "Großflächiges, speziell konstruiertes Erker- oder Kastenfenster, das in den 1920er Jahren entwickelt wurde. Es konnte auch Glasbausteine an der Decke, einen schrägen Boden mit Wasserbecken und Wasserzulauf, Lüftungsflügel, ein Lamellenstore als Sonnenschutz sowie als Abgrenzung zum Wohnraum ein Schiebefester aufweisen. In Wohn- und Siedlungsbauten waren z.B. die Blumenfenster von Auefeld und Helleböhn berühmt. [Pax - Fenster & Türen Fachbegriffe]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0;
  skos:prefLabel "Blumenfenster"@de;
  skos:broader :c_f88a153a;
  dct:created "2019-05-23T08:05:26.000"^^xsd:dateTime;
