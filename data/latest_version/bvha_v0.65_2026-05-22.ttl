  skos:related :c_043fca8d, :c_6dd959ea, :c_xh1ezgu0;
  dct:created "2020-08-06T20:08:53.000"^^xsd:dateTime;
  dct:modified "2021-01-24T14:58:56.000"^^xsd:dateTime .

:c_f4a35dd8 a skos:Concept;
  skos:definition "Sakramentskapelle, Kapellenanbau, in der das Sakrament (Hostie, Kelch usw.) aufbewahrt wird, stiller Andachtsraum, zumeist in einer Seitenkapelle auf der Nordseite großer, vielbesuchter Kirchen. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
