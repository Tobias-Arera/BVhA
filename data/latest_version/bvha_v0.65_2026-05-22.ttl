:c_631c0ecd a skos:Concept;
  skos:definition "Insula (lat. Insel), 1. Häuserblock des Hippodamischen Systems. 2. römisch-antiker Miethausblock. [Koch 2009]"@de,
    "Lat. ostrov. 1. blok domů v Hippodamově systému, 2. blok římských antických nájemných domů. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c8a571d9,
