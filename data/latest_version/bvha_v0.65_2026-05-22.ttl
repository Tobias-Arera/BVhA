:c_e5ddbd29 a skos:Concept;
  skos:definition "Stab, Rundstab, Viertelstab u. dergl. als Element von Gesimsen, Friesen, an Säulenbasen: Torus (att. Basis). [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_19d56a39;
  skos:prefLabel "prut"@cs, "toro"@es, "Wulst"@de;
  skos:altLabel "vyvýšenina "@cs, "vyboulení"@cs, "naválka"@cs, "podvalek"@cs;
