:c_5aaf5447 a skos:Concept;
  skos:definition "Un assombrissement du à l’humidité est considérée comme une altération chromatique (baisse de saturation). [ICOMOS-ISCS]"@fr,
    "Corresponds to the darkening (lower hue) of asurface due to dampness. [ICOMOS-ISCS]"@en,
    "Feuchtebereich bezieht sich auf die Dunklung (geringere Farbhelligkeit) der Oberfläche durch Feuchtigkeit. [ICOMOS-ISCS] "@de,
    "Koresponduje se ztmavnutím (nižší barevnýodstín) povrchu v důsledku zvlhnutí. [ICOMOS-ISCS] "@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_315cf028,
    :conceptScheme_34ca6582;
  skos:prefLabel "assombrissement du à l’humidité"@fr, "moist area"@en, "Feuchtebereich"@de,
    "vlhká oblast"@cs;
  skos:altLabel "tache d’humidité"@fr, "zone humide visible"@fr, "moist spot"@en, "moist zone"@en,
    "visible damp area"@en, "sichtbare Durchfeuchtung"@de, "Feuchtezone"@de, "vlhké zóny"@de,
    "oblasti s viditelnou vlhkostí"@cs;
  skos:broader :c_c64fa4ae;
  dct:created "2019-11-07T12:55:34.000"^^xsd:dateTime;
  dct:modified "2021-03-19T20:00:14.000"^^xsd:dateTime .

:c_acd8564c a skos:Concept;
