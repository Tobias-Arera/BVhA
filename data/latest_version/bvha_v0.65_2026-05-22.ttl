  dct:modified "2020-09-01T13:57:10.000"^^xsd:dateTime .

:c_bae4cd11 a skos:Concept;
  skos:definition "Abschlag, 1. Wasserablaufvorrichtung an Mauervorsprüngen oder Fensterflügeln, Kaffgesims, Wasserschlag. 2. Kleiner Wassergraben oder Kanal als Ablass zur Haus- und Straßenentwässerung. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Abschlag"@de;
  skos:broader :c_b99ef53b;
