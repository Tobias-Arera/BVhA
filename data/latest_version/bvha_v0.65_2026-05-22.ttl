:c_ec46f19a a skos:Concept;
  skos:definition "Ein Altar in Tischform, dessen Platte (Mensa) von Stützen (meist Säulchen) getragen wird. [Koepf / Binding 2016]"@de,
    "Stolní oltář z desky a opěr. [Koch 2008]"@cs, "Der Tischaltar ist ein aus Platte und einer, zwei oder mehreren Stützen bestehendes tischförmiges Gebilde. [RDK Labor]"@de,
    "Tischaltar aus Platte und Stützen. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9, :conceptScheme_cf792a3c;
  skos:prefLabel "altare a mensa"@it, "Tischaltar"@de, "altar con forma de mesa"@es,
    "stolní oltář"@cs;
  skos:broader :c_wyccl4ls;
  dct:created "2020-01-16T15:35:20.000"^^xsd:dateTime;
  dct:modified "2021-01-30T23:55:33.000"^^xsd:dateTime;
  :broaderByShape :c_wyccl4ls .

:c_c1fe8cfc a skos:Concept;
  skos:definition "Blockaltar mit blockartigem Stipes und vorgekragter Mensa. [Koch 2009]"@de,
    "Blokový oltář s podstavcem v podobě bloku a předsunutou mensou. [Koch 2008]"@cs,
    "Der Blockaltar ist ein Altar, dessen Stipes entweder ein Massiv ist oder doch, wenn er aus Platten besteht, weil ringsum gegeschlossen, als Massiv erscheint, an Breite und Tiefe aber den Maßverhältnissen der Mensa fast gleichkommt. [RDK Labor]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9, :conceptScheme_cf792a3c;
  skos:prefLabel "Blockaltar"@de, "blokový oltář"@cs;
  skos:broader :c_wyccl4ls;
  dct:created "2020-01-16T15:35:27.000"^^xsd:dateTime;
  dct:modified "2021-01-30T23:53:29.000"^^xsd:dateTime;
  :broaderByShape :c_wyccl4ls .

:c_6488b329 a skos:Concept;
  skos:definition "Kastenaltar mit großem Reliquiengrab im Innern des Stipes. [Koch 2009]"@de,
    "Der Kastenaltar ist ein Altar mit großem Hohlraum im Innern des Stipes, der durch eine Türe oder sonst eine Öffnung von außen zugänglich ist. [RDK Labor]. "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
