:c_5f54f3c5 a skos:Concept;
  skos:definition "»estilo Isabel«, üppiger spätgotischer Ornamentstil Spaniens, dessen Formen von textilen Spitzen abgeleitet scheinen. 1480-1510. [Koch 2009]"@de,
    "Pozdně gotický bohatě ornamentální španělský styl, jehož tvary jako by vycházely z textilních krajek (1480-1510). [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9;
  skos:prefLabel "Isabell-Stil"@de, "isabelský styl"@cs;
  skos:altLabel "Estilo Isabel"@de, "estilo isabel"@cs;
  skos:broader :c_7c4af9bc;
  skos:related :c_28ae80a9, :c_e4d34c2a, :c_depjwldn;
  dct:created "2020-08-04T13:47:25.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:29:26.000"^^xsd:dateTime .

:c_e4d34c2a a skos:Concept;
  skos:definition "Vereinigung des Platero-Stils und des Isabell-Stils in der spanischen Spätgotik, bei der die Flächen mit üppigstem, spitzenartigem plastischen Schmuck bedeckt werden. [Koch 2009]"@de,
    "Spojení platereskního a isabelského stylu ve španělské pozdní gotice, kdy jsou plochy pokrývány hojnou plastickou krajkovitou výzdobou. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9;
  skos:prefLabel "Gotico florido"@de, "gótico florido"@cs;
  skos:broader :c_7c4af9bc, :c_fdaefa78, :c_7698a523;
  skos:related :c_5f54f3c5, :c_899721a9;
  dct:created "2020-08-05T12:06:23.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:19:49.000"^^xsd:dateTime .

