  skos:broader :c_1f0a3ce6;
  skos:related :c_609bdceb, :c_39b2b180, :c_gfbmrhsx;
  dct:created "2020-06-10T11:32:41.000"^^xsd:dateTime;
  dct:modified "2021-01-18T17:48:26.000"^^xsd:dateTime .

:c_609bdceb a skos:Concept;
  skos:definition "Ein Geistlicher oder ein Laie, der einem hohen Würdenträger bei einem feierlichen Auftritt die Schleppe seines Gewandes trägt. [Glossarium Artis] "@de;
