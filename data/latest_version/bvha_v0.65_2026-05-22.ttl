:c_c7d07adf a skos:Concept;
  skos:definition "Bauopfer, im Altertum häufig, im MA noch vereinzelt geübter Brauch, beim Bau eines Hauses, eines Damms, einer Brücke usw. in das Fundament oder unter der Schwelle ein Tier oder auch Gegenstände einzumauern, um Dämonen, Naturgottheiten oder Hausgeister gnädig zu stimmen bzw. Unheil von dem Bau abzuwenden. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_84fc24e6;
  skos:prefLabel "Bauopfer"@de;
  skos:broader :c_5856a552;
  dct:created "2020-08-25T13:11:00.000"^^xsd:dateTime;
  dct:modified "2021-01-15T17:20:01.000"^^xsd:dateTime .

:c_4c33a164 a skos:Concept;
  skos:definition "Bauabschnitt, der innerhalb zeitl. (Bauperiode) oder räuml. Grenzen fertiggestellte Teil eines Baus. Bei großen Bauvorhaben, die eine lange Bauzeit erfordern, können von vornherein bestimmte B.e eingeplant sein (Baulos), um das fristgerechte Fortschreiten der Bauarbeiten kontrollieren zu können oder aus wirtschaftl. und anderen Gründen. Die an ma. Kathedralen erkennbaren B.e (Baunaht) sind jedoch häufig durch unfreiwillige Unterbrechungen der Bauarbeiten, wie wirtschaftl. Schwierigkeiten, Einsturzkatastrophen, Kriege, Brände u.a., entstanden. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Bauabschnitt"@de;
  skos:broader :c_8c8249bf;
  dct:created "2020-08-25T13:30:22.000"^^xsd:dateTime;
  dct:modified "2021-01-13T11:04:32.000"^^xsd:dateTime .

