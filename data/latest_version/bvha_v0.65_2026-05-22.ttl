:c_c8c9a68f a skos:Concept;
  skos:definition "lkonostasis (griech. Standplatz des Bildes), in orthodoxen Kirchen die mit Ikonen geschmückte Schranke zwischen Chor und Gemeinderaum. [Koch 2009]"@de,
    "Řec. umístění obrazu. Přepážka zdobená ikonami v pravoslavných kostelích mezi chórem a prostorem pro věřící. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
