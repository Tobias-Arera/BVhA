:c_21b78509 a skos:Concept;
  skos:definition "Brunnenhaus, rundes oder polygonales Gebäude über einem Brunnen, bes. an Kreuzgängen in roman. und got. Klöstern. [Koepf / Binding 2016]"@de,
    "Tonsur (lat. Schur), Brunnenkapelle, oft an der Westseite des Kreuzgangs eines Klosters, gegenüber dem Refektorium. Hier wurde bei der Klerikerweihe die »Tonsur« vorgenommen, d.h. Haupt- und Barthaar geschoren. [Koch 2009]"@de,
    "Krytá studna v podobě kaple: často na západní straně křížové chodby kláštera, proti refektáři; při vysvěcovaní klenku zde byla prováděna „tonsura\" (odtud název v řa­dě jazyků), tj. ostříhány vlasy a vousy. [Koch 2008]"@cs,
    "Bezeichnung für das Brunnenhaus an Klosterkreuzgängen, das den Mönchen als Waschraum und zum Rasieren sowie zum Schneiden (tonsura) der Haare diente. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_37522b74;
  skos:prefLabel "Brunnenkapelle"@de, "tonsura"@es, "tonsura"@it, "klášterní studna"@cs,
    "fountain house"@en;
  skos:altLabel "tonsure"@fr, "lavabo"@en, "Tonsur (Brunnenkapelle)"@de, "cuarto de aseo"@es,
    "lavabo"@es, "Brunnenhaus (Kapelle)"@de;
  skos:broader :c_b5206255;
  skos:related :c_83e770d8;
  dct:created "2019-09-19T12:55:50.000"^^xsd:dateTime;
  dct:modified "2020-08-31T16:03:18.000"^^xsd:dateTime .

:c_2e374f89 a skos:Concept;
  skos:definition "Kreuzgang (Ambitus), um den Rechteckhof einer Klausur angelegter, flach gedeckter oder gewölbter Gang, in dem Prozessionen mit einem Kreuz abgehalten wurden. Der K. bildet mit der Kirche das Kernstück eines Klosters. [Koepf / Binding 2016]"@de;
  skos:scopeNote "Ein viereckiger, offener Hof. In Anlehnung an das  Peristyl des hellenistischen Wohnhauses. Der Name Kreuzgang stammt von der um den Hof führendenKreuzprozession. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_8c0441f9;
  skos:prefLabel "Kreuzgang"@de, "chiostro"@it, "křížová chodba"@cs, "cloister"@en,
    "ambitus"@la, "claustro"@es, "claustre"@ca, "cloître, clôture"@fr;
  skos:broader :c_b54dd069;
  skos:related :c_83e770d8, :c_a07e515f;
  dct:created "2019-09-19T13:00:29.000"^^xsd:dateTime;
  dct:modified "2021-01-27T15:33:30.000"^^xsd:dateTime;
  :broaderByFunction :c_b54dd069 .

:c_792e6b1d a skos:Concept;
  skos:definition "Stift, mit Grundbesitz und eigenem Rechtsstatus ausgestattete Klerikergemeinschaft (Kanoniker, Kanonissen) an einer Domkirche (Doms.) oder einer nicht klösterl. Kirche (Kollegiats.). Baul. Gestaltung ähnl. dem Kloster, seit dem 12. Jh. wohnen die Mitglieder in eigenen, am Rand der Stiftsimmunität gelegenen Häusern (Kanonikerhäuser). InÖsterreich auch Bezeichnung für Klöster anderer Orden. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "Stift"@de, "convent"@en, "kolík"@cs, "fondation"@fr, "cabildo eclesiástico"@es,
    "sticht"@nl, "operapia"@it;
  skos:altLabel "kolíček"@cs, "capítulo de una orden"@es, "fondazione"@it;
  skos:broader :c_0c109f15;
  skos:narrower :c_d7c4c202, :c_d6953a56;
  skos:related :c_83e770d8, :c_0e7ca4ab, :c_71c1feaf;
  dct:created "2020-02-26T17:29:59.000"^^xsd:dateTime;
  dct:modified "2021-01-26T15:45:41.000"^^xsd:dateTime .

:c_abc0fd85 a skos:Concept;
  skos:definition "Abt m; lat. abbas; pater monasterii: Vorsteher einer klösterlichen Gemeinschaft. Ein infulierter Abt m ist berechtigt, die Mitra zu tragen. Seine Rangfarbe ist Schwarz bzw. Violett. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "Abt"@de, "abbot"@en, "abbé"@fr, "abbas"@la;
  skos:altLabel "pater monasterii"@la, "Père"@fr;
  skos:broader :c_3575f5f6, :c_146492b6;
  skos:narrower :c_952d41bc, :c_02f9a560;
  skos:related :c_83e770d8, :c_f71f8ec8, :c_71190f5c, :c_df25fc3a, :c_7674b8b2, :c_f7633ccf,
    :c_db732d1e;
  dct:created "2020-06-05T16:31:43.000"^^xsd:dateTime;
  dct:modified "2021-01-15T15:02:44.000"^^xsd:dateTime .

:c_9a164150 a skos:Concept;
  skos:definition "Kirche eines Kollegiums, einer Klerikergemeinschaft, die sich auf wenigen Stiftspfründen neben der Seelsorge bes. der Ausbildung des Klerikernachwuchses widmete. [Koepf / Binding 2016]"@de,
    "Kostel duchovní instituce, jejíž příslušníci jsou světští duchovní (nikoliv řeholníci) a společně tvoří kolegiátní kapitulu. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_37522b74;
  skos:prefLabel "kolegiátní kostel"@cs, "Kollegiatkirche"@de;
  skos:altLabel "Kollegienkirche"@de;
  skos:broader :c_0ea453f7;
  skos:related :c_0e7ca4ab;
  dct:created "2019-05-28T14:48:15.000"^^xsd:dateTime;
  dct:modified "2021-01-19T15:08:21.000"^^xsd:dateTime;
  :broaderByFunction :c_0ea453f7 .

:c_f10a307c a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_19d56a39;
