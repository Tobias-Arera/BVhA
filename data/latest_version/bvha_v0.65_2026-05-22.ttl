:c_d784f43e a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ec8c77bf;
  skos:prefLabel "Umweltprüfung"@de, "valutazione ambientale"@it, "Оценка на околната среда"@bg,
    "environmental assessment"@en, "környezet vizsgálat"@hu, "évaluation des conditions environne mentales"@fr,
    "procjena okoliša"@hr, "estudio medioambiental"@es, "çevresel değerlendirme"@tr, "evaluarea condițiilor de mediu"@ro,
    "ocena warunków środowiska"@pl;
  skos:altLabel "Umweltbewertung"@de, "Umweltgutachten"@de;
  skos:note "Estimation des conséquences de l’application d’un plan de conservation, d’un projet de restauration sur la conservation d’une peinture murale, basée sur l’étude préalable de l’environnement. (EwaGlos)"@fr,
    "A preliminary study of the environment which can help estimate the potential consequences of actioning a conservation plan, or a conservation or restoration project for a mural or architectural surface. (EwaGlos)"@en,
    "Eine Vorstudie zur Umwelt, mit der die Folgen eines Restaurierungskonzepts oder einer Konservierung/Restaurierung für eine Architekturoberfläche ausgewertet werden sollen. (EwaGlos)"@de;
  skos:broader :c_290c8d10;
  dct:created "2019-05-15T17:53:04.000"^^xsd:dateTime;
  dct:modified "2021-03-19T14:54:18.000"^^xsd:dateTime .

:c_ebbe9248 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ec8c77bf;
  skos:prefLabel "Raumklimauntersuchung"@de, "studio del clima interno"@it, "Анализ на климата в закрити помещения"@bg,
    "indoor climate study"@en, "béltéri klíma tanulmány"@hu, "étude climatique"@fr, "proučavanje klime u unutrašnjosti"@hr,
    "estudio climático de interiores"@es, "iç mekan iklim çalışması"@tr, "studiul climatului interior"@ro,
    "studium klimatu wnętrza"@pl;
  skos:altLabel "Innenklimauntersuchung"@de;
  skos:note "Étude du micro climat intérieur influençant la conservation des peintures murales. (EwaGlos)"@fr,
    "The study of the internal microclimate that can influence the conservation of wall paintings. (EwaGlos)"@en,
    "Untersuchung des internen Mikroklimas, das die Erhaltung von Wandmalereien beeinflussen kann. (EwaGlos)"@de;
  skos:broader :c_290c8d10;
  dct:created "2019-05-15T17:59:59.000"^^xsd:dateTime;
  dct:modified "2021-03-19T14:54:29.000"^^xsd:dateTime .

:c_b34d6a1e a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ec8c77bf;
  skos:prefLabel "Monitoring"@de, "monitoraggio"@it, "Мониторинг"@bg, "monitoring"@en,
    "monitorozás"@hu, "contrôles périodiques"@fr, "nadziranje"@hr, "monitorización"@es,
    "izleme"@tr, "monitorizare"@ro, "monitoring"@pl;
  skos:altLabel "gözlemleme"@tr, "Gebäudeüberwachung"@de;
  skos:note "Suivi, enregistrement et contrôle de tout signe visible de changement de la peinture murale, de son environnement, à même d’affecter la stabilité de l’oeuvre. (EwaGlos)"@fr,
    "Involves collecting data and checking for any visible signs of change that may affect wall paintings and their environment. (EwaGlos)"@en,
    "Die Datenerfassung und Überwachung von allen sichtbaren Anzeichen einer Veränderung, die eine Wandmalerei und deren Umgebung beeinflussen können. (EwaGlos)"@de;
  skos:broader :c_290c8d10;
  dct:created "2019-05-15T18:08:01.000"^^xsd:dateTime;
  dct:modified "2021-03-19T14:54:36.000"^^xsd:dateTime .

:c_be068deb a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ec8c77bf;
  skos:prefLabel "Umweltmanagement"@de, "gestione dell’ambiente"@it, "Управление на околната среда"@bg,
    "environmental management"@en, "környezet menedzsment"@hu, "gestion de l’environnement"@fr,
    "upravljanje okolišem"@hr, "gestión medioambiental"@es, "çevresel yönetim"@tr, "management de mediu"@ro,
    "zarządzanie warunkami środowiska"@pl;
  skos:note "Suivi des paramètres environnementaux afin de limiter l’impact de l’environnement sur la conservation des peintures murales et surfaces architectoniques. (EwaGlos)"@fr,
    "Monitoring various environmental parameters in order to limit the impact of the environment on the conservation conditions of wall paintings and architectural surfaces."@en,
    "Das Überwachen verschiedener Umweltparameter, um den Einfluss der Umwelt auf die Erhaltung der Wandmalereien und Architekturoberflächen einzugrenzen. (EwaGlos)"@de;
  skos:broader :c_290c8d10;
  dct:created "2019-05-20T11:19:40.000"^^xsd:dateTime;
  dct:modified "2021-03-19T14:54:23.000"^^xsd:dateTime .

:c_ac705510 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ec8c77bf;
  skos:prefLabel "Drainage"@de, "drenaggio"@it, "Дренаж"@bg, "drainage"@en, "vízelvezetés"@hu,
    "drainage"@fr, "drenaža"@hr, "drenaje"@es, "drenaj"@tr, "drenaj"@ro, "odpływy"@pl;
  skos:altLabel "tahliye kanalı"@tr, "drenaż"@pl, "odwadnianie"@pl, "dreny"@pl, "Dränage"@de,
    "Dränung"@de, "Entwässerung"@de;
  skos:note "Action d’évacuer artificiellement l’eau de ruissellement ou contenue dans les sols ou dans les structures, afin d’assécher un bâtiment et sa maçonnerie. (EwaGlos)"@fr,
    "The artificial evacuation of runoff water, water in the soil, or water that is in the structure in order to dry a building and its walls. (EwaGlos)"@en,
    "Der künstliche Abtransport von Regenwasser, Wasser im Boden oder im Bauwerk, um das Gebäude und seine Mauern zu trocknen. (EwaGlos)"@de;
  skos:broader :c_290c8d10;
  dct:created "2019-05-20T11:30:55.000"^^xsd:dateTime;
  dct:modified "2021-03-19T14:54:42.000"^^xsd:dateTime .

:c_e36b7fdb a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ec8c77bf;
  skos:prefLabel "Wartung und Pflege"@de, "manutenzione"@it, "Поддържане и текущи грижи"@bg,
    "maintenance and care"@en, "karbantartás és gondozás"@hu, "maintenance et suivi de conservation"@fr,
    "održavanje i skrb"@hr, "mantenimiento y cuidado"@es, "bakım ve koruma"@tr, "Întreținere și îngrijire"@ro,
    "opieka i pielęgnacja"@pl;
  skos:altLabel "mentenanță"@ro;
  skos:note "Toute action directe ou indirectebasée sur des actions de routine autre qu’un traitement ou toute autre intervention et qui a pour but de préserver une peinture murale. (EwaGlos)"@fr,
    "Any active or passive act, carried out on a routine basis that aims to preserve a wall painting, but not including direct treatment or other interventions. (EwaGlos)"@en,
    "Alle aktiven oder passiven Maßnahmen, die routinemäßig durchgeführt werden, um eine Wandmalerei zu erhalten, ohne direkte Behandlungen oder andere Eingriffe. (EwaGlos)"@de;
  skos:broader :c_290c8d10;
  dct:created "2019-05-20T11:39:39.000"^^xsd:dateTime;
  dct:modified "2021-03-19T14:54:11.000"^^xsd:dateTime .

