:c_f645ff87 a skos:Concept;
  skos:definition "Ein hölzerner, mit Lamellen versehener Fensterladen (Fensterblende), der zum Schutz vor Sonneneinstrahlung außen vor die Fensteröffnung geklappt wird. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "persienne"@fr, "sunshade"@en, "persiana"@it, "Sonnenladen"@de;
  skos:altLabel "sun blind"@en, "persiana"@es;
  skos:broader :c_fd1a5740;
  dct:created "2020-08-18T15:12:29.000"^^xsd:dateTime;
  dct:modified "2020-11-02T13:38:53.000"^^xsd:dateTime .

:c_01cc280b a skos:Concept;
  skos:definition "Vor die Fenster gehängte oder über den Fenstern auskragende, den direkten Sonneneinfall verhindernde Konstruktion, bes. beim modernen Büro- und Schulbau. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "brise-soleil"@fr, "sluneční clona"@cs, "sun-blind"@en, "parasole"@it,
    "quitasol"@es, "Sonnenblende"@de;
  skos:altLabel "paresoleil"@fr, "sombrilla"@es;
  skos:broader :c_fd1a5740;
  dct:created "2020-08-18T15:22:22.000"^^xsd:dateTime;
  dct:modified "2020-11-27T15:39:35.000"^^xsd:dateTime .

:c_a8fc75f7 a skos:Concept;
  skos:definition "Fensterladen mit türähnl., senkrecht in Angeln gefassten Flügeln, die außen oder innen gegen den Fensterrahmen oder in einen entsprechenden Falz schlagen, seit dem 12. Jh. nachgewiesen, zunächst nur nach innen zu klappen, als Außenläden selten, erst im 19. Jh. wird der äußere S. üblich. [Koepf /Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Schlagladen"@de, "postigo rebatido"@es, "imposte ribaltabili"@it,
    "judas"@fr, "hinged (window) shutter"@en;
  skos:altLabel "volet (pliant)"@fr;
  skos:broader :c_fd1a5740;
  dct:created "2020-08-20T12:25:24.000"^^xsd:dateTime;
  dct:modified "2020-10-25T20:36:39.000"^^xsd:dateTime .

:c_f65ceafa a skos:Concept;
  skos:definition "Schirmbrett, Schallladen; schräg gestellter Holzladen zum Abdecken der Schallöffnung an einem Glockenturm. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Schallladen"@de, "žaluzie v okně zvonice"@cs;
  skos:altLabel "Schalldach"@de, "Schirmbrett"@de, "stříška nad oknem zvonice"@cs;
  skos:broader :c_fd1a5740;
  dct:created "2020-08-21T09:56:30.000"^^xsd:dateTime;
  dct:modified "2020-11-27T07:22:31.000"^^xsd:dateTime .

:c_31376634 a skos:Concept;
  skos:definition "Eine ein- oder mehrflügelige Tür, die einen Linksflügel (DIN links) besitzt. [Schrader / Voigt 2003]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_5bf6bcac;
  skos:prefLabel "Linkstür"@de;
  skos:altLabel "Linksflügel"@de;
  skos:broader :c_0c67239c;
  dct:created "2020-06-22T14:24:19.000"^^xsd:dateTime;
  dct:modified "2021-01-22T18:54:40.000"^^xsd:dateTime;
  :broaderByConstruction :c_0c67239c .

:c_0edd9dd2 a skos:Concept;
  skos:definition "Rechtsflügel (DIN rechts), Rechtstür Richtungsbezeichnung für den Anschlag einer Tür im Gegensatz zum Linksflügel (DIN links). Als Linksflügel wird der Flügel bezeichnet, bei dem die Bänder von der Öffnungsfläche her gesehen rechts liegen. Nach der DIN gehört zu einer Rechtstür ein rechtes Einstemmschloss. [Schrader / Voigt 2003]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe;
  skos:prefLabel "Rechtstür"@de;
  skos:altLabel "Rechtsflügel"@de;
  skos:broader :c_0c67239c;
  dct:created "2020-06-22T14:24:37.000"^^xsd:dateTime;
  dct:modified "2021-01-22T18:59:06.000"^^xsd:dateTime;
  :broaderByConstruction :c_0c67239c .

