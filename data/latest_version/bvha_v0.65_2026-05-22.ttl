  skos:altLabel "fût"@fr, "pozzo"@it, "anima ( della scala a chiocciola)"@it, "spina ( della scala a chiocciola)"@it,
    "núcleo"@es, "vřeteno"@cs, "vřetenový sloup"@cs;
  skos:broader :c_59a72838;
  skos:narrower :c_555c5aa9;
  dct:created "2019-04-05T07:46:49.000"^^xsd:dateTime;
