:c_edb5b0ad a skos:Concept;
  skos:definition "Fronaltar (Altar des Herrn) vor oder in der Apsis. [Koch 2009]"@de,
    "Oltář Páně, před apsidou, nebo v apsidě. [Koch 2008]"@cs;
  skos:scopeNote "Direkt an der Ostwand bzw. am östlichen Abschluss stehender Altar, vor dem 2. Vatikanischen Konzil häufig Hauptaltar. "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
