:c_976d51e4 a skos:Concept;
  skos:definition "Liegende Rostkonstruktionen wurden ausgeführt bei Baugrund mit geringer Tragfähigkeit und erforderlichen großen Fundamentbreiten oder zur Vermeidung unterschiedlicher Setzungen bei ungleichem Baugrund oder zur Verteilung ungleicher Lasten. Die Roste fertigte man aus sich kreuzenden horizontalen Hölzern, die unter dem niedrigsten Wasserstand liegen mussten. Man bezeichnet sie auch als gestreckte, fliegende oder schwimmende Roste. Aus diese hölzerne Rostkonstruktion wurden dann die Grundmauern direkt aufgemauert. Man unterschied je nach verwendeten Hölzern Bohlen oder Schwellroste. [Bargmann]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_50ec0c5e, :conceptScheme_c8a571d9;
  skos:prefLabel "Rostgründung"@de;
  skos:broader :c_473bbc7d, :c_2b0f89a2;
  skos:narrower :c_975c2c9c, :c_68f4abf2;
  dct:created "2019-10-01T11:01:47.000"^^xsd:dateTime;
  dct:modified "2021-01-22T19:23:52.000"^^xsd:dateTime;
  :broaderByConstruction :c_473bbc7d, :c_2b0f89a2 .

:c_975c2c9c a skos:Concept;
  skos:definition "Ausführung bei größeren Gebäuden mit höheren Belastungen. [Bargmann]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_50ec0c5e, :conceptScheme_c8a571d9;
  skos:prefLabel "Schwellrostgründung"@de;
  skos:broader :c_976d51e4;
  dct:created "2019-10-01T11:02:05.000"^^xsd:dateTime;
  dct:modified "2021-01-22T19:24:03.000"^^xsd:dateTime .

:c_68f4abf2 a skos:Concept;
  skos:definition "Sie kamen zur Ausführung bei kleineren Gebäuden mit geringer Belastung. Als einfaches Balkenrost oder doppeltes Bohlenrost. [Bargmann]"@de,
    "Balkenrost, sich überkreuzende Balken als Unterlage für Fundamentmauern auf sumpfigem oder nicht ausreichend tragfähigem Boden; unter Luftabschluss haltbar. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_50ec0c5e, :conceptScheme_c8a571d9;
  skos:prefLabel "Bohlenrostgründung"@de;
  skos:altLabel "Balkenrostgründungen"@de;
  skos:broader :c_976d51e4;
  dct:created "2019-10-01T11:02:10.000"^^xsd:dateTime;
  dct:modified "2021-01-22T19:23:57.000"^^xsd:dateTime .

