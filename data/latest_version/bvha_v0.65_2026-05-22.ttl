  skos:altLabel "Kommunionteller"@de, "plateau de communion"@fr;
  skos:broader :c_c22ee248;
  dct:created "2020-08-07T08:53:41.000"^^xsd:dateTime;
  dct:modified "2021-01-24T15:04:19.000"^^xsd:dateTime .

