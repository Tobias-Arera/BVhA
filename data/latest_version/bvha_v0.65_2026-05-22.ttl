:c_303b2d58 a skos:Concept;
  skos:scopeNote "Doppelt gekerbtes Kreuz, Kreuz dessen Balkenenden mehr als zweifach spitz eingeschnitten sind. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_1f14b4dd;
  skos:prefLabel "endgezahntes Kreuz"@de;
  skos:broader :c_b421a34a;
  dct:created "2020-08-11T17:25:12.000"^^xsd:dateTime;
  dct:modified "2020-08-11T17:25:39.000"^^xsd:dateTime .

:c_ba4ccb7e a skos:Concept;
  skos:scopeNote "Kreuz mit geschweiften Enden, Form des Tatzenkreuzes. Ist die seitliche Begrenzung der Balken bogenförmig, spricht man präzis. von Kreuz (n) mit geschweifen Enden. [Glossarium Artis]"@de;
