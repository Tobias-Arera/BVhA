:c_c5f6b57d a skos:Concept;
  skos:definition "Typisch für den frühen Einsatz der Fläche sind die recht groben Hiebe; das Werkzeug wurde noch ohne eine ausgerichtete Hiebrichtung zum Einebnen der vorher abgespitzten Oberfläche eingesetzt. [Voelkle 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ef0a8695, :conceptScheme_f10222e0;
  skos:prefLabel "Abflächung ungerelte Hiebe"@de;
  skos:broader :c_0dd0afbf;
  dct:created "2019-12-18T10:49:23.000"^^xsd:dateTime;
  dct:modified "2021-01-30T16:10:02.000"^^xsd:dateTime .

:c_59e88e37 a skos:Concept;
  skos:definition "Einheitliche Bearbeitungsspuren am Werkstein durch Einsatz einer Glattfläche. [BVHA]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ef0a8695, :conceptScheme_f10222e0;
  skos:prefLabel "Abflächung geregelte Hiebe"@de;
