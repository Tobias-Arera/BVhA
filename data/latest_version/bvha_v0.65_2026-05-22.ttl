:c_3d2f62e9 a skos:Concept;
  skos:definition "Tonne mit halbkreisförmiger Gewölbelinie, die Grundform des TonnengewöIbes. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
