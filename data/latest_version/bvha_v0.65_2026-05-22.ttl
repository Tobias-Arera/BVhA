:c_02064fdc a skos:Concept;
  skos:definition "Ein zur Wölbung in Ringschichten benötigtes, auf einem Gerüst verschiebbares Gestell, das die Breite mehrerer Mauerringe, manchmal auch nur eines Mauerringes, hat. Es bietet eine Teilschalung oder Gleitschalung. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "rolling scaffolding "@en, "disque de coffrage glissante"@fr, "Rutschbogen "@de;
  skos:altLabel "disque de coffrage coulissante "@fr;
  skos:broader :c_e7c5540b;
  dct:created "2020-03-26T15:35:44.000"^^xsd:dateTime;
  dct:modified "2021-01-24T14:24:00.000"^^xsd:dateTime .

