:c_8ca6a619 a skos:Concept;
  skos:definition "Eine einschiffige Kirche mit Wandpfeilern, zwischen denen anstelle des früheren Seitenschiffs Kapellen liegen. Bereits in der Spätgotik vorkommend, wird die W. bevorzugtes Kirchenbauschema der Renaissance und bes. des Barock. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "Wandpfeilerkirche"@de, "iglesia con pilastras murales"@es, "kostel s vtaženými pilíři"@cs,
    "église à pilastres"@fr, "pilaster church"@en;
  skos:broader :c_0ea453f7;
  dct:created "2019-09-24T14:59:20.000"^^xsd:dateTime;
  dct:modified "2021-01-19T15:12:01.000"^^xsd:dateTime;
  :broaderByShape :c_0ea453f7 .

