:c_c5d23d37 a skos:Concept;
  skos:definition "Ein Bauschaden, der z.B. in den Gurtbogen mittelalterlicher Gewölbe auftritt, deren Form sich unter Einwirkung des Druckes verändert. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_1f14b4dd, :conceptScheme_315cf028,
