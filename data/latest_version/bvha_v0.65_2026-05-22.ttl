:c_44af87b8 a skos:Concept;
  skos:definition "Hängesiegel, Siegel dass an eine Urkunde angehängt wird. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
