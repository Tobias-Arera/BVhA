:c_ca4b8b72 a skos:Concept;
  skos:definition "Bogen mit S-förmiger Bogenlinie. Im Bogenscheitel verläuft sie konvex, im Bogenanfall konkav. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "reversed ogee arch"@en, "arc en doucines affrontées"@fr, "Karniesbogen"@de;
  skos:altLabel "contrasted arch"@en, "arc chantourné"@fr, "Konvexbogen"@de;
  skos:broader :c_2026364f;
  skos:related :c_57305768;
  dct:created "2019-02-18T20:11:12.000"^^xsd:dateTime;
  dct:modified "2021-01-15T17:37:36.000"^^xsd:dateTime;
  :broaderByShape :c_2026364f .

:c_d4d2de5a a skos:Concept;
  skos:definition "Bogen mit einer sehr flachen Bogenlinie, oft mit besonderer Ausbildung des Bogenanfalls. Der Mittelpunkt des Kreisbogens liegt unterhalb der Kämpferlinie. Die Bogenlinie trifft an den Kämpferpunkten im stumpfen Winkel auf die senkrechten Stützen. Der Stich beträgt im allgemeinen 1/6–1/12 der Spannweite. [Glossarium Artis]"@de,
    "Flachbogen, Stichbogen, Segmentbogen; eine Bogenkonstruktion, deren Kreismittelpunkt unterhalb der Kämpferlinie liegt; der Pfeil beträgt im Allg. 1/6 - 1/12 Spannweite. [Koepf / Binding 2016]"@de,
    "Flachbogen, Stichbogen; eine Bogenform, deren Kontur von einem Kreissegment gebildet wird. Der Kreisausschnitt ist kleiner als beim Halbkreisbogen (Rundbogen), bei relativ großem Kreisdurchmesser und relativ kleinem Ausschnitt nähert er sich dem Scheitrechten Sturz. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_84fc24e6,
    :conceptScheme_1f14b4dd, :conceptScheme_c7b144d0;
  skos:prefLabel "arc en segment"@fr, "oblouk segmentový"@cs, "segmental arch"@en, "arco (a sesto) ribassato"@it,
    "arco escarzano"@es, "Segmentbogen"@de;
  skos:altLabel "Stichbogen"@de, "Flachbogen"@de, "arco rebajado"@es, "plochý klenutý oblouk"@cs,
    "arc segmentaire"@fr, "arc aplati"@fr, "arc bombé"@fr, "diminished arch"@en;
  skos:broader :c_2026364f;
  dct:created "2019-02-18T20:11:23.000"^^xsd:dateTime;
  dct:modified "2021-01-15T17:39:51.000"^^xsd:dateTime;
  :broaderByShape :c_2026364f .

:c_e92b96ae a skos:Concept;
  skos:definition "Bogen, der im oberen Teil konkav, im unteren Teil konvex geschwungen ist. [Glossarium Artis]"@de,
    "Im unteren Teil des Bogenscheitels konvex, im oberen Teil konkav geschwungener, geschweifter Spitzbogen, eine in der Hochgotik bes. in England beliebte Form. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_84fc24e6,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "arc en accolade"@fr, "oslí hřbet"@cs, "ogee arch"@en, "arco a sesto in flesso"@it,
    "arco conopial"@es, "Kielbogen"@de;
  skos:altLabel "keel arch"@en, "arc en dos d\\'âne"@fr, "arcon"@fr, "Eselsrücken"@de,
    "Sattelbogen"@de;
  skos:broader :c_2026364f;
  skos:related :c_2c39bc66, :c_af191f6f, :c_01354d71;
  dct:created "2019-02-18T20:11:32.000"^^xsd:dateTime;
  dct:modified "2021-01-15T17:37:45.000"^^xsd:dateTime;
  :broaderByShape :c_2026364f .

