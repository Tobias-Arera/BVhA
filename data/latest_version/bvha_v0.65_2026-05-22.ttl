  dct:modified "2021-01-22T14:26:52.000"^^xsd:dateTime;
  :broaderByConstruction :c_66433988 .

:c_bd6489d9 a skos:Concept;
  skos:definition "Vordächer verfügen über eigenständige Konstruktionen, die an das Hauptdach anbinden. Die Dachhaut wird in diesem Fall von Vordachrofen/-sparren getragen. [Eißing et al. 2012]"@de;
  skos:scopeNote "Bei Dachüberständen auf der Traufseite. An der Giebelseite wurde man von einem Freirofen sprechen. [BVHA]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_19d56a39;
  skos:prefLabel "Vordachrofen"@de;
  skos:broader :c_ac93c02d;
  dct:created "2019-05-27T17:47:36.000"^^xsd:dateTime;
  dct:modified "2019-11-21T10:28:02.000"^^xsd:dateTime .

:c_43872ad8 a skos:Concept;
  skos:definition "Gratsparren/Gratrofen: Sparren/Rofen, der an der Nahtstelle schräg aneinanderstoßender Dachflächen verläuft; der Sparren- bzw. Rofenquerschn itt kann rhombisch ausgeformt sein.  (Eißing et al. 2012) "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_19d56a39;
  skos:prefLabel "Gratrofen"@de;
