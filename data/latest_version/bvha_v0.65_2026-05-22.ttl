:c_8npondzn a skos:Concept;
  skos:definition "Zimmermannszeichen zur Kennzeichnung der Einzelteile einer Holzkonstruktion je nach ihrer späteren Lage im Bauwerk. Es gibt sie in verschiedenen Zählweisen, römisch oder arabisch oder mit speziellen Zeichen, wie z.B. Strich mit Fähnchen. [Schrader / Voigt 2003]"@de;
  skos:scopeNote "Kombination aus Abbundmarken zur Markierung der zu einem Bund gehöhrenden Hölzer. [BVHA]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd, :conceptScheme_5bf6bcac, :conceptScheme_19d56a39;
  skos:prefLabel "Abbundzeichen"@de, "assembly mark"@en, "marque d\\'assemblage"@fr;
  skos:altLabel "carpenter\\'s mark"@en;
  skos:broader :c_e39b6c90;
  skos:narrower :c_1eaaad47, :c_49b69f36, :c_168605fb;
  skos:related :c_227b1d8a, :c_cf0ec846;
  dct:created "2019-11-26T10:53:22.000"^^xsd:dateTime;
  dct:modified "2021-01-26T10:47:41.000"^^xsd:dateTime .

:c_mgsjoiid a skos:Concept;
  skos:scopeNote "Ein Verbundkörper aus Beton und einer Stahlbewehrung, der so ausgeführt ist, dass der Beton nur die Druckspannungen, der Stahl meist nur die Zugspannungen aufzunehmen hat. Der S. wird auf vorfabrizierten oder eigens für einen bestimmten Bauteil angefertigten Schalungen gegossen, die nach Erhärten des Materials wieder entfernt werden können. Je nach Art der Ausbildung einer S.konstruktion unterscheidet man Pilz-, Rippen-, Platten- und Plattenbalkendecken, Rahmen, Schalen u. dergl. [Koepf / Binding 2016]"@de,
    "Eisenbeton ist die veraltete Bezeichnung für Stahlbeton."@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_84fc24e6;
  skos:prefLabel "Stahlbeton"@de, "béton armé"@fr, "železový beton"@cs, "reinforced concrete"@en,
    "cemento (calcestruzzo) armato"@it, "hormigón armado"@es;
  skos:altLabel "železobeton"@cs, "calcestruzzo armato"@it, "vyztužený beton"@cs;
  skos:broader :c_731c851a;
  skos:related :c_kqjbswgs, :c_4a3mjwqc;
  dct:created "2020-08-12T17:02:11.000"^^xsd:dateTime;
  dct:modified "2020-11-27T18:43:23.000"^^xsd:dateTime .

:c_kqjbswgs a skos:Concept;
  skos:definition "Beton (frz.), Gussmauerwerk, das bereits den Römern bekannt war (opus caementitium) und das hinter einer Vormauerung als Hinterfüllung, meist aber in oder auf einer Schalung gegossen wird. B. besteht aus festen Zuschlagstoffen und einem Bindemittel (in der Antike Kalk und hydraul. Bindemittel, auch Trass, seit 2. Hälfte 19. Jh. Zement), die mit Wasser aufbereitet werden. Je nach der Art und Menge der Zuschlagstoffe und der Bindemittel unterscheidet man verschiedene Arten von B. (Leichtb. oder Schwerb.; Schlackenb., Zellenb., Gussb., Kiesb., Hartb.). Eine neue Entwicklung nahm der B. durch die Verwendung von Rundeiseneinlagen (Bewehrung) zur Aufnahme der Zugspannungen (Stahlb.) und von vorgespannten Drähten (Spannb.). [Koepf / Binding 2016]"@de,
    "1. Beton-Mauerwerk, opus incertum; 2. Gussmauerwerk aus festen Zuschlagstoffen, Zement und Wasser; 3. Stahl-Beton aus Beton und Eiseneinlagen (Bewehrung). [Koch 2009]"@de,
    " 1. Zdivo IA, opus incertum, 2. Lité zdivo z pevného kameniva, cementu a vody, 3. Železobeton z betonu a ocelových výztuží (armatura). [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9, :conceptScheme_315cf028;
  skos:prefLabel "Beton"@de, "béton"@fr, "beton"@cs, "concrete"@en, "calcestruzzo"@it,
    "hormigón"@es;
  skos:broader :c_847c0729, :c_4mgalztg, :c_jqmv6iaq;
  skos:related :c_mgsjoiid;
  dct:created "2019-05-07T17:50:48.000"^^xsd:dateTime;
  dct:modified "2021-03-19T15:00:00.000"^^xsd:dateTime .

