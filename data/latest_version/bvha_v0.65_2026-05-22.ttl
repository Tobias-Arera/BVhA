:c_5c8f441d a skos:Concept;
  skos:definition "Offene Treppenanlage, die zum erhöhten Erdgeschoss oder 1. Obergeschoss eines Gebäudes emporführt, im Unterschied zur Außentreppe senkrecht auf den Eingang zuführend. Bereits im Altertum waren monumentale F.n ein wichtiges baukünstler. Gestaltungsmittel bei Burganlagen; Propyläen, Tempeln; im MA vor Kirchen, seit der Renaissance an Rathäusern, Schlössern und Bürgerhäusern. [Koepf / Binding 2016]"@de,
    " Nezastřešené schodiště umístěné před domovní průčelím, v době renesance a baroka zvl. reprezentativně ztvárněno, často zdůrazňuje symetrii budovy. [Koch 2008]"@cs,
    "Große, nicht innerhalb eines Baukörpers liegende und meist axial auf den Eingang zuführende Treppe. B. Sch.-W. . [Wörterbuch der Burgen, Schlösser und Festungen]"@de,
    "Der Hausfassade vorgelegte Treppe ohne Dach, in Renaissance und Barock besonders repräsentativ gestaltet. Betont oft die Symmetrie des Gebäudes. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "Freitreppe"@de, "venkovní schodiště"@cs;
  skos:broader :c_5615a6bf;
  dct:created "2019-04-05T07:11:46.000"^^xsd:dateTime;
  dct:modified "2021-01-22T17:37:14.000"^^xsd:dateTime;
  :broaderByFunction :c_5615a6bf;
  :broaderByPosition :c_5615a6bf .

