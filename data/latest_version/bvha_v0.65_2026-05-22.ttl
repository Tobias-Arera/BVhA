:c_2607d677 a skos:Concept;
  skos:definition "Architekt (gr. architekton: Erzfüger). Der A. versucht, die Umwelt menschl. Bedürfnissen entsprechend zu ordnen und einzurichten und den Lebensraum oder seine Teile nach den Regeln der Baukunst zu gestalten (Architektur). Der Stand des A.en entwickelte sich vom Leiter der Bauleute (Parlier, Polier: Sprecher) und Werkmeister (magister operis, wercmeistere) zum entwerfenden und theoretisierenden Künstler, der mit dem konstruierenden und experimentierenden Ingenieur verantwortl. Planer wird. Als Attribute des A.en gelten Richtscheit, Winkel, Lotwaage und Zirkel. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_84fc24e6;
  skos:prefLabel "Architekt"@de;
  skos:broader :c_1f0a3ce6;
  skos:related :c_jquheldj;
  dct:created "2019-12-17T14:33:00.000"^^xsd:dateTime;
  dct:modified "2021-01-15T14:40:41.000"^^xsd:dateTime .

