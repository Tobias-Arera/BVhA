:c_76813609 a skos:Concept;
  skos:definition " Aus zwei um ein Gelenk drehbaren Metallplatten, von denen die eine am Rahmen, die andere am bewegl. Teil (Tür, Flügel) eines Möbelstücks angebracht ist. Ein S. in ganzer Länge des beweg. Teils heißt Klavierband. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Scharnier"@de, "charnière"@fr, "stěžejka"@cs, "hinge"@en, "cerniera"@it,
    "charnela"@es;
  skos:altLabel "joint"@en, "stěžej"@cs, "kloubový závěs (dveřní)"@cs, "bisagra"@es;
