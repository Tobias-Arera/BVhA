:c_995cdcc0 a skos:Concept;
  skos:definition "Eine Häufung ländl. Einzelsiedlungen (Bauernhäuser, Gehöfte, Höfe) mitsamt allen zugehörigen Ländereien (Dorfflur, Dorfmark, Feldmark), deren Bewohner in der Mehrzahl Landwirtschaft betreiben. Die Erscheinungsform des D.es kann sehr vielgestaltig sein (Dorfformen) und ist außer von geograph. und wirtschaftl. Voraussetzungen auch vom sozialen Aufbau der D.gemeinde abhängig. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_176fcff1;
