  skos:definition "Sanctuskerze f; auch Wandlungskerze f: eine Kerze, die nach dem Sanctus angezündet wird und bis nach der Kommunion brennen soll; heute weithin außer Gebrauch. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
