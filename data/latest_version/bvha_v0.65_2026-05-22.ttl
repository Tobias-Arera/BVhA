:c_0ddf326f a skos:Concept;
  skos:definition "Zwerchdach, Dach mit quer zum First des Hauptdaches verlaufendem First. [Koepf/Binding 2016]"@de,
    "Příčná střecha, zastřešení bočních lodí několika rovnoběžnými sedlovými střechami kolmo k podélné ose kostela, viz vikýř s obytným prostorem. [Koch 2008]"@cs,
    "Kleiner Giebelaufsatz an der Außenmauer der Traufseite eines Hauses, dessen First quer zum Hauptdach (Dach) verläuft. Sowohl im französischen als auch im deutschen Palast- und Schlossbau  der Renaissance spielen Z., die häufig reich verziert sind, eine große Rolle. Oft sind entlang der Traufkante viele kleine Z. aneinandergereiht (Burg Mansfeld S), oder aber ein großer Z. erstreckt sich fast über die gesamte Breite des Hauses. Ist der Z. geschosshoch und befindet sich dahinter ein nutzbarer Raum, spricht man vom Z.-Haus. B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen] "@de,
    "Der Giebel des Zwerchhauses. Er soll zwischen der langen Horizontalen des Dachs und vertikalen Formen ausgleichen. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_50ec0c5e, :conceptScheme_c8a571d9, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9, :conceptScheme_1d7ba54b;
  skos:prefLabel "toit transversal"@fr, "příčná střecha"@cs, "transverse roof"@en, "tetto trasversale"@it,
    "techo transversal"@es, "Zwerchgiebel"@de;
  skos:altLabel "Zwerchdach"@de, " comble transversal"@fr, "příčná sedlová střecha"@cs,
    "Lukarne"@de, "Querdach"@de;
  skos:broader :c_d6e98810;
  dct:created "2020-04-22T13:50:15.000"^^xsd:dateTime;
  dct:modified "2021-01-22T12:25:44.000"^^xsd:dateTime .

:c_8e19de21 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe;
  skos:prefLabel "Holborn-Giebel"@de, "holbornský štít"@cs;
  skos:broader :c_d6e98810;
  dct:created "2020-08-05T13:19:08.000"^^xsd:dateTime;
  dct:modified "2020-08-12T00:11:00.000"^^xsd:dateTime .

:c_b3e7a407 a skos:Concept;
  skos:definition "Ein Giebel, der keinen Dachraum abschließt, sondern in der Art von Zwerchgiebeln (Lukarne) und Blendgiebeln v. a. dekorativ angeordnet ist. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_50ec0c5e, :conceptScheme_c8a571d9;
  skos:prefLabel "Ziergiebel"@de, "pignon décor"@fr, "fronton"@cs, "decorative gable"@en,
    "frontone ornamentale"@it, "frontón ornamental"@es;
  skos:altLabel "cimasa ornamentale"@it, "pignon décoratif"@fr;
  skos:broader :c_d6e98810, :c_90e65d89;
  dct:created "2020-03-16T14:03:56.000"^^xsd:dateTime;
  dct:modified "2021-01-22T12:24:03.000"^^xsd:dateTime;
  :broaderByFunction :c_d6e98810 .

:c_b5ef7dd5 a skos:Concept;
  skos:definition "Stufenportal, Portal mit von außen nach innen zurückgestuftem Gewände, so dass die meist relativ geringe Öffnung bei großen Mauerdicken in der Fassade wesentl. erweitert erscheint. Das Gewände kann durch eingestellte Säulen, die sich in oft ornamental verzierten Archivolten fortsetzen (Säulenportal), und durch Skulpturen zwischen den Säulen (Säulenfigurenportal) bereichert werden. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "stepped portal"@en, "portale a smussi"@it, "Stufenportal"@de, "portal escalonado"@es;
  skos:broader :c_6a7d7ddc;
  skos:narrower :c_f88715e5;
  dct:created "2020-03-16T14:21:42.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:23:03.000"^^xsd:dateTime;
  :broaderByConstruction :c_6a7d7ddc .

:c_f88715e5 a skos:Concept;
  skos:definition "Säulenportal, Portal, in dessen abgetreppter Laibung (Stufenportal) Säulen eingesetzt sind. Bes. häufig kommt das S. in der roman. Baukunst vor. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "portail à colonnes"@fr, "ústupkový portál s vložený-mi sloupky"@cs,
    "columned portal"@en, "portale a smussi con colonnine"@it, "portal con columnas"@es,
    "Säulenportal"@de;
  skos:broader :c_b5ef7dd5;
  skos:narrower :c_bb6974ce;
  dct:created "2020-03-16T14:21:53.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:23:16.000"^^xsd:dateTime .

:c_bb6974ce a skos:Concept;
  skos:definition "Säulenfigurenportal, ein gestuftes Säulenportal, bei dem zwischen den Säulen des Gewändes Skulpturen angeordnet sind. Das S. kommt in der frz. Baukunst der Romanik, v. a. aber bei den Kathedralen der Gotik vor. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Säulenfigurenportal"@de;
  skos:broader :c_f88715e5;
  dct:created "2020-03-16T14:22:03.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:23:31.000"^^xsd:dateTime .

