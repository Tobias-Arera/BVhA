:c_7e4d9ed1 a skos:Concept;
  skos:definition "In der römischen Markt- oder Gerichtsbasilika der Bogen, an den sich die Tribunalnische - der erhöhte Platz am Ende der Basilika, die Rednerbühne, die spätere Apsis - anschloss und sie vom Langschiff trennte. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "arch of Roman tribunal"@en, "arc de tribune romaine"@fr, "Tribunalbogen"@de;
  skos:altLabel "Tribünenbogen"@de, "arc d\\'exèdre"@fr;
  skos:broader :c_0e469ac8;
  dct:created "2019-10-21T11:34:52.000"^^xsd:dateTime;
  dct:modified "2019-12-05T12:41:35.000"^^xsd:dateTime;
  :broaderByPosition :c_0e469ac8 .

:c_8b3f167e a skos:Concept;
  skos:definition "Bogen, der zwei oder mehr Bogenöffnungen oder Arkaden in einer Wandnische überfängt. [Koepf / Binding 2016]"@de,
    "Často bývají okna sdružena pomocí slepého oblouku = vylehčovací oblouku. [Koch 2008]"@cs,
    "Ein verstärkender Hauptbogen, der kleinere Nebenbogen umgreift und entlastet. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_37522b74,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "arco estradossato di una volta"@it, "vylehčovací oblouk"@cs, "enclosing arch"@en,
    "arco de refuerzo"@es, "Überfangbogen"@de, "arc d\\'encadrement"@fr;
  skos:altLabel "relieving arch"@en, "arc de décharge"@fr, "discharging arch"@en, "framing arch"@en;
  skos:broader :c_eea5235b;
  dct:created "2019-10-21T11:50:02.000"^^xsd:dateTime;
  dct:modified "2020-10-19T12:46:47.000"^^xsd:dateTime;
  :broaderByFunction :c_eea5235b .

:c_a776924b a skos:Concept;
  skos:definition "Bogen, dessen Stirn durch drei, seltener zwei übereinanderliegende, leicht vorkragende bandartige Streifen gegliedert ist. [Glossarium Artis]"@de,
    "Mit Faszien architravierter Bogen, je nach der Zahl der Faszien können die toskanische (mit einer), die dor. (mit zwei), die ion. und die korinth. Archivolte (mit drei) F. unterschieden werden. In der Antike, an antikisierenden Bauten der Romanik und in der Renaissance angewandt. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "arch decorated with fascias"@en, "arc orné de fasces"@fr, "Faszienbogen"@de;
  skos:broader :c_8916f563;
  dct:created "2019-10-21T12:03:07.000"^^xsd:dateTime;
  dct:modified "2020-09-14T09:35:03.000"^^xsd:dateTime .

:c_9a3fd2eb a skos:Concept;
  skos:definition "Namentlich in Frankreich und England verbreiteter spätgotischer Spitzbogen, in dessen Leibung langgezogene, flammenähnliche Pässe eingreifen. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "arc flamboyant"@fr, "flamboyant arch"@en, "Flamboyantbogen"@de, "plaménkový oblouk"@cs;
  skos:altLabel "Flammenbogen"@de;
  skos:broader :c_8916f563;
  dct:created "2019-10-21T12:09:13.000"^^xsd:dateTime;
  dct:modified "2020-08-04T11:37:42.000"^^xsd:dateTime .

:c_6abebb28 a skos:Concept;
  skos:definition "In der Regel ein Rundbogen, auf dessen Stirn eine Schmuckform gelegt ist, die an ein gedrehtes Tau erinnert. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "arch decorated with cable molding"@en, "arc orné de torsades"@fr,
    "Kordelbogen"@de;
  skos:broader :c_8916f563;
  dct:created "2019-10-21T12:11:42.000"^^xsd:dateTime;
  dct:modified "2019-10-21T12:15:06.000"^^xsd:dateTime .

:c_7593782e a skos:Concept;
  skos:definition "Bogen, dessen Leibung wie eine Stoffbordüre gestaltet ist. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "arch with intrados imitating lambrequins"@en, "arc orné de lambrequins"@fr,
    "Lambrequinbogen"@de;
  skos:altLabel "gelappter Bogen"@de;
  skos:broader :c_8916f563;
  dct:created "2019-10-21T12:15:51.000"^^xsd:dateTime;
  dct:modified "2019-10-21T12:18:31.000"^^xsd:dateTime .

:c_8241e08e a skos:Concept;
  skos:definition "Bogen, der an seiner Leibung und oft auch an der Stirn mit Schmuckformen dekoriert ist, welche Tropfsteinen ähneln. In der islamischen Baukunst oft über dem Eingang zum Mihrab. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "arc à stalactites"@fr, "arch with stalactite decoration"@en, "Stalaktitenbogen"@de;
  skos:altLabel "Muqarnasbogen"@de;
  skos:broader :c_8916f563;
  dct:created "2019-10-21T12:20:32.000"^^xsd:dateTime;
  dct:modified "2019-10-21T12:24:12.000"^^xsd:dateTime .

:c_41996675 a skos:Concept;
  skos:definition "Bogen, dessen Leibung durch aus- und einspringende Winkel begrenzt ist oder dessen Archivolten mit zickzackförmigem Ornament besetzt sind; in der Regel ein Rundbogen. Zickzackbogen finden sich besonders häufig in der normannischen (romanischen) Architektur Englands. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "arch with zigzagged intrados"@en, "arc à intrados en dents-de-scie"@fr,
    "Zickzackbogen"@de;
  skos:broader :c_8916f563;
  dct:created "2019-10-21T12:24:54.000"^^xsd:dateTime;
  dct:modified "2019-10-21T12:27:16.000"^^xsd:dateTime .

:c_9b240563 a skos:Concept;
  skos:definition "Gewölbe, meist eine Tonne, mit konvergierend oder divergierend verlaufenden Widerlagermauern und horizontaler Scheitellinie. Zu unterscheiden vom konischen Gewölbe. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "voûte conoide"@fr, "expanding vault"@en, "konoidisches Gewölbe"@de;
  skos:altLabel "conoidal barrel vault "@en, "conoidal vault"@en;
  skos:broader :c_049c4c22;
  dct:created "2019-10-21T13:47:55.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:24:39.000"^^xsd:dateTime;
  :broaderByShape :c_049c4c22 .

:c_9a6c71e7 a skos:Concept;
  skos:definition "Scheitrechter Bogen, Sturzbogen, Horizontalbogen; trotz waagerechter Untersicht ein echter Bogen, d. h. die Fugen weisen zu einem angenommenen gemeinsamen Mittelpunkt. Der Setzung des Mauerwerks wird bei der Konstruktion des S.S.es durch eine geringfügige Erhöhung der Mitte oder durch Anordnung eines Entlastungsbogens entgegengewirkt. Ist der S. S. aus Werksteinen gefügt, so können zur Verbesserung der Tragfähigkeit auch Hakensteine verwendet werden. [Koepf / Binding 2016] "@de,
    "Bogenförmige Überdeckung einer Fenster- oder Türöffnung durch einen Stein mit gerundeter Unterseite. Ausnahmsweise auch ein gerader Sturz mit ausgerundeter Oberseite. [Glossarium Artis]"@de,
    "Segmentbogenförmiger Abschluss einer Fenster- oder Türöffnung, missverständl. auch für einen Scheitrechten Sturz. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "plate-bande bombée"@fr, "záklenek"@cs, "vaulted lintel"@en, "arco ribassato (di porta o di finestra)"@it,
    "arco achatado"@es, "Sturzbogen"@de;
  skos:altLabel "flat arch"@en, "lintel"@en, "Horizontalbogen"@de, "scheitrechter Bogen"@de,
    "dintel plano"@es, "dintel escotado"@es, "piattabanda"@it, "linteau échancré"@fr,
    "arc monolithique arasé"@fr, "arc en plate-bande"@fr, "scheitrechter Sturz"@de;
  skos:broader :c_c55445fe, :c_d1311ee4;
  dct:created "2019-10-21T14:01:03.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:36:22.000"^^xsd:dateTime .

:c_59b8ef4e a skos:Concept;
  skos:definition "Aus Zement oder anderem Material gegossener oder gepresster Bogen. Beispiel: der Parabelbogen im Collegium delle Teresiane von Antonio Gaudi in Barcelona. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "Gussbogen"@de;
  skos:broader :c_d1311ee4;
  dct:created "2019-10-21T14:16:33.000"^^xsd:dateTime;
  dct:modified "2019-10-21T14:18:00.000"^^xsd:dateTime .

