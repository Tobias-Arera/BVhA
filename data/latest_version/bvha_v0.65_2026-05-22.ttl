  dct:modified "2021-01-26T22:55:57.000"^^xsd:dateTime .

:c_4e6deb7d a skos:Concept;
  skos:definition "Eine hauptsächl. in Oberösterreich vorkommende Form eines Bauernhauses, bei der Wohn- und Wirtschaftsgebäude einen allseitig geschlossenen Hof umgeben. Der V. ist meist aus Backstein- oder Schichtmauerwerk, einzelne Teile der Wirtschaftsgebäude auch als Holzkonstruktion mit Verschalung errichtet. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_c8a571d9;
  skos:prefLabel "Vierkanthof"@de;
