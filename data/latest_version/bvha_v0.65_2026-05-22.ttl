:c_b4b2e9b5 a skos:Concept;
  skos:definition "Aus einfacher Schräge bestehendes Profil von Gesimsen und Kämpfern oder eine zu einer schrägen, gekehlten Fläche abgearbeitete Kante. [Koepf / Binding 2016]"@de,
    "Úkos, sražená hrana architektonických prvků, např. pilířů, patek. [Koch 2008]"@cs,
    "Abfasung, Fasung, Fase: Schräge, flache Abarbeitung einer Kante. Ohne An- und Auslauf als Abkantung bezeichnet. (Eißing et al. 2012)"@de,
    "Abschrägung einer Kante, meist zum Schutz vor Absplitterungen. Als starke Abschrägung bei glasangrenzenden Hölzern wird durch entsprechende Fälzung eine Vergrößerung des Lichteinfalls erzielt. [Pax - Fenster & Türen Fachbegriffe]"@de,
    "Schmiege, abgeschrägte Kante an Bauteilen. z.B. Pfeilern, Kämpfern. [Koch 2009]"@de,
    "Durch Abfasen (Abkanten) entstandene, schmale Fläche anstelle der Kante. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_37522b74, :conceptScheme_8c0441f9, :conceptScheme_19d56a39,
    :conceptScheme_c7b144d0, :conceptScheme_b41bd73a;
  skos:prefLabel "angle chanfreiné"@fr, "zkosení"@cs, "bevel"@en, "smusso"@it, "bisel"@es,
