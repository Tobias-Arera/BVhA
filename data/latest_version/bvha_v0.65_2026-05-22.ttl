:c_8665b3a4 a skos:Concept;
  skos:definition "Bogenfeld, das von einem Bogen und seiner Kämpferlinie umgrenzte Feld. Das Bogenfeld über dem waagerechten Türsturz roman. und got. Kirchenportale wird auch Tympanon genannt, ebenso das Bogenfeld an bogenförmigen Giebeln und Bekrönungen von Tür- und Portalumrahmungen der Renaissance und des Barock (Lünette); beide sind meist mit figürl. Schmuck gefüllt. Ferner kann ein Bogenfeld unter einem Entlastungsbogen über einer Reihe kleinerer Bogenöffnungen auftreten, bes. an Fenstern, Emporen und Triforien der roman. und got. Baukunst. Schließlich kann auch ein Schildbogen unter einem Gewölbe ein Bogenfeld bilden, wenn die Kämpferlinie durch ein Gesims betont ist. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_37522b74, :conceptScheme_1f14b4dd;
  skos:prefLabel "Bogenfeld"@de;
  skos:broader :c_cdfab687;
  skos:narrower :c_6feb0679, :c_d3f996e4;
  dct:created "2019-10-22T12:07:37.000"^^xsd:dateTime;
  dct:modified "2021-01-21T10:50:15.000"^^xsd:dateTime .

:c_74eaefca a skos:Concept;
  skos:definition "Profiliertes Glied einer Archivolte. Vielfach ruht jeder einzelne Bogenlauf auf seinem eigenen Kämpfer. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "rouleau"@fr, "arch ring"@en, "Bogenlauf"@de;
