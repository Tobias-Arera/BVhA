:c_0a196e79 a skos:Concept;
  skos:definition "Messbecher m: ein Becher mit Stiften oder anderen Markierungen, welche die Menge des jeweils erlaubten Getränkes anzeigen. Er wurde im Mittelalter bei liturgischen Handlungen verwendet. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
