:c_a7b81e15 a skos:Concept;
  skos:definition "Zum Tragen der Dachrinne bestimmter eiserner Haken, der auf die Sparren genagelt wird. [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel " gouttière"@fr, "gutter hanger"@en, "Rinneisen"@de, " gancho de apoyo del canalón"@es;
