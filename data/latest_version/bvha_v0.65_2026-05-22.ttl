:c_bc977321 a skos:Concept;
  skos:definition "Reliquie f , primäre; lat. reliquia primaria: der leibliche Überrest eines Heiligen, präzis. auch Körperreliquie (f) genannt. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "relique primaire"@fr, "primary relic"@en, "primäre Reliquie"@de, "reliquie primaria"@la;
  skos:broader :c_45fded98;
  skos:narrower :c_49320237;
  dct:created "2020-09-24T20:41:38.000"^^xsd:dateTime;
  dct:modified "2021-01-27T11:46:44.000"^^xsd:dateTime .

:c_6ce3d7bf a skos:Concept;
  skos:definition "Reliquie f, sekundäre; lat. reliquia secundaria: ein Gegenstand, der im Leben eines Heiligen eine Bedeutung hatte, z. B. Kleidung, Schriftrollen und Marterwerkzeuge. Man spricht präzis. auch von Sachreliquie (f). [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "relique secondaire"@fr, "secondary relic"@en, "sekundäre Reliquie "@de,
    "reliquie secundaria"@la;
  skos:altLabel "representative relic"@en;
  skos:broader :c_45fded98;
  skos:narrower :c_b55b09a2, :c_af5e23a0;
  dct:created "2020-09-24T20:46:26.000"^^xsd:dateTime;
  dct:modified "2021-01-27T11:47:23.000"^^xsd:dateTime .

:c_d382388d a skos:Concept;
  skos:definition "Acheiropoieta f pl; von gr. acheiropoietos eikon \"ohne Hand gemachtes Bild\"; lat. acheropitae imagines: Bilder, die auf übernatürliche Weise entstanden sein sollen und daher als authentische Christus- bzw. Marienbilder gelten und als Reliquien verehrt werden; auch Bezeichnung für den ihnen folgenden Typus von Ikonen. In der byzantinischen Kunst werden MarienbiIder, die nicht von Menschenhand geschaffen sein sollen, als Theotokos-Acheiropoieta verehrt. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "acheropita imago"@la, "Acheiropoieton"@de;
  skos:broader :c_45fded98;
  dct:created "2020-09-24T21:05:25.000"^^xsd:dateTime;
  dct:modified "2021-01-27T11:40:29.000"^^xsd:dateTime .

:c_f27523e7 a skos:Concept;
  skos:definition "Heiliges Blut n; Kostbares auch Wundertätiges Blut, Heilig-Blut-Reliquie f ; lat. Sanguis Domini: Blut, das von Christus, von Märtyrern, von geschändeten Hostien oder Kruzifixen stammen soll und das in Ampullen auf bewahrt wird (seit 8. Jh.). Einigen dieser Reliquien wird ein Blutwunder zugeschrieben, d. h. die Entstehung neuer Blutstropfen oder die Verflüssigung eingetrockneter Blutsflecken. Kultstätten befinden sich u. a. auf der Insel Reichenau, in Brügge, Fecamp, Mantua, Weingarten, Rothenburg ob der Tauber (St. Jakob, HeiIig-BIut-AItar von Tilman Riemenschneider, 1501-04). [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "Saint-Sang"@fr, "Holy Blood"@en, "Heiliges Blut"@de, "Sanguis Domini"@la;
  skos:altLabel "Sang Précieux"@fr, "Precious Blood"@en, "Kostbares Blut"@de, "Wundertätiges Blut"@de,
    "Heilig-Blut-Reliquie"@de;
  skos:broader :c_45fded98;
  dct:created "2020-09-25T19:27:45.000"^^xsd:dateTime;
  dct:modified "2021-01-27T11:41:40.000"^^xsd:dateTime .

:c_9ae4139b a skos:Concept;
  skos:definition "Etikettierung f: die Beschriftung von Reliquien, um ihre Identität zu sichern. In früherer Zeit befestigte man Gold-, Silber- oder BleipIättchen mit einer getriebenen oder gravierten Inschrift an der Reliquie. Im späten Mittelalter verwendete man Reliquienzettel, die meist mit Faden um das Partikel gewickelt wurden. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "étiquetage"@fr, "labeling"@en, "Etikettierung"@de;
  skos:broader :c_a2dc7eed;
  skos:related :c_a9bd647a, :c_1ba67ac2;
  dct:created "2020-09-27T14:57:39.000"^^xsd:dateTime;
  dct:modified "2021-01-15T17:33:17.000"^^xsd:dateTime .

:c_bd00c3f4 a skos:Concept;
  skos:definition "Turnustafel f: eine Tafel, auf der für einen längeren Zeitraum die Abfolge der Gottesdienste und die Namen der beteiligten Zelebranten aufgeführt sind. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
