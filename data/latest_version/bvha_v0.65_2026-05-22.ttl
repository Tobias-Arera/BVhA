  dct:modified "2021-01-31T00:28:47.000"^^xsd:dateTime .

:c_87e7afd6 a skos:Concept;
  skos:definition "Basrelief (frz. bas-relief), Flachrelief, Relief mit nur geringer räuml. Tiefe. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
