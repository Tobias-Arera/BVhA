:c_3b7582b1 a skos:Concept;
  skos:definition "Gebetsturm der Moschee. [Koch 2009]"@de, "Minar, Minarett (arab. manara: Leuchtturm), Turm für den Gebetsrufer (Muezzin) einer Moschee. In Nordafrika und Spanien ist das M. meist ein quadrat. Turm mit reicher Ornamentdekoration und schlankem Aufsatz (Migalet). In der ind.-islam. Baukunst finden wir Bündelpfeilern ähnl. M.e, in der türk. nadelschlanke Türme, die nur eine oder zwei Wendeltreppen enthalten, die zu einem oder mehreren Umgängen führt. Gewöhnl. hat eine Moschee ein M., doch haben bdeutendere Anlagen zwei, vier oder sechs M.e. Nur das Heiligtum in Mekka hat sieben M.e. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_8c0441f9;
  skos:prefLabel "minaret"@ca, "minaret"@en, "minaret"@cs, "minar"@fr, "minarete"@es,
    "Minarett"@de, "minareto"@it;
  skos:altLabel "Minar"@de;
  skos:broader :c_a2025113;
  skos:related :c_d03664eb;
  dct:created "2019-08-17T17:26:52.000"^^xsd:dateTime;
  dct:modified "2021-01-22T13:33:00.000"^^xsd:dateTime;
  :broaderByFunction :c_a2025113 .

:c_591ed7e5 a skos:Concept;
  skos:definition "Gebetsnische der Moschee. [Koch 2009]"@de, "Mihrab (arab.), kleine Gebetsnische, die die Richtung nach Mekka weisen muss, gegenüber dem Eingang einer Moschee. Aus diesem Grund sind zwar alle Moscheen einheitl. nach Mekka gerichtet, jedoch nach ihrer geograph. Lage verschieden \\'orientiert\\'. Der M. ist oft durch ein Stalaktitengewölbe abgeschlossen und an den Wänden mit bunten Azulejos bekleidet. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_8c0441f9;
  skos:prefLabel "mihrab"@cs, "Miḥrāb"@de, """mihrab
"""@en;
  skos:editorialNote "gehört unter Bauelement (TAR)."@de;
  skos:broader :c_bfa40c59, :c_2d6003a3;
  skos:related :c_d03664eb;
  dct:created "2019-08-17T17:46:23.000"^^xsd:dateTime;
  dct:modified "2021-01-21T18:33:33.000"^^xsd:dateTime;
  :broaderByFunction :c_bfa40c59 .

