:c_eb035dce a skos:Concept;
  skos:definition "Seitlicher Befestigungsbau eines bewehrten Tores. [Koch 2009]"@de,
    "Boční ochranný objekt opevněné brány. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
