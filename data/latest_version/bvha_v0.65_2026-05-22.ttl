:c_b4d2bfb6 a skos:Concept;
  skos:definition "Eine Methode, gerade Linien auf Putzmörtel aufzubringen (kann farbig oder farblos sein), indem eine Schnur gespannt, leicht abgehoben und wieder losgelassen wird, sodass sie auf den Putz zurückschnellt und dabei eine Spur hinterlässt. [EwaGlos]"@de,
    "A method of applying a straight line on plaster (can be coloured or without colour) by stretching a piece of string, pulling back and releasing it so that it snaps against the painting, leaving a mark. [EwaGlos]"@en;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_ec8c77bf;
  skos:prefLabel "Markierung durch Schlagschnur"@de, "snapped line"@en;
  skos:altLabel "Schnurschlag"@de, "Markierung mit Schlagleine"@de, "snapped cord"@en,
    "chalk line"@en;
  skos:broader :c_1df9f722;
  dct:created "2019-10-15T11:06:05.000"^^xsd:dateTime;
  dct:modified "2021-01-18T14:03:38.000"^^xsd:dateTime .

