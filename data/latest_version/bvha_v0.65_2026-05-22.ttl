    "église fortifiée"@fr, "Wehrkirche (Anlage)"@de;
  skos:altLabel "Wehrkirche"@de, "opevněný kostel"@cs;
  skos:editorialNote "Hier ist eine Unterscheidung nach Wehrkirche (Anlage) und Wehrkirche (Einzelbauwerk) notwendig, da ansonsten die Zuordnung zu Bauwerksgruppe oder Bauwerk unscharf bleibt."@de;
  skos:broader :c_0ea453f7, :c_0218b422, :c_8e6f9337;
  dct:created "2019-05-28T14:45:30.000"^^xsd:dateTime;
  dct:modified "2021-01-27T12:59:51.000"^^xsd:dateTime .

