:c_db78aa81 a skos:Concept;
  skos:definition "Im Gegensatz zum Flachrelief zeigt das H. eine nahezu vollplast. Ausbildung der Darstellung, die aber noch immer mit dem Hintergrund verbunden bleibt. [Koepf / Binding 2016]"@de,
    "U „přísného\" reliéfu jsou figury jasně oddělené od podklad1;1, u „malířského\" reliéfu splývají s podkladem, který má často architektonické nebo krajinné pozadí. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_50ec0c5e, :conceptScheme_37522b74;
