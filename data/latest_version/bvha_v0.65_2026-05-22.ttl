:c_0c96cb38 a skos:Concept;
  skos:definition "Unterste Schicht des aufgehenden Mauerwerks eines Gebäudes, die aus größeren und manchmal hochkant gestellten Steinen  besteht, beim gr. Tempelbau die Schicht über dem Mauerfuß, die den Sockel der Cella bildet und von einer Abdeckplatte abgeschlossen ist. In der Baukunst Mesopotamiens und der Hethiter war nur das 0. aus Stein und meist mit Reliefs geschmückt. [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Orthostat"@de, "orthostate"@fr, "ortostata"@it, "orthostat"@en;
  skos:broader :c_c4eed245;
  dct:created "2020-08-21T13:44:57.000"^^xsd:dateTime;
  dct:modified "2021-01-22T15:50:32.000"^^xsd:dateTime .

