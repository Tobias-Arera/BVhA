  dct:modified "2021-01-19T12:12:46.000"^^xsd:dateTime;
  :broaderByShape :c_049c4c22 .

:c_9bc154b8 a skos:Concept;
  skos:definition "Gewölbe über dem Grundriss einer Ellipse, hauptsächl. im böhm. und fränk. Barock vorkommend. [Koepf / Binding 2016]"@de,
    "Gewölbe über ellipsenförmigem Grundriss; vor allem im böhmischen und fränkischen Barock. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_1f14b4dd;
  skos:prefLabel "voûte elliptique"@fr, "elliptical vault"@en, "Ellipsengewölbe"@de,
    "elipsovitá klenba"@cs;
  skos:altLabel "elliptisches Gewölbe"@de;
