:c_f3d06acd a skos:Concept;
  skos:definition "Stützmauer, eine Mauer aus Backstein, Naturstein oder Beton, die rutschgefährdete Erde, Felsen u. dergl. stützen soll. [Koepf / Binding 2016]"@de,
    "Mauer, die seitlichen Druck von Erdmassen aufnimmt. (Glossarium Artis, Bd. 3, Bögen und Mauerwerk)"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe;
