:c_537f5b30 a skos:Concept;
  skos:definition "Fest mit der Mauer verbundener Teil des Fensters, Fensterstock, an dem die Flügel befestigt sind. [Koepf / Binding 2016]"@de,
    "Holzgerüst, das in die Fensteröffnung eingesetzt ist. Es wird von Schenkeln und der Innenkonstruktion gebildet und ist Träger der Fensterflügel und der Festverglasung. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_c7b144d0, :conceptScheme_b41bd73a;
  skos:prefLabel "Fensterrahmen"@de;
  skos:broader :c_b2356bd0;
  skos:narrower :c_bd51d5d0, :c_4da5b007, :c_884f9a03, :c_7e0fd312, :c_6836c935, :c_6a2b5c14,
    :c_8374abb2, :c_ca4da84f;
  dct:created "2019-05-23T07:59:56.000"^^xsd:dateTime;
  dct:modified "2020-09-14T12:44:05.000"^^xsd:dateTime .

:c_b8d6a0c3 a skos:Concept;
  skos:definition "Deckleiste, Fugenleiste, flache, meist hölzerne Leiste zur Überdeckung der Anschlussfuge zweier Bauteile oder Bauelemente verschiedenen Materials. [Koepf / Binding 2016]"@de,
    "Eine Leiste in einfacher oder profilierter Form zum Abdecken vom Zwischenraum zweier angrenzender Bauteile, z.B. zwischen Fensterrahmen und Wand in Form einer Bekleidung. [Pax - Fenster & Türen Fachbegriffe]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_c7b144d0;
  skos:prefLabel "Deckleiste"@de;
  skos:broader :c_b2356bd0, :c_8b0a1aab;
  dct:created "2019-05-23T08:09:26.000"^^xsd:dateTime;
  dct:modified "2020-09-08T17:20:48.000"^^xsd:dateTime .

:c_8b0a1aab a skos:Concept;
  skos:definition "Schenkel und Innenkonstruktion in Fenster- oder Flügelrahmen, die alle einen nahezu gleichen querrechteckigen Querschnitt haben. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
