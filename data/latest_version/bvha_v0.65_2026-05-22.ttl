:c_6d9e49ef a skos:Concept;
  skos:definition "Ein als Blockbau errichtetes Haus, dessen Obergeschoss oder Dach (Dachgeschoss) auf einer selbständigen äußeren Tragkonstruktion aus Säulen oder Ständern, Rähm, Riegeln und Streben bzw. Kopfbändern ruht. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_c8a571d9;
  skos:prefLabel "Umgebindehaus"@de, "hrázděný dům s vnitřním nosným skeletem a samonosnými obvodovými stěnami"@cs;
  skos:broader :c_1c8ef562;
  dct:created "2020-08-05T16:32:04.000"^^xsd:dateTime;
  dct:modified "2021-01-26T23:13:47.000"^^xsd:dateTime .

:c_a73a67a1 a skos:Concept;
  skos:definition "Variante von einem Fensterrahmen und Türrahmen. Entwicklungsgeschichtlich eine Zwischenform zwischen Blockrahmen und Zargenrahmen, der sich vom konstruktiven Fachwerkgerüst getrennt hat und bei dem die einzelnen Hölzer differenzierte Querschnitte bekommen. Die Blockzarge wird in die lichte Maueröffnung gesetzt und sie ist tiefer als breit, im Gegensatz zum Blendrahmen, der breiter als tief ist. Vorteile sind beim Fenster geringerer Holzverbrauch und größere Lichtausbeute. [Schrader / Voigt 2003]  "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_5bf6bcac;
  skos:prefLabel "Blockzargenrahmen (Tür)"@de;
  skos:altLabel "Blockzarge (Tür)"@de;
  skos:broader :c_13411016;
  skos:related :c_7587fad6;
  dct:created "2020-09-29T14:56:48.000"^^xsd:dateTime;
  dct:modified "2021-01-22T19:23:35.000"^^xsd:dateTime .

:c_7587fad6 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_5bf6bcac;
  skos:prefLabel "Blockzargenrahmentür"@de;
  skos:broader :c_62508dc5;
  skos:related :c_a73a67a1;
  dct:created "2020-09-29T15:03:20.000"^^xsd:dateTime;
  dct:modified "2021-01-22T18:46:18.000"^^xsd:dateTime;
  :broaderByConstruction :c_62508dc5 .

:c_7bee83eb a skos:Concept;
  skos:definition "Ein zumeist quadrat., selten runder Turm axial vor dem Mittelschiff einer Basilika, Hallen- oder Saalkirche. Der Turm enthält den Eingang oder eine Eingangshalle im Erdgeschoss, häufig eine Empore oder Kapelle im Obergeschoss; ohne W.-Eingang kann er als W.-Chor dienen. Die frühesten E.n finden sich Ende des 11. Jhs., bes. bei den Pfarrkirchen der Gotik beliebt. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "Einturmfassade"@de;
  skos:broader :c_98b29ba3;
  dct:created "2020-09-07T10:58:03.000"^^xsd:dateTime;
  dct:modified "2021-01-19T11:09:29.000"^^xsd:dateTime .

:c_5b0de703 a skos:Concept;
  skos:definition "Bewegl., oft ornamental ausgestalteter Beschlag, der zum Klopfen um Einlass diente. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "heurtoir"@fr, "knocker"@en, "battaglio"@it, "Türklopfer"@de;
  skos:altLabel "marteau de porte"@fr, "picchiotto"@it;
  skos:broader :c_927173eb;
  dct:created "2020-08-05T17:40:39.000"^^xsd:dateTime;
  dct:modified "2021-01-22T19:22:08.000"^^xsd:dateTime .

