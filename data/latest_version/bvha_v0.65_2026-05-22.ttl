  dct:modified "2021-01-15T17:36:15.000"^^xsd:dateTime .

:c_b6eb3b35 a skos:Concept;
  skos:definition "Das von der Gotik angestrebte Strukturprinzip, bei dem die Felder zwischen den tragenden Rippen, Pfeilern und Streben nicht massiv, sondern durchscheinend (Maßwerk, Glasmalerei) oder zweischichtig räumlich (Zweischichtengewölbe, Blendmaßwerk, Schleierwerk, Triforium) geschlossen werden. 1927 von Hans Jantzen eingeführte Bezeichnung. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_84fc24e6;
  skos:prefLabel "Diaphane Struktur"@de;
  skos:broader :c_a4d58de0;
  dct:created "2020-09-07T09:24:42.000"^^xsd:dateTime;
  dct:modified "2025-11-04T15:11:27"^^xsd:dateTime .

:c_3060c2c8 a skos:Concept;
  skos:definition "Verengung des Querschnitts, bezogen auf die Längsachse. So kann z.B. der Chor einer Kirche gegenüber dem breiteren Langhaus >eingezogen< sein. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_84fc24e6;
  skos:prefLabel "Einziehung"@de;
  skos:broader :c_a4d58de0;
  dct:created "2020-09-07T11:00:48.000"^^xsd:dateTime;
  dct:modified "2021-01-15T17:42:02.000"^^xsd:dateTime .

:c_f0571956 a skos:Concept;
  skos:definition "Viereckige, polygonale oder krummlinig umrahmte Fläche an Wänden, Decken oder Gewölben. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_84fc24e6;
  skos:prefLabel "Feld"@de;
  skos:broader :c_a4d58de0;
  dct:created "2020-09-14T10:01:13.000"^^xsd:dateTime;
  dct:modified "2021-01-15T17:42:12.000"^^xsd:dateTime .

:c_ca67fbbf a skos:Concept;
  skos:definition "Bei der Dorischen Ordnung sind die Triglyphen in der Regel auf die Säulenachse bzw. auf die Mitte des Interkolumniums bezogen, nur die Ecktriglyphe sitzt genau an der Ecke. Eine Triglyphe ist aber meist schmäler als der obere Säulendurchmesser, so dass die Differenz im letzten Interkolumnium ausgeglichen werden muss. Das geschieht durch Verringerung des letzten Interkolumniums (Eckkontraktion). [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_84fc24e6;
  skos:prefLabel "Triglyphenkonflikt"@de;
  skos:altLabel "Dorischer Eckkonflikt"@de;
  skos:broader :c_9dcb728d;
  skos:narrower :c_c99a60cb;
  dct:created "2020-08-07T10:58:36.000"^^xsd:dateTime;
  dct:modified "2021-01-15T17:57:45.000"^^xsd:dateTime .

:c_c99a60cb a skos:Concept;
  skos:definition "Verringerung des Eckinterkolumniums. Die E. tritt am dor. Tempel als Folge des Triglyphenkonfliktes auf. Bei den anderen Säulenordnungen tritt manchmal eine E. (meist über zwei Interkolumnien) als opt. Korrektur auf. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_84fc24e6;
  skos:prefLabel "Eckkontraktion"@de;
  skos:broader :c_ca67fbbf;
  dct:created "2020-09-07T09:52:49.000"^^xsd:dateTime;
  dct:modified "2021-01-15T17:57:55.000"^^xsd:dateTime .

:c_57b13fa1 a skos:Concept;
  skos:definition "Ein Haus, das der Straße die Traufe zukehrt. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_c8a571d9;
  skos:prefLabel "Traufenhaus"@de;
  skos:broader :c_1c8ef562;
  dct:created "2020-08-07T15:00:00.000"^^xsd:dateTime;
  dct:modified "2021-01-26T23:13:06.000"^^xsd:dateTime .

