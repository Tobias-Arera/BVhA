:c_7a7db0bd a skos:Concept;
  skos:definition "Heiliges Grab, Kenotaph Christi, in zwei verschiedenen Formen vorkommend: eine Rotunde oder ein Polygon (v.a. in Frankreich) als Nachbildung der Grabeskirche in Jerusalem. [Koepf / Binding 2016]"@de,
    "BOŽÍ HROB (též Svatý hrob), 1. Kaple, původně zpravidla kruhová, upomínající na Ježíšův hrob v Jeruzalémě (4.-18. stol., zvl. četné ve středověku). 2. Figurální skupinová plastika z kmene nebo dřeva v kostelích: sarkofág s Kristovým tělem, anděly, 3 Mariemi a spícími strážci (od 14. stol.). [Koch 2008] "@cs,
    "Meist als Rundbau angelegte Kapelle in Erinnerung an die Grabstätte Jesu in Jerusalem (4.-18. Jh., bes. zahlreich im Mittelalter). [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "Heiliges Grab (Kapelle)"@de, "Boží hrob"@cs;
  skos:altLabel "Svatý hrob"@cs;
  skos:broader :c_a252a285;
  skos:related :c_b6eb4c58;
  dct:created "2020-05-20T17:40:51.000"^^xsd:dateTime;
  dct:modified "2021-01-19T14:50:33.000"^^xsd:dateTime .

