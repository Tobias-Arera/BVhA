:c_5560f3a0 a skos:Concept;
  skos:definition " Diese kommen zum Einsatz, wenn Radien angerissen werden müssen, bei denen der Mittelpunkt außerhalb des zu bearbeitenden Werkstücks liegt. Dies ist insbesondere bei den Bogenradien von Gewölben oder Maßwerken der Fall. [Voelkle 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_f10222e0;
  skos:prefLabel "Bogenschablone"@de;
  skos:broader :c_77f02e97;
  dct:created "2019-11-14T14:54:05.000"^^xsd:dateTime;
  dct:modified "2019-11-14T14:55:25.000"^^xsd:dateTime .

:c_d980ca2a a skos:Concept;
  skos:definition "Bei dieser Schablone handelt es sich um ein Hilfsmittel, um eingesetzte (totlaufende) Profile bearbeiten zu können. [Voelkle 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_f10222e0;
  skos:prefLabel "Kontraschablone"@de;
  skos:broader :c_77f02e97;
  dct:created "2019-11-14T14:57:43.000"^^xsd:dateTime;
  dct:modified "2019-11-14T14:59:37.000"^^xsd:dateTime .

:c_5d687ff5 a skos:Concept;
  skos:definition "Wenn mehrere gleich profilierte Werkstücke angefertigt werden - dies betrifft insbesondere Profilsteine von Maßwerken, Gewölberippen oder Diensten - kann die Verwendung von Profilschablonen den Fertigungsprozess wesentlich beschleunigen. Darüber hinaus erhöht sich natürlich die Genauigkeit, was insbesondere in der Hoch- und Spätgotik die Bearbeitung der kompliziertenProfile wesentlich vereinfachte. [Voelkle 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_f10222e0;
  skos:prefLabel "Profilschablonen"@de;
  skos:broader :c_77f02e97;
  dct:created "2019-11-14T15:00:18.000"^^xsd:dateTime;
  dct:modified "2019-11-14T15:04:10.000"^^xsd:dateTime .

:c_4f112a9a a skos:Concept;
  skos:definition "Ein Gestell mit Form- und Maßangaben (Wölblinie etc.), das beim freihändigen Einwölben benützt wird. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "mould (template)"@en, "échantillon "@fr, "Lehre"@de;
  skos:altLabel "Schablone"@de, "model"@en, "gabarit "@fr, "Lehrbrett "@de;
  skos:broader :c_77f02e97;
  dct:created "2020-03-26T13:02:29.000"^^xsd:dateTime;
  dct:modified "2020-03-26T13:15:24.000"^^xsd:dateTime .

:c_1c731062 a skos:Concept;
  skos:definition "Nur gering tragendes, senkrechtes Holz zwischen Riegeln, Schwellen und Rähm in einer Fachwerkwand, das meistens eine Öffnung begrenzt. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Stiel"@de, "jamba"@es, "gamba"@it, "manche"@fr, "helve"@en;
  skos:altLabel "pilastro"@it, "poteau"@fr, "post"@en, "hampe"@fr, "handle"@en, "montant"@fr,
    "stud"@en, "upright"@en, "coscia"@it;
  skos:broader :c_f99ea647;
  dct:created "2020-08-12T08:47:41.000"^^xsd:dateTime;
  dct:modified "2020-11-10T11:34:33.000"^^xsd:dateTime .

:c_dcbe9f3a a skos:Concept;
  skos:definition "Untere Verdickung des Ständers durch ein Blatt, das von dem mit einfachem Zapfen versehenen Fuß bis zur halben oder ganzen Höhe der Schwelle herunterreicht und die Fugen zwischen Ständer und Schwelle deckt, bes. im südwestl. Fachwerkbau des 15./16. Jhs. (veraltet Schwebeblatt). [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Ständerfußblatt"@de;
  skos:altLabel "Schwebeblatt"@de;
  skos:broader :c_f99ea647;
  dct:created "2020-08-12T15:42:49.000"^^xsd:dateTime;
  dct:modified "2020-11-02T16:14:31.000"^^xsd:dateTime .

:c_5f806b91 a skos:Concept;
  skos:definition "Stabförmiges Konstruktionsglied. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Stab"@de, "barra"@es, "asta"@it, "bâton"@fr, "bead"@en;
