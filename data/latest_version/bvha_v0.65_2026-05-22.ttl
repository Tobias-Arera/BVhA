:c_52e560f6 a skos:Concept;
  skos:definition "Eine rillenartige Vertiefung. Als Holzverbindung (Nut und Feder) eine Aussparung am Stoß eines Bretts, die meist ein Drittel der Brettdicke breit ist und in die die Feder eingreift. [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_19d56a39;
