:c_6feb0679 a skos:Concept;
  skos:definition " [de] Das von einem Bogen und seiner Kämpferlinie umgrenzte Feld. Das Bogenfeld über dem waagerechten Türsturz roman. und got. Kirchenportale wird auch Tympanon genannt, ebenso das Bogenfeld an bogenförmigen Giebeln und Bekrönungen von Tür- und Portalumrahmungen der Renaissance und des Barock (Lünette); beide sind meist mit figürl. Schmuck gefüllt. Ferner kann ein Bogenfeld unter einem Entlastungsbogen über einer Reihe kleinerer Bogenöffnungen auftreten, bes. an Fenstern, Emporen und Triforien der roman. und got. Baukunst. Schließlich kann auch ein Schildbogen unter einem Gewölbe ein Bogenfeld bilden, wenn die Kämpferlinie durch ein Gesims betont ist. [Koepf / Binding 2016] "@de,
    "TYMPANON, 1. Vnitřní plocha štítu antikého chrámu. 2. Trojúhelníková nebo segmentová plocha vymezená frontonem na románském a gotickém portálu. [Koch 2008]"@cs,
    "Fläche über einem Portal innerhalb des Bogenfelds, häufig mit Reliefs [geschmückt]. [Koepf / Binding 2016]"@de,
    "Bogenfeld am romanischen und gotischen Portal. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "tympanon"@cs, "Tympanon"@de, "tympan"@fr, "tympanum"@en, "timpano"@it,
    "tímpano"@es;
  skos:altLabel "tympan"@en;
  skos:broader :c_09462c92, :c_8665b3a4;
  dct:created "2019-10-22T12:00:09.000"^^xsd:dateTime;
  dct:modified "2021-01-22T17:12:32.000"^^xsd:dateTime;
  :broaderByPosition :c_09462c92 .

:c_d3f996e4 a skos:Concept;
  skos:definition "Lünette (frz. Möndchen), 1. halbkreisförmiges Bogenfeld über Türen und Fenstern; 2. oberer gerundeter Abschluss eines Rechtecks. [Koch 2009]"@de,
    "Kleineres, gerahmtes, teilweise dekoriertes Bogenfeld über Türen und Fenstern, das im Unterschied zum Tympanon nicht eingetieft, sondern auf die Rahmung aufgesetzt ist, bes. in der Renaissance und im Barock angewandt. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_8c0441f9, :conceptScheme_1f14b4dd;
  skos:prefLabel "lunette"@fr, "lunette"@en, "lunetta"@it, "Lünette (Bogenfeld)"@de,
    "luneto"@es;
  skos:broader :c_8665b3a4;
  dct:created "2019-10-22T12:08:25.000"^^xsd:dateTime;
  dct:modified "2020-08-28T15:01:10.000"^^xsd:dateTime .

