    "campanello da messa"@it, "sonnette"@fr, "clochette d\\'autel"@fr, ""@en-GB, "Mass bell"@en,
    "sacring bell"@en, "Sacryn bell"@en, "saints\\' bell"@en, "sance-bell"@en, "sanctus bell"@en;
  skos:broader :c_aced96c4, :c_1655dbba, :c_17d46f99;
  skos:narrower :c_5ecb8679;
  skos:related :c_1d4f2d1b;
  dct:created "2020-02-25T15:00:46.000"^^xsd:dateTime;
  dct:modified "2021-01-28T08:47:07.000"^^xsd:dateTime .

