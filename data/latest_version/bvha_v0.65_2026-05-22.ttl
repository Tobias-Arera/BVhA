:c_35952657 a skos:Concept;
  skos:definition "Eine emporeähnl. Maueröffnung zwischen Seitenschiffarkade und Fensterzone, hinter der sich kein begehbarer Raum befindet. S.n führen meist in den oberen Teil der Seitenschiffe oder in den Dachraum. [Koepf / Binding 2016]"@de,
    "Pouhý otvor ve zdi, který netvoří žádný vlastní emporový prostor. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_37522b74;
  skos:prefLabel "tribune simulée"@fr, "falešná empora"@cs, "blind gallery"@en, "falso matroneo"@it,
    "galería simulada"@es, "Scheinempore"@de;
  skos:altLabel "tribune aveugle"@fr, "tribuna simulada"@es;
  skos:broader :c_d37353f8;
  dct:created "2020-08-04T13:14:40.000"^^xsd:dateTime;
  dct:modified "2021-01-22T12:25:54.000"^^xsd:dateTime .

:c_040f0668 a skos:Concept;
  skos:definition "Eine Empore an den Langseiten, meist aber über dem Westeingang einer Kirche (Orgelempore). Die S.n waren urspr. nicht sehr groß. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "cantoria"@it, "Sängerbühne"@de, "tribuna coral"@es, "zpěvácká kruchta"@cs;
  skos:altLabel "kůr"@cs;
  skos:broader :c_d37353f8;
  dct:created "2020-08-21T11:54:14.000"^^xsd:dateTime;
  dct:modified "2021-01-22T12:25:39.000"^^xsd:dateTime .

:c_dcf65a9c a skos:Concept;
  skos:definition "Empore für die Orgel, urspr. nicht über dem Westeingang, sondern an den Hochschiffwänden des Langhauses angebracht. Erst in der  Barockzeit, als die Orgel monumental in das Langhaus eingefügt wurde (Orgelprospekt), wurden eigens O.n (Orgelchor) erbaut. Sie wurden später allg. und auch in ältere Kirchen ohne ursprüngl. Westempore eingefügt. [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "Orgelempore"@de, " tribuna del órgano"@es, " cantoria"@it, "organ loft"@en,
    " tribune d\\'orgue"@fr;
  skos:broader :c_d37353f8;
  dct:created "2020-08-25T14:28:51.000"^^xsd:dateTime;
  dct:modified "2021-01-22T12:25:31.000"^^xsd:dateTime .

:c_f5854446 a skos:Concept;
  skos:definition "Der um einen mittleren Bauteil herumgeführte Gang, kann auch als selbständiger Bauteil von einer Wallfahrtskirche zur Gnadenkapelle führen. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel " ambulatoire"@fr, " ambulacro"@it, "Umgang"@de, " deambulatorio"@es;
  skos:altLabel "ambulatory"@en, "c(h)arole"@fr, " deambulatorio"@it;
