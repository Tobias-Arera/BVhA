:c_95892c25 a skos:Concept;
  skos:definition "Ablaufrinne, Entwässerungsrinne zwischen Dächern, auf Strebebogen, im Altertum und MA in Wasserspeiern, später in Ablaufrohren mündend, auch zur Entwässerung von Hofflächen und Straßen. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Ablaufrinne"@de;
