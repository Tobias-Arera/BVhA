:c_b78e308a a skos:Concept;
  skos:definition "Parcham, Bereich zwischen zwei Wehrmauern oder Wällen, zumeist zwischen Ring- und Vormauer. Diente zur Verbesserung der Verteidigungsfähigkeit und war vor der Einführung der Feuerwaffen von Bedeutung, auch als Tiergehege oder für Wettkämpfe genutzt, wurde durch den Festungsbau abgelöst. [Koepf/Binding 2016]"@de,
    "U středověkých hradů a měst prostor mezi vnější a vnitřní okružní hradbou; od baroka též přestavován jako slavnostní a zábavní prostor (Drážďany). [Koch 2008]"@cs,
    "Geländestreifen zwischen der Ringmauer und einer weiteren, vorgelegten Mauer (Z.-Mauer, teils mit Flankierungstürmen versehen). Durch die Z.-Anlage wurde dem Gegner ein weiteres Annäherungshindernis entgegengelegt. Bisweilen konnten Z. Stallungen, Schuppen und Scheunen aufnehmen (Ortenberg HE). M. L. [Wörterbuch der Burgen, Schlösser und Festungen]"@de,
    "Bei mittelalterlichen Burgen und Städten das Terrain zwischen äußerem und innerem Mauerring. Seit Barock auch als Vergnügungs- oder Festplatz umgebaut. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_50ec0c5e, :conceptScheme_37522b74, :conceptScheme_8c0441f9, :conceptScheme_1d7ba54b;
  skos:prefLabel "bayle extérieur"@fr, "parkán"@cs, "outer courtyard, enclosure"@en,
    "pomerio"@it, "recinto exterior cercado"@es, "Zwinger"@de;
  skos:altLabel "Zwingeranlage"@de, "hradní příkop "@cs;
  skos:broader :c_69367952;
  skos:narrower :c_d9d49e81;
  dct:created "2020-04-09T18:24:19.000"^^xsd:dateTime;
  dct:modified "2021-01-27T12:57:32.000"^^xsd:dateTime;
  :broaderByFunction :c_69367952 .

:c_d9d49e81 a skos:Concept;
  skos:definition "\"Fanghof, der zwischen Außen- und Innentor liegende Raum einer Torburg (Kammertor), entwickelt aus dem Propugnaculum röm. Kastelltore.\" [Koepf / Binding 2016]"@de;
