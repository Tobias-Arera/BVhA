  dct:created "2019-06-11T20:50:53.000"^^xsd:dateTime;
  dct:modified "2021-03-19T17:52:30.000"^^xsd:dateTime .

:c_c1834f5b a skos:Concept;
  skos:definition "Adobe (span.), ungebrannter, luftgetrockneter Backstein aus Lehm, in Spanien und Lateinamerika für den Hausbau verwendet. [Koepf / Binding 2016]"@de,
    "Getrockneter, ungebrannter Lehmziegel, den man volkstümlich auch Ägyptischer Ziegel nannte. Gibt es in verschiedenen Formaten, etwa 230 bis 380 mm lang, 115 bis 190 mm breit und so bis 180 mm hoch. [Schrader / Voigt 2003]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_5bf6bcac;
  skos:prefLabel "Adobeziegel"@de;
