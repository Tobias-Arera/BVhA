  dct:modified "2020-10-14T18:01:13.000"^^xsd:dateTime .

:c_858b126a a skos:Concept;
  skos:definition "Dreiteiliger Architrav, dessen Mittelteil zu einer Archivolte aufgebogen ist. Vgl. Palladio-Motiv. [Koch 2009]"@de,
    "Trojdílný architráv, jehož střední část je prohnutá do archivolty (Efesos), srov. palladiovský motiv. [Koch 2008]"@cs;
