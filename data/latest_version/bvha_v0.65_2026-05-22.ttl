  dct:created "2020-07-27T18:34:01.000"^^xsd:dateTime;
  dct:modified "2021-01-30T23:48:05.000"^^xsd:dateTime .

:c_75d30f00 a skos:Concept;
  skos:definition "Sterbeglocke f; auch Scheideglocke f: die Glocke, welche beim Ableben eines Gläubigen und beim Angstläuten am Freitag zur Todesstunde Christi erklingt. [Glossarium Artis]"@de;
