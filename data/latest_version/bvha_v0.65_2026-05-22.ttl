:c_9f4d97be a skos:Concept;
  skos:definition "Geschossriegel: horizontaler, zwischen den Bundständern eines mehrgeschossigen Holzgerüstes verlaufender Riegel, auf dem die Geschossdeckenbalken aufgelegt sind.  (Eißing et al. 2012)"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_19d56a39;
