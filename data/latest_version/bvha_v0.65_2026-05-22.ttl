:c_c9937a95 a skos:Concept;
  skos:definition "Kapellenkranz, radial auf einen Mittelpunkt bezogene Kapellen, an einem halbrunden oder polygonalen Chor bzw. Chorumgang. [Koepf / Binding 2016]"@de,
    "Na tento ochoz často navazují chórové kaple jako věnec kaplí, které se otevírají směrem do chórového ochozu a bývají většinou patrné na vnějším půdorysu kostela. Jestliže se jejich osy protínají v jednom bodě, nazýváme je radiální kaple. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_37522b74;
  skos:prefLabel "Kapellenkranz"@de, "věnec kaplí"@cs;
