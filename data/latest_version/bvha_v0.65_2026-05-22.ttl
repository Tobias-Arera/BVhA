:c_9c682310 a skos:Concept;
  skos:definition "Jeder Bogen, in dessen Leibung Zierformen bzw. Maßwerkelemente wie Blatt, Nase und Pass als schmückende Details hineinreichen, ohne jedoch die eigentliche Form der Bogenlinie (als Rundbogen, Segmentbogen, Spitzbogen etc.) zu bestimmen. Zu unterscheiden von Bogen, in deren Bogenlinien selbst Maßwerkformen nachgebildet werden, wie z. B. Kleeblattbogen und Vielpassbogen. [Glossarium Artis]"@de;
  skos:scopeNote "Bogenform, die sich aus Maßwerkelementen zusammensetzt."@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "arc à réseau d\\'intrados"@fr, "arch with tracery in the intrados"@en,
    "eingeschriebener Bogen"@de;
  skos:altLabel "Maßwerkbogen"@de;
  skos:broader :c_8916f563;
  dct:created "2019-10-16T14:25:28.000"^^xsd:dateTime;
  dct:modified "2020-02-18T18:13:53.000"^^xsd:dateTime .

:c_8916f563 a skos:Concept;
  skos:definition "Bogen, der mit schmückenden Elementen wie Stern- und Perlformen, Rauten oder Voluten etc. besetzt ist oder dessen innere Bogenlinie selbst ornamental gestaltet ist, wie z. B. beim Zickzackbogen. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "decorated arch"@en, "arc orné"@fr, "Zierbogen"@de;
  skos:altLabel "ornamental arch"@en, "decorative arch"@en, "arc ornemental"@fr, "arc décoratif"@fr;
  skos:broader :c_eea5235b;
  skos:narrower :c_e33d855d, :c_9c682310, :c_a776924b, :c_9a3fd2eb, :c_6abebb28, :c_7593782e,
    :c_8241e08e, :c_41996675;
  dct:created "2019-10-21T11:53:34.000"^^xsd:dateTime;
  dct:modified "2019-12-05T13:07:42.000"^^xsd:dateTime;
  :broaderByFunction :c_eea5235b .

:c_a95e9b52 a skos:Concept;
  skos:definition "Bogen, der aus Steinen gemauert ist, die nach Material, Form und Farbe unterschiedlich sind, z.B. ein Bogen aus Backsteinen und keilförmig zugehauenen Werksteinen. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
