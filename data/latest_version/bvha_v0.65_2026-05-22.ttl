:c_1f650c8a a skos:Concept;
  skos:definition "Baugrube, Ausschachtung für ein Bauwerk oder dessen Fundamente. Das anfallende Material heißt Aushub. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
