:c_f415b5e9 a skos:Concept;
  skos:definition "Pfeilervorlage, Halbsäule, Halbpfeiler (Wandpfeiler), Pilaster u. dergl.; einem Pfeiler zur Verstärkung oder Gliederung vorgelegt. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "pier buttress"@en, "contrafuerte para pilastras"@it, "Pfeilervorlage"@de;
