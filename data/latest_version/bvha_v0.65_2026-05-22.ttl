:c_c7098093 a skos:Concept;
  skos:scopeNote "Style Plantagenet, Form der frz. Frühgotik im Anjou und Loire-Gebiet. Dreischiffige Hallenkirchen mit gleich hohen Schiffen, in der Tradition romanischer Dreitonnenhallen des Poitous. Saalkirchen ohne Wandgliederung mit Rundbogenfenstern, achtteilige gebuste Gewölbefelder mit dünnen Rippen, durch einen dünnen Rundstab statt durch einen breiten Gurt von den Nachbarjochen getrennt (\"angevinisches Gewölbe\"). [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8;
  skos:prefLabel "Style Plantagenet"@de, "style plantagenet"@cs;
  skos:broader :c_19a0a69b, :c_6a10ebdb;
  dct:created "2020-08-12T09:11:09.000"^^xsd:dateTime;
