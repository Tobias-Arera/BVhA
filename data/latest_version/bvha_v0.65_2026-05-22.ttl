  dct:modified "2019-12-05T13:32:55.000"^^xsd:dateTime;
  :broaderByConstruction :c_eea5235b .

:c_df144d51 a skos:Concept;
  skos:definition "Drei Bogen unter einem übergreifenden größeren Bogen. [Koepf / Binding 2016]"@de,
    "Drei zu einer Gruppe zusammengefasste Bogen. Sie sind gleichmäßig gereiht oder in der Höhe gestaffelt, können auch verschiedene Form und unterschiedliche Spannweite haben. Sie stehen entweder jeder für sich oder auf gemeinsamen Stützen, oft sind sie durch einen größeren Bogen überfangen. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
