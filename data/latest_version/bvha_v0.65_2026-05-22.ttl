  dct:modified "2021-01-19T12:40:33.000"^^xsd:dateTime;
  :broaderByShape :c_049c4c22 .

:c_099681fe a skos:Concept;
  skos:definition "Netzgewölbe mit besonders engem, regelmäßigen Rippenwerk und sehr kleinen Fachen. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
