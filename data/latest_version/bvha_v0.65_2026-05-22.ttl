:c_25bd046d a skos:Concept;
  skos:definition "n (mfrz. cabinet), im Schlossbau ein kleines abgeschlossenes Nebenzimmer, das entweder zu intimen Besprechungen oder aber als Ort zur Aufbewahrung kleiner Kunstgegenstände (Porzellan – München Residenz BY; Medaillen, Miniaturen – Schloss Schönbrunn A) diente. Für die Innenauskleidung von K.en kann ein besonderes Material verwendet werden, z. B. Bernstein (Königsberg R), Lack (Bayreuth BY) oder Spiegel (Ansbach BY). B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe;
  skos:prefLabel "pokoj"@cs, "Zimmer"@de;
  skos:broader :c_2d93c3e7;
