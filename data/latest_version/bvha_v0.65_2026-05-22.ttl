:c_cfdeef86 a skos:Concept;
  skos:definition "Im weiteren Sinne [Im Bezug auf Fächergwölbe] Bezeichnung für Gewölbe, bei denen sich die Rippenbündel strahlenförmig von freistehenden Stützen aus entfalten. Wie der Grundriß zeigt, handelt es sich hierbei jedoch eigentlich um Sterngewölbe. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "fächerartige Sterngewölbe"@de, "bóveda en abanico"@es, "volta a ventaglio"@it,
    "voûte en éventails (contexte plus large)"@fr, "fan vault (broader context)"@en;
  skos:altLabel "vějířová klenba"@cs, "voûte à nervures rayonnantes"@fr, "Palmengewölbe"@de,
    "Strahlengewölbe"@de, "voûte en calice "@fr, "fan groning "@en, "fan tracery vault "@en,
    "Fächergewölbe"@de, "Radialgewölbe"@de, "Baldachingewölbe"@de, "Palmettengewölbe"@de,
    "stehendes Trichtergewölbe"@de, "Rippengewölbe nach Art der Fächergewölbe"@de;
  skos:broader :c_2effa5cc;
  skos:narrower :c_114ce8fa;
  dct:created "2019-10-16T11:04:37.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:54:56.000"^^xsd:dateTime;
  :broaderByShape :c_2effa5cc .

:c_74d5a9bf a skos:Concept;
  skos:definition "Kreuzgewölbe, das durch zwei Kreuzbogen und einen Transversalbogen in sechs Kappen unterteilt ist, zwei längs- und vier quergestellte. Im sechsteiligen Kreuzgewölbe tritt häufig der Stützenwechsel auf. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "sexpartite cross vault"@en, "sechsteiliges Kreuzgewölbe"@de, "voûte d\\'arêtes hexapartite"@fr;
  skos:altLabel "hexapartite cross vault"@en, "six-part cross vault"@en, "sechskappiges Kreuzgewölbe"@de,
    "voûte d\\'ogives hexapartite "@fr, "voûte d\\'arêtes à six quartiers"@fr, "voûte d\\'ogives à six quartiers "@fr;
  skos:broader :c_5f9418c5, :c_2efb4f13;
  skos:narrower :c_c22f863d;
  dct:created "2019-02-18T23:23:40.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:11:11.000"^^xsd:dateTime;
  :broaderByShape :c_5f9418c5, :c_2efb4f13 .

:c_2efb4f13 a skos:Concept;
  skos:definition "Eine Gewölbefläche, die sich aus sechs Gewölbekappen zusammensetzt. [BVHA] "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "sexpartite vault"@en, "voûte hexapartite "@fr, "sechsteiIiges Gewölbe"@de;
