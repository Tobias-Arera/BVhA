:c_a99a5c62 a skos:Concept;
  skos:definition "Großer Vorraum im W. einer Kirche, einer Vorhalle oder einem Narthex ähnl., jedoch mehrschiffig und mehrjochig, zumeist hallenförmig und auch zweigeschossig, in Burgund ausgebildet, von den Cluniazensern verbreitet und in Deutschland bes. von der Hirsauer Kongregation übernommen. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
