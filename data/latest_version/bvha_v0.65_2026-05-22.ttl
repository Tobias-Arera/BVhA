:c_df212cbd a skos:Concept;
  skos:definition "Nur in der Höhe der Fensterzone, nicht in der des ganzen Stockwerks vorspringender Erker. Der F. kommt auch im Fachwerkbau vor, wo er durch Verdoppelung des Brustriegels und des Sturzriegels unter und über der Fensteröffnung gewonnen wird. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Fenstererker"@de;
  skos:broader :c_70f41797;
  dct:created "2020-09-14T12:23:10.000"^^xsd:dateTime;
  dct:modified "2021-01-22T12:29:00.000"^^xsd:dateTime .

