:c_3cca5a05 a skos:Concept;
  skos:definition "Altes Mauerziegelformat, z.B. als Holsteiner Acht-Zoll-Format 190 x 90 x40 mm. [Schrader / Voigt 2003]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_5bf6bcac;
  skos:prefLabel "Acht-Zoll-Ziegel"@de;
  skos:broader :c_0cb8deb1;
  dct:created "2020-01-17T09:56:52.000"^^xsd:dateTime;
  dct:modified "2021-03-19T18:29:58.000"^^xsd:dateTime .

:c_4347d3c0 a skos:Concept;
  skos:definition "Handgeformter Mauerziegel aus der Zeit der österreichisch-ungarischen Monarchie (1869-1918), der deren Herrschaftssymbol, den doppelköpfigen Adler, als Prägung trägt. [Schrader / Voigt 2003]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_5bf6bcac;
  skos:prefLabel "Adlerziegel"@de;
  skos:altLabel "Doppeladlerziegel"@de;
  skos:broader :c_0cb8deb1;
  dct:created "2020-01-17T15:50:47.000"^^xsd:dateTime;
  dct:modified "2021-03-19T18:30:05.000"^^xsd:dateTime .

:c_3a122a0a a skos:Concept;
  skos:definition "Großformatiger Ziegel mit verschiedenen Abmessungen, z.B. 350 x 350 x 90 mm oder 300 x 180 x 70 mm oder 310 x 180 x 70 mm. [Schrader / Voigt 2003]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_5bf6bcac;
  skos:prefLabel "altbabylonischer Mauerziegel"@de;
  skos:broader :c_0cb8deb1;
  dct:created "2020-11-20T17:05:52.000"^^xsd:dateTime;
  dct:modified "2021-03-19T18:30:12.000"^^xsd:dateTime .

:c_af0a8268 a skos:Concept;
  skos:definition "Bezeichnung für einen altbayerischen Vormauerziegel, den es als Handstrichziegel mit verschiedenen Abmessungen gab, z.B. 295 x 145 x 65 mm oder 340 x 165 x 70 mm oder 320 x 120 x 50 mm. [Schrader / Voigt 2003]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_5bf6bcac;
  skos:prefLabel "altbayerischer Mauerziegel"@de;
  skos:broader :c_0cb8deb1;
  dct:created "2020-11-20T17:08:52.000"^^xsd:dateTime;
  dct:modified "2021-03-19T18:30:19.000"^^xsd:dateTime .

:c_183127e8 a skos:Concept;
  skos:definition "(1) In der älteren Literatur nach 1872 zunächst alle Ziegel in nicht metrischen Mauerziegelformaten, die noch in Zoll und Fuß gemessen wurden und vom Reichsformat von 1872 abgelöst wurden. (2) Heute alle Ziegel, die noch nicht in dem DIN- Ziegelformat von 1952 gefertigt wurden, also auch die Reichsformatziegel von 1872. [Schrader / Voigt 2003]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_5bf6bcac;
  skos:prefLabel "Altmaßziegel"@de;
  skos:broader :c_0cb8deb1;
  dct:created "2020-11-20T18:04:26.000"^^xsd:dateTime;
  dct:modified "2021-03-19T18:30:26.000"^^xsd:dateTime .

:c_5307e97d a skos:Concept;
  skos:definition "Andere Bezeichnung für den römischen Leistenziegel. [Schrader / Voigt 2003]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_5bf6bcac;
  skos:prefLabel "embrice"@fr, "lip"@en, "Leistenziegel"@de, " tejuela de listones"@es;
  skos:altLabel "altrömischer Ziegel"@de, "römischer Leistenziegel"@de;
  skos:broader :c_0cb8deb1;
  dct:created "2020-11-20T18:15:44.000"^^xsd:dateTime;
  dct:modified "2021-03-19T18:31:54.000"^^xsd:dateTime .

:c_7303a46f a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_ec8c77bf;
  skos:prefLabel "calcite crust"@en, "povlak uhličitanu vápenatého"@cs, "Kalksinterhaut"@de;
  skos:altLabel "Sinterhaut"@de;
  skos:note "A thin film of calcium carbonate which forms on lime water or on a lime plaster surface as a result of the reaction of carbon dioxide from the air with calcium hydroxide (carbonation). [EwaGlos]"@en,
    "Eine dünne, feinkristalline Schicht aus Calciumcarbonat, die auf Kalkwasser oder auf einer Kalkputzoberfläche gebildet wird – als Ergebnis der Reaktion von Kohlendioxid aus der Luft mit Calciumhydroxid (Karbonatisierung). [EwaGlos]"@de;
  skos:broader :c_e6f0e9cc;
  dct:created "2019-06-11T21:08:13.000"^^xsd:dateTime;
  dct:modified "2020-07-08T15:02:27.000"^^xsd:dateTime .

:c_4ba459b4 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe;
  skos:prefLabel "Kratzputz"@de, "škrábaná omítka"@cs;
  skos:broader :c_e6f0e9cc;
  dct:created "2019-07-15T13:14:52.000"^^xsd:dateTime;
  dct:modified "2020-07-08T14:37:48.000"^^xsd:dateTime .

:c_11561872 a skos:Concept;
  skos:definition "Nachahmung des Aussehens eines Quaderbaus durch Ziehen von Scheinfugen im Putz (Quaderputz) oder durch Bemalung. [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "carroyage"@fr, "Quadrierung"@de, " cuadrícula"@es, "kvádrování"@cs;
  skos:altLabel "Quaderputz"@de, "kvádrová omítka"@cs, "omítková bosáž"@cs;
  skos:broader :c_e6f0e9cc;
  dct:created "2020-08-21T16:17:02.000"^^xsd:dateTime;
  dct:modified "2020-11-26T09:16:31.000"^^xsd:dateTime .

:c_a1ae099d a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe;
  skos:prefLabel "aufgemalte Fuge"@de;
  skos:broader :c_e6f0e9cc;
  dct:created "2020-08-24T15:43:36.000"^^xsd:dateTime .

:c_0fba563a a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe;
  skos:prefLabel "eingeritze Fuge"@de;
  skos:broader :c_e6f0e9cc;
  dct:created "2020-08-24T15:43:50.000"^^xsd:dateTime .

:c_d4d8213a a skos:Concept;
  skos:definition "(1) Ein Putz mit wellenartiger, rustikaler Struktur, der durch Mörtelanwurf mit Kelle und anschließendem Verwaschen mit einem Schwamm erreicht wird, deshalb auch mundartlich Waschelputz genannt wird. (2) Putzaufbau, auch als Rusticoputz oder Modellierputz bezeichnet, bei dem auf einem ebenen Unterputz grobkörniger Mörtel in allen Richtungen verrieben wird. [Schrader / Voigt 2003]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_5bf6bcac;
  skos:prefLabel "altdeutscher Putz"@de;
  skos:altLabel "Rusticoputz"@de;
  skos:broader :c_e6f0e9cc;
  dct:created "2020-11-20T17:29:27.000"^^xsd:dateTime;
  dct:modified "2020-11-20T17:31:54.000"^^xsd:dateTime .

:c_11c9287f a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_37522b74, :conceptScheme_ec8c77bf;
  skos:prefLabel "terracotta (product of clay)"@en, "terakota"@cs, "Terracotta (Tonprodukt)"@de;
  skos:altLabel "Terrakotta"@de, "terra cotta"@de;
  skos:note "A glazed or unglazed product made with clay and mixed with fillers (grog – calcinated clay, chamotte, brick dust or pot clay) and natural binders which are then baked at a high temperature (above 600 °C). [EwaGlos]"@en,
    "Ein glasiertes oder unglasiertes Produkt aus Ton, das vermischt mit Zusatzmitteln (Schamotte – kalzinierter Ton, Ziegelmehl oder Attapulgit) und natürlichen Bindemitteln bei hohen Temperaturen (über 600 °C) gebrannt wird. [EwaGlos]"@de,
    "Lat. terra = země, hlína, ital. cotta = pálená) Hlína, která vypálením dostane bílou, žlutou, hnědou nebo červenou barvu; pro odolnost vůči klimatickým vlivům se používala často jako stavební keramika (chrámové štíty, antefixy) nebo v plastice (starořecké figurky z Tanagry, v renesanci ji používali především Donatello, Robbia). [Koch 2008]"@cs;
  skos:broader :c_11ec36ef;
  skos:related :c_380577c3;
  dct:created "2019-07-05T20:52:12.000"^^xsd:dateTime;
  dct:modified "2020-08-24T10:26:31.000"^^xsd:dateTime .

:c_380577c3 a skos:Concept;
  skos:definition "Terrakotta (lat. terra = Erde, ital. cotta = gebrannt), Tonerde, die durch den Brand weiß, gelb, braun oder rot wird. Wegen ihrer Wetterbeständigkeit oft als Bau-Keramik (Tempelgiebel, Stirnziegel) oder zu Tonbildwerken verwendet (altgriech. Tanagrafigürchen; in der Renaissance besonders durch Donatello, Robbia angewandt). [Koch 2009]"@de,
    "Unglasierter, gebrannter Ton als Baukeramik, meist dekoriert (Fries) und mit Reliefs geschmückt. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_8c0441f9;
  skos:prefLabel "Terracotta"@de;
  skos:broader :c_bvscnjkx;
  skos:related :c_11c9287f, :c_60a06338;
  dct:created "2020-08-06T10:30:54.000"^^xsd:dateTime;
  dct:modified "2020-08-31T16:54:48.000"^^xsd:dateTime .

:c_60a06338 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ec8c77bf;
  skos:prefLabel "terracotta"@en, "Terracotta (Baumaterial)"@de;
  skos:altLabel "Terrakotta"@de, "terra cotta"@de;
  skos:note "Any kind of baked or semi-fired clay used to create utilitarian or decorative objects, or structural forms such as: floor tiles, roof tiles or decorative architectural elements. [EwaGlos]"@en,
    "Jede Art von gebranntem oder niedrig gebranntem Ton zur Herstellung von Gebrauchsoder Dekorationsobjekten und Bauelementen, wie Bodenfliesen, Dachziegeln oder dekorativen architektonischen Elementen. [EwaGlos]"@de;
  skos:broader :c_11ec36ef;
  skos:related :c_380577c3;
  dct:created "2019-07-05T21:01:47.000"^^xsd:dateTime;
  dct:modified "2020-08-17T10:18:52.000"^^xsd:dateTime .

:c_c68fefae a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe;
  skos:prefLabel "Türbeschlag"@de, "dveřní kování"@cs;
