:c_aedda11d a skos:Concept;
  skos:definition "Lichtdorn m; Dorn m; auch Kerzenstachel m; Einsteckdorn m: die Metallspitze auf dem Leuchter, auf den die Kerze gesteckt wird. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
