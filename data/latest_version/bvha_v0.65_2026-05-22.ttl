  dct:created "2020-02-18T16:16:05.000"^^xsd:dateTime;
  dct:modified "2021-01-22T15:59:58.000"^^xsd:dateTime .

:c_6c6b65da a skos:Concept;
  skos:definition "Die Auflage von weiteren Steinen über den Graten zur besseren Aufnahme der Schubkräfte. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
