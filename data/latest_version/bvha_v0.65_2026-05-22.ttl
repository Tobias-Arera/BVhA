  skos:definition "Zwerchhaus (zwerch = quer), geschosshohes Dachhäuschen in der Hausflucht und unter einem Zwerchdach. [Koch 2009]"@de,
    "Podkrovní obytný prostor ve výši podlaží zastřešený boční stříškou. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_37522b74,
