:c_da0504c3 a skos:Concept;
  skos:definition "Aus vorkragenden Steinschichten gemauerter Bogen, man spricht auch von einem Bogen mit horizontalen Fugen. Kragbogen sind charakteristisch für die Baukunst der Maya in Mittelamerika. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "corbel arch"@en, "arc en tas-de-charge"@fr, "Kragbogen"@de;
  skos:altLabel "corbelled arch"@en, "arc en encorbellement"@fr, "Kragsteinbogen"@de;
  skos:broader :c_d1311ee4;
  skos:narrower :c_83789b81;
  skos:related :c_f644efa6;
  dct:created "2019-02-18T22:34:41.000"^^xsd:dateTime;
  dct:modified "2019-10-21T14:16:20.000"^^xsd:dateTime .

:c_d1311ee4 a skos:Concept;
  skos:definition "Ein Bogen, der nur aus vorkragenden Steinen mit horizontalen Parallelfugen gemauert ist (unechtes Gewölbe). [Koepf / Binding 2016]"@de,
    "Bogenförmige Überdeckung einer Maueröffnung, die nicht aus Keilsteinen oder aus Backsteinen etc. mit Keilfugen konstruiert ist, sondern die z. B. aus einem bogenförmig ausgerundeten Monolithstein besteht oder aus übereinandergelegten, vorkragenden Steinschichten mit horizontalen Fugen gebildet wird; sie kann auch aus Holz gefertigt bzw. aus Beton gegossen sein. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "unechter Bogen"@de, "arco falso"@es, "pseudoarco"@it, "faux-arc"@fr,
    "false arch"@en;
  skos:altLabel "corbel arch"@en, "pseudo-arch"@en, "pseudo-arc"@fr, "Scheinbogen"@de,
    "falscher Bogen"@de, "Pseudobogen"@de;
  skos:broader :c_eea5235b;
  skos:narrower :c_da0504c3, :c_f644efa6, :c_9a6c71e7, :c_59b8ef4e;
  dct:created "2019-10-21T13:54:56.000"^^xsd:dateTime;
  dct:modified "2020-08-27T16:10:27.000"^^xsd:dateTime;
  :broaderByConstruction :c_eea5235b .

:c_f644efa6 a skos:Concept;
  skos:definition "Einem Staffelgiebel ähnelnde Überdeckung einer Öffnung, vergleichbar dem Kragbogen, jedoch von bewusst erstrebter künstlerischer Form. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "corbel arch with stepped intrados"@en, "arc en tas-de-charge à ressauts"@fr,
    "Treppenbogen"@de;
  skos:altLabel "Stufenbogen"@de;
  skos:broader :c_d1311ee4;
  skos:related :c_da0504c3;
  dct:created "2019-10-21T14:25:21.000"^^xsd:dateTime;
  dct:modified "2019-10-21T14:29:19.000"^^xsd:dateTime .

:c_83789b81 a skos:Concept;
  skos:definition "Unechter Bogen, bei dem die vorkragenden Steine an ihrer Unterseite derart behauen werden, dass die gewünschte Bogenlinie entsteht."@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "arc en tas-de-charge délardé"@fr, "chamfered corbel arch"@en, "abgefaster Kragbogen"@de;
  skos:broader :c_da0504c3;
