:c_389b7332 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_ec8c77bf;
  skos:prefLabel " mosaïque"@fr, "mozaika"@cs, "mosaic"@en, "mosaico"@it, "mosaico"@es,
    "Mosaik"@de;
  skos:note "Decoration made of small coloured pieces of various materials (tesserae) applied on interior or exterior surfaces and embedded in several layers of mortar. [EwaGlos]"@en,
    "Dekoration aus kleinen, farbigen Teilen aus verschiedenen Materialien (Tesserae), die auf Innen- oder Außenflächen aufgebracht und in mehrere Mörtellagen gebettet werden. [EwaGlos]"@de;
  skos:broader :c_a1b21914;
  skos:narrower :c_e3404b66, :c_4ad58c08;
  dct:created "2019-07-05T21:07:08.000"^^xsd:dateTime;
  dct:modified "2020-12-01T16:02:57.000"^^xsd:dateTime .

:c_73aa1d6e a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_ec8c77bf;
  skos:prefLabel "béton apparent"@fr, "pohledový beton"@cs, "exposed aggregate"@en,
    "calcestruzzo faccia a vista"@it, "hormigón a la vista"@es, "Sichtbeton"@de;
  skos:altLabel "exposed concrete"@en, "fair-faced concrete"@en, "brut concrete"@en,
    "beton brut"@en, "dekorativní beton"@cs, "beton s upraveným lícem"@cs;
  skos:note "A smooth architectural surface made without plaster. The surface is made of very fine concrete which consists of fluid cement and small grained aggregate that exposes the forms and structures of the shuttering. [EwaGlos]"@en,
    "Eine glatte Architekturoberfläche ohne Verputz. Die Oberfläche wird aus sehr feinem Beton hergestellt, der aus flüssigem Zement und feinkörnigem Zuschlag besteht und die Form und Struktur der Schalung zeigt. [EwaGlos]"@de,
    "Auf Sicht berechneter und durch ausgewählte Zuschlagstoffe und Schalung gestalteter Beton, bes. in den 1950/60er Jahren im Betonbau als Gestaltungsmittel eingesetzt. [Koepf / Binding 2016]"@de;
  skos:broader :c_a1b21914;
  dct:created "2019-07-14T16:58:21.000"^^xsd:dateTime;
  dct:modified "2020-11-27T14:52:03.000"^^xsd:dateTime .

:c_f5ac1ba2 a skos:Concept;
  skos:definition "Bekleidung eines Mauerkörpers mit verschiedenfabigen Platten aus kostbareren Materialien wie Stein, Marmor und Ton, auch das Anbringen von Putz und Stuck. [Glossarium Artis, Bd. 3, Bögen und Mauerwerk]"@de,
    "Inkrustation (lat. crusta = Rinde), Einlegearbeit von farbigen Steinen in Stein, bei der z.B. heller und dunkler Marmor wechseln (besonders in Wänden und Fußböden). Blütezeit: Antike, Byzantinische Kunst, Italien vom Mittelalter bis Barock. [Koch 2009]"@de;
  skos:scopeNote "Inkrustation (lat.), Bekleidung von Wänden und Fassaden aus verschiedenfarbigen Blendsteinen, die oft in Anlehnung an konstruktive Vorbilder rein ornamental angebracht sind. Bekannt sind die Cosmatenarbeiten sowie die I.en an Bauten der Protorenaissance in Italien. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_8c0441f9, :conceptScheme_1f14b4dd;
  skos:prefLabel "incrustation"@fr, "inkrustation"@en, "Inkrustation (Architekturoberfläche)"@de,
    "inkrustace"@cs;
  skos:broader :c_a1b21914;
  dct:created "2019-07-15T13:42:02.000"^^xsd:dateTime;
  dct:modified "2020-08-24T16:55:48.000"^^xsd:dateTime .

:c_34d52f00 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_ec8c77bf;
  skos:prefLabel "glazed decorations"@en, "glazovaná výzdoba fasád"@cs, "glasierter Bauschmuck"@de;
  skos:note "Façade and interior wall ornaments made with polychrome and glazed bricks or terracotta tiles. [EwaGlos]"@en,
    "Ornamente an Fassaden und Innenwänden aus polychrom glasierten Ziegeln oder Terrakottafliesen. [EwaGlos]"@de;
  skos:broader :c_a1b21914;
  dct:created "2019-07-24T19:12:03.000"^^xsd:dateTime;
  dct:modified "2020-07-08T13:59:14.000"^^xsd:dateTime .

:c_b991a9cc a skos:Concept;
  skos:definition "Hohlfuge, Fuge, bei der der Mörtel hinter die Vorderkante der Steine zurücktritt, so dass die einzelnen Steine in der Ansicht scharf hervortreten. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Hohlfuge"@de, "joint creux"@fr;
  skos:broader :c_a1b21914;
