:c_9291076a a skos:Concept;
  skos:definition "Blasiuskerzen f pl: zwei dem hl. Basilius geweihte Kerzen, mit denen sein besonderer Segen verbunden ist. Sie stecken in zwei kreuzförmig angeordneten MetallhüIsen. Laut Ritenkongregation wird der Segen auch dann wirksam, wenn die Kerzen nicht angezündet werden. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd, :conceptScheme_b16d0aff;
  skos:prefLabel "cierge de Saint Blaise"@fr, "candle of St. Blase"@en, "Blasiuskerze"@de;
  skos:broader :c_65b847bf;
  dct:created "2020-07-28T17:45:38.000"^^xsd:dateTime;
  dct:modified "2021-01-26T21:09:33.000"^^xsd:dateTime .

:c_6bfb6557 a skos:Concept;
  skos:definition "Sterbekerze f: eine gesegnete Kerze, die bei der Commendatio animae brennt. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "cierge funèbre"@fr, "funeral candle"@en, "Sterbekerze"@de;
  skos:broader :c_65b847bf;
  dct:created "2020-07-28T17:58:29.000"^^xsd:dateTime;
  dct:modified "2021-01-26T21:09:55.000"^^xsd:dateTime .

:c_ab6df022 a skos:Concept;
  skos:definition "Votivkerze f: eine Kerze, die mit der Ablegung eines Gelübdes verbunden ist. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "cierge votive"@fr, "votive candle"@en, "Votivkerze"@de;
