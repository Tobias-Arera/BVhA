:c_917c02e2 a skos:Concept;
  skos:definition "Als Stocksparren stockhoch abgebunden im mehrstöckigen Dachwerk. [Eißing et al. 2012]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_19d56a39;
