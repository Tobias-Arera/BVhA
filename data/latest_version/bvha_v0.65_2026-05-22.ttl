:c_9d6e0f16 a skos:Concept;
  skos:definition "Gynäkeoin, Gynaikeion (gr.), Frauengemach des gr. Wohnhauses im Gegensatz zum Wohnteil der Männer (Andronitis). [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
