:c_01f6e5c1 a skos:Concept;
  skos:definition "Lady Chapel (engl. Kapelle Unserer Lieben Frau), Marienkapelle in englischen Kathedralen, meist mit rechteckigem Grundriss und meist an den Scheitel des Ostchores angesetzt (Scheitelkapelle). [Koch 2009]"@de,
    "Lady Chapel, angl. kaple Macky boží), kaple P. Marie v anglických katedrálách, většinou obdélníkového půdorysu, většinou v závěru východního chóru (kaple v závěru chóru, Salisbury). [Koch 2008]"@cs,
    "Lady Chapel, der Maria geweihte und nach außen vorstehende Scheitelkapelle am Ostende einer engl. Kathedrale. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "Lady Chapel"@de, "Lady Chapel"@cs;
  skos:broader :c_a5f0b363;
  dct:created "2020-07-23T12:58:16.000"^^xsd:dateTime;
  dct:modified "2021-01-22T12:13:52.000"^^xsd:dateTime;
  :broaderByFunction :c_a5f0b363 .

