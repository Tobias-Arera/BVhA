:c_40c1f31b a skos:Concept;
  skos:definition "Liber pontificalis m, Papstbuch n: Sammlung von Lebensbeschreibungen der Päpste, die bis in das 6. Jh. zurückreicht; zu unterscheiden vom Pontifikale. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "libre pontifical"@fr, "liber pontificalis"@cs, "Liber pontificalis"@de;
