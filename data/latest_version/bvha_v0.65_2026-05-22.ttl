  dct:created "2020-08-18T13:42:19.000"^^xsd:dateTime;
  dct:modified "2020-11-27T17:32:03.000"^^xsd:dateTime .

:c_4f5d0dfb a skos:Concept;
  skos:definition "Raumüberdeckung aus Kreuzhölzern (Riemchen), in die die Bohlen eingenutet sind, ein außerordentl. dichter Abschluss, bes. in süddt. Fachwerkhäusern bis ins 18./19. Jh. üblich. [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
