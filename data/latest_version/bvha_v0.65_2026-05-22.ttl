  :broaderByConstructionMaterial :c_6bbfbe49 .

:c_439d7c1b a skos:Concept;
  skos:definition "Der Kantholzblockbau (regional Strickbau) besteht aus Balken mit hochrechteckigem Querschnitt, mit einer Breite zwischen 9 cm und 15 cm. Die Höhe der Kanthölzer schwankt zwischen 25 cm und 30 cm, zuweilen erreicht das Wurzelende (Stockende) bis zu 50 cm. Der Kantholzblockbau mit verzinkten Ecken wird als verzinkter Blockbau bezeichnet. (Eißing et al. 2012)"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c8a571d9,
    :conceptScheme_1f14b4dd, :conceptScheme_19d56a39;
  skos:prefLabel "squared log construction"@en, "construction en madriers"@fr, "Kantholzblockbau"@de;
  skos:altLabel "Strickbau"@de, "construction en bois équarri (pièce sur pièce)"@fr;
  skos:broader :c_93fd7d9a;
  skos:narrower :c_a102cd20;
  skos:related :c_05c2e78a;
  dct:created "2019-05-15T09:06:36.000"^^xsd:dateTime;
  dct:modified "2021-01-26T23:17:01.000"^^xsd:dateTime;
  :broaderByConstruction :c_93fd7d9a .

:c_05c2e78a a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8;
  skos:prefLabel "Kantholzblockbauweise"@de;
  skos:broader :c_feda08b4;
  skos:related :c_439d7c1b;
  dct:created "2020-12-15T12:36:57.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:08:20.000"^^xsd:dateTime;
  :broaderByConstruction :c_feda08b4 .

:c_b8663798 a skos:Concept;
  skos:definition "Im Unterschied [zum Rund- oder Vollholzblockbau] werden beim Hälblingsblockbau die Stämme der Länge nach gespalten oder gesägt und als halbrunde Blockhölzer oder als kantig beschlagene Halbhölzer verbaut.  (Eißing et al. 2012) "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c8a571d9,
    :conceptScheme_19d56a39;
  skos:prefLabel "Hälblingsblockbau"@de;
  skos:broader :c_93fd7d9a;
  skos:related :c_cb5a5fa3;
  dct:created "2019-05-15T09:09:35.000"^^xsd:dateTime;
  dct:modified "2021-01-26T23:16:44.000"^^xsd:dateTime;
  :broaderByConstruction :c_93fd7d9a .

:c_cb5a5fa3 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8;
  skos:prefLabel "Hälblingsblockbauweise"@de;
  skos:broader :c_feda08b4;
  skos:related :c_b8663798;
  dct:created "2020-12-15T12:34:08.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:08:09.000"^^xsd:dateTime;
  :broaderByConstruction :c_feda08b4 .

:c_5c0e060d a skos:Concept;
  skos:definition "Der Rund- oder Vollholzblockbau aus ganzen Baumstämmen ist die bearbeitungstechnisch einfachste Art des Blockbaus.  (Eißing et al. 2012) "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c8a571d9,
    :conceptScheme_1f14b4dd, :conceptScheme_19d56a39;
  skos:prefLabel "round log construction"@en, "construction en grumes"@fr, "Rundblockbau"@de;
  skos:altLabel "Vollholzblockbau"@de, "construction en rondins (pièce sur pièce)"@fr;
  skos:broader :c_93fd7d9a;
  skos:related :c_437ba507;
  dct:created "2019-05-15T09:10:00.000"^^xsd:dateTime;
  dct:modified "2021-01-26T23:17:54.000"^^xsd:dateTime;
  :broaderByConstruction :c_93fd7d9a .

:c_437ba507 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8;
  skos:prefLabel "Rundblockbauweise"@de;
  skos:broader :c_feda08b4;
  skos:related :c_5c0e060d;
  dct:created "2020-12-15T12:42:11.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:10:42.000"^^xsd:dateTime;
  :broaderByConstruction :c_feda08b4 .

:c_84aedafe a skos:Concept;
  skos:definition "Beim sogenannten lockeren oder offenen Blockbau sind Kant- oder Rundhölzer mit deutlichen Abständen aufgesetzt. Die lockere Schichtung erlaubt eine Belüftung, weshalb der offene Blockbau vor allem bei landwirtschaftlich genutzten Gebäuden wie Scheunen und Heustadeln zu finden ist. Die Abstände werden durch die Ausbildung der Eckverbindung vorgegeben und durch Distanzhölzer im Wandverlauf gestützt. (Eißing et al. 2012) "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c8a571d9,
    :conceptScheme_19d56a39;
  skos:prefLabel "lockerer Blockbau"@de;
  skos:altLabel "offener Blockbau"@de;
  skos:broader :c_93fd7d9a;
  skos:related :c_8278bb17;
  dct:created "2019-05-15T09:25:15.000"^^xsd:dateTime;
  dct:modified "2021-01-26T23:17:41.000"^^xsd:dateTime;
  :broaderByConstruction :c_93fd7d9a .

:c_8278bb17 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8;
  skos:prefLabel "lockere Blockbauweise"@de;
  skos:broader :c_feda08b4;
  skos:related :c_84aedafe;
  dct:created "2020-12-15T12:42:33.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:08:32.000"^^xsd:dateTime;
  :broaderByConstruction :c_feda08b4 .

:c_0e49c61f a skos:Concept;
  skos:definition "Verbindung von zwei Balken, Bohlen oder Brettern (Rahmen), die (meist unter 45°) schräg aneinanderstoßen, so dass die Gehrlinie durch die Winkelhalbierende gebildet wird. Je nach der Profilierung des Rahmens spricht man von einer Grat- bzw. Winkelg. [Koepf / Binding 2016]"@de,
    "Verbindung zweier Teile mit demselben Profil, bei der die Stoßfuge so schräg geschnitten wird, dass sie die Winkelhalbierende der zu verbindenden Teile bildet. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_b41bd73a;
  skos:prefLabel "Gehrung"@de;
  skos:altLabel "Kehrung"@de;
  skos:broader :c_88b4f652, :c_194f23d8;
  dct:created "2019-06-18T16:48:39.000"^^xsd:dateTime;
  dct:modified "2021-03-19T18:51:40.000"^^xsd:dateTime .

:c_8934bda5 a skos:Concept;
  skos:definition "Zahnartig ineinandergreifende Ausschnitte zur schubsicheren Holzverbindung. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "assemblage en adents"@fr, "formación de denticulos"@es, "denticulation"@en,
    "Verzahnung"@de;
  skos:altLabel "addentellato"@it, "immorsatura"@it, "endenture"@fr, "indenting"@en;
  skos:broader :c_88b4f652;
  dct:created "2020-08-05T10:49:57.000"^^xsd:dateTime;
  dct:modified "2021-03-19T18:55:12.000"^^xsd:dateTime .

:c_a32ccb15 a skos:Concept;
  skos:definition "Schubsichere Verbindung zweier Teile durch Dübel. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "entarugar"@es, "dowel joint"@en, "Verdübelung"@de, "spojení hmoždíky"@cs,
    "spinatura"@it;
  skos:altLabel "dowelling"@en, "hmoždíkový spoj"@cs;
  skos:broader :c_88b4f652;
  dct:created "2020-08-05T12:07:07.000"^^xsd:dateTime;
  dct:modified "2021-03-19T18:54:36.000"^^xsd:dateTime .

:c_0fd116a0 a skos:Concept;
  skos:definition "Verblattung, eine Holzverbindung mittels eines Blatts. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "přeplátování"@cs, "assemblage à mi-paune"@fr, "ensamble media madera"@es,
    "halving"@en, "Überblattung"@de, "giunto a mezzo legno"@it;
