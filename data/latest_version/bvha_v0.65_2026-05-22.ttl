:c_5ogzoa7b a skos:Concept;
  skos:definition "Backstein, (lat. later), aus Ton oder Lehm geformter Baustein, der im Unterschied zum luftgetrockneten B. durch Brennen gehärtet und wetterfest gemacht ist, meist längsrechteckiges Format, dessen Größe sich aus den jeweiligen techn. Gegebenheiten und aus traditionellen Verfahren in den Verbreitungsgebieten ergibt. Die Farbe hängt von der chem. Zusammensetzung des Rohmaterials und von der Brenntemperatur ab, auch farbige Glasuren sind möglich. Zur Verbindung von Backsteinen zu Mauern s. Mauerwerk, zur Verwendung als Dachdeckung s. Ziegel. [Koepf / Binding 2016]"@de,
    "Cihla z jílu nebo hlíny, tvrzená proti meteorologickým vlivům (pále­ná). [Koch 2008]"@cs,
    "Altes Mauerziegelformat, z.B. als Holsteiner Acht-Zoll-Format 190 x 90 x 40 mm. [Schrader / Voigt 2003]"@de,
    "Ziegelstein, Ziegel, aus Ton oder Lehm wetterfest gehärtet (gebrannt). [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_8c0441f9;
  skos:prefLabel "Ziegel"@de, "cihla"@cs;
  skos:altLabel "Backstein"@de;
  skos:editorialNote "Bitte Begriffe für \"Ziegel\" (Dachziegel) und \"Backstein\" genau umgekehrt verwenden - hier auch die narrower nachführen (TAR)"@de;
  skos:broader :c_2pqtnskw;
  skos:narrower :c_0cb8deb1, :c_36751d31, :c_89bb0645, :c_7becmxjs;
  dct:created "2019-05-07T14:22:43.000"^^xsd:dateTime;
  dct:modified "2025-11-04T23:28:04"^^xsd:dateTime .

