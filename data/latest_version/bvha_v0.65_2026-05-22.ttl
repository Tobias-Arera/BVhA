:c_702f391a a skos:Concept;
  skos:scopeNote "Temenos, altis, řecký chrámový a kultovní okrsek obehnaný hradbou. [Koch 2008]"@cs,
    "Temenos, Altis, ummauerter griechischer Tempel-, Kultbezirk. [Koch 2009]"@de, "Ein heiliger Bezirk, in dessen Zentrum einer oder mehrere Tempel stehen und der von einer Mauer umgeben wird, an deren Innenseite Kammern (Schatzhäuser) oder Säulenhallen liegen können. Der T. ist durch einen oder mehrere Torbauten (Propylon) zugängl. In Griechenland wird der T. Temenos, Altis oder Peribolos, in Rom häufig Kapitol genannt. Auch in Indien, Ostasien und in Altamerika gibt es große T.e, die durch eine Einfriedung (Prakdra, Vedika) abgeschlossen und durch Torbauten (in Indien: Gopuram) zugängl. sind und in denen mehrere Tempel, Pagoden oder andere Kultbauten stehen, manchmal auch heilige Teiche (in Indien: Teppakulam) liegen. [Koepf / Binding 2016]"@de,
    "Altis (gr.), Temenos, Peribolos, Bezeichnung für einen griechischen Tempelbezirk. [Koepf / Binding 2016]"@de,
    "Peribolos (gr.), Temenos, der einen Tempel umgebende, oft durch Säulenhallen begrenzte Bezirk. [Koepf/Binding 2016]"@de,
    "Temenos (gr.), Altis, auch Peribolos; der durch eine Mauer oder Säulenhalle begrenzte und durch ein Propylon zugängl. gr. Tempelbezirk. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "recinto del templo"@es, "area sacra"@it, "peribolos"@cs, "temple precinct"@en,
    "Tempelbezirk (Lokalität)"@de;
  skos:altLabel "Peribolos"@de, "Altis (griech.)"@de, "Temenos (griech.)"@de, "chrámový okrsek"@cs;
  skos:broader :c_0c109f15;
  dct:created "2020-08-10T15:51:59.000"^^xsd:dateTime;
  dct:modified "2025-12-10T15:01:23"^^xsd:dateTime .

