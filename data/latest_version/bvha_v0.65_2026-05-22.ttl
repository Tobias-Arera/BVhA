:c_15137f46 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ef0a8695,
    :conceptScheme_ec8c77bf;
  skos:prefLabel "Wachs"@de, "wax"@en;
  skos:note "A solid or semi-solid, slightly greasy, water-insoluble, organic substance, principally containing compounds of high molecular weight. They are derived from animals, plants, petroleum or are synthetic in origin. [EwaGlos]"@en,
    "Eine feste oder halbfeste, leicht fettige, wasserunlösliche, organische Substanz, die hauptsächlich aus Verbindungen mit hohem Molekulargewicht besteht. Diese werden aus Tieren und deren Absonderungen, Pflanzen und Erdöl gewonnen oder synthetisch hergestellt. [EwaGlos]"@de;
  skos:broader :c_4f3228a9, :c_9jb9am2u, :c_bci8b96z, :c_14be9de2;
  skos:related :c_f861ef30, :c_46f2f1d7, :c_a9c01a56;
