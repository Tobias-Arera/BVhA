:c_c9e20fdd a skos:Concept;
  skos:definition "Sacrarium n: Buch mit den Vorschriften für die Weihe der liturgischen Geräte, des Wassers, der Kerzen usw. [Glossarium Artis]"@de,
    "Grube oder Behälter südl. neben dem Altar oder in der südl. Sakristei zur Aufnahme unbrauchbar gewordener geweihter Gegenstände (Baumwolle, Kerzen, Asche) sowie des zu liturg. Waschungen (Lavabo) verwendeten Wassers. Das S. ist häufig mit durchlochter Steinplatte oder kleinem Puteal (Eingussbecken) abgedeckt. Auch neben oder unter dem Taufstein soll ein S. sein. Verbreitet im frühen MA, in der weiteren Entwicklung des 13./ 14. Jhs. als Piscina in der Südwand des Chors oder der Sakristei. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "Sacrarium"@de, "sacrarium"@fr;
  skos:altLabel "rituel de bénédictions"@fr;
  skos:broader :c_6ca61a95;
  skos:related :c_1d666449, :c_1b2278c2;
  dct:created "2020-05-22T17:45:07.000"^^xsd:dateTime;
  dct:modified "2021-01-23T16:41:57.000"^^xsd:dateTime .

:c_ea59b5fa a skos:Concept;
  skos:definition "Schultervelum n, velum humerale: langes, aus dem Offertorium entstandenes, streifenförmiges Seidentuch, das um die Schultern gelegt wird und mit dessen Enden die Hände zur Berührung der Vasa sacra verhüllt werden. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "Schultervelum"@de, "ramenní velum"@cs, "echarpe"@fr, "velum humerale"@la,
    "humeral veil"@en;
  skos:altLabel "voile humérale "@fr, "sudarium"@en;
  skos:broader :c_ce128b66, :c_02fc3080;
  skos:related :c_8c8035ef, :c_af38f5d3;
  dct:created "2020-05-20T17:51:14.000"^^xsd:dateTime;
  dct:modified "2021-01-24T16:20:20.000"^^xsd:dateTime .

