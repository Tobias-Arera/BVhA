:c_dce60e4c a skos:Concept;
  skos:definition "Im Fachwerkbau im Unterschied zum Stockwerkbau ein mehretagiges Gebäude, dessen Ständerkonstruktion von der Schwelle bis zur Traufe durchgeht und in das die einzelnen Etagen eingehängt bzw. eingespannt sind. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_c8a571d9;
  skos:prefLabel "Geschossbau (Fachwerkbau)"@de;
  skos:broader :c_a4edb279;
