  dct:modified "2019-11-05T10:25:41.000"^^xsd:dateTime .

:c_b8c8f8bb a skos:Concept;
  skos:definition "In einigem Abstand unter der Firstpfette angeordnetes Längsholz, das durch Windstreben mit der Spitzsäule verbunden ist. Das über die Giebelwand vorstehende Kopfstück wurde im Salzburger Land und in Bayern oft mit einem Katzenkopf geziert, davon leiten sich auch Bezeichnungen wie Katzenbaum, Katzenpfette oder Katzenbalken ab. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "sous-faîte"@fr, "beam running below the ridge"@en, "Unterfirstpfette"@de;
  skos:broader :c_c495fe17;
  dct:created "2019-11-05T10:32:35.000"^^xsd:dateTime;
  dct:modified "2019-11-05T10:41:42.000"^^xsd:dateTime .

:c_fe00a802 a skos:Concept;
  skos:definition "Über die Giebelwand vortretende Pfette. Sie wird durch eine Büge und (oder) Kopfbänder unterstützt.  [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_19d56a39;
  skos:prefLabel "overhanging plate"@en, "panne saillante"@fr, "Flugpfette"@de;
  skos:altLabel "projecting plate"@en, "Freipfette"@de, "Auslagholz"@de, "Schüpfholz"@de;
  skos:broader :c_c495fe17;
  dct:created "2019-11-05T10:42:58.000"^^xsd:dateTime;
  dct:modified "2019-11-05T10:46:25.000"^^xsd:dateTime .

:c_12dc97e3 a skos:Concept;
