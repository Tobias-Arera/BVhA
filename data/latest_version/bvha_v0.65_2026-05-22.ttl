:c_48f83942 a skos:Concept;
  skos:definition "Pluviale n. Cappa f, Chormantel m, auch Rauchmantel m, Vespermantel m, Chorkappe f: halbkreisförmig geschnittener, langer, vorne offener, ärmelloser Mantel aus Seide, häufig mit breitem, vertikalem Zierbesatz (--> Stab), ursprünglich (und neuerdings wieder oft) mit Kapuze, später nur noch mit Zierbehang (--> Schild); das Pallium wird bei feierlichen Anlässen außerhalb der Messe getragen und unterliegt dem Farbenkanon. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "Pluviale"@de, "pluviál"@cs, "chape (pluvial)"@fr, "cappa"@la, "pluvial"@en;
  skos:altLabel "cope"@en, "pluvial"@fr, "Chorkappe"@de, "Cappa "@de, "Chormantel"@de,
    "Rauchmantel"@de, "Vespermantel"@de, "mantus"@la, "cappa pluvialis"@la;
  skos:broader :c_3e0c1197, :c_c0a0cd49;
  skos:narrower :c_983f74c0;
  skos:related :c_71f0541b, :c_c08338d7, :c_6397f79b;
  dct:created "2020-04-04T18:37:42.000"^^xsd:dateTime;
  dct:modified "2021-01-24T17:42:34.000"^^xsd:dateTime .

