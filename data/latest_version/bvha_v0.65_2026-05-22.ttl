:c_ac98232a a skos:Concept;
  skos:definition "hammerartiges Werkzeug, dessen Bahnen mit pyramidenförmigen, stumpfen Erhöhungen versehen sind. Bei der Bearbeitung der Oberfläche harter Steine werden nur kleine Splitter entfernt. [Glossarium Artis, Bd. 3, Bögen und Mauerwerk]"@de,
    "Beim Stockhammer handelt es sich um einen zweihändig geführten Hammer, dessen Schlagflächen mit pyramidenförmigen Spitzen versehen sind. Diese werden senkrecht auf die zu bearbeitende Fläche geschlagen, was ein charakteristisches Bild ergibt. [Voelkle 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd,
    :conceptScheme_f10222e0;
  skos:prefLabel "Stockhammer"@de, "pemrlice"@cs;
  skos:altLabel "Kraushammer"@de;
  skos:broader :c_7860420e;
  skos:related :c_caa7efac, :c_44198e62;
  dct:created "2019-07-15T09:12:43.000"^^xsd:dateTime;
  dct:modified "2021-01-26T16:17:54.000"^^xsd:dateTime .

:c_44198e62 a skos:Concept;
  skos:definition "Eine Werksteinfläche mit dem Stockhammer bearbeiten. [BVHA]"@de,
    "Behandlung der Oberfläche eines Steins (Steinbearbeitung) mit einem Stockhammer. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_1f14b4dd;
