:c_d363c854 a skos:Concept;
  skos:definition "Turmkreuz n: ein Kreuz auf der Spitze eines Kirchturms. Es trägt oft einen Wetterhahn. Der Hahn ist Symbol des reuigen Sünders (Verleugnung Christi durch Petrus, Mt 26, 34) und der Erweckung (Christus, der die Sünder aufweckt). [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "croix de flèche "@fr, "spire-cross"@en, "Turmkreuz"@de;
  skos:broader :c_c10d78d5, :c_5c402a54;
  dct:created "2020-08-31T11:08:40.000"^^xsd:dateTime;
  dct:modified "2021-01-24T14:40:27.000"^^xsd:dateTime .

