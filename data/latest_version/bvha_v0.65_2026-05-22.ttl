:c_3936be44 a skos:Concept;
  skos:definition "Der obere Teil des Gewölbes. Zu unterscheiden von Gewölbehaupt [dass die Gewölbestirn bezeichnet]. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "Gewölbehaupt"@de, "crown of a vault"@en, "tête d\\'une voûte"@fr;
  skos:altLabel "crête d\\'une voûte"@fr;
  skos:broader :c_3e25acca;
  dct:created "2020-02-12T16:15:40.000"^^xsd:dateTime;
  dct:modified "2021-01-19T13:19:15.000"^^xsd:dateTime .

:c_6cee77c1 a skos:Concept;
  skos:definition "Eines der vier Teilstücke des Kreuzgewölbes, das aus gleich hohen, rechtwinklig überkreuzten Tonnen (Gewölbeformen) entsteht. Senkrechte Einschnitte in ein Tonnengewölbe nennt man Stichkappen. Aus einzelnen Kappen können auch ganze Gewölbe gebildet werden, so nennt man aneinandergereihte Tonnensegment Preußische Kappen. Der Böhmischen Kappe liegt ein Kugelausschnitt zugrunde. [Koepf / Binding 2016]"@de,
    "Der Wölbabschnitt zwischen den zum Gewölbescheitel aufsteigenden Graten oder Rippen des Kreuzgewölbes. Nach der Form unterscheidet man horizontale gerade Kappen, gerade Kappen mit Stich, horizontale busige Kappen, busige Kappen mit Stich und sphärische Kappen (ihr Grat verliert sich im Gewölbehaupt). Nach der Lage unterscheidet man längsgerichtete Kappen (in Richtung der Gewölbeachse) und quergestellte Kappen (quer zur Gewölbeachse). Im Unterschied zu den Gewölbewangen haben die Kappen Stirnöffnungen. Als Kappen werden auch Segmente aus sehr flachen Tonnengewölben bezeichnet. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_1f14b4dd;
  skos:prefLabel "voûtain (voûte)"@fr, "severy (vault)"@en, "Gewölbekappe"@de, "kápě klenby"@cs;
  skos:altLabel "vaulting compartment"@en, "vaulting cell"@en, "canton"@fr, "quartier"@fr,
    "web"@en, "Kappe"@de, "Kappenfläche"@de, "prsa"@cs;
  skos:broader :c_3e25acca;
  dct:created "2020-02-12T16:20:21.000"^^xsd:dateTime;
  dct:modified "2021-01-19T13:19:30.000"^^xsd:dateTime .

:c_57442c81 a skos:Concept;
  skos:definition "Ein Entlastungsbogen an der Nahtstelle zwischen dem Hauptgewölbe und einer Stichkappe, der als Widerlager dient. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "underpitch arch"@en, "Gewölbekranz"@de, "avant-voussure d\\'une lunette"@fr;
  skos:altLabel "Kappenkranz"@de;
  skos:broader :c_3e25acca;
  skos:related :c_32a962f6;
  dct:created "2020-02-12T16:39:58.000"^^xsd:dateTime;
  dct:modified "2021-01-19T13:19:43.000"^^xsd:dateTime .

:c_32a962f6 a skos:Concept;
  skos:definition "Im Unterschied zu dem einer Mauer aufgelegten Blendbogen ein in der Mauer liegender, gemauerter, konstruktiver Bogen zur Lastabtragung über einer Maueröffnung. [Koepf / Binding 2016]"@de,
    "Im Mauerwerk über Wandöffnungen liegender Bogen, der einen Fenster- oder Türsturz oder auch einen anderen Bogen überspannt und die auf ihm liegende Last abfängt. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "relieving arch"@en, "arc de décharge"@fr, "Entlastungsbogen"@de;
  skos:altLabel "arc de renfort"@fr, "discharging arch"@en, "Mauerbogen"@de, "Versteifungsbogen"@de;
  skos:broader :c_eea5235b;
  skos:related :c_57442c81;
  dct:created "2019-10-16T15:30:13.000"^^xsd:dateTime;
  dct:modified "2020-09-07T14:16:44.000"^^xsd:dateTime;
  :broaderByFunction :c_eea5235b .

:c_51602642 a skos:Concept;
  skos:definition "Die massive Konstruktion einer Wölbung. [Koepf / Binding 2016]"@de,
    "Die aus Keilsteinen gemauerte, tragende Konstruktion eines Gewölbes. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_1f14b4dd;
  skos:prefLabel "webbing"@en, "voûte compacte"@fr, "Gewölbeschale"@de;
  skos:altLabel "shell"@en, "Wölbschale"@de, "Gewölbekörper"@de;
  skos:broader :c_3e25acca;
  dct:created "2020-02-12T18:18:16.000"^^xsd:dateTime;
  dct:modified "2021-01-19T13:20:40.000"^^xsd:dateTime .

:c_8970e9f3 a skos:Concept;
  skos:definition "Der Abschnitt zwischen Widerlager und Gewölbescheitel. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "montée de voute"@fr, "haunch"@en, "Gewölbeschenkel"@de;
