:c_c81faecc a skos:Concept;
  skos:definition "Byzantinische Kuppel, geschlossene Kugelkuppel oder Kalotte über abgekappter Hängekuppel bzw. flachen Pendentifs. [Koepf / Binding 2016]"@de,
    "Kuppel, die über den vier verbleibenden Abschnitten einer angeschnittenen Hängekuppel, den Pendentifs, errichtet ist. Im Unterschied zur Hängekuppel ist die Gewölbelinie der Pendentifs hier anders als die der Kuppel. Eine Sonderform der Pendentifkuppel ist die Aquitanische Kuppel, bei der die Pendentifs horizontale Lagerfugen haben. (Glossarium Artis)"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "coupole sur pendentifs"@fr, "Byzantine dome"@en, "Pendentifkuppel"@de,
    "kupole na pendentivech"@cs;
  skos:altLabel "Zwickelkuppel "@de, "Byzantinische Kuppel "@de, "Byzantinerkuppel "@de,
    "coupole à pendentifs"@fr, "coupole byzantine"@fr;
  skos:broader :c_ad800342;
  dct:created "2019-12-18T15:03:35.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:34:38.000"^^xsd:dateTime;
  :broaderByConstruction :c_ad800342 .

