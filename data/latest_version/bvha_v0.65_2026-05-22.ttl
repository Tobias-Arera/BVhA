:c_3664b4d9 a skos:Concept;
  skos:definition "Kandelaber (lat. candelabrum), Kerzenständer. Seit der Antike in zahlreichen Formen: als siebenarmiger Leuchter (hebräisch Menora, jüdischer Kultleuchter, in der christlichen Kirche als Symbol der Erfüllung des Alten Testaments); als achtarmiger Leuchter (hebräisch Chanukka = Tempelweihe, Symbol des Judentums; ein 9. Licht = Schames dient als Anzünder); mit einer menschlichen Gestalt als Kerzenträger; als Osterleuchter usw. [Koch 2009]"@de,
    "Lat. candelabrum, stojan na svíce, od antických dob se vyskytuje v nejrůznějších tvarech: jako sedmiramenný svícen (hebr. menora, židovský kultovní svícen, v křesťanské církvi jako symbol naplnění Starého zákona), jako osmiramenný svícen (hebr. chanuka= posvěcení chrámu, židovský symbol, deváté světlo = šames slouží k zapálení), jako svícen s lidskou postavou jako nositelem svící, velikonoční svícen atd. [Koch 2008]"@cs,
    "Kandelaber m; gr. polykerion; manoyalion; kerostates; lat. candelabrum; polycandilum: ein hoher Standleuchter mit säulenartigem, reich dekorierten Schaft, von dem oft mehrere Arme nach allen Seiten ausgehen. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_8c0441f9, :conceptScheme_1f14b4dd;
  skos:prefLabel "candélabre"@fr, "polycandilum"@la, "polykerion"@el, "kandelábr"@cs,
    "candelabra"@en, "Kandelaber"@de;
  skos:altLabel "kerostates"@el, "manoyalion"@el, "candelabrum"@la, "candelabrum"@en;
  skos:broader :c_438111ab;
  skos:narrower :c_f592f958, :c_871503e4, :c_e02fc4c5;
  skos:related :c_5204de19;
  dct:created "2020-08-04T14:12:09.000"^^xsd:dateTime;
  dct:modified "2021-01-30T22:48:55.000"^^xsd:dateTime .

:c_5204de19 a skos:Concept;
  skos:definition "Armleuchter m; gr . polykandelon ; lat. candelabrum: ein Stand- oder Wandleuchter mit mehreren, meist zwei bis sieben, nach zwei Seiten gerichteten Lichtträgern. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "candelabrum"@la, "polykandelon"@el, "Armleuchter"@de, "chandelier à branches"@fr,
    "branched candlestick"@en;
  skos:altLabel "candélabre"@fr, "candelabra"@en;
  skos:broader :c_0dc5882f, :c_438111ab;
  skos:related :c_3664b4d9;
  dct:created "2020-08-06T16:46:28.000"^^xsd:dateTime;
  dct:modified "2021-01-30T22:48:28.000"^^xsd:dateTime .

:c_34f98b47 a skos:Concept;
  skos:definition "Almosenbrett n; Almosenschaufel f; auch Bettelbrett n; Klappe f; im Ostseegebiet Bedel n: eine schaufelartige, vorne offene und an der Rückseite oft mit Reliefs verziert Lade mit Griff; eine Sonderform des Kollektentellers. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
