:c_df11ad23 a skos:Concept;
  skos:definition "Antefixa, beim antiken Tempel ein Dachziegel mit aufrecht stehender Ansichtsfläche, der über der Traufkante den Stoß der Flachziegel überdeckt und meist mit einer Palmette geschmückt ist. [Koepf / Binding 2016]"@de,
    "I. čelní štítek u antických chrámů upevněný na okraj střechy; jeho pohledová plocha zakrývá styk tašek, 2. malovaná keramická deska jako obložení trámu pod okapní hranou řeckých a etruských chrámů. [Koch 2008]"@cs,
    "Antefix, -a, bei antiken Tempeln ein Dachziegel, dessen senkrecht aufgebogene Ansichtsfläche den Stoß der Flachziegel verdeckt. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9;
  skos:prefLabel "antéfixe"@fr, "antefix"@cs, "antefix"@en, "antefissa"@it, "antefija"@es,
    "Stirnziegel"@de;
  skos:altLabel "Antefix"@de, "čelní taška"@cs;
  skos:broader :c_7becmxjs;
  dct:created "2019-12-18T14:10:22.000"^^xsd:dateTime;
  dct:modified "2021-03-19T18:29:29.000"^^xsd:dateTime .

:c_e421119f a skos:Concept;
  skos:definition "Böhmische Kappe, Böhm. Gewölbe, Platzelgewölbe, Stutzkuppel; im Gegensatz zur Hängekuppel, bei der das Grundquadrat des zu überwölbenden Raums dem Fußkreis einer Kuppel eingeschrieben ist, versteht man unter einer B.K. ein Gewölbe über einer kleineren Fläche als dem Grundquadrat. [Koepf / Binding 2016]"@de,
    "Gewölbe, das nur einen Ausschnitt aus einer Hängekuppel darstellt. Wegen der Form des Grundrisses oder wegen mangelnder Höhe ist die reine Kugelfläche nicht ausgebildet. Wie bei der Hängekuppel liegt der eigentliche Fußkreis außerhalb der Ecken des überwölbten Raumes. Bei quadratischem Grundriss werden die vier Schildbogen gleich hoch. Die Einwölbung erfolgt freihändig oder mit einer Brettlehre. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_1f14b4dd;
  skos:prefLabel "Böhmische Kappe"@de, "bóveda bohemia plana"@es, "pruská klenba"@cs,
    "coupole en pendentifs surbaissée"@fr, "segmental sail vault"@en;
  skos:altLabel "volta a vela a sesto ribassato"@it, "calotte"@fr, "Böhmische Kappe "@de,
    "Böhmisches Kappengewölbe "@de, "Segmentkugel"@de, "Böhmische Kugelkappe "@de, "flaches Platzel "@de,
    "Platzelgewölbe"@de, "česká placka"@cs, "plochá klenba"@cs, "voûte à nappes"@fr, "voûte à bohémienne plate"@fr,
    "surbased spherical vault"@en;
  skos:broader :c_ad800342;
  dct:created "2019-12-18T14:11:27.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:28:58.000"^^xsd:dateTime;
  :broaderByShape :c_ad800342 .

