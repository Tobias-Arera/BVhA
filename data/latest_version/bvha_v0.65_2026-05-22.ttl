:c_7db6670b a skos:Concept;
  skos:definition "Nach Juan de Herrera, 1530-97, benannter offizieller Baustil zur Regierungszeit Philipps II., eine strenge Version der italienischen Renaissance, der wegen seines sparsamen Dekors auch »Desornamentado-Stil« genannt wird. Hauptwerk: Escorial. [Koch 2009]"@de,
    "Oficiální stavební sloh z doby vlády španělského krále Filipa II., nazvaný podle Juana de Herrery (1530-97), přísná verze italské renesance, vzhledem k úspornému dekoru nazýván také desornamentado, hlavní dílo: Escorial. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9;
  skos:prefLabel "Herrera-Stil"@de, "herrerův styl"@cs;
  skos:altLabel "Desornamentado-Stil"@de, "desornamentado"@cs;
  skos:broader :c_f7qkhf86;
  dct:created "2020-08-04T11:38:01.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:26:17.000"^^xsd:dateTime .

