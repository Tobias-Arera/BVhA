  skos:prefLabel "Parterre (Garten)"@de, "parter (zahrada)"@cs, "parterre"@it, "prado baroco"@es;
  skos:broader :c_0cd41f3f;
  dct:created "2020-08-05T10:56:40.000"^^xsd:dateTime;
  dct:modified "2021-01-27T16:20:55.000"^^xsd:dateTime .

