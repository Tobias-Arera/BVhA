  dct:modified "2019-12-05T13:34:36.000"^^xsd:dateTime;
  :broaderByConstruction :c_eea5235b .

:c_9101e93a a skos:Concept;
  skos:definition "Bogen, bei dem innere und äußere Bogenlinie parallel verlaufen. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
