:c_62273ce0 a skos:Concept;
  skos:definition "Innenmauern, Innenwände, sind die Mauern im Inneren eines Bauwerks im Gegensatz zu den Außenmauern (Umfassungsmauern). Man unterscheidet Mittelmauer, Trennmauern und Zwischenwände. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Innenwand"@de;
