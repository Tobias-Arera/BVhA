  skos:related :c_a252a285, :c_0094d807;
  dct:created "2019-02-18T21:16:02.000"^^xsd:dateTime;
  dct:modified "2021-01-27T14:38:39.000"^^xsd:dateTime .

:c_76832dd5 a skos:Concept;
  skos:definition "Lat. křticí budova. Často osmiboká centrální stavba, která se v starokřesťanské době a ve středověku (4.-15. stol.) nacházela většinou západně od biskupského chrámu. Byla zasvěcena Janu Křtiteli. Křtěnec by ponořen do křticí nádrže (- piscina, uprostřed místnosti). Tento zvyk postupně mizel a namísto pisciny se prosazovala křtitelnice, která stává od těch dob v kostelích. [Koch 2008]"@cs,
    "Baptisterium (lat. Taufgebäude), selbständiger, häufig achteckiger Zentralbau, der in altchristlicher und mittelalterlicher Zeit (4.-15. Jh.) meist westlich von einer Bischofskirche errichtet wird. Er ist Johannes d. Täufer geweiht. Im Taufbecken (Piscina, in der Mitte des Raumes) wird der Täufling untergetaucht. Mit dem Verschwinden dieser Sitte setzt sich der Taufstein durch, der seitdem in der Kirche steht. [Koch 2009]"@de,
    "Baptisterium (lat., v. gr. baptisterion: Badebassin), Taufkirche. Der frühchristl. Brauch, die Taufe (meist nur Erwachsener) durch völliges Untertauchen (submersio) oder durch Eintauchen (immersio) des Körpers zu vollziehen, führte schon im 4. Jh. dazu, dass in unmittelbarer Nähe der bischöfl. Basilika eine kleinere Taufkirche errichtet wurde mit einem meist in den Boden versenkten, achteckigen oder kreuzförmigen Wasserbassin (Piscina) in der Mitte, zu dem drei oder sieben Stufen hinabführten. Diese Baptisterien genannten Kapellen sind in der Regel Zentralbauten mit quadrat., häufiger polygonalem oder rundem Grundriss, der durch halbrunde oder rechteckige Anbauten sowie Nischen auch kreuz- oder kleeblattförmig ausgebildet sein kann. Bei größeren Anlagen ist das Taufbassin oft von einem inneren Säulenkranz umgeben, auf dem eine Obermauer mit Kuppel- oder Zeltdachabschluss und Lichtöffnungen ruht, während der Umgang mit Tonnen- oder Gratgewölben überdeckt ist. Seit im hohen MA die Taufe durch Untertauchen aufgegeben wurde, dient das B. meist allgemeinkirchl. Zwecken. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "Baptisterium (Taufgebäude)"@de, "baptisterium (křticí budova)"@cs;
  skos:altLabel "Taufkirche"@de;
  skos:broader :c_ceec0c04;
  skos:related :c_d2c456cb;
  dct:created "2020-08-03T14:18:08.000"^^xsd:dateTime;
  dct:modified "2021-01-26T18:15:19.000"^^xsd:dateTime .

:c_d2c456cb a skos:Concept;
  skos:definition "Piscina (lat. Fischbecken), liturgisches Wasserbecken, meist in Form einer Nische in der südlichen Chorwand, mit Ablauf in eine Sickergrube (Sacrarium) für das Wasser, das zum Waschen der Hände des Priesters und der heiligen Gefäße gebraucht wurde und das nach einer kirchlichen Vorschrift nicht in eine Kloake gelangen darf. [Koch 2009]"@de,
    "Lat. nádrž s rybami. Liturgické umyvadlo, většinou v podobě niky v jižní stěně chóru, s odtokem do jímky (sacrarium), protože voda, která byla použita k mycí rukou kněze a k mytí liturgických nádob, se nesmí podle církevních předpisů dostat do stoky. [Koch 2008]"@cs,
    "Becken mit Ausguss für liturg. Waschungen, meist an der südl. Chor-oder Sakristeiwand. [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "Piscina (Wasserbecken)"@de, "lavabo (liturgické umyvadlo)"@cs;
  skos:broader :c_a1d0df39;
  skos:related :c_76832dd5, :c_ae33ed6f;
  dct:created "2020-08-11T13:14:32.000"^^xsd:dateTime;
  dct:modified "2021-01-26T17:56:40.000"^^xsd:dateTime .

:c_0436e719 a skos:Concept;
  skos:definition "Bethaus, ein Gebäude ohne Turm und Glocke, in dem außer Gebet und Predigt keine pfarramtl. Handlungen vorgenommen werden, durch Erlasse in der 2. Hälfte des 17. Jhs. in kath. Ländern für luther. und andere reformierte Bekenntnisse genehmigt (Österreich, Schlesien, Rheinland). [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "Bethaus"@de;
  skos:altLabel "Betsaal"@de;
  skos:broader :c_ceec0c04;
  dct:created "2020-08-28T10:54:23.000"^^xsd:dateTime;
  dct:modified "2021-01-26T18:16:14.000"^^xsd:dateTime .

:c_3dffa19a a skos:Concept;
  skos:definition "Chapterhouse (engl.), in England ein meist viereckiger oder polygonaler freistehender Bau, der außerhalb der Klausur liegt und mit dem Kreuzgang oder auch mit dem Querhaus der Kirche unmittelbar durch einen Gang verbunden ist. Er dient dem Konvent als repräsentativer Raum oder dem Domkapitel zu Sitzungen. 1. Hälfte 12.-15. Jh. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "Kapitelhaus"@de, "Chapterhouse"@en;
  skos:broader :c_ceec0c04, :c_c0e6748a;
  dct:created "2020-08-28T15:53:47.000"^^xsd:dateTime;
  dct:modified "2021-01-26T18:14:37.000"^^xsd:dateTime .

