  skos:definition "Ein auf vier Seiten von einer Portikus umgebenes Atrium. [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
