:c_d8ee92a4 a skos:Concept;
  skos:definition "Tonnengewölbe, dessen Achse parallel zur Längsachse des Bauwerkes verläuft. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
