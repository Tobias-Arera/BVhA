:c_qojdlphd a skos:Concept;
  skos:definition "Rückgriff auf Stile und Künstler vorausgegangener Zeiten, besonders im 19. Jh. zwischen Klassizismus (der selber historisierende Absicht zeigt) und Jugendstil. Seit 1930 findet sich eine erneute Hinwendung zum Klassizismus (Neoklassizismus), nach dem 2. Weltkrieg zu den Stilen aus dem 1. Viertel des 20. Jhs. (Neojugendstil, Gaudi, Expressionismus, Bauhaus usw.). [Koch 2009]"@de,
    "Návrat ke slohům a umělcům minulých dob, zvl. v. 19. stol. mezi klasicismem (v němž se také projevují historizující záměry) a secesi, od r. 1930 dochází k novému obratu ke klasicismu (neoklasicismus), po druhé světové válce ke slohům z I. čtvrtiny 20. stol. (neosecese, neo-Gaudí, neoexpresionismus, neo-Bauhaus). [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9;
  skos:prefLabel "Historismus"@de, "historismus"@cs;
  skos:broader :c_be880384, :c_bqjysq71;
  skos:narrower :c_f5772509, :c_f50f0892, :c_619cf6c7, :c_78a92730, :c_e717d45d, :c_2ff1ad3c,
    :c_47ea382e;
  skos:related :c_f5772509, :c_775b8a30, :c_e2da6bd0, :c_bqjysq71;
  dct:created "2020-08-11T15:02:37.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:20:31.000"^^xsd:dateTime .

