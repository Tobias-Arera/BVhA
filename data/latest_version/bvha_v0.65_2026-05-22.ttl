    "smussatura"@it, "ángulo achaflanado"@es, "Fasung"@de, "Abfasung"@de, "Schmiege"@de;
  skos:broader :c_78eff904, :c_7039254c;
  skos:narrower :c_bc58b851, :c_116fbde6;
  skos:related :c_4d9dfad6;
  dct:created "2019-05-22T12:09:07.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:11:38.000"^^xsd:dateTime .

