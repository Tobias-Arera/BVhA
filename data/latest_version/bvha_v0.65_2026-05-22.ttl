:c_760c8dff a skos:Concept;
  skos:definition "Profilierung im Einschlagfalz der Höhenschenkel des Flügels und des Fensterrahmens nur an der Seite, wo der Flügel an den Fensterrahmen gehangen ist. Da der Flügel an dieser Seite nicht in den Fensterrahmen einschlägt, sondern hineingedreht wird, kann er hier anders profiliert sein. Schon seit dem ausgehenden 17. Jh. werden bei aufwendigeren Fenstern die beiden Teile so geformt. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_c7b144d0, :conceptScheme_b41bd73a;
  skos:prefLabel "Klemmfalz"@de;
  skos:altLabel "Quetschfalz"@de, "Kneiffalz"@de;
  skos:broader :c_b8ea47ea;
  dct:created "2019-05-23T08:30:19.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:10:47.000"^^xsd:dateTime .

