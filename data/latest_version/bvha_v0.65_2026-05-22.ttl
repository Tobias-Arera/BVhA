  skos:broader :c_76131543;
  dct:created "2020-06-05T17:26:02.000"^^xsd:dateTime;
  dct:modified "2021-01-22T10:20:57.000"^^xsd:dateTime .

:c_5469da98 a skos:Concept;
  skos:definition "Ars moriendi f, auch Ars bene moriendi f, Speculum artis bene moriendi n, Sterbebüchlein n: spätmittelalterliches Erbauungsbuch mit religiösem Text und mit Darstellungen des Kampfes zwischen Himmel und Hölle um die Seele des Sterbenden; im Schlussbild wird der Sieg des Guten gezeigt. [Glossarium Artis]"@de;
