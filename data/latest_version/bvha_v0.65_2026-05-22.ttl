  dct:modified "2021-01-24T15:55:30.000"^^xsd:dateTime .

:c_779ccda6 a skos:Concept;
  skos:definition "Beinreliquiar n: ein Reliquienbehälter in Form eines menschlichen Beines, auch nur eines Ober- oder Unterschenkels. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "jambe-reliquaire"@fr, "leg-reliquary"@en, "Beinreliquiar"@de;
  skos:broader :c_2e3d5fc3;
  dct:created "2020-09-01T20:09:23.000"^^xsd:dateTime;
  dct:modified "2021-01-24T15:40:16.000"^^xsd:dateTime .

:c_ad33b25f a skos:Concept;
  skos:definition "Fingerreliquiar n: das als Finger gestaltetes Behältnis für eine Fingerreliquie. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "doigt-reliquaire"@fr, "finger-reliquary"@en, "Fingerreliquiar"@de;
