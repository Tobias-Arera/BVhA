    :conceptScheme_1f14b4dd;
  skos:prefLabel "ciboire en forme de tourelle"@fr, "turret-ciborium"@en, "Turmpyxis"@de,
    "turris eucharisticus"@la;
  skos:altLabel "turriculum"@la, "eucharistischer Turm"@de;
  skos:broader :c_14a349f2;
  dct:created "2020-08-07T09:44:33.000"^^xsd:dateTime;
  dct:modified "2021-01-24T15:25:18.000"^^xsd:dateTime .

:c_68f1ad8e a skos:Concept;
  skos:definition "Bezeichnung für ein Bauschema, das aus Vorarlberg stammende Meister (Tuumb, Beer, Moosbrugger) bei ihren Kirchenbauten oft angewandt haben. Das Schema zeigt ein tonnengewölbtes Langhaus zwischen Kapellennischen und darüber liegenden Emporen. Das Querhaus ist meist nur wenig ausladend und schmaler als das Mittelschiff des Langhauses. Im etwas eingezogenen Chor setzt sich das Langhaussystem modifiziert fort.Das V. S. ist in der Schweiz und in Süddeutschland in der Zeit um 1700 weitverbreitet. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_84fc24e6;
  skos:prefLabel "Vorarlberger Schema"@de;
  skos:broader :c_a4d58de0;
  dct:created "2020-08-07T11:14:57.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:05:52.000"^^xsd:dateTime .

:c_3aa93d86 a skos:Concept;
  skos:definition "Urspr. die Ausgewogenheit im Verhältnis des Ganzen zu seinen Teilen, später nur noch die Spiegelgleichheit auf eine Mittelachse bezogener Teile eines Ganzen. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_84fc24e6;
  skos:prefLabel "symétrie"@fr, "symetrie"@cs, "symmetry"@en, "simmetria"@it, "simetria"@es,
    "Symmetrie"@de;
  skos:altLabel "souměrnost"@cs;
  skos:broader :c_a4d58de0;
  skos:narrower :c_4d95de30;
  dct:created "2020-08-11T11:17:48.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:05:31.000"^^xsd:dateTime .

:c_4666989e a skos:Concept;
  skos:definition "Vereinfachen von Naturformen (z.B. Blattwerk) zu einer charakterist., oft geometr. Grundform. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_84fc24e6;
