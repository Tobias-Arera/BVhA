  dct:modified "2020-02-13T13:50:39.000"^^xsd:dateTime .

:c_50e0ab32 a skos:Concept;
  skos:definition "Beim primitiven Dachhaus reichten die Rofen – Stangenrofen – bis auf den Erdboden. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "Stangenrofen"@de;
