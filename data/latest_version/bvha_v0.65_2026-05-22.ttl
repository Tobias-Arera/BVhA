:c_b31198a0 a skos:Concept;
  skos:definition "Mönch m; auch Ordensmann m; lat. monachus: Angehöriger eines religiösen Männerordens. Er hat die Gelübde (Armut, Keuschheit, Gehorsam) abgelegt und lebt nach festen Regeln der Gemeinschaft. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
