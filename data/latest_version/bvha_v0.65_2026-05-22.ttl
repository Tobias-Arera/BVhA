:c_3eb67821 a skos:Concept;
  skos:definition "Ein geräumiger, meist öffentl. Bau oder Raum. 1. Ein offener oder halboffener Bau, ursprüngl. zum Schutz vor Regen oder Sonne (Stoa, Wandelhalle, Vorh.), bisweilen auch geschlossen (Rathaush., Markth., Bahnhofsh.). 2. Eine weite Raumform, die nur über eingestellte Stützen gedeckt werden konnte und nur durch die Außenfronten belichtet wurde. [Koepf / Binding 2016]"@de,
    "Hoher und weiter Raum eines Bauwerks. Während im mittelalterlichen Profanbau die H. (Diele) eines Hauses eine entscheidende Rolle spielte, kommen H.n im Burgen- und Schlossbau selten vor. Lediglich in der englischen Tradition (Westminster Hall GB, 1097) tragen sie als Mittelpunkt der Anlagen entscheidend zum Bautyp bei. B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_c8a571d9, :conceptScheme_1d7ba54b;
  skos:prefLabel "Halle (Raum)"@de;
  skos:broader :c_2d93c3e7;
  skos:narrower :c_2f44313c, :c_0ce11bbd, :c_6db85b01, :c_7b8f962f, :c_81a62a56;
  dct:created "2019-10-21T17:38:54.000"^^xsd:dateTime;
  dct:modified "2021-01-27T01:17:33.000"^^xsd:dateTime .

:c_0ce11bbd a skos:Concept;
  skos:definition "Eine zum Umhergehen bestimmte Halle, bes. an öffentl. Gebäuden wie Theater, Bäder, auch an Plätzen (Stoa), ein gegen Regen geschützter, teilweise offener Raum unterschiedl.Gestaltung. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_c8a571d9;
  skos:prefLabel "Wandelhalle"@de, "paseo"@es, "portiei"@it, "promenoir"@fr, "covered walk"@en;
  skos:altLabel "galería"@es, "salle des pas perdus"@fr;
  skos:broader :c_3eb67821;
  dct:created "2020-08-04T15:30:17.000"^^xsd:dateTime;
  dct:modified "2021-01-27T01:19:43.000"^^xsd:dateTime .

:c_6db85b01 a skos:Concept;
  skos:definition "Ein hallenartiger Wandelgang vor öffentl. Gebäuden oder Kirchen und als Rahmung von Plätzen (Säulengang). Auch Vorhalle von Kirchen- und Profanbauten. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c8a571d9;
  skos:prefLabel "Säulenhalle"@de, "loggia colonnato"@it, "sloupová síň"@cs, "portique"@fr,
    "hypostyle hall"@en;
  skos:altLabel "pórtico"@es, "portikus"@cs, "columned hall"@en, "stoa"@cs, "hypostyl"@cs,
    "portico colonnato"@it, "salle hypostyle"@fr;
  skos:broader :c_3eb67821;
  skos:narrower :c_49d6297f, :c_a3670921, :c_17b40a9c, :c_ed8900c5;
  dct:created "2020-08-06T12:02:20.000"^^xsd:dateTime;
  dct:modified "2021-01-27T01:18:16.000"^^xsd:dateTime .

:c_7b8f962f a skos:Concept;
  skos:definition "Torgang, Innenraum eines Torbaus. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_c8a571d9;
  skos:prefLabel "pórtico"@es, "porch"@en, "Torhalle"@de, "porticato"@it, "porche"@fr;
