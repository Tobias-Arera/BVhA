:c_5c4733e9 a skos:Concept;
  skos:definition "Brandmauer, Feuermauer, gegen ein angebautes Nachbarhaus gerichtete, nicht durchbrochene Abschlussmauer eines Bauwerks, in die keine Holzteile einbinden dürfen. Auch eine vom Keller bis über die Dachhaut geführte Mauer innerhalb eines Gebäudes, das dieses in einzelne, untereinander nur mit besonderen Sicherheitsvorkehrungen verbundene Brandabschnitte unterteilt. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Brandmauer"@de;
  skos:altLabel "Feuermauer"@de;
  skos:broader :c_5b828b5f;
  dct:created "2019-05-07T12:02:54.000"^^xsd:dateTime;
  dct:modified "2021-01-22T15:35:42.000"^^xsd:dateTime .

:c_1d12e80a a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe;
  skos:prefLabel "Brüstungsmauer"@de;
  skos:broader :c_5b828b5f;
