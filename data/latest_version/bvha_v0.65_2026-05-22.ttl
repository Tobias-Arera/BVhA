  dct:modified "2021-01-15T16:13:47.000"^^xsd:dateTime .

:c_a63420c9 a skos:Concept;
  skos:definition "Darstellung der Dreifaltigkeit seit dem 12. Jh.: Gottvater auf dem Thron hält mit beiden Händen das Kreuz mit Christus (oder im Schoß Christi Leichnam), der Heilige Geist wird durch eine schwebende Taube dargestellt. [Koch 2009]"@de,
    "Zobrazení Nejsvětější Trojice od 12. stol.: Bůh Otec sedí na trůnu a oběma rukama drží kříž s Kristem (nebo na klíně Krista ukřižovaného), Duch svatý bývá znázorněn jako holubice. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9;
  skos:prefLabel "Gnadenstuhl"@de, "trůn milosti"@cs;
  skos:broader :c_0b1e85cc;
  skos:related :c_eef3ed7d, :c_1a9644a7, :c_eieuwx7k;
  dct:created "2020-08-05T12:01:46.000"^^xsd:dateTime;
  dct:modified "2021-01-22T12:08:21.000"^^xsd:dateTime .

