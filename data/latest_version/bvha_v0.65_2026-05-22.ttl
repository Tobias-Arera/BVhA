  dct:modified "2021-01-15T16:00:21.000"^^xsd:dateTime .

:c_a2aafc4b a skos:Concept;
  skos:definition "Allianzwappen (Ehewappen, Heiratswappen) nennt man die Zusammenstellung der Wappen von Ehegatten. Am häufigsten werden beide Schilde gegeneinander leicht geneigt. In Deutschland hat betreffs der Zusammenstellung von Allianzwappen stets große Regellosigkeit geherrscht. Es kommt u. a. auch vor, dass beide Wappen im gespaltenen Schilde nebeneinander oder im gevierteten Schilde stehen. Das Wappen des Mannes hat fast ausschließlich den besseren Platz inne und wendet sich (häufig seitenverkehrt) dem Wappen der Frau zu. Der zu letzterem gehörige Helmschmuck bleibt oft fort, beide Schilde des Allianzwappens stehen dann unter dem Helm des männlichen Wappens oder einer gemeinsamen Krone. [RDK Labor]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_cf792a3c;
  skos:prefLabel "united arms of husband and wife"@en, "Armoiries par alliance"@fr,
    "Allianzwappen"@de;
  skos:altLabel "Ehewappen"@de, "Heiratswappen"@de, "Doppelwappen"@de;
  skos:broader :c_kx6houci;
  dct:created "2020-12-16T16:32:36.000"^^xsd:dateTime;
  dct:modified "2021-01-27T14:25:08.000"^^xsd:dateTime .

