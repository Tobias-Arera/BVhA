:c_503471f6 a skos:Concept;
  skos:definition "Falz am Flügelrahmen, welcher sich an den Überschlag am Flügel nach außen anschließt und den Wind brechen soll, der sonst in den Einschlagfalz drückt. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_b41bd73a;
  skos:prefLabel "Windfalz"@de;
  skos:broader :c_b8ea47ea;
  dct:created "2019-06-11T18:30:00.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:11:18.000"^^xsd:dateTime .

