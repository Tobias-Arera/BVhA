  skos:broader :c_17d46f99;
  dct:created "2020-02-23T18:41:27.000"^^xsd:dateTime;
  dct:modified "2021-01-24T14:51:04.000"^^xsd:dateTime .

:c_5a630b26 a skos:Concept;
  skos:definition "Messkännchen für den zu konsekrierenden Wein und das diesem beizumischende Wasser. [RDK Labor]"@de,
    "Messkännchen n; auch Altarkännchen n; Messampulle f; Messpolle f; lat. amula (offertoria) ; ama; ampulla; urceolus; fons; bureta; phiala: eine kleine Kanne oder ein kleiner Krug aus Edelmetall, Kristall, Halbedelstein oder auch aus Glas für den Messwein (seit 5. Jh.) und das beizumischende Wasser. Sofern der Genuss des Weines sich auf den (oder die) Priester beschränkt, werden sehr kleine Kannen benützt. Oft ist das Weinkännchen mit einer Traube oder einem V (vinum),das Wasserkännchen mit einem Fisch oder einem Α (aqua) gekennzeichnet. In prot. Kirchen sind größere Kannen mit einem Deckel üblich (Abendmahlskanne f). [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd,
    :conceptScheme_cf792a3c;
  skos:prefLabel "Messkännchen"@de, "mešní konvička"@cs, "galheta"@pt, "cruet"@en, "amula"@la,
    "vinajera"@es, "ampul"@nl, "burette"@fr;
  skos:altLabel "ampulla"@la, "fons"@la, "burette à eau"@fr, "burette à vin"@fr, "service de burettes"@fr,
    "altar-cruet"@en, "flagon"@en, "communion-jug"@en, "cruet-set"@en, "Messpolle"@de,
    "Altarkännchen"@de, "Messampulle"@de, "urceolus"@la, "ama"@la, "amula offertoria"@la,
    "bureta"@la, "phiala"@la;
  skos:broader :c_1655dbba, :c_17d46f99, :c_f490a4dd;
  skos:related :c_dce89a1e, :c_07107e8d, :c_f21d8620, :c_18135148;
  dct:created "2020-02-25T09:01:41.000"^^xsd:dateTime;
  dct:modified "2021-01-24T13:05:20.000"^^xsd:dateTime .

:c_dce89a1e a skos:Concept;
  skos:definition "Messkännchenständer m: ein kleiner Untersatz mit Halterungen für die Messkännchen. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
