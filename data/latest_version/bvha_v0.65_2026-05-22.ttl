:c_f3b6edc5 a skos:Concept;
  skos:definition "Gedrücktes Kreuzgewölbe, gelegentlich mit Stich, Busung und Stichkappen. Zu unterscheiden von der Kreuzkappe als Abschnitt eines Kreuzgewölbes. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "surbased cross vault"@en, "Kreuzkappengewölbe"@de, "voûte d\\'arêtes surbaissée"@fr;
