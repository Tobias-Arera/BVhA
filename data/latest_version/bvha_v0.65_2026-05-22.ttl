:c_df6adff3 a skos:Concept;
  skos:definition "Heiliges Antlitz ist die im Mittelalter geprägte Bezeichnung für besonders verehrungswürdige und gnadenreiche Darstellungen des Angesichts Christi, die auf ein angeblich vom Herrn zu seinen Lebzeiten der hl. Veronika durch wunderbaren Abdruck in ein Tuch gewährtes Bild zurückgehen. [RDK Labor]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_cf792a3c;
  skos:prefLabel "vera icon"@la, "Vera Ikon"@de;
  skos:altLabel "Heiliges Antlitz"@de;
  skos:broader :c_deb4e660, :c_0gcqi8ey;
  skos:related :c_fe09c7aa;
  dct:created "2020-12-16T17:39:20.000"^^xsd:dateTime;
  dct:modified "2021-01-22T10:43:47.000"^^xsd:dateTime .

