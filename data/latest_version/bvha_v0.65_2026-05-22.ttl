:c_0e53fb92 a skos:Concept;
  skos:definition "Heiliger (ungenähter) Rock Christi m; lat. tunica Christi: das aus braunem Gewebe gefertigte, nahtlose Leibgewand Christi, um das die Soldaten gewürfelt haben sollen. Diese Reliquie wird in mehreren HeiItumsverzeichnissen aufgeführt. Sie soll sich z. B. im Besitz der Basilika St. Denis in Argenteuil befinden, außerdem in der Schlosskirche zu Wittenberg, in S. Giovanni in Laterano und in der Heilig-Rock-Kapelle des Trierer Domes. Partikel vom hl. Rock werden in zahlreichen weiteren Kirchen verehrt. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "Sainte Tunique"@fr, "Tunic of Christ"@en, "Heiliger Rock Christi "@de,
    "tunica Christi"@la;
  skos:altLabel "Sainte Robe"@fr, "Seamless Robe"@en;
  skos:broader :c_16d20867;
  dct:created "2020-09-25T19:05:09.000"^^xsd:dateTime;
  dct:modified "2021-01-27T11:42:52.000"^^xsd:dateTime .

:c_06a765fb a skos:Concept;
  skos:definition "Spottzepter n Christi: das Rohr, das man Christus als \"Zepter\" in die gefesselten Hände gedrückt hatte, um ihn zu verhöhnen. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "Sceptre de Roseau"@fr, "Sceptre of the Reeds"@en, "Spottzepter Christi"@de;
  skos:broader :c_16d20867;
  dct:created "2020-09-26T16:16:11.000"^^xsd:dateTime;
  dct:modified "2021-01-27T11:44:58.000"^^xsd:dateTime .

:c_be0bea02 a skos:Concept;
  skos:definition "Deposition f; Reliquienbeisetzung f; lat. depositio: der feierliche Ritus des Ablegens von Reliquien (seit 6. Jh.) nach ihrer Translation in einer Kirche bzw. einem Altargrab. Auch eine vorübergehende Deposition während der Translation führte zuweilen dazu, dass ein Ort der Verehrung entstand. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "déposition de reliques"@fr, "deposition of relics"@en, "Deposition"@de,
    "depositio"@la;
  skos:altLabel "Reliquienbeisetzung"@de;
  skos:broader :c_a2dc7eed;
  skos:related :c_03c233d0, :c_9c9bc5b1, :c_526de093;
  dct:created "2020-09-27T14:48:53.000"^^xsd:dateTime;
  dct:modified "2021-01-15T17:33:03.000"^^xsd:dateTime .

:c_526de093 a skos:Concept;
  skos:definition "Erhebung f; Elevation f; auch Exhumierung f; lat elevatio: die Entnahme der sterblichen Überreste eines Heiligen aus seinem ursprünglichen Grab zur feierlichen Beisetzung am Ort der Verehrung. Die erste bekannte Erhebung erfolgte 386 durch Ambrosius in Mailand. Die Elevation wurde im Kalender als Fest begangen. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "élévation"@fr, "exhumation"@en, "Elevation"@de, "elevatio"@la;
  skos:altLabel "exhumation"@fr, "elevation"@en, "Erhebung"@de, "Exhumierung"@de;
  skos:broader :c_a2dc7eed;
  skos:related :c_be0bea02;
  dct:created "2020-09-27T14:53:31.000"^^xsd:dateTime;
  dct:modified "2021-01-15T17:33:10.000"^^xsd:dateTime .

:c_cea62c8f a skos:Concept;
  skos:definition "Reliquienauffindung f: die Entdeckung von Reliquien eines Heiligen. Der Tag der Auffindung wird oft im Kalendarium aufgenommen. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "découverte de reliques"@fr, "discovery of relics"@en, "Reliquienauffindung"@de;
  skos:broader :c_a2dc7eed;
  dct:created "2020-09-27T17:04:52.000"^^xsd:dateTime;
  dct:modified "2021-01-15T17:34:35.000"^^xsd:dateTime .

:c_3189faf9 a skos:Concept;
  skos:definition "Andachtsfigur f: eine kleine plastische Figur, vor der im häuslichen Rahmen die religiöse Andacht verrichtet werden kann. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "statuette de dévotion"@fr, "statuette of devotion"@en, "Andachtsfigur"@de;
  skos:broader :c_1f8af5be;
  dct:created "2020-09-27T19:24:11.000"^^xsd:dateTime;
  dct:modified "2021-01-27T09:45:13.000"^^xsd:dateTime .

:c_e931f61e a skos:Concept;
  skos:definition "Beichtzettel m; lat. schedula confessionis: ein Andachtsbild, das als Nachweis für die abgelegte Osterbeichte gilt. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "certificat de confession"@fr, "confession-certificate"@en, "Beichtzettel"@de,
    "schedula confessionis"@la;
  skos:broader :c_1f8af5be;
  dct:created "2020-09-27T19:32:56.000"^^xsd:dateTime;
  dct:modified "2021-01-24T14:43:16.000"^^xsd:dateTime .

:c_5b96caec a skos:Concept;
  skos:definition "Betnuss f; Gebetsnuss f: eine aufklappbare, bis zu 6 cm große Kapsel aus Buchsholz, Elfenbein oder Edelmetall, deren Innenseiten zierliche Schnitzarbeiten zeigen, z. B. Szenen aus der Passion Christi oder Heiligenfiguren. Sie wird als Anhänger am Rosenkranz oder an einer Schmuckkette getragen. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "noix de prière"@fr, "prayer-bead"@en, "Betnuss"@de;
  skos:altLabel "Gebetsnuss"@de;
  skos:broader :c_1f8af5be;
  dct:created "2020-09-27T19:39:37.000"^^xsd:dateTime;
  dct:modified "2021-01-24T14:43:28.000"^^xsd:dateTime .

:c_84b01dcf a skos:Concept;
  skos:definition "BruderschaftsmedaiIle f; auch Bruderschaftsmünze f: ein Medaillon, das von geistlichen Bruderschaften als Andenken vergeben wurde. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "médaille d\\'une confrérie"@fr, "confraternity-medal"@en, "Bruderschaftsmedaille"@de;
  skos:altLabel "Bruderschaftsmünze"@de;
  skos:broader :c_1f8af5be;
  dct:created "2020-09-27T19:42:04.000"^^xsd:dateTime;
  dct:modified "2021-01-24T14:43:41.000"^^xsd:dateTime .

:c_597b22f4 a skos:Concept;
  skos:definition "Schutzbrieflein n; oberdt. Beverl n (von lat. littera brevis \"kurzer Brief\"): ein Blatt, auf dem Wundertäter und Schutzpatrone, aber auch Reliquien und christliche Symbole abgebildet sind und das seinem Besitzer Schutz gewähren soll. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "feuille de protection"@fr, "talismanic text"@en, "Schutzbrieflein"@de;
  skos:altLabel "Beverl"@de;
  skos:broader :c_1f8af5be;
  dct:created "2020-09-29T15:59:48.000"^^xsd:dateTime;
  dct:modified "2021-01-24T14:46:10.000"^^xsd:dateTime .

