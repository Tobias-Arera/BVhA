:c_8a0b1b50 a skos:Concept;
  skos:definition "Tragfigur f: eine Heiligenfigur, die bei Prozessionen in einem Traggestell mitgeführt wird. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "statue portative"@fr, "portable statue"@en, "Tragfigur"@de;
  skos:broader :c_90bb4120;
  skos:related :c_043fca8d, :c_a40071ed;
  dct:created "2020-08-07T15:13:38.000"^^xsd:dateTime;
  dct:modified "2021-01-30T23:12:20.000"^^xsd:dateTime .

:c_399284af a skos:Concept;
  skos:definition "Bruderschaftskreuz n: ein oft mit heraldischen Zeichen versehenes Kreuz, das den Mitgliedern einer Bruderschaft bei Prozessionen vorangetragen wird. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "croix de confrérie"@fr, "confraternity-cross"@en, "Bruderschaftskreuz"@de;
  skos:broader :c_6d545cca;
  skos:related :c_043fca8d;
  dct:created "2020-08-28T16:10:37.000"^^xsd:dateTime;
  dct:modified "2021-01-24T14:40:46.000"^^xsd:dateTime .

:c_147e3782 a skos:Concept;
  skos:definition "Reliquiarvelum n: Hülle oder Vorhang für ein Reliquiar. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "voile de reliquaire"@fr, "reliquary-veil"@en, "Reliquiarvelum"@de;
  skos:altLabel "voile de châsse"@fr, "shrine-veil"@en, "shrine-cloth"@en;
  skos:broader :c_69593e2e;
  skos:related :c_b9eb688f;
  dct:created "2020-06-18T18:07:56.000"^^xsd:dateTime;
  dct:modified "2021-01-24T17:31:32.000"^^xsd:dateTime .

:c_6d3826a1 a skos:Concept;
  skos:definition "Rekognition f; Iat. recognitio: die Prüfung von Reliquien auf ihre Echtheit, bzw. die Untersuchung des Inhaltes eines Reliquiares. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "recognition des reliques"@fr, "recognition of relics"@en, "Rekognition"@de,
    "recognitio"@la;
  skos:altLabel "reconnaissance de reliques"@fr;
  skos:broader :c_a2dc7eed;
  skos:related :c_b9eb688f, :c_1c04073c, :c_a9bd647a;
  dct:created "2020-09-27T16:08:45.000"^^xsd:dateTime;
  dct:modified "2021-01-15T17:34:00.000"^^xsd:dateTime .

:c_57226acf a skos:Concept;
  skos:definition "Reliquienaltar m: ein Altar, der durch seine enge Verbindung mit einem Reliquiar, besonders einem Reliquienschrein ausgezeichnet ist. Durch Papst Leo IV (847- 855) und das Konzil von Reims 867 wurde die Aufstellung von Reliquiaren auf oder nahe bei dem Altar ausdrücklich sanktioniert. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "autel des reliques"@fr, "reliquary altar "@en, "Reliquienaltar"@de;
  skos:broader :c_wyccl4ls;
  skos:related :c_b9eb688f, :c_03c233d0, :c_eb2e4d21;
  dct:created "2020-09-27T16:16:53.000"^^xsd:dateTime;
  dct:modified "2021-01-30T23:55:06.000"^^xsd:dateTime .

:c_e4deefc3 a skos:Concept;
  skos:definition "Reliquienmonstranz f ; Reliquienostensorium n; auch Monstranzreliquiar n; Ostensoriumreliquiar n; lat. monstrantia reliquiarum; ostensorium reliquiarum: ein Reliquienbehälter, in dem die Partikel in einem Schaugefäß enthalten sind, oft in einer durch eine metallene Wand zweigeteilten Kapsel, in deren verglaster Vorderseite sich die Reliquie befindet, während die Rückseite die gefaltete Authentiken  thält. Reliquienmonstranzen sind sehr verbreitet (seit 13. Jh.) und zeigen eine große Formenvielfalt. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "monstrance-reliquaire"@fr, "monstrance-reliquary"@en, "Reliquienmonstranz"@de,
    "monstrantia reliquiarum"@la;
  skos:altLabel "Reliquienostensorium"@de, "ostensoir-reliquaire"@fr, "Monstranzreliquiar"@de,
    "Ostensoriumreliquiar"@de, "ostensorium reliquiarum"@la;
  skos:broader :c_c800a378, :c_b8a55fa4;
  dct:created "2020-02-25T15:07:53.000"^^xsd:dateTime;
  dct:modified "2021-01-25T11:29:57.000"^^xsd:dateTime .

:c_2e3d5fc3 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8;
  skos:prefLabel "Körperteilreliquiar"@de;
  skos:broader :c_b9eb688f, :c_b8a55fa4;
