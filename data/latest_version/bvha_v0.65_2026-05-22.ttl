:c_9a284967 a skos:Concept;
  skos:definition "Gloriole (auch Nimbus, Glorie), Lichtscheibe oder -kreis um oder über dem Haupt von Heiligen und Engeln. [Koch 2009]"@de,
    "Též nimbus, glorie. Světelný kotouč nebo kruh kolem hlavy nebo nad hlavou světců a andělů. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_37522b74,
