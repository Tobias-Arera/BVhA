:c_6fdbbcb5 a skos:Concept;
  skos:definition "Gussgewölbe, in dessen Schale topfähnl. Tonhohlkörper eingegossen sind, um das Gewicht herabzusetzen. Bei Kuppeln sind die Töpfe meist spiralförmig angeordnet. T. kommen in der spätantiken und byzantin. Baukunst vor. [Koepf / Binding 2016]"@de,
    "Leichtes Gussgewölbe, in das Tontöpfe eingefügt sind, die nebeneinander gelegt oder ineinander gesteckt und dann in spiralförmigen Schichten hochgeführt werden. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "voûte en poterie(s) creuse(s)"@fr, "džbánková klenba"@cs, "vault constructed of terra-cotta pots"@en,
    "volta doliare"@it, "bóveda de pote"@es, "Topfgewölbe"@de;
  skos:altLabel "Tongewölbe"@de, "Vasengewölbe "@de, "voûte à drains de poterie emboîtes"@fr;
  skos:broader :c_049c4c22, :c_2623d3ff;
  dct:created "2019-12-12T16:49:41.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:39:39.000"^^xsd:dateTime;
  :broaderByConstruction :c_049c4c22, :c_2623d3ff .

