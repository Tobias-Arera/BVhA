:c_0eea2334 a skos:Concept;
  skos:definition "Rosenkranz m; auch Gebetskranz m; Gebetsschnur f ; Paternoster n; Iat. rosarium; corona: eine Kette mit großen und kleinen Perlen oder Kugeln, die in einer festgelegten Abfolge aufgereiht und denen bestimmte Gebete zugeordnet sind. Der Rosenkranz wird bei der Marienandacht benützt. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "rosarium"@la, "Rosenkranz"@de;
  skos:altLabel "Gebetskranz"@de, "Gebetsschnur"@de, "Paternoster"@de;
  skos:broader :c_0b7daa52, :c_49b400f3, :c_1f8af5be;
  skos:narrower :c_0d388910, :c_232f8ad0, :c_13603a28;
  skos:related :c_fbb8b39a, :c_1d215e80, :c_973a9b84, :c_8b52c299;
  dct:created "2020-09-27T20:47:28.000"^^xsd:dateTime;
  dct:modified "2021-01-22T13:31:02.000"^^xsd:dateTime .

:c_1f8af5be a skos:Concept;
  skos:definition "Devotionalien f pl: Gegenstände für die private religiöse Andacht, auch Erinnerungsstücke an Wallfahrten und Objekte, die als Votivgaben an WalIfahrtsorte gebracht werden. Man schreibt ihnen gelegentlich heilende und schützende Wirkung zu. Devotionalien gehören vornehmlich der volkstümlichen Kleinkunst an, manchmal werden sie auch mit besonderer kirchlicher Erlaubnis hergestellt und sind mit Ablässen verbunden. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "objets de piété"@fr, "objects of devotion"@en, "Devotionalie"@de,
    "devocionálie"@cs;
  skos:altLabel "objets de dévotion"@fr;
  skos:broader :c_0e073b8b;
  skos:narrower :c_0eea2334, :c_8b52c299, :c_134a2d4f, :c_481b7ccd, :c_414b6a3d, :c_bbbf2b23,
