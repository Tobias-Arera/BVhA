:c_1b6b63c4 a skos:Concept;
  skos:definition "Staurogramm n: ein Kreuz mit einem Ρ (Rho) als Standbalken, etwa seit dem Jahre 200 nachweisbar. Ein berühmtes Beispiel ist das Staurogramm mit Nimbus und der Hand Gottes im Kuppelmosaik des Baptisteriums von San Giovanni in Fonte zu Neapel um 400. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "staurogramme"@fr, "staurogram"@en, "Staurogramm"@de;
  skos:broader :c_38e881e4;
  dct:created "2020-08-31T16:35:21.000"^^xsd:dateTime;
  dct:modified "2021-01-22T10:38:19.000"^^xsd:dateTime .

:c_61930c96 a skos:Concept;
  skos:definition "(Alpha und Omega, erster und letzter Buchstabe des griech. Alphabets) für die Unendlichkeit Gottes. [Koch 2009]"@de,
    "Alpha und Omega: der erste und letzte Buchstabe des griechischen Alphabets, christologisch interpretiert als Name Gottes (Apk 1,8), der Erste und der Letzte, der Anfang und das Ende (seit 2. Hälfte 4. Jh.). Die Buchstaben begleiten oft das Chri stusmonogramm, das Gotteslamm und andere Symbole. [Glossarium Artis]"@de,
    "První a poslední písmeno řecké abecedy, symbol nekonečnosti Boží. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9, :conceptScheme_1f14b4dd;
  skos:prefLabel "alpha et oméga "@fr, "alpha and omega"@en, "Alpha und Omega"@de, "alfa a omega"@cs;
  skos:broader :c_0gcqi8ey;
  dct:created "2020-08-11T09:54:19.000"^^xsd:dateTime;
  dct:modified "2021-01-22T10:31:47.000"^^xsd:dateTime .

