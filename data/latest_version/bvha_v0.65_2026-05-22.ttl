:c_92c6ffd3 a skos:Concept;
  skos:definition "Staurothek f; Kreuzreliquiar n; auch Partikelkreuz n; gr. staurotheke: ein Tafelreliquiar mit einer Partikel des Heiligen Kreuzes. Beispiel: die Staurothek im Dom zu Limburg (um 950). Zu unterscheiden vom Reliquienkreuz. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe;
  skos:prefLabel "Staurothek"@de, "staurotéka"@cs, "staurotheke"@el, "reliquaire de la Vraie Croix"@fr,
    "True Cross-reliquary"@en;
  skos:altLabel "staurothèque"@fr, "staurothek"@en, "Kreuzreliquiar"@de, "Partikelkreuz"@de;
  skos:broader :c_b9eb688f;
  dct:created "2020-08-12T08:53:47.000"^^xsd:dateTime;
  dct:modified "2020-09-24T19:13:57.000"^^xsd:dateTime .

:c_8c991bcc a skos:Concept;
  skos:definition "Baumreliquiar n; auch Reliquienbaum m: ein Reliquienbehälter, der den Lebensbaum (arbor vitae) symbolisiert. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "arbre-reliquaire"@fr, "tree-reliquary"@en, "Baumreliquiar"@de;
  skos:altLabel "Reliquienbaum"@de;
  skos:broader :c_b9eb688f;
  skos:related :c_1827f04a;
  dct:created "2020-09-01T19:55:41.000"^^xsd:dateTime;
  dct:modified "2020-09-01T20:03:17.000"^^xsd:dateTime .

