:c_1d215e80 a skos:Concept;
  skos:definition "Rosenkranz m; Rosenkranzpsalter m; Marienpsalter m; marianischer Psalter m; lat. psalterium BMV; rosarium marianum:eine der Marienverehrung dienende, mit Ablässen verbundene Andachtsübung, zu deren Durchführung der Rosenkranz benützt wird und die meist aus drei Abteilungen besteht: den freudenreichen, den schmerzensreichen und den glorreichen Geheimnissen des Lebens Jesu. Jede Abteilung besteht aus fünf Teilen (Gesetzen). [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "rosaire psautier"@fr, "Lady psalter"@en, "Rosenkranzgebet"@de, "psalterium BMV"@la;
  skos:altLabel "rosary"@en, "Rosenkranzpsalter"@de, "Marienpsalter"@de, "marianischer Psalter"@de,
    "rosarium marianum"@la;
  skos:broader :c_fddcfb20;
  skos:related :c_0eea2334, :c_cdc23551;
  dct:created "2020-09-28T19:48:46.000"^^xsd:dateTime;
  dct:modified "2021-01-15T17:10:17.000"^^xsd:dateTime .

