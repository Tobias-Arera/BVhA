:c_7eeca620 a skos:Concept;
  skos:definition "Fluchtlinie, im Bebauungsplan die Grenzlinie (Bauflucht), bis zu der an Straßen und Plätzen gebaut werden darf. Abfluchten heißt in gerade Linie bringen. [Koch 2009] "@de,
    "Stavební čára, v plánu zástavby mezní čára, po kterou lze do ulice a náměstí stavět. [Koch 2008] "@cs,
    "Gerade, horizontale Begrenzungslinie eines Bauwerks. [Koepf / Binding 2016]"@de,
    "Die von einer Baubehörde im amtl. Bebauungsplan festgelegte Linie (B.linie), über die hinaus ein Grundstück nicht bebaut werden darf. [Koepf / Binding 2016] "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_8c0441f9;
  skos:prefLabel "Bauflucht"@de, "stavební čára "@cs;
  skos:broader :c_3131b50e;
  dct:created "2020-08-25T12:53:42.000"^^xsd:dateTime;
  dct:modified "2021-01-12T17:41:47.000"^^xsd:dateTime .

