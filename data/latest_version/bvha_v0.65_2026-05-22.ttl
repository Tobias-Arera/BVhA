  dct:modified "2021-01-28T08:39:29.000"^^xsd:dateTime .

:c_826b09f1 a skos:Concept;
  skos:definition "Tabernakelschlüssel m; lat. clavicella; clavicula: der kleine Schlüssel für das Tabernakelpförtchen zum sicheren Verschluss der Eucharistie (gefordert vom Canon 938 des Codex Iuris Canonici von 1983). Er ist in der Sakristei \"an geheimem Platz unter Verschluss mittels eines zweiten Schlüssels zu verwahren\" (Hortatio vom 10. Februar 1941). [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "clef du tabernacle"@fr, "key of tabernacle"@en, "Tabernakelschlüssel"@de,
    "clavicella"@la;
  skos:altLabel "clavicula"@la;
  skos:broader :c_ef163f2f;
  skos:related :c_fd44f8d9, :c_3ebc17f0;
  dct:created "2020-08-07T13:11:20.000"^^xsd:dateTime;
  dct:modified "2021-01-28T08:39:00.000"^^xsd:dateTime .

