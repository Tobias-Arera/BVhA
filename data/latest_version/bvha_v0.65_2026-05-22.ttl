  dct:created "2020-08-28T10:48:38.000"^^xsd:dateTime;
  dct:modified "2021-01-19T10:48:22.000"^^xsd:dateTime .

:c_c9563214 a skos:Concept;
  skos:definition "Cairn, Carn (gäl.-ir.), frühgeschichtl. Grabmal in Form eines pyramidenförmig aufgeschichteten Steinhaufens, bes. in England und Irland; dort auch Bezeichnung für ebenso gebildete Grenzmale und Wegzeichen. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Cairn"@de;
  skos:broader :c_b42aa49a;
  dct:created "2020-08-28T15:44:50.000"^^xsd:dateTime;
  dct:modified "2021-01-12T16:58:46.000"^^xsd:dateTime .

:c_83bee789 a skos:Concept;
  skos:definition "Coemeterium (lat., v. gr. koimeterion: Schlafkammer), altchristl. Begräbnisstätte bes. in den Katakomben, auch allg. Friedhof. [Koepf / Binding 2016]"@de;
