:c_bf342bb7 a skos:Concept;
  skos:definition "Gewölbe, dessen Achse rechtwinklig zur Horizontalprojektion seines Stirnbogens verläuft, z. B. die Rundtonne. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
