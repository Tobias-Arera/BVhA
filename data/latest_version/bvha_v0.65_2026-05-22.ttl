:c_1b9089e1 a skos:Concept;
  skos:definition "Základní lidské postavy se 4 křídly nesoucími oči (od 8. stol. 6 křídel) a 4 hlavami (řec. tetramorf = se čtyřmi těly, podle vidění proroka Ezechiela 1,5-14) nejdokonalejších stvoření: orla, lva, býka a člověka; od 8. stol. vzor pro symboly----> evangelistů*, na uměleckých dílech většinou zobrazování pouze s lidskou tváří, symbolická barva: červená. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_37522b74;
  skos:prefLabel "Cherub"@de, "cherubín"@cs;
  skos:altLabel "8. Cherub"@de, "Cherubim"@de, "8. cherubín"@cs;
  skos:broader :c_63c4e0f5;
  dct:created "2020-08-04T09:09:03.000"^^xsd:dateTime;
  dct:modified "2021-01-20T09:49:11.000"^^xsd:dateTime .

:c_84b25607 a skos:Concept;
  skos:definition "Podle Izaiáše 6,2 a 6,6 andělé u božího trůnu, kteří si 2 křídly zakrývají tvář a nohy a 2 dalšími křídly létají, symboly rychlosti, jíž má být uskutečněna boží vůle, symbolická barva: modrá. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_37522b74;
  skos:prefLabel "Seraph"@de, "serafín"@cs;
  skos:altLabel "9. Seraph"@de, "Seraphim"@de, "9. serafín"@cs;
  skos:broader :c_63c4e0f5;
  dct:created "2020-08-04T09:10:52.000"^^xsd:dateTime;
  dct:modified "2021-01-20T09:49:43.000"^^xsd:dateTime .

