:c_d850d2bd a skos:Concept;
  skos:definition "Eingezapftes, den Winkel zwischen vertikalen und horizontalen Gerüsthölzern vollständig ausfüllendes Holz, in der Ansicht dreieckig. [Eißing et al. 2012]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_19d56a39;
