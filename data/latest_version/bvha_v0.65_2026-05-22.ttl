  dct:modified "2021-01-30T23:51:11.000"^^xsd:dateTime;
  :broaderByFunction :c_klbrisjd .

:c_559a45ba a skos:Concept;
  skos:definition "Herz-Jesu-Bild n: eine Darstellung Christi mit einem brennenden Herzen auf der Brust, Symbol des liebenden und leidenden Heilandes; ein aus der deutschen Mystik hervorgegangenes Bild der Christusfrömmigkeit. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "image de Sacré-Cœur"@fr, "image of the Sacred Heard"@en, "Herz-Jesu-Bild"@de;
