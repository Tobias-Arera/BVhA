:c_3adceef3 a skos:Concept;
  skos:definition "Kröpfung, Vorziehen eines Gebälks samt Fries und Gesims, eines Gesimses u. dergl. über einem vorstehenden Bauteil (Wandsäule, Wandpfeiler, Pilaster, Mauervorsprung u. dergl.). Die vorstehende Kante des verkröpften Elements heißt Kropfkante. Der Höhe nach Verkröpfen wird aufkröpfen genannt. [Koepf / Binding 2016]"@de,
    "Zalomení z vodorovné do svislé polohy nazýváme svislé zalomení. [Koch 2008]"@cs,
    "Gesims. Die Verkröpfung aus der Waagerechten in die Senkrechte nennt man Aufkröpfung. [Koch 2009]"@de,
    "Zalomená (lomená) je římsa vedená celým svým profilem klikatě kolem výstupků ve zdi = zalomení. [Koch 2008]"@cs,
    "Herausspringen bzw. Vorziehen eines Gesimses, Gebälkes oder Frieses aus der Ebene, um ein hervorstehendes → Bauelement, wie eine → Wandsäule, ein → Wandpfeiler, eine → Wandvorlage oder dergleichen zu umlaufen. Die Verkröpfung erfolgt dementsprechend in der Grundrissebene. Die Höhe des Gesimses, Gebälkes oder Frieses in der Ansichtsebene bleibt dabei unverändert. Das Herausspringen bzw. Vorziehen oder das Verkröpfen solcher Elemente in der Höhe, d.h. in der Ansichtsebene bzw. die \"... Verkröpfung aus der Waagerechten in die Senkrechte ...\" [Koch 2009] wird als → Aufkröpfung bezeichnet. [BVHA, Tobias Arera-Rütenik]"@de;
  skos:scopeNote "Herausspringen bzw. Vorziehen eines Gesimses, Gebälkes oder Frieses über ein aus der Ebene hervorstehendes Bauteil. [BVHA, Tobias Arera-Rütenik]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "risalto"@it, "Verkröpfung"@de, "acodadura"@es, "zalomení"@cs, "crossette"@fr;
  skos:altLabel "recoupement"@fr, "ripiegatura"@it;
  skos:broader :c_2b8c8e23;
  skos:related :c_01e49620;
  dct:created "2020-02-11T16:25:38.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:22:53.000"^^xsd:dateTime .

:c_e3e3c46e a skos:Concept;
  skos:scopeNote "Umlaufen eines Gesimses, Gebälkes oder Frieses um ein in der Ansichtsebene nach oben hervorstehendes Bauteil, im Unterschied zur → Verkröpfung. [BVHA, Tobias Arera-Rütenik]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe;
  skos:prefLabel "Aufkröpfung"@de;
  skos:broader :c_2b8c8e23;
  dct:created "2020-02-11T16:25:59.000"^^xsd:dateTime;
  dct:modified "2021-01-26T10:57:22.000"^^xsd:dateTime .

