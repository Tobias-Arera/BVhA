:c_f7983f12 a skos:Concept;
  skos:definition "Morgenglocke f; lat. matutinalis campana: eine kleinere Turmglocke, die am frühen Morgen geläutet wurde; auch die zum Wecken der Mönche im Kloster geläutete Glocke. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
