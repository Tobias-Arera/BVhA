  skos:broader :c_47v6axo2;
  dct:created "2020-07-26T15:45:00.000"^^xsd:dateTime;
  dct:modified "2021-01-30T23:44:53.000"^^xsd:dateTime .

:c_c49a059b a skos:Concept;
  skos:definition "Glockenspiel n: ein Klangkörper aus mehreren, mindestens aber vier chromatisch aufeinander abgestimmten Glocken, die durch Hämmer mit der Hand angeschlagen oder automatisch mit Stiftwalzen betätigt werden; in Europa seit dem 9. Jh. bekannt. Beispiel: das Glockenspiel von Dünkirchen mit 44 Glocken. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "carillon"@fr, "chime of bells"@en, "Glockenspiel"@de;
  skos:broader :c_47v6axo2;
  dct:created "2020-07-26T15:48:56.000"^^xsd:dateTime;
  dct:modified "2021-01-30T23:45:18.000"^^xsd:dateTime .

:c_5b71a38d a skos:Concept;
  skos:definition "Hammerglocke f: eine unbewegliche Glocke, deren Geläut durch den Anschlag eines Glockenhammers von außen auf den Glockenkörper bewirkt wird. Der Hammer wird manchmal von einer Glockenschläger-Figur (f) betätigt. Beispiel: die Mohren am Uhrturm der Piazza di San Marco in Venedig (1597). [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "Hammerglocke"@de, "timbre"@fr;
  skos:altLabel "bell"@en;
  skos:broader :c_47v6axo2;
  skos:related :c_c91806a6;
  dct:created "2020-07-26T15:51:56.000"^^xsd:dateTime;
  dct:modified "2021-01-30T23:45:45.000"^^xsd:dateTime;
  :broaderByConstruction :c_47v6axo2 .

