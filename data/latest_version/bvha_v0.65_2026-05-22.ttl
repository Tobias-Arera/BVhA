:c_dc8fc75b a skos:Concept;
  skos:definition "Ein wiederkehrender Wechsel von Pfeilern und Säulen, bei dem ein Pfeiler auf eine oder mehrere Säulen folgen kann, auch Wechsel von runden und quadrat. Pfeilern mit Diensten. [Koepf / Binding 2016]"@de,
    "Střídání pilířů (P) a sloupů (S) v pořadí P-S-P-S, nebo P-S-S-P. [Koch 2008]"@cs,
    "Eine sich nach einem bestimmten Rhythmus vollziehende Abfolge unterschiedlicher Stützen, z. B. der Wechsel zwischen Pfeilern und Säulen. [Glossarium Artis]"@de,
    "Wechsel von Pfeiler P und Säule S im Mittelschiff romanischer Basiliken, entweder in der Abfolge P-S-P-S oder P-S-S-P. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9, :conceptScheme_1f14b4dd;
