:c_df30c1bf a skos:Concept;
  skos:definition "Schräg ansteigende Zufahrt oder Zugang (schiefe Ebene) zu einem erhöhten Platz, einer Terrasse oder einem Bauwerk. Monumentale R.n kommen bei ägypt. Terrassentempeln, bei assyr. Palästen und Zikkurats vor. Beim Bau der Pyramiden verwendete man R.n zum Materialtransport.  R.n mit gewendeltem Lauf nennt man Wendelr.n (Wendeltürme: Samarra, Spiralturm, Minar). [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "rampa"@cs, "ramp"@en, "rampa"@it, "rampa"@es, "Rampe"@de, "rampe (d\\'accés)"@fr;
  skos:altLabel "větev mimoúrovňové křižovatky"@cs;
  skos:broader :c_747561e8;
  skos:narrower :c_62f9df73;
  dct:created "2020-08-21T15:19:21.000"^^xsd:dateTime;
  dct:modified "2021-01-22T19:18:40.000"^^xsd:dateTime .

