:c_2a9df779 a skos:Concept;
  skos:definition "Dorment (lat. dormire: schlafen), urspr. jedes Schlafgemach, dann Schlafsaal der Mönche, meist im Obergeschoss des östl. Klosterflügels, auch die Gesamtheit der späteren Einzelzellen und somit der entsprechende Klosterflügel. [Koepf / Binding 2016]"@de,
    "Společná ložnice v klášteře. [Koch 2008]"@cs, "Schlafsaal eines Klosters. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_37522b74, :conceptScheme_8c0441f9;
