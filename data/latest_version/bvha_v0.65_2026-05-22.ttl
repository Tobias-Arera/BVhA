  dct:modified "2021-01-15T16:56:05.000"^^xsd:dateTime .

:c_251c85ef a skos:Concept;
  skos:definition "Rippenreliquiar n: ein halbkreisförmiger Reliquienbehälter, der auf einem meist reich verzierten Ständer aus Edelmetall montiert ist. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "côte-reliquaire"@fr, "rib-reliquary"@en, "Rippenreliquiar"@de;
  skos:broader :c_2e3d5fc3;
  dct:created "2020-09-23T20:45:49.000"^^xsd:dateTime;
  dct:modified "2021-01-24T15:56:11.000"^^xsd:dateTime .

