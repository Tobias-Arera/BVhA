:c_2b59d776 a skos:Concept;
  skos:definition "Kerner, Gerner (lat. carnarium = Beinhaus), meist zweigeschossige Friedhofskapelle, deren Untergeschoss ausgegrabene Gebeine, deren Obergeschoss den Altarraum enthält. In der Romanik Zentralbau mit Ostapsis, in der Gotik auch als langgestreckte (Michaels-)Kapelle. [Koch 2009]"@de,
    "Lat. carnarium = kostnice. Většinou dvojpodlažní hřbitovní kaple, v jejímž spodním podlaží byly uloženy vyzdvižené ostatky, v horním podlaží se nacházel presbytář; v románské době centrální stavba s východní apsidou, v gotice také podélná kaple (zpravidla sv. Michaela). [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "Karner"@de, "karner"@cs;
  skos:altLabel "Kerner"@de, "Gerner"@de, "Ossarium"@de, "Ossuarium"@de;
  skos:broader :c_9b120fa1;
  dct:created "2020-08-05T15:00:53.000"^^xsd:dateTime;
  dct:modified "2021-01-19T14:50:03.000"^^xsd:dateTime .

