:c_4107cb37 a skos:Concept;
  skos:definition "Dient zur waagerechten und senkrechten Verlängerung von Hölzern in einfachster Weise. Der Endquerschnitt verläuft senkrecht zur Längsachse. Gegen Verschieben sind g.S.e durch Klammern u.Ä. zu sichern. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Gerader Stoß"@de;
  skos:broader :c_d5f3f3e0;
  dct:created "2020-09-29T12:22:54.000"^^xsd:dateTime;
  dct:modified "2021-03-19T18:54:00.000"^^xsd:dateTime .

:c_75997c62 a skos:Concept;
  skos:definition "Geschosshöhe, Maß von der Fußbodenoberkante eines Stockwerks bis zur Fußbodenoberkante des nächsten, also lichte Raumhöhe plus Deckendicke. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_84fc24e6, :conceptScheme_315cf028;
  skos:prefLabel "Stockwerkshöhe"@de, "interpiano"@it, "konstrukční výška podlaží"@cs,
    "hauteur d\\'étage"@fr, "storey height"@en;
  skos:altLabel "výška podlaží"@cs;
  skos:broader :c_b51bc052;
  dct:created "2020-08-11T16:24:10.000"^^xsd:dateTime;
  dct:modified "2021-01-30T14:51:37.000"^^xsd:dateTime .

:c_a4edb279 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c8a571d9;
  skos:prefLabel "Fachwerkgebäude"@de;
  skos:altLabel "Fachwerkbau"@de;
  skos:broader :c_d6f572a5;
  skos:narrower :c_32af0f8e, :c_dce60e4c;
  dct:created "2020-12-15T12:51:35.000"^^xsd:dateTime;
  dct:modified "2021-01-26T23:18:08.000"^^xsd:dateTime;
  :broaderByConstruction :c_d6f572a5 .

:c_f8fdc6b3 a skos:Concept;
  skos:definition "Stirnbohle, ein Brett, das vor die Stirn der Dachbalkenlage, also vor die nach unten schräg einwärts abgeschnittenen Balkenköpfe genagelt ist und die Stelle des Gesimses einnimmt. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_167cb98f;
  skos:prefLabel "planche de rive"@fr, "eaves board"@en, "Stirnbrett"@de;
  skos:altLabel "okřídlí"@cs, "chanlatte"@fr, "bordure de pignon"@fr, "saledizo"@es;
  skos:broader :c_ba70e9ab;
  dct:created "2020-08-11T16:57:05.000"^^xsd:dateTime;
  dct:modified "2021-01-22T15:05:52.000"^^xsd:dateTime;
  :broaderByPosition :c_ba70e9ab .

:c_2ff1ad3c a skos:Concept;
  skos:definition "Erscheinungsform des deutschen Historismus mit byzantinischen Bauformen und Elementen der italienischen Romanik und Renaissance. Ursprünge bei K. F. Schinkel, L. Persius (Berlin); besonders verbreitet in München (Ludwigskirche, F. v. Gärtner; Bahnhof, F. Bürklein), Karlsruhe (H. Hübsch, F. Eisenlohr), Hannover (C. W. Hase). Nachwirkungen bis zum Stuttgarter Bahnhof, 1912-31, P. Bonatz. [Koch 2009]"@de,
    "Projev německého historismu s byzantskými architektonickými prvky a prvky italského románského slohu a renesance; na počátku stál K. F. Schinkel, L. Persius (Berlín), zvl. rozšířen v Mnichově (Ludwigskirche, F. v. Gartner; nádraží, F. Biirklein), Karlsruhe (H. Hiibsch, F. Eisenlohr), Hannoveru (C. W. Hase}; vlivy patrné ještě i na stuttgartském nádraží, 1912-31, P. Bonatz. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9;
  skos:prefLabel "Rundbogenstil"@de, "rundbogenstil"@cs;
  skos:broader :c_qojdlphd;
  dct:created "2020-08-11T17:06:00.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:22:23.000"^^xsd:dateTime .

:c_325ec138 a skos:Concept;
  skos:definition "Durch Malerei oder Relief vorgetäuschte Architekturteile an Wänden oder Decken, die den Innenraum meist illusionistisch erweitern. Besonders pompejanische Architektur und Barock. [Koch 2009]"@de,
    "Eine illusionist. gemalte oder durch Reliefwirkung nur angedeutete Architektur, die räuml. nicht existiert. S. findet man v. a. in barocken Kirchenbauten, um eine Raumausweitung zu erzielen. [Koepf / Binding 2016]"@de,
    "Architektonické prvky napodobené pomocí malby nebo reliéfu na stěnách nebo klenbách, které iluzivně rozšiřují vnitřní prostor, zvl. pompejská architektura a baroko. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "architecture simulée"@fr, "iluzivní architektura"@cs, "illusionistic architecture"@en,
    "architettura finta"@it, "arquitectura aparente"@es, "Scheinarchitektur"@de;
  skos:altLabel "architettura trompe-l\\'œil"@it, "arquitectura simulada"@es;
  skos:broader :c_219f468f;
  dct:created "2020-08-11T17:20:07.000"^^xsd:dateTime;
  dct:modified "2021-01-26T17:06:59.000"^^xsd:dateTime .

