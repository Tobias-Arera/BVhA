  dct:modified "2021-01-22T19:11:56.000"^^xsd:dateTime .

:c_a2909416 a skos:Concept;
  skos:definition "Bei der gestemmten Füllungstür jedes aufrechte Rahmenholz. [Schrader / Voigt 2003]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_5bf6bcac;
