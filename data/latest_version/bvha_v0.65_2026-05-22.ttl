:c_bci8b96z a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ef0a8695, :conceptScheme_ec8c77bf;
  skos:prefLabel "Firnis"@de, "varnish"@en;
  skos:note "A solution of a binder in a solvent, applied for aesthetic or protective purposes as a thin, transparent coating, as a final layer over a painting. [EwaGlos]"@en,
    "Lösung aus Bindemittel in Lösemittel, die aus ästhetischen Gründen oder zum Schutz als dünne, transparente Beschichtung zuletzt auf die Malerei aufgetragen wird. [EwaGlos]"@de;
  skos:broader :c_8c9ea27b;
  skos:narrower :c_aaf69ea1, :c_15137f46, :c_df273259;
  dct:created "2019-05-07T18:16:02.000"^^xsd:dateTime;
  dct:modified "2021-01-30T15:42:30.000"^^xsd:dateTime .

:c_b6prqhi5 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ef0a8695, :conceptScheme_ec8c77bf;
  skos:prefLabel "Gips"@de, "gypsum"@en, "sádra"@cs;
  skos:note "A soft mineral composed of calcium sulfate dihydrate. [EwaGlos]"@en, "Ein weiches Mineral aus Calciumsulfat-Dihydrat. [EwaGlos]"@de;
  skos:broader :c_34df71dd, :c_bbe43d47, :c_65fe071d;
  skos:narrower :c_54af5a6c;
  dct:created "2019-05-22T17:59:41.000"^^xsd:dateTime;
  dct:modified "2021-01-30T14:58:56.000"^^xsd:dateTime .

:c_imrbnvf1 a skos:Concept;
  skos:definition "Durch Einfügen von Hohlräumen in sein Gefüge leichter gemachter Backstein. Liegen die Hohlräume parallel zur Lagerfläche, wird er als Langlochziegel bezeichnet; stehen sie senkrecht zur Lagerfläche, heißt er Hochlochziegel oder Querlochziegel. Hohlziegel wurden bereits bei den Römern zur Installation von Heißluftheizungen verwendet. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "brique creuse"@fr, "hollow brick"@en, "Lochziegel"@de, "tubulus"@la;
  skos:altLabel "Hohlziegel"@de, "brique perforée"@fr, "cavity brick"@en;
  skos:broader :c_0cb8deb1;
  skos:narrower :c_4b80959c, :c_d2d393b9, :c_9763a0a2;
  dct:created "2019-05-07T14:22:54.000"^^xsd:dateTime;
  dct:modified "2021-03-19T18:32:01.000"^^xsd:dateTime .

:c_bvscnjkx a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_37522b74, :conceptScheme_8c0441f9,
    :conceptScheme_ec8c77bf;
  skos:prefLabel "Keramik"@de, "ceramic"@en, "keramika"@cs;
  skos:note "A hard and brittle, heat- and corrosion- resistant material, made by shaping clay or similar earth materials and subsequently firing them at high temperatures. [EwaGlos]"@en,
    "Ein hartes, sprödes, hitze- und korrosionsbeständiges Material, das durch die Formung von Tonerde oder ähnlichen Erdmaterialien und späteren Brand bei hohen Temperaturen hergestellt wird. [EwaGlos]"@de,
    "Keramik (griech. keramos = Töpferton), Sammelbegriff für Tonwaren. Man unterscheidet Grob-Keramik (Ziegel, Röhren, Baukeramik) und Fein-Keramik (Geschirr, Gefäße, kunstgewerbliche Gegenstände). Die Porosität des Scherben wird aufgehoben durch Sinterung des Tons bei hoher Brenntemperatur und durch Glasur. [Koch 2009]"@de,
    "Řec. keramos = hrnčířská hlína. Souhrnný název pro výrobky z hlíny, rozlišujeme keramiku hrubou (cihly, trubky, stavební keramika) a jemnou (nádobí, nádoby, umělecké předměty); pórovitost výrobku se odstraňuje spékáním hlíny při vysoké vypalovací teplotě a glazurováním. [Koch 2008]"@cs;
  skos:broader :c_jqmv6iaq;
  skos:narrower :c_380577c3, :c_be20e6da, :c_7daa3a60, :c_451a03d3, :c_9a3af356, :c_ba2faafd;
  skos:related :c_33318aad;
  dct:created "2019-06-11T21:32:17.000"^^xsd:dateTime;
  dct:modified "2020-08-24T10:10:22.000"^^xsd:dateTime .

:c_rhrrwb0h a skos:Concept;
  skos:definition "Externe Faktoren, die natürlich oder anthropogen sein können, verursachen Zerfall. [EwaGlos]"@de,
    "Dépôt très fin de particules exogènes (par ex. poussières, suies) donnant un aspect sale à la surface de pierre. [ICOMOS-ISCS]"@fr,
    "The accumulation of extraneous material on a surface leading to discolouration. [EwaGlos]"@en,
    "Deposit of a very thin layer of exogenous particles (eg. soot) giving a dirty appearance to the stone surface. [ICOMOS-ISCS]"@en,
    "Ablagerung einer sehr dünnen Schicht von Fremd - partikeln (z. B. Ruß), welche der Stein ober fläche ein schmutziges Aussehen verleihen. [ICOMOS-ISCS]"@de,
    "znečištění, špinění je uložení velmi tenké vrstvy exogenních částic (např. sazí), dávající povrchu kamene špinavý vzhled. [ICOMOS-ISCS]"@cs;
  skos:scopeNote "Beziehungen zum Substrat: Bei einer Verschmutzung wird die Struktur des Substrats nicht angegriffen. Die Verschmutzung kann unterschiedlich stark am Substrat haften.[ICOMOS-ISCS]"@de,
    "Relationship with the substrate : With soiling, the substrate stucture is not considered as affect - ed. Soiling may have different degrees of adhesion to the substrate. [ICOMOS-ISCS]"@en;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_ec8c77bf,
    :conceptScheme_34ca6582;
  skos:prefLabel "Verschmutzung"@de, "encrassement"@fr, "soiling"@en, "znečištění"@cs;
  skos:altLabel "dirt"@en, "salissure"@fr, "Schmutz"@de, "Kontamination"@de, "Verunreinigung"@de,
    "Dreck"@de;
  skos:broader :c_ed43f447, :c_c2d76511, :c_63d87b7c;
  dct:created "2019-07-05T21:46:32.000"^^xsd:dateTime;
  dct:modified "2021-01-15T17:58:58.000"^^xsd:dateTime .

:c_zowlwzvp a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ef0a8695,
    :conceptScheme_ec8c77bf;
  skos:prefLabel "Pigmentveränderung"@de, "pigment alteration"@en;
  skos:note "Change in colour or chemical structure by means of a chemical or physical reaction. [EwaGlos]"@en,
    "Veränderung der Farbe oder der chemischen Struktur durch chemische oder physikalische Reaktion. [EwaGlos]"@de;
  skos:broader :c_ed43f447;
  dct:created "2019-07-14T15:54:08.000"^^xsd:dateTime;
  dct:modified "2021-01-30T17:50:25.000"^^xsd:dateTime .

:c_iye5j8si a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ef0a8695,
    :conceptScheme_ec8c77bf;
  skos:prefLabel "Korrosion"@de, "corrosion"@en, "koroze"@cs;
  skos:note "The chemical and physical degradation of architectural surfaces, stone or metal, caused by weathering or corrosive substances with which they come into contact. [EwaGlos]"@en,
    "Chemischer und physikalischer Verfall von Architekturoberflächen, Stein oder Metall, verursacht durch Verwitterung oder korrosive Substanzen, mit denen sie in Kontakt kommen. [EwaGlos]"@de;
  skos:broader :c_ed43f447;
  dct:created "2019-07-06T19:56:51.000"^^xsd:dateTime;
  dct:modified "2021-01-30T17:49:19.000"^^xsd:dateTime .

:c_oskyixgn a skos:Concept;
  skos:definition "Modification chromatique superficielle, résultant d’une altération naturelle ou artificielle et n`impliquant généralement pas de dégradation superficielle visible. [ICOMOS-ISCS]"@fr,
    "Chromatic modification of the material, generally resulting from natural or artificial ageing and not involving in most cases visible surface deterioration. [ICOMOS-ISCS]"@en,
    "Auch Edelrost, die äußere Schicht auf Kupfer und Bronze, die mit der Zeit durch Oxidation entsteht, aber auch oft künstlich erzeugt oder imitiert wird. Ihre grüne, braune oder schwarze Farbe gilt als Zeichen ehrwürdigen Alters. [Koch 2009]"@de,
    "Farbliche Veränderung des Materials, allgemein re - sultierend aus natürlicher oder künstlicher Alterung. Mit Patina ist in der Regel keine sichtbare Schä - digung der Oberfläche verbunden. [ICOMOS-ISCS]"@de,
    "Barevná přeměna materiálu, obecně vzniklá přírodnímnebo umělým stárnutím materiálu a neobsahujícíve většině případů viditelné povrchové poškození. [ICOMOS-ISCS]"@cs,
    "Povrchová vrstva na mědi a bronzu vznikající oxidací, často však bývá i uměle vytvářena nebo imitována. Její zelená, hnědá nebo černá barva bývá považována za známku úctyhodného stáří. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_37522b74, :conceptScheme_8c0441f9,
    :conceptScheme_315cf028, :conceptScheme_ef0a8695, :conceptScheme_ec8c77bf, :conceptScheme_34ca6582;
  skos:prefLabel "Patina"@de, "patine"@fr, "patina"@en, "patina"@cs;
  skos:note "A natural alteration which appears at the surface of various materials due to ageing, use, handling, oxidation, and/or exposure to the environment. A patina can also be applied artificially. [EwaGlos]"@en,
    "Eine natürliche Veränderung, die sich auf der Oberfläche verschiedener Materialien durch Alterung, Benutzung, Gebrauch, Oxidation und/oder Umwelteinflüsse ergeben kann. Sie kann auch künstlich aufgebracht werden. [EwaGlos]"@de;
  skos:broader :c_ed43f447;
  skos:narrower :c_768dcd24, :c_33d8c043;
  dct:created "2019-07-14T13:52:54.000"^^xsd:dateTime;
  dct:modified "2021-01-30T17:50:06.000"^^xsd:dateTime .

