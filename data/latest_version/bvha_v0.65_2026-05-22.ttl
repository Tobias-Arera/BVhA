:c_36751d31 a skos:Concept;
  skos:definition "Gebrauchter Mauerziegel aus einem Bauwerk, das im Rahmen eines selektiven Rückbaus in seine Einzelteile zerlegt wird und danach wieder für Neubauten oder für die Restaurierung von Altbauten Verwendung finden kann. [Schrader / Voigt 2003]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_5bf6bcac;
  skos:prefLabel "Abbruchziegel"@de;
  skos:broader :c_5ogzoa7b;
  dct:created "2020-01-15T12:43:09.000"^^xsd:dateTime;
  dct:modified "2021-03-19T18:08:31.000"^^xsd:dateTime .

:c_df3fefed a skos:Concept;
  skos:definition "Jede Art von Dachziegel oder Mauerziegel, der zur Abdeckung einer Mauer verwendet wird. Von den Dachziegeln eignen sich hierzu insbesondere  Biberschwanzziegel, Hohlpfannen sowie Mönch-Nonne-Ziegel, aber auch Falzdachziegel. [Schrader / Voigt 2003]"@de,
    "Abdeckstein, zur Abdeckung von freistehenden Mauern als Backsteine (Rollschicht), Dachsteine, Formsteine oder Betonplatten zum Schutz gegen das Eindringen von Niederschlägen in die Stoßfugen des Mauerwerks. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_5bf6bcac;
  skos:prefLabel "Abdeckziegel"@de;
  skos:altLabel "Abdeckstein"@de;
  skos:broader :c_0cb8deb1;
  dct:created "2020-01-15T14:29:40.000"^^xsd:dateTime;
  dct:modified "2021-01-26T16:36:10.000"^^xsd:dateTime;
  :broaderByFunction :c_0cb8deb1 .

:c_07b9b27d a skos:Concept;
  skos:definition "Fallrohr, Abfallrohr, zur Entwässerung der Dachfläche an die Dachrinne angeschlossene Röhre zur Ableitung des Wassers. [Koepf / Binding 2016]"@de,
    "Hohlkörper mit rundem oder eckigem Querschnitt zur Abführung von Abwasser, aus Holz oder  Gusseisen, aber auch aus Keramik. [Schrader / Voigt 2003]"@de,
    "Abfallrohr, Hohlkörper mit rundem oder rechteckigem Querschnitt aus Holz, Gusseisen oder Keramik zur Abführung von Abwasser, auch vom Dach. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_5bf6bcac;
  skos:prefLabel "Abfallrohr"@de, "odpadní trubka"@cs;
  skos:altLabel "Fallrohr"@de;
  skos:broader :c_b99ef53b;
  dct:created "2020-01-15T15:00:54.000"^^xsd:dateTime;
  dct:modified "2020-09-08T15:05:38.000"^^xsd:dateTime .

:c_7e3aaf87 a skos:Concept;
  skos:definition "Transportierendes Bauteil der Haustechnik, um Regenwasser und Abwasser abzuleiten. Hierzu gehören u.a. Dachrinnen, Ausgusssteine und Rohre aller Art. [Schrader / Voigt 2003]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_5bf6bcac;
  skos:prefLabel "Abfluss"@de, "odtok"@cs;
  skos:altLabel "Ablauf (Entwässerung)"@de, "odpad"@cs;
  skos:broader :c_b99ef53b;
  dct:created "2020-01-15T15:03:23.000"^^xsd:dateTime;
  dct:modified "2020-08-22T16:42:49.000"^^xsd:dateTime .

:c_8ad24703 a skos:Concept;
  skos:definition "Art der Füllung einer gestemmten Füllungstür in Rahmenbauweise, bei der die äußeren Bereiche der Füllung flächig entweder geradlinig oder mit einer Kehle profiliert wurden, so dass diese besser in die Nut der Rahmenhölzer eingeführt werden können und auch bei Schrumpfung des Holzes keine offene Fuge ergeben. [Schrader / Voigt 2003]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_5bf6bcac,
    :conceptScheme_167cb98f;
  skos:prefLabel "abgeplattete Füllung"@de;
  skos:broader :c_eb7c51a5;
  dct:created "2020-01-15T15:24:25.000"^^xsd:dateTime;
  dct:modified "2021-01-22T15:12:10.000"^^xsd:dateTime;
  :broaderByConstruction :c_eb7c51a5 .

:c_eb7c51a5 a skos:Concept;
  skos:definition "Füllung einer gestemmten Füllungstür in Rahmenbauweise, wobei man diese Türen nach der Zahl und Lage der Füllungen gliedern kann. Gerade bei Zimmertüren sind sie ein stilprägendes Merkmal und tauchen nur in bestimmten Zeitspannen oder in speziellen Regionen auf. Auch die Breite der Friese kann zeitlich und regional unterschiedlich sein, wobei süddeutsche Barocktüren Friesbreiten bis zu 25 cm aufweisen können. Einige der typischen Füllungsaufteilungen sind die Einfüllungstür, Zweifüllungstür, Dreifüllungstür, Vierfüllungstür, Fünffüllungstür in verschiedenen Ausführungen. [Schrader / Voigt 2003]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_5bf6bcac,
    :conceptScheme_167cb98f;
  skos:prefLabel "Türfüllung"@de;
  skos:broader :c_8deaa968, :c_6adde293;
  skos:narrower :c_8ad24703;
  skos:related :c_826f3942;
  dct:created "2020-11-23T08:46:34.000"^^xsd:dateTime;
  dct:modified "2021-01-22T15:10:46.000"^^xsd:dateTime;
  :broaderByPosition :c_8deaa968 .

:c_826f3942 a skos:Concept;
  skos:definition "Spezielle Türkonstruktion mit einem durch Schlitz- und Zapfentechnik verbundenem Rahmen und eingeschobenen oder auch überschobenen Füllungen, die baugeschichtlich die konstruktiv einfache Brettertür abgelöst hat. Dadurch läuft das Arbeiten des Holzes nicht mehr in der Gesamtbreite ab, sondern nur noch innerhalb der Füllungen. Aus der Füllungsaufteilung lassen sich Rückschlüsse auf Stil und Entstehung ziehen. [Schrader / Voigt 2003]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_5bf6bcac;
  skos:prefLabel "gestemmte Füllungstür"@de, "panel door"@en;
  skos:altLabel "eingeschobene Tür"@de, "gestemmte Tür"@de, "Füllungstür"@de, "gestemmte Rahmentür"@de,
    "Rahmentür"@de;
  skos:broader :c_e93595cd;
  skos:narrower :c_9490720a, :c_507b668b, :c_03e54345, :c_a4587da3, :c_2fc26a5e;
  skos:related :c_eb7c51a5, :c_0da4ff83;
  dct:created "2020-06-22T15:38:27.000"^^xsd:dateTime;
  dct:modified "2021-01-22T18:53:47.000"^^xsd:dateTime;
  :broaderByConstruction :c_e93595cd .

:c_b4dbeb90 a skos:Concept;
  skos:definition "Hängezapfen, zapfenförmiger, herabhängender Schlussstein (hängender Schlussstein) an Rippengewölben bes. in spätgot. Zeit. [Koepf / Binding 2016]"@de,
    "Pozdně gotický typ svorníku, visí dolů do prostoru. [Koch 2008]"@cs, "Herabhängender Zapfen als Schlussstein eines Gewölbes oder schmückende Verzierung an sich kreuzenden Hölzern. [Schrader / Voigt 2003]"@de,
    "Ein in der Gewölbeleibungverfugter und herabhängender, häufig knauf -oder zapfenförmiger Stein, meist im Gewölbescheitel als Schlußstein.Zu unterscheiden vom Absenker und vom hängenden Trichter. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_37522b74, :conceptScheme_1f14b4dd, :conceptScheme_5bf6bcac;
  skos:prefLabel "clef pendante"@fr, "pendant"@en, "Abhängling (Gewölbe)"@de, "visutý svorník"@cs;
  skos:altLabel "pendent"@en, "cul-de-lampe"@en, "cul-de-lampe"@fr, "fausse clef pendante"@fr,
    "Hängeschlußstein"@de, "Hängezapfen"@de;
  skos:broader :c_3e25acca, :c_zafa5lop;
  dct:created "2020-01-15T15:30:03.000"^^xsd:dateTime;
  dct:modified "2021-01-19T13:15:30.000"^^xsd:dateTime;
  :broaderByPosition :c_3e25acca .

:c_b50b7a5b a skos:Concept;
  skos:definition "Wässrige, alkalische Lösung einer starken Lauge, mit der Altanstriche und Beschichtungen wie Ölfarben, Lacke und Lasurfarben chemisch so umgewandelt werden, dass sie gelöst und entfernt werden können. Bei der Anwendung auf Holz werden dessen Strukturen trotz einer etwaigen Neutralisierung mit Essigsäure und Nachwaschen mit Wasser geschädigt. [Schrader / Voigt 2003]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_5bf6bcac;
  skos:prefLabel "Ablauger"@de;
  skos:altLabel "Abbeizer"@de, "Abbeizmittel"@de;
  skos:broader :c_9jb9am2u;
  dct:created "2020-01-15T15:48:22.000"^^xsd:dateTime;
  dct:modified "2020-01-15T15:53:38.000"^^xsd:dateTime .

