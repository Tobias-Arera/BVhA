:c_4b4e99f7 a skos:Concept;
  skos:definition "Kantorstab m; auch Chormeisterstab m; Vorsängerstab m; Praecentorstab m; lat. baculus cantoris; baculus praecentoris: das Insigne eines Kantors als Leiter der Kirchenmusik; ein Stab, der durch unterschiedliche Schmuckformen bekrönt tist, z. B. durch ein pflanzliches Motiv, eine Kugelform oder figürliche Darstellung. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "bâton de chantre"@fr, "cantor\\'s staff"@en, "Kantorstab"@de, "baculus cantoris"@la;
  skos:altLabel "precentor\\'s staff"@en, "Chormeisterstab"@de, "Vorsängerstab"@de,
    "Praecentorstab"@de, "baculus praecentoris"@la;
  skos:broader :c_86c8b719;
  skos:related :c_aa0d1c4c;
  dct:created "2020-08-09T19:20:27.000"^^xsd:dateTime;
  dct:modified "2021-01-23T13:38:13.000"^^xsd:dateTime .

:c_5f2735ad a skos:Concept;
  skos:definition "Graduale n, Cancionale n: Buch mit den Messgesängen (--> Antiphonar); in der fränkischen Kirche das Buch, aus dem der Kantor von den Stufen (gradus) des Epistelambo aus den Stufengesang (aus den Gradual- oder Stufenpsalmen) vortrug. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "gradual"@fr, "graduál"@cs, "Graduale"@de;
  skos:altLabel "Cancionale"@de;
  skos:broader :c_6ca61a95;
  skos:related :c_aa0d1c4c, :c_8358e420, :c_334623ef, :c_2e6c25e9, :c_d9b8da3d, :c_8bae7427;
  dct:created "2020-05-22T09:21:06.000"^^xsd:dateTime;
  dct:modified "2021-01-23T16:33:44.000"^^xsd:dateTime .

:c_efb1a544 a skos:Concept;
  skos:definition "Cantatorium n: Buch mit den Gesängen, die vom Kantor nach der Epistel auf dem Ambo vorgetragen wurden; oft mit kostbarem Einband versehen. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
