:c_b5b62918 a skos:Concept;
  skos:scopeNote "Ein Reißboden ist ein Zeichnungsträger für größere Werkzeichnungen aus der mittelalterlichen sowie frühneuzeitlichen Werkplanung. Kleinere Werkzeichnungen wurden auf einem Reißbrett ausgeführt. [BVHA]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_f10222e0;
  skos:prefLabel "Reißboden"@de;
  skos:broader :c_eb9726ec;
  dct:created "2019-11-14T11:38:56.000"^^xsd:dateTime;
  dct:modified "2021-01-24T14:23:17.000"^^xsd:dateTime .

:c_7e73a008 a skos:Concept;
  skos:scopeNote "Der Prinzipalbogen ist eine Methode zur Gewölbekonstruktion, die nachweislich in der Spätgotik zum Einsatz kam. Aus einem Bogenschlag, dem Prinzipalbogen, leiten sich alle Rippenprofile eines Gewölbes ab, d.h. alle Rippenprofile erhalten denselben Halbmesser.  [BVHA]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_f10222e0;
  skos:prefLabel "Prinzipalbogen"@de;
  skos:broader :c_a4d58de0;
  dct:created "2019-11-14T14:25:35.000"^^xsd:dateTime;
  dct:modified "2021-01-24T14:22:42.000"^^xsd:dateTime .

