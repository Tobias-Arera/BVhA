:c_efeb7f37 a skos:Concept;
  skos:definition "Eine altägyptische Prozessionstempelanlage ist eine → altägyptische Tempelanlage, deren Hauptbestandteile ein oder mehrere → Prozessionstempel (altägyptischer Tempel) bilden. Darüber hinaus wird der → Tempelbezirk der altägyptischen Prozessionstempelanlage in der Regel durch eine → Temenosmauer definiert, deren Zugänge häufig durch → Pylone markiert werden und die unter anderem einen Heiligen See, Magazine, Wohnbauten für die Priesterschaft und weitere Nebentempel umschließt. Weitere Bestandteile der altägyptischen Prozessionstempelanlage sind ferner eine oder mehrere auf die → Pylone zulaufende → Prozessionsstraßen, inklusive entsprechender → Barkenstationen und / oder → Kioske, → Obelisken, ggf. → Kultpaläste. [BVhA, Tobias Arera-Rütenik]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe;
  skos:prefLabel "altägyptische Prozessionstempelanlage"@de;
  skos:broader :c_553e77cd;
  dct:created "2025-12-10T14:47:56"^^xsd:dateTime;
  dct:modified "2025-12-15T10:06:29"^^xsd:dateTime;
  :broaderByFunction :c_553e77cd;
  :broaderByShape :c_553e77cd .

:c_7dff95f8 a skos:Concept;
  skos:definition "Eine Temenosmauer ist die den → Tempelbezirk umschließende Umfassungsmauer, die den sakralen Bereich vom \"profanen\" Umfeld abtrennt. Die Temenosmauer definiert dadurch in der Regel auch die jeweilige Tempelanlage. [BVhA, Tobias Arera-Rütenik]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe;
  skos:prefLabel "Temenosmauer"@de;
  skos:broader :c_6d43a6fd, :c_6740bff1;
  skos:narrower :c_4519957b;
  dct:created "2025-12-10T15:08:39"^^xsd:dateTime;
  dct:modified "2025-12-10T15:19:15"^^xsd:dateTime;
  :broaderByFunction :c_6740bff1 .

