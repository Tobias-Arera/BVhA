:c_nskxcexd a skos:Concept;
  skos:definition "Aus der Mauer vorspringender Tragstein (Kragstein) für Balkone, Figuren, Balken, Dienste usw., bei Holzbau (Fachwerk) auch Knagge genannt. Oft ornamental oder mit - häufig grotesken - Figuren geschmückt. [Koch 2009]"@de,
    "Ze zdi vystupující nosný článek (též krakorec) podpírající balkony, sochy, trámy, přípory aj., u dřevěných staveb (hrázděné zdivo) nazývaná také: závěrník. Knagge (= suk). Konzola je často zdobená ornamenty, nebo - obvykle groteskními - figurami. [Koch 2008] "@cs,
    "Konsole (frz.), vorspringendes Tragelement, im Steinbau ein Kragstein (Kraft-, Not- oder Balkenstein), auf dem ein Bogen, ein Gesims (K.ngesims), Skulpturen, Balken, Balkone, Erker, Dienste, Gewölbeanfänger u. dergl. ruhen. Eine nur zur Unterstützung von Diensten und Gewölbeanfängern vorkommende Sonderform sind die Hornkonsolen. [Koepf / Binding 2016]"@de,
    "Ein aus der Wand vorkragender, häufig profilierter oder mit figürlichen Skulpturen dekorierter Stein, der im Gewölbebau z. B. einen Dienst oder eine Rippe aufnehmen kann. [Glossarium Artis]"@de,
    "(frz. console aus consolateur ›Tröster, Helfer‹, auch ›Stützpfeiler‹) Vorkragender oder einem Dienst aufgelegter Tragstein. K.n können entweder Friese (Rundbogenfries, K.n-Fries) oder auch einzelne Standfiguren tragen. Im Burgenbau kommen sie besonders häufig an den steinernen Kaminen der Wohn- und Repräsentationsräume vor (Burg Neipperg BW). Als auffallendes Konstruktionsglied war die K. ähnlich wie das Kapitell Träger von baukünstlerischem Schmuck (Chambord F). B. Sch.-W. . [Wörterbuch der Burgen, Schlösser und Festungen]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_37522b74, :conceptScheme_8c0441f9, :conceptScheme_1d7ba54b;
  skos:prefLabel "console"@fr, "konzola"@cs, "mensola"@it, "console"@en, "consola"@es,
    "Konsole"@de;
  skos:altLabel "Kragstein"@de, "ménsula"@es, "modiglione"@it, "Tragstein"@de, "cartela"@es,
    "corbeau"@fr, "corbel"@en;
  skos:broader :c_6975d802;
  skos:narrower :c_689b3384, :c_4d7d769a, :c_8c4139d7, :c_964b67ec, :c_841edb00, :c_cf2c1992,
    :c_f718d208;
  skos:related :c_baad22f3, :c_a5fccf1b;
  dct:created "2019-05-21T17:34:03.000"^^xsd:dateTime;
  dct:modified "2021-01-26T15:54:21.000"^^xsd:dateTime .

:c_uyc640ov a skos:Concept;
  skos:definition "Erosion due à un frottement (attrition) ou àl’impact de particules. [ICOMOS-ISCS]"@fr,
    "Superficial loss or damage as a result of mechanical action due to friction. [EwaGlos]"@en,
    "Erosion due to wearing down or rubbing awayby means of friction, or to the impact of particles. [ICOMOS-ISCS]"@en,
    "Oberflächlicher Verlust oder Schaden als Ergebnis eines mechanisch verursachten Abriebs. [EwaGlos]"@de,
    "Eine Form der Erosion, die durch Abtragen oder Abreiben mit harten Werkzeugen oder durch den Aufprall von Partikeln (Sandstrahl) erzeugt wird. [ICOMOS-ISCS] "@de,
    "Eroze, způsobená odnosem nebo obrušováním, dřením a třením, nebo dopadem částic (např. při pískování). [ICOMOS-ISCS] "@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_315cf028,
    :conceptScheme_ef0a8695, :conceptScheme_ec8c77bf, :conceptScheme_34ca6582;
  skos:prefLabel "abrasion"@fr, "abrasion"@en, "Abrieb"@de, "odírání"@cs;
  skos:altLabel "Abrasion"@de;
  skos:broader :c_ed43f447, :c_0380427d;
  dct:created "2019-05-20T16:33:00.000"^^xsd:dateTime;
  dct:modified "2021-01-30T17:27:27.000"^^xsd:dateTime .

