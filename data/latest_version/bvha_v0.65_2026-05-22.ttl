  dct:created "2020-09-01T11:56:44.000"^^xsd:dateTime;
  dct:modified "2021-01-23T12:32:43.000"^^xsd:dateTime .

:c_e2086cea a skos:Concept;
  skos:definition "Kreuzerhöhung f; lat. exaltatio crucis: die Wiederaufrichtung des Kreuzes am 14. September 335 nach der Weihe der byzantinischen Doppelkirche und die dritte Aufrichtung durch den Kaiser Heraklios III. von Byzanz am 14. September 628. Gelegentlich auch Bezeichnung für die Kreuzauffindung. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
