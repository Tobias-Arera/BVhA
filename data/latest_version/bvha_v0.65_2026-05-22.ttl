:c_adef846e a skos:Concept;
  skos:definition "Eckz., Teilgewölbe (Trompe), das zu einer Kuppel oder zu einem Klostergewölbe überleitet. Ein Z. in Form eines sphär. Dreiecks ist der Pendentif. [Koepf/Binding 2016]"@de,
    "Trojúhelníková, většinou na špici stojící plocha mezi dvěma divergujícími obloukovými liniemi. [Koch 2008]"@cs,
    "Der Zwischenraum zwischen dem Gewölberücken und dem aufgehenden Mauerwerk über dem Widerlager. [Glossarium Artis]"@de,
    "1. die dreieckige, meist auf einer Spitze stehende Fläche zwischen zwei divergierenden Bogenlinien ( = Bogenzwickel) oder zwischen Bogen und rechtwinkliger Einfassung (= Spandrille); 2. Hängezwickel bzw. Pendentifs (Kuppel). [Koch 2009] "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_37522b74,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "écoinçon (voûte)"@fr, "cvikl (prostorově)"@cs, "spandrel (vault)"@en,
    "pennacchio"@it, "pechina"@es, "Zwickel (räumlich)"@de;
  skos:altLabel "pendentiv"@cs, "cíp"@cs, "gore"@en, "lune"@en, "clef de voûte"@fr;
  skos:broader :c_3e25acca;
  skos:narrower :c_da303341;
  dct:created "2020-02-18T14:49:32.000"^^xsd:dateTime;
  dct:modified "2020-12-01T14:46:56.000"^^xsd:dateTime .

:c_da303341 a skos:Concept;
  skos:definition "Gewölbezwickel, überleitende Elemente, die zwischen dem quadrat. Grundriss des Unterbaus und dem Fußkreis einer Kuppel, eines Domikalgewölbes oder dem Polygon eines Klostergewölbes vermitteln (Trompen, Pendentifs). [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "Gewölbezwickel"@de;
  skos:broader :c_3e25acca, :c_adef846e;
  dct:created "2020-02-18T14:50:44.000"^^xsd:dateTime;
  dct:modified "2021-01-19T13:26:30.000"^^xsd:dateTime .

:c_17c026b7 a skos:Concept;
  skos:definition "Ein am Extrados vortretender Grat, z. B. bei der Spitztonne. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "Gewölbegrat"@de;
  skos:broader :c_3e25acca, :c_a8acd6c4;
  dct:created "2020-02-18T15:16:21.000"^^xsd:dateTime;
  dct:modified "2021-01-19T11:58:50.000"^^xsd:dateTime .

:c_a8acd6c4 a skos:Concept;
  skos:definition "Grat, 1. die Schnittkante zweier Dachflächen mit ausspringendem Winkel (Dachausmittlung). 2. Kante zwischen zwei einander überschneidenden Flächen eines Gewölbes. [Koepf / Binding 2016]"@de,
    "Die von zwei sich überschneidenden Flächen gebildete scharfe Kante, bei gewölbten Flächen bogenförmig. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_1f14b4dd, :conceptScheme_19d56a39;
  skos:prefLabel "arête saillante"@fr, "groin (vaulted)"@en, "Grat"@de, "hrana"@cs;
  skos:altLabel "enfourchement"@fr, "arris (straight)"@en, "nároží"@cs, "hřeben (střechy)"@cs,
    "šev"@cs;
  skos:broader :c_1a53f70e;
  skos:narrower :c_17c026b7, :c_ca740619, :c_be646811, :c_eb3650b2;
  dct:created "2019-05-22T13:37:05.000"^^xsd:dateTime;
  dct:modified "2021-01-19T11:57:51.000"^^xsd:dateTime .

:c_5a1e3fc4 a skos:Concept;
  skos:definition "Ein winkelförmig behauener Wölbstein, der beim Gratgewölbe zwischen den zusammenstoßenden Gewölbekappen eingesetzt wird. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "groin voussoir"@en, "voussoir arêtier"@fr, "Gratstein"@de;
  skos:broader :c_3e25acca, :c_9c69c39b;
  skos:related :c_0892a7ba;
  dct:created "2020-02-18T15:55:36.000"^^xsd:dateTime;
  dct:modified "2021-01-19T13:26:54.000"^^xsd:dateTime;
  :broaderByPosition :c_9c69c39b .

:c_9c69c39b a skos:Concept;
  skos:definition "Baustein, der zum Bauen verwendete, natürl. oder künstl. Einzelstein. Natürl. oder gewachsene B.e sind die nicht zugehauenen Bruchsteine von unregelmäßiger Form und die Hau- oder Werksteine, die durch Behauen in eine regelmäßige Form gebracht sind (Quader). Der meist gebrauchte künstl. B. ist der Backstein. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_50ec0c5e;
  skos:prefLabel "Mauerstein"@de, "stavební kámen"@cs;
  skos:altLabel "Baustein"@de;
  skos:broader :c_2pqtnskw;
  skos:narrower :c_5a1e3fc4, :c_1a491350, :c_d04a5ddf, :c_98e57caf, :c_baad22f3, :c_a8e5d9bb,
    :c_6096f4c9, :c_0a02c60b, :c_b85cf2f1, :c_58453364, :c_75921782, :c_2fce538c, :c_fs33brqp;
  dct:created "2019-05-07T15:29:30.000"^^xsd:dateTime;
  dct:modified "2021-01-27T16:08:44.000"^^xsd:dateTime .

:c_0892a7ba a skos:Concept;
  skos:definition "Die Art und Weise, in der die Gratsteine zugerichtet sind. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "shape of the groin voussoirs"@en, "taille des voussoirs arêtiers"@fr,
