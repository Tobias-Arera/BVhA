:c_d1563945 a skos:Concept;
  skos:definition "Ein nach der vorgesehenen Wölblinie gezimmertes und mit Schalbrettern belegtes Gerüst, das ein Gewölbe (z.B. eine Tonne) während der Aufmauerung abstützt. Das Lehrgerüst bietet eine Vollschalung, wie sie z.B. für die Mauerung auf Kuf benötigt wird. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "cintre de voûtement"@fr, "vault centering"@en, "Lehrgerüst"@de;
  skos:altLabel "vault falsework"@en, "vault scaffolding "@en, "centre"@en, "center"@en,
    "cintre de charpente "@fr, "armement de voûte"@fr, "charpente de voûte"@fr, "Wölbgerüst "@de,
    "Schalungsgerüst "@de;
  skos:broader :c_1fd82f00;
  skos:related :c_049c4c22, :c_8e9f92af, :c_2075a77b;
  dct:created "2020-03-26T13:16:57.000"^^xsd:dateTime;
  dct:modified "2021-01-24T14:18:39.000"^^xsd:dateTime .

