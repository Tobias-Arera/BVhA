:c_bf404f51 a skos:Concept;
  skos:definition "Superfrontale η, lat.; Überhang m; auch Leiste f: einem kurzen Volant ähnelnder, in ganzer Breite von der Mensa herunterhängender Stoffstreifen, meist aus Seide und mit Gold- oder Seidenfransen besetzt. Das Superfrontale war ursprünglich ein am oberen Altartuch festgemachtes, eigenständiges Parament, wurde dann aber mit dem Antependium verbunden. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "superfrontal"@fr, "superfrontal"@en, "Superfrontale"@de;
  skos:altLabel "Leiste"@de, "Überhang"@de, "frontlet"@en;
  skos:broader :c_a2689e3f;
  skos:related :c_8fa30f59;
  dct:created "2020-06-18T16:22:55.000"^^xsd:dateTime;
  dct:modified "2021-01-27T21:04:56.000"^^xsd:dateTime .

:c_16b837ff a skos:Concept;
  skos:definition "Aurifrisium n, auch Auriphrygium n; mit Seiden- und Goldfäden durchwebter oder bestickter, häufig auch mit Perlenstickerei verzierter Besatz, der vor aller an Albe, Amikt, Dalmatik, Mitra und Antependium vorkommt. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "orfroi"@fr, "aurifrisium"@cs, "Aurifrisium "@de;
