:c_ad4ce2d6 a skos:Concept;
  skos:definition "Brüstung oder Brustwehr. [Koepf/Binding 2016]"@de, "Brüstung, Parapet (frz.), waagerechte, brusthohe Sicherung von Fenster, Terrasse, Balkon aus Stein, Holz oder Eisen, entweder aus Platten oder aus Pfosten mit eingestellten Platten, auch aus Mauerwerk, in der Gotik mit Maßwerk, im Barock als Balustrade, seit Ende des 17. und im 18. Jh. als schmiedeeiserne Konstruktion. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "parapet"@en, "parapet"@en-GB, "parapet"@cs, "Brüstung"@de, "parapet"@fr,
    "parapeto"@es, "parapetto"@it;
  skos:altLabel "poprsník"@cs;
