  dct:modified "2020-12-01T14:25:49.000"^^xsd:dateTime .

:c_98775b4d a skos:Concept;
  skos:definition "Winkelhaken, seit Rivius 1548 so genannter rechter Winkel als Werkzeug der Steinmetzen. [Koepf / Binding 2016]"@de;
