  dct:modified "2021-01-22T15:58:33.000"^^xsd:dateTime .

:c_3722325b a skos:Concept;
  skos:definition "Der obere, abschließende Teil, auch die obere Fläche einer Mauer. [Glossarium Artis, Bd. 3, Bögen und Mauerwerk]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "couronnement du mur"@fr, "koruna zdiva"@cs, "wall crown"@en, "dorso del muro"@it,
    " corona del muro"@es, "Mauerkrone"@de;
  skos:altLabel "sommet du mur"@fr, "corniche"@fr, "couronne de rempart"@fr, "couronne murale"@fr,
    "crest"@en, "Mauerabdeckung"@de;
  skos:broader :c_24f6ab7f;
  dct:created "2019-07-15T13:29:08.000"^^xsd:dateTime;
  dct:modified "2021-01-22T15:44:03.000"^^xsd:dateTime .

