:c_258980b5 a skos:Concept;
  skos:definition "Eine Mauer, die zwischen regelmäßig gemauerten Ansichtsflächen (Blendmauer) mit Bruchsteinen oder Mörtel aufgefüllt ist (Mauerwerk). [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
