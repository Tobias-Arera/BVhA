  skos:broader :c_17d46f99;
  skos:related :c_06414fbb;
  dct:created "2020-07-28T15:18:42.000"^^xsd:dateTime;
  dct:modified "2021-01-24T14:47:10.000"^^xsd:dateTime .

:c_0b319462 a skos:Concept;
  skos:definition "Sanctusleuchter m; Wandlungsleuchter m: ein Standleuchter an der Epistelseite des Altares für die Sanctuskerze. [Glossarium Artis]"@de;
