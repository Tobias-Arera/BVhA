  skos:prefLabel "Niello"@de, "niello"@cs;
  skos:broader :c_d997b1c2;
  dct:created "2020-08-04T11:20:39.000"^^xsd:dateTime;
  dct:modified "2021-01-26T21:41:58.000"^^xsd:dateTime .

