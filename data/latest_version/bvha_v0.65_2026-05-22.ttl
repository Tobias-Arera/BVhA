  dct:modified "2021-01-15T17:38:39.000"^^xsd:dateTime .

:c_df0504e3 a skos:Concept;
  skos:definition "Gedrückter, aus vier Kreissegmenten konstruierter Spitzbogen, der stumpfer ist als der gleichseitige Spitzbogen. Die zwei Hauptsegmente mit größerem Radius treffen sich in einer Spitze und werden zum Bogenanfang hin durch zwei Segmente mit kleinerem Radius verlängert. Diese Bogenform ist typisch für die englische Spätgotik (Tudorstil, 15. Jh.). [Glossarium Artis]"@de,
    "Bogen aus je zwei Segmenten zweier kleiner und großer Kreise. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "Tudor arch"@en, "tudorský oblouk"@cs, "fourcentered arch"@en-US, "Tudorbogen"@de,
    "arc Tudor"@fr, "arco Tudor"@es, "arco Tudor"@it;
  skos:altLabel "four-centred arch"@en, "arc brisé aplati"@fr, "Vierzentrenbogen"@de;
  skos:broader :c_1cf0c7ce;
  skos:related :c_66cfa33e;
  dct:created "2019-02-18T20:27:00.000"^^xsd:dateTime;
  dct:modified "2021-01-15T17:41:03.000"^^xsd:dateTime .

:c_66cfa33e a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe;
  skos:prefLabel "Tudorbogenportal"@de;
  skos:broader :c_373d5928;
