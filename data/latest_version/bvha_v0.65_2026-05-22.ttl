:c_db9a8cdc a skos:Concept;
  skos:definition "Giebelblume, Firstblume, pflanzl. Ornament, das den oberen Abschluss got. Fialen, Wimperge und Turmpyramiden bildet. [Koepf / Binding 2016]"@de,
    "KYTKA, též křížová kytka, ornamentální zakončení gotických fiál, vimperků, věží. [Koch 2008]"@cs,
    "Kreuzblume, First-, Giebelblume, in Grund- und Aufriss kreuzförmiges, stilisiertes Blattgebilde, auch zweifach übereinander, als Bekrönung von Fialen, Wimpergen, Turmpyramiden u. dergl., bes. in der Gotik. [Koepf / Binding 2016]"@de,
    "Ornamentale Bekrönung gotischer Fialen, Wimperge, Turmhelme. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "Kreuzblume"@de, "kytka"@cs;
  skos:altLabel "Firstblume"@de, "Giebelblume"@de, "křížová kytka"@cs;
  skos:broader :c_ec6223cf, :c_6c422be2;
  dct:created "2019-09-25T23:05:55.000"^^xsd:dateTime;
  dct:modified "2021-01-27T21:11:10.000"^^xsd:dateTime .

:c_7dc5f8aa a skos:Concept;
  skos:definition "Kriechblume auf den Kanten von gotischen Turmhelmen, Fialen, Wimpergen. [Koch 2009]"@de,
    "Ozdoba na hranách gotických věží, fiál, vimperků. [Koch 2008]"@cs, "Krabbe, Kantenblume, Knolle, got. Kriechblume an den Kanten von Fialen, Wimperggiebeln, Turmpyramiden u. dergl. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "Krabbe"@de, "krab"@cs;
  skos:altLabel "Kriechblume"@de, "Kantenblume"@de, "Knolle"@de, "žába"@cs;
  skos:broader :c_ec6223cf, :c_1bbaa08f;
  dct:created "2019-09-25T23:06:14.000"^^xsd:dateTime;
  dct:modified "2021-01-27T21:10:59.000"^^xsd:dateTime .

:c_6cf89213 a skos:Concept;
  skos:definition "Vorspringende Spitze der Passformen des got. Maß­werks. [Koepf/Binding 2016]"@de,
    "Výstupek zasahující do otvoru (gotické) kružby. [Koch 2008]"@cs, "Vorspringende Spitze zwischen den Passformen des gotischen Maßwerks. [Glossarium Artis]"@de,
    "Vorspringendes, meist gegengeschwungenes Element mit geradem oder auch spitzem Abschluss, das als Zierform bspw. an den Passformen eines Maßwerks, an Andreaskreuzen im Fachwerkbau oder an Deckplatten von Kapitellen auftretten kann. [BVHA]"@de,
    "In die Öffnung eines (gotischen) Maßwerks vorspringende Spitze. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_37522b74, :conceptScheme_8c0441f9, :conceptScheme_1f14b4dd;
  skos:prefLabel " nasello"@it, "redent"@fr, "kružbový nos"@cs, "cusp"@en, " gancho"@es,
    "Nase"@de;
  skos:altLabel " crochet"@fr, " knob"@en, "point"@fr, " crocket"@en, " sporto"@it,
    "tope"@es;
  skos:broader :c_2b8c8e23, :c_f651ce64;
