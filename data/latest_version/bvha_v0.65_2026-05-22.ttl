:c_1d554c24 a skos:Concept;
  skos:definition "Im Kreuzgewölbe diagonal verlaufender gratiger, gekehlter oder berippter Bogen, der sich mit einem zweiten gleichgearteten Bogen oder auch mit einem Transversalbogen kreuzt. Zu unterscheiden vom Kreuzungsbogen. [Glossarium Artis]"@de,
    "Diagonalbogen, Kreuzbogen; im Kreuzgewölbe der diagonal verlaufende; gratig gekehlte oder gerippte Bogen; er besteht aus zwei Bogenästen (Gewölbeformen). [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_84fc24e6,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "diagonal arch"@en, "arc diagonal"@fr, "Diagonalbogen"@de;
  skos:altLabel "cross springer"@en, "branche d\\'ogive"@fr, "Kreuzbogen"@de;
  skos:broader :c_2026364f;
  dct:created "2019-10-16T16:23:42.000"^^xsd:dateTime;
  dct:modified "2021-01-15T17:36:54.000"^^xsd:dateTime;
  :broaderByPosition :c_2026364f .

:c_789f7de8 a skos:Concept;
  skos:definition "Bogen, der sich mit einem anderen überschneidet, wobei jeweils eine Stütze übersprungen wird. Die Bogen kreuzen sich entweder auf gleicher Ebene oder ein Bogen tritt hinter den nächsten zurück. Kreuzungsbogen sind meist rundbogig, bei ihrer Überschneidung entstehen schmale Spitzbogenformen. Das ursprünglich islamische Motiv wurde besonders im südlichen Italien und in Spanien übernommen. Zu unterscheiden vom Kreuzbogen. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "interlacing arches"@en, "arcs entrecroisés"@fr, "Kreuzungsbogen"@de;
  skos:altLabel "Flechtbogen"@de, "intersecting arches"@en;
  skos:broader :c_0e469ac8;
  dct:created "2019-10-16T16:38:19.000"^^xsd:dateTime;
  dct:modified "2019-12-05T12:21:04.000"^^xsd:dateTime .

:c_e95833be a skos:Concept;
  skos:definition "Vorderer Bogen eines offenen Gewölbes, z. B. einer Apsis. [Koepf / Binding 2016]"@de,
    "Der vordere Bogen eines offenen Gewölbes. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "arc de face"@fr, "face arch"@en, "arco frontale"@it, "Stirnbogen"@de;
  skos:altLabel "čelní oblouk"@cs, "arc du front"@fr, "arc de départ"@fr, "premier arc"@fr,
    "frontal arch"@en, "arco frontal"@es;
  skos:broader :c_eea5235b;
  dct:created "2019-10-16T16:49:05.000"^^xsd:dateTime;
  dct:modified "2020-11-30T16:59:15.000"^^xsd:dateTime;
  :broaderByFunction :c_eea5235b .

