:c_be647c48 a skos:Concept;
  skos:definition "Dach, das nur an einer Frontseite abgewalmt ist. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
