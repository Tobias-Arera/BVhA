:c_13aa66fa a skos:Concept;
  skos:definition "Entwicklungsphase der spätgotischen Bildhauerkunst und Malerei, etwa 1380-1430. Charakteristisch sind die ergreifenden Erbärmdebilder, besonders aber die sogenannten »Schönen Madonnen« mit den weichgeschwungenen Gewandfalten und Faltenkaskaden und ihrer anmutig-lieblichen, unfeierlichen Mutter-Kind-Idyllik. Der Weiche Stil wirkt auch auf die zur gleichen Zeit aufkommenden ersten Holzschnitte ein. [Koch 2009]"@de,
    "Vývojová fáze pozdně gotického sochařství a malířství, asi v letech 1380-1430; charakteristické jsou působivé obrazy Krista jako Trpitele, zvl. však tzv. ,,krásné madony\" s oděvem s četnými záhyby a kaskádami záhybů a s jejich půvabnou neslavnostní idylikou matky s dítětem; krásný sloh ovlivnil též v té době vznikající první dřevořezby. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "Weicher Stil"@de, "krásný sloh"@cs;
  skos:broader :c_541f6da4;
  skos:related :c_depjwldn;
  dct:created "2020-08-12T10:25:41.000"^^xsd:dateTime;
  dct:modified "2020-08-24T14:07:24.000"^^xsd:dateTime .

:c_2b831ad9 a skos:Concept;
  skos:definition "Verzierung von Wänden und Decken in meist ornamentaler, aber auch figürl. Stuckatur. Einen Höhepunkt erreichte die S. in der Zeit des Barock und Rokoko, wobei verschiedene Dekorationsformen wie Bandelwerk, Blattstab, Akanthusranken und Rocaille entwickelt wurden. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Stuckdekoration"@de, "decoración en estuco"@es, "decorazione a stucco"@it,
    "décoration en stuc"@fr, "stucco decoration"@en;
  skos:broader :c_8e64a27b;
  skos:narrower :c_cb5d8135;
  dct:created "2020-08-11T14:11:37.000"^^xsd:dateTime;
  dct:modified "2021-01-25T13:42:18.000"^^xsd:dateTime .

