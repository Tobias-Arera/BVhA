:c_06dbae66 a skos:Concept;
  skos:scopeNote "Ein Pokal st ein Trinkgefäß, dessen Schale (Kuppa) vom Fuß durch einen eigenen Schaft getrennt ist. Vom Kelch und Ziborium unterscheidet er sich durch seinen profanen Gebrauch, vom Becher durch den hohen Schaft."@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8;
