  dct:created "2020-08-24T23:22:33.000"^^xsd:dateTime;
  dct:modified "2021-01-30T16:25:33.000"^^xsd:dateTime .

:c_314c85d5 a skos:Concept;
  skos:definition "Enduit de réparation fortementporeux utilisé pour absorber les sels solublesqui affectent une surface architecturale.(EwaGlos)"@fr,
    "Highly porous repair plaster used for long-term absorption of soluble salts affecting a structure.(EwaGlos)"@en,
    "Reparaturmörtel mit sehr hoher Porositat, der zur langen Aufnahme von löslichen Salzen benutzt wird. (EwaGlos)"@de;
