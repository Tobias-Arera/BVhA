:c_45f728ae a skos:Concept;
  skos:definition "Gnadenbild n: ein Gemälde oder eine Plastik, denen wundertätige Kraft zugeschrieben wird, weil - auf die Fürbitte des Dargestellten hin - viele Gebetserhörungen stattgefunden haben. Gnadenbilder sind Ziel für Wallfahrten. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "image miraculeuse"@fr, "miraculous image"@en, "Gnadenbild"@de;
  skos:broader :c_klbrisjd;
