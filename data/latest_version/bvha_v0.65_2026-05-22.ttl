:c_2e03a541 a skos:Concept;
  skos:definition "Feldkapelle, kleine Kapelle an Feldwegen, von niederem kirchl. Rang für Privatgottesdienst und zu privater Andacht, Ziel von Prozessionen, Wallfahrten von lokaler Bedeutung und Verehrung hl. Bilder. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
