:c_ef40cc12 a skos:Concept;
  skos:definition "Farb(en)kanon m, auch Farbenregel f: Vorschriften für die Verwendung der liturg. Farben: dem Farbenkanon unterliegen Antependium, Bursa, Conopeum, Dalmatik, Gremiale, Kasel, Kelchvelum, Manipel, Pluviale, Pontifikalhandschuhe, Pontifikalschuhe, Stola und Tuniceila. [Glossarium Artis]"@de,
    "Farb(en)kanon m, liturgischer; auch liturgische Farbenregel f: Anfang des 13. Jh. von der Kirche erlassene Vorschriften für den Gebrauch der liturgischen Farben. Diese Regeln beziehen sich vor allem auf die liturgische Obergewandung, also Kasel, Dalmatik, Tuniceila und Pluviale, auf die Ornatstücke Stola und Manipel, die Pontifikalhandschuhe, -Strümpfe und -schuhe, gelegentlich auf Albe und Mitra. Die Vorschriften betreffen oft, jedoch nicht immer, Altarbehänge, Kelchvelum, Bursa, Wandbehänge und Kirchenfahnen. Seit dem Trienter Konzil (1545-63) können auch nicht-liturgische Textilien in der liturgischen Tagesfarbe gehalten sein, ζ. B. das Conopeum, der Bezug des Missalkissens, der Missalumschlag oder die Pultdecken. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8;
  skos:prefLabel "canon des couleurs liturgiques"@fr, "canon of liturgical colours"@en,
    "Farbkanon"@de;
  skos:altLabel "Farbenkanon"@de, "Farbenregel"@de, "liturgische Farbenregel"@de;
  skos:broader :c_76131543;
  skos:related :c_b81f50c0, :c_213ea7b0, :c_f9d66a98, :c_c01eb518, :c_3e0c1197, :c_a40cff13,
    :c_52e9e4b7, :c_bfa98060, :c_b55a7c22, :c_bd3ee50d, :c_d1a705c6, :c_364933bc, :c_b41dc3bb,
    :c_c529c13a, :c_73a34358, :c_de98fc61, :c_2a39853a;
  dct:created "2020-03-03T16:10:12.000"^^xsd:dateTime;
  dct:modified "2021-01-22T10:20:26.000"^^xsd:dateTime .

