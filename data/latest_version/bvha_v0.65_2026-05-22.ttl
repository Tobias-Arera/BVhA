:c_912427c6 a skos:Concept;
  skos:definition "1. gewebt = rechtwinklige Kreuzung von Kett- und Schussfäden (z.B. Jacquard-Teppiche); 2. gewirkt = bunte Schussfäden werden mit Nadel oder Spule in die Kette eingeflochten, besonders für Bildteppiche (Gobelins); 3. geknüpft = die Kettfäden werden mit kurzen bunten Fäden verknüpft (Orientteppich). [Koch 2009]"@de,
    "Wandteppich, Tapisserie, ein Teppich zum Schmuck oder zur Bekleidung (Bespannung) der Wand. [Koepf / Binding 2016]"@de,
    "Wandbehang m; auch Wandteppich m: an der Wand, vorzugsweise der Chorwand, hängender Teppich, oft ein gewirkter oder gestickter Bildteppich. Vielfach werden Szenen zur Begleitung des Kirchenjahres dargestellt. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_57be8ee8, :conceptScheme_84fc24e6, :conceptScheme_50ec0c5e, :conceptScheme_8c0441f9,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "tapestry"@en, "Wandteppich"@de, "tapiz"@es, "tenture murale"@fr, "tapiserie"@cs,
    "arazzo"@it;
  skos:altLabel "gobelín"@cs, "Wandbehang"@de, "gobelino"@es, "nástěnný koberec"@cs,
    "tapisserie, gobelin"@fr, "wall hanging"@en;
  skos:broader :c_fbc27934, :c_36969a5d;
  dct:created "2019-09-24T14:40:55.000"^^xsd:dateTime;
  dct:modified "2021-01-31T00:37:48.000"^^xsd:dateTime .

:c_3e463b9f a skos:Concept;
  skos:definition "Täfelung, Wand- oder Deckenbekleidung mit Holztafeln. [Koepf / Binding 2016]"@de,
    "Dřevěné obložení stropů a stěn, zvl. v severní Evropě v 15. až 18. stol., často s bohatou řezbářskou výzdobou. [Koch 2008]"@cs,
    "Vor allem nördlich der Alpen die verbreitetste Art der Wandverkleidung aus Holz, die zugleich als WärmeIsolierung und Raumschmuck dient. Eine aus Rahmen und Füllungen bestehende Holzkonstruktion wird dabei direkt vor die Stein- oder Fachwerkwand gesetzt und oben mit einem Gesims oder Fries abgeschlossen. Im einfachsten Fall bestehen die Rahmen aus schlichten Profilen und die Füllungen sind glatt und unverziert. Die Rahmen können aber auch reich differenziert, die abschließenden Friese mit Maßwerk oder Schnitzereien verziert und die Füllungen bemalt oder mit Intarsien versehen sein. Dann sind Türen und Fensterläden in die Gestaltung einbezogen (Hohensalzburg/Salzburg A). Diese Art der Wandgestaltung wird neben Tapisserien und Stoffbespannungen bis ins 18. Jh. beibehalten, wobei sich das Dekor dem jeweiligen Zeitstil anpasst. Im 17. und 18. Jh. wird die jetzt deutlich niedrigere und flacher gearbeitete V. nach dem französischen Vorbild Boiserie genannt. B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen]."@de,
    "Auch Täfelung, Getäfel, Holzverkleidung von Decken und Wänden, bes. im Nord-Europa des 15. bis 1 8. Jhs., oft mit reichem Schnitzwerk. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9;
  skos:prefLabel "tabletterie"@fr, "deštění"@cs, "paneling"@en, "rivestimento ligneo"@it,
    "revestimiento de madera"@es, "Vertäfelung"@de;
  skos:altLabel "obložení"@cs, "Täfelung"@de, "wainscoting"@en, "Iambrissage (en bois)"@fr,
    "táflování"@cs, "boiserie"@it, "artesonado"@es, "entarimado"@es, "Täfelwerk"@de, "Getäfel"@de;
  skos:broader :c_36969a5d;
  skos:narrower :c_fd2d01c4, :c_28a4bada;
  dct:created "2020-04-28T16:49:49.000"^^xsd:dateTime;
  dct:modified "2020-11-30T18:48:42.000"^^xsd:dateTime .

:c_c2828222 a skos:Concept;
  skos:definition "Bildteppich m: mit farbigen Fäden gewirkter Wandteppich mit ornamentalen und figürlichen Darstellungen. Die von den Brüdern Gobelin erfundene Technik der Bildwirkerei f gibtden Erzeugnissen aus ihrer Manufaktur auch die Bezeichnung Gobelin m. [Glossarium Artis]"@de;
