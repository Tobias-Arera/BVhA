:c_18cbbb05 a skos:Concept;
  skos:scopeNote "Als Holme werden meist die tragenden Balken einer Treppe bezeichnet. Im Gegensatz zu den Holmen, auf denen z.B. die Keilstufen der Balkentreppe aufliegen, befinden sich die Wangen mit zumeist hochrechteckigem Querschnitt und geringerer Stärke seitlich an den Stufen."@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe;
  skos:prefLabel "Holm"@de;
  skos:broader :c_59a72838;
  dct:created "2019-04-05T07:23:12.000"^^xsd:dateTime;
  dct:modified "2021-01-22T18:01:30.000"^^xsd:dateTime .

:c_2936911c a skos:Concept;
  skos:scopeNote "Im Gegensatz zu Holmen, auf denen z.B. die Keilstufen der Balkentreppe aufliegen, befinden sich die Wangen mit zumeist hochrechteckigem Querschnitt und geringerer Stärke seitlich an den Stufen. Zwischengewendelte Holztreppen, die im 18. Jahrhundert beliebt werden setzen in der Regel die Herstellung gebogener Wangen voraus. Bei historischen Treppen mit eingeschobenen Trittstufen sind die Wangen zwischen den Tritten häufig verziert."@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "limon"@fr, "stringer"@en, "Wange (Treppe)"@de, "bočnice (schody)"@cs;
  skos:altLabel "courbe rampante"@fr;
  skos:broader :c_59a72838;
  dct:created "2019-04-05T07:32:05.000"^^xsd:dateTime;
  dct:modified "2021-01-22T18:07:18.000"^^xsd:dateTime .

:c_67caf4a2 a skos:Concept;
  skos:scopeNote "Neben dem Krümmling kann der Knotenpunkt zweier Treppenarme am Podest auch über einen halbrunden oder eckigen Pfosten ausgebildet sein. Ein eckiger Pfosten, als Verbindungsstück am Treppenabsatz kommt regelmäßig bei barocken Wangentreppen bis etwa 1750 vor. "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe;
