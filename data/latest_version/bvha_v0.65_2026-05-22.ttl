    "lavabo-bowl"@en, "Ablutionsbecken"@de, "bacinum"@la, "concha"@la;
  skos:broader :c_17d46f99;
  skos:narrower :c_77a52065;
  skos:related :c_fae87b6c, :c_096b9b72;
  dct:created "2020-07-29T16:29:20.000"^^xsd:dateTime;
  dct:modified "2021-01-24T14:51:31.000"^^xsd:dateTime .

:c_18ab94f7 a skos:Concept;
  skos:definition "Lavabokanne f; Ablutionskanne f; lat. urceus; effusorium; vas fusorium; aquafusiIis: eine meist aus Metall gefertigte Kanne oder auch ein Krug für das AbIutionswasser. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
