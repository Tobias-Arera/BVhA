:c_3a948897 a skos:Concept;
  skos:definition "Knospenkapitell, Knollenkapitell, ein Kelch- oder Kelchblockkapitell, das mit plast. volutenartigen Knospenstengel geziert ist, bes. in der Spätromanik und Frühgotik häufig (Kapitell). [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "chapiteau à crochets"@fr, "bobulová hlavice"@cs, "bud capital"@en,
    "capitello a ganci"@it, "capitel adornado con capullos"@es, "Knospenkapitell"@de;
  skos:altLabel "crocket capital"@en, "Knollenkapitell"@de, "Kelchknospenkapitell"@de;
  skos:broader :c_utiejxdh;
  dct:created "2019-05-14T13:08:49.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:44:56.000"^^xsd:dateTime .

:c_5ce6568c a skos:Concept;
  skos:definition "Blattkapitell, mit stilisierten oder naturgetreu nachgebildeten Blättern geschmücktes Kapitell. In der Antike ist das von Akanthusblättern umgebende Kapitell der Korinthischen Ordnung die reichste Form. Sie wird in der karoling.-otton. Baukunst übernommen zumeist als Kompositkapitell, in der Romanik mit verschiedenen, häufig abstrahierenden Blättern, in der Gotik als Kelchkapitell mit einer oder mehreren Reihen heim. Blattformen (Eiche, Efeu, Wein, Ahorn u.a.). Renaissance, Barock und Klassizismus verwenden wieder die klass. Form des korinth. Kapitells. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "chapiteau à feuillage"@fr, "listová hlavice"@cs, "leaf capital"@en,
    "capitello a fogliame"@it, "capitel adornado con hojas"@es, "Blattkapitell"@de;
  skos:altLabel "foliated capital"@en, "chapiteau à feuiIlages"@fr, "Blätterkapitell"@de;
  skos:broader :c_utiejxdh;
  skos:narrower :c_c0e9b4fd, :c_f8ff718a;
  skos:related :c_56e42355;
  dct:created "2019-05-14T13:09:16.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:39:56.000"^^xsd:dateTime .

