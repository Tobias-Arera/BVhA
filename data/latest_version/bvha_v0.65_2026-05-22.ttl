:c_9d83686d a skos:Concept;
  skos:definition "Schlupfloch neben dem Burgtor. [Koch 2009]"@de, "Průchozí otvor vedle hradní brány. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_37522b74,
