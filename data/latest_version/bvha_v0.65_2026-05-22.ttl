:c_b7a6172a a skos:Concept;
  skos:definition "Fassung f: das Einbetten körperlicher Reliquien in reinen thecae. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
