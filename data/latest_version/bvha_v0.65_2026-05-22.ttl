:c_a003878d a skos:Concept;
  skos:definition "Turmglocke f; lat. campana: eine große Glocke in einem Kirchturm. Sie wird, im Unterschied zur Beiglocke, auch als Hauptglocke (f) bezeichnet. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
