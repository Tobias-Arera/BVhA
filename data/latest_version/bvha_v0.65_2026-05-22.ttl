:c_e58fbb73 a skos:Concept;
  skos:definition "Zusammenfassender Begriff für Diakonikon (Ankleideraum der Priester, Sakristei) und Prothesis (Aufbewahrungsort für Geräte) am Ostende der Seitenschiffe einer frühchristl. Basilika. [Koepf/Binding 2016]"@de,
    "V raně křesťanských a byzantských kostelích místnosti ve východní části bočních lodi: prothesis(sakristie) a diakonikon (pro diakony a mešní nástroje) vytvářejí dohromady s chórem často příčnou loď s pastoforií. [2008]"@cs,
    "Im frühchristlichen und byzantinischen Kirchenbau die Räume am Ostende der Seitenschiffe: Prothesis (Sakristei) und Diakonikon (für Diakone und Geräte), ergeben zusammen mit dem Chor oft einen Zellenquerbau. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "Pastophorium"@de, "pastoforium"@cs;
  skos:altLabel "sakristie"@cs, "Pastophorion"@de;
  skos:broader :c_4880e8cc;
  skos:narrower :c_b1fae3f8, :c_922125b4;
  skos:related :c_9556c9c8;
  dct:created "2020-08-11T12:28:53.000"^^xsd:dateTime;
  dct:modified "2021-01-25T16:21:20.000"^^xsd:dateTime .

:c_add75970 a skos:Concept;
  skos:definition "Hallenchor, mehrschiffiger Chor mit gleicher oder annähernd gleicher Höhe der einzelnen Schiffe, jedoch ohne selbständige Belichtung des Mittelschiffs. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "chœur-halle"@fr, "hall choir"@en, "Hallenchor"@de, "coro con naves"@es;
  skos:broader :c_f4914836;
  skos:narrower :c_26178bf5;
  dct:created "2020-01-17T11:02:30.000"^^xsd:dateTime;
  dct:modified "2021-01-22T12:04:42.000"^^xsd:dateTime .

:c_68a5989f a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe;
  skos:prefLabel "eingezogener Chor"@de, "vtažený chór"@cs;
  skos:broader :c_f4914836;
  dct:created "2020-08-04T09:42:56.000"^^xsd:dateTime;
  dct:modified "2021-01-22T12:04:33.000"^^xsd:dateTime .

:c_dc292f9f a skos:Concept;
  skos:definition "Kirche mit drei etwa gleich großen, halbrunden oder polygonalen Konchen (Trikonchos, Trichorum, Cella trichora), die im Gegensatz zum Dreiapsidenchor (Chor) nach drei Richtungen weisen, so dass sich ein zentralisierender Abschluss in der Form eines regelmäßigen Kleeblattes ergibt, meist als Chor an Basiliken, aber auch als Kapelle mit wesentl. kleinerem Rechtecksaal. D. kommen vereinzelt auch mit einem um alle Konchen herumgeführten Umgang vor. [Koepf / Binding 2016]"@de,
    "Trikonchos, řecky: kostel s trojlistovou dispozicí. [Koch 2008]"@cs, "Trichorum, Anlage mit drei kleeblattförmig angeordneten Konchen. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_37522b74;
  skos:prefLabel "Dreikonchenchor"@de, "trojlistový chór"@cs;
  skos:altLabel "Dreikonchenanlage"@de, "Trikonchos"@de, "Trichorum"@de, "trikonchos"@cs,
    "tříkonchová dispozice"@cs, "trojlistová dispozice"@cs, "trojlist "@cs, "třílistová dispozice"@cs,
    "třílistové založení"@cs, "tříkonchové založení"@cs;
  skos:broader :c_f4914836;
  dct:created "2020-08-04T09:43:40.000"^^xsd:dateTime;
  dct:modified "2021-01-21T18:19:37.000"^^xsd:dateTime .

:c_504c6bc3 a skos:Concept;
  skos:definition "Am östl. Ende des Kirchenschiffs, westl. vom Hohen Chor, tiefer als dieser gelegen, von Schranken umgrenzter Raum für Sänger und niedere Kleriker oder in Klosterkirchen für kranke Mönche. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "chrœur inférieur"@fr, "nezvýšená část chóru určená zpěvákům a nižším klerikům"@cs,
    "antechoir"@en, "coro inferiore"@it, "coro inferior"@es, "Unterchor"@de;
  skos:altLabel "chrœur bas"@fr;
  skos:broader :c_f4914836;
  dct:created "2020-08-05T14:20:36.000"^^xsd:dateTime;
  dct:modified "2021-01-22T12:10:36.000"^^xsd:dateTime .

:c_de0d4536 a skos:Concept;
  skos:definition "Ein quadrat. oder rechteckiger Raum, der gegenüber dem Kirchensaal zumeist um Mauerdicke oder mehr eingezogen und entweder voll geöffnet oder mittels Mauerzungen abgeschnürt ist. Hinsichtl. seiner Funktion ist er ident. mit der Apsis. Er findet ihn vornehml. bei einfachen Saalkirchen, seltener bei großen Kirchen; später wählen häufig die Reformorden den R„  der auch von rechteckigen Nebenchören begleitet sein kann wie bei Zisterzienserkirchen. [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_8c0441f9;
  skos:prefLabel "Rechteckchor"@de, "coro rectangular"@es, " coro rettangolare"@it,
    " chœur rectangulaire"@fr, " rectangular choir"@en;
  skos:broader :c_f4914836;
  dct:created "2020-08-21T14:10:56.000"^^xsd:dateTime;
  dct:modified "2021-01-22T12:05:26.000"^^xsd:dateTime .

:c_0f45f85d a skos:Concept;
  skos:definition "Besteht aus mehreren Seiten eines beliebigen Vielecks und wird bestimmt durch das Verhältnis der Seitenzahl zum jeweiligen zu ergänzenden Polygon: z.B. 5/10-Schluss; häufig schließt der P. an einen mehrjochigen Vorchor an. Der P. kann auch zentralisierenden Charakter erhalten,  recht zahlr. an got. Kirchen, bes. in Spanien im späten 15. und 16. Jh., im süd-dt. und frz. Barock und schließl. vereinzelt im 19. Jh. [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "Polygonchor"@de, "coro poligonal"@es, " coro poligonale"@it, "chœur polygonal"@fr,
    " polygonal choir"@en;
  skos:broader :c_f4914836;
  dct:created "2020-08-25T09:50:54.000"^^xsd:dateTime;
  dct:modified "2021-01-22T12:05:14.000"^^xsd:dateTime .

:c_253c881f a skos:Concept;
  skos:definition "Chorus major (lat.), in Hirsauer- oder Cluniazenserkirchen der \"größere Chor\", der östl. an den Chorus minor anschließt und den Mönchen vorbehalten war. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "Chorus major"@de;
  skos:broader :c_b4ffaac7;
  dct:created "2020-08-28T15:58:05.000"^^xsd:dateTime;
  dct:modified "2021-01-21T18:19:16.000"^^xsd:dateTime .

:c_a6dba749 a skos:Concept;
  skos:definition "Chorus minor (lat.), in Kirchen der Hirsauer oder der Cluniazenser der >kleinere Chor<, der sich anschließend an den Chorus major bis zum ersten Stützenpaar des Langhauses erstreckt. Zur Markierung der Grenze gegen den Gemeinderaum besteht dieses Stützenpaar bei Säulenbasiliken aus Pfeilern, auch ist über ihm manchmal ein Querbogen angeordnet. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "Chorus minor"@de;
  skos:broader :c_b4ffaac7;
  dct:created "2020-08-28T15:58:20.000"^^xsd:dateTime;
  dct:modified "2021-01-21T18:19:27.000"^^xsd:dateTime .

:c_7ac00a92 a skos:Concept;
  skos:definition "An die Saalkirche oder das Vorchorjoch der dreischiffigen Basilika werden rechteckige Räume (Pastophorien, Secretarium) seitl. angefügt; der nördl. Raum (Prothesis) dient zur Vorbereitung des Messopfers, der südl. Raum (Diakonikon) zur Aufbewahrung der liturg. Gewänder und Geräte; auch dienen sie zur Aufbewahrung von Reliquien, als Grablege oder als Privatkapellen. Nachdem sich in karoling. Zeit die einfachere röm. Liturgie durchsetzt, die die Vormesse und den Introitus der gallikan. Liturgie aufgibt, verlieren sich die Pastophorien und werden durch die einseitig an den Chor angefügte Sakristei (Almaria, Almer, Treskammer) ersetzt. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "Dreizellenchor"@de;
  skos:broader :c_f4914836;
  dct:created "2020-09-01T12:45:34.000"^^xsd:dateTime;
