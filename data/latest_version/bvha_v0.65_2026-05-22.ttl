  skos:altLabel "substratoire"@fr;
  skos:broader :c_a2689e3f;
  skos:related :c_30831661, :c_e5eb81f8;
  dct:created "2020-04-06T22:31:44.000"^^xsd:dateTime;
  dct:modified "2021-01-27T21:04:39.000"^^xsd:dateTime .

:c_52e9e4b7 a skos:Concept;
  skos:definition "Bursa f, auch Messbursa f: 1. Korporalientasche f, auch Corporaltasche f, pera: taschen- oder mappenartiger Behälter zur Aufbewahrung für das zusammengefaltete Korporale; die Oberseite besteht oft aus dem gleichen Material wie die Kasel; die Bursa unterliegt dem Farbenkanon. 2. Korporalienschrein m, Korporalienkästchen n, domus corporalis, capsa corporalis: mit Seide bezogenes und ausgekleidetes Kästchen als Behälter für das Korporale; im Mittelalter die häufigere Form der Bursa. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "bourse"@fr, "burse"@en, "Bursa"@de, "burza"@cs;
  skos:altLabel "corporalier"@fr, "purse"@en, "Messbursa"@de, "Korporalientasche"@de,
