  dct:modified "2021-01-15T16:59:02.000"^^xsd:dateTime .

:c_d23211dd a skos:Concept;
  skos:definition "Heiltumsbesitz m; Reliquienschatz m; Heiligtümer n pl: der Bestand an Reliquien und Reliquiaren einer Kirche, der meist in einem Schatzverzeichnis aufgelistet ist. So besitzt z. B. der Dom in Aachen neben vielen kleineren Reliquien vier große Heiltümer: das Marienkleid, das Lendentuch Jesu, das Enthauptungstuch Johannes des Täufers und die Windeln Jesu. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "trésor des reliques"@fr, "treasury of relics"@en, "Heiltumsbesitz"@de;
  skos:altLabel "Reliquienschatz"@de, "Heiligtümer"@de;
  skos:broader :c_ef163f2f;
  skos:related :c_45fded98, :c_b9eb688f, :c_d59d3175, :c_d81474cc;
  dct:created "2020-09-27T15:17:18.000"^^xsd:dateTime;
  dct:modified "2021-01-24T15:29:05.000"^^xsd:dateTime .

:c_1c04073c a skos:Concept;
  skos:definition "Authentifizierung f: die Bestimmung der Echtheit und der Bedeutung einer Reliquie. Hierbei sind Etikettierung, Konsekrationsurkunden, Protokolle über Rekognitionen und Visitationen, Schatzverzeichnisse, Translationsberichte, Besiegelungen, Ablassbriefe etc. zu prüfen. Besonders wichtig ist der Nachweis eines mit der Reliquie zusammenhängenden Wunders. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "authentification"@fr, "authentification"@en, "Authentifizierung "@de;
  skos:broader :c_0v3vvfra;
  skos:related :c_45fded98, :c_6d3826a1;
  dct:created "2020-09-27T14:32:32.000"^^xsd:dateTime;
  dct:modified "2021-01-15T16:43:40.000"^^xsd:dateTime .

:c_a9bd647a a skos:Concept;
  skos:definition "Authentik f; auch Approbation f; lat. authenticum: ein Dokument über die Echtheit einer Reliquie, das von höheren Prälaten bei der Kirchenbehörde ausgestellt und der Reliquie beigefügt wird; in der Regel auf Pergament geschrieben. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "certificat d\\'authenticité"@fr, "certificate of authenticity"@en,
    "Authentik"@de, "authenticum"@la;
  skos:altLabel "Approbation"@de;
  skos:broader :c_ef163f2f;
  skos:related :c_45fded98, :c_6d3826a1, :c_9ae4139b;
  dct:created "2020-09-27T14:40:04.000"^^xsd:dateTime;
  dct:modified "2021-01-24T15:28:16.000"^^xsd:dateTime .

