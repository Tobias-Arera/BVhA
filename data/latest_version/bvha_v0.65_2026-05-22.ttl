:c_8073bca1 a skos:Concept;
  skos:definition "Pontonbrücke, eine Brücke, die statt auf Pfeilern auf Schwimmkörpern oder Booten (Pontons) aufruht. Die S. wird hauptsächl. bei militär. Unternehmungen verwendet,  da sie bes. rasch montiert bzw. demontiert werden kann. Die erste große S. wurde von Harpalos im Auftrag des Perserkönigs Xerxes über den Hellespont gelegt. [Koepf /Binding 2016]"@de,
    "Schiffsbrücke, Brücke auf verankerten Schiffen oder Schwimmkörpern (Pontons). [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_c8a571d9, :conceptScheme_176fcff1;
  skos:prefLabel "pontoon bridge"@en, "pontonový most"@cs, "ponte su chiatte"@it, "puente de pontones"@es,
    "Schiffbrücke"@de, "pont de bateaux"@fr;
  skos:altLabel "Pontonbrücke"@de, "ponte su barche"@it, "plovoucí most"@cs, "ponton bridge"@en,
    "pont de pontons"@fr, "ponte di barconi"@it;
  skos:broader :c_32b3164e;
