  dct:modified "2021-01-22T15:39:13.000"^^xsd:dateTime .

:c_d94a0e37 a skos:Concept;
  skos:definition "Mauer zwischen benachbarten Grundstücken. (Glossarium Artis, Bd. 3, Bögen und Mauerwerk)"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe;
