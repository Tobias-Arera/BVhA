  dct:created "2019-05-27T17:48:17.000"^^xsd:dateTime;
  dct:modified "2019-05-27T17:53:44.000"^^xsd:dateTime .

:c_c8edf5da a skos:Concept;
  skos:definition "Gratschiftersparren/Gratschifterrofen: Sparren/ Rofen innerhalb eines Walms, der mit Gratsparren/ Gratrofen verbunden ist.  (Eißing et al. 2012) "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_19d56a39;
  skos:prefLabel "Gratschifterrofen"@de;
