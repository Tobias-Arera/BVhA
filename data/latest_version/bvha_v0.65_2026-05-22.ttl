:c_b55a7c22 a skos:Concept;
  skos:definition "Albe (alba, camisia, tunica), Bestandteil der liturgischen Kleidung, ein aus Leinen gemachter (tunica linea, linea), engärmeliger, bis zu den Füßen reichender (tunica talaris, poderes), mittels eines Zingulums aufgeschürzter Rock. [RDK Labor]"@de,
    "Albe f, Alba f, auch Sackalbe f, camisa, tunica alba, tunica talaris, tunica poderis: aus der römischen Tunika entstandenes, hemdartiges, knöchellanges weißes Leinengewand mit langen, engen Ärmeln; an Saum und Ärmeln befindet sich häufig eine Parura; als liturgisches Untergewand wird die Albe von allen Klerikern getragen. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd,
    :conceptScheme_cf792a3c;
  skos:prefLabel "alb"@en, "Albe"@de, "camice"@it, "alba"@cs, "camisa"@la, "alba"@es,
    "albe"@nl, "aube"@fr;
  skos:altLabel "tunica talaris"@la, "tunica alba"@la, "tunica poderis "@la, "Alba"@de,
    "Sackalbe"@de;
  skos:broader :c_cb3125a1, :c_aa790c5e, :c_b2ce93f9, :c_5f0a70dc, :c_581497e3;
  skos:narrower :c_551decb8, :c_056082e4, :c_6a18e18e;
  skos:related :c_16b837ff, :c_ef40cc12, :c_aa7a9a9b, :c_f94e92f0, :c_106b1464;
  dct:created "2020-03-02T14:53:04.000"^^xsd:dateTime;
  dct:modified "2021-01-24T17:48:15.000"^^xsd:dateTime .

