:c_90f43317 a skos:Concept;
  skos:definition "Blattwerk, Laubwerk, Sammelbezeichnung für die aus stilisierten oder naturgetreu nachgebildeten Blättern bestehende Verzierung bes. an Friesen (Blattfries), Gesimsen, Konsolen und Kapitellen (Blattkapitell) der Gotik, in der Spätgotik von wuchernder Fülle und reicher Bewegung, zumeist der heim. Pflanzenwelt entnommen, oft in Form des sog. Wasserblatts. Eine engl. Sonderform ist das Tudorblatt. Die Antike kennt v. a. Akanthusblätter, Wasserlaub (lesb. Kyma) und Palmette. In der Renaissance und im Barock wieder aufgenommen (Arabeske, Maureske). [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "feuillage"@fr, "listoví"@cs, "foliage"@en, "fogliame"@it, "foliaje"@es,
    "Blattwerk"@de;
  skos:altLabel " rinceau"@fr, " ornamento a fogliame"@it, "Laubwerk"@de, " ornamento de follaje"@es;
  skos:broader :c_d1a8ce66;
  skos:related :c_ed7910da;
  dct:created "2020-06-30T15:15:55.000"^^xsd:dateTime;
  dct:modified "2021-01-26T11:01:21.000"^^xsd:dateTime .

