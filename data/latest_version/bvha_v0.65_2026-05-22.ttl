:c_54030093 a skos:Concept;
  skos:definition "Das Angerdorf, in dessen Mitte sich die durchlaufende Straße zu einem breiten, längl. Anger erweitert, an dem die Häuser liegen. Eine Vorform des Angerdorfs ist das sich um einen Platz gruppierende Platzdorf. [Koepf / Binding 2016]"@de,
    "Angerdorf, Dorf, dessen durchlaufende Hauptstraße sich zu einem längl. grünen, baumbestandenen Platz, Anger, erweitert. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_176fcff1;
  skos:prefLabel "Angerdorf"@de;
  skos:broader :c_995cdcc0;
  dct:created "2020-08-24T14:57:11.000"^^xsd:dateTime;
  dct:modified "2021-01-25T15:28:29.000"^^xsd:dateTime .

:c_5abc7848 a skos:Concept;
  skos:definition "Das Haufendorf, wenn um einen Hauptplatz gruppiert auch Platzdorf genannt, ist die lockerste der D. Die Gehöfte stehen ohne bestimmten Grundplan und ohne regelmäßige Frontstellung beieinander. Eine Abart oder auch Vorform ist der aus nur wenigen Gehöften bestehende Weiler. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_176fcff1;
  skos:prefLabel "Haufendorf"@de;
  skos:broader :c_995cdcc0;
  dct:created "2020-09-01T11:30:45.000"^^xsd:dateTime;
  dct:modified "2021-01-25T15:28:40.000"^^xsd:dateTime .

:c_6e7089f1 a skos:Concept;
  skos:definition "Urspr. von einer Hecke umgebenes Dorf, dessen Häuser mit der Giebelseite um einen runden, nur von einer Seite zugängl. Platz stehen. [Koepf / Binding 2016]"@de,
    "Die geschlossenste der D. ist der aus dem Wehr- und Schutzbedürfnis der Siedler entstandene Rundling (Runddorf), urspr. von einer Hecke umgeben, bei dem die Häuser mit der Giebelseite um einen runden, nur an einer Seite zugängl. Platz stehen. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_176fcff1;
  skos:prefLabel "Rundling"@de;
  skos:altLabel "Runddorf"@de;
  skos:broader :c_995cdcc0;
  dct:created "2020-09-01T11:32:15.000"^^xsd:dateTime;
  dct:modified "2021-01-25T15:29:39.000"^^xsd:dateTime .

:c_af320429 a skos:Concept;
  skos:definition "Reihendörfer (Kettendörfer) sind: a) in Marschgebieten das Marschhufendorf, dessen Häuser an der Innenseite eines Deiches aufgereiht sind, während die zu den einzelnen Höfen gehörigen Hufen sich senkrecht zum Deich hinter den Häusern erstrecken, b) das Waldhufendorf, meist in Gebirgsgegenden oder -tälern, bei dem die Gehöfte längs eines Bachs oder einer Talstraße liegen, die Hufen in langen, parallelen Streifen bis in den Gebirgswald hinaufreichen. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_176fcff1;
  skos:prefLabel "Reihendorf"@de;
  skos:broader :c_995cdcc0;
  dct:created "2020-09-01T11:33:55.000"^^xsd:dateTime;
  dct:modified "2021-01-25T15:29:24.000"^^xsd:dateTime .

:c_286d51af a skos:Concept;
  skos:definition "Dorf mit beidseitiger Bebauung entlang einer Straße. [Koepf / Binding 2016]"@de,
    "Das Straßendorf mit einem verhältnismäßig kurzen Straßenzug, zu dessen beiden Seiten die Gehöfte liegen. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "Straßendorf"@de;
  skos:broader :c_995cdcc0;
  dct:created "2020-09-01T11:35:29.000"^^xsd:dateTime;
  dct:modified "2021-01-25T15:29:50.000"^^xsd:dateTime .

:c_d3e3169b a skos:Concept;
  skos:definition "Dorf, das sich um einen Platz gruppiert. Sonderfälle sind der Rundling und das Angerdorf. [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_176fcff1;
  skos:prefLabel "Platzdorf"@de;
  skos:broader :c_995cdcc0;
  dct:created "2020-10-14T14:35:50.000"^^xsd:dateTime;
  dct:modified "2021-01-25T15:29:09.000"^^xsd:dateTime .

:c_d87f08d1 a skos:Concept;
  skos:definition "Satellitenstadt, eine baul. in sich abgeschlossene und wirtschaftl. selbständige Nebenstadt einer Großstadt. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
