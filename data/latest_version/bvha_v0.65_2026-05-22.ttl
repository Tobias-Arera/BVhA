:c_ed7905d0 a skos:Concept;
  skos:definition "Genius (lat., Mz. Genien), persönlicher Schutzgeist eines Mannes oder eines Ortes (Genius loci) im antiken Rom. Er ist eine Allegorie der Zeugung und wird als Schlange, Jüngling oder nacktes geflügeltes Kind in der Art von Eroten (Bauplastik) dargestellt. Die Schutzgöttin einer Frau heißt Juno. [Koch 2009]"@de,
    "Strážný duch člověka nebo určitého místa (genius loci) v antickém Římě představoval alegorii zplození a býval znázorňován v podobě hada, jinocha, nebo nahého okřídleného dítěte ve stylu erotů, strážná bohyně žen se jmenovala Juno. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9;
  skos:prefLabel "Genius"@de, "génius"@cs;
  skos:broader :c_f2c2df1e;
  dct:created "2020-08-05T11:25:32.000"^^xsd:dateTime;
  dct:modified "2021-01-23T13:31:57.000"^^xsd:dateTime .

:c_8acb4a79 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8;
  skos:prefLabel "Genius loci"@de, "genius loci"@cs;
  skos:broader :c_f2c2df1e;
  dct:created "2020-08-05T11:25:43.000"^^xsd:dateTime;
  dct:modified "2021-01-23T13:32:09.000"^^xsd:dateTime .

:c_94a8a468 a skos:Concept;
  skos:definition "Stilphase der englischen Architektur zwischen dem Georgian und Victorian style von 1790-1830, im zeitlichen Umkreis der Regentschaft des Prince of Wales (später George IV.) von 1811-20. [Koch 2009]"@de,
    "Slohová fáze anglické architektury mezi georgiánským a viktoriánským slohem v letech 1790-1830, v časovém období kolem „regentství\" prince z Walesu (pozdějšího krále Jiřího IV.) v letech 1811-20. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9;
  skos:prefLabel "Regency"@de, "regency style"@cs;
  skos:broader :c_c11523f4;
  dct:created "2020-08-05T11:27:16.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:23:58.000"^^xsd:dateTime .

:c_856694c6 a skos:Concept;
  skos:definition "An Steinblöcken, z.B. Säulenschäften, stehen gelassener Vorsprung, der ein Abrutschen der Hebetaue beim Versetzen verhindert, zumeist paarweise angeordnet und anschließend abgearbeitet. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Versatzbossen"@de;
  skos:broader :c_a7e5edc4;
  dct:created "2020-08-05T11:43:13.000"^^xsd:dateTime;
  dct:modified "2020-08-27T15:23:03.000"^^xsd:dateTime .

