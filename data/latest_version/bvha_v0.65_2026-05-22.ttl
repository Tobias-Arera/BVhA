  dct:created "2020-08-21T13:20:03.000"^^xsd:dateTime;
  dct:modified "2021-01-22T19:24:48.000"^^xsd:dateTime .

:c_55d8b86d a skos:Concept;
  skos:definition "Regelmäßige Wiederkehr derselben Form eines Musters, z.B. bei Friesen, Tapeten oder Geweben. [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_84fc24e6;
