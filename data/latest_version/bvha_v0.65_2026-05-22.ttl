:c_60fcc7d2 a skos:Concept;
  skos:definition "Oberste Stufe des antiken Tempelunterbaus (Stereobat), auf dem die Säulen aufruhen. Dorische Ordnung. [Koepf / Binding 2016]"@de,
    "Nejvyšší stupeň stereobatu (spodní část stavby antického chrámu), na něm stojí sloupy. [Koch 2008]"@cs,
    "Stylobat, -es, oberste Stufe des Stereobats (Unterbau des antiken Tempels). Auf ihm stehen die Säulen. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "Stylobat"@de, "stylobat"@cs;
  skos:altLabel "Säulenstuhl"@de, "postament sloupu"@cs, "podlaží sloupu"@cs;
  skos:broader :c_790de72b, :c_079720f3;
