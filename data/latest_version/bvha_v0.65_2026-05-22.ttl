:c_dee2aeac a skos:Concept;
  skos:definition "Romanisches Ornament. [Koch 2009]"@de, "Fries aus kleinen, aneinandergereihten Rundbogen, die auch von Konsolen getragen werden können. R.e kommen v. a. an Gesimsen roman. Bauten vor, als Rahmung von Wandflächen zwischen Lisenen, auch als steigender R. unter Giebelschrägen. [Koepf / Binding 2016]"@de,
    "Reihe von kurzen Rundbögen, die vor die Wand gesetzt sind. Die Bögen können schlicht gereiht auftreten oder auf kleine Konsolen gesetzt sein. Während im Sakralbau der R. auf das 12. und frühe 13. Jh. beschränkt blieb und nur höchst selten konstruktiv verwendet wurde, sind an Burgen auch noch im späten 13. und 14. Jh. R.e zu finden. Sie werden zudem zur Abstützung von Wehrgängen oder Holz- oder Fachwerkaufbauten auch konstruktiv, d. h. tragend eingesetzt (Burg Eltz RP), Fries; Bogenfries. B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_8c0441f9, :conceptScheme_1f14b4dd;
  skos:prefLabel "Rundbogenfries"@de, " friso arqueado"@es, " fregio ad archetti"@it,
    " blind arcade"@en, "frise d\\'arceaux en plein cintre"@fr;
  skos:altLabel "frieze of round arches"@en, "round arch frieze"@en, "frise en arceaux"@fr,
    "frise en arquée"@fr;
  skos:broader :c_bb055578;
  skos:narrower :c_3617bdab;
  dct:created "2019-05-16T16:10:35.000"^^xsd:dateTime;
  dct:modified "2021-01-25T12:01:23.000"^^xsd:dateTime .

:c_3617bdab a skos:Concept;
  skos:definition "Rundbogenfries zwischen hohen Lisenen zur Wandgliederung. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "Lombard bands"@en, "bandes lombardes"@fr, "Lombardische Bänder"@de;
  skos:altLabel "arcature lombarde"@fr;
  skos:broader :c_dee2aeac;
  skos:related :c_9740fe3a;
  dct:created "2019-10-21T15:18:13.000"^^xsd:dateTime;
  dct:modified "2021-01-25T12:01:40.000"^^xsd:dateTime .

:c_9740fe3a a skos:Concept;
  skos:definition "Auch Lesene, senkrechter, pilasterähnlicher Mauerstreifen, aber ohne Basis und Kapitell, häufig durch Rundbogenfriese mit den benachbarten Lisenen verbunden (Romanik). Gliedernde und stützende Funktionen. [Koch 2009]"@de,
    "Svislý pruh zdiva podobný pilastru, avšak bez patky a hlavice, se sousedními lizénami často propojena obloučkovými vlysy (románský sloh), členící a podpůrná funkce. [Koch 2008]"@cs,
    "Lisene (frz. lisière: Rand), schwach vortretende, senkrechte, im Mauerverband gemauerte Mauervorlage, selten mit Basis und kleinem Kämpfer (im Unterschied zum Pilaster ohne Kapitell), häufig durch Blendbogen oder Bogenfries verbunden. In der Romanik bevorzugtes Mittel zur Wandgliederung. [Koepf / Binding 2016]"@de,
    "Eine schwach vortretende, vertikale Mauerverstärkung ohne Basis und Kapitell, die der Gliederung von Mauerverbänden dient, besonders am romanischen Außenbau. Dem antiken Pilaster nachempfunden, entsteht sie zuerst in Ravenna und Essen. [Glossarium Artis]"@de,
    "Element der Wand- und Fassadengliederung. Als L. bezeichnet man einen nur wenig hervortretenden Wandstreifen, der aber im Gegensatz zum Pilaster keine Basis und kein Kapitell hat. Damit steht die L. in der Rangordnung der Säulen (Säulenordnun-gen) unter allen Ordnungen. L.n kommen häufig an romanischer Architektur vor, wo sie Felder begrenzen, die oben durch Bogenfriese abgeschlossen werden (Wartburg, Landgrafenhaus TH). Im Schlossbau kommt die L. aufgrund ihrer niederen Stellung vor allem bei unbedeutenderen Bauten zur Anwendung wie etwa Jagd- oder Lustschlös-sern bzw. an nachgeordneten Bauteilen wie dem Marstall. Auch beim Festungsbau werden L.n verwendet. B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9, :conceptScheme_1f14b4dd;
  skos:prefLabel "lisière"@fr, "lizéna"@cs, "lesene"@en, "lesena"@it, "refuerzo de pilar"@es,
    "Lisene"@de;
  skos:broader :c_5ea9467f;
  skos:narrower :c_5ab0714b;
  skos:related :c_3617bdab;
  dct:created "2019-05-21T17:30:56.000"^^xsd:dateTime;
  dct:modified "2021-01-22T19:35:46.000"^^xsd:dateTime .

