:c_0515f73a a skos:Concept;
  skos:definition "Bereits von Serlio entwickelte und von Palladio (Basilika in Vicenza) weiterentwickelte Komposition in der Spätrenaissance: Verbindung eines mittleren, breiteren Bogens mit zwei schmaleren Seitenöffnungen, die von einem Gebälk in Höhe des Bogenkämpfers abgeschlossen sind. [Koepf/Binding 2016] "@de,
    "PALLADIOVSKÝ MOTIV, též benátské okno, v Anglii - jelikož vycházel ze Serliova díla \"Architettura\" - též nazývaný serliovský motiv nebo \"serliana\"; obloukový otvor ve stěně spočívající na sloupech nebo pilířích, který má po stranách 2 úzké obdélníkové otvory, jejichž kladí probíhá ve výši patky oblouku. Tento motiv často používal Palladio a jeho následovníci. [Koch 2008]"@cs,
    "Von Sebastiano Serlio (1475-1554) entwickelte und von Andrea Palladio (1505-1580) weiter ausgestaltete Form der Wand- oder Fenstergliederung, bei der ein mittlerer, breiterer Bogen von zwei schmaleren Öffnungen flankiert wird, die von einem Gebälk (Architrav) in Höhe des Kämpfers überdeckt sind. [Glossarium Artis]"@de,
    "Auch Venezianisches Fenster, in England - weil auf Serlios »Architettura« zurückgehend - Serliomotiv oder Serliana genannte Wandöffnung, bei der eine auf Säulen oder Pfeilern stehende Bogenöffnung von 2 schmalrechteckigen Öffnungen flankiert wird, deren Gebälk in Höhe des Bogenkämpfers verläuft. Von Palladio und seinen Nachfolgern oft verwendet. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9, :conceptScheme_1f14b4dd;
  skos:prefLabel "baie palladienne"@fr, "palladiovský motiv"@cs, "Palladian motif"@en,
    "serliana"@it, "Palladio-Motiv"@de, "composición desarrollada por Serlio y Palladio"@es;
  skos:altLabel "baie à la Serlio"@fr, "baie à rythme ternaire"@fr, "Venetian motif"@en,
    "Serliana"@en, "Serlian motif"@en, "Serliana"@de, "benátské okno"@cs, "serliana"@cs;
  skos:broader :c_0e469ac8;
  dct:created "2019-10-22T10:31:03.000"^^xsd:dateTime;
  dct:modified "2020-11-21T16:13:18.000"^^xsd:dateTime .

