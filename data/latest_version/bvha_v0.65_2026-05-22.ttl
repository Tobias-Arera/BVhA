  dct:modified "2021-01-22T14:50:24.000"^^xsd:dateTime .

:c_bdd4abf3 a skos:Concept;
  skos:definition "Pfosten im Fenster mit zwei Querhölzern, der mit Höhenhölzern zwischen den durchlaufenden Querhölzern gebildet wird. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Geteilter Pfosten"@de;
  skos:broader :c_be2985ad;
  dct:created "2019-06-12T15:18:37.000"^^xsd:dateTime;
  dct:modified "2019-06-12T17:24:15.000"^^xsd:dateTime .

:c_300bcb11 a skos:Concept;
  skos:definition "In Höhe der Reiber an den inneren Höhenschenkeln der Fensterflügel eingesteckter Draht, auf dem der Reiber entlangstreift und das Holz vor Abnutzung schützt, zugleich aber auch für einen dichteren Verschluss sorgt. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0,
    :conceptScheme_b41bd73a;
  skos:prefLabel "Streifdraht"@de;
  skos:altLabel "Auflaufdraht"@de, "Streichdraht"@de;
  skos:broader :c_d936f79a;
  dct:created "2019-06-12T15:25:11.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:43:15.000"^^xsd:dateTime .

:c_7738eee1 a skos:Concept;
  skos:definition "Waagrechte Bleisprosse. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Bleiquersprosse"@de;
  skos:broader :c_be713e0d;
