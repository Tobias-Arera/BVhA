    :conceptScheme_8c0441f9;
  skos:prefLabel "Naos"@de, "naos"@cs;
  skos:editorialNote "Hier bitte im Sinne einer phänomenorientierten Onthologie die Konzepte Naos (Tempel) und Naos (Cella) trennen, entprechend mit broadern verweisen und mit related in Beziehung setzen (TAR)."@de;
