  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_50ec0c5e;
  skos:prefLabel "Wurferker"@de;
  skos:broader :c_5d9b780a;
  dct:created "2020-04-28T15:04:43.000"^^xsd:dateTime;
  dct:modified "2021-01-27T14:33:10.000"^^xsd:dateTime .

:c_b9e0a442 a skos:Concept;
  skos:definition "Kleiner, erkerartiger Vorbau mit Bodenöffnung an den Außenseiten von Burg- oder Stadtmauern, an Torbauten, selten an Wohnbauten und an Bergfrieden, wie bei Gusslöchern (Wurfscharten) zum Ausgießen von heißen Flüssigkeiten (Wasser, Öl, Pech, Teer) gegen angreifende Feinde. Häufig werden Abtritte mit P.n verwechselt,  deren Einbauten und Bodenöffnung aber ihre Nutzung erkennen lassen. Die P. ist wahrscheinl. vom Orient über Südfrankreich im 13. Jh. allg. in Europa verbreitet worden. Die frz. Wehrbauten bevorzugten eme fortlaufende und zusammenhängende Anordnung als vorspringende Galerie auf Konsolen (Maschikuli). [Koepf/Binding 2016]"@de,
    "Licí arkýř ve středověkém hradu. [Koch 2008]"@cs, "Nach unten offener Erker an der Außenseite einer Wehrmauer zum Hinabgießen von heißem Öl, Pech o. ä. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_50ec0c5e,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "machicolation"@en, "Pechnase"@de, "podsebití"@cs, " piombatoia"@it,
    " mâchicoulis"@fr;
  skos:altLabel "matacán"@es, "Gusserker"@de, " bertesca"@it, "naso"@it, "cadoia"@it,
    "piknůsek"@cs, " bretèche"@fr;
  skos:broader :c_5d9b780a;
  dct:created "2020-06-15T16:00:50.000"^^xsd:dateTime;
  dct:modified "2021-01-27T14:32:52.000"^^xsd:dateTime .

:c_8db3a296 a skos:Concept;
  skos:definition "Eine vor, gelegentlich auch hinter dem Tor befindliche Grube, die ein zusätzliches Annäherungshindernis darstellte und durch eine bewegliche Zugbrücke (oder Wippbrücke) überbrückt wurde. R. F.. [Wörterbuch der Burgen, Schlösser und Festungen]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_50ec0c5e,
    :conceptScheme_1d7ba54b;
  skos:prefLabel "Wolfsgrube"@de;
