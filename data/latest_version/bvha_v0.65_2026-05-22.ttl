  dct:modified "2021-01-25T11:18:33.000"^^xsd:dateTime .

:c_e7f0b018 a skos:Concept;
  skos:definition "Sattelholz: kopfzoniges Holz über frei stehendem Ständer unter Unterzug bzw. Deckenbalken zur besseren Lastaufnahme, oft mit Kopf und/ oder von Ständerschalen umfasst; immer in Richtung des zu unterstützenden Balkens orientiert. (Eißing et al. 2012)"@de,
    "Ein waagerechtes Holz  zur Verbreiterung des Auflagers über einem Ständer und zur Unterstützung eines Unterzugs. Durch Anordnung von einem oder mehreren S.ern kann die freie Spannweite von Unterzügen wie durch Kopfbüge (Büge) oder Streben verringert werden. Das S. hat auch die Aufgabe, das Hirnholz des Ständers vor dem Aufsplittern zu schützen. Formal sind auch verschiedene Kapitelle z.B. das ion. dem S. verwandt. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_19d56a39;
  skos:prefLabel "semelle"@fr, "trámové sedlo"@cs, "bolster"@en, "sottotrave"@it, "sobre viga de madera"@es,
    "Sattelholz"@de;
  skos:altLabel "bois"@fr, "sous-longeron"@fr, "corbel piece"@en, "trave a sella"@it,
    "sedlo"@cs;
  skos:broader :c_41d94569;
  dct:created "2019-05-28T08:20:05.000"^^xsd:dateTime;
  dct:modified "2020-11-26T16:10:43.000"^^xsd:dateTime .

:c_e9afb96c a skos:Concept;
  skos:definition "Sattelschwelle: fußzoniges Holz unter frei stehendem Ständer auf Unterzug bzw. Deckenbalken zur besseren Lastaufnahme.  (Eißing et al. 2012) "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_19d56a39;
  skos:prefLabel "Sattelschwelle"@de;
  skos:broader :c_41d94569;
  dct:created "2019-05-28T08:22:02.000"^^xsd:dateTime;
  dct:modified "2019-11-06T11:57:11.000"^^xsd:dateTime .

:c_8e7e43f6 a skos:Concept;
  skos:definition "Vom Dachbalken bis zum First reichende Säule, an die von beiden Seiten die Sparren anliegen, vielfach mit angeblatteten oder eingezapften Kehlbalken im Querverband und Unterzügen mit Kopfbändern und Streben im Längsverband verknüpft. Die S. kommt auch im Giebelwandgefüge vor. Reichen die Säulen nur bis unter die Hahnenbalken, in die sie eingezapft sind, so spricht man von Hochsäulen. [Koepf / Binding 2016]"@de,
    "Dachspitzständer: auf dem Dach- oder Kehlbalken aufsitzender, bis in den Firstbereich geführter Ständer. Kann spitz auslaufend unter das Sparrenpaar stoßen oder den First ausbilden und mit den Sparren verbunden sein oder den Walmanfallspunkt stützen. Die verschiedenen Varianten des Spitzständers können über den First hinausragen und Träger für eine Firstzier sein (Firstzierständer). [Eißing et al. 2012]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_19d56a39;
  skos:prefLabel "Dachspitzständer"@de, "king post"@en, "pendolón"@es, "poinçon de faîte"@fr;
  skos:altLabel "fiála"@cs, "Spitzsäule"@de, "obélisque"@fr, "poinçon"@fr;
  skos:broader :c_a9967019, :c_040d9b15;
  skos:narrower :c_eb97d12e;
  dct:created "2020-08-18T12:46:04.000"^^xsd:dateTime;
  dct:modified "2020-11-27T17:53:25.000"^^xsd:dateTime .

:c_9c582540 a skos:Concept;
  skos:definition "Im Gegensatz zum Unterzug eines Gebälks bzw. einer Massivdecke ein Träger, der über der Decke liegt, bes. bei Ausstellungs-, Sport- und Werkhallen. [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Oberzug"@de, " viga exterior"@es, " trave estradossata"@it, " partie inférieure"@fr,
    " outer garments"@en;
  skos:broader :c_41d94569;
  dct:created "2020-08-25T15:15:41.000"^^xsd:dateTime;
  dct:modified "2020-11-20T19:34:27.000"^^xsd:dateTime .

:c_c51fa22d a skos:Concept;
  skos:example "Die aussteifenden Gerüstelemente umfassen alle Hölzer, die schräg zu den tragenden Gerüstelementen verlaufen und deren Aufgabe vorrangig darin besteht, Deformation und Verschiebung zu verhindern. Beinhaltet das Gerüst unverschiebliche Dreiecke, z. B. Sparrenpaare, übernehmen diese nicht nur tragende, sondern auch aussteifende Funktion. (Eißing et al. 2012)"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_19d56a39;
  skos:prefLabel "aussteifendes Holzgerüstelement"@de;
  skos:broader :c_46f8305f;
  skos:narrower :c_89c3620e, :c_1fbc2459, :c_fa12efc4, :c_4c25291a, :c_189b869b, :c_cf69c793,
    :c_d850d2bd, :c_70286868, :c_232dcf3c;
  dct:created "2019-05-15T09:52:08.000"^^xsd:dateTime;
  dct:modified "2020-02-28T13:26:44.000"^^xsd:dateTime;
  :broaderByFunction :c_46f8305f .

:c_89c3620e a skos:Concept;
  skos:definition "An beiden Enden geblattetes, schräg verlaufendes Holz. [Eißing et al. 2012]"@de,
    "Zimmermannsmäßige Holzverbindung durch ein schräg angeordnetes Holz, das als Bohle zur Aufnahme von Zugkräften angeblattet ist, seltener als Vollholz, das dann zusätzl. Strebefunktion hat (Vollholz-Band); zumeist als Kopf- oder Fußband (Schwäbisches Weible). [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_19d56a39;
  skos:prefLabel "Band (Holzbauteil)"@de;
  skos:broader :c_c51fa22d;
  skos:narrower :c_1d35dd46, :c_6c2b5429, :c_6a52fdaf, :c_242d332c, :c_0f9fc176, :c_d2733eac,
    :c_2874cded, :c_bd18a907, :c_0355aefa, :c_b62640d1, :c_0e765e58, :c_3b37c51b;
  dct:created "2019-05-28T08:25:23.000"^^xsd:dateTime;
  dct:modified "2020-09-03T15:14:01.000"^^xsd:dateTime .

:c_1fbc2459 a skos:Concept;
  skos:definition "Schräg gestelltes, versteifendes Holz zur Aufnahme von Druckkräften, zumeist eingezapft, seltener angeblattet (Band); zwei sich überkreuzende S.n werden Kreuzs. (Schere) oder Andreaskreuz genannt. Eine kurze S. (Kopf- und Fußs.) wird auch fälschl. Band genannt. [Koepf / Binding 2016]"@de,
    "An beiden Enden gezapftes, schräg verlaufendes Holz. [Eißing et al. 2012]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_19d56a39;
  skos:prefLabel "Strebe"@de, "puntal"@es, "vzpěra"@cs, "contraffisso"@it, "jambe de force"@fr;
  skos:altLabel "podpěra"@cs, "zápora"@cs, "rozpěra"@cs, "étrésillon"@fr, "strut"@en,
    "saettone"@it;
  skos:broader :c_174d6ba6, :c_c51fa22d;
  skos:narrower :c_1412f9bb, :c_317bf0b1, :c_8a6c8e28, :c_7e653b37, :c_d9cfe229, :c_10e1955f,
