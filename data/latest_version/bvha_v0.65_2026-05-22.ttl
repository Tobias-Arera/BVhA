:c_d28a68ed a skos:Concept;
  skos:definition "Custodia f (lat.); Kustodia f ; Repositorium n (lat.); auch Sakramentsbehälter m; gr. artophorion;lat. capsular ein oft schmuckloser, verschIießbarer Behälter aus Edelmetall zur Aufbewahrung der zur Aussetzung in der Monstranz bestimmten großen Hostie samt ihrem Träger (Lunula) im Tabernakel. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "custodia"@la, "artophorion"@el, "custode"@fr, "kustodie"@cs, "repository"@en,
    "Custodia"@de;
  skos:altLabel "repositorium"@la, "capsula"@la, "Kustodia"@de, "Repositorium"@de, "Sakramentsbehälter"@de;
  skos:broader :c_af38f5d3;
  skos:related :c_fd44f8d9, :c_40d7ba03, :c_6f7181ac, :c_0d483041;
  dct:created "2020-07-25T16:27:49.000"^^xsd:dateTime;
  dct:modified "2021-01-24T14:58:28.000"^^xsd:dateTime .

:c_14a349f2 a skos:Concept;
  skos:definition "Pyxis f (gr.); präzis. Hostienpyxis f; gr. artophorion; lat. area; capsa; ciborium; theca; custodia: ein runder, ovaler oder polygonaler Behälter mit kuppel- oder pyramidenförmigern Deckel zur Aufbewahrung des eucharistischen Brotes bzw. der konsekrierten großen Hostie im Tabernakel. Die Pyxis ist aus Buchsbaumholz, Elfenbein oder Edelmetall gearbeitet und häufig mit Emailschmuck dekoriert. Um sie von der Reliquienpyxis unterscheiden zu können, trug sie oft die Aufschrift \"pro sacramento\". Vom 13. Jh. an wurde das Behältnis kelchförmig und hieß etwa vom 16. Jh. an nur noch Ziborium. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "Pyxis"@de, "pyx"@en, "pyxide"@fr, "arca"@la;
  skos:altLabel "custodia"@la, "artophorion"@el, "ciboire"@fr, "ciborium"@la, "capsa"@la,
    "theca"@la, "Hostienpyxis"@de;
  skos:broader :c_aced96c4, :c_af38f5d3;
  skos:narrower :c_3866550a, :c_241880a6, :c_c01558f6, :c_405e3cb8;
  skos:related :c_fd44f8d9, :c_b6b48d98, :c_6086188f, :c_67faa0fb;
  dct:created "2020-08-07T09:20:02.000"^^xsd:dateTime;
  dct:modified "2021-01-24T15:23:50.000"^^xsd:dateTime .

:c_bdf08c99 a skos:Concept;
  skos:definition "Tabernakelauskleidung f: der meist aus weißer Seide bestehende Bezug der Innenflächen des Tabernakels, der immer dann vorgeschrieben ist, wenn diese nicht vergoldet sind. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "revêtement du tabernacle"@fr, "tabernacle lining"@en, "Tabernakelauskleidung"@de;
  skos:broader :c_69593e2e;
  skos:related :c_fd44f8d9, :c_9f74e321;
  dct:created "2020-06-18T18:16:24.000"^^xsd:dateTime;
  dct:modified "2021-01-24T17:32:02.000"^^xsd:dateTime .

:c_7df544d2 a skos:Concept;
  skos:definition "Öl-Ampel, die ständig vor dem Allerheiligsten (Venerabile) christlicher Kirchen und in Synagogen brennt. [Koch 2009]"@de,
    "Olejová lampa hořící nepřetržitě před Nejsvětější svátostí oltářní (venerabile) v křesťanském kostele a v synagogách. [Koch 2008]"@cs,
    "Ewiges Licht n; auch Ewige Lampe f ; Chorlampe f; Ewiglichtlampe f; lat. lucerna aeterna: eine an drei Ketten hängende, mit Olivenöl gespeiste Lampe, die ständig vor dem Tabernakel brennen muss, in dem das Sakrament aufbewahrt wird und die nur an den drei letzten Tagen der Karwoche gelöscht wird. Das Ewige Licht gilt als Symbol der Gegenwart Christi als Licht der Welt (Joh 8, 12 ). Die Verwendung eines anderen vegetabilischen Öls bedarf der bischöflichen Genehmigung, die Benützung von Glühlicht bedarf der Erlaubnis durch den Heiligen Stuhl. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9, :conceptScheme_1f14b4dd;
  skos:prefLabel "Ewiges Licht"@de, "věčné světlo"@cs, "lampe du sanctuaire"@fr, "lucerna aeterna"@la,
    "sanctuary-lamp"@en;
  skos:altLabel "lampe du Saint-Sacrement"@fr, "veilleuse"@fr, "veilleuse à perpétuité"@fr,
    "sanctuary light"@en, "Ewige Lampe"@de, "Chorlampe"@de, "Ewiglichtlampe"@de;
  skos:broader :c_0660b156, :c_fe6ee255;
  skos:related :c_fd44f8d9;
  dct:created "2020-07-25T16:40:39.000"^^xsd:dateTime;
  dct:modified "2021-01-30T22:40:55.000"^^xsd:dateTime .

:c_b81f50c0 a skos:Concept;
  skos:definition "Conopeum n, Konopeum n: aus verschiedenen Materialien (z.B. Seide, Leinen oder Baumwolle) bestehender, schlichter oder verzierter Behang, der das Tabernakel zeltartig umhüllt; das Conopeum unterliegt dem Farbenkanon, darf auch immer weiß sein, nie jedoch schwarz. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "conopée"@fr, "tabernacle veil"@en, "Conopeum"@de, "konopeum"@cs;
  skos:altLabel "pavillon de tabernacle"@fr, "aumbrey veil"@en, "Konopeum"@de;
  skos:broader :c_69593e2e;
  skos:related :c_fd44f8d9, :c_e3ddd266, :c_9f74e321, :c_ef40cc12, :c_1734c443;
  dct:created "2020-04-09T16:38:35.000"^^xsd:dateTime;
  dct:modified "2021-01-24T16:26:39.000"^^xsd:dateTime .

