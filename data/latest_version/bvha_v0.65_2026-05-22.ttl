  dct:modified "2021-01-24T17:39:00.000"^^xsd:dateTime .

:c_46e93730 a skos:Concept;
  skos:definition "Camail m: bis zu den Ellenbogen reichendes Schultermäntelchen ohne Kapuze; besonders in Frankreich gebräuchlich. [Glossarium Artis]"@de;
