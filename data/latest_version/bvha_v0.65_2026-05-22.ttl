:c_7ce7b01c a skos:Concept;
  skos:definition "Ein Glöckchen, mit dem nach heutiger Vorschrift in der Messe beim Sanktus und bei den auf die Konsekration der Hostie und des Weines folgenden Elevationen allgemein sowie nach örtlichem Brauch vielfach auch bei Beginn der Opferung und dem Domine non sum dignus vor der Kommunion ein Zeichen gegeben wird, um die Aufmerksamkeit der Gläubigen auf jene Akte zu lenken. [RDK Labor]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_cf792a3c;
  skos:prefLabel "campanula"@la, "altar bell"@en, "oltářní zvonek"@cs, "Altarglocke"@de,
    "sonnette d\\'autel"@fr, "altaarschel"@nl, "campanello"@it;
