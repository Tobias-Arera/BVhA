:c_657a510f a skos:Concept;
  skos:definition "Ein Gewölbe, meist eine Tonne, dessen Achse nicht rechtwinklig zur HörizontaIprojektion des Stirnbogens verläuft. Die Grundfläche des überwölbten Raumes ist meist rautenförmig. Das schiefe Gewölbe verlangt Keilsteine mit einem besonderen, schrägen Fugenschnitt. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "oblique vault"@en, "voûte biaise"@fr, "schiefes Gewölbe"@de;
