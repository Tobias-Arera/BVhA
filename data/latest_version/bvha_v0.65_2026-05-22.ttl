:c_abec9f5f a skos:Concept;
  skos:definition "Wandkonstruktion aus nebeneinander eingegrabenen Hölzern, die zugleich das Dach tragen; die Hölzer sind häufig Spaltbohlen. Eine frühgeschichtl. Konstruktionsweise, die sich in Nordeuropa bis ins MA erhalten hat. [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Palisadenbau"@de, "construcción de empalizada"@es, "costruzione a palizzata"@it,
    "palissade"@fr, " palisade"@en;
  skos:broader :c_8b190e59;
  dct:created "2020-08-25T13:15:39.000"^^xsd:dateTime;
  dct:modified "2020-11-21T16:09:06.000"^^xsd:dateTime .

:c_8f7593b5 a skos:Concept;
