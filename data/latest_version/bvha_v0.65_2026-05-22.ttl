  dct:modified "2021-01-19T13:27:17.000"^^xsd:dateTime .

:c_ca740619 a skos:Concept;
  skos:definition "Die Schnittkurve zwischen zwei einander überschneidenden Gewölbeflächen. [Koepf / Binding 2016]"@de,
    "Die von einem Gewölbegrat gebiIdete Bogenlinie. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_1f14b4dd;
  skos:prefLabel "groin arch"@en, "arc en arête"@fr, "Gratbogen"@de;
  skos:broader :c_a8acd6c4;
  skos:related :c_6c6b65da;
  dct:created "2020-02-18T15:35:16.000"^^xsd:dateTime;
  dct:modified "2021-01-19T11:59:04.000"^^xsd:dateTime .

:c_ff8b37b5 a skos:Concept;
  skos:definition "Die Ausmauerung der Hohlräume hinter einer vorgeblendeten Schale aus besserem Material, auch das Ausfüllen des Hohlraums zwischen der Gewölbeschale und dem aufgehenden Mauerwerk. [Koepf / Binding 2016]"@de,
    "Eine Aufmauerung zwischen Widerlagsmauer und Gewölberücken. Sie stabilisiert  die Gewölbeschale und wird bis zu zwei Dritteln ihrer Höhe aufgeführt. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_1f14b4dd;
  skos:prefLabel "backing (vault)"@en, "maçonnerie de remplissage (voûte)"@fr, "Hintermauerung (Gewölbe)"@de;
  skos:broader :c_3e25acca;
  dct:created "2020-02-18T16:38:42.000"^^xsd:dateTime;
  dct:modified "2021-01-19T13:28:36.000"^^xsd:dateTime .

:c_ee8d0d5f a skos:Concept;
  skos:definition "Die rinnenartige Einziehung zwischen zwei sich überschneidenden gewölbten Flächen, z. B. in der Leibung des Klostergewölbes und im Rücken des Kreuzgewölbes. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "arête rentrante"@fr, "re-entrant groin"@en, "Kehle (Gewölbe)"@de;
  skos:broader :c_3e25acca, :c_cabd02f8;
