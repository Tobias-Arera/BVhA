  dct:created "2020-02-25T16:09:25.000"^^xsd:dateTime;
  dct:modified "2021-01-24T14:49:48.000"^^xsd:dateTime .

:c_b7877c2d a skos:Concept;
  skos:scopeNote "Liturgisches Gerät, das zur Besprengung mit Weihwasser verwendet wird. Auf einen Schaft sind Borsten montiert. "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8;
  skos:prefLabel "Sprengwedel"@de, "aspersorium"@cs, "aspersorium"@la;
