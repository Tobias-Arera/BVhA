:c_258fd264 a skos:Concept;
  skos:definition "Westl. Querhaus bzw. Querhaus, das an einen Westchor (Doppelchörige Anlage) angefügt ist. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "Westquerhaus"@de, "crucero occidental"@es, "transetto occidentale"@it,
    "transept occidental"@fr, "west transept"@en;
  skos:broader :c_956c614a;
  dct:created "2020-08-04T10:36:23.000"^^xsd:dateTime;
  dct:modified "2021-01-21T18:26:48.000"^^xsd:dateTime .

:c_e4411e0d a skos:Concept;
  skos:definition "Teil des Querhauses seitl. des Vierungsquadrats. Beim Quadratischen Schema hat der Q. die Größe des Vierungsquadrats, so dass das Querhaus drei Quadrate umschließt. [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe;
  skos:prefLabel " aile de transept"@fr, "ramena příčné lodi"@cs, "transept arm"@en,
    " braccio del transetto"@it, "brazo de crucero"@es, "Querhausarm"@de;
  skos:altLabel "croisillon"@fr, "Transept"@de, "Kreuzarm (Querhaus)"@de, "bras de transept"@fr,
    "Kreuzflügel"@de;
  skos:broader :c_956c614a;
  dct:created "2020-08-06T11:15:14.000"^^xsd:dateTime;
  dct:modified "2021-01-21T18:26:28.000"^^xsd:dateTime .

:c_71b285aa a skos:Concept;
  skos:definition "Bes. betont ausgebildetes Querschiff roman. Kirchen in der  Auvergne (auvergnat. Querriegel). [Koepf/Binding 2016]"@de,
    "Stupňovitá příčná loď, mohutná příčná loď se vzpěrnou funkcí u některých románských kostelů, zvl. v Auvergni.  [Koch 2008]"@cs,
    "Das gestaffelte Querhaus einiger romanischer Kirchen, besonders der Auvergne. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "Querriegel"@de, "stupňovitá příčná loď"@cs;
  skos:broader :c_956c614a;
  dct:created "2020-08-11T14:06:49.000"^^xsd:dateTime;
  dct:modified "2021-01-21T18:26:38.000"^^xsd:dateTime .

:c_9556c9c8 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe;
  skos:prefLabel "Zellenquerbau"@de, "příčná loď s pastoforii"@cs;
  skos:broader :c_956c614a;
  skos:related :c_e58fbb73;
