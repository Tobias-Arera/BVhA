:c_85ed2113 a skos:Concept;
  skos:definition "Apsis an den Ostseiten der Querhausarme. Sie können auch gestaffelt sein, wobei der Chor mit der Hauptapsis am weitesten nach 0. vorstößt. Bei Zisterzienserbauten sind die Q.n meist kleine Rechtecknischen, die unmittelbar nebeneinander liegen. [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "Querhausapside"@de, "abside del transetto"@it, "apside de transept"@fr,
