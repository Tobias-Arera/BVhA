  dct:created "2020-02-25T16:13:23.000"^^xsd:dateTime;
  dct:modified "2021-01-24T14:57:29.000"^^xsd:dateTime .

:c_19442209 a skos:Concept;
  skos:definition "Gerät zur Erteilung des Friedenskusses. [RDK Labor]"@de, "Kusstafel f; Friedenskusstafel f; Paxtafel f; auch Kusstäfelchen n; Pacificale n (lat.); Pacemtafel f; Osculatorium n (lat.); Paxbrettl n; lat. tabula pacis; pax; instrumentum pacis; etc.: eine kleine Tafel aus Elfenbein, Metall oder Holz mit der Darstellung des Gekreuzigten oder des Agnus Dei bzw. eines Ereignisses aus dem Leben Jesu. Sie wurde ausgewählten Personen in der Messe nach dem Agnus Dei als symbolischer Vermittler des Seelenfriedens zum Kuss gereicht . Manchmal diente sie auch als Reliquiar. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd, :conceptScheme_cf792a3c;
  skos:prefLabel "Kusstafel"@de, "pacifikál"@cs, "instrument de paix"@fr, "instrumentum pacis"@la,
    "pax brede"@en;
  skos:altLabel "paix liturgique"@fr, "pax"@en, "osculatorium"@en, "Paxtafel"@de, "Oskulatorium"@de,
    "Friedenskusstafel"@de, "Kusstäfelchen"@de, "Pacificale"@de, "Pacemtafel"@de, "pacificale"@la,
    "tabula pacis"@la;
  skos:broader :c_17d46f99;
  dct:created "2020-02-25T16:18:24.000"^^xsd:dateTime;
  dct:modified "2021-01-24T14:51:16.000"^^xsd:dateTime .

:c_37fd5c3f a skos:Concept;
  skos:definition "Altarleuchter m; lat. candelabrum altaris: ein StandIeuchter auf dem Altar. Ursprünglich befanden sich die Leuchter neben dem Altar auf dem Boden, sie wurden erst in der 2. Hälfte des 11. Jh. auf die Mensa gestellt. Üblich sind zwei Leuchter mit je einer Kerze, die Anzahl der erlaubten Kerzen hat jedoch im Laufe der Zeit mehrfach gewechselt. [Glossarium Artis]"@de,
    "Leuchter mit brennender Kerze, die auf dem Altar stehen müssen, wenn an ihm Messen oder sonstige liturgische Handlungen stattfinden. Ihre Zahl beträgt je nach den Umständen 2, 4, 6 oder 7. [RDK Labor]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd, :conceptScheme_cf792a3c;
  skos:prefLabel "Altarleuchter"@de, "candelabrum altaris"@la, "altar-candlestick"@en,
    "candelabro d\\'altare "@it, "candélabre d\\'autel"@fr;
  skos:altLabel "candelabrum"@la, "altar light"@en, "altar-candelabra"@en, "chandelier d\\'autel"@fr;
  skos:broader :c_17d46f99, :c_438111ab;
  skos:related :c_b395ea26, :c_9402111b;
  dct:created "2020-02-25T16:26:10.000"^^xsd:dateTime;
  dct:modified "2021-01-30T22:48:15.000"^^xsd:dateTime .

