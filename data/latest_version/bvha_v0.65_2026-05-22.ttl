:c_0dc61805 a skos:Concept;
  skos:definition " City (engl.), vom Namen der Innenstadt Londons abgeleitete Bezeichnung für den Stadtkern, bes. bei Ballung von Geschäfts- und Verwaltungsfunktionen. [Koepf / Binding 2016] "@de,
    "Innenstadt, Zentrum einer Stadt. Der S. ist bei europ. Städten meist der ehemals von Mauern, Gräben und Wällen umgebene Teil (Altstadt), im weiteren Sinne des Worts auch das Zentrum mit den Hauptgeschäftsstraßen und öffentl.Gebäuden (City) im Gegensatz zu den Außenbezirken bzw. Vorstädten. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_176fcff1;
  skos:prefLabel "city centre"@en, "city center"@en-US, "centrum města, městské jádro"@cs,
    "Stadtkern"@de, "noyau urbain"@fr, "centro urbano"@es, "centro (della città)"@it;
  skos:altLabel "centre-ville"@fr, "City"@en;
  skos:broader :c_34633e2c, :c_650e7fcc;
  dct:created "2020-08-14T16:17:11.000"^^xsd:dateTime;
  dct:modified "2021-01-27T15:42:54.000"^^xsd:dateTime .

