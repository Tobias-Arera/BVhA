    "conoidal section of a fan vault"@en;
  skos:broader :c_e5979373;
  dct:created "2019-12-13T13:39:39.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:57:13.000"^^xsd:dateTime .

