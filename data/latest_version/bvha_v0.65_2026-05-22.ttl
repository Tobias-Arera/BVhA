:c_d96146d9 a skos:Concept;
  skos:definition "Mitra pretiosa f: mit Edelsteinen, Perlen, Gold- und Silberplättchen verzierte Mitra. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
