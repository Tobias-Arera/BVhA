:c_36dcf38f a skos:Concept;
  skos:definition "Gewölbe, das aus einem Gemisch aus Zement, Wasser und Zuschlagstoffen gegossen ist. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
