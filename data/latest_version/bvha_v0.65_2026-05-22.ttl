:c_126f1589 a skos:Concept;
  skos:definition "Vestibulum, 1. Vorhof, Vorhalle vor dem Eingang des röm. Hauses, die in die Bauflucht einbezogene Haustür bildet den hinteren Abschluss, seit!. von Läden oder anderen Räumen flankiert. Vom V. geht der Raum mit der Obergeschosstreppe ab. 2. In der jüngeren Neuzeit zunächst ein Vorraum hinter der Haustür vor den Zimmern, häufig mit Garderobe ausgestattet, dann auch jedes Vorzimmer. [Koepf / Binding 2016]"@de,
    "Lat. vestibulum, vstupní hala a předsíň domu, též strážní místnost. [Koch 2008]"@cs,
    "(lat. vestis ›Gewand‹), Vorraum eines Hauses. Im Schlossbau bezeichnet man damit die große Eingangshalle, von der meist die Treppe abgeht und die man durchschreitet, um in die Sala terrena zu gelangen. B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen]"@de,
    "Vestibül (lat. vestibulum), Eingangshalle und Vorraum eines Hauses, auch Wachtraum. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9, :conceptScheme_1d7ba54b;
  skos:prefLabel "vestibule"@fr, "vestibulum"@la, "vestibul"@cs, "vestibolo"@it, "vestíbulo"@es,
    "Vestibül"@de;
  skos:altLabel "atrio"@it, "dvorana"@cs, "vstupní hala"@cs;
  skos:broader :c_de30207d;
  dct:created "2020-04-28T16:47:21.000"^^xsd:dateTime;
  dct:modified "2021-01-22T13:55:39.000"^^xsd:dateTime .

