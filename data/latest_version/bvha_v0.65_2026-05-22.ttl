  dct:modified "2021-01-26T23:18:27.000"^^xsd:dateTime .

:c_587f1f11 a skos:Concept;
  skos:definition "Geschossbau, dessen Außenwände durch Bohlen geschlossen sind, die in Nuten oder Falze des Gerüsts eingesetzt sind und im Unterschied zum Stabbau keine aussteifende Funktion besitzen. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_c8a571d9;
  skos:prefLabel "Ständerbohlenbau"@de;
  skos:broader :c_dce60e4c;
  dct:created "2020-08-12T15:45:00.000"^^xsd:dateTime;
  dct:modified "2021-01-26T23:19:57.000"^^xsd:dateTime .

:c_2454f311 a skos:Concept;
  skos:definition "Geschossbau, bei dem die Lehmausfachung auch über die dünneren, einige Zentimeter gegenüber der Bundebene zurückgesetzt verzimmerten Riegel und Streben reicht und diese damit verdeckt. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_c8a571d9;
  skos:prefLabel "Ständerlehmbau"@de;
  skos:broader :c_dce60e4c;
  dct:created "2020-08-12T15:46:21.000"^^xsd:dateTime;
  dct:modified "2021-01-26T23:20:27.000"^^xsd:dateTime .

:c_0648edeb a skos:Concept;
  skos:definition "1. Eine Bauweise, bei der tragende Wände aus senkrechten Holzstützen (Ständern) gefügt werden (im Unterschied zum Blockbau). 2. Auch verwendet als Sammelbezeichnung für alle Holzbauweisen mit tragendem Gerüst aus Ständern. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
