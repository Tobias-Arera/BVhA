:c_230e1e22 a skos:Concept;
  skos:definition "Emporenraum; Empore in Damenstifts- und Nonnenklosterkirchen, die der Abschirmung der Nonnen von den übrigen Teilnehmern am Gottesdienst diente, meist mit Altar, Orgel und Chorgestühl. Die N. lag meist im W, seltener auch über den Seitenschiffen oder in einem Querhausarm. Sie kann bühnenartig über Säulenstellungen weit in das Mittelschiff hineingezogen werden oder auf den Westbau beschränkt bleiben. [Koepf/Binding 2016]"@de,
    "Empora jeptišek v ženském klášteře. [Koch 2008]"@cs, "Prieche, Nonnenempore im Frauenkloster oder Damenstift. [Koch 2009]"@de,
    "Zpravidla v západní části, nebo jsou na ní umístěny varhany (též kruchta, většinou na západě), nebo má především členící funkci. Zvláště v románské době empory otvíraly stěny chrámové lodi a představovaly třecí rytmický prvek mezi arkádami v přízemí a horní okenní stěnou. V renesančních a barokních emporových kostelích zasahovala empora až do klenby a nabývala zároveň většího prostorového významu. Empora však není nezbytnou součástí chrámového prostoru. V centrální stavbě se nachází nad ochozem, v bazilice nad bočními loděmi, v příčné lodi, nebo nad západním vchodem, v halových nebo jednolodních kostelích stojí na vlastní konstrukci a bývala často zabudována až dodatečně, především v reformovaných kostelích. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel " tribune de religieuse"@fr, "tribuna jeptišek"@cs, "matroneo delle monache"@it,
    " coro de las monjas"@es, "Nonnenchor"@de, "nun\\'s gallery"@en;
  skos:altLabel "kruchta jeptišek"@cs, "chór jeptišek"@cs, "empora jeptišek"@cs, " galería de las monjas"@es,
    "Nonnenempore"@de, "Prieche"@de;
  skos:broader :c_d37353f8;
  dct:created "2020-08-04T13:13:42.000"^^xsd:dateTime;
  dct:modified "2021-01-22T12:25:11.000"^^xsd:dateTime .

