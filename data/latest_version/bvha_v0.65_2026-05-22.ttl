:c_c407e950 a skos:Concept;
  skos:definition "Fensterform, deren Öffnung durch einen Segmentbogen abgeschlossen wird. [Koepf / Binding 2016]"@de,
    "Okno se segmentovým nadpražím (fronton), nadokenní římsy mohou být zalomené nebo prolomené. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_37522b74;
  skos:prefLabel "Segmentfenster"@de, "ventana con arco rebajado"@es, "segmentové okno"@cs,
