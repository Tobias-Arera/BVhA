:c_3c76f533 a skos:Concept;
  skos:definition "Kehlsparren/Kehlrofen: Sparren/Rofen, der die Dachkehle bei zwei aneinanderstoßenden Dachflächen bildet.  (Eißing et al. 2012) "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_19d56a39;
  skos:prefLabel "Kehlrofen"@de;
  skos:broader :c_ac93c02d;
  dct:created "2019-05-27T17:48:47.000"^^xsd:dateTime;
  dct:modified "2019-05-27T17:51:14.000"^^xsd:dateTime .

:c_cc100c10 a skos:Concept;
  skos:definition "Kehlschiftersparren/Kehlschifterrofen: Sparren/ Rofen, der gegen einen Kehlsparren/Kehlrofen anläuft.  (Eißing et al. 2012) "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_19d56a39;
