:c_53b8ae97 a skos:Concept;
  skos:definition "Krippe f; auch Präsepie f ; lat. praesepium: der hölzerne Trog, in den der neugeborene Jesus zu Bethlehem gelegt wurde. Die hl. Helena verwahrte die Krippe in der Geburtkirche, später wurde sie nach Rom in die Basilika S. Maria Maggiore gebracht, wo s ie alljährlich am 24. Dezember auf dem Hochaltar aufgestellt und als Reliquie verehrt wird. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "Crèche "@fr, "Crib"@en, "Krippe Christi"@de, "praesepium"@la;
  skos:altLabel "Präsepie"@de;
  skos:broader :c_d15c6488;
  skos:related :c_4a44d96f;
  dct:created "2020-09-25T18:49:51.000"^^xsd:dateTime;
  dct:modified "2021-01-27T11:42:02.000"^^xsd:dateTime .

