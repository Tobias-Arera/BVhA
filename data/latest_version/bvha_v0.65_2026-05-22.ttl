  dct:modified "2020-02-18T09:17:36.000"^^xsd:dateTime;
  :broaderByPosition :c_be713e0d .

:c_b652ef1a a skos:Concept;
  skos:definition "Der im Unterschied zum Fensterladen meist verglaste, bewegl. Teil des Verschlusses der Fensteröffnung. [Koepf / Binding 2016]"@de,
    "Bauteil, welches durch eine Dreh- oder Schiebebewegung die Fensteröffnung oder das Fenster öffnen kann. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_b41bd73a;
  skos:prefLabel "Fensterflügel"@de;
  skos:broader :c_fd1a5740;
  skos:narrower :c_dc1a23a4, :c_f1bea293, :c_e76780c7, :c_350c9daf, :c_94a8e8f7, :c_87272d02,
    :c_e894bff1, :c_081385ad;
  dct:created "2019-06-12T16:58:13.000"^^xsd:dateTime;
  dct:modified "2020-09-14T12:25:50.000"^^xsd:dateTime .

:c_dc1a23a4 a skos:Concept;
  skos:definition "Ein um die Senkrechte drehbarer, mit Bändern in die Kloben am Fensterrahmen oder in die Haspen am Werksteinrahmen gehangener Flügel. Beim Lüftungsflügel befinden sich die Kloben am Höhenstück des Flügels. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Drehflügel"@de;
  skos:broader :c_b652ef1a;
  dct:created "2019-06-12T17:00:24.000"^^xsd:dateTime;
  dct:modified "2019-06-12T17:03:53.000"^^xsd:dateTime .

:c_f1bea293 a skos:Concept;
  skos:definition "Horizontal oder vertikal in Laufnuten meist auf der Fensterinnenseite verschiebbarer Flügel. Es sind keine Beschläge notwendig. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0,
    :conceptScheme_b41bd73a;
  skos:prefLabel "Schiebeflügel"@de;
  skos:broader :c_b652ef1a;
  dct:created "2019-06-12T17:00:36.000"^^xsd:dateTime;
  dct:modified "2019-06-17T14:53:26.000"^^xsd:dateTime .

:c_e76780c7 a skos:Concept;
  skos:definition "Um die Waagerechte drehbarer Flügel, entweder als Oberlicht oder als Flügel, größtenteils moderne Form. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Kippflügel"@de;
  skos:broader :c_b652ef1a;
  dct:created "2019-06-12T17:00:55.000"^^xsd:dateTime;
  dct:modified "2019-06-12T17:10:40.000"^^xsd:dateTime .

:c_350c9daf a skos:Concept;
  skos:scopeNote "Flügel, der beim Öffnen des Fensters durch Heben über die obere Fensterhälfte geschoben wird."@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Hebeflügel"@de;
  skos:broader :c_b652ef1a;
  dct:created "2019-06-12T17:01:12.000"^^xsd:dateTime;
  dct:modified "2019-06-12T17:13:41.000"^^xsd:dateTime .

:c_94a8e8f7 a skos:Concept;
  skos:definition "Flügel, der aus Brettern zusammengefügt ist. Eine Öffnung, aus zwei Brettern ausgesägt, ist möglich. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Brettflügel"@de;
  skos:broader :c_b652ef1a;
  dct:created "2019-06-17T13:40:07.000"^^xsd:dateTime;
  dct:modified "2019-06-17T13:41:41.000"^^xsd:dateTime .

:c_87272d02 a skos:Concept;
  skos:definition "Auch Schößchen oder Gucklein genannt. Flügel im Fensterflügel, der kleiner ist und eigene Beschläge besitzt. Er verkleinert die Lüftungsfläche des Fensters und diente als Ausguck. Seine Abmessungen sind i. d. R. so bemessen, dass ein Kopf durch die Öffnung gesteckt werden kann. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Lüftungsflügel"@de;
  skos:altLabel "Schößchen"@de, "Gucklein"@de;
  skos:broader :c_b652ef1a;
  dct:created "2019-06-18T08:00:31.000"^^xsd:dateTime;
  dct:modified "2019-06-18T08:02:18.000"^^xsd:dateTime .

:c_e894bff1 a skos:Concept;
  skos:definition "Bei einem zweiflügeligen Fenster ohne festen Pfosten der Flügel, der zuletzt geöffnet wird. Die Bezeichnung im modernen Fensterbau lautet auch Bedarfsflügel. [Pax - Fenster & Türen Fachbegriffe]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0;
  skos:prefLabel "Stulpflügel"@de;
  skos:broader :c_b652ef1a;
  dct:created "2019-06-18T10:23:52.000"^^xsd:dateTime;
  dct:modified "2019-06-18T10:24:29.000"^^xsd:dateTime .

:c_18b9aa69 a skos:Concept;
  skos:definition "Vorreiber, Fensterbeschlag; drehbarer Griff zur Verriegelung der Fensterflügel, bes. zur Betätigung des senkrechten Stabs, dessen gebogene Enden in untere und obere Ösen eindrehen. [Koepf/Binding 2016]"@de,
    "Neben der Ankettel älteste bekannte Fensterverriegelung. Drehbar innen am Fensterrahmen befestigte Verriegelung, die den Fensterflügel an den Rahmen drückt. [Noky 1996]"@de,
    "(Halbvorreiber oder Doppelvorreiber) aufgeschraubter oder genagelter Drehriegel, der die Flügel am Blendrahmen über einen Streichdraht oder ein Streichblech festriegelt. [Pax - Fenster & Türen Fachbegriffe]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0,
    :conceptScheme_b41bd73a;
  skos:prefLabel " frottoir"@fr, " maniglia di finestra"@it, "Reiber"@de, "perilla de ventana"@es;
  skos:altLabel "Vorreiber"@de;
  skos:broader :c_d936f79a;
  skos:narrower :c_d56109a3, :c_0709039d;
  dct:created "2019-06-12T18:24:02.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:42:07.000"^^xsd:dateTime .

:c_d56109a3 a skos:Concept;
  skos:definition "Reiber mit einseitigem Riegel, der nur einen Flügel verschließt. Er ist i. d. R. am Fensterrahmen befestigt, kann aber auch am Fensterflügel befestigt sein, z. B. beim Lüftungsflügelfenster oder bei nach außen zu öffnenden Fenstern. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Einreiber"@de;
  skos:broader :c_18b9aa69;
  dct:created "2019-06-12T18:27:39.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:42:34.000"^^xsd:dateTime .

:c_0709039d a skos:Concept;
  skos:definition "Reiber mit zweiseitigem Riegel, der zwei Flügel verschließt und i. d. R. am Pfosten angebracht ist. [Noky 1996]"@de,
    "Fensterbeschlag zum Verriegeln eines Fensters aus einem doppelten Reiber aus Rundeisen oder später Gußmaterial. Besitzt eingerollte Enden und eine breit geschmiedete Mitte, durch die der Doppelvorreiber mit einem Nagel am Mittelpfosten befestigt wird. [Pax - Fenster & Türen Fachbegriffe]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0,
    :conceptScheme_b41bd73a;
  skos:prefLabel "Doppelreiber"@de;
  skos:altLabel "Doppelvorreiber"@de;
  skos:broader :c_18b9aa69;
  dct:created "2019-06-12T18:27:52.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:42:24.000"^^xsd:dateTime .

:c_c05dd4af a skos:Concept;
  skos:definition "Der Flügel schlägt in den Einschlagfalz ein und schließt innen bündig mit dem Fensterrahmen ab. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_b41bd73a;
  skos:prefLabel "Einfacher Überschlag"@de;
  skos:broader :c_e8019b16;
  dct:created "2019-06-13T14:48:40.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:16:04.000"^^xsd:dateTime .

:c_5105dab3 a skos:Concept;
  skos:definition "Der Flügel schlägt zusätzlich zum einfachen Überschlag noch auf den Fensterrahmen auf und steht so erhaben über ihm. Er ist eine Entwicklung aus der Barockzeit und hat eine bessere Abdichtung zum Ziel. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_b41bd73a;
  skos:prefLabel "Doppelter Überschlag"@de;
  skos:broader :c_e8019b16;
  dct:created "2019-06-13T14:48:59.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:15:55.000"^^xsd:dateTime .

:c_74e7a266 a skos:Concept;
  skos:definition "Winklig geschmiedetes Eisenteil, dessen Enden wie ein Schmiedenagel angespitzt bzw. als runder Dorn ausgearbeitet sind. Es wird in das Holz wie ein Nagel eingeschlagen. Die Lauffläche ist lediglich das Auflagerstück der Rolle auf dem Eisenteil, mitunter ist auch ein Sockel angeschmiedet. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Einschlagkloben"@de;
  skos:broader :c_39fa2838;
  dct:created "2019-06-13T14:58:35.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:44:47.000"^^xsd:dateTime .

:c_3dc21bc9 a skos:Concept;
  skos:definition "Aus zwei Teilen bestehender Kloben. Ein Teil ist unten zu einem Stützblech mit einer Zierform und oben zu einem Dorn ausgearbeitet, das Zweite wird um den Dorn gelegt und ins Holz geschlagen. Es dient zugleich als Lauffläche für das Band. Das Stützblech wird am unteren Ende in der Zierform mit einem Nagel im Holz befestigt. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0,
    :conceptScheme_b41bd73a;
  skos:prefLabel "Stützkloben"@de;
  skos:broader :c_39fa2838;
  dct:created "2019-06-13T14:58:47.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:44:55.000"^^xsd:dateTime .

:c_20262d98 a skos:Concept;
  skos:definition "Oberer Teil des Klobens."@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Dorn"@de;
  skos:broader :c_39fa2838;
  dct:created "2019-06-13T15:07:33.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:44:39.000"^^xsd:dateTime .

:c_7fb230a7 a skos:Concept;
  skos:definition "Bezeichnung für ein Paar Fensterflügel mit den dazugehörenden Teilen des Fensterrahmens, wenn das Fenster mehrere Flügelpaare übereinander aufweist. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Etage (Fenster)"@de;
  skos:broader :c_f88a153a, :c_8ddac41d;
  dct:created "2019-06-13T15:19:42.000"^^xsd:dateTime;
  dct:modified "2020-02-18T08:47:50.000"^^xsd:dateTime;
  :broaderByPosition :c_f88a153a .

:c_8ddac41d a skos:Concept;
  skos:definition "Hölzer, die mit den Schenkeln die Konstruktion eines Rahmens bilden, im Fensterrahmen Pfosten, Querholz, Höhenholz und Setzholz und im Flügelrahmen Querstück und Höhenstück. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Innenkonstruktion (Fenster)"@de;
  skos:broader :c_fd1a5740;
  skos:narrower :c_7fb230a7, :c_8e5c0176, :c_ce1dbe72;
  dct:created "2019-06-18T06:45:10.000"^^xsd:dateTime;
  dct:modified "2020-06-19T14:10:04.000"^^xsd:dateTime .

:c_a7ccf810 a skos:Concept;
  skos:definition "Form der Lichtfase an einer Holzsprosse, wenn auf der Außenseite des Fensterflügels ein Kittfalz eingearbeitet ist. Sie läuft nach der Verglasung nach innen über die Stärke der Schenkel auf beiden Seiten der Sprosse spitz aus. Im gleichen Winkel verlaufen auch die Lichtfasen an den Schenkeln. Bei ersten Anwendungen des Kittfalzes im bürgerlichen Bauen im frühen 19. Jahrhundert kommt die Spitzfase noch nicht zur Anwendung. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_b41bd73a;
  skos:prefLabel "Spitzfase"@de;
  skos:broader :c_bc58b851;
  dct:created "2019-06-18T09:48:47.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:11:59.000"^^xsd:dateTime .

:c_8e5c0176 a skos:Concept;
  skos:definition "Die von Setz- und Querholz gebildete Teilung eines Fensters, Kreuzstock. [Koepf / Binding 2016]"@de,
    "Pfosten und Querholz bilden den Kreuzstock, auch Fensterkreuz genannt. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_c7b144d0, :conceptScheme_b41bd73a;
  skos:prefLabel "Kreuzstock"@de, "okenní mříž"@cs;
  skos:altLabel "Fensterkreuz"@de;
  skos:broader :c_8ddac41d;
  dct:created "2019-06-13T15:54:45.000"^^xsd:dateTime;
  dct:modified "2020-09-14T12:36:52.000"^^xsd:dateTime .

:c_559aa52a a skos:Concept;
  skos:definition "(1) Handelsname für ein spezielles gegossenes Ornamentglas. (2) Modernes farbiges Gussglas mit bewusst herbeigeführten Schlieren, um den Eindruck von altem, mundgeblasenem Glas herbeizuführen. [Schrader / Voigt 2003]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_5bf6bcac;
  skos:prefLabel "altdeutsches Glas"@de;
  skos:broader :c_efeb2340, :c_0c16593b;
  dct:created "2020-11-20T17:38:03.000"^^xsd:dateTime;
  dct:modified "2020-11-20T17:41:37.000"^^xsd:dateTime .

:c_3244cac9 a skos:Concept;
  skos:definition "Ein am rechten Flügel angebrachter, drehbarer Riegel wird zum Verschließen in das am linken Flügel befindliche Winkelstück gelegt, welches am senkrechten Teil nach unten stärker wird. Dadurch werden beide Flügel aneinander gezogen. Die Ruderverriegelung tritt nur mit dem aufgehenden Pfosten auf. Der rechte Flügel wird am linken gehalten, der mit Schubriegeln oder Einreibern am Unterschenkel des Fensterrahmens und am Querholz arretiert wird. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Ruderverriegelung"@de;
  skos:broader :c_d936f79a;
  dct:created "2019-06-13T17:05:16.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:42:44.000"^^xsd:dateTime .

:c_93b9ef28 a skos:Concept;
  skos:definition "Beschlag zum Feststellen des v. i. linken Flügels bei Fenstern mit aufgehendem Pfosten und Reibern oder Ruderverriegelung. Am oberen und unteren Ende des v. i. rechten Höhenschenkel des linken Flügels sind sie auf das Holz aufgesetzt oder in das Holz eingelassen und werden in Ausnehmungen im Querholz und an Ober- und / oder Unterschenkel des Fensterrahmens geschoben. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Schubriegel"@de;
  skos:altLabel "Schubstange"@de;
  skos:broader :c_d936f79a;
  dct:created "2019-06-13T17:10:33.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:42:54.000"^^xsd:dateTime .

:c_d4b29125 a skos:Concept;
  skos:definition "Haken innen an den Höhenschenkeln des Futterrahmens oder außen an den Höhen der Laibung bzw. des Werksteinrahmens, der in eine Öse am Fensterrahmen gesteckt wird und dem Fenster als Befestigung in der Fensteröffnung dient. I. d. R. wird ein Fenster mit vier Kettelhaken befestigt. Winterfenster werden nur mit Kettelhaken befestigt, da es eine leicht lösbare Befestigung ist. Der Haken läuft konisch in der Spitze aus und zieht so das Fenster relativ dicht in die Öffnung. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0,
    :conceptScheme_b41bd73a;
  skos:prefLabel "Kettelhaken"@de;
  skos:altLabel "Ankettel"@de;
  skos:broader :c_d936f79a;
  dct:created "2019-06-18T07:04:52.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:41:53.000"^^xsd:dateTime .

:c_d13900ea a skos:Concept;
  skos:definition "Metallblech oder Metalldraht, der in das Flügelholz aufgeschraubt oder eingeschlagen wird (ähnlich Streichdraht). [Pax - Fenster & Türen Fachbegriffe]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0;
  skos:prefLabel "Streichblech"@de;
  skos:broader :c_d936f79a;
  dct:created "2019-06-18T09:35:42.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:43:04.000"^^xsd:dateTime .

:c_30ea41d0 a skos:Concept;
  skos:definition "Fensterform des späten 19. Jh., aus dem Fenster mit Kreuzstock entwickelt. Ein ungeteiltes Oberlicht liegt über zwei Flügeln mit aufgehendem Pfosten. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Galgenfenster"@de;
  skos:broader :c_f88a153a;
  dct:created "2019-06-17T11:58:30.000"^^xsd:dateTime;
  dct:modified "2020-02-18T08:45:51.000"^^xsd:dateTime;
  :broaderByConstruction :c_f88a153a .

:c_6813f346 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe;
  skos:prefLabel "Maßwerkbrüstung"@de;
  skos:broader :c_ad4ce2d6;
  dct:created "2020-10-12T11:41:17.000"^^xsd:dateTime;
  dct:modified "2021-01-22T17:47:12.000"^^xsd:dateTime .

:c_96306b6f a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_50ec0c5e;
  skos:prefLabel "Brüstungsgitter"@de;
  skos:broader :c_ad4ce2d6, :c_3b768083;
  dct:created "2020-10-19T11:21:22.000"^^xsd:dateTime;
  dct:modified "2021-01-30T23:25:34.000"^^xsd:dateTime;
  :broaderByPosition :c_3b768083 .

:c_6cc290c4 a skos:Concept;
  skos:definition "Form des Fensters mit zwei Querhölzern. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Fenster mit Mittelflügel"@de;
  skos:broader :c_f88a153a;
  dct:created "2019-06-17T14:43:52.000"^^xsd:dateTime;
  dct:modified "2020-02-18T08:46:56.000"^^xsd:dateTime;
  :broaderByConstruction :c_f88a153a .

:c_16cba33a a skos:Concept;
  skos:definition "Senkrecht verlaufende Halbsprosse. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Höhenhalbsprosse"@de;
  skos:broader :c_8fc063d3;
  dct:created "2019-06-17T17:40:04.000"^^xsd:dateTime;
  dct:modified "2019-06-17T17:40:48.000"^^xsd:dateTime .

:c_d189402d a skos:Concept;
  skos:definition "Waagrechte Halbsprosse. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Querhalbsprosse"@de;
  skos:broader :c_8fc063d3;
  dct:created "2019-06-18T08:29:39.000"^^xsd:dateTime;
  dct:modified "2019-06-18T08:30:11.000"^^xsd:dateTime .

:c_8030b9c8 a skos:Concept;
  skos:definition "Der zur Betätigung von Fensterverschlüssen häufig gebrauchte, o.nförmige Drehknauf, d.h. ein Handgriff, mit dem die zum Öffnen und Schließen erforderl. Drehung des Gestänges oder des Fallriegels ausgeführt wird. [Koepf/Binding 2016]"@de,
    "Bezeichnung für den Drehgriff der Basküle. Die Griffe haben oftmals die Form einer Olive, daher der Name. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0,
    :conceptScheme_b41bd73a;
  skos:prefLabel "Olive"@de, " oliva"@es, " oliva"@it, " (bouton en) olive"@fr, " olive"@en;
  skos:broader :c_ff863922;
  dct:created "2019-06-17T16:07:36.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:49:57.000"^^xsd:dateTime .

:c_b5316a89 a skos:Concept;
  skos:definition "Sonderform des Schiebefensters, dessen bewegl. Flügel gegen einen meist feststehenden oberen Teil gehoben und festgestellt wird. [Koepf / Binding 2016]"@de,
    "Fenstertyp, bei dem die gesamte untere Hälfte als Hebeflügel vor die obere geschoben werden kann. Die Form ist, von Holland kommend, vorwiegend in Norddeutschland zu finden. Sie tritt im 18. Jh. auf, aber aufgrund der aufwendigen Konstruktion nur in anspruchsvolleren Gebäuden. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_b41bd73a;
  skos:prefLabel "Hebefenster"@de;
  skos:broader :c_f88a153a;
  dct:created "2019-06-17T17:07:37.000"^^xsd:dateTime;
  dct:modified "2020-09-30T11:01:21.000"^^xsd:dateTime;
  :broaderByConstruction :c_f88a153a .

:c_47db91c5 a skos:Concept;
  skos:scopeNote "Senkrechte Hölzer eines Fenster- oder Flügelrahmens."@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0,
    :conceptScheme_b41bd73a;
  skos:prefLabel "Höhenschenkel"@de, " profili della finestra"@it;
  skos:altLabel "maderos del bastidor de una ventana"@es, "Höhen"@de;
  skos:broader :c_d344a51a;
  dct:created "2019-06-17T17:34:46.000"^^xsd:dateTime;
  dct:modified "2020-11-25T08:49:34.000"^^xsd:dateTime .

:c_e4dee1e3 a skos:Concept;
  skos:scopeNote "Oberbegriff für die waagrechten Hölzer eines Fenster- oder Flügelrahmens. "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0;
  skos:prefLabel "Weiten"@de;
  skos:broader :c_d344a51a;
