:c_9c8e3465 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_57be8ee8, :conceptScheme_ec8c77bf;
  skos:prefLabel "arriccio"@en, "arriccio"@cs, "Arriccio"@de;
  skos:altLabel "Rauputz"@de, "Grobputz"@de, "Unterputz"@de, "Grundputz"@de, "rough coat"@en;
  skos:note "A relatively coarse plaster coat applied before the last plaster layer, the intonaco, for levelling the unevenness of the support. [EwaGlos]"@en,
    "Eine relativ grobe Putzlage, die unter dem Intonaco liegt und Unebenheiten des Trägers ausgleichen soll. [EwaGlos]"@de;
  skos:broader :c_3f0545b6, :c_wdriolje;
  dct:created "2019-07-19T22:31:53.000"^^xsd:dateTime;
  dct:modified "2021-01-25T15:51:14.000"^^xsd:dateTime .

:c_f6504380 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_57be8ee8, :conceptScheme_ec8c77bf;
  skos:prefLabel "intonaco"@en, "intonaco"@cs, "Intonaco"@de;
  skos:altLabel "Feinputz"@de, "Oberputz"@de, "Sichtputz"@de, "Deckputz"@de, "final rending"@en,
    "plaster finish"@en;
  skos:note "The last, fine-grained, thin and well-evened layer of plaster on which the wall painting is applied in fresco technique. [EwaGlos]"@en,
    "Die letzte, feinkörnige, dünne, stark geglättete Putzlage, auf der ein Fresko aufgetragen wird. [EwaGlos]"@de;
  skos:broader :c_3f0545b6, :c_wdriolje;
  dct:created "2019-07-19T22:42:56.000"^^xsd:dateTime;
  dct:modified "2021-01-25T15:53:09.000"^^xsd:dateTime .

:c_d8ed0f8f a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_ec8c77bf;
  skos:prefLabel "Pontata"@de, "pontata"@en;
  skos:altLabel "Gerüstgrenze"@de, "Putzgrenze"@de, "Putznaht"@de;
  skos:note "A wide area of plaster applied at the same high as the scaffolding, leaving horizontal seams in the finished work. [EwaGlos]"@en,
    "Eine große Putzfläche, die auf derselben Ebene wie eine Gerüstlage verläuft und nach der Fertigstellung horizontale Putznähte hinterlässt. [EwaGlos]"@de;
  skos:broader :c_69129c1b, :c_8c8249bf;
  dct:created "2019-07-19T22:36:01.000"^^xsd:dateTime;
  dct:modified "2021-01-29T13:53:43.000"^^xsd:dateTime .

:c_263ec86c a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_ec8c77bf;
  skos:prefLabel "Giornata"@de, "giornata"@en;
  skos:altLabel "Tagwerk"@de, "Tagewerk"@de;
  skos:note "An area of fresh plaster (intonaco) applied as one part of a fresco. [EwaGlos]"@en,
    "Ein Bereich frischen Oberputzes (lntonaco), der als ein Teil eines Freskos auf den Arriccio aufgetragen wird. [EwaGlos]"@de;
  skos:broader :c_69129c1b, :c_8c8249bf;
  dct:created "2019-07-19T22:47:33.000"^^xsd:dateTime;
  dct:modified "2021-01-29T13:54:57.000"^^xsd:dateTime .

:c_6e8d8528 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_ec8c77bf;
  skos:prefLabel "final render"@en, "hladká omítka"@cs, "Feinputz"@de;
  skos:altLabel "Oberputz"@de, "Glättputzschicht"@de, "skim"@en, "finish coat"@en;
  skos:note "Last layer of coating for exterior architectural surfaces with a protective as well as a decorative function. [EwaGlos]"@en,
    "Die letzte Putzschicht auf einer Architekturoberfläche im Außenraum mit einer sowohl schützenden als auch dekorativen Funktion. [EwaGlos]"@de,
    "Putz, der auf einem Unterputz aufgetragen wird und eine feinkörnige Struktur der Zuschlagstoffe aufweist. [Koepf / Binding 2016]"@de;
  skos:broader :c_wdriolje;
  dct:created "2019-07-19T22:51:03.000"^^xsd:dateTime;
  dct:modified "2021-01-25T15:52:47.000"^^xsd:dateTime .

