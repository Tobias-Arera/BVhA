:c_d61dc0e6 a skos:Concept;
  skos:definition "Weihekreuz n; Konsekrationskreuz n; Iat. crux signata: ein Kreuz, das aus gebogenen Linien gebildet wird und von einem Kreis umschrieben ist. Es ist das Zeichen der vollzogenen Weihe und findet sich z. B. in der Mensa des Altares, an liturgischen Geräten und an den Apostelleuchtern, wo es präzis. auch Apostelkreuz (n) heißt. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "crux signata"@la, "croix de consécration"@fr, "konsekrační kříž"@cs,
    "croce di consacrazione"@it, "consecration-cross"@en, "Weihekreuz"@de;
  skos:altLabel "Konsekraktionskreuz"@de;
  skos:broader :c_c10d78d5, :c_d4265c6a;
  skos:narrower :c_4c22c6c2;
  skos:related :c_c0557847;
  dct:created "2020-02-05T18:03:11.000"^^xsd:dateTime;
  dct:modified "2021-01-27T20:48:59.000"^^xsd:dateTime;
  :broaderByFunction :c_c10d78d5 .

:c_c0557847 a skos:Concept;
  skos:definition "An den 12 Stellen, an denen katholische Kirchen bei ihrer Weihe gesalbt werden, sind zur Erinnerung an die 12 Apostel 12 Kreuze und 12 Wandleuchter angebracht, die gelegentlich Apostelbildnisse tragen. [Koch 2009]"@de,
    "Apostelleuchter nennt man die meist aus Metall gefertigten, mitunter beweglichen Wandleuchter, die über, unter und noch häufiger mitten in den Weihekreuzen angebracht sind und bei der Kirchweihe sowie an ihrem Jahrestag brennende Kerzen tragen. [RDK Labor]"@de,
    "Apostel leuchter m; auch Weiheleuchter m: ein Wandleuchter vor einem der zwölf Weihekreuze in einer Kirche, welches häufig das Bild eines Apostels zeigt. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9, :conceptScheme_1f14b4dd, :conceptScheme_cf792a3c;
  skos:prefLabel "Apostelleuchter"@de, "candelabro di consacrazione"@it, "apoštolský svícen"@cs,
    "chandelier de consécration"@fr, "consecration candlestick"@en;
  skos:altLabel "apostle candlestick"@en, "applique de consécration"@fr, "Weiheleuchter"@de;
  skos:broader :c_0dc5882f;
  skos:related :c_d61dc0e6, :c_4c22c6c2;
  dct:created "2020-02-05T18:03:03.000"^^xsd:dateTime;
  dct:modified "2021-01-30T22:52:36.000"^^xsd:dateTime .

