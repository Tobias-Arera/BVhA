  dct:created "2020-08-11T15:25:45.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:15:18.000"^^xsd:dateTime .

:c_7cfd7314 a skos:Concept;
  skos:definition "Stirnbrett, Brett ander Giebelseite, das die Dachdeckung.(Legschindel, Pfannen) gegen Windangriff schützt. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_167cb98f;
  skos:prefLabel "bordure de pignon"@fr, "gableboard"@en, "Windbrett"@de, "saledizo"@es;
