    "ranura"@es;
  skos:altLabel "žlábek"@cs, "slot"@en, "rýha"@cs, "femmina"@it, "acanaladura"@es, "mortice"@en;
  skos:broader :c_78eff904;
  dct:created "2019-05-22T12:29:13.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:18:10.000"^^xsd:dateTime .

