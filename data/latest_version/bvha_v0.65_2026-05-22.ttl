  skos:broader :c_1a0d89ef, :c_bba082cf;
  skos:narrower :c_d429307b, :c_6a121d5e, :c_a5fccf1b, :c_930698bf, :c_4d73864a;
  dct:created "2020-01-29T09:44:32.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:54:41.000"^^xsd:dateTime .

:c_6a121d5e a skos:Concept;
  skos:definition "Eine nur zu einem kleinen Teil in die rückwärtige Mauer oder den Pfeilerkern eingebundene Säule. [Koepf / Binding 2016]"@de,
    "Sloup, který vystupuje pouze ze tří čtvrtin z jádra pilíře nebo stěny. [Koch 2008]"@cs,
    "Säule (Dienst), die nur zu Dreivierteln aus Pfeilerkern oder Wand hervortritt. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "Dreiviertelsäule"@de, "tříčtvrteční sloup"@cs;
  skos:broader :c_8c13d696, :c_f415b5e9;
  dct:created "2020-05-18T14:48:13.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:56:44.000"^^xsd:dateTime .

:c_9caf0994 a skos:Concept;
  skos:definition "Bauwerkecken-Verstärkung aus Quadern. [Koch 2009]"@de, "1. Zesílení rohů stavby z kvádrů, 2. Zdivo. [Koch 2008] "@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9;
  skos:prefLabel "Bossenwerk"@de, "bosáž"@cs;
