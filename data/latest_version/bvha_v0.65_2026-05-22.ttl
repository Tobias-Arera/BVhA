:c_f6c108c4 a skos:Concept;
  skos:definition "Eine Sonderform zwischen Spitzeisen und Zahneisen ist der zweizahnige »Hundszahn« zur Bearbeitung von weichem Sandstein. Seit wann dieses Eisen eingesetzt wurde, kann nicht nachgewiesen werden. [Voelkle 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_f10222e0;
  skos:prefLabel "Hundszahn (Werkzeug)"@de;
  skos:broader :c_ffc581ab;
  dct:created "2019-12-03T14:28:17.000"^^xsd:dateTime;
  dct:modified "2019-12-03T14:32:50.000"^^xsd:dateTime .

:c_4edb6be0 a skos:Concept;
  skos:definition "Die veränderliche oder bewegliche Belastung des Bauteils (z.B. Personen, Einrichtungsstücke, Lagerstoffe, Riemenantriebe, Kranlasten, Wind und Schnee). [BVHA]"@de,
    "Die aus Kräften und Gewichten resultierende Last, die nur vorübergehend wirksam ist, z.B. durch Witterungseinflüsse, verkehrsbedingte Erschütterungen oder Arbeiten am Gebäude. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_1f14b4dd;
  skos:prefLabel "life load"@en, "charge variable"@fr, "Verkehrslast"@de;
  skos:altLabel "Nutzlast"@de, "Lebende Last"@de, "charge roulante"@fr;
  skos:broader :c_6ee54738;
  dct:created "2019-10-01T09:56:51.000"^^xsd:dateTime;
  dct:modified "2020-03-05T18:42:49.000"^^xsd:dateTime .

:c_35f80b69 a skos:Concept;
  skos:definition "Die Summe der unveränderlichen Lasten. Das Gewicht der tragenden oder stützenden Bauteile und die unveränderlichen, von den tragenden Bauteilen dauernd aufzunehmenden Lasten, z.B. Auffüllungen, Fußbodenbeläge, Putz usw."@de;
  skos:inScheme :conceptScheme_7816b346;
  skos:prefLabel "ständige Laste"@de;
  skos:broader :c_6ee54738;
  skos:narrower :c_8c67a8cc, :c_e956df25;
  dct:created "2019-10-01T09:59:33.000"^^xsd:dateTime;
  dct:modified "2020-05-20T11:19:39.000"^^xsd:dateTime .

