  skos:altLabel "Fallgitter"@de;
  skos:broader :c_dd883e1f, :c_3b768083;
  dct:created "2020-08-05T09:27:24.000"^^xsd:dateTime;
  dct:modified "2021-01-25T17:45:56.000"^^xsd:dateTime .

