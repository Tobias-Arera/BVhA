  skos:broader :c_aced96c4, :c_c22ee248;
  skos:related :c_30831661, :c_a3e668d3;
  dct:created "2020-08-07T08:56:03.000"^^xsd:dateTime;
  dct:modified "2021-01-24T15:04:31.000"^^xsd:dateTime .

:c_16fcb1c4 a skos:Concept;
  skos:definition "Altarleinen n pl; veraltet Altarlinnen n pl: Bezeichnung für die aus Leinen gefertigten Paramente, die für den Altar und das liturgische Gerät bei der Meßfeier bestimmt sind. Dazu gehören Altartücher, Korporale, Palla, Purifikatorium und Lavabotüchlein. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
