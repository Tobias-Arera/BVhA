:c_db764c30 a skos:Concept;
  skos:definition "Abseite, seitl., meist zu beiden Seiten des Mittelschiffs angeordnete Raumteile, durch Wandöffnungen (Arkaden und dergl.) mit Letzterem verbunden. [Koepf / Binding 2016]"@de,
    "Část chrámového prostoru, která probíhá paralelně se střední lodí a je do ní (případně do dalších sousedních lodí) otevřena. [Koch 2008]"@cs,
    "Abseite, Raumteil, der parallel zum Mittelschiff verläuft und zu diesem (und evtl. weiteren, benachbarten Seitenschiffen) geöffnet ist. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "nau lateral"@ca, "side aisle"@en, "boční loď"@cs, "Seitenschiff"@de,
    "nave lateral"@es, "bas-côté"@fr, "navata laterale"@it;
  skos:altLabel "basse-nef"@en, "nef latérale"@fr, "postranní lod\\'"@cs;
