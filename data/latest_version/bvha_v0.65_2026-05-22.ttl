:c_5e718832 a skos:Concept;
  skos:definition "Kardinal m; lat. cardinalis: Vorsteher einer Hauptkirche, höchster kath. Würdenträger nach dem Papst, von dem er ernannt wird und zu dessen engsten Ratgebern er gehört. Seine Rangfarbe ist Rot bzw. Purpur. Das Kollegium der Kardinäle wählt seit 1059 den Papst. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "cardinal"@en, "Kardinal"@de, "cardinal"@fr, "cardinalis"@la;
