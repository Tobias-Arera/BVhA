:c_bb677c47 a skos:Concept;
  skos:definition " Gewölbe mit paarweise gleichlaufenden Rippen (Parallelrippen), gehört als Untergruppe zu den Netzgewölben. [Koepf/Binding 2016]"@de,
    "Gewölbe mit paarweise gleichlaufenden Rippen. Dieser Figuration liegt ein System von Rippendreistrahlen zugrunde. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "Parallelrippengewölbe"@de, "bóveda nervada en paralelo"@es, " volta reticolare a nervature binate"@it,
    "voûte à nervures parallèles"@fr, " vault with parallel ribs  "@en;
  skos:altLabel "parallel ribbed vault"@en;
  skos:broader :c_b505b3b9;
  dct:created "2019-10-29T13:21:11.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:49:48.000"^^xsd:dateTime;
  :broaderByShape :c_b505b3b9 .

:c_f4435c09 a skos:Concept;
  skos:definition "Gewölbe mit parallel verlaufenden, schräg zur Längsachse des Raumes ausgerichteten Rippen. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_1f14b4dd;
  skos:prefLabel "Diagonalrippengewölbe"@de, "voûte à nervures diagonales"@fr, "diagonal-ribbed vault"@en;
  skos:altLabel "diagonal and cross ribbing"@en;
  skos:broader :c_b505b3b9;
  dct:created "2019-10-29T13:25:11.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:45:57.000"^^xsd:dateTime;
  :broaderByShape :c_b505b3b9 .

:c_930ad2e3 a skos:Concept;
  skos:definition "Gewölbe, in dem die Rippen strahlenförmig vom SchIussstein oder auch vom offenen Scheitelring ausgehen bzw. auf ihn hinführen. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "voûte à nervures rayonnantes"@fr, "radiating ribbed vault"@en, "Radialrippengewölbe"@de;
  skos:altLabel "voûte d\\'ogives a quartiers rayonnants"@fr;
  skos:broader :c_b505b3b9;
  dct:created "2019-10-29T14:06:51.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:50:02.000"^^xsd:dateTime;
  :broaderByShape :c_b505b3b9 .

:c_4c8f5392 a skos:Concept;
  skos:definition "Gewölbe mit einer durchlaufenden, häufig besonders akzentuierten Rippe unter dem Gewölbescheitel. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "vault with a continuous ridge rib"@en, "voûte à nervure faîtière continue"@fr,
    "Scheitelrippengewölbe"@de;
  skos:altLabel "voûte à lierne"@fr;
  skos:broader :c_b505b3b9;
  dct:created "2019-10-29T14:19:02.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:50:15.000"^^xsd:dateTime;
  :broaderByShape :c_b505b3b9 .

:c_4d7d769a a skos:Concept;
  skos:definition "Blockkonsolen können entweder ein- oder beidseitig sich verbreiternde Stummelwände oder auskragende Eck- oder Binnenvorstöße sein. [Eißing et al. 2012]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_167cb98f, :conceptScheme_19d56a39;
  skos:prefLabel "Blockkonsole"@de;
  skos:broader :c_1cb81a92, :c_nskxcexd;
  skos:narrower :c_f8153b86, :c_922cfdf7;
  dct:created "2019-11-04T16:12:11.000"^^xsd:dateTime;
  dct:modified "2021-01-25T18:24:50.000"^^xsd:dateTime;
  :broaderByConstruction :c_nskxcexd .

:c_a1edf052 a skos:Concept;
  skos:definition "Stummelwände sind beidseitig vorstoßende Querhölzer im Giebelfeld, die bei fehlenden Binnenwänden die Giebelwand stabilisieren. [Eißing et al. 2012]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_167cb98f,
    :conceptScheme_19d56a39;
  skos:prefLabel "Stummelwand"@de;
  skos:broader :c_1cb81a92;
  dct:created "2019-11-04T16:03:31.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:59:31.000"^^xsd:dateTime;
  :broaderByFunction :c_1cb81a92;
  :broaderByPosition :c_1cb81a92 .

:c_f8153b86 a skos:Concept;
  skos:scopeNote "Blockkonsolen, auf denen Pfetten ruhen. [BVHA]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_167cb98f, :conceptScheme_19d56a39;
  skos:prefLabel "Pfettenkonsole"@de;
  skos:broader :c_4d7d769a;
  dct:created "2019-11-04T16:15:02.000"^^xsd:dateTime;
  dct:modified "2021-01-25T18:25:14.000"^^xsd:dateTime;
  :broaderByFunction :c_4d7d769a .

:c_922cfdf7 a skos:Concept;
  skos:definition "Blockkonsolen, auf denen die Bohlen der Lauben ruhen. [BVHA]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_167cb98f, :conceptScheme_19d56a39;
  skos:prefLabel "Laubenkonsole"@de;
  skos:broader :c_4d7d769a;
  dct:created "2019-11-04T16:15:15.000"^^xsd:dateTime;
  dct:modified "2021-01-25T18:25:02.000"^^xsd:dateTime;
  :broaderByFunction :c_4d7d769a .

:c_bf3bffa7 a skos:Concept;
  skos:definition "Der Mantel-/Schalenständer ist ein wandhohes, vertikal in die Block- oder Bohlenwand eingestelltes Holz, welches beidseitig mit Mantelschalen die Balken- oder Bohlenköpfe umfasst. Seine Funktion entspricht entweder jener der Blockzange oder der eines Verbindungselementes bei der nachträglichen Verlängerung oder Reparatur einer Blockwand. [Eißing et al. 2012]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_167cb98f,
    :conceptScheme_19d56a39;
  skos:prefLabel "Mantelständer"@de;
  skos:altLabel "Schalenständer"@de;
  skos:broader :c_1cb81a92;
  dct:created "2019-11-04T16:18:08.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:54:15.000"^^xsd:dateTime;
  :broaderByFunction :c_1cb81a92;
  :broaderByPosition :c_1cb81a92 .

:c_1e175a99 a skos:Concept;
  skos:definition "Mantelstiele umfassen in der Regel einseitig Balken oder Balkenköpfe im Bereich von Tür- und Fensteröffnungen (bei Türöffnungen regional als Mantelstud bezeichnet). [Eißing et al. 2012]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_167cb98f,
    :conceptScheme_19d56a39;
  skos:prefLabel "Mantelstiel"@de;
  skos:broader :c_1cb81a92;
  dct:created "2019-11-04T16:25:38.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:55:50.000"^^xsd:dateTime;
  :broaderByFunction :c_1cb81a92;
  :broaderByPosition :c_1cb81a92 .

:c_46eacad9 a skos:Concept;
  skos:definition "Im Gegensatz dazu [zum Mantelständer] steht der eingebundene Ständer (wandhoch) mit Nut, der in gleicher Stärke wie die Blockwand ausgebildet ist. An den Balkenköpfen sind Zapfen angeschnitten, die von der Nut des Ständers umfasst werden. [Eißing et al. 2012]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_167cb98f,
    :conceptScheme_19d56a39;
  skos:prefLabel "eingebundener Ständer"@de;
  skos:broader :c_1cb81a92;
  dct:created "2019-11-04T16:28:17.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:51:04.000"^^xsd:dateTime;
  :broaderByFunction :c_1cb81a92;
  :broaderByPosition :c_1cb81a92 .

:c_715a9434 a skos:Concept;
  skos:definition "Im Gegensatz dazu [zum Mantelstiel] steht der eingebundene Stiel (nicht wandhoch) mit Nut, der in gleicher Stärke wie die Blockwand ausgebildet ist. An den Balkenköpfen sind Zapfen angeschnitten, die von der Nut des Stiels umfasst werden. [Eißing et al. 2012]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_167cb98f,
    :conceptScheme_19d56a39;
  skos:prefLabel "eingebundener Stiel"@de;
  skos:broader :c_1cb81a92;
  dct:created "2019-11-04T16:28:35.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:52:41.000"^^xsd:dateTime;
  :broaderByFunction :c_1cb81a92;
  :broaderByPosition :c_1cb81a92 .

:c_ce7c7e46 a skos:Concept;
  skos:definition "Blockzangen kommen in der Regel beim offenen Blockbau vor. Sie bestehen entweder aus zwei Kanthölzern oder Hälblingen, die als Schwerter gearbeitet sind und mithilfe von durch die Wand greifenden Schlossbohlen (Zungen) verklammert werden. In einer weiteren Variante können Kanthölzer und Hälblinge mit durchgezapften Holzbolzen verklammert und mit Keilen verankert sein. [Eißing et al. 2012]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_167cb98f,
    :conceptScheme_19d56a39;
  skos:prefLabel "Blockzange"@de;
  skos:broader :c_1cb81a92;
  dct:created "2019-11-04T16:34:08.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:49:01.000"^^xsd:dateTime;
  :broaderByFunction :c_1cb81a92 .

:c_055744a7 a skos:Concept;
  skos:scopeNote "Bohle zur Verklammerung der Blockzange. [BVHA]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_167cb98f,
    :conceptScheme_19d56a39;
  skos:prefLabel "Schlossbohle"@de;
  skos:altLabel "Zunge"@de;
  skos:broader :c_1cb81a92;
  dct:created "2019-11-04T16:35:39.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:58:05.000"^^xsd:dateTime;
  :broaderByFunction :c_1cb81a92 .

:c_7c401fa2 a skos:Concept;
  skos:scopeNote "Blockkränze, auf denen oder in deren Nuten die Deckenbohlen  eingelegt werden. [BVHA]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_167cb98f,
    :conceptScheme_19d56a39;
  skos:prefLabel "Deckenblockkranz"@de;
  skos:broader :c_f2a5513e;
  dct:created "2019-11-04T18:07:14.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:44:30.000"^^xsd:dateTime;
  :broaderByFunction :c_f2a5513e;
  :broaderByPosition :c_f2a5513e .

:c_08cf2739 a skos:Concept;
  skos:definition "Boden- bzw. Deckenbohlen werden entweder fassadensichtig auf die Deckenblockkränze verlegt oder in Nuten derselben eingeschoben. Bei Letzterem wird eine keilförmige Bohle (Schließbohle, Keilladen) von außen durch eine Öffnung im Deckenblockholz eingetrieben und verspannt die bereits verlegten Deckenbohlen. Das Ende der Schließbohle kann außen aus der Wand vorstehend belassen werden oder es wird abgesägt und die Öffnung im Blockholz verschlossen oder sichtbar gelassen. [Eißing et al. 2012]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_167cb98f,
    :conceptScheme_19d56a39;
  skos:prefLabel "Schließbohle"@de;
  skos:altLabel "Keilladen"@de;
  skos:broader :c_1cb81a92;
  dct:created "2019-11-04T18:16:18.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:57:13.000"^^xsd:dateTime;
  :broaderByFunction :c_1cb81a92 .

:c_20ecde3f a skos:Concept;
  skos:definition "Gerüst mit starken Verstrebungen, an dem die Glocken in einem Turm aufgehängt sind. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "Glockenstuhl"@de;
  skos:broader :c_98f15e72;
  dct:created "2020-09-29T14:43:26.000"^^xsd:dateTime;
  dct:modified "2021-03-20T00:18:05.000"^^xsd:dateTime .

