:c_d5a7eaef a skos:Concept;
  skos:definition "Burgen der großen Landesherren (Bischöfe, Herzöge, Fürsten) in den sich seit dem Spätmittelalter festigenden Territorien, die Zentren der Verwaltung und der politisch-militärischen Herrschaftsausübung, aber auch kulturelle Mittelpunkte waren, meist gleichbedeutend mit Landesburgen (z. B. die Burgen des Erzbischofs Balduin von Trier im 14. Jh.). Viele dieser oft repräsentativ ausgebauten landesherrlichen Burgen dienten gleichzeitig als Residenzburgen, konnten aber auch einfache Amtsburgen sein. H. W. B. [Wörterbuch der Burgen, Schlösser und Festungen]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_50ec0c5e,
    :conceptScheme_1d7ba54b;
  skos:prefLabel "Territorialburg"@de;
  skos:broader :c_f8146cf8;
  dct:created "2020-04-28T17:10:50.000"^^xsd:dateTime;
  dct:modified "2021-01-27T11:03:55.000"^^xsd:dateTime;
  :broaderByFunction :c_f8146cf8 .

:c_3c42853f a skos:Concept;
  skos:definition "Terasa se zábradlím a venkovním schodištěm po celé šíři čela domu na uliční straně. V Pobaltí, zvl. v Gdaňsku nahradilo zahradu městského domu a chránilo přízemí a vchod do domu před záplavami. [Koch 2008]"@cs,
    "Terrasse mit Brüstung und Freitreppe in der ganzen Frontbreite des Hauses an der Straßenseite. Ersetzt im Ostseeraum den Garten des Stadthauses und schützt Erdgeschoss und Hauseingang mit Diele vor Überschwemmungen. [Koch 2009]"@de,
    "Beischlag, als Sitze ausgebildete Wangen der drei- bis vierstufigen Freitreppe vor dem städt. Wohnhaus in Norddeutschland, Ostseeraum, Schweiz, Niederlanden, Böhmen, seit Ende des 14. Jhs. urkundl. nachgewiesen, im 15. Jh. voll ausgebildet mit hohen, stelenartigen Pfosten an der Stirnseite, zur Straße hin mit Reliefs verziert. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_c8a571d9, :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "Beischlag"@de, "zápraží"@cs;
  skos:broader :c_0cfd9e60;
  dct:created "2020-08-03T14:59:38.000"^^xsd:dateTime;
  dct:modified "2021-01-27T01:11:12.000"^^xsd:dateTime .

:c_fd2f0212 a skos:Concept;
  skos:definition "Zu angenehmem Aufenthalt ausgestaltetes Flachdach, oft mit Kübelpflanzen und Blumenschalen belebt und fälschl. Dachgarten genannt. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_c8a571d9;
  skos:prefLabel "Dachterrasse"@de, "střešní terasa"@cs;
  skos:broader :c_0cfd9e60;
  dct:created "2020-09-01T10:00:10.000"^^xsd:dateTime;
  dct:modified "2021-01-27T01:11:27.000"^^xsd:dateTime .

