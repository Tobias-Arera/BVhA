:c_05cd53cd a skos:Concept;
  skos:definition "Die dem Kämpfer zugeordneten Teile eines Tonnengewölbes, aus denen ein Klostergewölbe zusammengesetzt ist. [Koepf / Binding 2016]"@de,
    "Ein dreieckiger Ausschnitt aus einer zylindrischen Wölbfläche mitdurchgehendem Auflager. Vier Gewölbewangen bilden das Klostergewölbein seiner Grundform. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "Gewölbewange"@de, "zanca"@es, "fuso"@it, "voûtain en arêtes rentrantes"@fr,
    "cove"@en;
  skos:altLabel "Gewölbewalme"@de;
  skos:broader :c_3e25acca;
  skos:related :c_6b1efaf3;
  dct:created "2019-04-29T23:38:50.000"^^xsd:dateTime;
  dct:modified "2021-01-19T13:26:12.000"^^xsd:dateTime .

