  dct:modified "2021-01-29T10:31:18.000"^^xsd:dateTime .

:c_ff285590 a skos:Concept;
  skos:definition "Diese wurden auf der Baustelle von den Werkleuten mit dem Spitzeisen im Schwerpunkt - meist deutlich in der oberen Hälfte - eingehauen und ermöglichten das Ansetzen der Steinzange. [Voelkle 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_50ec0c5e,
    :conceptScheme_f10222e0;
  skos:prefLabel "Zangenloch"@de, "důlek"@cs;
  skos:broader :c_7f248b0e;
  skos:related :c_daad4519;
  dct:created "2019-05-07T16:15:17.000"^^xsd:dateTime;
  dct:modified "2021-01-27T16:05:31.000"^^xsd:dateTime .

:c_daad4519 a skos:Concept;
  skos:definition "Mittelalterliches Gerät zum Steintransport. Nachdem in der Frühzeit zum Hochziehen der Steine der Wolf benutzt wurde, kam ab etwa 1220 die schon in der Antike bekannte S. im Burgenbau vermehrt zum Einsatz. Sie besteht aus zwei sich kreuzenden, mit einem Gelenkbolzen verbundenen, S-förmig geschmiedeten Greifarmen, die an ihrem oberen Ende mittels eines Kettenglieds an das Tau des Krans gehängt werden konnten und deren untere Enden in zwei vorbereitete Löcher an der Außenseite des Quaders gesteckt wur-den. Beim Aufziehen drückt die Last des Quaders die Zange zu, die erst wieder abge-nommen werden kann, wenn das Kranseil entlastet ist. Die Zangenlöcher bleiben auf der äußeren Quaderseite sichtbar. B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen] "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_f10222e0;
  skos:prefLabel "Steinzange"@de, "kamenické nůžky"@cs;
  skos:broader :c_9303cab6;
  skos:related :c_ff285590;
  dct:created "2019-12-18T16:36:19.000"^^xsd:dateTime;
  dct:modified "2020-07-03T15:42:31.000"^^xsd:dateTime .

:c_d1e4f03e a skos:Concept;
  skos:definition "Schwalbenschwanzförmige Vertiefung im oberen Lager eines Werksteins. [BVHA]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_50ec0c5e,
    :conceptScheme_f10222e0;
  skos:prefLabel "Wolfsloch"@de;
  skos:broader :c_7f248b0e;
  skos:related :c_24dd038b;
  dct:created "2019-05-07T16:15:28.000"^^xsd:dateTime;
  dct:modified "2021-01-27T16:04:52.000"^^xsd:dateTime .

:c_24dd038b a skos:Concept;
  skos:definition "Dreiteiliges Lastaufnahmemittel des Mittelalters. [BHVA]"@de, "Neben der Steinzange das zweite Gerät, mit dem im Mittelalter Steine hochgezogen wurden. Er besteht aus zwei keilförmigen Eisenteilen, die mit einem Mittelstück und einem Eisenbolzen zu einer schwalbenschwanzförmigen Metallklaue verriegelt werden können. Auf der Oberseite der Steine muss ein trapezförmiges Loch geschlagen werden, in das man den W. einführt und justiert. Danach kann der Steinquader an dem Ring, der die Teile des W.s verbindet, hochgezogen werden. Erst nach Entlastung kann der W. wieder aus dem Stein gelöst werden. Mauern, die mit Hilfe eines W.s errichtet wurden, tragen im Gegensatz zu den mit einer Steinzange errichteten keine sichtbaren Löcher. B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_f10222e0;
  skos:prefLabel "Wolf"@de, "vlk"@cs;
  skos:broader :c_9303cab6;
  skos:narrower :c_74269405, :c_b9554cee, :c_cd8b2329;
  skos:related :c_d1e4f03e;
  dct:created "2019-12-18T16:42:35.000"^^xsd:dateTime;
  dct:modified "2020-07-02T15:28:24.000"^^xsd:dateTime .

:c_55027891 a skos:Concept;
  skos:definition "Holes purposely made in a wall to support a suspended scaffolding platform. [EwaGlos]"@en,
    "Kruhové, nebo pravoúhlé otvory ve zdivu sloužící pro lešeňové trámy. [Koch 2008]"@cs,
    "1/2 Stein tiefe Aussparrung im Mauerwerk als Auflage für die Netzriegel des Gerüsts. [Koepf / Binding 2016]"@de,
    "Die Stelle im Mauerwerk, in die ein Gerüstholz während der Bauarbeiten eingelegt wurde; anmittelalterlichen Bauten wurden Rüstlöcher manchmal auch nach Fertigstellung des Gebäudesnicht geschlossen. [Glossarium Artis, Bd. 3, Bögen und Mauerwerk]"@de,
    "Speziell angefertigte, eingetiefte Löcher in einer Wand zum Abstützen einer Gerüstplattform. [EwaGlos]"@de,
    "Im Mauerwerk ausgesparte viereckige Löcher für die Befestigung der Hölzer eines Baugerüsts. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_50ec0c5e, :conceptScheme_37522b74, :conceptScheme_8c0441f9, :conceptScheme_1f14b4dd,
    :conceptScheme_ec8c77bf;
  skos:prefLabel "trou de boulin"@fr, "putlog hole"@en, "Gerüstloch"@de;
  skos:altLabel "Rüstloch"@de, "lešenářské otvory"@cs;
  skos:broader :c_7f248b0e;
  dct:created "2019-07-15T09:40:25.000"^^xsd:dateTime;
  dct:modified "2021-01-27T16:04:22.000"^^xsd:dateTime .

