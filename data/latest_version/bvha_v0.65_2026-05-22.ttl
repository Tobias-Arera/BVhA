:c_0cb8deb1 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_ec8c77bf;
  skos:prefLabel "Mauerziegel"@de, "teja"@es, "tegola"@it, "tuile"@fr, "brick"@en;
  skos:altLabel "Lehmziegel"@de, "Klinker"@de, "Ziegel"@de, "Backstein"@de, "Ziegelstein"@de,
    "Klinkerziegel"@de, "Tonziegel"@de, "ladrillo"@es, "mattone"@it, " brique de mur"@fr,
    "tile"@en;
  skos:note "A manufactured structural unit of clay or shale produced in the form of a rectangular block, either sun-dried or baked (fired), and used as a building material in masonry. [EwaGlos]"@en,
    "Ein aus tonhaltigem Lehm oder Tonschiefer gefertigtes Bauelement in Form eines rechteckigen Blocks, entweder getrocknet oder gebrannt und als Baumaterial für Mauerwerk verwendet. [EwaGlos]"@de,
    "Der aus gebranntem Ton hergestellte Dachziegel: Biberschwanz, Pfannendach, Leistenziegel, Hohlziegel, Krempz„ Falzz. sowie Sonderformen wie Grat-, First und Ortz. (Dachdeckung). Heute häufig fälschl. für Backstein verwandt. [Koepf / Binding 2016]"@de;
  skos:broader :c_5ogzoa7b;
  skos:narrower :c_04e48803, :c_541c2a1f, :c_f7664081, :c_1aa7935c, :c_c862c69f, :c_3cca5a05,
