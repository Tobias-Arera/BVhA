:c_a7b9748b a skos:Concept;
  skos:definition "Es können grundsätzlich zwei verschiedene Typen unterschiedenwerden: Zum einen gab es den halbkugelförmigen Knüpfel. [...] In Nordfrankreich [...] [a]b dem 13. Jahrhundert gibt es zahlreiche Abbildungen, die rund-prismatisch geformte Knüpfel zeigen, manchmal auch zusätzlich in Schlagrichtung gebogen. [Voelkle 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe;
  skos:prefLabel "Knüpfel"@de, "dřevěná palice "@cs;
  skos:altLabel "Klöpfel"@de, "Klopfholz"@de, "Klüpfel"@de, "Klöphl"@sw;
  skos:broader :c_8bda1a91;
  dct:created "2019-09-30T17:35:29.000"^^xsd:dateTime;
  dct:modified "2020-07-03T15:38:34.000"^^xsd:dateTime .

:c_9f577728 a skos:Concept;
  skos:definition "Der Schlägel ist eines der ursprünglichsten und vielfältigsten Werkzeuge und bereits seit der Antike im Einsatz. Benötigt wird er hauptsächlich zum Antreiben von Spitzeisen in allen Größen, bei groben Bossierarbeiten ebenso wie bei feinen Bildhauerarbeiten. Auch das Setzeisen wird mit dem Schlägel geschlagen, auf Hartgestein auch Schlag- oder Beizeisen. [Voelkle 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_f10222e0;
  skos:prefLabel "Fäustel"@de, "perlík"@cs;
  skos:altLabel "Hammer"@de, "Schlägel"@de, "Yseinschlejel"@sw, "eisnein slegel"@sw;
  skos:broader :c_8bda1a91;
  dct:created "2019-09-30T17:35:35.000"^^xsd:dateTime;
  dct:modified "2020-07-10T10:41:57.000"^^xsd:dateTime .

:c_ccc7b5d6 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_f10222e0;
  skos:prefLabel "Spaltkeil"@de;
  skos:broader :c_8bda1a91;
  dct:created "2019-12-03T11:39:12.000"^^xsd:dateTime;
  dct:modified "2019-12-03T11:40:03.000"^^xsd:dateTime .

:c_c95f54cd a skos:Concept;
  skos:definition " [...] glatte oder gezahnte Schneiden mit abgekröpften Enden, entweder beidseitig ausgeschmiedet oder mit einem Holzgriff versehen.Die Schneidebreite beträgt etwa 10 - 30 mm und besitzt 3 - 8 Zähne. Die Besonderheit bei diesem Werkzeug ist, dass es bei der Handhabung mit einer Hand auf die Steinoberflächegedrückt und mit der anderen gezogen wird. Dadurch entstehendie charakteristischen langgezogenen Spuren, die sich vom Einsatz des mit dem Knüpfel vorwärts getriebenen Zahneisens deutlich unterscheiden. [Voelkle 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_f10222e0;
  skos:prefLabel "Schabeisen"@de, "škrabadlo"@cs;
  skos:altLabel "Kratzeisen"@de;
  skos:broader :c_8bda1a91;
  dct:created "2019-12-03T14:38:19.000"^^xsd:dateTime;
  dct:modified "2020-08-24T16:30:51.000"^^xsd:dateTime .

