  dct:created "2019-10-21T11:45:32.000"^^xsd:dateTime;
  dct:modified "2020-10-14T16:29:01.000"^^xsd:dateTime .

:c_5db4dd70 a skos:Concept;
  skos:definition "Triumphsäule, Ehrensäule, eine freistehende monumentale Säule mit Darstellungen aus dem Leben eines röm. Kaisers in spiralförmig angeordneten Reliefbändern. Die T. wurde von einer Statue des Kaisers bekrönt. Im Innern führt eine Wendeltreppe zur oberen Plattform. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "triumphal column"@en, "triumfální sloup"@cs, "colonna commemorativa"@it,
    "columna de triunfo"@es, "Triumphsäule"@de, "colonne de triomphe"@fr;
  skos:altLabel "colonne triomphale"@fr;
  skos:broader :c_acae2ce7;
  dct:created "2019-09-18T21:33:49.000"^^xsd:dateTime;
  dct:modified "2021-01-26T18:10:38.000"^^xsd:dateTime .

