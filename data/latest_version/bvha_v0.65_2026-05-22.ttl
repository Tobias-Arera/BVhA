:c_c2761113 a skos:Concept;
  skos:definition " Ein vor oder in Schießscharten angebrachter, häufig mit Blech beschlagener Holzladen, der sich nach außen öffnet; er wird zumeist von Zapfen, die in Klauen liegen, gehalten und schwingt um die obere horizontale Achse. Er dient zur Deckung der Schützen. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "postigo de una tronera"@es, "mantelletta"@it, "Schartenladen"@de;
  skos:altLabel "Schartenblende"@de, "Schartenschirm"@de;
  skos:broader :c_517345ef;
  dct:created "2020-08-21T09:23:45.000"^^xsd:dateTime;
  dct:modified "2021-01-25T13:06:09.000"^^xsd:dateTime .

