:c_3bry5m4j a skos:Concept;
  skos:definition "Buch, liturgisches n, auch Ritualbuch n, liber de divinis officiis, liber de ritibus ecclesiasticis, liber ritualis: Buch mit den Lesungen, Gebeten, Gesängen und rituellen Anweisungen für den Gottesdienst; oft reich illuminiert und mit kostbarem Bucheinband versehen. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "liturgisches Buch"@de, "liturgická kniha"@cs, "livre liturgique"@fr,
    "liber de divinis officiis"@la, "liturgical book"@en;
  skos:altLabel "liber de ritibus ecclesiasticis"@la, "liber ritualis"@la, "Ritualbuch"@de;
  skos:broader :c_ef163f2f, :c_eee71711;
  skos:narrower :c_6ca61a95;
  skos:related :c_ef753180;
  dct:created "2020-05-20T15:05:40.000"^^xsd:dateTime;
  dct:modified "2021-01-23T16:27:36.000"^^xsd:dateTime .

:c_ne734chh a skos:Concept;
  skos:definition "Kruzifix (lat. crucifixus = der Gekreuzigte), gemalte oder plastische Darstellung Jesu am Kreuz. Crux = Kreuz ohne den Leib Christi. [Koch 2009]"@de,
    "Kruzifix n; gr. estayromenos; lat. crucifixus; crux exemplata: ein Kreuz mit der Darstellung bzw. der plastischen Nachbildung des gekreuzigten Christus. In der karolingischen Kunst wurde Christus als Lebender und Leidender mit geöffneten Augen dargestellt, in ottonischer Kunst seit dem Ende des 10. Jh. dann meist als Toter mit geschlossenen Augen (Beispiel: Gero-Kruzifix, Köln, um 970). [Glossarium Artis]"@de,
    "Lat. crucifixus = ukřižovaný. Malované nebo plastické znázornění Ježíše na kříži, crux = kříž, bez Kristova těla. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9, :conceptScheme_1f14b4dd;
  skos:prefLabel "Kruzifix"@de, "crucifix"@en, "crucifix"@fr, "crucifixus"@la, "estayromenos"@el,
    "krucifix"@cs;
  skos:altLabel "rood"@en, "Kruzifixus"@de, "crux exemplata"@la;
  skos:broader :c_e5eb81f8;
  skos:narrower :c_2d098355, :c_a163d2b0, :c_3d983f36, :c_70415aed, :c_8599e5fd, :c_7a0c7ef3;
  skos:related :c_2e6f0e40;
  dct:created "2020-08-06T11:22:30.000"^^xsd:dateTime;
  dct:modified "2021-01-22T11:23:41.000"^^xsd:dateTime .

