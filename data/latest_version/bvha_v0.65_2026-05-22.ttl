  skos:broader :c_78eff904;
  dct:created "2020-06-23T13:26:11.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:19:56.000"^^xsd:dateTime .

:c_82382511 a skos:Concept;
  skos:definition "Wassernase, Tropfleiste an der vorderen Kante eines Wasserschlags. [Koepf / Binding 2016]"@de,
    "An der Unterseite des Wetterschenkels ausgehobelte Rinne. Daran soll - wie bei einem Gesims - der Wasserfluss gebrochen werden und abtropfen, technisches Profil. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_b41bd73a;
  skos:prefLabel "mouchette"@fr, "okapní nos"@cs, "drip nose"@en, "gronda"@it, "goterón"@es,
    "Tropfnase"@de;
  skos:altLabel "okapnice"@cs, "cavettino"@it, "gocciolatoio"@it, "Wassernase"@de, "Tropfkante"@de,
    "cortagoteras"@es, "splávek"@cs;
  skos:broader :c_78eff904, :c_7039254c;
  dct:created "2020-07-03T15:54:52.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:15:23.000"^^xsd:dateTime .

:c_528a88fc a skos:Concept;
  skos:definition "Stabförmiger, zylindr. Bauteil, hauptsächl. bei Profilen, Rippen, Fenster- und Portalgewänden der Gotik (Stab). Ein Dreiviertelstab ist ein R. mit Dreiviertelkreisquerschnitt.[Koepf / Binding 2016] "@de,
    "a) české synonymum pro torus, b) ozdobný prut, jehož průřez tvoří čtvrtkruh, půlkruh nebo tříčtvrteční kruh. [Koch 2008]"@cs,
    "Zierstab, dessen Querschnitt einen Viertel-, Halb- oder Dreiviertelkreis ( Viertel-, Halbrund-, Dreiviertelstab) bildet. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "obloun"@cs, " baguette"@fr, " baston"@en, " tondo"@it, "tapajuntas"@es,
    "Rundstab"@de;
  skos:altLabel "astragal"@cs, " astragal"@en, " torus"@en, "podhrlek"@cs, "junquillo"@es;
  skos:broader :c_78eff904;
  skos:narrower :c_4b599987, :c_110d9426, :c_d1aa2cea;
  dct:created "2020-08-04T12:53:37.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:18:52.000"^^xsd:dateTime .

:c_527ff9aa a skos:Concept;
  skos:definition "Konvexe Zierleiste aus wechselnd senkrecht stehenden, eiförmigen und pfeilspitzartigen Gebilden, unten und auch oben von einer Perlschnur (Astragal) abgeschlossen, in der röm. Architektur und in der Renaissance bevorzugtes Schmuckglied (Kyma). [Koepf / Binding 2016]"@de,
    "Dekorativní motiv vejčitého tvaru. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_37522b74;
  skos:prefLabel "Eierstab"@de, "vejcovec"@cs;
  skos:altLabel "inonisches Kymation"@de;
  skos:broader :c_78eff904;
  dct:created "2020-08-04T13:02:38.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:09:58.000"^^xsd:dateTime .

:c_11d21998 a skos:Concept;
  skos:definition "Abschrägung der Deckplatte von Gesimsen (Gesimsformen), Wasserschlägen und Fensterbänken. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_19d56a39;
  skos:prefLabel "biseau"@fr, "spiovente"@it, "Wasserschräge"@de, "pendiente"@es;
  skos:altLabel "vierte-aguas"@es;
  skos:broader :c_78eff904;
  dct:created "2020-08-04T14:11:30.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:21:03.000"^^xsd:dateTime .

:c_bbd289b1 a skos:Concept;
  skos:definition "Eine Querschnittsschwächung bei vorspringenden Baugliedern (Profilen),z. B. die Neigung der unteren Fläche einer Gesimsplatte nach außen. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "distinction"@en, "assottigliamento"@it, "Unterschneidung"@de;
  skos:altLabel "goterón"@es;
  skos:broader :c_78eff904;
  dct:created "2020-08-05T14:00:14.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:20:42.000"^^xsd:dateTime .

:c_cd98a452 a skos:Concept;
  skos:definition "Überstabung, Durchdringung von Profilen, Rundstäben u. dergl. bei Eckausbildung spätgot. Portale, Nischen oder Fenster. Ü.en entstehen auch, wenn ein Bogenlauf von einem Rechteckrahmen überlagert wird. [Koepf / Binding 2016]"@de,
    "Průnik profilů, zvl. u rohů portálů a oken ve vrcholné a pozdní gotice. [Koch 2008]"@cs,
    "Überstaben, Überschneidung, Profildurchdringung besonders bei der Eckenbildung von hoch- und spätgotischen Portalen und Fenstern. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "recoupement"@fr, "Überschneidung"@de, "ensamble cruzado"@es, "přetínání profilů"@cs,
    "overlap"@en;
  skos:altLabel "Überstaben"@de;
  skos:broader :c_78eff904;
  dct:created "2020-08-05T16:02:53.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:20:32.000"^^xsd:dateTime .

:c_e678f84c a skos:Concept;
  skos:definition "Keilschnitt, Kerbschnitt, ornamentale Holzschnitzerei als versenktes Relief. [Koch 2009]"@de,
    "Ornamentální dřevořezba jako zapuštěný reliéf. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9;
  skos:prefLabel "Keilschnitt"@de, "vrubořez"@cs;
  skos:altLabel "Kehlschnitt"@de;
  skos:broader :c_78eff904;
  skos:related :c_499b374b;
  dct:created "2020-08-06T10:24:40.000"^^xsd:dateTime;
  dct:modified "2021-01-26T17:41:49.000"^^xsd:dateTime .

:c_499b374b a skos:Concept;
  skos:definition "Die Figuren werden in die Fläche hinein vertieft und treten nirgends aus ihr hervor. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_50ec0c5e, :conceptScheme_8c0441f9;
  skos:prefLabel "versenktes Relief"@de, "zapuštěný reliéf"@cs;
  skos:broader :c_v04spf8z;
  skos:related :c_e678f84c;
  dct:created "2020-08-03T14:40:42.000"^^xsd:dateTime;
  dct:modified "2021-01-31T00:30:24.000"^^xsd:dateTime .

:c_70abcf73 a skos:Concept;
  skos:definition "Verdrehung eines Baukörpers (Turmhelm) oder Bauteils (Säule) in korkenzieherähnl. Form. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "torsion"@fr, "krut"@cs, "torsion"@en, "torsione"@it, "torsión"@es,
    "Torsion"@de;
  skos:altLabel "kroucení"@cs, "torze"@cs;
  skos:broader :c_78eff904;
  dct:created "2020-08-10T10:54:31.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:20:17.000"^^xsd:dateTime .

:c_260c6309 a skos:Concept;
  skos:definition "Eine in Karniesform aufgebogene Traufleiste (Sima) über dem Kranzgesims des antiken Tempels. Die R. war zunächst aus Terrakotta, später meist aus Stein. Da Ablaufrohre nicht bekannt waren, floss das Dachwasser durch Wasserspeier, meist Löwenköpfe ab. [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "moldura"@es, "sima"@it, "Rinnleiste"@de;
  skos:altLabel "sima"@es;
  skos:broader :c_78eff904;
  dct:created "2020-08-21T12:46:31.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:18:40.000"^^xsd:dateTime .

:c_490559b9 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "Ringstab"@de;
  skos:broader :c_78eff904;
  dct:created "2020-08-21T12:57:26.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:18:31.000"^^xsd:dateTime .

:c_d2bc4246 a skos:Concept;
  skos:definition "Abplattung, Abblattung, 1. hinter die Kante eines Balkens oder Bretts zurücktretende Fläche. 2. Auch Abgründung, das Abarbeiten der Ränder von Füllungsbrettern auf die Dicke der Nuten, in die sie eingeschoben werden sollen, z.B. bei Türfüllungen. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Abplattung"@de, "zploštění"@cs;
  skos:altLabel "Abblattung"@de, "Abgründung"@de;
  skos:broader :c_78eff904;
  dct:created "2020-08-22T16:30:48.000"^^xsd:dateTime;
  dct:modified "2021-01-26T17:41:35.000"^^xsd:dateTime .

:c_1f4b2c34 a skos:Concept;
  skos:definition "Ausschrägung, bei Steinbauten des MAs haben die Fensterleibungen häufig eine A. nach innen, so dass bei dicken Mauern die innere Fensteröffnung größer ist als die äußere, wodurch der Lichteinfall vergrößert wird und das Fenster opt. größer erscheint, bes. wenn die A. weiß verputzt ist. Bei sehr dicken Mauern und kleinen Fensteröffnungen können die Leibungen auch nach innen und nach außen ausgeschrägt sein. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "Ausschrägung"@de;
  skos:broader :c_78eff904;
  dct:created "2020-08-25T11:34:54.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:09:39.000"^^xsd:dateTime .

:c_e9aaa253 a skos:Concept;
  skos:definition "Ablauf, Apophyge, Apothesis, im Gegensatz zum Anlauf konkav kurvierte Vermittlung zwischen einem vorspringenden oberen und einem zurücktretenden unteren Bauglied. [Koepf / Binding 2016]"@de,
    "Apophyge, Apophysis (gr. das Fliehen, Fehlen), Anlauf oder Ablauf. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "Ablauf"@de, "průběh"@cs;
  skos:altLabel "Apophyge"@de, """Apothesis
"""@de;
  skos:broader :c_78eff904;
  dct:created "2020-09-01T13:53:27.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:08:49.000"^^xsd:dateTime .

:c_bf6746b8 a skos:Concept;
  skos:definition "Ziernagelung: gehäufte Anordnung von Holznägeln, deren Anzahl über das konstruktiv Notwendige hinausgeht. (Eißing et al. 2012)"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_19d56a39;
  skos:prefLabel "Ziernagelung"@de;
  skos:broader :c_8e64a27b;
  dct:created "2019-05-22T12:06:23.000"^^xsd:dateTime;
  dct:modified "2021-01-31T20:52:27.000"^^xsd:dateTime .

:c_bc58b851 a skos:Concept;
  skos:definition "Eigentliche Funktion der Fase an einem Fenster, den Einfallwinkel des Lichtes über die Schenkel und Holzsprossen zu vergrößern. Die Lichtfase kann in einem Winkel von etwa 45° glatt gehobelt sein, aber auch mit Zierform (Viertelstab etc.) ausgeführt sein. Sie tritt innen und außen auf. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_b41bd73a;
  skos:prefLabel "Lichtfase"@de;
  skos:broader :c_b4b2e9b5;
  skos:narrower :c_a7ccf810;
  dct:created "2019-06-13T15:31:58.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:11:50.000"^^xsd:dateTime .

:c_116fbde6 a skos:Concept;
  skos:definition "Fasen und auch Lichtfasen an Fenster-, Flügel- und Schieberahmen sowie an Sprossen, deren Oberflächen nicht glatt gehobelt sind, sondern ein Zierprofil tragen. Es gibt auch glatt gehobelte Zierfasen die neben der Ansicht den Gebrauch angenehmer machen. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_b41bd73a;
  skos:prefLabel "Zierfase"@de;
  skos:broader :c_b4b2e9b5;
  dct:created "2019-06-13T15:32:16.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:12:08.000"^^xsd:dateTime .

:c_a3070567 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_ec8c77bf;
  skos:prefLabel "relief"@en, "reliéf (technika)"@cs, "Relief (Technik)"@de;
  skos:note "A sculptural technique which creates high, mid or low projections from a flat surface or excavated forms below a surface. [EwaGlos]"@en,
    "Eine plastische Technik, mit der hohe, mittlere oder niedrige Strukturen aus einer ebenen Fläche heraus geformt werden oder in die Oberfläche versenkte Strukturen eingetieft werden. [EwaGlos]"@de;
  skos:broader :c_36969a5d;
  skos:related :c_v04spf8z;
  dct:created "2019-07-24T18:26:44.000"^^xsd:dateTime;
  dct:modified "2020-08-18T17:50:27.000"^^xsd:dateTime .

:c_be92cd86 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346;
  skos:prefLabel "reliefiert"@de;
  skos:broader :c_4ccd7999;
  skos:related :c_v04spf8z;
  dct:created "2020-06-24T08:43:51.000"^^xsd:dateTime;
  dct:modified "2020-06-24T08:44:15.000"^^xsd:dateTime .

:c_74620c62 a skos:Concept;
  skos:definition "Die Ebene eines Falzes, gegen die der Flügel beim Verschließen im Fensterrahmen schlägt. [Pax - Fenster & Türen Fachbegriffe]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_c7b144d0, :conceptScheme_b41bd73a;
  skos:prefLabel "Anschlagfalz"@de;
  skos:altLabel "Einschlagfalz"@de;
  skos:broader :c_b8ea47ea;
  dct:created "2019-05-22T18:55:53.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:10:19.000"^^xsd:dateTime .

:c_46ccb7a3 a skos:Concept;
  skos:definition "Zwei Falze speziell zwischen Flügel- und Blendrahmen von Holzfenstern. [Pax - Fenster & Türen Fachbegriffe]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
