:c_af5d3dcb a skos:Concept;
  skos:definition "Karnies (ital. cornice = Fries, Rahmen), »Glockenleiste«. S-förmiges, also konkav-konvex profiliertes Bauglied. Nach seiner Funktion am Baukörper tragendes Karnies (als Zwischenglied) oder bekrönendes Karnies (als oberer Abschluss, etwa bei Gesimsen). Nach der Anordnung des konvexen Profilteils steigend wenn er oben (z.B. bei Säulenkapitellen), fallend wenn er unten angebracht ist. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_8c0441f9, :conceptScheme_19d56a39;
  skos:prefLabel "Karnies"@de, "zvonovnice"@cs;
  skos:altLabel "sima"@cs;
  skos:broader :c_78eff904;
  skos:narrower :c_8bece343, :c_278163d4, :c_015dea6d, :c_d8dc5711;
  dct:created "2019-05-22T12:29:48.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:17:22.000"^^xsd:dateTime .

:c_84343fef a skos:Concept;
  skos:definition "Tauartig gedrehter Stab als Schmuckglied der normann. und roman. Architektur des 12. Jhs. sowie im dt. Fachwerkbau des 15./16. Jhs. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_19d56a39;
  skos:prefLabel "câble torsadé"@fr, "normanský páskový ornament z prvků tvaru T"@cs,
    "rope moulding"@en, "cordeliera"@it, "entorchado"@es, "Taustab"@de;
  skos:altLabel "treccia"@it;
  skos:broader :c_78eff904;
  dct:created "2019-05-22T12:29:57.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:20:07.000"^^xsd:dateTime .

:c_1fe0ba39 a skos:Concept;
  skos:definition "Birnstab, stabartiges Bauglied der Gotik (Rippe, Dienst) mit birnenförmigem Querschnitt. [Koepf / Binding 2016] "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "Birnstab"@de, "hruškovec"@cs;
  skos:broader :c_78eff904;
  dct:created "2019-09-11T15:01:40.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:09:48.000"^^xsd:dateTime .

:c_888abc62 a skos:Concept;
  skos:definition "Anlauf: Ansätze einer Profilierung, die durch unterschiedlich gestaltete Übergänge zwischen verschiedenen Querschnitten des Bauholzes vermitteln. [Eißing et al. 2012]"@de,
    "Anlauf, 1. konkav kurvierte Vermittlung zwischen einem vorspringenden unteren und einem zurücktretenden oberen Bauglied (Apothesis, Apophyge, Ablauf). 2. Leichte Neigung (Anzug) des Sockels bzw. des gequaderten Erdgeschosses nach dem Gebäude. 3. Kurze Rampe.  [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_19d56a39;
  skos:prefLabel "Anlauf"@de, "náběh"@cs;
  skos:broader :c_78eff904;
  dct:created "2019-12-05T15:21:46.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:08:59.000"^^xsd:dateTime .

:c_5d65acba a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe;
