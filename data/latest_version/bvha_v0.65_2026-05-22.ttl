:c_9fdadf31 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ec8c77bf;
  skos:prefLabel "brick dust"@en, "cihelná moučka"@cs, "Ziegelmehl"@de;
  skos:note "A moisture-retaining aggregate which, depending on its grain size, may be a pozzolanic aggregate for mortars. Brick dust is also used for colouring mortars. Crushed brick and coarse brick particles are used for the manufacture of cocciopesto mortar, terrazzo and waterproof mortars. [EwaGlos]"@en,
    "Ein feuchtespeichernder und ggf., abhängig von seiner Korngröße, ein puzzolanischer Zuschlag für Mörtel, der auch zum Färben von Mörteln verwendet wird. Ziegelbruch und grobe Ziegelpartikel werden für die Herstellung von Cocciopesto-Mörtel, Terrazzo und wasserfesten Mörteln verwendet. [EwaGlos]"@de;
  skos:broader :c_d0f56cb6;
  dct:created "2019-06-11T20:59:49.000"^^xsd:dateTime;
  dct:modified "2020-07-30T14:38:28.000"^^xsd:dateTime .

:c_f7274108 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346;
  skos:prefLabel "Schluff"@de;
  skos:broader :c_d0f56cb6;
  dct:created "2019-06-11T21:53:46.000"^^xsd:dateTime;
  dct:modified "2019-06-11T21:53:55.000"^^xsd:dateTime .

:c_11ec36ef a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ec8c77bf;
  skos:prefLabel "clay"@en, "hlína"@cs, "Ton"@de;
  skos:note "A fine-grained material made up of particles that have a size of less than 4 μm and are predominantly composed of hydrated phyllosilicates; a clay is plastic when wet and hardens when fired or dried. [EwaGlos]"@en,
    "Ein feinkörniges Material aus Partikeln mit weniger als 4 μm Größe, das hauptsächlich aus hydratisierten Schichtsilikaten zusammengesetzt ist. Ton ist im feuchten Zustand plastisch und härtet, wenn er getrocknet oder gebrannt wird. [EwaGlos]"@de;
  skos:broader :c_d0f56cb6;
  skos:narrower :c_11c9287f, :c_60a06338;
  skos:related :c_3d120723;
  dct:created "2019-06-11T21:54:09.000"^^xsd:dateTime;
  dct:modified "2020-07-30T14:35:48.000"^^xsd:dateTime .

:c_3d120723 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "práce s hlínou, řemesla zpracovávající hlínu"@cs, "Tonarbeit"@de,
    "opus latericium"@la;
  skos:broader :c_1df9f722;
  skos:related :c_11ec36ef;
  dct:created "2020-09-29T19:07:51.000"^^xsd:dateTime;
  dct:modified "2021-01-18T14:16:02.000"^^xsd:dateTime .

:c_f8e7242f a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ec8c77bf;
  skos:prefLabel "crushed brick"@en, "cihelná drť"@cs, "Ziegelsplitt"@de;
  skos:note "Recycled material which is generally obtained from unused bricks or pottery by crushing them into different dimensions. (EwaGlos)"@en,
    "Wiederverwendetes Material aus ungenutzten Ziegeln oder Tonwaren, die in verschiedene Größen zerkleinert werden. (EwaGlos)"@de;
  skos:broader :c_d0f56cb6;
  dct:created "2019-06-20T17:28:45.000"^^xsd:dateTime;
  dct:modified "2020-07-30T14:39:30.000"^^xsd:dateTime .

:c_2fceb100 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ef0a8695,
    :conceptScheme_ec8c77bf;
  skos:prefLabel "Füllstoff"@de, "filler"@en;
  skos:note "1. An inert powdered material added to a material (binder, pigment, adhesive, paint, cement, etc.), to improve its working properties, to enhance its properties or to reduce costs.2. A mixture of substances used to fill pores, gaps, cracks and holes in wall paintings, mosaics and other architectural surfaces.3. A very fine aggregate used for concrete, mortar and plaster with standard-defined dimensions (“which passes a 0.063 mm sieve“). [EwaGlos]"@en,
    "1. Ein inertes, unlösliches, pulveriges Material, das zu einem Grundmaterial (Bindemittel, Pigment, Klebemittel, Farbe, Zement etc.) hinzugefügt wird, um dessen Handhabung und Eigenschaften zu verbessern oder um Kosten zu reduzieren.2. Der englische Begriff “filler” bezeichnet auch eine Mischung aus Stoffen, die zum Füllen von Poren, Lücken, Rissen und Löchern in Wandmalereien, Mosaiken und anderen Architekturoberflächen verwendet wird. Dies entsprichtim Deutschen der “Füllmasse”/dem “Kitt” oder der Ergänzungsmasse.3. Ein sehr feiner Zuschlag für Beton, Mörtel, Putz mit einer standardisierten Korngröße („passiert ein 0,063 mm Sieb“). [EwaGlos]"@de;
  skos:broader :c_d0f56cb6, :c_4mgalztg;
  dct:created "2019-06-20T18:02:40.000"^^xsd:dateTime;
  dct:modified "2021-03-19T15:01:39.000"^^xsd:dateTime .

:c_70779b43 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ec8c77bf;
  skos:prefLabel "marble dust"@en, "mramorová moučka"@cs, "Marmormehl"@de;
  skos:note "Fine powder made from crushed and ground marble chips, of calcitic or dolomitic origin. [EwaGlos]"@en,
    "Feines Pulver aus zerkleinerten und gemahlenen Marmorstücken, calcitischen oder dolomitischen Ursprungs. [EwaGlos]"@de;
  skos:broader :c_d0f56cb6;
  dct:created "2019-07-05T20:09:06.000"^^xsd:dateTime;
  dct:modified "2020-07-30T14:47:13.000"^^xsd:dateTime .

