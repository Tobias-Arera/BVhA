    "alternanza dei supporti"@it, "soportes dispuestos alternadamente"@es, "Stützenwechsel"@de;
  skos:broader :c_b4d4b9c7, :c_9c378a56, :c_eea86d94;
  skos:narrower :c_fe045bb8, :c_5279a090;
  dct:created "2019-10-22T14:35:44.000"^^xsd:dateTime;
  dct:modified "2021-01-15T17:58:20.000"^^xsd:dateTime .

