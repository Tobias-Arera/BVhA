:c_b8339847 a skos:Concept;
  skos:definition "Kreuzfahne f : Fahne, deren Fahnentuch an einer beweglichen Querstange befestigt ist und unten entweder gerade, bogenförmig oder gezackt endet; das Fahnentuch ist meist aus schwerer Seide und reich bestickt; die Fahnenstange ist von einem Kreuz bekrönt. [Glossarium Artis]"@de,
    "Labarum, Siegeszeichen des auferstandenen Christus über den Tod: Wimpel an einem langschäftigen Kreuz. [Koch 2009]"@de,
    "Znamení vítězství vzkříšeného Krista. nad smrtí, korouhev (praporec) na kříži s dlouhou žerdí. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9, :conceptScheme_1f14b4dd;
  skos:prefLabel "bannière croisée "@fr, "labarum"@cs, "Kreuzfahne"@de;
  skos:altLabel "Labarum"@de, "korouhev s křížovým ráhnem"@cs;
  skos:broader :c_bfa98060;
  skos:related :c_9f74e321, :c_da9a0c9b;
  dct:created "2020-04-11T17:01:10.000"^^xsd:dateTime;
  dct:modified "2021-01-24T17:35:24.000"^^xsd:dateTime .

:c_1183384d a skos:Concept;
  skos:definition "Dalmatikflügel m, scapularium: dreieckiger, mit Quasten und Fransen besetzter seidener Behang, der hauptsächlich am Rückenteil mittelalterlicher Dalmatiken aus dem norddeutschen Raum vorkommt. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8;
