:c_2f8a3523 a skos:Concept;
  skos:definition "Blaker (niederdeutsch blaken = rußen, glühen), Wandleuchter mit reflektierender Rückplatte. [Koch 2009]"@de,
    "Z dolnoněm. blaken = čadit, žhnout. Svícen připevněný ke stěně s odrazovou zadní deskou. [Koch 2008]"@cs,
    "Leuchter m; präzis. KerzenIeuchter m; auch Kerzenstock m; gr. kerostates; lat. cereostatum; candelabrum; lucerna: ein Ständer oder Träger für Kerzen, Fackeln und Lampen. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
