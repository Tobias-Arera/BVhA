:c_8c21b07a a skos:Concept;
  skos:definition "Netzartig durchbrochenes Blech, das 1893 erstmalig in den USA hergestellt wurde und als Putzträger dient. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "Streckmetall"@de, "metal desplegado"@es, "lamiera stirata"@it, "métai déployé"@fr,
    "expanded metal"@en;
  skos:altLabel "metal extendido"@es;
  skos:editorialNote "Ist nicht zwingend ein \"Träger\", lässt sich auch in anderen Kontexten verwenden und ist deshalb hier nicht unterzuordnen."@de;
  skos:broader :c_c72b7354;
  dct:created "2020-08-11T15:11:38.000"^^xsd:dateTime;
  dct:modified "2021-01-25T15:55:41.000"^^xsd:dateTime .

:c_50c7bdfe a skos:Concept;
  skos:definition "Als Putzträger für Holz- und Eisenteile, die mit Strohlehm beworfen und mit einem verzinkten Drahtgeflecht so überspannt werden, dass auch die Fugen überdeckt sind. Urspr. aus dünnen, schmalen oder breiteren, auf Grat kannelierten Latten (Pliesterlatten)  bestehend und anstelle von Rohr beim Deckenputz verwandt. [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "Pliestergeflecht"@de;
  skos:broader :c_c72b7354;
  dct:created "2020-08-25T10:17:44.000"^^xsd:dateTime;
  dct:modified "2021-01-25T15:55:15.000"^^xsd:dateTime .

:c_b3b8889b a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_ec8c77bf;
  skos:prefLabel "render"@en, "venkovní omítka"@cs, "Außenputz"@de;
  skos:altLabel "Verputz"@de, "Fassadenputz"@de;
  skos:note "A protective and/or decorative coat (possibly in multi layers), which is applied to exterior architectural surfaces. [EwaGlos]"@en,
    "Eine schützende und/oder dekorative Beschichtung (eventuell mehrlagig), die auf äußere Architekturoberflächen aufgebracht wird. [EwaGlos]"@de,
    "Außenputz, Putz an der Außenseite eines Bauwerks zum Schutz des Mauerwerks gegen Witterungseinflüsse. [Koepf / Binding 2016]"@de;
  skos:broader :c_wdriolje;
  skos:narrower :c_df497a63;
  dct:created "2019-05-07T18:01:03.000"^^xsd:dateTime;
  dct:modified "2021-01-25T15:52:18.000"^^xsd:dateTime .

:c_df497a63 a skos:Concept;
  skos:definition "Amborelliputz, Fassadenputz aus zwei bis drei Lagen Kalkmörtel mit Zement- und Farbzusatz. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
