  dct:modified "2020-11-27T12:20:52.000"^^xsd:dateTime .

:c_e8627f5b a skos:Concept;
  skos:definition "Mantelbaum, Schurzholz; das zum Tragen eines gemauerten Rauchfangs bestimmte horizontale Holz, entweder in mächtige Mauern eingespannt oder durch bes. hierzu ausgeführte massive Pfeiler, auch durch Knaggen (Rauchfangträger, Mantelknagge) unterstützt. Das R. ist in der Regel gegen die Steigungslinie des Rauchfangs abgeschrägt. [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe;
  skos:prefLabel "Rauchfangholz"@de, " viga de la campana de la chimenea"@es, "architrave del camino"@it,
    " poutre de hotte"@fr, "manteltree"@en;
  skos:altLabel "Mantelbaum"@de, "Schurzholz"@de, " cornice del camino"@it;
  skos:broader :c_f99ea647;
  dct:created "2020-08-21T14:28:34.000"^^xsd:dateTime;
  dct:modified "2020-11-24T09:22:06.000"^^xsd:dateTime .

:c_ee88b67f a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe;
  skos:prefLabel "Pfahl"@de, "kůl"@cs;
  skos:altLabel "kolík"@cs, "pilota"@cs, "pažina"@cs;
  skos:broader :c_f99ea647;
  dct:created "2020-08-24T15:32:59.000"^^xsd:dateTime;
  dct:modified "2020-11-25T18:55:02.000"^^xsd:dateTime .

:c_b4efa6c7 a skos:Concept;
  skos:definition "(Pfahl), eine in den Boden (P.loch) eingelassene und gegen Seitendruck verankerte Stütze aus Holz oder Metall, Hauptkonstruktionselement des frühgeschichtl. Hauses, dessen Wände aus Flechtwerk zwischen P. bestanden. Auch bei Fenstern und Türen werden die senkrechten Seitenbegrenzungshölzer P. genannt. Falsch ist es jedoch, Ständer, Stiele oder Säulen im Fachwerkbau als P. zu bezeichnen, da ihnen die Bodeneinspannung fehlt.[Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Pfosten"@de, " poste"@es, "palo"@it, "fošna"@cs, " poste"@fr;
  skos:altLabel "poteau"@fr, "sloupek"@cs, "montante"@it, "post"@en, "vzpěra"@cs, "zárubeň"@cs,
    "montant"@fr, "ritto"@it, "veřeje"@cs, "ostění"@cs;
  skos:broader :c_f99ea647;
  dct:created "2020-08-25T10:57:41.000"^^xsd:dateTime;
  dct:modified "2020-11-25T20:19:22.000"^^xsd:dateTime .

:c_22870fcf a skos:Concept;
  skos:definition "Abstehender, direkter Dachrinnenausguss aus Stein oder  Blech, z.B. in Form eines Wasserspeiers oder eines schnauzenförmigen Austritts, der später durch eine Dachrinne mit Regenfallrohr ersetzt wurde. [Schrader / Voigt 2003]"@de,
    "Abtraufe, Ansetztraufe, Schnauze, schmuckloser Wasserspeier in Form einer Röhre oder Ablaufrinne aus Holz, Stein oder Blech. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_5bf6bcac;
  skos:prefLabel "Abtraufe"@de, "okapní žlábek"@cs;
  skos:altLabel "Schnauze"@de, "Ansetztraufe"@de;
  skos:broader :c_a9967019, :c_b99ef53b;
  dct:created "2020-01-15T16:48:54.000"^^xsd:dateTime;
  dct:modified "2020-09-01T14:10:01.000"^^xsd:dateTime .

:c_4d5f7627 a skos:Concept;
  skos:definition "Längsversteifung durch Diagonalrispen (Windrispen) unter den Sparren einer Dachkonstruktion. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "contreventement"@fr, "ztužení"@cs, "wind brace"@en, "controventatura"@it,
    "contraviento"@es, "Windverband"@de;
  skos:altLabel "zavětrování"@cs, "horizontal (longitudinal) bracing"@en, "controventatura ( di falda del tetto )"@it,
    " trabazón longitudinal"@es, "zavětrovací ztužidlo"@cs, "podélné ztužení"@cs;
  skos:broader :c_a9967019;
  dct:created "2020-08-04T09:36:10.000"^^xsd:dateTime;
  dct:modified "2020-12-03T09:37:10.000"^^xsd:dateTime .

:c_91f599cb a skos:Concept;
  skos:definition "Schlankes, meist hölzernes Türmchen zur Aufnahme einer Glocke oder einer Uhr, das auf dem Dachfirst zu reiten scheint, tatsächl. aber mittels vier Eckständern auf der Konstruktion des Dachwerks fußt. D. sind häufig über der Vierung angeordnet und dienen als Glockenstuhl. D. aus Holz und Stein, oft mit reichem Strebewerk, gewannen im 13. Jh. bes. Bedeutung bei den im Übrigen turmlosen Kirchen der Zisterzienser und Bettelorden, denen nur zwei Glocken gestattet waren, kommen aber auch auf Kathedralen vor. Auf Profanbauten (Rathäusern, Tortürmen, Spitälern) finden sich D. seit dem 15. Jh., mitunter über einem Giebel (Giebelreiter) oder in dessen Nähe. [Koepf / Binding 2016]"@de,
    "Štíhlá (většinou dřevěná) věžička na hřebeni střechy, zaveden cisterciáky ve 13. stol., později na kazatelském kostele, u gotických katedrál nahrazoval často věž nad křížením lodí, protože stavba věží se soustřeďovala na západní průčelí. [Koch 2008]"@cs,
    "Schlankes (meist Holz-)Türmchen auf dem Dachfirst. Von den Zisterziensern im 13. Jh. eingeführt, dann auf Predigerkirchen, ersetzt bei den gotischen Kathedralen manchmal den Vierungsturm, weil der Turmbau auf die Westfassade konzentriert wird. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "Dachreiter"@de, "sanktusník"@cs;
  skos:broader :c_a9967019;
  dct:created "2020-08-04T11:15:36.000"^^xsd:dateTime;
  dct:modified "2020-09-08T12:30:22.000"^^xsd:dateTime .

:c_07d1171b a skos:Concept;
  skos:definition "Schwache Hölzer, die gegen den Winddruck kreuzweise übereinander zwischen die liegenden Stuhlsäulen oder an der Innenseite der Sparren angebracht werden. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "riostra de contraviento"@es, "queue de vache"@fr, "Sturmlatte"@de;
  skos:altLabel "controvento"@it, "sprocket"@en, "auvent"@fr, "poincon rampant"@fr;
  skos:broader :c_a9967019;
  dct:created "2020-08-11T12:34:23.000"^^xsd:dateTime;
  dct:modified "2020-09-02T17:38:18.000"^^xsd:dateTime .

:c_f3004039 a skos:Concept;
  skos:definition "Unterer, vorstehender Teil eines weit ausladenden Dachs, auch als kurze, senkrechte, von oben herabhängende Verkleidung. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "revestimiento de techo"@es, "sporgenza del tetto"@it, "Schurz (Dachelement)"@de;
  skos:broader :c_a9967019;
  dct:created "2020-08-19T15:09:17.000"^^xsd:dateTime;
  dct:modified "2020-11-02T10:49:01.000"^^xsd:dateTime .

:c_61c26469 a skos:Concept;
  skos:definition "Vorrichtung, die das lawinenartige Abrutschen von Schnee auf den Dächern verhindern soll, entweder als Latte oder als Gitter traufenparallel an Schneehaken befestigt. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Schneefang"@de, "retenedor de nieve"@es, "paraneve"@it, "mřížový sněhový zachytač"@cs,
    "pare-neige"@en;
  skos:altLabel "Schneegitter"@de;
  skos:broader :c_a9967019;
  dct:created "2020-08-19T16:16:16.000"^^xsd:dateTime;
  dct:modified "2020-11-27T11:51:41.000"^^xsd:dateTime .

:c_bed66b34 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Dachziegelelement"@de;
  skos:broader :c_a9967019;
  skos:narrower :c_536a39fd;
  dct:created "2020-08-25T16:14:18.000"^^xsd:dateTime .

:c_2b91385d a skos:Concept;
  skos:definition "Das die Sparren aufnehmende Tragwerk einer Dachkonstruktion, das in größeren Abständen zwischen den Leergesprängen eingefügt ist; die darauf liegenden Sparren heißen Hauptsparren, Bindersparren oder Gebindesparren; die Gesamtheit der Konstruktion heißt Gebinde bzw. Bundgespärre oder Vollgespärre. [Koepf / Binding 2016]"@de,
    "Beim Dachwerk das die Sparren oder Pfetten aufnehmende Tragwerk, das in großen Abständen zwischen den Leergespärren vorkommt (Dachkonstruktion). [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Dachbinder"@de, "střešní vazník"@cs;
  skos:broader :c_a9967019;
  skos:narrower :c_20b52c97;
  dct:created "2020-08-28T16:22:21.000"^^xsd:dateTime;
  dct:modified "2020-09-10T12:58:36.000"^^xsd:dateTime .

:c_eb774bdc a skos:Concept;
  skos:definition "Gespärre, Sparrenwerk, Gesamtheit der Sparren einer Dachkonstruktion. [Koepf / Binding 2016]"@de,
    "Das einzelne Sparrenpaar, aber auch das Sparrenwerk als Gesamtheit aller Sparren eines Dachs. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Dachgespärre"@de, "(střešní) trámoví"@cs;
  skos:broader :c_a9967019;
  dct:created "2020-09-01T09:28:11.000"^^xsd:dateTime;
  dct:modified "2020-09-29T13:07:54.000"^^xsd:dateTime .

:c_fe5e2ad9 a skos:Concept;
  skos:definition "Dachkehle, Kehle, Seiler; der einspringende Winkel, den zwei aufeinanderstoßende Dachflächen bilden, bzw. die dadurch entstehende Rinne, unter der ein Kehlsparren liegt. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Dachkehle"@de, "úbočí střechy"@cs;
  skos:broader :c_a9967019;
  dct:created "2020-09-01T09:36:31.000"^^xsd:dateTime;
  dct:modified "2020-09-10T13:01:19.000"^^xsd:dateTime .

:c_1f562dde a skos:Concept;
  skos:definition "Eine nur mit einem Laden verschließbare, der Lüftung dienende Dachöffnung; häufig wird so auch fälschl. ein kleines Dachfenster (Gaube) bezeichnet. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Dachluke"@de, "střešní okno"@cs;
  skos:broader :c_a9967019;
  dct:created "2020-09-01T09:49:33.000"^^xsd:dateTime;
  dct:modified "2020-09-10T13:04:02.000"^^xsd:dateTime .

:c_e689f8dd a skos:Concept;
