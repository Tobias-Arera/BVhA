:c_d2a04bd0 a skos:Concept;
  skos:scopeNote "Für mittelalterliche Planrisse charakteristische Zeichentechnik. Mit einem Griffel, dem Blindrillenstift, wird die Vorzeichnung auf Pergament eingeprägt."@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_f10222e0;
  skos:prefLabel "Blindrille"@de;
  skos:broader :c_929e45f2;
  dct:created "2019-11-13T14:19:03.000"^^xsd:dateTime;
  dct:modified "2021-01-24T14:20:48.000"^^xsd:dateTime .

:c_929e45f2 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8;
  skos:prefLabel "Zeichentechnik"@de;
  skos:broader :c_1df9f722;
  skos:narrower :c_d2a04bd0 .

:c_faf0956a a skos:Concept;
  skos:definition "Dachausmittlung heißt die geometr. Festlegung einer Dachform und ihrer Schnittlinien (Traufe, Ort, First, Grat, Kehle, Verfallung) über dem gegebenen Grundriss. Sie ist die Grundlage für die konstruktive Ausbilung des Dachs (Werksatz). [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_84fc24e6;
  skos:prefLabel "Dachausmittlung"@de;
  skos:broader :c_1df9f722;
  dct:created "2020-09-06T15:30:02.000"^^xsd:dateTime;
  dct:modified "2021-01-24T14:21:01.000"^^xsd:dateTime .

:c_c9733728 a skos:Concept;
  skos:definition "Die [...] Blindrillenstifte für die Vorzeichnung auf den Pergamentrissen sind lediglich auf einigen Abbildungenzu sehen; originale Exemplare sind nicht erhalten. Aus diesen Quellen geht auch hervor, dass die Blindrillenstiftewohl aus Metall waren. [Voelkle 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_f10222e0;
  skos:prefLabel "Blindrillenstift"@de;
  skos:broader :c_9fc3a864;
  dct:created "2019-11-13T14:17:31.000"^^xsd:dateTime;
  dct:modified "2019-11-13T15:08:03.000"^^xsd:dateTime .

:c_f9a1fcad a skos:Concept;
  skos:scopeNote "Zeichengerät zum Ausführen der Vorzeichnung auf mittelalterlichen Architekturrissen. [BVHA]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_f10222e0;
  skos:prefLabel "Reißfeder"@de;
  skos:broader :c_9fc3a864;
  dct:created "2019-11-13T14:17:45.000"^^xsd:dateTime;
  dct:modified "2019-11-14T12:01:15.000"^^xsd:dateTime .

:c_26a203fa a skos:Concept;
  skos:scopeNote "Ein Winkel mit zumindest einem Schenkel, der keine parallele Form besitzt. [BVHA]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_f10222e0;
  skos:prefLabel "Winkel mit nicht-parallelen Schenkeln"@de;
  skos:broader :c_e2edd153;
  dct:created "2019-11-13T15:36:57.000"^^xsd:dateTime;
  dct:modified "2019-11-14T11:57:56.000"^^xsd:dateTime .

