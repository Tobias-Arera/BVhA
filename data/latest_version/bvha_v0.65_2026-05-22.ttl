:c_4af80e17 a skos:Concept;
  skos:definition "Meist als Fratze ausgebildet, aus Holz oder Stein an Giebel, Mauer oder Tür eines Hauses oder Tores als Abwehrzauber angebracht. [Koepf/Binding 2016]"@de,
    "Reliéf lidské nebo zvířecí hlavy k odvrácení zlých duchů, na domech, v románských kostelích, na křtitelnicích a chórových lavicích. [Koch 2008]"@cs,
    "Neidkopf (von althochdeutsch nîd = Hass), Menschen- oder Tierkopf-Relief zur Abwehr böser Geister an Häusern, in romanischen Kirchen, an Taufsteinen und Chorgestühl. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel " tête conjuratoire"@fr, "ochranná hlava"@cs, " apotropaic image"@en,
    " maschera apotropaica"@it, "máscara apotropaica"@es, "Neidkopf"@de;
