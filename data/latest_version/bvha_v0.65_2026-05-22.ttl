:c_c1c07882 a skos:Concept;
  skos:definition "Bezeichnung für alle Gewölbe, deren Form aus der des Zylinders abgeleitet werden kann, z.B. Tonnengewölbe, Kreuzgewölbe, Klostergewölbe und Stichkappe. Die Wölbflächen sind Zylinderflächen, die man sich durch Fortbewegen einer ebenen, regelmäßig gekrümmten Linie an einer geraden oder gekrümmten Achse entstanden denken kann. Im Unterschied zu den sphärischen Gewölben werden zylindrische Gewölbe eingeschalt. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "voûte cylindrique"@fr, "cylindrical vault"@en, "zylindrisches Gewölbe"@de;
  skos:broader :c_049c4c22;
  skos:narrower :c_11426742, :c_5f9418c5, :c_6b1efaf3;
  dct:created "2019-10-23T09:39:35.000"^^xsd:dateTime;
  dct:modified "2021-01-19T13:14:16.000"^^xsd:dateTime;
  :broaderByShape :c_049c4c22 .

