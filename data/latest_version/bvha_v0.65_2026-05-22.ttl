:c_v04spf8z a skos:Concept;
  skos:definition "Relief (frz.), plast. Komposition, in der Form von Basr., Flachr., Hochr., Koilanaglyphen oder dergl. mehr oder weniger stark herausgearbeitet, jedoch immer mit dem Mauergrund verbunden. [Koepf / Binding 2016]"@de,
    "Plastika, která vzešla z plochy a je s ní ještě zřetelně spjata. [Koch 2008]"@cs,
    "Relief (frz. erhabene Arbeit), Plastik, die aus einer Fläche heraus entwickelt wurde und noch spürbare Beziehung zu ihr hat. Hauptformen nach dem Grad des Hervortretens der Figuren. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_50ec0c5e, :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "Relief"@de, "relieve"@es, "reliéf"@cs, "rilievo"@it, "relief"@fr;
  skos:altLabel "relief"@de;
  skos:broader :c_klbrisjd;
