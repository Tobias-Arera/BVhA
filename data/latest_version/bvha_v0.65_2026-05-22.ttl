:c_e3a089f6 a skos:Concept;
  skos:definition "vaulting system in which a central nave bay aligns with a single side-aisle bay [Glossarium Artis]"@en,
    "Ein Schema des Kirchengrundrisses, bei dem ein Joch im Mittelschiff gleich lang ist wie ein Joch in den Seitenschiffen. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd,
    :conceptScheme_167cb98f;
  skos:prefLabel "durchgehendes Gewölbesystem"@de, "système des voûtes à travées simples"@fr;
  skos:broader :c_da88954d;
