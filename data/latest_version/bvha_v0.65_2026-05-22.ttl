:c_4d4fbaf3 a skos:Concept;
  skos:definition "Eine Sonderform der Zahnfläche war die Zahndechsel, bei der die Schneide quer zum Stiel steht - also ein klassisches Werkzeug für die Arbeit »im Stich« oder zumindest an schräg liegenden Flächen. [Voelkle 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_f10222e0;
  skos:prefLabel "Zahndechsel"@de;
  skos:broader :c_6ab2e845;
  dct:created "2019-12-18T11:56:09.000"^^xsd:dateTime;
  dct:modified "2019-12-18T12:00:51.000"^^xsd:dateTime .

:c_8ba1162d a skos:Concept;
  skos:definition "[...] die sogenannte Rennspindel - ein einfaches, aber sehr effektives Werkzeug: Eine senkrechte Welle mit einem eingesetzten »Bohrer« drehte sich in einem horizontalen Holzgriff, aufgehängt über zwei Schnüre. Beim Ansetzen des Bohrers wurde dieser einige Male um die eigene Achse gedreht um die Schnüre aufzuwickeln. Durch das Herabdrücken des Holzgriffs rotierte die Welle, drehte sich durch die Fliehkraft des Gewichts weiter und wickelte dabei die Schnur wieder auf. [Voelkle 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_f10222e0;
  skos:prefLabel "Rennspindel"@de;
  skos:broader :c_fc540a39;
  dct:created "2019-12-03T16:46:25.000"^^xsd:dateTime;
  dct:modified "2019-12-03T16:56:38.000"^^xsd:dateTime .

