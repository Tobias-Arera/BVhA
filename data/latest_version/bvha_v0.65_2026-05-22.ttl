:c_4c25291a a skos:Concept;
  skos:definition "Gratbalken, Kehlbalken, der diagonal auf die Ecke zulaufende Balken einer Balkenlage, in den die übrigen Balken eingezapft werden, vorrangig bei Dachbalkenlagen; besser ist die Anordnung eines Gratstichbalkens. [Koepf / Binding 2016]"@de,
    "Horizontal zwischen den beiden Sparren eines Sparrenpaares eingespanntes Holz, zugleich geschossunterteilend als Bundkehlbalken im Querbund. [Eißing et al. 2012]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_167cb98f, :conceptScheme_19d56a39;
  skos:prefLabel "Kehlbalken"@de, "hambalky"@cs;
  skos:altLabel "Gratbalken"@de, "Hahnenbalken"@de;
  skos:broader :c_a9967019, :c_66433988, :c_c51fa22d;
  skos:narrower :c_46c53805;
  dct:created "2019-05-28T08:48:28.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:22:20.000"^^xsd:dateTime;
  :broaderByPosition :c_66433988 .

:c_189b869b a skos:Concept;
  skos:definition "Eine schräg zurTrauflinie verlaufende Latte, die als Windverband (Längsverband) eines Sparrendachs dient (Dachkonstruktion). [Koepf / Binding 2016]"@de,
    "Schräg vom Dachfuß gegen den First verlaufendes, latten-, brett- oder bohlenartiges Holz, das auf der unteren oder oberen Seite der Sparren aufgenagelt, überkämmt oder überblattet ist. [Eißing et al. 2012]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_19d56a39;
  skos:prefLabel "riostra de contraviento"@es, "controvento"@it, "contrevent"@fr, "podélný spoj pod krokví přibitý šikmo ke směru okapu"@cs,
    "cross lath"@en, "Rispe"@de;
  skos:altLabel "vaznice"@cs, "queue de vache"@fr, "sprocket"@en, "Windrispe"@de, "zavětrování"@cs;
  skos:broader :c_a9967019, :c_c51fa22d;
  dct:created "2019-05-28T08:48:48.000"^^xsd:dateTime;
  dct:modified "2020-12-01T12:41:15.000"^^xsd:dateTime .

:c_cf69c793 a skos:Concept;
  skos:definition "Bei offenen Sparrenpaaren den Sparrenfuß aufnehmendes Holz. [Eißing et al. 2012]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_19d56a39;
