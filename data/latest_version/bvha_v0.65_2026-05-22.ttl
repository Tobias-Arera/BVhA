:c_81f107fc a skos:Concept;
  skos:definition "Kronleuchter mit Marienstatue, ein Hirschgeweih bildet einen Heiligenschein in Mandorla-Form. [Koch 2009]"@de,
    "Lustr se soškou Panny Marie, jelení parohy vytvářejí svatozář v podobě mandorly. [Koch 2008]"@cs,
    "Ein Kronleuchter mit der Figur der Jungfrau Maria heißt Marienleuchter (m) oder Muttergottesleuchter (m). [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9, :conceptScheme_1f14b4dd;
