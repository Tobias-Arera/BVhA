  dct:modified "2021-01-26T14:05:19.000"^^xsd:dateTime .

:c_c997baa1 a skos:Concept;
  skos:definition "1. Muschelwerk in künstl. Grotten. 2. Muschelformen ähnl., asymmetr. Dekorationselement der Spätbarockzeit, nach dem der ganze Stil auch Rokoko genannt wurde. [Koepf/Binding 2016]"@de,
    "Pozdní renesance - jako rokaj ve francouzském rokoku, charakteristický zvl. pro německé rokoko. [Koch 2008]"@cs,
    "Ornament der Spätrenaissance, als Rocaille im frz., besonders im deutschen Rokoko stil- und namenbildend. [Koch 2009]"@de,
    "Muschelartiges unsymmetrisches Ornament des Spätbarock. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "rocaille"@fr, "mušlový ornament"@cs, "rocaille"@en, "rocaille"@it,
    " rocalla"@es, "Rocaille"@de;
  skos:altLabel "Muschelwerk"@de, "rokaj"@cs, "lasturový ornament"@cs;
  skos:broader :c_298d4e12;
  dct:created "2020-08-11T10:18:24.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:05:47.000"^^xsd:dateTime .

:c_579e2120 a skos:Concept;
  skos:definition "Verzierung mit Diamantierung, hauptsächl. in der roman. Ornamentik. [Koepf/Binding 2016]"@de;
  skos:scopeNote "Romanisches Ornament. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_8c0441f9;
  skos:prefLabel "tête de clou"@fr, "hřebíková hlavička"@cs, " nailhead"@en, " ornamento a capoccia"@it,
    "cabeza de clavo"@es, "Nagelkopf"@de;
  skos:altLabel "tête conjuratoire"@fr, " pointe de diamante"@fr, "hlavičková ozdoba"@cs,
    " punta de diamante"@es;
  skos:broader :c_298d4e12;
  dct:created "2020-08-11T10:27:22.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:05:29.000"^^xsd:dateTime .

:c_3f4fa479 a skos:Concept;
  skos:definition "Symmetr. Abstraktion eines Palmenwipfels als Grundform der Ornamentik. Die P. kann einzeln vorkommen (z.B. Bekrönung von Stelen, Grabdenkmal), wird aber meist wiederholt (Fries, Anthemion). Sie kommt bereits in der babylon. Kunst vor und tritt meist in Verbindung mit Voluten auf. [Koepf/Binding 2016]"@de,
    "Rostlinný ornament z vějířovitých palmovitých listů; spolu s lotosovými květy = antemion; antika a slohy z ní vycházející. [Koch 2008]"@cs,
    "Pflanzenornament aus gefächerten palmenähnlichen Blättern. Zusammen mit Lotosblüten = Anthemion. Antike und abhängige Stile. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "palmette"@fr, "palmeta"@cs, "palmette"@en, " palmetta"@it, " palmeta"@es,
    "Palmette"@de;
  skos:broader :c_20497539;
  dct:created "2020-08-11T11:55:22.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:05:38.000"^^xsd:dateTime .

:c_66851976 a skos:Concept;
  skos:definition "Stilisiertes Blütenornament, z.B. in Fries oder Kassette. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_8c0441f9;
  skos:prefLabel "Rosette (Ornament)"@de;
  skos:altLabel "rozeta"@cs, "růžice"@cs;
