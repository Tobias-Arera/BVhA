:c_2589c418 a skos:Concept;
  skos:definition "Decke, die zwischen zwei Geschossdecken die Raumhöhe unterteilt oder vermindert. Die Z. kann auch begehbar sein, wodurch ein Zwischengeschoss (Entresol, Mezzanin) entsteht. [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Zwischendecke"@de, "cielo falso, techo intermedio"@es, "soppalco"@it,
    "mezistrop"@cs, "false ceiling"@en;
  skos:altLabel "Zwischenboden"@de;
  skos:broader :c_1fcb2666;
  skos:narrower :c_9ea8aa99;
  dct:created "2020-08-03T12:17:33.000"^^xsd:dateTime;
  dct:modified "2020-12-01T14:57:09.000"^^xsd:dateTime .

:c_d53d0558 a skos:Concept;
  skos:definition "ARTESONADO, španělský název pro maurské táflované stropy a dveře složené z četných, často barevných kusů dřeva, které vytvářejí umělecky proplétané geometrické vzory se zahloubenými poli (artesón = mísa), rovněž ze štuku. [Koch 2008] "@cs,
    "Spanischer Name für maurische Täfeldecken und -türen aus zahlreichen, oft farbigen Hölzern, die kunstvoll verschlungene geometrische Muster mit vertieften Feldern (artesón = Becken) bilden. Auch aus Stuck. [Koch 2009]"@de,
    "Artesonado, span. Bezeichnung für das kunstvolle Täfelwerk maur. Decken und Türen, bestehend aus vielen Hölzern, die zu geometr. Mustern mit vertieften Feldern (artesón: Becken) zusammengefügt sind. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "Artesonado"@de, "artesonado"@cs;
  skos:broader :c_1fcb2666;
  dct:created "2020-08-03T12:49:12.000"^^xsd:dateTime;
  dct:modified "2020-09-02T15:01:20.000"^^xsd:dateTime .

:c_891789ec a skos:Concept;
  skos:definition "Stahlbetonplatte ohne Unterzüge, die mit ihren oben pilzförmig verbreiterten Stützen (Pilzsäulen) biegesteif verbunden ist. [Koepf/Binding 2016]"@de,
    "Železobetonový strop bez průvaků, který nesou hřibové sloupy. [Koch 2008]"@cs, "Von Pilzsäulen getragene Stahlbetondecke ohne Unterzüge. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9;
  skos:prefLabel "plancher champignon"@fr, "hřebový strop"@cs, " mushroom floor"@en,
    " solaio a fungo"@it, " techo macizo sobre soportes con forma de hongo"@es, "Pilzdecke"@de;
  skos:broader :c_1fcb2666;
  dct:created "2020-08-11T13:08:46.000"^^xsd:dateTime;
  dct:modified "2020-11-23T16:08:52.000"^^xsd:dateTime .

:c_6ec14370 a skos:Concept;
  skos:definition "Eine Decke, deren mittleres Feld (Deckenspiegel) von Profilen gerahmt ist. Der Übergang zur Wand erfolgt mittels Kehlen (Deckenkehle, Voute) oder mit einem Deckengesims. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
