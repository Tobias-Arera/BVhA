:c_45590240 a skos:Concept;
  skos:definition "Waagerechtes Holz zwischen Stützen gezapft oder über Stützen geblattet; man unterscheidet Schwellr., Geschossr., Sturzr., Kopfr., Rähmr., Brustr. [Koepf/Binding 2016]"@de,
    "Riegel: horizontal zwischen vertikalen oder schräg verlaufenden Hölzern eingespanntes Holz.  (Eißing et al. 2012)"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe;
