:c_f203c4ff a skos:Concept;
  skos:scopeNote "Das 2. Vatikanische Konzil wurde am 11. Oktober 1962 von Papst Johannes XXIII. einberufen und tagte nach Johannes Tod\\' 1963 unter seinem Nachfolger Paul VI. bis zum 8. Dezember 1965. Kern des reformorientierten Konzils war die Anpassung verschiedener katholischer Dogmen an den Zeitgeist, dazu zählten auch umfangreiche Liturgiereformen wie die Feier der Heiligen Messe in Landessprache sowie deren Zelebration verso populum. "@de;
  skos:inScheme :conceptScheme_7816b346;
  skos:prefLabel "2. Vatikanisches Konzil"@de;
  skos:broader :c_dec6f7ce;
  skos:related :c_3f6abb92;
  dct:created "2020-01-16T09:49:32.000"^^xsd:dateTime;
  dct:modified "2020-01-16T10:00:48.000"^^xsd:dateTime .

:c_665d3978 a skos:Concept;
  skos:definition "Weihe f; Weihesakrament n; Konsekration f; ostk. Cheirotonie f; gr. cheirotonia; lat. sacramentum ordinis ; benedictio constitutiva ; russ. chirotonija: das Sakrament der Einführung, Ordination (f), zu einem klerikalen Amt (Diakon, Priester, Bischof). - Im weiteren Sinne auch die Aussonderung einer Sache aus dem profanen Gebrauch durch eine konstitutive Segnung. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "ordination"@fr, "sacramentum ordinis"@la, "cheirotonia"@el, "Orders"@en,
    "chirotonija"@ru, "Weihesakrament (katholisch)"@de;
  skos:altLabel "Konsekration"@de, "Weihe"@de, "sacrement de consécration"@fr, "sacrament of Consecration "@en,
    "Cheirotonie"@de, "benedictio constitutiva"@la;
  skos:broader :c_c5c22822;
  skos:related :c_6fd46e6e;
  dct:created "2020-04-05T15:09:56.000"^^xsd:dateTime;
  dct:modified "2021-01-15T17:38:52.000"^^xsd:dateTime .

:c_f9845cfb a skos:Concept;
  skos:definition "Pontifikale n, Pontificale romanum n, liber pontificalis, liber episcopalis, liber ministerialis, ordinarium episcopi: Buch mit den Texten und rituellen Anweisungen für alle den Bischöfen obliegenden liturgischen Funktionen (Firmung und Ordination, Weihe und Benediktion von Personen und Sachen, Visitationen usw.); zu unterscheiden vom Liber pontificalis als der Lebensbeschreibung von Päpsten. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "Pontifikale"@de, "pontifical"@fr, "liber pontificalis"@la, "pontifikál"@cs;
  skos:altLabel "liber episcopalis "@la, "liber ministerialis"@la, "ordinarium episcopi"@la,
    "Pontificale romanum"@de;
  skos:broader :c_6ca61a95;
  skos:related :c_6fd46e6e, :c_fdf5a8a5, :c_95f55db6, :c_05f49e3c, :c_1b2278c2, :c_d9611b38;
  dct:created "2020-05-22T09:32:34.000"^^xsd:dateTime;
  dct:modified "2021-01-23T16:39:45.000"^^xsd:dateTime .

