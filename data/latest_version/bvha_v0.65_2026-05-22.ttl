:c_16727c46 a skos:Concept;
  skos:definition "Kuppelreliquiar n: ein Reliquienbehälter, der als Modell eines kuppelüberwölbten Zentralbaus gestaltetist. Beispiel: das Anastasiusreliquiar (Antiochien, 10. Jh.) im Aachener Domschatz. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "reliquaire dômical"@fr, "cupola-reliquary"@en, "Kuppelreliquiar"@de;
  skos:broader :c_00ddac7b;
  dct:created "2020-09-03T20:23:06.000"^^xsd:dateTime;
  dct:modified "2020-09-03T20:25:16.000"^^xsd:dateTime .

:c_035bb3a5 a skos:Concept;
  skos:definition "Dornenkronenreliquiar n: ein Behälter für Partikel der Dornenkrone Christi. Beispiel: in der Kathedrale von Namur um 1210. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "reliquaire de la Sainte-Epine"@fr, "reliquary of the Crown of Thorns "@en,
    "Dornenkronenreliquiar"@de;
  skos:broader :c_a2b4b7b1;
  skos:related :c_a974836d;
  dct:created "2020-09-03T16:26:16.000"^^xsd:dateTime;
  dct:modified "2020-09-03T16:41:35.000"^^xsd:dateTime .

:c_a974836d a skos:Concept;
  skos:definition "Dornenkrone f: die aus Zweigen mit Dornen geflochtene Krone, die Christus zum Spott tragen musste. Sie wurde als große Reliquie in der Sainte Chapelle zu Paris verwahrt. Einzelne Dornen werden noch an vielen anderen Orten verehrt. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8;
  skos:prefLabel "Couronne d\\'Epines"@fr, "Crown of Thorns"@en, "Dornenkrone Christi (Reliquie)"@de;
  skos:broader :c_16d20867;
  skos:related :c_035bb3a5;
  dct:created "2020-09-03T16:40:03.000"^^xsd:dateTime;
  dct:modified "2021-01-27T11:42:27.000"^^xsd:dateTime .

:c_f519fa75 a skos:Concept;
  skos:definition "Fläschchenreliquiar n; auch Ampullenreliquiar n; lat. ampulla; flasca: ein Reliquienbehälter aus Glas oder Ton in Form einer kleinen Flasche oder einer Ampulle, oft auf einem Fuß oder Untersatz montiert und manchmal mit einem Tragring am Flaschenhals versehen. Eine Sonderform sind die sogenannten Blutampullen (f pl), Behältnisse für das Blut von Märtyrern. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "ampulla"@la, "ampoule-reliquaire"@fr, "phial-reliquary"@en, "Fläschchenreliquiar"@de;
  skos:altLabel "fiole-reliquaire"@fr, "Ampullenreliquiar"@de, "flasca"@la;
  skos:broader :c_a2b4b7b1;
  skos:narrower :c_0424fd46;
  dct:created "2020-09-03T16:52:17.000"^^xsd:dateTime;
  dct:modified "2020-09-03T16:57:47.000"^^xsd:dateTime .

:c_39ff5719 a skos:Concept;
  skos:definition "Kokosnussreliquiar n: die Schale einer Kokosnuss als Reliquienbehälter. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "reliquaire en noix de coco"@fr, "coconut-reliquary"@en, "Kokosnussreliquiar"@de;
