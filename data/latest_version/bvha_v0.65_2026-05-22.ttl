  dct:modified "2021-01-30T23:57:36.000"^^xsd:dateTime .

:c_03c233d0 a skos:Concept;
  skos:definition "Reliquientranslation f; Reliquienübertragung f; Translation f; lat. translatio reliquiarum; translatio cadaveris ad ecclesiam : die feierliche Überführung von Reliquien eines Heiligen nach ihrer Erhebung aus dem ursprünglichen Grab an einen anderen Ort zum Zwecke der Umbettung in ein Altargrab, einen ReliquienaItar oder ein Ehrengrab (seit 4. Jh.). Erhebung und Translation waren aus mehreren Gründen notwendig: zunächst mußten die Reliquien vor Überfällen, Raub und Diebstahl geschützt werden, denn sie galten als begehrte Kriegsbeute; außerdem brachte die Vorschrift, dass in jedem geweihten Altar eine Reliquie ruhen müsse, einen großen Bedarf an Reliquien bzw. Reliquiaren mit sich. Die erste datierte Überführung eines Heiligen, die des ungeteilten Leibes des hl. Babylos, erfolgte im Jahre 354 von Antiocheia nach Daphne. Die feierliche Translation eines Leichnams oder einer Reliquie von einem Begräbnisort zum anderen wird als Fest gefeiert, gleich den Natales, den Todestagen der Märtyrer. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "translation de reliques"@fr, "translation of relics"@en, "Reliquientranslation"@de,
    "translatio reliquiarum"@la;
  skos:altLabel "translatio cadaveris ad ecclesiam"@la, "Translation"@de, "Reliquienübertragung"@de;
  skos:broader :c_a2dc7eed;
  skos:related :c_1b7de933, :c_57226acf, :c_be0bea02;
  dct:created "2020-09-27T14:52:59.000"^^xsd:dateTime;
  dct:modified "2021-01-15T17:34:51.000"^^xsd:dateTime .

:c_9c9bc5b1 a skos:Concept;
  skos:definition "Rekondition f; lat. reconditio: die feierliche Einschließung von Reliquien in das Altargrab bei der Altarweihe durch den Bischof (vorgeschrieben im Ordo der Konsekration, jedoch nicht für die orthodoxen Kirchen, deren Altäre keine Reliquien enthalten müssen). [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "reposition des reliques"@fr, "reposition of relics"@en, "Rekondition"@de,
    "reconditio"@la;
  skos:broader :c_a2dc7eed;
  skos:related :c_1b7de933, :c_be0bea02;
  dct:created "2020-09-27T16:12:48.000"^^xsd:dateTime;
  dct:modified "2021-01-15T17:34:28.000"^^xsd:dateTime .

:c_1d666449 a skos:Concept;
  skos:definition "Altargerät nennt man die Gesamtheit aller jener liturgischen Geräte, welche bei den am Altar sich vollziehenden gottesdienstlichen Verrichtungen, der nur auf ihm zulässigen eucharistischen Opferfeier, den mit dieser verbundenen feierlichen Segnungen (Kerzen-, Asche-, Palmweihe) und den feierlichen Aussetzungen des Allerheiligsten, zur Verwendung kommen. Sie haben entweder die Eigenschaft eines „heiligen Geräts“ (vasa sacrum) oder lediglich die eines liturgischen. [RDK Labor]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_cf792a3c;
  skos:prefLabel "vybavení oltáře"@cs, "Altargerät (katholisch)"@de, "arredi sacri"@it,
    "garniture d\\'autel "@fr, "altar furniture"@en;
  skos:broader :c_ef163f2f, :c_uv43etgj;
  skos:narrower :c_17d46f99, :c_af38f5d3;
  skos:related :c_c9e20fdd, :c_wyccl4ls;
  dct:created "2020-02-23T17:44:34.000"^^xsd:dateTime;
  dct:modified "2021-01-24T14:46:44.000"^^xsd:dateTime .

:c_8c8035ef a skos:Concept;
  skos:definition "Offertorium n, Oblationsvelum n, velum offertorii, velum subdiaconale: zunächst ein weißes Tuch, in dem die Gläubigen ihre Gaben zum Altar brachten; etwa seit dem 13. Jh. das Tuch, mit dem die Patene verhüllt und vom Subdiakon von der Kredenz zum Altar getragen wird. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "mappula"@la, "Oblationsvelum"@de, "mappula"@cs, "voile d\\'offertoire"@fr,
    "offertory veil"@en;
  skos:altLabel "manipul"@cs, "Offertorium"@de, "Oblationstuch"@de, "voile d\\'offrande"@fr,
    "voile d\\'oblation "@fr, "velum offertorii"@la, "velum subdiaconale"@la, "oblation veil"@en;
  skos:broader :c_ce128b66, :c_02fc3080;
  skos:related :c_c22ee248, :c_ea59b5fa, :c_2348f657, :c_wyccl4ls;
  dct:created "2020-05-20T17:41:45.000"^^xsd:dateTime;
  dct:modified "2021-01-24T16:19:32.000"^^xsd:dateTime .

:c_213ea7b0 a skos:Concept;
  skos:definition "Altarbehang m, Altarvelum n, auch Altarvorhang m, velum, cortina, aulea: im Altarraum an Stangen, Schnüren oder beweglichen Armen befestigter Vorhang; zu unterscheiden vom Antependium. [Glossarium Artis]"@de;
