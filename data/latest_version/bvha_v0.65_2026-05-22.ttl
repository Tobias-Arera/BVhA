:c_2e71411d a skos:Concept;
  skos:definition "Quadratischer Nimbus für noch lebende Personen mit besonderer priesterlicher oder aristokratischer Würde (6. Jh. bis zur Gotik). [Koch 2009]"@de,
    "Čtvercový nimbus u dosud žijících osob se zvl. církevní nebo aristokratickou hodností (od 6. stol. po gotiku). [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_37522b74,
