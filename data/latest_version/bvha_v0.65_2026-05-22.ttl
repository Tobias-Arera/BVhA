  skos:broader :c_469133b1;
  dct:created "2020-08-05T13:51:32.000"^^xsd:dateTime;
  dct:modified "2021-01-26T22:48:55.000"^^xsd:dateTime .

:c_2c394961 a skos:Concept;
  skos:definition "Labyrinth (griech. labyrinthos, von labrys = Doppelaxt, kretisch-minoisches Kultsymbol; der Palast von Knossos mit seinem unübersichtlichen Grundriss hieß » Haus der Doppelaxt« und gilt als ein Urbild aller Labyrinthe), Jerusalemsweg, in den Fußboden mancher gotischer Kathedralen eingelegte geometrische Figur aus hellen und dunklen Steinen. Diesen Weg durchrutschten die Gläubigen als Bußübung auf den Knien von der Peripherie bis zur Mitte. Labyrinthe mit ausweglosen Weggabelungen gibt es erst seit dem Manierismus, z.B. bei labyrinthischen Gartenbosketts. [Koch 2009]"@de,
    "Labrys = dvojitá sekera, krétsko-minojský kultovní symbol; palác v Knossu, s nepřehledným půdorysem se nazýval „Dům dvojité sekery\" a je považován za prototyp všech labyrintů), Jeruzalémská pouť, geometrický obrazec ze světlých a tmavých kamenů v podlaze některých gotických katedrál; touto cestou se věřící vkleče posunují od okraje až do středu na znamení pokání. Labyrinty se slepými odbočkami existují teprve od doby manýrismu, např. v labyrintových zahradních bosketech. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "labyrinthe"@fr, "labyrint"@cs, "labyrinth"@en, "labirinto"@it, " laberinto"@es,
    "Labyrinth (Ausstattung)"@de;
  skos:altLabel "Jerusalemsweg"@de, "jeruzalémská pouť"@cs;
  skos:broader :c_klbrisjd;
  dct:created "2020-08-05T14:00:01.000"^^xsd:dateTime;
  dct:modified "2021-01-31T00:20:59.000"^^xsd:dateTime .

:c_3c777f39 a skos:Concept;
  skos:definition "1. Stil der von Jesuiten in Lateinamerika gebauten Barockkirchen. Oft dekorativ überladen; 2. an das Muster von II Gesu in Rom angelehnter Barockstil der Jesuitenkirchen besonders des 17. Jhs. [Koch 2009]"@de,
    "1. Sloh barokních kostelů postavených jezuity v Latinské Americe, často přebujelý dekor. 2. Barokní sloh jezuitských kostelů vycházející ze stylu kostela II Gesu v Římě, zvl. v 17. stol. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9;
  skos:prefLabel "Jesuitenstil"@de, "jezuitský sloh"@cs;
  skos:broader :c_6uazz5qx;
  dct:created "2020-08-05T14:01:11.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:14:28.000"^^xsd:dateTime .

