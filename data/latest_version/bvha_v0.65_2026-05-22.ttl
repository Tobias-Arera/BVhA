:c_5d272114 a skos:Concept;
  skos:definition "Ornament aus streng stilisierten Pflanzen, islamisch nach hellenistischen Vorbildern, seit der Renaissance wieder angewandt. Vgl. Arabeske. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_8c0441f9;
  skos:prefLabel "mauresque"@fr, "maureska"@cs, " arabesque"@en, "arabesco moresco"@it,
    "morisco"@es, "Maureske"@de;
