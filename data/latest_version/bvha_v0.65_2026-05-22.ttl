  skos:broader :c_17d46f99;
  skos:related :c_b6b48d98;
  dct:created "2020-07-28T10:13:10.000"^^xsd:dateTime;
  dct:modified "2021-01-24T14:50:15.000"^^xsd:dateTime .

:c_537a4197 a skos:Concept;
  skos:definition "Hostiensieb n: ein Sieb aus Porzellan oder Email, dessen Öffnungen so groß sind, dass noch eine Drittelhostie hindurchfällt. Das von der Sakramentenkongregation vorgeschriebene Gerät dient dazu, schadhafte Hostien auszusondern. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "crible à hosties"@fr, "riddle for hosts"@en, "Hostiensieb"@de;
  skos:broader :c_17d46f99;
  skos:related :c_b6b48d98;
  dct:created "2020-07-28T10:32:07.000"^^xsd:dateTime;
  dct:modified "2021-01-24T14:50:42.000"^^xsd:dateTime .

:c_bf623a2f a skos:Concept;
  skos:definition "Ablutionskelch m; auch Spülkelch m: ein nicht konsekrierter Kelch für den nicht konsekrierten Ablutionswein (m), mit dem der Kelch ausgespült wurde und der nach der Kommunion unter einer Gestalt gereicht wird. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
