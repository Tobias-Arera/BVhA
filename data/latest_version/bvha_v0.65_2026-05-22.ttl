:c_5d9b780a a skos:Concept;
  skos:definition "Erkerartiger, gemauerter oder hölzerner Vorbau mit Schießscharten, auch mit Senkscharten, ähnl. dem auf der Ecke angebrachten und zumeist höheren Scharwachtturm [Koepf /Binding 2016]. "@de,
    "Unten offener Erker an der Feldseite der Wehrmauer oder eines Gebäudes, häufig über dem Tor, um den Feind von oben direkt zu bekämpfen (z. B. durch Steinwürfe). Aufgrund der im 19. Jh. aufgekommenen irrigen Vorstellung, man hätte heißes Pech aus ihnen gegossen, häufig fälschlich als »Gusserker« (»Pechnase«) mit »Gussloch« bezeichnet. Im Scheitel eines Torgewölbes hat der W. eher die Funktion einer Kommunikationsöffnung (Marksburg RP), da durch solch kleine Öffnungen keine effektive Bekämpfung eingedrungener Angreifer möglich war. S. a. Maschikuli. M. L. [Wörterbuch der Burgen, Schlösser und Festungen]"@de,
    "Ausschuss, Schießerker, Wehrerker, hölzerne, erkerartig überkragende Maueraufbauten mit Schießscharten. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_50ec0c5e, :conceptScheme_1d7ba54b;
  skos:prefLabel "salidizo de tiro"@es, "bertesca"@it, "Schießerker"@de;
  skos:altLabel "Wehrerker"@de, "Schusserker"@de, "Ausschuss"@de;
  skos:broader :c_dd883e1f, :c_70f41797;
  skos:narrower :c_bdf7b7aa, :c_b9e0a442;
  dct:created "2020-04-28T15:04:36.000"^^xsd:dateTime;
  dct:modified "2021-01-27T14:32:23.000"^^xsd:dateTime .

:c_2ab38035 a skos:Concept;
  skos:definition "Besonders an den Wohnhäusern der niedersächsischen Renaissance üblicher erkerartiger Vorbau des Erdgeschosses oder mehrerer Geschosse an einer oder beiden Seiten der Haustür. [Koch 2009]"@de,
    "Auslucht, 1. Auch Utlucht, an Renaissancebauten Niedersachsens ein vom Erdboden aufsteigender, meist mehrgeschossiger, erkerartiger Vorbau an einer oder zu beiden Seiten der Haustüre. 2. Über einem Seitenschiffjoch errichteter Querdachgiebel, bes. an got. Kirchen Ostdeutschlands (Lucht). [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_8c0441f9;
  skos:prefLabel "Auslucht"@de, "arkýřový výstupek"@cs;
  skos:altLabel "Utlucht"@de;
  skos:broader :c_70f41797;
  dct:created "2020-08-03T13:34:57.000"^^xsd:dateTime;
  dct:modified "2021-01-22T12:27:12.000"^^xsd:dateTime .

:c_0f3a18fa a skos:Concept;
  skos:definition "Aus dem stehenden Dachfenster entwickelter, in der Höhe der Trauflinie aufsteigender Dachaufbau, dessen Vorderseite bündig mit der Außenfläche des Gebäudes liegt (Lukarne). [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Dacherker"@de;
  skos:broader :c_70f41797, :c_90e65d89;
  skos:narrower :c_f70f0624;
  dct:created "2020-08-06T12:07:21.000"^^xsd:dateTime;
  dct:modified "2021-01-22T12:27:29.000"^^xsd:dateTime .

:c_e9ec683c a skos:Concept;
  skos:definition "Auslugerker, Eckerker, heißen die Erker an Gebäudeecken (im Unterschied zu den Erkern an der Gebäudewand). [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
