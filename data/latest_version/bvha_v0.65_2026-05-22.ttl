:c_6de4ace6 a skos:Concept;
  skos:scopeNote "Dachform, deren Dachfläche in Form von vier Rhomben (Rauten) zwischen vier Giebeln den Abschluss bildet. [Koepf/Binding 2016]"@de,
    "Romboid, složená z kosočtvercových střešních rovin. [Koch 2008]"@cs, "Rhombendach, Dach auf Türmen, dessen Dachflächen ein gleichseitiges, schiefwinkliges Parallelogramm bilden. [Koepf / Binding 2016]"@de,
    "Steigen über den Giebelspitzen eines Kreuzdaches Grate zu einer gemeinsamen Spitze auf, so dass sich dazwischen Rhombenflächen bilden, entsteht das Rhomben- oder Rautendach. [Eißing et al. 2012]"@de,
    "Rautendach, aus rautenförmigen Dachseiten zusammengesetzt. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9, :conceptScheme_19d56a39;
  skos:prefLabel " comble rhomboïdal"@fr, "routová střecha"@cs, " lozenge roof"@en,
    " tetto a falde romboidali"@it, " techo romboidal"@es, "Rhombendach"@de;
  skos:altLabel "Rautendach"@de, " rhomboid roof"@en, "helm roof"@en;
