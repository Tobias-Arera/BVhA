:c_e550edf7 a skos:Concept;
  skos:definition "1. Auf Pfählen gegründete Bauten (Pfahlgründung) bei schlechtem Baugrund. 2. Der P. kommt bereits in vorgeschichtl. Zeit und bei Naturvölkern der Gegenwart vor und wurde sowohl bei Vorrats- als auch bei Wohngebäuden angewandt, um diese vor Tieren zu schützen vielleicht auch zur Verteidigung. P.ten stehen daher auch oft in flachen Ufergewässern. [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c8a571d9;
  skos:prefLabel " palafitte"@fr, "nákolní stavba"@cs, "pile construction"@en, " palafitta"@it,
    "palafito"@es, "Pfahlbau"@de;
  skos:altLabel "pile work"@en, "construction lacustre"@fr, "kolová stavba"@cs;
  skos:broader :c_d6f572a5;
  dct:created "2020-08-24T15:29:48.000"^^xsd:dateTime;
  dct:modified "2021-01-26T23:25:31.000"^^xsd:dateTime .

:c_ff77b7dd a skos:Concept;
  skos:definition "(prakrit.) Aus dem Stupa der buddhist. Baukunst Ostasiens weiterentwickelter Stockwerksbau auf quadrat. oder polygonalem Grundriss. Die meist ungerade Zahl der Stockwerke beträgt zwischen drei und neun. Die oft geschwungenen und manchmal auch mit Glocken besetzten Dächer springen weit vor. Die P. ist ein umschreitbares Heiligtum und kann isoliert, aber auch in Verbindung mit anderen Bauten einer buddhist. Tempelanlage stehen. Der Begriff P. wird auch für turmähnl. Bauten ind. bzw. hinterind. Tempel verwandt. [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_c8a571d9;
  skos:prefLabel "Pagode"@de;
  skos:broader :c_ceec0c04, :c_a2025113;
  dct:created "2020-08-25T13:30:30.000"^^xsd:dateTime;
  dct:modified "2021-01-26T23:21:47.000"^^xsd:dateTime .

