  dct:created "2019-10-22T12:19:29.000"^^xsd:dateTime;
  dct:modified "2019-10-22T12:22:05.000"^^xsd:dateTime .

:c_20d6acf2 a skos:Concept;
  skos:definition "Ausführung des Fugenschnittes an den Wölbsteinen und die reliefartige Hervorhebung der Vorderseite der Werksteine. [Glossarium Artis]"@de,
    "Bogenquaderung, 1. Durchführung des Fugenschnitts von Bogensteinen, wobei spitze Winkel möglichst vermieden werden und ein gutes Einbinden der Bogensteine in das übrige Mauerwerk gewährleistet werden soll. 2. Betont reliefartige Hervorhebung der Stirnfläche der einzelnen Bogensteine (Bosse, Rustika). [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "paring of voussoirs"@en, "dressage des claveaux"@fr, "Bogenquaderung"@de;
  skos:broader :c_cdfab687;
  dct:created "2019-10-22T12:25:40.000"^^xsd:dateTime;
  dct:modified "2020-09-04T15:56:26.000"^^xsd:dateTime .

:c_4651f983 a skos:Concept;
  skos:definition "Schmückendes oder auch als Wasserschlag dienendes Gesims über einem Bogen. [Glossarium Artis]"@de,
    "Též nadokenní římsa. Trojúhelníkový, segmentový, prolomený (též roztržený), zalomený nebo volutový štít nad oknem nebo dveřmi. [Koch 2008]"@cs;
  skos:scopeNote "Oft eher funktional als Wasserschlag dienend und meist deutlich weniger kräftig ausgebildet als ein → Gesimsbogen (letzterer eher dekorativ)."@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_37522b74, :conceptScheme_1f14b4dd;
  skos:prefLabel "arch hoodmold"@en, "Bogenverdachung"@de, "fronton (oblouk)"@cs, "entablement de l\\'arc"@fr;
  skos:broader :c_cdfab687, :c_01e49620, :c_fddb0e6d;
  dct:created "2019-10-22T12:34:04.000"^^xsd:dateTime;
  dct:modified "2025-11-09T16:25:56"^^xsd:dateTime;
  :broaderByPosition :c_01e49620 .

:c_01e49620 a skos:Concept;
  skos:definition "Sims, aus der Mauer hervortretender waagerechter Streifen zur Betonung der waagerechten Bauabschnitte. 1. Sockel-Gesims, oberes Abschlussprofil am Sockel; 2. Gurt-Gesims zwischen den Geschossen; 3. Kaff-, Kapp-Gesims (Gotik), abgeschrägtes (gekapptes) Gesims, läuft unter den Fenstern hin und wird um die Strebepfeiler (Strebewerk) herumgekröpft; 4. Kranz-, Haupt-Gesims (im griechischen Tempelbau = Geison) zwischen Wand und Dach oder Attika. Oft durch Kragsteine (Konsolen) gestützte, weit ausladende Hängeplatte mit Wasserschräge darüber und Wassernase (Tropfleiste, die die Fassade vor Wasser schützt) darunter; 5. je nach Bauteil auch Tür-, Fenster-Gesims. Verkröpft (gekröpft) ist ein Gesims, wenn es mit seinem ganzen Profil winklig um Mauervorsprünge herumgeführt ist = Verkröpfung. [Koch 2009]"@de,
    "Vodorovný pas vystupující ze zdi a zdůrazňující vodorovné úseky stavby. [Koch 2008]"@cs,
    "Gesims, Sims, ein meist horizontales Bauelement, das eine Außenwand in einzelne Abschnitte gliedert. Die Grundform der G.e sind vorspringende Platten mit waagerechter Begrenzung, die aber auch schräge Abdeckflächen haben (Schrägg.) oder manchmal unterschnitten sind (Kaffg., Wasserschlag). G.e können an ihrer Unterseite durch wulstartige Zierformen (Kyma, Astragal) geschmückt oder durch Konsolen (Konsolgesims) unterstützt sein. Je nach Lage unterscheidet man Sockel- oder Fußg. an einem Unterbau, Gurt- bzw. Stockwerksg. (Kordong.), Fensterbankg. und das abschließende Dachg. (Hauptg., Schlussg.). Eine Sonderform des Dachgesimses ist das beim Tempel- und Palastbau vorkommende, stark ausladende Kranzgesims, das konstruktiv noch zur Außenwand gehört und meist als Konsolg. ausgebildet ist. Das Giebelg. läuft schräg entlang der Giebellinie. Als Kehlg. bezeichnet man das unterhalb einer Deckenkehle (Voute) verlaufende G., aber auch die gesimsartige Ausbildung des Dachbruchs eines Mansarddachs. Bei Verschalung vorstehender Balkenköpfe entsteht das Balkengesims. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "Gesims"@de, "římsa"@cs;
  skos:altLabel "Sims"@de;
  skos:broader :c_6975d802;
