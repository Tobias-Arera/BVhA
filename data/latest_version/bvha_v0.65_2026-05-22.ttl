  dct:modified "2021-01-23T13:39:59.000"^^xsd:dateTime .

:c_ba2943ba a skos:Concept;
  skos:definition "Überhang m, auch Leiste f, aurifrisium, praetexta: aus Seide oder anderem kostbarem Stoff bestehender, mit Gold- oder Seidenfransen besetzter, schmaler Zierstreifen entlang der Vorderkante der Mensa; heute oft nur noch ein Zierbörtchen. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
