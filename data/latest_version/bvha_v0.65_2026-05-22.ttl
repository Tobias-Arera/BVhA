  dct:created "2020-03-03T17:05:33.000"^^xsd:dateTime;
  dct:modified "2021-01-23T13:43:58.000"^^xsd:dateTime .

:c_d8d9a3e1 a skos:Concept;
  skos:definition "Habitus m pianus, lat.: Kleidung von Prälaten bei festlichen Anlässen: Kollar und schwarze Soutane, deren Futter, Saum, Nähte und Knöpfe violett sind bzw. violett abgesetzt sind. Dazu kommen Ferraiolo, Pileolus, Birett und Brustkreuz, für Bischöfe noch die Zimarra. Diese recht komplizierte Kleiderordnung ist seit 1969 vereinfacht. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "abito piano"@fr, "academic dress"@en, "Habitus pianus"@de, "abito piano"@cs;
  skos:altLabel "habit piano"@fr, "abito piano"@en;
