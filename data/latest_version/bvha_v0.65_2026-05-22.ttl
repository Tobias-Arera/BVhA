:c_93d6ca6a a skos:Concept;
  skos:definition "Ein natürlicher oder künstlich geschaffener Hohlraum in Felsen, der mit Zeichnungen, Malereien, Skulpturen und/oder eingeritzten Gravuren verziert sein kann. [EwaGlos]"@de,
    "A natural or man-made cavity in rocks which may be decorated with drawings, paintings, sculpture, and/or scratched engravings. [EwaGlos]"@en;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c8a571d9,
    :conceptScheme_ec8c77bf;
  skos:prefLabel "cave"@en, "jeskyně"@cs, "Höhle"@de;
  skos:broader :c_109ed874;
  dct:created "2019-05-07T17:22:08.000"^^xsd:dateTime;
  dct:modified "2021-01-26T22:56:52.000"^^xsd:dateTime .

:c_101c9261 a skos:Concept;
  skos:definition "Grotte (ital. grotta), künstl. errichtete Höhle, die in der Gartenarchitektur der Renaissance und der Barockzeit eine große Rolle spielt. Manchmal wurde auch die Sala terrena barocker Schlösser mit G.nwerk zur G. ausgestaltet. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_c8a571d9;
  skos:prefLabel "Grotte"@de;
  skos:broader :c_a96c6abc;
  dct:created "2020-09-30T09:03:35.000"^^xsd:dateTime;
  dct:modified "2021-01-26T22:57:09.000"^^xsd:dateTime .

:c_3d5a6c23 a skos:Concept;
  skos:definition "Mauerwerk aus getrockneten, ungebrannten, handgefertigten Lehmziegeln, die  aus  einer  Mischung  aus  Lehm,  Sand, Schluff und kleinen Mengen Stroh (oder anderen Fasermaterialien) sowie Wasser angefertigt werden. Das Rohmaterial kann auch als Verputzmaterial benutzt werden. [EwaGlos]"@de,
    "Unfired clay masonry made of sun-dried handmade bricks that are formed from a mixture of clay soil, sand, silt and a small amount of straw (or other fibrous materials), and water. The raw material can also be used as a plastering material. [EwaGlos]"@en;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_ec8c77bf;
  skos:prefLabel "Brique de terre crue"@fr, "adobe"@en, "Lehmziegelmauerwerk "@de;
  skos:altLabel "Adobe (Mauerwerk)"@de;
  skos:broader :c_k1vkpmvw;
  dct:created "2019-05-07T17:34:39"^^xsd:dateTime;
  dct:modified "2025-12-08T17:54:26"^^xsd:dateTime;
  :broaderByConstructionMaterial :c_k1vkpmvw .

:c_e6f0e9cc a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe;
  skos:prefLabel "Putzoberflächengestaltung"@de, "úprava povrchu omítky"@cs;
  skos:broader :c_a1b21914;
  skos:narrower :c_3b683e1f, :c_7303a46f, :c_4ba459b4, :c_11561872, :c_a1ae099d, :c_0fba563a,
