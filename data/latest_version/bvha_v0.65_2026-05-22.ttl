:c_f45c8063 a skos:Concept;
  skos:definition "Kolossalordnung (griech. kolossos = Riesenbildsäule), Säulenordnung, die über mehrere, meist zwei Stockwerke greift. Von Michelangelo und Palladio entwickelt. [Koch 2009]"@de,
    "Řec. kolossos = obrovitá socha. Sloupový řád, který zasahuje více než jedno patro, většinou dvě, rozvinut Michelangelem a Palladiem. [Koch 2008] "@cs,
    "Gliederung einer Fassade mit Pilastern oder Säulen der antiken Ordnungen, die über mehrere Stockwerke reicht. Michelangelo hat in der Spätrenaissance das geschossweise Aufeinandersetzen der Fassaden aufgegeben und die K. entwickelt. Besondere Bedeutung hat die K. im Schlossbau der Barockzeit, weil mit ihr besondere Gebäudeteile hervorgehoben werden konnten (Schloss Weißenfels / Pommersfelden BY). B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_57be8ee8, :conceptScheme_37522b74, :conceptScheme_8c0441f9, :conceptScheme_1d7ba54b;
  skos:prefLabel "Kolossalordnung"@de, "vysoký řád"@cs;
  skos:broader :c_4bd3aa19, :c_40b99f7d;
  dct:created "2020-07-27T14:47:23.000"^^xsd:dateTime;
  dct:modified "2021-01-19T11:08:31.000"^^xsd:dateTime .

:c_40b99f7d a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8;
  skos:prefLabel "Fassadenordnung"@de;
  skos:broader :c_eea86d94;
  skos:narrower :c_f45c8063;
  dct:created "2020-08-04T13:21:43.000"^^xsd:dateTime;
  dct:modified "2021-01-15T17:51:04.000"^^xsd:dateTime .

:c_c7fc4903 a skos:Concept;
  skos:definition "Blendfassade, Scheinfassade, Fassade, die einem andersartigen, meist unschönen oder in seinen Proportionen bzw. in seiner Gestaltung ästhet. nicht befriedigenden Baukörper vorgelagert ist. Die B. kann größer oder kleiner als der dahinter liegende Baukörper sein und braucht dessen Querschnitt (Blendgiebel), Geschosseinteilung, Fensterteilung, Konstruktion und Material nicht zu übernehmen (Vorhangfassade). [Koepf / Binding 2016]"@de,
    "Průčelí, které je dekorativně předsazeno před proporčně neuspokojivě stavbu, často tuto stavbu přesahuje buď bočně, nebo výškou ( = předsazený štít). [Koch 2008]"@cs,
    "Fassade, die einem unbefriedigend proportionierten Bau dekorativ vorgeblendet ist. Sie überragt diesen oft seitlich oder in der Höhe ( = vorgeschildet). [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "Blendfassade"@de, "slepé průčelí"@cs;
  skos:broader :c_4bd3aa19;
  skos:related :c_6f51345a;
  dct:created "2020-08-03T15:44:18.000"^^xsd:dateTime;
  dct:modified "2021-01-19T11:08:17.000"^^xsd:dateTime .

:c_6f51345a a skos:Concept;
  skos:definition "1. Jako okrasný a členící boční štít na okapní straně střechy. 2. Štít slepého průčelí. [Koch 2008]"@cs,
    "Giebel der Blendfassade. [Koch 2009]"@de, "Blendgiebel, Giebel einer Blendfassade (Blendfenster). [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_50ec0c5e, :conceptScheme_c8a571d9, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9;
  skos:prefLabel "Blendgiebel (Blendfassade)"@de, "slepý štít"@cs;
  skos:broader :c_d6e98810;
  skos:related :c_c7fc4903;
  dct:created "2020-08-03T15:45:37.000"^^xsd:dateTime;
  dct:modified "2021-01-22T11:31:59.000"^^xsd:dateTime;
  :broaderByFunction :c_d6e98810 .

:c_e755a0e3 a skos:Concept;
  skos:definition "Vorhangfassade, nichttragende Fassadenverkleidung, oft aus Metall oder Glas, die dem konstruktiven Skelettbau vorgehängt ist. [Koch 2009] "@de,
    "Curtain Wall, eine dem konstruktiven Skelett (Skelettbau) vorgehängte, nicht tragende Fassadenhaut meist aus Metall und Glas. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe;
  skos:prefLabel "façade rideau"@fr, "curtain wall"@cs, "Curtain wall"@en, "curtain wall"@it,
    "muro cortina"@es, "Vorhangfassade"@de;
  skos:altLabel "murrideau"@fr, "zavěšená fasáda"@cs, "facciata appesa"@it, "zavěšený obvodový plášt\\'"@cs;
  skos:broader :c_4bd3aa19;
  dct:created "2020-08-04T11:02:02.000"^^xsd:dateTime;
  dct:modified "2021-01-19T11:09:41.000"^^xsd:dateTime .

:c_c126c36e a skos:Concept;
  skos:definition "Fassade mit übermäßiger Häufung unterschiedlicher Dekorationselemente, vor allem des Manierismus, des bürgerlichen Barock und der Gründerzeit. [Koch 2009]"@de,
    "Průčelí s přehnaným nahromaděním různých dekoračních prvků, především v době manýrismu, měšťanského baroka (Brusel) a gründerské doby. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "Stapelfassade"@de, "průčelí s patrovým členěním"@cs;
  skos:broader :c_4bd3aa19;
  dct:created "2020-08-12T08:50:52.000"^^xsd:dateTime;
  dct:modified "2021-01-19T11:08:54.000"^^xsd:dateTime .

:c_422f7097 a skos:Concept;
