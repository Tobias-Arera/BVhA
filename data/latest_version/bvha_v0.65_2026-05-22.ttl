  dct:modified "2021-01-31T00:00:14.000"^^xsd:dateTime .

:c_44ceb1c0 a skos:Concept;
  skos:definition "Ein Flügelaltar mit mehreren Flügelpaaren, wodurch sich mehrere Wandlungsmöglichkeiten ergeben. [Koepf / Binding 2016]"@de,
    "Vzhled oltáře bylo možno měnit výměnnými páry křídel, což je pak proměnný oltář. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_37522b74, :conceptScheme_1f14b4dd, :conceptScheme_cf792a3c;
  skos:prefLabel "pentaptyque"@fr, "Wandelaltar"@de, "altar con aletas modificable"@es,
    "proměnný oltář"@cs;
  skos:altLabel "přenosný oltář"@cs, "vícekřídlový oltář"@cs;
  skos:broader :c_d2c7cee1;
  dct:created "2020-08-03T11:07:53.000"^^xsd:dateTime;
  dct:modified "2021-01-31T00:01:32.000"^^xsd:dateTime .

:c_08eedb5e a skos:Concept;
  skos:definition "Tafelreliquiar n; Reliquientafel f; lat. tabula reliquiarum: eine meist mit Edelmetall überzogene, mit Filigran, Email, Malerei und Edelsteinen verzierte Holztafel, in die Reliquien eingelassen sind (Bespiel: das \"Schachbrett Karls d. Gr.\" in Roncesvalles/ Navarra, 14. Jh.). Eine ähnliche Art des Reliquiars sind kleine FIügelschreine (--> Retabelreliquiar) und Kusstafeln, in denen die Reliquien meist hinter Feldspat, Glas oder Kristall sichtbar sind. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "tableau-reliquaire"@fr, "reliquary-board"@en, "Tafelreliquiar"@de,
    "tabula reliquiarum"@la;
  skos:altLabel "Reliquientafel"@de;
  skos:broader :c_b9eb688f;
  skos:narrower :c_5142fe0b, :c_b65730ec, :c_7586bac2;
  skos:related :c_9eb36631;
  dct:created "2020-09-24T19:15:39.000"^^xsd:dateTime;
  dct:modified "2020-09-24T19:28:35.000"^^xsd:dateTime .

