  :broaderByPosition :c_b5206255 .

:c_c684ab4c a skos:Concept;
  skos:definition "Capilla Mayor (span. Hauptkapelle), in größeren span. Kirchen der Altarraum im mittleren Teil des Chors, vom Chorumgang und dem Gemeinderaum durch hohe, steinerne Schranken (→ Chorschranken) getrennt, die meist mit reichem plast. Schmuck oder Prachtgittern ausgestattet sind. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
