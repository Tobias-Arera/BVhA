:c_f9575a83 a skos:Concept;
  skos:definition "Schüttfundamente, die als Bodenaustausch zu betrachten sind und teilweisebeachtliche Tiefen (bis 10 m unter OK Erdreich) erreichten; teilweisewurden diese Schüttungen in weichen plastischem Boden einfach durch das Gewicht des aufgehenden Gebäudes in den Baugrund eingepresst, bis die Setzungen zum (in einem kurzen, begrenzten Zeitraum wahrgenommenen)Stillstand kamen. [Nodoushani]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_50ec0c5e, :conceptScheme_c8a571d9;
  skos:prefLabel "Schüttfundament"@de;
  skos:broader :c_473bbc7d;
  skos:narrower :c_f218c787, :c_909472b2, :c_bb203ef8;
