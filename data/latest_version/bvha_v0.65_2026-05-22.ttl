:c_16e17bed a skos:Concept;
  skos:definition "Bekrönendes Schmuckelement, hauptsächl. als Knauf über dem Zeltdach eines Rundtempels. [Koepf/Binding 2016]"@de,
    "Ukončující okrasný stavební prvek, antický symbol plodnosti. [Koch 2008]"@cs, "Bekrönendes, schmückendes Bauglied, antikes Fruchtbarkeitssymbol. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9;
  skos:prefLabel "pomme de pin"@fr, "piniová šiška"@cs, " pine cone"@en, " pigna"@it,
    " ornamento en forma de piña"@es, "Pinienzapfen"@de;
  skos:broader :c_d1a8ce66;
  dct:created "2020-08-11T13:09:43.000"^^xsd:dateTime;
  dct:modified "2021-01-25T13:37:33.000"^^xsd:dateTime .

:c_93258107 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "Holzzierelement"@de;
  skos:broader :c_d1a8ce66;
