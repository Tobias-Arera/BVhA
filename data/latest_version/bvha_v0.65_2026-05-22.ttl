:c_44dba109 a skos:Concept;
  skos:definition "Baracke, zunächst jede Hütte aus Zweigen oder Brettern, provisor. hergerichtete Bretterbude zum Wohnen, Lagerhütte, offene Arbeitsbude bei Steinmetzen und Zimmereiplätzen, heute vorgefertigte, schnell montierte Holzbauten für Soldaten, Flüchtlinge oder als Lazarett. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_c8a571d9;
