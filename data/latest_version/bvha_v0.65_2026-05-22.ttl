:c_7cee1fe4 a skos:Concept;
  skos:definition "Mit einem langstieligen, schlanken Zweispitz (Schrämhacke oder Sehrotpickel genannt) wurden etwa 10 - 15 cm breite Schlitze, die sogenannten Schräme, in den Sandstein gehauen. Die Tiefe dieser Schräme und damit die Blockgröße hing neben der nutzbaren Abbauhöhe auch vom handwerklichen Können des Steinbrechers ab. [Voelkle 2016] "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ef0a8695, :conceptScheme_f10222e0;
  skos:prefLabel "Schräme"@de;
  skos:altLabel "Schrämschlitz"@de;
  skos:broader :c_162d82c1;
  dct:created "2019-12-03T11:48:00.000"^^xsd:dateTime;
  dct:modified "2021-03-19T13:23:51.000"^^xsd:dateTime .

