:c_cd3792f1 a skos:Concept;
  skos:definition "Massivdecke aus Stahlbeton. Die an der Untersicht in kurzen Abständen vortretenden schlanken Rippen und die quer darüber verlegte Deckenplatte bilden eine stat. Einheit. [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel " plancher à nervures"@fr, "žebírkový strop"@cs, " ribbed ceiling"@en,
