:c_775b8a30 a skos:Concept;
  skos:definition "Das engherzige Bestreben nach absoluter Stilreinheit. Richtete besonders im 19. Jh. große Schäden an, als z.B. in gotischen Kirchen zahlreiche kostbare Ausstattungsstücke aus späteren Stilepochen zerstört und durch Werke der Neugotik ersetzt wurden. Heute maßvoll oder gar verpönt. [Koch 2009]"@de,
    "Rigorózní snaha o absolutní slohovou čistotu; způsobil velké škody zvl. v 19. století, kdy bylo např. v gotických kostelích zničeno hodně cenného zařízení z pozdějších slohových období a nahrazováno díly neogotiky; dnes do jisté míry nebo zcela zavržen. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9;
  skos:prefLabel "Purismus"@de, "purismus"@cs;
  skos:broader :c_7c0b4654, :c_7c4af9bc, :c_66eeb4d6;
  skos:related :c_qojdlphd;
  dct:created "2020-08-11T15:22:48.000"^^xsd:dateTime;
  dct:modified "2021-01-15T15:30:53.000"^^xsd:dateTime .

