:c_dc9adde5 a skos:Concept;
  skos:definition "Reguläre Hofanlage, bei der auf drei Seiten Gebäude (Wohnstallhaus, Stall oder Schuppen, Scheune oder in Norddtl. Wohnhaus, Stall, Scheune) stehen; die vierte Seite schließt ein Zaun mit Tor (geschlossener D.) oder sie bleibt offen (offener D.). [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_c8a571d9;
  skos:prefLabel "Dreiseithof"@de, "třístranný dvůr"@cs;
  skos:broader :c_58ec1151;
  dct:created "2020-06-23T13:44:56.000"^^xsd:dateTime;
  dct:modified "2021-01-26T22:47:39.000"^^xsd:dateTime .

:c_8a4489a0 a skos:Concept;
  skos:definition "Niederdeutsche, besonders in Nordrhein-Westfalen gebräuchliche Bezeichnung für einen von Wassergräben (Gräften, Wasserburg) umschlossenen und somit leicht befestigten Hof. R. F. . [Wörterbuch der Burgen, Schlösser und Festungen]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_50ec0c5e,
    :conceptScheme_1d7ba54b;
  skos:prefLabel "Gräftenhof"@de;
  skos:broader :c_23139d21;
  dct:created "2020-07-03T13:59:21.000"^^xsd:dateTime;
  dct:modified "2021-01-27T11:29:51.000"^^xsd:dateTime .

:c_fa8f5e2b a skos:Concept;
  skos:definition "Bezeichnung für ›feste‹ oder wehrhafte Schlösser, also jene fürstlichen und adeligen Wohnbauten, die auf Einsatz von Pulverwaffen reagieren und Wehrelemente zeigen (Schütte). Auch ab der 2. Hälfte des 15. Jh.s, als man mehr und mehr vom reinen Burgenbau abließ und größeren Wohnkomfort suchte, blieben die dann entstehenden Schlösser häufig nicht ohne Wehrelemente. Treten diese deutlich in den Vordergrund, spricht man vom B. B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_50ec0c5e,
    :conceptScheme_1d7ba54b;
  skos:prefLabel "Burgschloss"@de;
  skos:broader :c_0218b422;
  dct:created "2020-07-16T13:31:22.000"^^xsd:dateTime;
  dct:modified "2021-01-27T11:06:02.000"^^xsd:dateTime .

:c_60764deb a skos:Concept;
  skos:definition "Hochschloss, Anlage, bei der die Wohnlichkeit und der Anspruch auf Repräsentation schon dem Schlossbau entspricht, bei der aber die strategisch günstige Lage auf dem Berg, häufig oberhalb einer Stadt, beibehalten wurde. Fast immer entstehen H.er durch Umbauten mittelalterlicher Burgen (Weilburg a. d. Lahn RP, Heidelberg BW, Würzburg BY). B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_50ec0c5e,
    :conceptScheme_1d7ba54b;
  skos:prefLabel "Hochschloss"@de;
  skos:broader :c_373f581b;
  dct:created "2020-07-27T13:09:17.000"^^xsd:dateTime;
  dct:modified "2021-01-27T11:32:53.000"^^xsd:dateTime .

