:c_069b16b6 a skos:Concept;
  skos:definition "Transition ( engl.), Übergangszeit zwischen zwei Stilen oder Stilphasen. [Koch 2009]"@de,
    "Též transition, angl., přechodné období mezi dvěma slohy nebo slohovými fázemi. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_37522b74,
