    :c_e6ed95ac, :c_4dae2053, :c_15738277, :c_3cc6bcc7, :c_8f6894ba, :c_8824ced5, :c_45936635,
    :c_5fc78037, :c_3cee5b4a, :c_55d117a4, :c_fe0921ec;
  skos:related :c_1a0d89ef, :c_c8df0cc0, :c_94b449c6;
