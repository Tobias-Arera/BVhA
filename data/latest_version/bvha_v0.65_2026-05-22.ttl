:c_99b75916 a skos:Concept;
  skos:definition "Tonnengewölbe mit spitzbogiger Gewölbelinie, seine Stichhöhe ist größer als die halbe Spannweite. Diese Konstruktion wurde aus statischen Gründen bereits lange vor Beginn der Gotik realisiert. [Glossarium Artis]"@de,
    "Ein Tonnengewölbe mit spitzbogigem Querschnitt. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_1f14b4dd;
  skos:prefLabel "Spitztonnengewölbe"@de, "bóveda de cañón ojival"@es, "volta a botte ogivale"@it,
    "voûte en berceau brisé"@fr, "pointed barrel vault "@en;
  skos:altLabel "gotisches Tonnengewölbe"@de, "Spitztonne"@de, "berceau brisé"@fr;
  skos:broader :c_11426742;
  dct:created "2019-02-18T23:24:58.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:21:44.000"^^xsd:dateTime;
  :broaderByShape :c_11426742 .

:c_376b2d49 a skos:Concept;
  skos:definition "Quadratische Deckplatte des antiken Kapitells. [Koch 2009]"@de, "Abakus (lat. v. gr. abax: Tischplatte), meist rechteckige oder quadrat. Deckplatte, die den oberen Abschluss des Kapitells bildet. Der A. der dor. Säule ist ungegliedert, der des ion. und korinth. Kapitells durch Hohlkehle und Leiste profiliert, vielfach auch mit Blattwerk oder anderem Ornament verziert. Beim Kapitell der korinth. Ordnung und beim Kompositkapitell sind die Seiten des A. konkav geschwungen, häufig mit einer Blume oder Rosette in der Mitte (Abakusblume). Während der A. in der Baukunst der Antike und den sie nachahmenden Baustilen die Regel ist, tritt in der frühchristl.-byzantin. Baukunst häufig ein Kämpferaufsatz an seine Stelle. In der ma. Baukunst kann der A. bes. in der Spätgotik sehr reduziert werden oder auch ganz entfallen. Bei der sog. protodor. Säule ersetzt der ungegliederte A. das Kapitell (Abakussäule). [Koepf / Binding 2016]"@de,
    "Abschlussplatte eines Kapitells. [Schrader / Voigt 2003]"@de, "Eine quadratische oder rechteckige Deckplatte, die auf dem Kapitell liegt und das Gebälk trägt. Beim korinthischen Kapitell und beim KompositkapitelI sind die Seiten konkav geschwungen und häufig in der Mitte mit einer Abakusblume dekoriert. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_8c0441f9, :conceptScheme_5bf6bcac;
  skos:prefLabel "Abakus"@de, "abaque"@fr, "abakus"@cs, "abacus"@en, "abaco"@it, "abaco"@es;
  skos:altLabel "Deckplatte"@de, "tailloir"@fr;
  skos:broader :c_381f9e69;
  skos:related :c_62a69ac6;
  dct:created "2019-03-05T16:05:08.000"^^xsd:dateTime;
  dct:modified "2020-09-01T10:24:36.000"^^xsd:dateTime .

