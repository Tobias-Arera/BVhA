:c_14ae0e29 a skos:Concept;
  skos:definition "Allseitig abgewalmt, jedoch mit Firstlinie (abwalmen = Herunterführen des Dachs über die Giebelseiten). [Koch 2009]"@de,
    "Valbová střecha, zkosená na všech stranách, avšak s vrcholnicí (zkosení střechy valbou na štítové straně). [Koch 2008]"@cs,
    "Werden ein oder beide Giebel eines Satteldaches insgesamt oder partiell durch eine Dachfläche ersetzt, entsteht ein Walm. Der oberste Punkt des Walmes wird als Walmanfallspunkt bezeichnet. Reicht die Walmabschrägung von der Traufe über die gesamte Dachhöhe bis zum Anfallspunkt, so handelt es sich um einen Vollwalm. [Eißing et al. 2012]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9, :conceptScheme_19d56a39;
  skos:prefLabel "Walmdach"@de, "valbová střecha"@cs;
  skos:broader :c_f4e2bee8;
  skos:narrower :c_b6388f2f, :c_1dc51d7f, :c_54c9d2b6, :c_149ca906, :c_7fc8dace, :c_be647c48;
  skos:related :c_1863c0bb;
  dct:created "2019-02-18T20:03:08.000"^^xsd:dateTime;
  dct:modified "2020-09-30T10:19:54.000"^^xsd:dateTime;
  :broaderByShape :c_f4e2bee8 .

:c_1863c0bb a skos:Concept;
  skos:definition "Dachfläche anstelle eines Giebels. Ist nur an einer Seite des Dachs ein W., so spricht man vom Halbw.dach, ist nur ·der obere Teil des Giebels abgewalmt, vom Krüppelw„ falls nur der untere Teil abgewalmt ist, vom Fußw. [Koepf / Binding 2016]"@de,
    "Werden ein oder beide Giebel eines Satteldaches insgesamt oder partiell durch eine Dachfläche ersetzt, entsteht ein Walm. Der oberste Punkt des Walmes wird als Walmanfallspunkt bezeichnet. [Eißing et al. 2012]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_19d56a39;
  skos:prefLabel "hip"@en, "croupe"@fr, "valba"@cs, "spiovente a triangolo"@it, "copete"@es,
    "Walm"@de;
  skos:broader :c_053a6f99;
  skos:narrower :c_a87fd279, :c_2f781688, :c_70b109dd, :c_7806fe86, :c_32e38496, :c_679c7fff;
  skos:related :c_14ae0e29;
  dct:created "2019-05-22T13:37:37.000"^^xsd:dateTime;
  dct:modified "2021-01-19T11:06:00.000"^^xsd:dateTime .

:c_b6388f2f a skos:Concept;
  skos:definition "Der Giebel wird nur im unteren oder oberen Teil durch Dachflächen ersetzt (z. B. Schwarzwaldhaus). [Koch 2009]"@de,
    "Štít je pouze ve spodní nebo v horní části nahrazen střešní plochou, např. schwarzwaldský dům. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9, :conceptScheme_19d56a39;
  skos:prefLabel "Krüppelwalmdach"@de, "polovalbová střecha"@cs;
  skos:altLabel "Schopfwalmdach"@de;
  skos:broader :c_14ae0e29;
  skos:related :c_a87fd279;
  dct:created "2019-02-18T20:04:43.000"^^xsd:dateTime;
  dct:modified "2020-09-09T13:03:24.000"^^xsd:dateTime .

:c_a87fd279 a skos:Concept;
  skos:definition "Abgewalmte Giebelspitze, bei der der kleine Walm nicht in die Dachkonstruktion eingreift, sondern vor der Giebelfläche auskragt. [Koepf / Binding 2016]"@de,
    "Ist der Walm auf einen deutlich kleineren Bruchteil der Dachhöhe beschränkt, wird dieser als Schopfwalm bezeichnet. [Eißing et al. 2012]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_19d56a39;
  skos:prefLabel "Schopfwalm"@de, "copete del frontón"@es, "polovalba"@cs, "demi-croupe"@fr,
    "half hip roof"@en;
  skos:altLabel "Krüppelwalm"@de;
  skos:broader :c_1863c0bb;
  skos:related :c_b6388f2f;
  dct:created "2020-03-17T15:01:08.000"^^xsd:dateTime;
  dct:modified "2021-01-19T11:06:55.000"^^xsd:dateTime;
  :broaderByPosition :c_1863c0bb .

:c_1dc51d7f a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_19d56a39;
  skos:prefLabel "Fußwalmdach"@de;
  skos:broader :c_14ae0e29;
  skos:related :c_2f781688;
  dct:created "2019-05-18T12:29:49.000"^^xsd:dateTime;
  dct:modified "2020-03-17T15:03:05.000"^^xsd:dateTime .

:c_2f781688 a skos:Concept;
  skos:definition "Im Gegensatz zum Krüppelwalm Abwalmung an der unteren Seite eines Giebels. In Ostasien Irimoyadach genannt. [Koepf / Binding 2016]"@de,
    "Der Fußwalm ist eine trapezförmige Walmfläche mit geringer Höhe, die unterseitig von der Traufe und oberseitig von der Schnittkante zum Giebel begrenzt wird. Der Übergang von Walmdächern zu giebelseitigen Vordächern kann fließend sein. [Eißing et al. 2012]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_19d56a39;
  skos:prefLabel "Fußwalm"@de, "valbová střecha s podlomenicí"@cs;
  skos:broader :c_1863c0bb;
  skos:related :c_1dc51d7f;
  dct:created "2020-03-17T15:01:19.000"^^xsd:dateTime;
  dct:modified "2021-01-19T11:06:28.000"^^xsd:dateTime;
  :broaderByPosition :c_1863c0bb .

:c_54c9d2b6 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_19d56a39;
  skos:prefLabel "Mansardwalmdach"@de;
  skos:broader :c_14ae0e29;
  dct:created "2019-05-18T12:30:36.000"^^xsd:dateTime;
  dct:modified "2020-03-17T15:02:37.000"^^xsd:dateTime .

:c_149ca906 a skos:Concept;
  skos:definition "Als Vollwalmdach wird ein Satteldach bezeichnet, dessen Giebel durch Vollwalme ersetzt wurden. Rücken die Walmflächen bis auf den Anfallspunkt zusammen, entsteht ein Zeltdach. Weil dann das Satteldach als Stützkonstruktion wegfällt, werden Zeltdächer häufig mit eigenen Stützgerüsten wie dem Dachspitzständer errichtet. In seltenen Fällen können Walme bis zum Erdreich hinabgeführt werden oder kurz davor enden. Setzt der Vollwalm kurz unterhalb des Anfallspunktes unter dem First aus, entsteht eine kleine, dreieckige Giebelfläche, die von den oberen Sparrenenden und einem kurzen Walmkehlbalken begrenzt wird. Dieses Firstfach kann geschlossen werden oder offen bleiben und dient dann häufig dem Rauchabzug. Auf dem Walmkehlbalken liegen die Walmrofen oder Walmsparren auf. Setzt der Walm oberhalb der Traufe auf einer Unterstützungskonstruktion auf, spricht man entsprechend der Überdeckungshöhe des Walmes im Verhältnis zur Dachhöhe von einem Zweidrittel-, Halb-, oder Drittelwalm. [Eißing et al. 2012]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_19d56a39;
  skos:prefLabel "Vollwalmdach"@de;
  skos:broader :c_14ae0e29;
  skos:related :c_70b109dd;
  dct:created "2019-05-22T13:00:59.000"^^xsd:dateTime;
  dct:modified "2019-05-28T16:57:26.000"^^xsd:dateTime .

:c_70b109dd a skos:Concept;
  skos:definition "Reicht die Walmabschrägung von der Traufe über die gesamte Dachhöhe bis zum Anfallspunkt, so handelt es sich um einen Vollwalm. [Eißing et al. 2012]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_19d56a39;
  skos:prefLabel "Vollwalm"@de, "plná valba"@cs;
  skos:broader :c_1863c0bb;
  skos:related :c_149ca906;
  dct:created "2020-03-17T15:01:30.000"^^xsd:dateTime;
  dct:modified "2021-01-19T11:07:09.000"^^xsd:dateTime .

