:c_83fae99e a skos:Concept;
  skos:definition "Gewölbeachse, ist die gedachte Linie unterhalb des Scheitels in Kämpferhöhe. [Koepf / Binding 2016]"@de,
    "Eine gedachte, horizontale oder geneigte Linie, die in Höhe der Widerlager parallel zum Gewölbescheitel verläuft. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
