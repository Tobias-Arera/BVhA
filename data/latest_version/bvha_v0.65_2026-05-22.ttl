    :conceptScheme_84fc24e6, :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "cénotaphe"@fr, "kenotaf"@cs, "cenotaph"@en, "cenotafio"@it, "cenotafio"@es,
    "Kenotaph"@de;
  skos:altLabel "Scheingrab"@de, "Ehrengrabmal"@de;
  skos:broader :c_2f3cf311;
