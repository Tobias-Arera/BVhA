:c_9cb3d277 a skos:Concept;
  skos:definition "Katakomben f pI: unterirdische Grabanlagen aus der römischen Antike, die auch in frühchristlicher Zeit und bis ins frühe Mittelalter hinein besonders in Rom und Umgebung, aber auch auf dem Balkan und im Orient gebaut wurden Die Toten waren in Nischengräbern, den Loculi (m pl), beigesetzt. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "catacombe"@fr, "catacomb"@en, "Katakombe"@de, "katakomby"@cs;
  skos:broader :c_ad106f42;
  skos:related :c_0660b156, :c_0e8d8cf2, :c_a3310d78;
  dct:created "2020-08-04T10:38:08.000"^^xsd:dateTime;
  dct:modified "2021-01-19T10:55:18.000"^^xsd:dateTime .

:c_962195a2 a skos:Concept;
  skos:definition "Tragaltar (altare portatile) als kleiner Reisealtar in der Form eines Tisch- oder Blockaltars oder als Klappaltärchen. [Koch 2009]"@de,
    "Altare portatile. Jako menší cestovní oltář v podobě oltáře stolního nebo blokového, případně jako skládací oltářík. [Koch 2008]"@cs,
    "Tragaltar m; Portatile n; auch Reisealtar m; Feldaltar m; lat. altare portatile; altare viaticum; ara portatilis; tabula itineraria: im frühen Mittelalter eine konsekrierte, reich verzierte Tafel aus Holz (Tafelportatilen), in deren Mitte Reliquien eingelassen waren und die von Missionaren und reisenden Mönchspriestern mitgeführt wurde. Später ein kleiner mobiler Reliquienkasten, der als Altar benutzt wurde. Er ist aus Edelmetall, meist mit EmaiIarbeiten und Beschlägen reich verziert, oft auf vier Füßchen ruhend. Die Reliquien im Deckel sind unter einem kostbaren Stein verborgen. Manchmal fanden ein kleiner Reisekelch und eine Patene in dem Kästchen Platz. Wurde der Tragaltar auf einen ungweihten Altar gestellt, so erhielt dieser dadurch die erforderliche Weihe und man konnte an ihm die Messe lesen. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9, :conceptScheme_1f14b4dd;
  skos:prefLabel "Tragaltar"@de, "portable altar"@en, "přenosný oltář"@cs, "autel portatif"@fr,
    "altare portatile"@la;
  skos:altLabel "altare viaticum"@la, "ara portatilis"@la, "tabula itineraria"@la, "Portatile"@de,
    "Reisealtar"@de, "Feldaltar"@de;
  skos:broader :c_wyccl4ls;
  skos:narrower :c_904ea322;
  skos:related :c_45fded98, :c_3309f4a6, :c_9e9094e8, :c_a0d6b25d, :c_5523ca6e;
  dct:created "2020-01-10T18:31:40.000"^^xsd:dateTime;
  dct:modified "2021-01-30T23:55:45.000"^^xsd:dateTime;
  :broaderByPosition :c_wyccl4ls .

