:c_4d4472bc a skos:Concept;
  skos:definition "Bogen mit einer genau halbkreisförmigen Bogenlinie. Sein Kreismittelpunkt liegt auf der Mitte der Kämpferlinie, der Stich entspricht dem Radius. Diese Form ist charakteristisch für die von den Römern erbauten Bogen, weshalb man manchmal auch vom römischen Bogen spricht. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_84fc24e6,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "arc en plein cintre"@fr, "půlkruhový oblouk"@cs, "round arch"@en,
    "arco de medio punto"@es, "Rundbogen"@de, "arco a tutto sesto"@it;
  skos:altLabel "arc en demi-cercle"@fr, "semicircular arch"@en, "Roman arch"@en, "Halbkreisbogen"@de,
    "kruhový oblouk"@cs;
  skos:broader :c_2026364f;
  skos:related :c_c16e700a, :c_02cc4595;
  dct:created "2019-02-18T20:10:54.000"^^xsd:dateTime;
  dct:modified "2021-01-15T17:39:22.000"^^xsd:dateTime;
  :broaderByShape :c_2026364f .

