  dct:created "2020-08-14T17:34:23.000"^^xsd:dateTime;
  dct:modified "2020-08-14T17:38:29.000"^^xsd:dateTime .

:c_2d2c840a a skos:Concept;
  skos:definition "Ein zum Abspreizen, Abstützen verwandtes Holz. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
