:c_3063aeac a skos:Concept;
  skos:definition "In der Decke liegende Fensteröffnung, die Oberlicht einlässt. Schon in ägypt. Tempeln kommt neben Obergadenfenstern die 0. vor. Sie hat sich in der Architektur bes. bei Ausstellungs- und Industriebauten bewährt (Lichthof). Eine Sonderform der 0. ist die ringförmige Öffnung (Auge, Opäum, Nabel) im Scheitel einer Kuppel. 2. Seltener für Fenster, die im obersten Teil der Umfassungswände eines Raums oder über dem Fensterkämpfer angebracht sind und hohes Seitenlicht hereinlassen. [Koepf/Binding 2016]"@de,
    "Bei Fenstern mit mehreren Etagen, bei denen die oberste Etage nicht wie die unteren geteilt ist, heißt diese Oberlicht. Es gibt das feststehende, nicht zu öffnende Oberlicht und das bewegliche. Von Oberlicht spricht man vorwiegend beim Galgenfenster. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0,
    :conceptScheme_b41bd73a;
  skos:prefLabel "světlík"@cs, "skylight"@en, " lucernario"@it, " tragaluz"@es, "Oberlicht"@de,
    " jour d\\'en haut"@fr;
  skos:altLabel " lanterneau"@fr, " imposte"@fr, "fanlight"@en, " claraboya"@es, "vrchní světlo"@cs,
    "nadsvětlik"@cs, "horní světlo"@cs, "horní osvětlení"@cs;
  skos:broader :c_f88a153a, :c_4708d89a, :c_927173eb;
  dct:created "2019-06-18T08:09:05.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:12:52.000"^^xsd:dateTime;
  :broaderByPosition :c_f88a153a .

:c_2a600321 a skos:Concept;
  skos:definition "Členění stěny v podobě okna, které však nemá okenní otvor, nebo které opticky rozšiřuje menší okenní otvor. [Koch 2008]"@cs,
    "Blendfenster, Fenster, das einer Mauer vorgeblendet ist, ohne dass Fensteröffnungen dahinter liegen. Auch kann das B. ein relativ niedriges Fenster nach unten bzw. nach oben opt. ausweiten. Bei Basiliken ohne Triforium können die Fenster über die geschlossene Mauerfläche hinter den Seitenschiffdächern als B. heruntergezogen sein (bes. häufig im Backsteinbau). Seltener kommt das B. im Innenraum als Wandgliederung vor, wenn äußere Anbauten einen Mauerdurchbruch unmöglich machen. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_37522b74;
  skos:prefLabel "Blendfenster"@de, "slepé okno"@cs;
  skos:broader :c_4708d89a, :c_804ab319;
  skos:narrower :c_ff9ff443;
  dct:created "2020-02-18T19:19:08.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:09:14.000"^^xsd:dateTime .

:c_59f67fe4 a skos:Concept;
  skos:definition "Fenster mit halbkreisförmigem Bogenabschluss. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe;
  skos:prefLabel " fenêtre arquée"@fr, "půlkruhové okno"@cs, "Roman window"@en, "finestra ad arco a tutto sesto"@it,
    "ventana arqueda"@es, "Rundbogenfenster"@de;
  skos:altLabel "okno s kruhovým obloukem"@cs;
  skos:broader :c_4708d89a;
  dct:created "2020-08-05T09:45:34.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:14:46.000"^^xsd:dateTime .

:c_ad5cd38c a skos:Concept;
  skos:definition "Fenster mit kreisrunder Öffnung. R. ohne Unterteilung oder mit eingefügten Mehrpässen; R. mit speichenartiger Unterteilung heißen Radfenster, R. mit Maßwerkfüllung werden Rose (Fensterrose) genannt. [Koepf / Binding 2016]"@de,
    "Též okulus, v gotice většinou s kružbou. [Koch 2008]"@cs, " Kleines Rundfenster; als ovales Fenster Ochsenauge. [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_37522b74, :conceptScheme_c7b144d0, :conceptScheme_b41bd73a;
  skos:prefLabel " oculus"@fr, "kruhové okno"@cs, " oculus"@en, " oculo"@it, "ojo de buey"@es,
    "Okulus"@de;
  skos:altLabel "Rundfenster"@de, "ventana circular"@es, "okulus"@cs, "oválné okno"@cs,
    " finestra circolare"@it, " fenêtre ronde"@fr;
  skos:broader :c_4708d89a;
  skos:narrower :c_c46dbfb4, :c_40e4eeaa, :c_13a08c76, :c_497291e9;
  dct:created "2020-08-05T09:48:10.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:13:03.000"^^xsd:dateTime .

:c_ad9c88fc a skos:Concept;
  skos:definition "Rundfenster mit speichenartiger Unterteilung, die als Vorform des Maßwerks bezeichnet werden kann. [Koepf/Binding 2016]"@de,
    "Kruhové okno členěné radiálními sloupky nebo pruty, předchůdce rozetového okna, románské období. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_37522b74, :conceptScheme_c7b144d0, :conceptScheme_b41bd73a;
  skos:prefLabel " rose du bras"@fr, "rozetové okno se sloupky nebo pruty"@cs, "wheel window"@en,
    " rosone"@it, " ventana tipo rueda"@es, "Radfenster"@de;
  skos:altLabel "roue de Saint-Cathérine"@fr, "rozetové okno s radiálními sloupky"@cs;
  skos:broader :c_4708d89a;
  dct:created "2020-08-05T09:50:35.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:14:23.000"^^xsd:dateTime .

:c_2276384c a skos:Concept;
  skos:definition "Stilisierte Abstraktion einer Blütenform, bei der um einen runden Kern Blütenblätter angeordnet sind. R.n sind schon in der babylon. Kunst (Prozessionsstraße und Thronsaal) nachgewiesen und kommen in fast allen Epochen der Kunst vor. [Koepf / Binding 2016]"@de,
    "Vyplněné kružbou, často velkého průměru, obvykle nad portávyplněné kružbou, často velkého průměru, obvykle nad portály a na štítech příčné lodi v gotice. [Koch 2008]"@cs,
    "Fensterrose, Rosenfenster, Rose; ein Rundfenster, dessen Lichte mit Stein- oder Holzwerk in radialer oder konzentr. Anordnung gefüllt ist, seit Ende des 14. Jhs. als Rose benannt. Vorstufen der F. finden sich seit 1130/ 40 in Frankreich, zunächst als Radfenster, Lochscheibenfenster oder  Plattenmaßwerk; erst mit dem Aufkommen des Maßwerks gibt es seit 1220 die eigentl. F., bis vorrangig konzentr. Lanzetten ( Lanzettfenster) das Grundgerüst bilden. F.n finden sich als bestimmende Gliederung an W- und Querhausfassaden got. Kirchen bes. in Frankreich und Deutschland, vereinzelt auch in England und an den von Frankreich beeinflussten Kirchen in Spanien und Italien. [Koepf / Binding 2016]"@de,
    "Mit Maßwerk geschmücktes got. Rundfenster. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_37522b74;
  skos:prefLabel "rose"@fr, "rozetové okno"@cs, "rose window"@en, "rosone"@it, " rosetón"@es,
    "Fensterrose"@de;
  skos:altLabel "Rose"@de, " rosace"@fr, "rosette"@fr, "rose"@en, "rosette"@en, "Rosette"@de,
    "Rosenfenster"@de, "rosa"@es;
  skos:broader :c_4708d89a;
  skos:related :c_7c038a77;
  dct:created "2020-08-05T09:54:11.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:10:34.000"^^xsd:dateTime .

