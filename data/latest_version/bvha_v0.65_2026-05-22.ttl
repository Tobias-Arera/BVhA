:c_aa66e1d7 a skos:Concept;
  skos:definition "Hauptsächl. in der dt. Renaissance vorkommende Dekoration mit verschlungenen und aufgerollten Bandformen, v. a. bei Wappen und Kartuschen, ähnl. dem Beschlagwerk. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe;
  skos:prefLabel " (cartouche) à enroulement (s)"@fr, " cartoccio"@it, "Rollwerk"@de,
    "zavíjený ornament"@cs;
  skos:altLabel "boltcový ornament"@cs, "scrollwork"@en, "adornos de voluta"@es, "rozvilinový ornament"@cs;
  skos:broader :c_077a12c6;
  dct:created "2020-08-03T15:10:37.000"^^xsd:dateTime;
  dct:modified "2021-01-26T11:01:01.000"^^xsd:dateTime .

:c_854e6eba a skos:Concept;
  skos:definition "Eine dem Beschlagwerk verwandte Dekorationsform der Frühbarockzeit, deren Charakteristikum einzelne, am Ende eingerollte Formen (Rollwerk) sind. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe;
  skos:prefLabel "redents"@fr, "volutový ornament"@cs, "scrollwork"@en, "fastigio composito"@it,
    "adornos de voluta"@es, "Schweifwerk"@de;
  skos:altLabel "resalto"@es;
  skos:broader :c_077a12c6;
  dct:created "2020-08-03T15:10:51.000"^^xsd:dateTime;
  dct:modified "2021-01-26T11:01:12.000"^^xsd:dateTime .

:c_1bb63682 a skos:Concept;
  skos:definition "Manierismus (ital. manierismo = Künstelei), im weiteren Sinne die unecht empfundene Nachahmung eines Stils. Der Manierismus steht meist am Ende einer Stilepoche, bedient sich mit Virtuosität deren formaler und technischer Mittel, jedoch ohne innere Bindung an deren geistige Grundhaltung. Im engen Sinn meint Manierismus die bildende Kunst und Literatur der Zeit zwischen Spätrenaissance und Barock, etwa 1525-1620. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_8c0441f9;
  skos:prefLabel "Manierismus"@de, "manýrismus"@cs;
  skos:broader :c_069b16b6;
  skos:narrower :c_89796e27;
  skos:related :c_2e004f61, :c_02629eac, :c_6uazz5qx, :c_f7qkhf86;
  dct:created "2020-08-11T16:34:43.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:27:58.000"^^xsd:dateTime .

:c_9781910f a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe;
  skos:prefLabel "Minoritenkirche"@de, "minoritský kostel"@cs;
  skos:broader :c_f8bf69ba;
