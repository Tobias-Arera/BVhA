  dct:created "2019-05-23T08:44:35.000"^^xsd:dateTime;
  dct:modified "2021-01-26T14:10:37.000"^^xsd:dateTime .

:c_638e4f46 a skos:Concept;
  skos:definition "Umlaufende, s-förmige Profilierung im Einschlagfalz des Blendrahmens und an den Schmalseiten im doppelten Überschlag der Flügel. [Noky 1996]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
