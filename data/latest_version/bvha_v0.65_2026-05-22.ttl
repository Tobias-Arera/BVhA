  dct:created "2020-08-11T13:15:17.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:30:02.000"^^xsd:dateTime .

:c_af94588b a skos:Concept;
  skos:definition "»Ozeanische Gotik« in Portugal, um 1500. [Koch 2009]"@de, ",,Oceánská gotika\" v Portugalsku kolem r. 1500. [Koch 2008]"@cs;
