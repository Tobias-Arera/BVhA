:c_34f98e4b a skos:Concept;
  skos:definition "Blei-, Eisen- oder Kupferplatten, Steinplatten, sowie aus Zement hergestellte ziegel- oder schieferähnl. Platten zur Dachdeckung. Fälschl. auch für Biberschwänze gebraucht. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Dachplatte"@de;
