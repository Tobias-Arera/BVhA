  dct:created "2020-09-30T13:28:14.000"^^xsd:dateTime;
  dct:modified "2021-01-30T22:56:36.000"^^xsd:dateTime .

:c_ea442afc a skos:Concept;
  skos:definition "(1) Auftragen eines Lacküberzuges. (2) Direktes Einfärben in geeigneten Färbelösungen nach festgelegten Rezepturen. Besonders Kupfer und Kupferlegierungen, aber auch Stahl, Aluminium, Zink und Zinn werden zum Färben herangezogen. Einige wichtige Verfahren sind die Altsilberfärbung, Barbediennefärbung und das Brünieren. [Schrader / Voigt 2003]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_5bf6bcac;
  skos:prefLabel "Metallfärbung"@de;
  skos:broader :c_1df9f722;
  skos:narrower :c_bdc53f59;
  dct:created "2020-11-20T17:49:14.000"^^xsd:dateTime;
  dct:modified "2021-01-18T14:09:45.000"^^xsd:dateTime .

:c_79b87b82 a skos:Concept;
  skos:definition "Design technique producing an outline by dabbing a cloth sack containing a dark powder, such as charcoal, onto the surface of a pierced sheet of paper or parchment. [EwaGlos]"@en,
    "Technik zur Anfertigung einer Zeichnung, bei der ein Stoffbeutel, gefüllt mit dunklem Puder, wie etwa Kohle, auf die Oberfläche eines durchstochenen Papiers gedrückt wird. [EwaGlos]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_ec8c77bf;
  skos:prefLabel "Spolvero-Methode"@de, "spolvero"@en;
  skos:broader :c_7acece55;
  dct:created "2019-10-15T11:46:55.000"^^xsd:dateTime;
  dct:modified "2021-01-18T14:01:36.000"^^xsd:dateTime .

:c_7723fa45 a skos:Concept;
  skos:definition "Fenster, dessen parallele Flügel gemeinsam angeschlagen und mit einem einzigen Handgriff zu öffnen sind. [Koepf / Binding 2016]"@de,
    "Verbundfenster erbringen besondere Leistungen in Schallschutz und Wärme-Isolierung. Der Luftzwischenraum zwischen den beiden Scheiben beträgt 4 - 7 cm und bildet mit seinem Luftpolster eine äußerst effektive Barriere gegenüber Schalleinflüssen. [Pax - Fenster & Türen Fachbegriffe]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0;
  skos:prefLabel "Verbundfenster"@de, "ventana con cierre doble"@es, "finestra a doppia chiusura"@it,
    "zdvojené okno"@cs, "fenêtre à vitrage double"@fr;
  skos:altLabel "sdružené okno"@cs, "fenêtre composée"@fr;
  skos:broader :c_f88a153a;
  dct:created "2019-10-15T12:09:42.000"^^xsd:dateTime;
  dct:modified "2020-11-30T23:27:36.000"^^xsd:dateTime;
  :broaderByConstruction :c_f88a153a .

:c_b0474097 a skos:Concept;
  skos:definition "bewegliches oder festes Rahmenteil unterhalb eines Fensters. [Pax - Fenster & Türen Fachbegriffe]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_c7b144d0;
  skos:prefLabel "Unterlicht"@de;
  skos:broader :c_f88a153a;
  dct:created "2019-10-15T13:45:14.000"^^xsd:dateTime;
  dct:modified "2020-02-28T10:17:42.000"^^xsd:dateTime;
  :broaderByPosition :c_f88a153a .

:c_41684347 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Strebe/Gerüstkonstruktion"@de;
  skos:broader :c_32a52cd0;
  skos:narrower :c_59cfb591, :c_630f07c7, :c_663f2690;
  dct:created "2020-08-19T14:38:56.000"^^xsd:dateTime;
  dct:modified "2020-08-21T15:37:35.000"^^xsd:dateTime .

:c_318b9bad a skos:Concept;
  skos:definition "Konstruktion, die Blockbau und Fachwerkbau miteinander verbindet. Das Umgebindehaus besteht aus einem Ständergerüst (Außenständer), das den Oberstock und das Dach trägt. Das Erdgeschoß mit seinen Wohnräumen ist durch Wände in Blockbauweise oder in der Form des Bohlenständerbaus geschlossen, während das darüberliegende Stockwerk vielfach als Fachwerk ausgeführt ist. Das Verbreitungsgebiet ist Schlesien und Böhmen. [Glossarium Artis]"@de,
    "Das Umgebinde ist eine regionale Sonderform des Unterbaugerüstes, bei der sich konstruktiv unabhängige Räume in Blockbauweise innerhalb des Unterbaugerüsts befinden. Es stellt entsprechend der hier verwendeten Systematik kein eigenständiges Grundsystem dar. [Eißing et al. 2012]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd,
    :conceptScheme_19d56a39;
  skos:prefLabel "Umgebinde"@de;
  skos:broader :c_4a848d10;
  dct:created "2019-10-15T17:55:50.000"^^xsd:dateTime;
  dct:modified "2019-11-06T10:29:10.000"^^xsd:dateTime .

:c_78638388 a skos:Concept;
  skos:definition "Ein Bogen, dessen Krümmung aus einer in der Längsrichtung halbierten Ellipse besteht. Im Gewölbebau kommt der E. v.a. als Diagonalbogen des Kreuzgewölbes über rechteckigem Grundriss vor. [Koepf / Binding 2016]"@de,
    "Bogen, dessen Krümmung einer Halbellipse folgt. Er entsteht z. B. als Diagonalbogen bei Kreuzgewölben über rechteckigem Grundriss. Man unterscheidet je nach Lage der großen Ellipsenachse den liegenden elliptischen Bogen und den stehenden elliptischen Bogen. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "arc elliptique"@fr, "elliptical arch"@en, "Ellipsenbogen"@de, "eliptický oblouk"@cs;
  skos:altLabel "elliptischer Bogen"@de, "arc en ellipse"@fr;
  skos:broader :c_eea5235b;
  dct:created "2019-10-16T08:42:47.000"^^xsd:dateTime;
  dct:modified "2020-09-07T13:21:58.000"^^xsd:dateTime;
  :broaderByShape :c_eea5235b .

:c_005c8d28 a skos:Concept;
  skos:definition "Giebelbogen, ein >Bogen<, der aus zwei schräg aneinander gelegten Steinen besteht. Obwohl er von zwei Geraden gebildet wird, erfüllt er konstruktiv die Voraussetzungen eines echten Bogens. [Koepf / Binding 2016]"@de,
    "Raumüberdeckung, die von zwei schräg gegeneinander gelegten, sich gegenseitig stützenden, langrechteckigen Steinen gebildet wird. Der Giebelbogen erfüllt konstruktiv die Bedingungen eines echten Bogens, obwohl seine Bogenschenkel nicht gekrümmt sind. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "arc en mitre"@fr, "triangular arch"@en, "Dreiecksbogen"@de, "trojúhelníkový oblouk"@cs;
  skos:altLabel "mitre arch"@en, "miter arch"@en, "arc en fronton"@fr, "arc triangulaire"@fr,
    "Giebelbogen"@de, "Spreizbogen"@de;
  skos:broader :c_eea5235b;
  dct:created "2019-10-16T09:08:24.000"^^xsd:dateTime;
  dct:modified "2020-09-29T14:04:04.000"^^xsd:dateTime;
  :broaderByShape :c_eea5235b .

:c_808448c2 a skos:Concept;
  skos:definition "Rundbogen über geschweiften Kämpfersteinen. Durch den Übergang der Bogenlinie in die Begrenzung der Kämpfersteine entsteht die glockenartige Form. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "arc en cloche"@fr, "bell arch"@en, "Glockenbogen"@de, "zvonový oblouk"@cs;
  skos:broader :c_eea5235b;
  dct:created "2019-10-16T09:14:43.000"^^xsd:dateTime;
  dct:modified "2020-07-29T19:46:59.000"^^xsd:dateTime;
  :broaderByShape :c_eea5235b .

:c_17b85ed5 a skos:Concept;
  skos:definition "Bogen, bei dem nur ein Bogenschenkel ausgebildet ist, der vom Kämpfer bis zum Bogenscheitel reicht und z. B. gegen eine Mauer läuft. Zu unterscheiden vom einhüftigen Bogen. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "demi-arc"@fr, "semiarch"@en, "Halbbogen"@de;
  skos:altLabel "half arch"@en, "quadrant arch"@en, "einschenkliger Bogen"@de;
  skos:broader :c_eea5235b;
  dct:created "2019-10-16T09:28:01.000"^^xsd:dateTime;
  dct:modified "2019-12-05T10:16:19.000"^^xsd:dateTime;
  :broaderByShape :c_eea5235b .

:c_f3805658 a skos:Concept;
  skos:definition "Bogen, dessen Bogenlinie ein stumpfwinkliges Vieleck ausbildet. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "polygonal arch"@en, "arc polygonal"@fr, "Knickbogen"@de;
  skos:altLabel "polygonaler Bogen"@de, "arc angulaire"@fr;
  skos:broader :c_eea5235b;
  dct:created "2019-10-16T10:01:06.000"^^xsd:dateTime;
  dct:modified "2019-12-05T10:20:37.000"^^xsd:dateTime;
  :broaderByShape :c_eea5235b .

:c_aefad218 a skos:Concept;
  skos:definition "Kuppelartig überhöhte (gebuste) Gewölbeform mit Diagonal- und Scheitelrippen, die hauptsächl. in der spätrom. Baukunst Südwestfrankreichs (Angers) und Westfalens vorkommt. [Koepf / Binding 2016]"@de,
    "Kreuzgewölbe von kuppelartiger Wirkung mit stark überhöhtem Scheitel, in der Regel mit Diagonalrippen und Scheitelrippen; eine Mischform aus Rippengewölbe und Kuppel. Bei spitzbogiger Wölblinie bilden sich im Gewölbescheitel Kehlen aus.[...]. Auch die sogenannte vierkehlige Spitzkuppel kann als Domikalgewölbe bezeichnet werden. [Glossarium Artis]"@de,
    "Ein kuppelartig gebustes 8-teiliges Rippengewölbe (4 Kreuz-, 2 Querrippen zwischen Kämpfern und Schlussstein, 2 Scheitelrippenabschnitte) heißt Domikalgewölbe. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_8c0441f9, :conceptScheme_1f14b4dd;
  skos:prefLabel "voûte domicale"@fr, "domical vault"@en, "Domikalgewölbe"@de, "dominikální klenba"@cs;
  skos:altLabel "domed vault"@en, "domical cross vault"@en, "voûte bombee"@fr, "kuppelförmiges Kreuzgewölbe"@de,
    "kreuzgewölbtes Domikal"@de, "Zwickeldomikal"@de, "gratiges Domikalgewölbe"@de, "Kreuzklostergewölbe"@de,
    "Rippen-Klostergewölbe"@de, "kuppliges Kreuzgewölbe"@de;
  skos:broader :c_5f9418c5;
  dct:created "2019-10-16T10:01:37.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:06:24.000"^^xsd:dateTime;
  :broaderByShape :c_5f9418c5 .

:c_9b9c7fc0 a skos:Concept;
  skos:definition "Aus alternierenden Formen, z.B. geraden und geschwungenen Teilen, gebildeter Bogen. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "Kompositbogen"@de, "arc mixtiligne"@fr;
  skos:broader :c_2026364f;
  dct:created "2019-10-16T10:05:54.000"^^xsd:dateTime;
  dct:modified "2019-12-05T10:21:04.000"^^xsd:dateTime .

:c_7c5ae7fd a skos:Concept;
  skos:definition "Doppelschalenkuppel, ein Gewölbe mit voneinander getrennten Innen- und Außenschalen. [Koepf / Binding 2016]"@de,
    "Gewölbe aus zwei selbständig gemauerten, übereinander Iiegenden Schalen. Diese Konstruktion bietet dem Architekten die Möglichkeit, die Gewölbeschale dem angestrebten Charakter des Innenraumes anzupassen, und das äußere Erscheinungsbild des Gewölbes freier zu gestalten.  [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_1f14b4dd;
  skos:prefLabel "two-shelled vault"@en, "voûte double"@fr, "Zweischalengewölbe"@de;
  skos:altLabel "Doppelgewölbe"@de, "double vault"@en;
  skos:broader :c_332f7a93;
  dct:created "2019-10-16T10:10:09.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:41:04.000"^^xsd:dateTime .

:c_332f7a93 a skos:Concept;
  skos:definition "Gewölbe, meist eine Tonne, das aus mehreren übereinander liegenden Wölbschichten besteht. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "multi-range vault"@en, "voûte à voussoirs superposés"@fr, "mehrschaliges Gewölbe"@de;
  skos:altLabel "multi-range barrel vault "@en, "voûte à plusieurs rangs de voussoirs superposés "@fr;
  skos:broader :c_049c4c22;
  skos:narrower :c_7c5ae7fd;
  dct:created "2019-10-22T17:07:06.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:40:50.000"^^xsd:dateTime;
  :broaderByConstruction :c_049c4c22 .

:c_ea53ad5d a skos:Concept;
  skos:definition "Einen vollen Kreis bzw. ein Oval ausbildender Bogen, wie er z. B. von den Römern beim Kanalbau verwendet wurde. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "annular arch"@en, "arc annulaire"@fr, "Ringbogen"@de;
  skos:altLabel "arc circulaire"@fr, "Kreisbogen"@de;
  skos:broader :c_2026364f;
  dct:created "2019-10-16T10:24:28.000"^^xsd:dateTime;
  dct:modified "2019-12-05T10:24:24.000"^^xsd:dateTime .

:c_028dc319 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ef0a8695;
  skos:prefLabel "Farbmittel"@de;
  skos:broader :c_39442c35;
