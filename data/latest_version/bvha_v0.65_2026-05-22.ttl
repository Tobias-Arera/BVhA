  dct:created "2020-03-03T16:08:14.000"^^xsd:dateTime;
  dct:modified "2021-01-23T13:48:31.000"^^xsd:dateTime .

:c_2a39853a a skos:Concept;
  skos:definition "Pontifikalstrümpfe m pl, caligae, tibilia, udones: bis zum 12.Jh. aus weißem Leinen, später aus farbiger Seide gefertigte Strümpfe des Bischofs; sie unterliegen dem Farbenkanon. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
