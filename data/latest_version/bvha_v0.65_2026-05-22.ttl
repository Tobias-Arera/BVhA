:c_b7de4733 a skos:Concept;
  skos:definition "Seltener Nebel; kreisrunde Lichtöffnung im Scheitel einer Kuppel. [Koepf/Binding 2016]"@de,
    "V některých případech končí kupole nahoře kruhovým otvorem zvaným oko (opaion, opaeum). [Koch 2008]"@cs,
    "Eine meist runde Öffnung im Scheitel einer Kuppel oder eines Klostergewölbes zur Belichtung des Raumes. [Glossarium Artis]"@de,
    "Auge, 1. kreisrunde Lichtöffnung im Scheitel einer Kuppel, gleichbedeutend mit Opaeon. 2. Kleine runde Scheibe im Zentrum der Voluten des Kapitells der Ionischen Ordnung. 3. Weniger gebräuchl. für die Öse am Ankerkopf (Anker). 4. Die Lichtspindel einer Wendeltreppe (Treppena.). [Koepf / Binding 2016]"@de;
  skos:scopeNote "Nabel, Opäum, seltene Bezeichnung für das Auge einer Kuppel. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_37522b74;
  skos:prefLabel "ombilic"@fr, "oko"@cs, "oculus"@en, " ombelico"@it, " ombligo"@es,
    "Auge"@de;
  skos:altLabel "nave"@en, " opaion"@en, "eye"@en, "Nabel"@de, "Opäum"@de, "Scheitelöffnung"@de,
    "Opaion"@de, " ojo de la cúpula"@es, " occhio della cupola"@it, " opaion"@it, "oeil"@fr,
    " œil de dome"@fr, "œil de coupole"@fr;
  skos:broader :c_508c0a07;
  skos:narrower :c_c7c35178;
  dct:created "2019-09-09T19:20:17.000"^^xsd:dateTime;
  dct:modified "2021-01-19T13:16:12.000"^^xsd:dateTime;
  :formsPartOfType :c_049c4c22, :c_ad800342 .

:c_06c72e3c a skos:Concept;
  skos:definition "Gewölbefeld, Joch, Travee, Grundfläche eines Gewölbeabschnitts, der durch Stützen, Gurt- und Scheidbogen als vollständiges Einzelelement eines größeren Gewölbesystems abgeschieden ist. [Koepf / Binding 2016]"@de,
    "Ein größerer Abschnitt innerhalb eines überwölbten Raumes, der sich manchmal konstruktiv oder dekorativ von anderen Abschnitten unterscheidet. Beim Netzgewölbe werden je nach der Lage des Gewölbefeldes ( z . B. im Scheitel, am Widerlager oder am Übergang in ein anderes Gewölbe) präzisierende Termini verwendet, wie z. B. Kopfnetzfeld, offenes und geschlossenes Randnetzfeld, Scheitelnetzfeid, Strahlennetzfeld, Zwikelnetzfeld. Zu unterscheiden vom Gewölbefach. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_1f14b4dd;
  skos:prefLabel "section of a vault"@en, "Gewölbefeld"@de, "champ d\\'une voûte"@fr;
  skos:altLabel "Gewölbeabteilung"@de, "Netzrippenfeld"@de, "section d\\'une voûte"@fr;
  skos:broader :c_3e25acca;
  dct:created "2020-02-12T15:46:33.000"^^xsd:dateTime;
  dct:modified "2021-01-19T13:18:05.000"^^xsd:dateTime .

