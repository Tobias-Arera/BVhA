:c_579c5e3f a skos:Concept;
  skos:definition "Giebelseitig frei vor die Giebelwand gesetztes Sparrenpaar; es wird am Fuß häufig durch einen auf dem vorkragenden Rähm liegenden, in sich unverrückbaren Dreiecksverband (in der Schweiz Flugsparrendreieck genannt, auch Sparrenknecht) gehalten und ruht im oberen Bereich auf vorkragenden Konstruktionshölzern (im Rheinland auch Schwebegiebel genannt). [Koepf / Binding 2016]"@de;
  skos:scopeNote "Analog zum Freirofen bei giebelseitigen Dachüberstand vorstehender Sparren. [BVHA]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd,
    :conceptScheme_19d56a39;
  skos:prefLabel "chevron en saillie"@fr, "Freisparren"@de;
  skos:altLabel "chevron débordant"@fr, "Flugsparren"@de, "Freigespärre"@de;
  skos:broader :c_1abb44b3;
  dct:created "2019-11-21T10:32:37.000"^^xsd:dateTime;
  dct:modified "2020-09-29T10:26:00.000"^^xsd:dateTime .

:c_8b960cda a skos:Concept;
  skos:definition "Kurzes Sparrenstück, das sich mit einem oder beiden Enden gegen einen Grat bzw. Kehlsparren lehnt. [Koepf /Binding 2016]"@de,
    "Schiftsparren (Schifter), die auf die Kehlsparren aufgeklaut werden. [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "tronera"@es, "empanon"@fr, "námětková krokev"@cs, "creeping rafter"@en,
    "falso puntone"@it, "Schiftsparren"@de;
  skos:altLabel "námětek"@cs, "aspillera"@es, "chevron de croupe"@fr, "jack rafter"@en,
    " dormer rafter"@en, " puntone cavaliere"@it, "cabio montado"@es, "Schifter"@de, "Reitersparren"@de;
  skos:broader :c_1abb44b3;
  dct:created "2020-08-20T13:06:51.000"^^xsd:dateTime;
  dct:modified "2020-11-27T09:04:23.000"^^xsd:dateTime .

:c_b96470ae a skos:Concept;
  skos:definition "Auflanger (Zusparren), Sparren für pultdachartige Seitenschiffdächer mehrschiffiger Hallenbauten; sie legen sich auf die Sparrenenden des Mittelschiffdaches und besitzen in der Regel eine sichere Fußpunktausbildung auf den Außenwänden (im Hausbau auch Kübbungssparren). [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Auflanger"@de;
  skos:altLabel "Zugsparren"@de;
  skos:broader :c_1abb44b3;
  dct:created "2020-08-25T11:04:51.000"^^xsd:dateTime;
  dct:modified "2020-09-02T15:34:38.000"^^xsd:dateTime .

:c_97c17ec7 a skos:Concept;
  skos:definition "Schwellenblockkranz: zu einem Rahmen zusammengefügte Schwellen mit kraftschlüssigen Eckverbindungen, deren Hölzer nicht in einer Ebene liegen, sondern verspringen. [Eißing et al. 2012]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_167cb98f,
    :conceptScheme_19d56a39;
  skos:prefLabel "Schwellenblockkranz"@de;
  skos:broader :c_6e8e74ba, :c_f2a5513e;
  dct:created "2019-05-27T16:59:38.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:47:06.000"^^xsd:dateTime;
  :broaderByFunction :c_f2a5513e;
  :broaderByPosition :c_f2a5513e;
  :broaderByConstruction :c_6e8e74ba .

:c_f2a5513e a skos:Concept;
  skos:definition "Im Blockbau werden horizontal aufeinandergeschichtete, an den Ecken kraftschlüssig miteinander verbundene Hölzer zu Blockkränzen gefügt. Der horizontale Ausgleich zwischen den Blockkränzen erfolgt durch eine wechselseitige Anordnung der naturgemäß konischen Baumstämme (Wipfel- über Wurzelende/Zopf- über Stockende). [Eißing et al. 2012]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_167cb98f,
    :conceptScheme_19d56a39;
  skos:prefLabel "Blockkranz"@de;
  skos:broader :c_1cb81a92;
  skos:narrower :c_011040ba, :c_97c17ec7, :c_7c401fa2;
  dct:created "2019-11-04T16:43:15.000"^^xsd:dateTime;
