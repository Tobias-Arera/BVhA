:c_ff9ff443 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe;
  skos:prefLabel "Blendmaßwerkfenster"@de;
  skos:broader :c_2a600321;
  skos:related :c_bc1a3522;
  dct:created "2020-09-02T12:35:01.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:09:23.000"^^xsd:dateTime .

:c_bc1a3522 a skos:Concept;
  skos:definition "Blendmaßwerk, einer nicht durchbrochenen Mauerfläche (z. B. Giebel) vorgeblendetes, d. h. aufgelegtes Maßwerk, häufig in Verbindung mit einem Blendfenster oder zur Füllung einer Blende, auch bei Holzvertäfelungen und anderem Holz- und Metallwerk, in der Gotik und im 19. Jh. angewandt. [Koepf / Binding 2016]"@de,
    "Slepá kružba je umístěna na plné stěně. [Koch 2008]"@cs;
  skos:scopeNote "Einer geschlossenen Wand vorgeblendetes Maßwerk. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "blind tracery"@en, "remplage aveugle"@fr, "slepá kružba"@cs, "traforo cieco"@it,
    "tracería falsa"@es, "Blendmaßwerk"@de;
  skos:altLabel "remplage simulé"@fr, "tracería simulada"@es;
  skos:broader :c_804ab319, :c_ghjjnlc5;
  skos:related :c_ff9ff443;
  dct:created "2020-06-16T14:47:05.000"^^xsd:dateTime;
  dct:modified "2021-01-25T18:22:46.000"^^xsd:dateTime .

:c_af38f5d3 a skos:Concept;
  skos:scopeNote "Vasa sacra; vasa dominica; ministeria sacrosancta; vasa sacramentorum: Altargeräte erster Ordnung, die mit der Eucharistie, den Heiligen Gaben Brot und Wein in Berührung kommen, wie Kelch, Patene, Ziborium und eucharistische Monstranz; in der Ostkirche auch der eucharistisehe Löffel. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "liturgické nádoby"@cs, "vasa sacra (katholisch)"@de, "vasa dominica"@la;
  skos:altLabel "ministeria sacrosancta"@la, "vasa sacramentorum"@la;
  skos:broader :c_1d666449;
  skos:narrower :c_d28a68ed, :c_14a349f2, :c_40d7ba03, :c_ecfe6614, :c_6086188f, :c_11a3e1f0,
    :c_76528fa1, :c_9587110f, :c_b9afb0f1;
  skos:related :c_8ed854bc, :c_ea59b5fa;
  dct:created "2020-02-23T17:50:38.000"^^xsd:dateTime;
  dct:modified "2021-01-24T14:58:15.000"^^xsd:dateTime .

:c_958612cc a skos:Concept;
  skos:definition "Echinus (gr. echinos: Igel, Seeigel), Polster, der wulstartige, im Querschnitt kreisförmige Teil des dor. Kapitells, der zwischen der Deckplatte (Abacus) und dem Säulenschaft vermittelt (Dorische Ordnung), mit Ringen (Anuli) an seiner unteren Kante. In der Frühzeit stark bauchig und weit ausladend, erscheint der E. in der klass. Form gestraffter und erstarrt in der nachklass. Zeit fast zum Kegelstumpf. [Koepf / Binding 2016]"@de,
    "ECHINUS, část dórské a iónské lavice. [Koch 2008]"@cs, "Der zwischen Abakus und Säulenschaft liegende polsterförmige, im Querschnitt kreisrunde Abschnitt des dorischen Kapitells. An seinem unteren Ende finden sich meist vier scharf profilierte Ringe, die sogenannten Anuli. [Glossarium Artis]"@de;
  skos:scopeNote "Teil des dorischen und ionischen Kapitells. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9, :conceptScheme_1f14b4dd;
  skos:prefLabel "échine"@fr, "echinus"@en, "Echinus"@de, "echinus"@cs;
  skos:broader :c_381f9e69;
  dct:created "2020-02-20T12:27:50.000"^^xsd:dateTime;
  dct:modified "2020-09-07T09:47:04.000"^^xsd:dateTime .

:c_68223333 a skos:Concept;
