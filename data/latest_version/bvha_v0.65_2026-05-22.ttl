:c_24f8dff1 a skos:Concept;
  skos:definition "Meist geflügelter kleiner Knabe als Liebesgott in weltlichen Szenen besonders des Rokoko nach dem Vorbild der antiken Eroten. [Koch 2009]"@de,
    "Většinou okřídlený chlapeček jako bůžek lásky ve světských scénách, zvl. ,; době rokoka podle vzoru antických erotů. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "Amorette"@de, "amorek"@cs;
