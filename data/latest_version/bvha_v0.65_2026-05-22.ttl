:c_19f2b5e4 a skos:Concept;
  skos:definition "Von der Decke herabhängend mit mehreren Lichtern. In Form einer Krone oder eines Rades (Radleuchter) mit Türmen und Toren als Symbol des himmlischen Jerusalem (Romanik), auch mit Figuren; als Schaft oder Kugel mit strahlenförmigen Armen (Gotik), später aus Glas (Renaissance, besonders in Venedig). [Koch 2009]"@de,
    "Svítidlo zavěšené pod stropem, i s několika světly, má tvar koruny nebo kruhu s věžičkam,1 a branami Jako symbolem nebeského Jeruzaléma (jeruzalémský lustr, románská doba), také s figurami; dřík nebo koule s paprskovitými rameny (gotika), později ze skla (renesance, zvl. v Benátkách). [Koch 2008]"@cs,
    "Kronleuchter m; gr. polykandelon; lat. corona lucis; coronapharaIis: ein runder, vielarmiger Hängeleuchter, manchmal mit mehreren Lichterreihen übereinander, deren oberste Panasch (m) genannt wird. Ein Kronleuchter mit der Figur der Jungfrau Maria heißt Marienleuchter (m) oder Muttergottesleuchter (m). [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_50ec0c5e, :conceptScheme_37522b74, :conceptScheme_8c0441f9, :conceptScheme_1f14b4dd;
  skos:prefLabel "Kronleuchter"@de, "lustr"@cs, "couronne de lumière"@fr, "corona lucis"@la,
    "corona lucis"@en;
  skos:altLabel "polykandelon"@el, "crown of light"@en, "corona pharalis"@la;
  skos:broader :c_fe6ee255;
  skos:narrower :c_81f107fc;
  skos:related :c_397b5b94, :c_c8f98864;
  dct:created "2020-08-04T14:14:43.000"^^xsd:dateTime;
  dct:modified "2021-01-30T22:46:00.000"^^xsd:dateTime .

:c_397b5b94 a skos:Concept;
  skos:definition "Radleuchter m; Reifenkrone f; auch Radkrone f; Lichtkrone f; lat. rota; corona: ein kreisförmiger Hängeleuchter, Vorläufer des KronIeuchters. Er war meist aus Bronze, seltener aus vergoldetem Kupfer gefertigt und mit Zinnen, Türmen und Toren verziert. Er sollte die Heilige Stadt symbolisieren (Apk 21, 10-21) und wurde deshalb auch Himmlisches Jerusalem (n) genannt. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "rota"@la, "roue de lumière"@fr, "corona"@en, "Radleuchter"@de;
  skos:altLabel "corona"@la, "couronne ardente"@fr, "Reifenkrone"@de, "Radkrone"@de,
    "Lichtkrone"@de;
  skos:broader :c_fe6ee255;
  skos:related :c_19f2b5e4;
  dct:created "2020-08-04T14:15:14.000"^^xsd:dateTime;
  dct:modified "2021-01-30T22:47:11.000"^^xsd:dateTime .

