:c_0edb1fea a skos:Concept;
  skos:scopeNote "Dachhelm, Helmdach, ein auf allen Seiten mit geraden Flächen nach oben spitz zulaufendes Dach, bes. bei Türmen als Rhombendach, Zeltdach oder Pyramidendach auftretend. [Koepf / Binding 2016]"@de,
    "Též helmice, strmá věžová střecha, tvar jehlanu, kužele, někdy i čepice nebo kupole. [Koch 2008]"@cs,
    "Steiles Turmdach, pyramiden-, kegelförmig, auch hauben- oder kuppelförmig. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "Turmdach"@de, "helmicová střecha"@cs;
  skos:altLabel "Helmdach"@de, "Dachhelm"@de;
  skos:broader :c_f4e2bee8;
  skos:related :c_a2025113, :c_6cef8be4;
  dct:created "2019-05-18T12:41:51.000"^^xsd:dateTime;
  dct:modified "2020-09-30T10:22:33.000"^^xsd:dateTime;
  :broaderByPosition :c_f4e2bee8 .

:c_6cef8be4 a skos:Concept;
  skos:definition "Helm, Helmdach, Dachhelm, Turmhelm; spitze Dachform über polygonalem Grundriss. Als H.dach (Dachh.) meist eine Zimmermannskonstruktion mit Kaiserstiel, als Turmh. eher massiv oder durchbrochen im Steinbau, wobei die Grenzen der Terminologie allerdings fließend sind. [Koepf / Binding 2016]"@de,
    "Der obere Abschluss eines Turms mit geneigten Dachflächen, meist in Pyramidenform (Dachform). In der Romanik gab es massive Steinhelme, in der Gotik durchbrochene und aus Maßwerkformen gebildete. In der Barockzeit wurden außer Zwiebelformen auch mit Voluten und Skulpturen geschmückte, steinerne T.e errichtet. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "spire"@en, "cuculla"@ca, "střecha věže"@cs, "Turmhelm"@de, "flèche"@fr,
    "chapitel"@es, "guglia"@it;
  skos:altLabel "Helmdach"@de, "Dachhelm"@de, "Helm"@de, "aiguille"@fr, "cucurulla"@ca,
    "cucurull"@ca, "agulla"@ca, "věžní báň"@cs, "polygonal spire"@en, "aguja"@es, "flecha de la torre"@es,
    "remate de la torre"@es;
  skos:broader :c_5c402a54, :c_f4e2bee8;
  skos:narrower :c_efb761d9, :c_14e579d7, :c_a5a14f82;
  skos:related :c_a2025113, :c_0edb1fea;
  dct:created "2019-09-24T18:45:18.000"^^xsd:dateTime;
  dct:modified "2021-01-22T13:53:28.000"^^xsd:dateTime;
  :broaderByPosition :c_5c402a54, :c_f4e2bee8 .

:c_dd2b0fad a skos:Concept;
  skos:definition "Turm über dem Chorjoch oder über dem Rechteckchor oder der Apsis im O. oder W. einer Saalkirche, selten an einer dreischiffigen Basilika über den Nebenchören. Sein Erdgeschoss ist auf einer Seite zum Kirchenraum geöffnet und enthält den Hauptaltar; der Turm dient als Glockenturm. C.e in größerer Dichte finden sich in roman. und got. Zeit zwischen Oberrhein, Donau und Main, in Thüringen, im Elsass, in Teilen von Frankreich und Skandinavien. Bes. in Mittel- und Unterfranken hält er sich bis ins 18. Jh. (Chorflankenturm, Chorwinkelturm). [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "Chorturm"@de, "chórová věž"@cs;
  skos:broader :c_56d01309;
  dct:created "2019-02-18T18:19:29.000"^^xsd:dateTime;
  dct:modified "2021-01-22T13:24:29.000"^^xsd:dateTime .

:c_31571146 a skos:Concept;
  skos:definition "Als Zylinder, Kubus oder Achteck auf der Vierung ruhender und über das Kirchendach aufragender Turm; er kann mehrgeschossig sein und seinen Querschnitt ändern. Zunächst als Holzkonstruktion (5.-10. Jh.) bis zu drei Geschossen (Tristegum) hoch, besteht er seit Anfang des 10. Jhs. aus Stein und ruht auf Trompen. [Koepf / Binding 2016]"@de,
    "Křížení lodí může zvenčí naznačovat věž nad kříženími, která je dále zdůrazněna sanktusníkem, nebo kupolí. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_37522b74;
  skos:prefLabel "cimbori"@ca, "lantern tower"@en, "věž nad křížením"@cs, "Vierungsturm"@de,
    "cimborrio"@es, "tour-lanterne"@fr, "torre nolare"@it;
  skos:altLabel "crossing tower"@en, "tour du transept"@fr, "torre de un crucero"@es;
  skos:broader :c_a2025113;
  dct:created "2019-02-18T18:19:36.000"^^xsd:dateTime;
  dct:modified "2021-01-22T13:36:12.000"^^xsd:dateTime .

