:c_f3054d31 a skos:Concept;
  skos:definition "Äußere Schale einer zweischaligen Kuppel oder eine über einer Kuppel liegende zweite Kuppel, die als Wetterschutz dient. [Koepf / Binding 2016]"@de,
    "Eine Kuppel, die über eine andere gespannt ist, um sie gegen schädliche Witterungseinflüsse etc. zu schützen, oder auch um die Auflast am Kuppelfuß zu erhöhen. Beispiel: die dritte Schale über dem Pantheon in Paris, 1764-1790. (Glossarium Artis)"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "coupole de protection"@fr, "protective dome"@en, "cupola esterna"@it,
    "cúpula protectora exterior"@es, "Schutzkuppel "@de, "vnější plášt\\'"@cs;
  skos:altLabel "outer dome"@en, "exterior dome"@en, "coupole extérieure"@fr, "dôme extérieur"@fr,
    "víceplášt\\'ové kopule"@cs;
  skos:broader :c_ad800342;
  dct:created "2020-01-09T08:26:54.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:36:32.000"^^xsd:dateTime;
  :broaderByFunction :c_ad800342 .

:c_da875175 a skos:Concept;
  skos:definition "Ein formal der Kuppel gleichender, jedoch nicht mit Keilsteinen errichteter Bau. Die frühesten Beispiele falscher Kuppeln, eher mit parabelförmiger als mit sphärischer Gewölbelinie, stammen vom Anfang des 2. Jahrtausends aus Mesopotamien und Ägypten. Sie wurden nicht nur über kreisrunder Grundfläche erbaut, sondern auch - teils mit Pendentifs oder Trompen - über rechteckiger Grundfläche. Beispiel: Das Kuppelgrab und Schatzhaus des Atreus zu Mykene. (Glossarium Artis)"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "fausse coupole"@fr, "false dome"@en, "Scheinkuppel"@de;
  skos:altLabel "Pseudokuppel "@de, "falsche Kuppel "@de;
  skos:broader :c_ad800342;
  dct:created "2020-01-09T08:28:44.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:35:55.000"^^xsd:dateTime;
  :broaderByConstruction :c_ad800342 .

:c_5e9f4fc4 a skos:Concept;
  skos:definition "Eine Kuppel von untergeordneter Bedeutung oder geringerer Abmessung, wie z. B. die Kuppeln über dem Querschiff einer Kreuzkuppelkirche oder die Kuppeln über dem Langhaus gegenüber der Vierungskuppel bei einer Kuppelbasilika. (Glossarium Artis)"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "coupole secondaire"@fr, "secondary dome"@en, "Nebenkuppel "@de;
  skos:broader :c_ad800342;
  dct:created "2020-01-09T08:31:10.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:33:43.000"^^xsd:dateTime;
  :broaderByPosition :c_ad800342 .

:c_a3a4093c a skos:Concept;
  skos:definition "Kuppelförmige Bedachung, die aus einer einzigen mächtigen Steinplatte gehauen ist. Beispiel: Die Kuppel über dem Grabmal des Theoderich zu Ravenna in Form einer Flachkuppel bzw. einer Kalotte. (Glossarium Artis)"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "dome monolithique"@fr, "monolithic dome"@en, "Monolithkuppel "@de;
  skos:broader :c_ad800342;
  dct:created "2020-01-09T08:33:04.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:33:29.000"^^xsd:dateTime;
  :broaderByConstruction :c_ad800342 .

:c_46710a61 a skos:Concept;
  skos:definition "Mit Kragsteinen gemauerte Pseudokuppel, wie das Tholosgewölbe, die etruskische Kuppel, die Trulli, Talaioten, Nuraghen und Kuppelgräber. Beispiel: die Trullo-Gruppe in Albarello/ Apulien und die Bienenkorbhäuser auf Zypern. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "coupole en tas-de-charge"@fr, "corbel dome"@en, "Kragkuppel "@de;
  skos:altLabel "beehive dome"@en, "corbeled dome"@en;
  skos:broader :c_ad800342;
  skos:related :c_2fce538c;
  dct:created "2020-01-09T08:34:19.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:32:32.000"^^xsd:dateTime;
  :broaderByConstruction :c_ad800342 .

:c_4fb9be65 a skos:Concept;
  skos:definition "Die den Innenraum überwölbende Kuppel einer mehrschaligen Kuppelkonstruktion. (Glossarium Artis)"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "voûte intérieure (de la coupole)"@fr, "inner dome"@en, "Innenkuppel"@de;
  skos:altLabel "première coupole"@fr, "inner shell"@en, "Raumkuppel "@de;
  skos:broader :c_ad800342;
  dct:created "2020-01-09T08:37:04.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:31:54.000"^^xsd:dateTime;
  :broaderByPosition :c_ad800342 .

:c_d583a72a a skos:Concept;
  skos:definition "Gezimmerte Pseudokuppel, die den Eindruck einer echten, mit Keilsteinen gewölbten Kuppel erwecken soll. Beispiel: Die stuckierte und bemalte HauptkuppeI der Wallfahrtskirche Wies/ Oberbayern, 1746. (Glossarium Artis)"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe;
  skos:prefLabel "coupole en bois"@fr, "wooden dome"@en, "Holzkuppel "@de;
  skos:broader :c_ad800342;
  dct:created "2020-01-09T08:41:53.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:31:37.000"^^xsd:dateTime;
  :broaderByConstructionMaterial :c_ad800342 .

:c_9c0f0fa2 a skos:Concept;
  skos:definition "Außenkuppel, Schutzkuppel, Mantelkuppel, äußere Kuppelschale einer mehrschaligen Kuppel. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "dôme"@fr, "outer dome"@en, "Außenkuppel "@de;
  skos:altLabel "Mantel"@de, "outer shell"@en;
  skos:broader :c_ad800342;
  dct:created "2020-01-09T08:49:52.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:28:46.000"^^xsd:dateTime;
  :broaderByPosition :c_ad800342 .

:c_54cc966e a skos:Concept;
  skos:definition "Kuppel, die durch ihre Lage und Größe, manchmal auch durch ihre besondere Konstruktion und dekorative Ausgestaltung eine hervorragende Stellung im Gesamtplan eines Bauwerkes einnimmt, das auch noch andere Kuppeln besitzt, wie z. B. die Zentralkuppel einer Kreuzkuppelkirche oder die Vierungskuppel einer Kuppelbasilika. > Nebenkuppel (Glossarium Artis)"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe;
  skos:prefLabel "coupole principale"@fr, "main dome"@en, "Hauptkuppel"@de;
  skos:altLabel "maîtresse-coupole"@fr, "principal dome"@en;
  skos:broader :c_ad800342;
  dct:created "2020-01-09T10:16:00.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:31:07.000"^^xsd:dateTime;
  :broaderByPosition :c_ad800342 .

:c_81470b6e a skos:Concept;
  skos:definition "Kuppel, deren Tragwerk senkrecht über das Kämpfergesims hinaus bis zum Beginn der Gewölbelinie weitergeführt ist, z. B. durch einen Tambour. (Glossarium Artis)"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "coupole surélevée"@fr, "stilted dome "@en, "Gestelzte Kuppel "@de;
  skos:broader :c_ad800342;
  dct:created "2020-01-09T10:38:33.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:30:26.000"^^xsd:dateTime;
  :broaderByConstruction :c_ad800342 .

:c_ce22829c a skos:Concept;
  skos:definition "Kuppel mit Scheitelöffnung (Kuppelauge), über der oft eine Laterne oder aber eine weitere Kuppelschale liegt. (Glossarium Artis)"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "coupole à oculus"@fr, "oculus-dome"@en, "Offene Kuppel "@de;
  skos:broader :c_ad800342;
  dct:created "2020-01-09T10:43:53.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:33:57.000"^^xsd:dateTime;
  :broaderByShape :c_ad800342 .

:c_a9cead41 a skos:Concept;
  skos:definition "Altarretabel (lat. retabulum: Rückwand), jeder Altaraufsatz, im dt. Sprachgebrauch oft schlechthin Altar genannt, eine entweder auf die Mensa des (kath.) Altars direkt aufgesetzte, auf einem Zwischenstück (Predella) oder hinter diesem auf einem Unterbau stehende Schauwand, die im MA aufkam. Das roman. A. aus Stein, Stuck oder Metall ist mit Reliefs, wenn aus Holz mit Malereien geschmückt. Sein Umriss ist rechteckig, halbrund oder rechteckig mit halbrunder Erhöhung in der Mitte. Die Gotik entwickelt das A. mit bemalten Tafeln und umgibt diese mit einem architekton. Rahmen, der mit einem Aufbau aus Pfeilern, Wimpergen und Fialen (Gesprenge) versehen und durch Hinzufügung von Flügeln zu einem Flügelaltar erweitert werden kann. In Renaissance und Barock ist das hinter dem Altar aufgebaute A. üblich, wobei auf Flügel weitgehend verzichtet und nur das Altarblatt genannte Mittelbild beibehalten wird, dessen architekton. Umrahmung in Form einer Ädikula mit der Architektur des Chors und des ganzen Kirchenraums zu einer stilist. und scheinbar konstrukt. Einheit verschmilzt. [Koepf / Binding 2016]"@de,
    "Oltářní nástavec, zadní stěna zdobená malbami nebo soškami, která bývala ve středověku pevně spojena s mensou a v gotické době rozšířena na křídlový oltář. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_37522b74;
  skos:prefLabel "retable"@en, "retable"@fr, "Altarretabel"@de, "retablo"@es, "oltářní retábl"@cs;
  skos:altLabel "Retabel"@de, "altarpiece"@en, "retabulum"@cs, "Altaraufsatz"@de;
  skos:note "Eigenständiger Aufsatz auf einem Altar. "@de;
  skos:broader :c_0f62a529;
  skos:narrower :c_b9806b99, :c_bb0125ec, :c_fda29c7e, :c_927c8dd6, :c_828bc2e9, :c_d2c7cee1;
  dct:created "2020-01-10T17:47:50.000"^^xsd:dateTime;
  dct:modified "2021-01-30T23:59:39.000"^^xsd:dateTime .

:c_bb0125ec a skos:Concept;
  skos:scopeNote "Zweiflügeliger, klappbarer Altaraufsatz. "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe;
  skos:prefLabel "Dyptychon"@de, "diptych"@cs;
  skos:broader :c_a9cead41;
  dct:created "2020-01-15T16:46:31.000"^^xsd:dateTime;
  dct:modified "2021-01-30T23:59:50.000"^^xsd:dateTime .

:c_fda29c7e a skos:Concept;
  skos:definition "Polyptychon (griech. polys = viel; ptyx, Genitiv ptychos = Falte; polyptychos = faltenreich), Flügelaltar (Altar) oder Gemälde mit mehr als 2 Flügeln. [Koch 2009]"@de,
    "Řec. polys = mnoho; ptyx, 2. p. ptychos = záhyb; polyprychos = s četnými záhyby,  křídlový oltář, nebo obraz s více než 2 křídly. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "polyptych"@en, "polyptych"@cs, "Polyptychon"@de;
  skos:note "Mehrflügeliger (>3), klappbarer Altaraufsatz. "@de;
  skos:broader :c_a9cead41;
  dct:created "2020-01-15T16:53:21.000"^^xsd:dateTime;
  dct:modified "2021-01-31T00:01:58.000"^^xsd:dateTime .

:c_927c8dd6 a skos:Concept;
  skos:definition "Triptychon (griech.), Bild aus drei miteinander verbundenen Teilen, insbesondere der mittelalterliche Flügelaltar mit feststehendem Mittelteil und beweglichen Flügeln. [Koch 2009]"@de,
    "Triptych, řec. obraz ze tří navzájem spojených částí, zvl. středověký křídlový oltář s pevnou střední částí a pohyblivými křídly. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "Triptychon"@de, "triptych"@cs;
  skos:broader :c_a9cead41;
  dct:created "2020-01-15T16:53:29.000"^^xsd:dateTime;
  dct:modified "2021-01-31T00:02:24.000"^^xsd:dateTime .

:c_828bc2e9 a skos:Concept;
  skos:definition "Pala is an Italian word for a large altapiece, and is used only for a single picture in which the action, the figures, and scene are treated as being in one consistent space, and occuring in a single pictorial continuum. It is described as a \\'pala of a unified type\\' in contrast to an ancona (Retabel), which usually consists of several pictures united in a singel frame, but not necessarily consistent between themselves; or a polyptych, which consists normally of a central picture with a number of smaller pictures - usually figures of saints - grouped round it. [Oxford Dictionary of Christian Art & Architecture 2004].  "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_6018174b;
  skos:prefLabel "pala"@en, "pala"@cs, "Pala"@de;
  skos:broader :c_a9cead41;
  dct:created "2020-01-28T20:55:48.000"^^xsd:dateTime;
  dct:modified "2021-01-31T00:01:44.000"^^xsd:dateTime .

:c_d2c7cee1 a skos:Concept;
  skos:definition "Hauptsächl. von der dt. Gotik entwickelte Form des Altarretabels. Der F. besteht aus einem feststehenden, meisthölzernen Mittelteil, dem Altarschrein, an dem rechts und linksbewegl. Flügel aus Holz angebracht sind. Schrein und Flügelsind mit geschnitzten (Schnitzaltar) oder gemalten Darstellungen versehen, doch sind die Flügel an ihrer Außenseite meist nur bemalt, so dass der F., wenn er geschlossen ist, lediglich Gemälde zeigt. Statt des einen Flügelpaares kann der Schrein auch mehrere Flügel haben, was einen mehrfachen Wandel der Ansichten ermöglicht (Wandelaltar). Im 15. Jh. und später wird der F. mit einem Untersatz in der Breite des Schreins versehen, der Predellaoder Altarstaffel, die meist auch mit geschnitzten oder gemalten Darstellungen ausgestattet ist und in der Mitte ein Gehäuse zur Aufnahme des Hostienbehälters haben kann. In der Spätgotik erhält der Schrein vielfach einen hohen,turmartigen Aufbau, das Gesprenge, ein Gebilde aus zierl. und dünnen Architekturgliedern, auch mit geschnitzten Figuren besetzt. [Koepf / Binding 2016]"@de,
    "Byl nejvíce rozšířen v 15.-16. stol., především v Německu, Nizozemsku, severovýchodní Francii a Skandinávii. [Koch 2008]"@cs,
    "Das Flügelretabel ist ein Altarretabel, das mit beweglichen Flügeln versehen ist und dessen Mittelteil (Tafel, Schrein) geschlossen und geöffnet werden kann, um die Schauseite zu verändern. [RDK Labor]"@de,
    "Der Flügelaltar hat seine Blütezeit im 15.-16. Jh., besonders in Deutschland, den Niederlanden, NO-Frankreich, Skandinavien. Bei ihm dient eine Predella (Altarstaffel auf der Mensa) als Reliquiengrab und als Untersatz für den feststehenden Altarschrein. Diesem sind links und rechts Flügel angesetzt. Schrein, Flügel und meist auch Predella werden mitgeschnitzten (Schnitzaltar) oder gemalten Bildern versehen.Mit mehreren Flügelpaaren lassen sich die Ansichten abwandeln (Wandelaltar). Spätgotische Schreine tragen ein Gesprenge, eine zierlich-durchsichtige Anordnung von dünnen Stäben, mit Krabben besetzten Fialen, auch Konsolfiguren unter Baldachinen. [Koch 2009]"@de;
  skos:scopeNote "In der Literatur findet sich oft der irreführende Begriff des \"Flügelaltars\". Dieser beschreibt jedoch keine Altarform, sondern ist synonym für das Flügelretabel zu verstehen."@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_37522b74, :conceptScheme_8c0441f9, :conceptScheme_cf792a3c;
  skos:prefLabel "Flügelretabel"@de, "polittico"@it, "křídlový retábl"@cs, "polyptique"@fr,
    "winged altarpiece"@en;
  skos:altLabel "polyptych"@en, "Schnitzretabel"@de, "Klappretabel"@de, "Wandelretabel"@de,
    "Flügelaltar"@de, "altare a portelli"@it, "křídlový oltář"@cs, "retable aux volets"@fr;
  skos:broader :c_a9cead41;
  skos:narrower :c_9e3fea21, :c_82abd10e, :c_44ceb1c0;
  skos:related :c_9eb36631, :c_c72822bd;
  dct:created "2020-02-26T11:26:03.000"^^xsd:dateTime;
  dct:modified "2021-01-31T00:00:03.000"^^xsd:dateTime .

:c_9eb36631 a skos:Concept;
  skos:definition "Retabelreliquiar n: Reliquienbehältnis in Form eines kleinen Altares oder FIügelaltares mit Retabel, in der Regel auf einem Ständer montiert. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "rétable-reliquaire"@fr, "reredos-reliquary"@en, "Retabelreliquiar"@de;
  skos:broader :c_b9eb688f;
