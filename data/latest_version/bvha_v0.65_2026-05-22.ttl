:c_7e4c947d a skos:Concept;
  skos:definition "Folge mehrerer Treppenläufe zwischen zwei Geschossen bei reicheren (zwei-, drei-, mehrarmigen) Treppenformen. [Koepf / Binding 2016]"@de,
    "Schodišťové rameno vedoucí v jiném směru než druhé schodišťové rameno (lomené schodiště), s nímž má však společné odpočívadlo. [Koch 2008]"@cs,
    "Treppenlauf, der in eine andere Richtung als ein zweiter Treppenlauf führt (gebrochene Treppe), mit diesem aber einen gemeinsamen Treppenabsatz = Podest hat. Jeder Arm kann wieder mehrere Läufe und Richtungen haben. Zwei- oder mehrarmig heißt eine Treppenanlage, die a) nicht mit demselben Treppenlauf beginnt oder endet oder b) von einem gemeinsamen Podest aus sich in 2 Läufe teilt, die in unterschiedliche, z.B. entgegengesetzte Richtungen führen. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "Treppenarm"@de, "ala de la escalera imperial"@es, "schodišťová část"@cs,
    "stair shapes"@en, "montée (d\\'escalier)"@fr;
  skos:altLabel "rampa di scala"@it, "brazo ala de la escalera imperial"@es, "aile (d\\'escalier)"@fr,
    "schodišt\\'ové rameno"@cs;
  skos:broader :c_70bbf373;
  dct:created "2020-08-07T14:31:12.000"^^xsd:dateTime;
  dct:modified "2021-01-22T18:02:53.000"^^xsd:dateTime .

