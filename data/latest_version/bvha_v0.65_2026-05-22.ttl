:c_882249f7 a skos:Concept;
  skos:definition "Im Bauhandwerk wurde im Mittelalter meist mit der Einheit Werkschuh gearbeitet, eingeteilt in 12 Zoll. Darauf deuten zumindest viele mittelalterliche Quellen hin, in denen meist von Schuch oder Werkschuch gesprochen wird. [Voelkle 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_f10222e0;
  skos:prefLabel "Werkschuh"@de;
  skos:altLabel "Schuch"@sw;
  skos:broader :c_bac07f36;
  dct:created "2019-11-14T10:53:06.000"^^xsd:dateTime;
  dct:modified "2019-12-03T18:11:29.000"^^xsd:dateTime .

:c_120a6daf a skos:Concept;
  skos:definition "Um einen Zoll zu erhalten, wird der Fuß in zwölf Teile geteilt. [Voelkle 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_f10222e0;
  skos:prefLabel "Zoll"@de;
  skos:broader :c_bac07f36;
  dct:created "2019-11-14T10:55:24.000"^^xsd:dateTime;
  dct:modified "2019-11-14T10:57:23.000"^^xsd:dateTime .

:c_1e729de0 a skos:Concept;
  skos:definition "4 Zoll ergeben einen jungen (kleinen) Schuh. [Voelkle 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_f10222e0;
  skos:prefLabel "Junger Schuh"@de;
  skos:altLabel "Kleiner Schuh"@de;
  skos:broader :c_bac07f36;
  dct:created "2019-11-14T10:58:22.000"^^xsd:dateTime;
  dct:modified "2019-11-14T11:01:45.000"^^xsd:dateTime .

:c_18890b41 a skos:Concept;
  skos:definition "4 Zoll ergeben einen jungen (kleinen) Schuh, wenn dieser durch 12 geteilt wird, erhält man die jungen Zoll. [Voelkle 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_f10222e0;
  skos:prefLabel "Junger Zoll"@de;
  skos:broader :c_bac07f36;
  dct:created "2019-11-14T11:02:41.000"^^xsd:dateTime;
  dct:modified "2019-11-14T11:04:33.000"^^xsd:dateTime .

:c_42d54615 a skos:Concept;
  skos:definition "Benötigt man einen noch kleineren Schuh zum »Reissen« (=Zeichnen), nimmt man einen Zoll aus dem alten Schuh und teilt ihn in 3 Teile. [Voelkle 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_f10222e0;
  skos:prefLabel "Ganz junger Schuh"@de;
  skos:altLabel "Ganz kleiner Schuh"@de;
  skos:broader :c_bac07f36;
  dct:created "2019-11-14T11:06:50.000"^^xsd:dateTime;
  dct:modified "2019-11-14T11:09:45.000"^^xsd:dateTime .

:c_0d9aca59 a skos:Concept;
  skos:definition "Benötigt man einen noch kleineren Schuh zum »Reissen« (=Zeichnen),nimmt man einen Zoll aus dem [...] Schuh und teilt ihn in 3 Teile. Werden diese drei Teile ebenfalls durch 12 geteilt, so erhält man die ganz jungen Zoll. [Voelkle 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_f10222e0;
  skos:prefLabel "Ganz junger Zoll"@de;
  skos:altLabel "Ganz kleiner Zoll"@de;
  skos:broader :c_bac07f36;
  dct:created "2019-11-14T11:10:30.000"^^xsd:dateTime;
  dct:modified "2019-11-14T11:15:13.000"^^xsd:dateTime .

