:c_389a7b39 a skos:Concept;
  skos:definition "Das untere, am Binder aufruhende Ende des Sparrens eines Sparrendachs. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "pied de chevron"@fr, "piede del puntone"@it, "Sparrenfuß"@de, "pie de cabio"@es;
