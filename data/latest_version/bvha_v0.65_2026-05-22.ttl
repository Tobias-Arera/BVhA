:c_a469ccf4 a skos:Concept;
  skos:definition "Chrisam n / m, heiliges / r ; heiliges Chrisma n; ost. Myron n (gr.); gr. chrisma; lat. sanctum chrisma (s. c .); russ. miro: eine Mischung aus konsekriertem Olivenöl und Balsam, die vom Bischof bei feierlichen Weihen (Priester-, Kirch-, Altar- und Glockenweihe) verwendet wird. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "sanctum chrisma"@la, "saint-chrême"@fr, "chrisma"@el, "chrism"@en,
    "miro"@ru, "heiliges Chrisam"@de;
