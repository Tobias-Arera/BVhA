:c_b908427f a skos:Concept;
  skos:definition "Schräge Buchunterlage auf einem Ständer im Chor, auf der Brüstung eines Ambos oder Lettners für die Verlesung des Evangeliums oder der Epistel oder als Notenpult (oft mehrseitig) für den Kirchenchor. [Koch 2009]"@de,
    "ČTECÍ PULT, šikmý podstavec pro knihy na stojanu v chóru, na parapetu ambony nebo lettneru sloužící pro předčítání evangelia nebo epištol, příp. jako notový pult (často vícestranný) pro chrámový chór, orlí pult. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "lectern"@en, "pupitre"@fr, "čtecí pult"@cs, "leggio"@it, "pupitre de lectura "@es,
    " Lesepult "@de;
  skos:altLabel "letteron"@fr;
  skos:broader :c_10499337;
  skos:narrower :c_96bf1bc0, :c_8095db87;
  dct:created "2020-05-22T11:20:09.000"^^xsd:dateTime;
  dct:modified "2021-01-27T21:33:36.000"^^xsd:dateTime .

:c_96bf1bc0 a skos:Concept;
