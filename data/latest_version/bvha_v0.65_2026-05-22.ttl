  dct:modified "2021-01-27T01:33:07.000"^^xsd:dateTime .

:c_f42ecd51 a skos:Concept;
  skos:definition "Ein Saal, dessen Decke von Säulen getragen wird. Bekannte S.e sind die Apadana der pers. Königspaläste (Hunderts.), die Quersäle ägypt. Tempel und der S.moscheen (Hypostyl). Eine Sonderform des S.s ist der ägypt. Saal, ein dreischiffiger s. der hellenist. Baukunst mit basilikal erhöhtem Mittelschiff. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "columned hall"@en, "salle à colonnes"@fr, "sloupový sál"@cs, "sala ipostila"@it,
    "salón con columnas"@es, "Säulensaal"@de;
  skos:altLabel "sloupová síň"@cs, "hypostyle hall"@en, "hypostyl"@cs;
  skos:broader :c_e3d4f39a;
  dct:created "2020-08-21T10:52:22.000"^^xsd:dateTime;
  dct:modified "2025-11-11T22:40:09"^^xsd:dateTime;
  :narrowerByCulturalArea :c_a5601b31 .

