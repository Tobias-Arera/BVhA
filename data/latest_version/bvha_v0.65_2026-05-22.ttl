  dct:created "2019-06-18T08:12:19.000"^^xsd:dateTime;
  dct:modified "2019-06-18T08:13:29.000"^^xsd:dateTime .

:c_7f6d98b0 a skos:Concept;
  skos:scopeNote "Oberes waagrechtes Holz eines Fenster- oder Flügelrahmens."@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_b41bd73a;
  skos:prefLabel "Oberschenkel"@de;
  skos:broader :c_e4dee1e3;
