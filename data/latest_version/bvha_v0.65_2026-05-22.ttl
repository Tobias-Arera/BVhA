:c_323cf4ff a skos:Concept;
  skos:definition "Tragender Querbalken zur Aufnahme tragender Stichbalken. [Eißing et al. 2012]"@de,
    "Balken, der quer zum übrigen Gebälk verläuft und in zwei Balken eingezapft ist. Ein W. ist v. a. bei Deckenöffnungen (Treppenw.) und bei der Schornsteindurchführung (Kaminw.) notwendig. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd,
    :conceptScheme_167cb98f, :conceptScheme_19d56a39;
  skos:prefLabel "chevêtre"@fr, "trámová výměna"@cs, "trimmer beam"@en, "cavallo"@it,
    "brochal"@es, "Wechselbalken"@de;
  skos:altLabel "trimmed joist"@en, "linçoir"@fr, "trimmer"@en, "Wechsel"@de, "Schlüsselbalken"@de,
    "viga secundaria"@es;
  skos:broader :c_66433988;
  skos:related :c_6af98fb4;
  dct:created "2019-05-23T12:34:09.000"^^xsd:dateTime;
  dct:modified "2021-01-22T14:28:42.000"^^xsd:dateTime;
  :broaderByFunction :c_66433988 .

:c_6af98fb4 a skos:Concept;
  skos:definition "Ein mit einem Ende auf einem Decken- oder Wechselbalken und mit dem anderen Ende auf der Außenwand aufruhender Balken. [Koepf / Binding 2016]"@de,
    "Einseitig aufgelegter Balken, der an einem Ende mit einem Decken- oder Wechselbalken verbunden ist. [Eißing et al. 2012]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_1f14b4dd, :conceptScheme_167cb98f, :conceptScheme_19d56a39;
  skos:prefLabel "trimmed joist"@en, "blochet"@fr, "krátče (v krovu)"@cs, "trave zoppa"@it,
    "viga embrochalada"@es, "Stichbalken"@de;
  skos:altLabel "námětek"@cs, "solive boiteuse"@fr, "entrait retroussé"@fr, "half-beam"@en,
    "tail beam"@en, "madero cojo"@es, "zkrácený trám"@cs, "zkrácená stropnice"@cs;
  skos:broader :c_66433988;
  skos:narrower :c_bd91114d, :c_e1c4a8f7;
