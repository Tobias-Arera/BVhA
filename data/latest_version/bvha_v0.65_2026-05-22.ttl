:c_6e181ba5 a skos:Concept;
  skos:definition "Abgestufte Pyramide. S.n kommen in Ägypten, Mesopotamien (Zikkurat), Hinterindien (Prang) und bei den altamerikan. Kulturen vor. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "pyramide à gradins"@fr, "piramide a gradini"@it, "pirámide escalonada"@es,
    "Stufenpyramide"@de, "step pyramid"@en, "stupňovitá pyramida"@cs;
