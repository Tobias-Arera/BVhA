:c_b19e44dd a skos:Concept;
  skos:definition "Přečnívání, předsazení před stavební čáru 1. stavebního prvku, např. krakorce (konzola), římsy, arkýře nebo 2. hrázděného podlaží pro rozšíření obytného prostoru a/nebo ja­ko protiváha pro mezistropní zatížení. [Koch 2008]"@cs,
    "Das Vorspringen, »Vorkragen« aus der Bauflucht 1. eines Bauteils, z.B. Kragsteins (Konsole), Gesimses, Erkers; 2. eines Fachwerkgeschosses, um den Wohnraum zu erweitern oder/und als Gegengewicht (Konterlast) für Zwischendecken- Belastungen. [Koch 2009]"@de,
    "Überschuss, Vorkragung; auskragender Teil eines Gebäudes, bes. im ma. und frühneuzeitl. Fachwerkbau als vorkragende Stockwerke. Das Maß des Ü.s war durch Ortssatzungen festgelegt und wurde vom Rat kontrolliert. [Koepf / Binding 2016]"@de,
    "Auskragung, das Vorspringen eines Bauteils, z.B. eines Erkers, Balkons oder ganzen Stockwerks. Die A. kann mittels aus der Wand vorstehender Balkenköpfe (Fachwerkbau), Kragsteine, Konsolen oder abgetreppter Mauerschichten bewirkt werden. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9, :conceptScheme_1f14b4dd;
  skos:prefLabel "encorbellement"@fr, "jetty"@en, "Auskragung"@de, "vyložení"@cs;
  skos:altLabel "Überhang"@de, "ressaut"@fr, "saillie"@fr, "jettying"@en, "corbelling"@en,
    "Vorkragung"@de;
  skos:broader :c_24f6ab7f;
  skos:related :c_325fdd46;
  dct:created "2019-07-15T08:53:19.000"^^xsd:dateTime;
  dct:modified "2021-01-22T15:41:48.000"^^xsd:dateTime .

:c_9e004d89 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346;
  skos:prefLabel "eingezogen"@de, "outrepassé"@fr;
  skos:broader :c_12194ed3;
  dct:created "2019-02-18T22:27:51.000"^^xsd:dateTime;
  dct:modified "2020-08-05T14:39:50.000"^^xsd:dateTime .

:c_ebdd6e17 a skos:Concept;
  skos:definition "Gekuppelt, gekoppelt heißen gleichartige Bauteile, die durch ein gemeinsames Glied verbunden sind, z.B. 2 Säulen mit gemeinsamer Basis oder Deckplatte, Rundbogenfenster mit gemeinsamer Mittelsäule. [Koch 2009]"@de,
    "Gekuppelt, unmittelbar nebeneinanderliegende und einander betont zugeordnete Bauelemente (Säulen, Träger, Fenster, Portale oder dergl.). Um eine engere Verbindung herzustellen, wird beim g.en Fenster (Zwillingsfenster, Doppelarkade) oder Portal meist der verbindende Mittelpfosten leichter ausgebildet als die normale Gewänderahmung (Fensterformen, Drolerie, Kolonnade). [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_84fc24e6, :conceptScheme_8c0441f9;
  skos:prefLabel "gekuppelt"@de;
  skos:broader :c_12194ed3;
  skos:related :c_a9f18594, :c_55a8722a, :c_70570800;
  dct:created "2019-02-18T22:32:02.000"^^xsd:dateTime;
  dct:modified "2020-09-29T12:13:59.000"^^xsd:dateTime .

:c_a9f18594 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346;
  skos:prefLabel "gedoppelt"@de;
  skos:broader :c_12194ed3;
  skos:related :c_ebdd6e17, :c_817bb7df;
  dct:created "2019-02-18T22:32:12.000"^^xsd:dateTime;
  dct:modified "2019-02-18T22:33:01.000"^^xsd:dateTime .

:c_55a8722a a skos:Concept;
  skos:definition "Zwei Bogen, die sich entweder auf derselben Stütze oder in einem hängenden Bogenanfall begegnen. Meist liegt über ihnen ein Überfangbogen. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "arcs géminés"@fr, "twin arch"@en, "Zwillingsbogen"@de;
  skos:altLabel "geminated arches"@en, "coupled arches"@en, "gemelled arches"@en, "arcs jumelés"@fr,
    "gekuppelter Bogen"@de;
  skos:broader :c_0e469ac8;
  skos:related :c_ebdd6e17, :c_70570800;
  dct:created "2019-10-16T15:16:12.000"^^xsd:dateTime;
  dct:modified "2019-12-05T12:22:38.000"^^xsd:dateTime .

:c_70570800 a skos:Concept;
  skos:definition "Doppelarkade, Zwillingsarkade, zwei Arkaden, die durch einen sie gemeinsam überspannenden Blendbogen oder sichtbaren Entlastungsbogen zu einer Einheit zusammenfasst (gekuppelt) sind. [Koepf / Binding 2016]"@de,
    "Zwei miteinander verbundene Bogenstellungen, oft von einem Entlastungsbogen überwölbt. Zwillingsarkaden gliedern häufig Fensteröffnungen. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "twin arcade"@en, "arcades géminées"@fr, "Zwillingsarkade"@de;
  skos:altLabel "arcades jumelées"@fr, "arcade double"@fr, "double arcade"@en, "Doppelarkade"@de,
    "gekuppelte Arkade"@de;
  skos:broader :c_0e469ac8;
  skos:related :c_ebdd6e17, :c_55a8722a;
  dct:created "2019-10-22T10:46:07.000"^^xsd:dateTime;
  dct:modified "2020-09-01T11:08:50.000"^^xsd:dateTime .

