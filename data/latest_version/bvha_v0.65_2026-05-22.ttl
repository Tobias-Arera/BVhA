:c_895f38ab a skos:Concept;
  skos:definition "Rippenkuppel mit mehr oder wenig stark gebusten Kappen, die den Eindruck geblähter Segel vermitteln. Am Kuppelfuß befinden sich oft Lichtöffnungen, deren Begrenzung als Kappenstirn (f) bezeichnet wird. (Glossarium Artis)"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe;
  skos:prefLabel "coupole à cotes"@fr, "umbrella dome "@en, "Schirmkuppel"@de;
