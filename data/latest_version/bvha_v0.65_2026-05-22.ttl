  dct:modified "2021-01-22T16:20:24.000"^^xsd:dateTime;
  :broaderByShape :c_373d5928 .

:c_34d32ef3 a skos:Concept;
  skos:definition "Konsolbogen, Kragsturzbogen; Bogenform, bei der der mittlere Kreisbogen durch einen waagerechten Sturz ersetzt ist und die beiden seitl. auskragende Konsolsteine sind. [Koepf / Binding 2016]"@de,
    "Scheitrechter Bogen mit Stelzung über Kreissegmenten am Bogenanfang. Zu unterscheiden vom Bogensturz. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "plate-bande surhaussée"@fr, "sedlový oblouk"@cs, "shouldered arch"@en,
    "arco a spalla"@it, "arco sobre almohadillas"@es, "Schulterbogen"@de;
  skos:altLabel "plate-bande à sommiers arrondis"@fr, "konzolový oblouk"@cs, "Kragsturzbogen"@de,
    "Konsolbogen"@de;
  skos:broader :c_c55445fe, :c_2026364f;
  skos:related :c_6f7039e2, :c_1901ce9f;
  dct:created "2019-02-18T20:27:40.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:36:10.000"^^xsd:dateTime;
  :broaderByShape :c_c55445fe, :c_2026364f .

