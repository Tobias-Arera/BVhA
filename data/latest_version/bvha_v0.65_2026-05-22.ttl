:c_9ea8aa99 a skos:Concept;
  skos:definition "Ein Zwischenboden, der unterhalb der Deckenbalken angehängt wird und durch den in einem hohen Raum ein oberer niedrigerer Raum abgetrennt wird, als Schlafraum für Knechte oder als Ablage, bis ins 19. Jh. auch in Stadthäusern vorhanden. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Hängeboden"@de;
  skos:broader :c_2589c418;
  dct:created "2020-09-30T09:52:46.000"^^xsd:dateTime;
  dct:modified "2020-09-30T09:53:53.000"^^xsd:dateTime .

:c_bfacc506 a skos:Concept;
  skos:definition "Trám položený vodorovně na sloupech v antické architektuře a ve stavebních slozích z ní vycházejících. [Koch 2008]"@cs,
    "Architrav (griech. epistylion), der waagerecht auf den Säulen aufliegende Balken in der antiken Baukunst und in den von ihr abhängigen Baustilen. [Koch 2009]"@de,
    "Architrav (gr. archi-: Ober-, Haupt-, und lat. trabs: Balken), in der antiken Baukunst und den von ihr beeinflussten Baustilen der waagerechte, den Oberbau tragende Hauptbalken; da er beim gr. Tempel meist auf Säulen ruht, auch Epistyl (gr. auf den Säulen liegend) genannt (Säulenordnungen). Der steinerne A., von einer Säulenachse zur anderen in Blöcke unterteilt, ist in der Dorischen Ordnung glatt und hat oben eine Abschlussleiste (lat. taenie: Band), an der unterhalb kleine Leisten (regulae) mit >Tropfen< (guttae) angebracht sind. Im ion. und korinth. Stil ist der A. durch zwei oder drei übereinanderliegende, horizontale Streifen (jasciae) von gleicher oder verschiedender Breite gegliedert und mit einer mehrfach unterteilten Leistenbekrönung versehen - beides eine Erinnerung an die übereinanderliegenden Balken des Holzbaus (Gebälk). [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "Architrav"@de, "architráv"@cs;
  skos:altLabel "Epistyl"@de;
  skos:broader :c_d3971ceb;
  skos:narrower :c_858b126a, :c_a2ba5605;
  dct:created "2020-08-03T12:20:39.000"^^xsd:dateTime;
  dct:modified "2020-09-02T11:28:53.000"^^xsd:dateTime .

:c_dacae7cb a skos:Concept;
  skos:definition "Zahnschnitt am Gebälk des antiken Tempels. [Koch 2009]"@de, "Zubořez, zhlaví nosníku v antickém chrámu. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_37522b74,
