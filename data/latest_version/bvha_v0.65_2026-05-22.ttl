:c_b27698e1 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe;
  skos:prefLabel "joint de clé"@fr, "vrcholová spára (lomeného oblouku)"@cs, "central joint"@en,
    "fuga di chiave"@it, "junta en el vértice"@es, "Scheitelfuge"@de;
  skos:altLabel "Schlußfuge"@de, "crown joint"@en;
  skos:note "Fuge, die den Scheitel eines Bogens markiert, wenn kein Schlussstein vorhanden ist. Sie kann z. B. beim Spitzbogen entstehen.  (Glossarium Artis, Bd. 3, Bögen und Mauerwerk)"@de,
    "Fuge am höchsten Punkt eines Gewölbes oder Bogens, falls kein Schlussstein (Scheitelstein) vorhanden ist. [Koepf / Binding 2016]"@de;
  skos:broader :c_2f908d8a;
  dct:created "2019-05-07T16:09:24.000"^^xsd:dateTime;
  dct:modified "2020-11-27T08:18:43.000"^^xsd:dateTime .

:c_7e14535a a skos:Concept;
  skos:definition "Bruchfuge, 1. Fuge, die sich bei der lagerhaften Schichtung der Steine, d.h. ihrer natürl. Lagerung entsprechend, ergibt. 2. Fuge, die sich bei zu starker Belastung eines Bogens öffnet. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
