  dct:modified "2021-01-24T14:52:04.000"^^xsd:dateTime .

:c_9402111b a skos:Concept;
  skos:definition "Altarkerze f pl: eine Kerze, die bei der Messe und anderen liturgischen Handlungen auf oder nahe bei dem Altar brennen muss. Sie muss ganz oder mindestens zu 75 v. H. aus reinem Bienenwachs bestehen. Beim Pontifikalamt brennen 7, bei der Missa solemnis 6, bei der Missa cantata 4 und bei der Priestermesse 2 Kerzen. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd, :conceptScheme_b16d0aff;
  skos:prefLabel "cierge d\\'autel"@fr, "altar-candle"@en, "Altarkerze"@de;
  skos:broader :c_65b847bf;
  skos:related :c_9e30f557, :c_37fd5c3f;
  dct:created "2020-07-28T17:40:20.000"^^xsd:dateTime;
  dct:modified "2021-01-26T21:08:55.000"^^xsd:dateTime .

:c_2c773cae a skos:Concept;
  skos:definition "Aschenschale f: eine meist silberne Schale mit Deckel, in der die Asche der am Palmsonntag gesegneten und dann verbrannten Palmzweige aufbewahrt wird. Sie wird am Aschermittwoch geweiht und dient dazu, das Aschenkreuz auf die Stirn der Gläubigen zu zeichnen. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "vase à Cendres"@fr, "ash-bowl"@en, "Aschenschale"@de;
  skos:altLabel "ash-cup"@en;
  skos:broader :c_17d46f99;
  skos:related :c_e4d282b1, :c_58aa794b, :c_b33569c7;
  dct:created "2020-07-23T15:42:36.000"^^xsd:dateTime;
  dct:modified "2021-01-24T14:49:33.000"^^xsd:dateTime .

