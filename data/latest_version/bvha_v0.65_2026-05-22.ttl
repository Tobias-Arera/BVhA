:c_13425c9a a skos:Concept;
  skos:definition "Tholos (griech. Kuppeldach, Mz.: Tholoi), Rundbau mit Säulenkranz und Innenraum. [Koch 2009]"@de,
    "Rundtempel, dessen Cella von einem Säulenkranz umgeben war. [Koepf / Binding 2016]"@de,
    "Ein Tempel mit runder Cella und runder Säulenhalle  heißt Tholos (Tempelformen), ein R. ohne Cella Monopteros (meist in barocken Parkanlagen). [Koepf / Binding 2016]"@de,
    "Řec. kopulová střecha, mn.č. tholoi, kruhová stavba se sloupovým ochozem a vnitřním prostorem. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
