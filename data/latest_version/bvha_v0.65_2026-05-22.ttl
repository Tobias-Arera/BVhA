:c_ada9a902 a skos:Concept;
  skos:definition "Die kurze Weiterführung der Vertikalen zwischen Kämpferlinie und Bogen- oder Gewölbekrümmung. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe;
