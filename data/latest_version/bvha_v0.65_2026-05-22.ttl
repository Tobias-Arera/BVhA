:c_4ad18c80 a skos:Concept;
  skos:definition "Walmkehlriegel: Kehlriegel, der den Walmansatz bildet und auf dem die Walmrofen aufliegen.  (Eißing et al. 2012) "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_19d56a39;
