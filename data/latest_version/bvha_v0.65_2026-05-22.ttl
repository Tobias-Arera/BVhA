  skos:definition "Kelchreliquiar n; Reliquienkelch m: ein ehemals eucharistischer Kelch mit Deckel, dessen Kuppa eine Reliquie birgt. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
