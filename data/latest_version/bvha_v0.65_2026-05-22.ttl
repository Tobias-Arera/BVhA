  dct:modified "2020-08-28T14:31:16.000"^^xsd:dateTime .

:c_fe716b64 a skos:Concept;
  skos:definition "Vedlejší žebro (žebro 2. stupně) na žebrové klenbě. [Koch 2008]"@cs,
    "Tierceron (frz.), vom Kämpfer aufgehende Nebenrippe in spätgot. Fächer- oder Netzgewölben. [Koepf / Binding 2016]"@de,
    "Nebenrippe (Rippe 2. Grades) am Rippen-Gewölbe. [Koch 2009]"@de, "Vom Kämpfer aufgehende Nebenrippe in spätgot. Fächer- oder Netzgewölben. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "tierceron"@fr, "tierceron"@cs, "tierceron"@it, "tierceron"@en, "arco tercelete"@es,
    "Tierceron"@de;
  skos:broader :c_5a75b100;
  dct:created "2019-12-10T15:18:51.000"^^xsd:dateTime;
  dct:modified "2020-09-10T18:09:51.000"^^xsd:dateTime .

:c_914c7dbc a skos:Concept;
  skos:definition "Kreuzrippe, Diagonalrippe eines Kreuzrippengewölbes im Unterschied zu den Gurtrippen bzw. Gurtbogen. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "ogive"@fr, "cross rib"@en, "nervatura della crociera"@it, "Kreuzrippe"@de;
