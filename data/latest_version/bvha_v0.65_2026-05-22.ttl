:c_6a2aafbf a skos:Concept;
  skos:definition "(Triklinium), Grundrissform des barocken Schlossbaus mit einem Hauptgebäude (Corps de Logis) und zwei meist kürzeren Seitenflügeln, die einen offenen Hof (Ehrenhof, Cour d\\'honneur) U-förmig umfassen. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_50ec0c5e;
  skos:prefLabel "Dreiflügelanlage"@de, "trojkřídlá dispozice"@cs;
  skos:broader :c_4ba8c795;
  dct:created "2020-08-12T13:32:05.000"^^xsd:dateTime;
  dct:modified "2021-01-27T11:59:36.000"^^xsd:dateTime .

:c_0a9d5145 a skos:Concept;
  skos:definition "Ein Schlossbau, dessen vier Flügel sich regelmäßig um einen quadratischen oder rechteckigen Innenhof legen. Diese früheste Form des Schlosses greift auf den antiken Kastelltyp zurück. Bei den Schlössern der Renaissance sind die Kanten durch Ecktürme betont (Ancy-le Franc F, Aschaffenburg BY), während die Beispiele des 18. Jhs. differenzierter gestaltet sind und sich mehr zum Garten orientieren (Ludwigsburg BW). B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen] "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_50ec0c5e, :conceptScheme_1d7ba54b;
  skos:prefLabel "Vierflügelanlage"@de, "čtyřkřídlá dispozice"@cs;
  skos:broader :c_4ba8c795;
  dct:created "2020-08-12T13:32:21.000"^^xsd:dateTime;
  dct:modified "2021-01-27T11:59:59.000"^^xsd:dateTime .

