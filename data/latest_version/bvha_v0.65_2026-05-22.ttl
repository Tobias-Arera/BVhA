:c_a26e1c3f a skos:Concept;
  skos:definition "Brustkreuz (Pektorale, crux pectoralis, pectorale) ist ein als religiöser Schmuck oder aus sonstigen religiösen Beweggründen an einer Halskette oder Schnur über der Brust getragenes Kreuzchen. Es lassen sich zwei Klassen unterscheiden: 1. das nichtliturgische Brustkreuz, das als Ausdruck der privaten Verehrung und als religiöses Schutzmittel (phylacterium) im Alltagsleben von jedermann getragen werden kann; 2. das einen Bestandteil der Pontifikalkleidung bildende, bei feierlichen Pontifikalhandlungen über der Albe angelegte liturgische Brustkreuz, das von Rechts wegen nur den Kardinälen, Bischöfen und Äbten, anderen nur auf Grund einer besonderen Ermächtigung zusteht, von den ersteren aber als Abzeichen ihrer Würde auch über der Alltagskleidung getragen werden darf. [RDK Labor]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_cf792a3c;
  skos:prefLabel "pectorale "@la, "croix pectorale"@fr, "pektorál"@cs, "pectoral cross"@en,
    "pettorale"@it, "Brustkreuz"@de;
  skos:altLabel "cruce pettorale"@it, "Pektorale"@de, "crux pectoralis"@la;
  skos:broader :c_c10d78d5, :c_cb3125a1, :c_64dd3656, :c_d8d9a3e1;
  dct:created "2020-02-05T18:58:12.000"^^xsd:dateTime;
  dct:modified "2021-01-23T13:44:30.000"^^xsd:dateTime;
  :broaderByFunction :c_c10d78d5 .

:c_64dd3656 a skos:Concept;
  skos:definition "Pontifikalinsignien n pi; Iat. pontificalia: dem Bischof und der höheren Geistlichkeit zustehende Rangabzeichen. Außer den Pontifikalgewändern sind dies der Bischofsring, der Bischofsstab bzw. die päpstliche Ferula, das Brustkreuz, die Kathedra (Bischofsthron) mit Baldachin sowie das Faldistorium (Faltstuhl). [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "insignes pontificaux"@fr, "pontificals"@en, "Pontifikalinsignie"@de,
    "pontificalia"@la;
  skos:altLabel "pontificalia"@fr, "pontifical insignia"@en, "Pontifikalie"@de;
  skos:broader :c_86c8b719;
  skos:narrower :c_838af7d3, :c_d0c849fe, :c_cd3a4921, :c_a26e1c3f, :c_c529c13a, :c_73a34358,
