:c_0eb97979 a skos:Concept;
  skos:definition "Fracturation en un ou plusieursfragments de forme allongée aux arêtes vives. [ICOMOS-ISCS]"@fr,
    "Detachment of sharp, slender pieces of stone,split or broken off from the main body. [ICSOMOS-ISCS]"@en,
    "Abtrennung von scharfen, schlanken Gestein - stücken, abgespalten oder abgebrochen vom Hauptbestandteil des Hauptgesteinskörpers. [ICOMOS-ISCS] "@de,
    "Oddělení ostrých, štíhlých kousků kamene odštípnutím nebo odlomením od hlavního kusu kamene. [ICOMOS-ISCS] "@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_315cf028,
    :conceptScheme_ef0a8695, :conceptScheme_34ca6582;
  skos:prefLabel "fragmentation en esquilles"@fr, "splintering"@en, "Abscherben"@de,
    "tříštění"@cs;
  skos:broader :c_b1b305ee;
  dct:created "2019-05-13T13:55:35.000"^^xsd:dateTime;
  dct:modified "2021-01-30T16:27:38.000"^^xsd:dateTime .

:c_488a94dc a skos:Concept;
  skos:definition "Détachement d’un éclat sur une arête. Le fragmentformé (chip en anglais) a une taille variable et une formeirrégulière. [ICOMOS-ISCS]"@fr,
    "Breaking off of pieces, called chips, from theedges of a block. [ICOMOS-ISCS]"@en,
    "Ausbrechen von Stücken (Chips, Splitter) von den Ecken eines Gesteinsblocks. [ICOMOS-ISCS] "@de,
    "Odlamování kousků, zvaných odštěpky, z okrajů bloků kamene. [ICOMOS-ISCS] "@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_315cf028,
    :conceptScheme_ef0a8695, :conceptScheme_34ca6582;
  skos:prefLabel "epaufrure"@fr, "chipping"@en, "Absplittern"@de, "odlomení hrany"@cs;
  skos:broader :c_b1b305ee;
  dct:created "2019-05-13T14:26:41.000"^^xsd:dateTime;
  dct:modified "2021-01-30T16:28:25.000"^^xsd:dateTime .

