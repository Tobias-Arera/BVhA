:c_adecb586 a skos:Concept;
  skos:definition "Flamboyant (frz. flammend, geflammt), Maßwerk der spätgot. Baukunst in Frankreich und England, Flowing tracery, das von der dort als Flamme gedeuteten Fischblase bes. starken Gebrauch macht. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_84fc24e6;
