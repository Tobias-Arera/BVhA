  skos:prefLabel "Präventive Konservierung"@de, "preventive conservation"@en;
  skos:broader :c_zynvte6n;
  skos:narrower :c_d784f43e, :c_ebbe9248, :c_b34d6a1e, :c_be068deb, :c_ac705510, :c_e36b7fdb;
