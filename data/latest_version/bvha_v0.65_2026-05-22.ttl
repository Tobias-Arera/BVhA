:c_db838684 a skos:Concept;
  skos:definition "Eine dem Kleeblattbogen ähnelnde Bogenform mit mehreren, symmetrisch angesetzten, konvexen Kreisbogen, die auch unterschiedlich dimensioniert sein können. Manchmal wird diese Form auch nach den kleinen Vorsprüngen zwischen den Pässen Nasenbogen oder vielnasiger Kleeblattbogen genannt. [Glossarium Artis]"@de,
    "Vielpass-, Fächerbogen; Bogen mit zahlr. rahmenden Pässen an der Laibung (Bogenformen). [Koepf / Binding 2016]"@de,
    "Zacken- oder Fächerbogen, eine Bogenform mit zahlr. rahmenden Pässen an der Laibung. [Koepf / Binding 2016]"@de,
    "Fächerbogen, Vielpass- oder Zackenbogen, aus mehreren, fächerförmig angeordneten Kreisbogen bestehender Bogen, bes. in der islam. und spätroman. Baukunst. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_84fc24e6,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "arc polylobé"@fr, "vícelaločný oblouk"@cs, "multifoil arch"@en, "arco polilobato"@it,
    "arco polilobulado"@es, "Vielpassbogen"@de;
  skos:altLabel "Zackenbogen"@de, "Fächerbogen"@de, "arco encabriado"@es, "laločnatý oblouk"@cs,
    "arc chevronné"@fr, "arc (à réseau d\\'intrados) polylobé"@fr, "multifoiled arch"@en,
    "chevron arch"@en, "quatrefoil arch"@en;
  skos:broader :c_7884b506;
  dct:created "2019-02-18T22:46:28.000"^^xsd:dateTime;
  dct:modified "2021-01-15T17:39:11.000"^^xsd:dateTime .

:c_58ab3e31 a skos:Concept;
  skos:definition "Bogen mit einer aus mehreren kleineren konkaven Kreissegmenten zusammengesetzten Bogenlinie, gewissermaßen ein umgekehrter Kleeblattbogen, gelegentlich mit Lambrequins und anderen dekorativen Formen. Besonders in der spätgotischen Profanarchitektur eine beliebte Ausbildung des Fenstersturzes. [Glossarium Artis]"@de,
    "Sternbogen, ein Bogen, der von konvexen Bogenlinien begrenzt wird. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "arc à inflexions multiples"@fr, "draperiový oblouk"@cs, "inflected arch"@en,
    "arco a tenda"@it, "arco torcido"@es, "Vorhangbogen"@de;
  skos:altLabel "arc infléchi"@fr, "Sternbogen"@de, "arco en contracurva"@es, "závěsový oblouk"@cs,
    "arco a controcurve"@it, "arc en contrecourbe"@fr;
  skos:broader :c_1cf0c7ce;
  skos:narrower :c_b66f7923;
  skos:related :c_256814ae;
  dct:created "2019-02-18T20:15:44.000"^^xsd:dateTime;
