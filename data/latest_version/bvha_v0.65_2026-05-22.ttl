  dct:modified "2021-01-23T16:37:49.000"^^xsd:dateTime .

:c_412735f3 a skos:Concept;
  skos:definition "Im liturgischen Sprachgebrauch bezeichnet Rubrik ein von der kirchlichen Autorität vorgeschriebenes Gesetz, welches den Vollzug einer liturgischen Handlung regelt; die Rubrik ist weiterhin meist rot geschrieben und entweder in den Text der Gebete eingeschoben (rubrica specialis, rubrica propria, rubrica particularis) oder zu Anfang des Textes niedergelegt (rubrica generalis). [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "rubrique (loi)"@fr, "Rubrik (Gesetz)"@de, "rubrica specialis"@la,
    "rubriky"@cs;
  skos:altLabel "rubrica propia"@la, "rubrica particularis"@la, "rubrica generalis"@la;
  skos:broader :c_6ca61a95, :c_76131543;
  dct:created "2020-05-22T17:39:10.000"^^xsd:dateTime;
  dct:modified "2021-01-22T10:20:46.000"^^xsd:dateTime .

