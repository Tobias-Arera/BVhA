  dct:modified "2021-01-26T22:43:16.000"^^xsd:dateTime .

:c_23aecf88 a skos:Concept;
  skos:definition "Voda z gotické sloupové kašny tekla z boku bohatě zdobeného, často figurami a nástavci zdobeného sloupu studny do kruhové nebo hranaté nádrže. Jako „krásná kašna\" stála na náměstích středověkých měst. Renesance v Německu zachovala sloupovou kašnu, ovšem bez nástavce, v románských zemích dávala však přednost klasickým mísovým kašnám. Barokní kašny bývaly často vyzdobeny postavami z antické mytologie: Poseidon, Tritoni, mořští koníci. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_c8a571d9, :conceptScheme_37522b74;
  skos:prefLabel "Stockbrunnen"@de, "sloupová kašna"@cs;
  skos:broader :c_097639c0;
  dct:created "2020-08-03T16:18:49.000"^^xsd:dateTime;
  dct:modified "2021-01-26T22:44:38.000"^^xsd:dateTime .

:c_e2a93db8 a skos:Concept;
