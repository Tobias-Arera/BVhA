:c_c50071e4 a skos:Concept;
  skos:definition "Exsultetrolle f, auch Exsultetrotel m, rotulus: mit Miniaturen reich verzierte Pergamentrolle mit dem Text des Exsultet (Lobpreis auf Ostern); die Illustrationen standen für den lesenden Geistlichen verkehrt herum, konnten aber von den Gläubigen richtig betrachtet werden, wenn die Rolle über den Ambo herabhing. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "rouleau d\\'exsultet"@fr, "Exultetrolle"@de, "rotolus"@la, "rotulus"@cs;
  skos:altLabel "Exultetrotel"@de;
  skos:broader :c_6ca61a95;
  skos:related :c_5a5eba69, :c_9359d9e7, :c_iyznvop1;
  dct:created "2020-05-22T12:08:46.000"^^xsd:dateTime;
  dct:modified "2021-01-23T16:33:12.000"^^xsd:dateTime .

