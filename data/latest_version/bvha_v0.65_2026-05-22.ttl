  skos:definition "Walmbundsparren: mittlerer Sparren eines Walms, der Teil des Firstlängsbundes ist.  (Eißing et al. 2012) "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_19d56a39;
