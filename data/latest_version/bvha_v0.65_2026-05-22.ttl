    "stavba hvězdicovitého půdorysu"@cs;
  skos:altLabel "edificio stellare"@it;
  skos:broader :c_59bd3f09;
  dct:created "2020-08-12T09:16:45.000"^^xsd:dateTime;
  dct:modified "2021-01-26T23:15:25.000"^^xsd:dateTime .

:c_c46dbfb4 a skos:Concept;
  skos:definition "Kreis- oder ellipsenförmiges Fenster, besonders des Barock. [Koch 2009]"@de,
    "Ochsenauge, kleines, ovales Fenster, das in einer Wand (über Türen häufig), in Kuppeln (bes. im Tambour) und auch als Dachgaube Verwendung findet, bes. in der Architektur des 17./18. Jhs. [Koepf / Binding 2016]"@de,
