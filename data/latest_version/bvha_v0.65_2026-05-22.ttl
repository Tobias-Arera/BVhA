    "Stilisieren"@de;
  skos:altLabel "conventionalize"@en;
  skos:broader :c_25d5f91f;
  dct:created "2020-08-12T08:25:04.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:05:17.000"^^xsd:dateTime .

:c_3f1605e1 a skos:Concept;
  skos:definition "Abtreppung, treppen- bzw. stufenförmige Ausbildung eines Bauteils, z.B. Treppengiebel, Stufenportal. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_84fc24e6;
