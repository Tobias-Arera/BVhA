:c_4fe9f074 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_ec8c77bf;
  skos:prefLabel "lösliche Salze"@de, "soluble salts"@en;
  skos:altLabel "bauschädliche Salze"@de, "leichtlösliche Salze"@de;
  skos:note "Minerals which readily undergo crystallisation cycles at ambient temperatures and varying humidities. [EwaGlos]"@en,
    "Mineralien, die bei Raumtemperatur und variierender Feuchtigkeit Kristallisationszyklen leicht durchlaufen. [EwaGlos]"@de;
  skos:broader :c_a2e37af3, :c_25b71ee6;
  dct:created "2019-07-05T22:28:12.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:02:34.000"^^xsd:dateTime .

:c_b38b1438 a skos:Concept;
  skos:definition "Feuchte ist die Menge an Flüssigkeit, die in der Luft (Luftfeuchte) oder in porösem Material enthalten ist. [EwaGlos]"@de,
    "The amount of moisture present in the air or in a porous material (here referred to as moisture). [EwaGlos]"@en;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_ec8c77bf;
  skos:prefLabel "Feuchte"@de, "humidity"@en;
  skos:altLabel "Feuchtigkeit"@de;
  skos:broader :c_a2e37af3;
  dct:created "2019-07-05T21:59:09.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:08:20.000"^^xsd:dateTime .

:c_67f00cd6 a skos:Concept;
  skos:definition "Abscheiden einer Flüssigkeit (oder eines Feststoffes) aus seinem Dampf, in der Regel auf einer Oberfläche, die kälter ist als das angrenzende Gas. [EwaGlos]"@de,
    "Deposition of a liquid (or a solid) from its vapour, generally upon a surface that is cooler than the adjacent gas. [EwaGlos]"@en;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_ec8c77bf;
  skos:prefLabel "Kondensation"@de, "condensation"@en;
  skos:broader :c_a2e37af3;
  dct:created "2019-07-05T22:01:39.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:04:31.000"^^xsd:dateTime .

:c_1a82513a a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_ec8c77bf;
  skos:prefLabel "Hygroskopizität"@de, "hygroscopicity"@en;
  skos:altLabel "Neigung zur Wasseraufnahme"@de, "Wasseraufnahmefähigkeit"@de, "deliquescence"@en;
  skos:note "Hygroscopicity is the ability of a salt or other materials to absorb moisture from the air; when the moisture is sufficient to allow dissolution of the salt, this is defined as deliquescence. [EwaGlos]"@en,
    "Die Fähigkeit eines Salzes oder anderen Materials, Feuchte aus der Luft zu absorbieren. Sobald die Feuchte ausreicht, um Salze in Lösung zu bringen, wird dies als Deliqueszenzfeuchte definiert. [EwaGlos]"@de;
  skos:broader :c_a2e37af3;
  dct:created "2019-07-05T22:04:53.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:08:01.000"^^xsd:dateTime .

:c_7141e85e a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_ec8c77bf;
  skos:prefLabel "Infiltration"@de, "infiltration"@en;
  skos:altLabel "eindringendes Wasser"@de, "Wassereintritt"@de;
  skos:note "The ingress of water through defects in a building. [EwaGlos]"@en, "Der Eintritt von Wasser in Folge von Schäden an einem Gebäude. [EwaGlos]"@de;
  skos:broader :c_a2e37af3, :c_a37cbf12;
  dct:created "2019-07-05T22:08:59.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:03:53.000"^^xsd:dateTime .

:c_1c0e7df8 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_ec8c77bf;
  skos:prefLabel "aufsteigende Feuchte"@de, "rising damp"@en;
  skos:altLabel "aufsteigende Grundfeuchte"@de, "aufsteigende Mauerfeuchte"@de, "aufsteigende Bodenfeuchtigkeit"@de;
  skos:note "Dampness in the lower part of buildings resulting from capillary rise of ground water. [EwaGlos]"@en,
    "Feuchtigkeit im unteren Teil eines Gebäudes als Ergebnis kapillar aufsteigenden Grundwassers. [EwaGlos]"@de;
  skos:broader :c_a2e37af3;
  dct:created "2019-07-05T22:11:45.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:08:32.000"^^xsd:dateTime .

:c_75f819d3 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_ec8c77bf;
  skos:prefLabel "Frost-Tau-Wechsel"@de, "freeze–thaw cycles"@en;
  skos:note "The cyclical formation of ice crystals when temperature fluctuates above and below 0 °C, the freezing point of water. [EwaGlos]"@en,
    "Die zyklische Ausbildung von Eiskristallen bei Temperaturschwankungen von über und unter 0 °C, dem Gefrierpunkt von Wasser. [EwaGlos]"@de;
  skos:broader :c_a2e37af3;
  dct:created "2019-07-05T22:14:48.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:08:08.000"^^xsd:dateTime .

:c_b08496e6 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_ec8c77bf;
  skos:prefLabel "Nass-Trocken-Wechsel"@de, "wet-dry cycles"@en;
  skos:note "The cyclical absorption and desorption of moisture in a building material, which can provoke damage in salt-infested porous materials. [EwaGlos]"@en,
    "Die zyklische Aufnahme und Abgabe von Feuchte in einem Baumaterial, die an salzbelasteten, porösen Materialien Schäden hervorrufen kann. [EwaGlos]"@de;
  skos:broader :c_a2e37af3;
  dct:created "2019-07-05T22:17:41.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:04:14.000"^^xsd:dateTime .

:c_edc95f19 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_ec8c77bf;
  skos:prefLabel "Luftverschmutzung"@de, "air pollution"@en;
  skos:note "The burning of materials (e.g. fossil fuels, wood, plastics) which releases gases and particulate matter, including aerosols. [EwaGlos]"@en,
    "Das Verbrennen von Materialien (z.B. Erdöl, Holz, Plastik) setzt Gase und Partikel, einschließlich Aerosole, frei. [EwaGlos]"@de;
  skos:broader :c_63d87b7c;
  dct:created "2019-07-05T22:22:06.000"^^xsd:dateTime;
  dct:modified "2021-01-15T17:59:31.000"^^xsd:dateTime .

:c_798f7d32 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_ec8c77bf;
  skos:prefLabel "Aerosole"@de, "aerosols"@en;
  skos:note "A colloidal system formed of tiny liquid or solid particles distributed uniformly through a gas, usually air. [EwaGlos]"@en,
    "Ein kolloidales System, das durch sehr kleine, flüssige oder feste Partikel gebildet wird, die gleichmäßig in Gas, üblicherweise Luft, verteilt sind. [EwaGlos]"@de;
  skos:broader :c_a2e37af3;
  dct:created "2019-07-06T18:48:36.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:08:41.000"^^xsd:dateTime .

:c_6a5ef5a6 a skos:Concept;
  skos:definition "L’expression colonisation biologique s’applique surtout aux plantes et aux microorganismes tels que bactéries, cyanobactéries, algues, moisissures et lichens (symbioses des trois derniers). Il s’applique aussi aux structures fabriquées par des animaux, tels que des nids. [ICOMOS-ISCS]"@fr,
    "Colonization of the stone by plants and micro-organisms such as bacteria, cyanobacteria, algae, fungi and lichen (symbioses of the latter three). Biological colonization also includes influences by other organisms such as animals nesting on and in stone. [ICOMOS-ISCS]"@en,
    "Die Besiedlung von Gesteinen durch höhere Pflanzen und Mikroorganismen wie Bakterien, Cyanobakterien, Algen, Pilze und Flechten (Symbiosen zwischen den drei Letztgenannten). Biologische Besiedlung umfasst auch Einflüsse durch andere Organismen wie den Nestbau von Tieren auf und im Stein. [ICOMOS-ISCS]"@de,
    "Kolonizace kamenů rostlinami a mikroorganismy jako jsou bakterie, cyanobakterie, řasy, houby a lišejníky (i symbiozou tří posledně zmíněných). biologická kolonizace také zahrnuje vlivy ostatních organismů, jako jsou živočichové, hnízdící na kamenech a uvnitř kamenů. [ICOMOS-ISCS]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_ec8c77bf,
    :conceptScheme_34ca6582;
  skos:prefLabel "colonisation biologique"@fr, "biological growth"@en, "Biologische Kolonisation"@de,
    "biologická kolonizace"@cs;
  skos:altLabel "croissance biologique"@fr, "prolifération végétale"@fr, "biological colonization"@en,
    "biological overgrowth"@en, "living exogenous material."@en, "biologischer Bewuchs"@de,
    "biologische Besiedelung"@de, "biologischer Befall"@de, "biologische Verwitterung"@de,
    "biologische Korrosion"@de, "mikrobiologischer Zerfall"@de, "biologický růst"@cs,
    "nadměrný biologický růst"@cs, "živý exogenní materiál"@cs;
  skos:note "Colonisation by living organisms on an object or other work of art which can lead to damage and/or deterioration. [EwaGlos]"@en,
    "Besiedelung eines Objekts oder anderen Kunstwerks mit lebenden Organismen, die zu Schäden oder Zerfall führen kann. [EwaGlos]"@de;
  skos:broader :c_9383da1e;
  skos:narrower :c_7219f1c5, :c_af18a646, :c_f4a965dd, :c_7ae0a270, :c_e1d2abad, :c_7b5c999a;
  dct:created "2019-07-06T18:58:16.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:11:38.000"^^xsd:dateTime .

:c_7219f1c5 a skos:Concept;
  skos:definition "Mono- to multilayered microbial colony attached to surfaces with varying thickness of up to 2mm. Often a biofilm consists of very few cells of different microorganisms embedded in large amounts of extracellular slime. These cohesive often sticky layers may shrink and expand according to the supply of water. Biofilms often create multicoloured biopatina by production of colouring agents [ICOMOS-ISCS]"@en,
    "communauté microbienne superficielle, mono- à multi-couches (épaisseur pouvant atteindre 2 mm). Un biofilm consiste souvent en une grande quantité de matière extracellulaire (par exemple polysaccharides produits par certaines algues) associée à très peu de cellules. Le biofilm, souvent visqueux, peut rétrécir ou gonfler au gré des apports en eau. Il forme souvent des patines (biopatines), du fait d’une production de colorants. [ICOMOS-ISCS]"@fr;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_34ca6582;
  skos:prefLabel "biofilm"@en, "biofilm"@fr, "Biofilm"@de;
  skos:broader :c_6a5ef5a6;
  dct:created "2019-11-13T11:05:38.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:11:24.000"^^xsd:dateTime .

:c_af18a646 a skos:Concept;
  skos:definition "Les algues sont des organismes végétaux microscopiques sans tige ni feuille formant à l’intérieur comme à l’extérieur des édifices des voiles verts, noirs ou rouges ou bruns (épaisseur quelques dixièmes de mm à plusieurs mm). Selon les conditions environnementales et le substrat les algues peuvent former des films pulvérulents ou visqueux. Les algues se développent principalement dans les situations où la surface du substrat reste humide pendant de longues périodes. Sur les monuments, les algues sont constituées de rassemblements uniou multicellulaires, elles ne forment jamais de macro-organismes. [ICOMOS-ISCS]"@fr,
    "Algae are microscopic vegetal organisms without stem nor leaves which can be seen outdoors and indoors, as powdery or viscous deposits (thickness : tenth of mm to several mm). Algae form green, red, brown, or black veil like zones and can be found mainly in situations where the substrate remains moistened for long periods of time. Depending on the environmental conditions and substrate type, algae may form solid layers or smooth films. On monuments, algae are constituted of unicellular to pluricellular clusters, and they never form macroorganisms. [ICOMOS-ISCS]"@en,
    "řasy jsou mikroskopické vegetativní organismy bez stonků a listů, které se mohou nacházet v přírodě i v interiérech jako sypké nebo vazké usazeniny (tloušťky desetiny mm až několik mm). řasy tvoří zelené, červené, hnědé nebo černé závojovité zóny a nalézají se většinou v místech, kde podklad zůstává vlhký po dlouhou dobu. V závislosti na podmínkách prostředí a typu podkladu mohou řasy tvořit pevné vrstvy nebo hladké povlaky. na památkách jsou řasy tvořeny jednobuněčnými až vícebuněčnými shluky a nikdy netvoří makroorganismus. [ICOMOS-ISCS]"@cs,
    "Pflanzlicher Mikroorganismus ohne Stengel und Blätter, der sowohl im Freien als auch in Innenräumen in Gestalt von pulvrigen bis viskosen Ablagerungen von einem Zehntel bis einige Millimeter Dicke gefunden wird. Algen bilden grüne, rote, braune oder schwarze, schleierartige Überzüge und kommen hauptsächlich dort vor, wo das Substrat längere Zeit feucht bleibt. Abhängig von den Umgebungsbedingungen und vom Substrat bilden Algen kompakte oder feine, filmartige Überzüge. Die an Denkmälern auftretenden Algen bestehen aus einzelligen bis vielzelligen Clustern; sie bilden keine Makroorganismen aus. [ICOMOS-ISCS]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_34ca6582;
  skos:prefLabel "algue"@fr, "alga"@en, "Alge"@de, "řasy"@cs;
  skos:broader :c_6a5ef5a6;
  dct:created "2019-11-13T11:25:36.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:11:32.000"^^xsd:dateTime .

:c_f4a965dd a skos:Concept;
  skos:definition "Structure végétale millimétrique à centimétrique, généralement arrondie, ayant un aspect encroûtant ou buissonnant, et l’aspect du cuir. De couleur variée (orange, vert, gris, brun ou noir), ils ne montrent pas de différenciation en feuilles, tige et racine. Les lichens se développent généralement sur les surfaces externes de monuments. [ICOMOS-ISCS]"@fr,
    "Vegetal organism forming rounded millimetric to centimetric crusty or bushy patches, often having a leathery appearence, growing generally on outside parts of a building. Lichen are most commonly grey, yellow, orange, green or black and show no differentiation into stem, root and leaf. [ICOMOS-ISCS]"@en,
    "Pflanzlicher Organismus, der Millimeter bis Zentimeter große krustenartige oder buschige Flecken bildet. Die Flecken besitzen oft ein lederartiges Aussehen. Flechten wachsen generell an der Außenseite von Gebäuden. Sie sind gewöhnlich grau, gelb, orange, grün oder schwarz und zeigen keine Differenzierung in Stamm, Wurzel und Blatt. [ICOMOS-ISCS]"@de,
    "rostlina vytvářející zaoblené milimetrové až centimetrové krusty nebo hustě zarostlé plošky, často kožovitého vzhledu, rostoucí obvykle na venkovních částech budov. lišejníky jsou nejčastěji šedé, žluté, oranžové, zelené nebo černé. stonek, kořen a list nejsou rozlišeny. [ICOMOS-ISCS]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_34ca6582;
  skos:prefLabel "lichen"@fr, "lichen"@en, "Flechte"@de, "Lišejníky"@cs;
  skos:broader :c_6a5ef5a6;
  dct:created "2019-11-13T11:32:38.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:11:15.000"^^xsd:dateTime .

:c_7ae0a270 a skos:Concept;
  skos:definition "Organisme végétal en forme de coussinets verts souples au toucher, de taille centimétrique. Les mousses ont l’apparence de petites feuilles (taille submillimétrique à millimétrique) assemblées en bouquets serrés. Les mousses se développent dans des cavités ouvertes, des fissures, des joints, toutes zones constamment ou souvent humides et/ou ombragées. [ICOMOS-ISCS]"@fr,
    "Vegetal organism forming small, soft and green cushions of centimetric size. Mosses look generally like dense micro-leaves (sub- to millimetric size) tightly packed together. Mosses often grow on stone surface open cavities, cracks, and in any place permanently or frequently wet (masonry joints), and usually shady. [ICOMOS-ISCS]"@en,
    "Pflanzlicher Organismus, der kleine, weiche grüne Kissen von Zentimetergröße bildet. Moose sehen allgemein wie dichte Mikroblätter (Sub - bis Millimetergröße) aus, die dicht zusammen gepackt sind. Moose wachsen oft auf der Steinoberfläche in offenen Aushöhlungen, Rissen oder an anderen Stellen, die andauernd oder häufig feucht (Mauerwerksfugen) und gewöhnlich schattig sind. [ICOMOS-ISCS]"@de,
    "en rostlina tvořící malé měkké zelené polštářky centimetrových rozměrů. Mechy vypadají zpravidla jako husté, pevně sbalené mikrolístečky (sub až milimetrových velikostí). Mechy často rostou na kamenech s otevřenými povrchovými dutinami, puklinami a v jakýchkoliv místech trvale nebo často vlhkých (spáry zdiva) a obvykle zastíněných. [ICOMOS-ISCS]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_34ca6582;
  skos:prefLabel "mousse"@fr, "moss"@en, "Moos"@de, "mechy"@cs;
  skos:broader :c_6a5ef5a6;
  dct:created "2019-11-13T11:37:41.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:11:08.000"^^xsd:dateTime .

:c_e1d2abad a skos:Concept;
  skos:definition "Une moisissure est un champignon microscopique. La croissance d’une moisissure peut atteindre des dimensions visibles à l’oeil nu sous la forme d’une pellicule duveteuse de diverses couleurs (blanc, gris, noir surtout) ou de filaments croissant depuis un centre (de façon centripète) et formant ainsi un réseau de structures en étoiles, ayant un diamètre de 2 à 10 mm. [ICOMOS-ISCS]"@fr,
    "Microscopic fungus which colonies, to the naked eye, look like a downy film or a network or star-like millimetric patches of filaments of diverse colours (white, grey, black). [ICOMOS-ISCS]"@en,
    "Mikroskopische, Kolonien bildende Pilze, die bei bloßem Auge wie ein flaumiger Film oder wie ein Netzwerk, oder wie sternenförmige, Millimeter große Flecken, bestehend aus Fäden verschiedener Farbe (weiß, grau, schwarz), aussehen. [ICOMOS-ISCS]"@de,
    "Mikroskopické houby, jejichž kolonie prostým okem vypadají jako chmýřím porostlý povlak, nebo jako síť či hvězdicovitý milimetrový chomáč vláken různých barev (bílá, šedá, černá). [ICOMOS-ISCS]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_34ca6582;
  skos:prefLabel "moisissure"@fr, "mould (fungus)"@en, "Schimmel"@de, "plísně"@cs;
  skos:altLabel "fungi"@en, "fungi"@cs, "Schimmelpilz"@de, "Pilz"@de;
  skos:broader :c_6a5ef5a6;
  dct:created "2019-11-13T11:44:44.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:10:53.000"^^xsd:dateTime .

:c_7b5c999a a skos:Concept;
  skos:definition "Etre vivant végétal organisé différencié en racine(s), tige(s) et feuilles. Parfois cependant, la plante peut ne se résumer qu’à une simple expansion foliaire (ex : Fougère, arbre, arbuste, herbe). [ICOMOS-ISCS]"@fr,
    "Vegetal living being, having, when complete, root, stem, and leaves, though consisting sometimes only of a single leafy expansion (e.g. Tree, fern, herb). [ICOMOS-ISCS]"@en,
    "Pflanzliches Lebewesen, welches voll ausgebildete Wurzel, Stamm und Blätter besitzt, obwohl es manchmal nur aus einem einzigen begrünten Austrieb besteht (z. B. Baum, Farn, Kraut). [ICOMOS-ISCS]"@de,
    "Živý organismus, mající v úplnosti kořenový systém, stonek nebo kmen a listy, ačkoliv někdy může být tvořen jenom listovou strukturou, (např. strom, kapradina, bylina). [ICOMOS-ISCS]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_34ca6582;
  skos:prefLabel "plante"@fr, "plant"@en, "Pflanze"@de, "rostliny"@cs;
  skos:altLabel "végétation"@fr, "vegetation"@en, "higher plant"@en, "höhere Pflanze"@de,
    "Vegetation"@de, "vyšší rostliny"@cs, "rostlinstvo"@cs;
  skos:broader :c_6a5ef5a6;
  dct:created "2019-11-13T11:49:16.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:11:00.000"^^xsd:dateTime .

:c_34310334 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_ec8c77bf;
  skos:prefLabel "unsachgemäße historische Intervention"@de, "inappropriate historic intervention"@en;
  skos:altLabel "frühere falsche Behandlung"@de, "frühere unsachgemäße Erhaltungsmaßnahmen"@de;
  skos:note "Techniques or materials applied in the past which can lead to additional or accelerated deterioration of original materials. [EwaGlos]"@en,
    "In der Vergangenheit angewendete Techniken oder Materialien, die zu neuer oder beschleunigter Schädigung der originalen Materialien führen können. [EwaGlos]"@de;
  skos:broader :c_63d87b7c;
  dct:created "2019-07-06T19:05:05.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:00:23.000"^^xsd:dateTime .

:c_74de7a96 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_ec8c77bf;
  skos:prefLabel "Übermalung"@de, "overpaint"@en;
  skos:note "A painting layer which partially or completely covers the original painting layer of an art work. [EwaGlos]"@en,
    "Eine Farbschicht, die teilweise oder gänzlich die originale Malschicht eines Kunstwerks überdeckt. [EwaGlos]"@de;
  skos:broader :c_63d87b7c;
  dct:created "2019-07-06T19:23:18.000"^^xsd:dateTime;
  dct:modified "2021-01-15T17:59:24.000"^^xsd:dateTime .

:c_bbae6a9b a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_ec8c77bf;
  skos:prefLabel "bauliche Intervention"@de, "structural intervention"@en;
  skos:altLabel "strukturelle Eingriffe"@de, "konstruktive Eingriffe"@de;
  skos:note "Interventions to a built fabric with the goal of restoring its structural stability or integrity. [EwaGlos]"@en,
    "Eingriffe in die Bausubstanz mit dem Ziel, ihre strukturelle Stabilität oder Einheit wiederherzustellen. [EwaGlos]"@de;
  skos:broader :c_63d87b7c;
  dct:created "2019-07-06T19:25:32.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:00:34.000"^^xsd:dateTime .

:c_5bb9a236 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ef0a8695,
    :conceptScheme_ec8c77bf;
  skos:prefLabel "pulvérulence"@fr, "chalking"@en, "Abmehlen"@de, "zpráškovatění a zkřídovatění"@cs;
  skos:altLabel "Pulverisierung"@de, "loss of cohesion"@en, "powdering"@en, "friability"@en,
    "pulverization"@en, "farinage"@fr, "Pudern"@de, "Kreiden"@de, "Kohäsionsverlust"@de;
  skos:note "Désagrégation en poudred’un matériau à grains fins (ex. craie).  [ICOMOS-ISCS]"@fr,
    "The loss of cohesion and the generation of very fine particles (chalk / powder like) on the surface of a material. [EwaGlos]"@en,
    "Kohäsionsverlust und Ablagerung von sehr feinen Partikeln (kreide- oder puderartig) auf der Oberfläche des Materials. [EwaGlos]"@de,
    "termíny někdy používané pro popsání zrnitého rozpadu jemnozrnných hornin. [ICOMOS-ISCS]"@cs;
  skos:broader :c_ed43f447;
  dct:created "2019-07-06T20:18:07.000"^^xsd:dateTime;
  dct:modified "2021-01-30T17:43:30.000"^^xsd:dateTime .

:c_bf038ef8 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ef0a8695,
    :conceptScheme_ec8c77bf;
  skos:prefLabel "Blase"@de, "boursouflure"@fr, "bulge"@en, "zpuchýřování"@cs;
  skos:altLabel "Wölbung"@de, "Aufwölbung"@de, "Beule"@de, "swelling"@en, "protuberance"@en;
  skos:note "Détachement d’une couche superficielle de la pierre sous forme d’un bombement creux plus ou moins fissuré, et de forme sub-hémisphérique. Ce détachement est indépendant de la structure interne de la pierre. [ICOMOS-ISCS]"@fr,
    "Localised rounded protuberance or swelling from within or underneath caused by pressure. [EwaGlos]"@en,
    "Lokal begrenzte, runde Wölbung oder Schwellung in einer oder unterhalb einer Schicht, die durch Druck entstand. [EwaGlos]"@de,
    "Abgetrennte, luftgefüllte, erhabene, halbkugelförmige Erhebung auf der Steinoberfläche, entstanden durch die Ablösung einer äußeren Gesteinsschicht. Die Ablösung ist unabhängig von der Gesteinstextur. [ICOMOS-ISCS]"@de,
    "Oddělené, vzduchem vyplněné a nadzvednuté vrchlíkovitévýstupky na povrchu kamene způsobenéodtržením vnější kamenné vrstvy. Odtržení je nezávisléna struktuře kamene. [ICOMOS-ISCS]"@cs;
  skos:broader :c_ed43f447;
  dct:created "2019-07-06T20:25:16.000"^^xsd:dateTime;
  dct:modified "2021-01-30T17:44:33.000"^^xsd:dateTime .

:c_a916eae8 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ef0a8695,
    :conceptScheme_ec8c77bf;
  skos:prefLabel "craquelure"@en, "craquelure"@fr, "Craquelée"@de;
  skos:altLabel "Krakelee"@de, "Kraklé"@de, "crackle"@en;
  skos:note "A network of fine minor cracks specific to secco paint layers. [EwaGlos]"@en,
    "Netz von kleinsten Rissen, typisch für Malschichten, die in Secco-Technik ausgeführt sind. [EwaGlos]"@de;
  skos:broader :c_ed43f447;
  dct:created "2019-07-14T13:49:00.000"^^xsd:dateTime;
  dct:modified "2021-01-30T17:45:07.000"^^xsd:dateTime .

:c_8eb29da8 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ef0a8695,
    :conceptScheme_ec8c77bf;
  skos:prefLabel "Weißschleier"@de, "white veil"@en;
  skos:note "A whitish haze forming over an architectural surface. [EwaGlos]"@en, "Ein weißlicher Schleier, der sich auf einer Architekturoberfläche bildet. [EwaGlos]"@de;
  skos:broader :c_ed43f447;
  dct:created "2019-07-14T13:55:57.000"^^xsd:dateTime;
  dct:modified "2021-01-30T17:52:55.000"^^xsd:dateTime .

:c_257a191b a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ef0a8695,
    :conceptScheme_ec8c77bf;
  skos:prefLabel "Vergilbung"@de, "yellowing"@en;
  skos:note "Chromatic alteration manifested as a change in colour in materials, usually in a yellowish hue. [EwaGlos]"@en,
    "Farbveränderung, die sich in einem Farbwechsel des Materials zeigt, in der Regel zu einem gelblichen Farbton. [EwaGlos]"@de;
  skos:broader :c_ed43f447;
  dct:created "2019-07-14T13:58:01.000"^^xsd:dateTime;
  dct:modified "2021-01-30T17:52:29.000"^^xsd:dateTime .

:c_808401d2 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ef0a8695,
    :conceptScheme_ec8c77bf;
  skos:prefLabel "Verdunklung"@de, "darkening"@en;
  skos:altLabel "Verschwärzung"@de;
  skos:note "A change in the surface colour due to a decrease in hue (reduction of visible light reflection). [EwaGlos]"@en,
    "Eine Farbveränderung der Oberfläche durch Dämpfung des Farbtons (Herabsetzung der Reflexion des sichtbaren Lichts). [EwaGlos]"@de;
  skos:broader :c_ed43f447;
  dct:created "2019-07-14T13:59:58.000"^^xsd:dateTime;
  dct:modified "2021-01-30T17:51:58.000"^^xsd:dateTime .

:c_129b705a a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ef0a8695,
    :conceptScheme_ec8c77bf;
  skos:prefLabel "Farbsättigung"@de, "colour saturation"@en;
  skos:note "The intensification of colour of a surface caused by humidity or by the use of construction or conservation materials. [EwaGlos]"@en,
    "Intensivierung der Farbe einer Oberfläche durch Feuchte oder durch eingebrachte Bau- oder Konservierungsmaterialien. [EwaGlos]"@de;
  skos:broader :c_ed43f447;
  dct:created "2019-07-14T14:04:20.000"^^xsd:dateTime;
  dct:modified "2021-01-30T17:45:55.000"^^xsd:dateTime .

:c_393eee89 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ef0a8695,
    :conceptScheme_ec8c77bf;
  skos:prefLabel "Verblassen"@de, "fading"@en;
  skos:note "A chromatic alteration manifested as the weakening of colour (pigment) saturation and which is generally the result of chemical reactions or exposure to direct sunlight. [EwaGlos]"@en,
    "Eine Farbveränderung, die sich in Form einer Schwächung der Farb- oder Pigmentsättigung zeigt und in der Regel auf chemische Reaktionen oder direktes Sonnenlicht zurückzuführen ist. [EwaGlos]"@de;
  skos:broader :c_ed43f447;
  dct:created "2019-07-14T15:48:39.000"^^xsd:dateTime;
  dct:modified "2021-01-30T17:51:39.000"^^xsd:dateTime .

:c_4e05a6e8 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ef0a8695,
    :conceptScheme_ec8c77bf;
  skos:prefLabel "Winderosion"@de, "wind erosion"@en;
  skos:note "The slow surface attrition or wear of architectural surfaces or mural paintings, which is usually caused by the natural action of wind-blown particles (e.g. dust, sand). [EwaGlos]"@en,
    "Die langsame Abnutzung oder der Abrieb von Architekturoberflächen oder Wandmalereien, die üblicherweise durch den natürlichen Einfluss von windgetragenen Partikeln (wie z.B. Staub, Sand) verursacht werden. [EwaGlos]"@de;
  skos:broader :c_ed43f447;
  dct:created "2019-07-14T16:00:37.000"^^xsd:dateTime;
  dct:modified "2021-01-30T17:53:13.000"^^xsd:dateTime .

:c_d0fbe47d a skos:Concept;
  skos:definition "Aspect de surface qui reflète totalement ou partiellementla lumière. La surface ressemble à un miroir. [ICOMOS-ISCS]"@fr,
    "Aspect of a surface that reflects totally or partially the light. The surface has a mirror-like appearance. [ICOMOS-ISCS]"@en,
    "Erscheinung an einer Oberfläche, welche ganz oder teilweise das Licht reflektiert. Die Oberfläche hat ein spiegelartiges Aussehen. [ICOMOS-ISCS]"@de,
    "Vlastnost povrchu, který odráží úplně, nebo částečně světlo. povrch má vzhled zrcadla. [ICOMOS-ISCS]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_315cf028,
    :conceptScheme_ef0a8695, :conceptScheme_34ca6582;
  skos:prefLabel "aspect luisant"@fr, "glossy aspect"@en, "Glanz"@de, "lesk"@cs;
  skos:altLabel "polished surface"@en, "vyleštěný povrch"@cs, "polierte Oberfläche"@de,
    "Politur"@de;
  skos:broader :c_ed43f447, :c_0135dacb;
  dct:created "2019-11-07T14:16:21.000"^^xsd:dateTime;
  dct:modified "2026-02-02T09:40:23"^^xsd:dateTime .

:c_db1b6d2b a skos:Concept;
  skos:definition "Forme d’altération superficielle résultant d’une incision, rayure ou application de peinture, encre ou matériau assimilé. [ICOMOS-ISCS]"@fr,
    "Engraving, scratching, cutting or application of paint, ink or similar matter on the stone surface. [ICOMOS-ISCS]"@en,
    "Einritzen, Kratzen, Schneiden oder Aufsprühen von Farbe, Tinte oder ähnlichem auf die Steinoberfläche.[ICOMOS-ISCS]"@de,
    "Rytí, škrábání, vyřezávání nebo nanesení barvy,inkoustu nebo podobné hmoty na kamenný povrch;malba sprejem na zeď. [ICOMOS-ISCS]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_34ca6582;
  skos:prefLabel "graffiti"@fr, "graffiti"@en, "Graffiti"@de, "vandalské značkování"@cs;
  skos:altLabel "grafiti"@cs;
  skos:broader :c_ed43f447;
  dct:created "2019-11-07T14:21:21.000"^^xsd:dateTime;
  dct:modified "2021-01-30T17:48:45.000"^^xsd:dateTime .

:c_81625868 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ef0a8695;
  skos:prefLabel "Absprengung"@de;
  skos:broader :c_ed43f447;
  dct:created "2020-09-11T13:30:38.000"^^xsd:dateTime;
  dct:modified "2021-01-30T17:43:58.000"^^xsd:dateTime .

:c_b383a8ae a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ef0a8695;
  skos:prefLabel "Lockerung des Materials"@de;
  skos:broader :c_ed43f447;
  dct:created "2020-09-14T12:01:56.000"^^xsd:dateTime;
  dct:modified "2021-01-30T17:49:49.000"^^xsd:dateTime .

:c_11485907 a skos:Concept;
  skos:definition "espace vide, cavité.[ICOMOS-ISCS]"@fr, "hollow place in the stone surface, hole. [ICOMOS-ISCS]"@en,
    "Eine Hohlstelle in der Steinoberfläche. [ICOMOS-ISCS] "@de, "duté nebo prázdné místo v povrchu kamene, díra. [ICOMOS-ISCS] "@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ef0a8695,
    :conceptScheme_ec8c77bf, :conceptScheme_34ca6582;
  skos:prefLabel "mezera"@cs, "trou"@fr, "cavity"@en, "Lücke"@de;
  skos:altLabel "gap"@en, "Loch"@de;
  skos:note "A hollow space (a loss of components) usually enclosed within solid material. [EwaGlos]"@en,
    "Hohlraum (Substanzverlust), in der Regel umgeben von festem Material. [EwaGlos]"@de;
  skos:broader :c_pf961ulj;
  dct:created "2019-07-06T19:41:09.000"^^xsd:dateTime;
  dct:modified "2021-01-30T16:44:22.000"^^xsd:dateTime .

:c_2411ebe4 a skos:Concept;
  skos:definition "détachement de fragments plats ou incurvés organisés en écailles de poisson et d’épaisseur submillimétrique à millimétrique.[ICOMOS-ISCS]"@fr,
    "scaling in thin flat or curved scales of submillimetric to millimetric thickness, organized as fish scales. [ICOMOS-ISCS]"@en;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ef0a8695,
    :conceptScheme_34ca6582;
  skos:prefLabel "ecaillage"@fr, "flaking"@en, "Abflocken"@de;
  skos:broader :c_be6dd5fa;
  dct:created "2019-10-16T14:24:14.000"^^xsd:dateTime;
  dct:modified "2021-01-30T16:31:26.000"^^xsd:dateTime .

:c_bc1004ab a skos:Concept;
  skos:definition "desquamation dont l’interface avec la partie saine de la pierre reproduit le modelé de la pierre, parallèlement à sa surface. [ICOMOS-ISCS]"@fr,
    "scaling in which the interface with thesound part of the stone is parallel to the stone surface. [ICOMOS-ISCS]"@en,
    "Hier verläuft die Trennfläche zwischen Schale und gesundem Gestein parallel zur Gesteinsoberfläche. Im Fall von ebenen Oberflächen kann die Konturschale auch als „Abplatzung“ bezeichnet werden. [ICOMOS-ISCS] "@de,
    "Odpadávání povrchů a hran v tenkých plátcích při kterémstyková plocha s nezvětralou částí kamene je paralelní spovrchem kamene. V případě plochého povrchu oddělováníkamene může být označené jako odprýskávání plochy. [ICOMOS-ISCS] "@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ef0a8695,
    :conceptScheme_34ca6582;
  skos:prefLabel "contour scaling"@fr, "contour scaling"@en, "Konturschale"@de, "odpadávání povrchů a hran"@cs;
  skos:altLabel "desquamation en plaque"@fr, "case hardening"@en, "Buchdeckelverhärtung"@de,
    "odprýskávání plátků"@cs;
  skos:broader :c_be6dd5fa;
  dct:created "2019-10-16T14:30:09.000"^^xsd:dateTime;
  dct:modified "2021-01-30T16:31:51.000"^^xsd:dateTime .

:c_7fe1d054 a skos:Concept;
  skos:definition "Contour scaling : scaling in which the interface with the sound part of the stone is parallel to the stone surface. In the case of flat surfaces, contour scaling may be called spalling. [ICOMOS-ISCS]"@en,
    "Contour scaling : desquamation dont l’interface avec la partie saine de la pierre reproduit le modelé de la pierre, parallèlement à sa surface. Dans le cas où cette surface est plane, l’expression Desquamation en plaque (préférée à déplacage ou encore formation de plaques) peut être utilisée. [ICOMOS-ISCS]"@fr;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ef0a8695,
    :conceptScheme_34ca6582;
  skos:prefLabel "desquamation en plaque"@fr, "spalling"@en;
  skos:broader :c_be6dd5fa;
  dct:created "2019-10-16T14:38:42.000"^^xsd:dateTime;
  dct:modified "2021-01-30T16:32:29.000"^^xsd:dateTime .

:c_dfb280e1 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_315cf028,
    :conceptScheme_ef0a8695, :conceptScheme_ec8c77bf;
  skos:prefLabel "statischer Riss"@de, "static crack"@en;
  skos:note "A crack which is caused by a change in the distribution of the static charge/load of the masonry structure. [EwaGlos]"@en,
    "Ein Riss, der durch Veränderung in der Verteilung statischer Belastung / Last auf eine Mauerwerkskonstruktion verursacht wird. [EwaGlos]"@de;
  skos:broader :c_a37cbf12, :c_jfpkvat1;
  dct:created "2019-07-14T13:38:59.000"^^xsd:dateTime;
  dct:modified "2021-01-30T17:38:42.000"^^xsd:dateTime .

:c_a5f5496d a skos:Concept;
  skos:definition "Augmentation de clarté, due à l’altérationchimique des minéraux (par exemple réduction du fer et dumanganèse) ou à l’extraction de matière colorante (par lavage,lessivage), ou par perte de poli, généralement très superficielle.Les marbres foncés et ceux de couleurs vives subissentsouvent une décoloration suite à une exposition aux intempéries.Un blanchiment est une sorte de décoloration. [ICOMOS-ISCS]"@fr,
    "Gain in value due to chemical weatheringof minerals (e.g. reduction of iron and manganesecompounds) or extraction of coloring matter (leaching, washingout), or loss of polish, generally very superficial. Dark andbright color marbles often show bleaching as a result of exposureto weather. [ICOMOS-ISCS]"@en,
    "Bleichung ist eine Zunahme der Farbhelligkeit auf Grund der chemischen Verwitterung von Mineralen (z. B. Eisen- oder Mangan- Komponenten), der Extraktion von färbenden Bestandteilen („Auslaugung“, „Auswaschung“) oder des Verlusts der Politur. Dunk le und farbige Marmore zeigen oft eine Bleichung, wenn sie der Witterung ausgesetzt sind. [ICOMOS-ISCS] "@de,
    "Barva zbělá v důsledku chemickéhozvětrání minerálů (tj. redukcí oxidů železa a manganu), neboextrakcí barvící hmoty (vylouhováním, vyplavením, vymytím),nebo ztrátou lesku, zpravidla velice povrchově. Tmavé a jasnězbarvené mramory často blednou, jako důsledek vystavení povrchuvlivům povětrnosti. [ICOMOS-ISCS] "@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028, :conceptScheme_ef0a8695,
    :conceptScheme_ec8c77bf, :conceptScheme_34ca6582;
  skos:prefLabel "décoloration"@fr, "bleaching"@en, "Bleichung"@de, "zbělení"@cs;
  skos:altLabel "Verblassen"@de, "fading"@en, "závoj"@cs, "zesvětlení"@cs, "Bleichen"@de,
    "Ausbleichen"@de, "Entfärbung"@de;
  skos:note "A chromatic change manifestedas a whitening of the constituent materials; tobecome white over time. [EwaGlos]"@en,
    "Eine Farbveränderung, die sich im Blasswerden bestehender Materialien äußert. [EwaGlos]"@de;
  skos:broader :c_bmuzsgj2;
  dct:created "2019-07-14T14:33:45.000"^^xsd:dateTime;
  dct:modified "2021-01-30T17:40:28.000"^^xsd:dateTime .

:c_a73136ac a skos:Concept;
  skos:definition "Staudamm, Staumauer, künstlich errichteter Damm, Wall oder Mauer, um Wasser für Energiegewinnung und Bewässerung aufzustauen. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "Staumauer"@de;
  skos:note "Mauer, die zum Anstauen eines Wasserlaufes dient. (Glossarium Artis, Bd. 3, Bögen und Mauerwerk) "@de;
  skos:broader :c_5b828b5f;
  dct:created "2019-07-15T08:23:52.000"^^xsd:dateTime;
  dct:modified "2021-01-22T15:38:57.000"^^xsd:dateTime;
  :broaderByFunction :c_5b828b5f .

:c_f66e21eb a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_ef0a8695,
    :conceptScheme_ec8c77bf;
  skos:prefLabel "scagliola"@en, "scagliola"@cs, "Scagliola"@de;
  skos:altLabel "Stucco lustro"@de, "Stuckmarmorintarsie"@de, "stucco marble"@en;
  skos:note "A technique used to imitate decorative stones (e.g. marble, breccia, and porphyry). [EwaGlos]"@en,
    "Eine Technik, um dekorative Steine zu imitieren (z.B. Marmor, Brekzie und Porphyr). [EwaGlos]"@de;
  skos:broader :c_0da8a3da;
  dct:created "2019-07-24T19:08:44.000"^^xsd:dateTime;
  dct:modified "2021-01-30T15:08:23.000"^^xsd:dateTime .

:c_5a138dc5 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe;
  skos:prefLabel "Marmorimitation"@de, "imitace mramoru"@cs;
  skos:broader :c_0da8a3da;
  skos:narrower :c_80ba4e6c, :c_56804594;
  dct:created "2020-08-13T10:13:54.000"^^xsd:dateTime;
  dct:modified "2020-09-08T11:18:40.000"^^xsd:dateTime .

:c_d847b271 a skos:Concept;
  skos:definition "Die abgekeilten Steinblöcke wurden [...] mit Keilen weiter zerkleinert.Dies wird,[...] mit Eisenkeilen durchgeführt,wobei man heute beim Trennen der Blöcke parallel zur natürlichen Schichtrichtung vom Spalten und rechtwinklig zur Schichtrichtung vom Stoßen spricht. Vor allem das Stoßen ist etwas heikel, da hier immer die Gefahr besteht, dass der Stein nicht sauber bricht, sondern frühzeitig seitlich ausreißt. Um das zu verhindern, kann man an drei Seiten sogenannte Schrote anbringen - keilförmige Rillen, die zum einen als Sollbruchstelle und zum andern zur Aufnahme der Keile dienen. Hier ist es wichtig, dass die Winkel von Keil und Schrot exakt zusammenpassen. Nach dem Ansetzen der Keile wird mit dem Schlägel vorsichtig Keil für Keil angetrieben, bis der Block an der vorgesehenen Stelle auseinanderbricht. [Voelkle 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_f10222e0;
  skos:prefLabel "Schroten"@de;
  skos:broader :c_1192c84c;
  dct:created "2019-12-03T12:02:15.000"^^xsd:dateTime;
  dct:modified "2021-01-18T14:06:08.000"^^xsd:dateTime .

:c_012abe3d a skos:Concept;
  skos:definition "Umbänken bedeutet das Drehen eines Werkstücks auf der entsprechenden Arbeitsunterlage. [Voelkle 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_f10222e0;
  skos:prefLabel "Umbänken"@de;
  skos:broader :c_1192c84c;
  dct:created "2019-12-03T12:33:05.000"^^xsd:dateTime;
  dct:modified "2021-01-18T14:07:24.000"^^xsd:dateTime .

:c_57406078 a skos:Concept;
  skos:definition "Damit die Fläche [bei der Werksteinbearbeitung] nicht windschief wird, ist der dritte Schlag mit dem Ersten exakt in Flucht zu bringen. Dieses sogenannte »Ersehen« des Schlags erfolgt durch das Auflegen eines Richtscheites auf den bereits erstellten ersten Schlag. Mit einem zweiten Richtscheit oder großen Winkel wird die gegenüberliegende Seite angerissen.Beim Anreißen wird das Richtscheit am gezogenen Schlag gutgehalten und durch Anpeilen über die ganze Längemit dem gegenüberliegenden Richtscheit parallel zur Deckung gebracht. [Voelkle 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_f10222e0;
  skos:prefLabel "Ersehen"@de;
  skos:broader :c_1192c84c;
  dct:created "2019-12-12T12:22:16.000"^^xsd:dateTime;
  dct:modified "2021-01-18T14:05:15.000"^^xsd:dateTime .

:c_209895ab a skos:Concept;
  skos:definition "Mit der Fläche wird eine vorher gespitzte Oberfläche eines Werksteines eingeebnet. [BVHA]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_f10222e0;
  skos:prefLabel "Abflächen"@de;
  skos:broader :c_1192c84c;
  skos:related :c_0dd0afbf;
  dct:created "2019-12-18T10:41:00.000"^^xsd:dateTime;
  dct:modified "2021-01-18T14:05:00.000"^^xsd:dateTime .

:c_0dd0afbf a skos:Concept;
  skos:definition "Arbeitsspuren am Werkstein, die vom Gebrauch einer Glattfläche herrühren und dem Einebnen einer Fläche dienten. [BVHA]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ef0a8695;
  skos:prefLabel "Abflächung"@de;
  skos:broader :c_162d82c1;
  skos:narrower :c_c5f6b57d, :c_59e88e37, :c_e9306c8d;
  skos:related :c_209895ab;
  dct:created "2019-12-18T10:47:12.000"^^xsd:dateTime;
  dct:modified "2021-03-19T13:18:23.000"^^xsd:dateTime .

:c_e2ade4eb a skos:Concept;
  skos:definition "Beim Überflächen wird nach dem groben Abflächen in einem zweiten Arbeitsgang und etwas feineren Hieben mit dem gleichen Werkzeug eine zweite Hieblage über die erste gelegt. [Voelkle 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_f10222e0;
  skos:prefLabel "Überflächen"@de;
  skos:broader :c_1192c84c;
  skos:related :c_0c86ff71;
  dct:created "2019-12-18T11:26:07.000"^^xsd:dateTime;
  dct:modified "2021-01-18T14:06:49.000"^^xsd:dateTime .

:c_0c86ff71 a skos:Concept;
  skos:definition "Nach dem Abspitzen und groben Abarbeiten mittels Glattfläche [an einem Werkstein] erfolgte in einem zweiten Durchgang die Überflächung. [...]  Trotzdem blieben manchmal auch hier die Spuren der vorherigen Arbeitsschritte wie etwa Spitzhiebe und die Spuren der vorangegangenen Abflächung mehr oder weniger deutlich sichtbar. [Voelkle 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ef0a8695, :conceptScheme_f10222e0;
  skos:prefLabel "Überflächung"@de;
  skos:broader :c_162d82c1;
  skos:related :c_e2ade4eb;
  dct:created "2019-12-18T11:10:58.000"^^xsd:dateTime;
  dct:modified "2021-03-19T13:23:19.000"^^xsd:dateTime .

:c_d2fca7f7 a skos:Concept;
  skos:definition "Die Zahnfläche wird [...] nach dem Spitzen eingesetzt. Je nach Lage der zu bearbeitenden Oberfläche und der Steinhärte ergeben sich ganz unterschiedliche Hiebwinkel. Die effektivste Bearbeitung erreicht man bei schräg liegender Oberfläche (etwa 30° - 40° ). [Voelkle 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_f10222e0;
  skos:prefLabel "Zahnflächen"@de;
  skos:broader :c_1192c84c;
  skos:related :c_290bd3f2;
  dct:created "2019-12-18T12:10:01.000"^^xsd:dateTime;
  dct:modified "2021-01-18T14:08:06.000"^^xsd:dateTime .

:c_290bd3f2 a skos:Concept;
  skos:definition "Durch die Zahnung [der Zahnfläche] kann der Materialabtrag [...] schneller erfolgen als [mit der Glattfläche], vor allem bei der Bearbeitung »im Stich«. Durch den unterschiedlichen Einsatz der Zahnfläche ergaben sich ganz unterschiedliche Bilder: Während das am horizontal liegenden Werkstück eingesetzte Werkzeug schmale, gezahnte Hiebrillen hinterließ, führte der Einsatz »im Stich« zu langen, streifenförmigen Hieben. [Voelkle 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ef0a8695, :conceptScheme_f10222e0;
  skos:prefLabel "Zahnflächung"@de;
  skos:broader :c_162d82c1;
  skos:related :c_d2fca7f7;
  dct:created "2019-12-18T11:33:37.000"^^xsd:dateTime;
  dct:modified "2021-03-19T13:23:11.000"^^xsd:dateTime .

:c_93a535f5 a skos:Concept;
  skos:definition "Bei der feinen Zahnflächung wird die Zahnfläche senkrecht oder nahezu senkrecht geführt. Mit feinen parallelen Hiebenwird die vorher zahngeflächte Oberfläche noch einmal komplett überarbeitet und alle bisherigen Arbeitsspuren weitgehend entfernt. Um eine präzisere Hiebführung zu erreichen,kann man den Werkzeugkopf direkt mit einer Hand halten, statt das Werkzeug mit zwei Händen zu führen. [Voelkle 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_f10222e0;
  skos:prefLabel "feines Zahnflächen"@de;
  skos:broader :c_1192c84c;
  skos:related :c_226599af;
  dct:created "2019-12-18T13:32:15.000"^^xsd:dateTime;
  dct:modified "2021-01-18T14:05:36.000"^^xsd:dateTime .

:c_226599af a skos:Concept;
  skos:definition "[D]ie zahngeflächten Oberflächenin[wurden in] einem zweiten Durchgang zunehmend fein überarbeitet. Dabei verwendete man zunächst wohl das gleiche Werkzeug, wobei man es senkrecht oder nahezu senkrecht zur Oberfläche führte. Dadurch erhielt man eine einheitliche Oberfläche. Die unruhigen Zahnhiebe, die vor allem bei der Bearbeitung im Stich entstanden, machte man durch die schmalen, dicht gesetzten Hiebe nahezu unsichtbar. [Voelkle 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ef0a8695, :conceptScheme_f10222e0;
  skos:prefLabel "Feine Zahnflächung"@de;
  skos:altLabel "Zahnpillung"@de;
  skos:broader :c_162d82c1;
  skos:related :c_93a535f5;
  dct:created "2019-12-18T12:15:32.000"^^xsd:dateTime;
  dct:modified "2021-03-19T13:21:59.000"^^xsd:dateTime .

:c_0a5fe3fd a skos:Concept;
  skos:definition "Die feine Überflächung wird genau wie die feine Zahnflächung durchgeführt [mit einer Glattfläche statt einer Zahnfläche]. Die dabei entstehende äußerst gleichmäßige Oberfläche wirkt jedoch noch ruhiger und wird aus einiger Entfernung und bei direkter Lichteinstrahlung kaum noch als Oberflächenbearbeitung wahrgenommen. [Voelkle 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_f10222e0;
  skos:prefLabel "Feines Überflächen"@de;
  skos:broader :c_1192c84c;
  skos:related :c_6d543cd0;
  dct:created "2019-12-18T13:51:27.000"^^xsd:dateTime;
  dct:modified "2021-01-18T14:05:23.000"^^xsd:dateTime .

:c_6d543cd0 a skos:Concept;
  skos:definition "Ähnlich der Überflächung. Die feine Überflächung wirkt aufgrund dichterer und feinerer Hiebe stärker vereinheitlicht. Wurde mit der Glattfläche ausgeführt. [BVHA]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ef0a8695, :conceptScheme_f10222e0;
  skos:prefLabel "Feine Überflächung"@de;
  skos:altLabel "Glattpillung"@de;
  skos:broader :c_162d82c1;
  skos:related :c_0a5fe3fd;
  dct:created "2019-12-18T13:35:24.000"^^xsd:dateTime;
  dct:modified "2021-03-19T13:21:49.000"^^xsd:dateTime .

:c_8fc3b9e5 a skos:Concept;
  skos:definition "Im Gegensatz [zum Scharrieren] wird beim Stelzen der Anstellwinkel steiler gewählt. Hier bleibt das Eisen nach dem Schlag in der Rille stehen und wird dann mit zwei kurzen, über die Schneidekante kippenden Bewegungen zum nächsten Schlag vorwärtsgeführt. [Voelkle 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_f10222e0;
  skos:prefLabel "Stelzen"@de;
  skos:broader :c_1192c84c;
  skos:related :c_f46ae1ca;
  dct:created "2019-12-18T14:22:20.000"^^xsd:dateTime;
  dct:modified "2021-01-18T14:06:32.000"^^xsd:dateTime .

:c_f46ae1ca a skos:Concept;
  skos:definition "Es gab [beim Scharrieren] Oberflächen an denen der gestelzte Hieb zum Einsatz kam. Durch das etwas steiler geführte Eisen und den nicht ganz durchgezogenen Hieb entstand ein etwas härteres, akzentuiertes Bild. [Voelkle 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ef0a8695, :conceptScheme_f10222e0;
  skos:prefLabel "Stelzung"@de, "elevación de arco"@es, "rialzo"@it, "exhaussement"@fr,
    "stilting"@en;
  skos:altLabel "sopralzo"@it, "elevación de bóveda"@es;
  skos:broader :c_162d82c1;
  skos:related :c_8fc3b9e5;
  dct:created "2019-12-18T14:25:32.000"^^xsd:dateTime;
  dct:modified "2021-03-19T13:23:27.000"^^xsd:dateTime .

:c_25aeeabb a skos:Concept;
  skos:definition "Das Verbinden zweier Werkstücke mit Blei. [BVHA]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_f10222e0;
  skos:prefLabel "Verbinden mit Blei"@de;
  skos:broader :c_1192c84c;
  dct:created "2019-12-18T16:32:18.000"^^xsd:dateTime;
  dct:modified "2021-01-18T14:07:50.000"^^xsd:dateTime .

:c_c59721ba a skos:Concept;
  skos:definition "Bossieren, einen Werkstein oder Quader an seiner Vorderseite mit dem Zweispitz, Spitzeisen o.Ä. grob zuhauen, so dass eine erhabene Bosse stehenbleibt, die dann weiter ausgearbeitet wird. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_84fc24e6;
  skos:prefLabel "Bossieren"@de;
  skos:broader :c_1192c84c;
  dct:created "2020-08-03T16:08:34.000"^^xsd:dateTime;
  dct:modified "2021-01-18T14:05:07.000"^^xsd:dateTime .

:c_0a02c60b a skos:Concept;
  skos:definition " Hau- oder Werkstein in regelmäßiger Form mit meist glatten, parallelen Flächen, deren Spiegel (Fläche) von einem 1,5 - 4,0 cm breiten Randschlag umgeben ist. Sonderformen mit unebener Sichtfläche sind Bossenq. oder Rustika (Spiegel weitgehend unbehauen, Randschlag meist vorhanden, opus rusticum), Buckelq. (Spiegel roh behauen, buckelförmig vorstehend), Diamantq. (Spiegel einem Facettenschliff ähnl. vorstehend) (Steinbearbeitung, Steinmetzzeichen, Mauerwerk). [Koepf/Binding 2016]"@de,
    "Pravoúhlý, masivní blok. [Koch 2008]"@cs, "Ein Werkstein bestehend aus sechs Flächen. [Voelkle 2016]"@de,
    "Längsrechteckig oder quadratisch, in jedem Fall viereckig zugehauener Stein mit glatten Kanten. Ein Q. besitzt demzufolge fünf bearbeitete Seiten (Stirn- bzw. Sichtseite, d. h. Spiegel, und umlaufende Seiten); die Rückseite wurde zum besseren Einbinden in das Mauerwerk bzw. Füllwerk in der Regel kaum bearbeitet. Das Format des Q.s kann extrem variieren (Hand-Q.; Buckel-Q.), desgleichen die Bearbeitung der sichtbaren Oberfläche bzw. des Spiegels (Bossen-Q., Kissenbuckel-Q., Polsterbuckel-Q., Glatt-Q.). Sehr gut zu bearbeiten sind Sandstein und Tuffstein, sehr schlecht dagegen Kalkstein, Nagelfluh und Granit.Das in antiker Zeit durchaus übliche Q.-Mauerwerk erschien seit dem 11. Jh. erneut im Wehrbau, damals in Form von Handquadern. Es änderte im Laufe des 12. Jhs. sein ursprünglich kleines Format hin zu großen Q.n (Buckel-Q.), die mitunter Höhen von 60–80 cm und Längen bis zu 1,5–2 m besitzen konnten. In der Neuzeit tritt an die Stelle des Begriffs Q. der der Rustika, die nur mehr eine dekorative Funktion hat. Rustizierungen können auch durch Putzfelder gestaltet werden und müssen nicht von Stein sein. Sie werden bevorzugt im Erdgeschossbereich verwendet, können aber auch auf Gebäudeecken als Lisenen gesetzt sein oder als durchgehende Streifen (Bänderrustika) gestaltet werden. Wird ein Pilaster rustiziert, steht er in der Rangordnung unter einem nicht rustizierten (Säulenordnungen). Diamant-Q. werden solche Q. genannt, deren Bossen einem Diamanten ähnlich abgearbeitet sind. Sie kommen im 15. Jh. in Italien auf und werden in Deutschland im 16. und 17. Jh. ähnlich der Rustizierung verwendet. J. Z. /H. L. [Wörterbuch der Burgen, Schlösser und Festungen]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_50ec0c5e,
    :conceptScheme_37522b74, :conceptScheme_1d7ba54b, :conceptScheme_f10222e0;
  skos:prefLabel " pierre carré"@fr, "kvádr"@cs, "ashlar"@en, "concio squadrato"@it,
    " pieda de talla"@es, "Quader"@de;
  skos:altLabel "Werkstein"@de, "sillar"@es, "carreau"@fr, "cut stone"@en;
  skos:broader :c_9c69c39b;
  skos:narrower :c_8cf58090, :c_0853357b, :c_6b5a3572, :c_a04114a3, :c_258840c4, :c_6326b2c4;
  dct:created "2019-12-12T11:16:17.000"^^xsd:dateTime;
  dct:modified "2021-01-27T16:08:30.000"^^xsd:dateTime;
  :broaderByShape :c_9c69c39b .

:c_3d90652a a skos:Concept;
  skos:definition "Eine nur angelegte, nicht vollendete Bildhauer- oder Steinmetzenarbeit, z.B. ein Kapitell, das in unfertigem Zustand versetzt wurde. Solche B.n-Kapitelle finden sich, oft neben fertigen, bes. an Bauten des MAs. [Koepf / Binding 2016] "@de,
    "Bosse (mittelhochdt. bozen: schlagen), 1. die nur roh zugerichtete, daher buckelige Vorderseite bzw. Ansichtsfläche eines Werksteins oder Quaders (Buckelquader, Bossenquader). Die B. diente urspr. wohl dazu, das Abgleiten schwerer Steine von den Hebetauen zu verhindern (Versatzb.), und kommt bereits in der antiken Mauertechnik und an altamerikan. Bauten vor. Bes. häufig findet man B.nmauerwerk (B.nwerk) an Burgen der Stauferzeit und an Palastbauten der Frührenaissance. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Bosse"@de;
  skos:broader :c_dfc5e7ad;
  skos:related :c_8cf58090;
  dct:created "2020-09-05T14:59:56.000"^^xsd:dateTime;
  dct:modified "2021-01-26T10:46:28.000"^^xsd:dateTime .

:c_604a31da a skos:Concept;
  skos:definition "Buckelquader mit einer kissenförmig bearbeiteten Oberfläche, die nur gering vorspringt und eine aufwändige Steinbearbeitung erfordert. Bedeutendes Beispiel einer Burg mit K. ist der Trifels RP; wird mitunter auch als Polsterbuckelquader bezeichnet. J. Z. [Wörterbuch der Burgen, Schlösser und Festungen]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_50ec0c5e,
    :conceptScheme_1d7ba54b;
  skos:prefLabel "Kissenbuckelquader"@de;
  skos:altLabel "Polsterbuckelquader "@de;
  skos:broader :c_8cf58090;
  dct:created "2020-06-15T15:49:46.000"^^xsd:dateTime;
  dct:modified "2021-01-27T16:10:36.000"^^xsd:dateTime .

