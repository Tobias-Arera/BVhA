:c_5bcab584 a skos:Concept;
  skos:definition "Dom (lat. domus), im 6./7. Jh. das Wohn- und Verwaltungshaus des Bischofs (domus episcopalis), davon auf das collegium canonicorum, das Domkapitel, übertragen; im 12./13. Jh. setzten die Kanoniker ihrem Namen de domo zu; so meint Dom eigentl. das Stiftskapitel, nicht den Bischof; heute werden allg. Bischofskirchen als Dome bezeichnet, in Süddeutschland Münster, in Frankreich Kathedrale genannt. [Koepf / Binding 2016]"@de,
    "Dom (lat. domus Dei = Haus Gottes), Bischofskirche, in Deutschland auch Hauptkirche einer Stadt ohne Bischof. In Süddeutschland auch Münster genannt. [Koch 2009]"@de,
    "Kathedrale, Bischofskirche einer Stadt, in Norddeutschland Dom, in Süddeutschland Münster genannt. [Koch 2009]"@de,
    "Bischofskirche, Hauptkirche am Sitz eines Bischofs. Die B. wird nach dem in ihr stehenden Bischofsstuhl (gr. kathedra) in Frankreich, Spanien und England meist Kathedrale genannt, während in Deutschland die Bezeichnungen Dom oder Münster üblicher sind. [Koepf / Binding 2016] "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_8c0441f9;
  skos:prefLabel "Dom"@de;
  skos:altLabel "Bischofskirche"@de, "Kathedrale"@de;
  skos:broader :c_0ea453f7;
  skos:related :c_1c7a57b1, :c_81c56447;
  dct:created "2019-02-18T21:14:14.000"^^xsd:dateTime;
  dct:modified "2021-01-19T15:04:46.000"^^xsd:dateTime;
  :broaderByFunction :c_0ea453f7 .

