:c_8e865623 a skos:Concept;
  skos:definition "Baufuge, 2. Fuge, die Bauteile aus zeitl. (Baunaht), arbeitstechn. (Bauabschnitt) oder konstruktiven (Dehn- und Setzfuge) Gründen trennt. [Koepf / Binding 2016]"@de,
    "Baunaht, Baufuge, wird die Stelle an einem Bauwerk genannt, an der ein älterer und ein jüngerer Teil sich deutl. erkennbar gegeneinander absetzen. Man findet solche B.e häufig an ma. Anlagen, die in der Regel von O. nach W. gebaut wurden und bei oft langer Bauzeit techn. und stilist. Unterschiede zwischen den einzelnen Bauabschnitten aufweisen. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_84fc24e6, :conceptScheme_315cf028;
  skos:prefLabel "Baufuge"@de;
  skos:altLabel "Baunaht"@de;
  skos:broader :c_6dd803a5;
  dct:created "2019-05-07T15:42:24.000"^^xsd:dateTime;
  dct:modified "2021-03-19T18:08:12.000"^^xsd:dateTime .

:c_6dd803a5 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_315cf028;
