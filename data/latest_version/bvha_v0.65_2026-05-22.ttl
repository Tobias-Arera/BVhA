  dct:modified "2020-09-30T10:49:29.000"^^xsd:dateTime .

:c_3cb70c24 a skos:Concept;
  skos:definition "Diglyph, Sonderform einer Triglyphe (Steg) ohne seitl. Halbschlitze. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe;
