:c_20af7737 a skos:Concept;
  skos:definition "Malerei auf getrocknetem Putz im Gegensatz zur Frescomalerei, bei der es sich vorwiegend um Temperamalerei handelt. [Schrader / Voigt 2003]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_5bf6bcac;
  skos:prefLabel "Alseccomalerei"@de;
  skos:broader :c_flb3guaw;
