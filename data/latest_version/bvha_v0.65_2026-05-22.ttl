:c_24340fa9 a skos:Concept;
  skos:definition "Eine über Ecktrichtern (Trompe) errichtete Kuppel. Ungenau auch fur  ein über Trompen errichtetes Klostergewölbe. [Koepf / Binding 2016]"@de,
    "Má horní rohy čtyřboké spodní části stavby přemostěny trompy. [Koch 2008]"@cs, "In der Regel eine vieleckige Kuppel über quadratischem Grundriss, bei der Trompen den Übergang von der Grundfläche zum Kuppelfuß ermöglichen. (Glossarium Artis)"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_37522b74;
  skos:prefLabel " coupole sur trompes "@fr, "kupole na trompech"@cs, "dome on squinches"@en,
    "cupola su tromba"@it, "cúpula sobre una trompa"@es, "Trompenkuppel "@de;
  skos:altLabel "squinch dome"@en;
  skos:broader :c_ad800342;
  dct:created "2019-12-18T14:47:02.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:37:55.000"^^xsd:dateTime;
  :broaderByConstruction :c_ad800342 .

