:c_8a0b7dd1 a skos:Concept;
  skos:definition "Sturzpfostenportal, einfachste Portalform, bei der zwei aufrecht stehende Monolithe als seitl. Begrenzung und ein Sturz den hochrechteckigen Durchgang rahmen, eine seit vorgeschichtl. Zeit übliche und bes. im Profanbau bis heute gebräuchl. Form. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
