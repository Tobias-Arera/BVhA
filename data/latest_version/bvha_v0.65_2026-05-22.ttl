:c_8cfab630 a skos:Concept;
  skos:definition "Verbreiterung am vorderen Rand des Sitzes im Chorgestühl, dient als Gesäßstütze beim Stehen. [Koepf / Binding]"@de,
    "MISERIKORDIE (lat. misericordia = milosrdenství), výstupek umístěný \"milosrdně\" vpředu pod sedadlem pak slouží jako opěra zad. Tyto výstupky, stejně jako bočnice, uzavírající zboku řady sedadel, bývaly zdobeny drsně světskými výjevy zvanými drolerie. [Koch 2008] "@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_37522b74;
  skos:prefLabel "Misericordie "@de, "miserikordie"@cs;
  skos:altLabel "Miserikordie"@de;
  skos:broader :c_60e47f2f;
  dct:created "2020-04-11T17:27:01.000"^^xsd:dateTime;
  dct:modified "2021-01-31T00:16:42.000"^^xsd:dateTime .

