:c_ce0ef4f6 a skos:Concept;
  skos:definition "Gewölbe, das durch Gurtbogen in Joche gegliedert ist. Die Gurtbogen verbessern die Statik des Gewölbes und bewirken eine Rhythmisierung der Gewölbefläche. Zu unterscheiden vom Gurtengewölbe. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "voûte sur doubleaux"@fr, "banded vault"@en, "Gurtbogengewölbe"@de;
  skos:altLabel "banded barrel vault "@en, "vault on transverse arches"@en, "Gurtgewölbe"@de;
  skos:broader :c_049c4c22;
  dct:created "2019-10-25T10:58:59.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:17:57.000"^^xsd:dateTime;
  :broaderByShape :c_049c4c22;
  :broaderByConstruction :c_049c4c22 .

:c_dcc14b1e a skos:Concept;
  skos:definition "Trichternische, Gewölbe in der Form eines halben Hohlkegels mit nach unten gekehrter Öffnung. [Koepf /Binding 2016]"@de,
    "Eine dem Fächergewölbe ähnelnde Gewölbeform, bei der die Teilgewölbe nicht auf Pfeilern ruhen, sondern an tragenden Quergurten verankert von der Decke herabhängen. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "Trichtergewölbe"@de, "bóveda normanda"@es, "volta normanna"@it, "voûte pendante"@fr,
    "pendant vault"@en;
  skos:altLabel "vějířová klenba"@cs, "voûte conique"@fr, "conical vault"@en, "voûte à retombée(s) pendante(s)"@fr,
    "voûte  à clef(s) pendante(s)"@fr, "vault normande"@fr, "voûte anglo-saxonne"@fr,
    "volta a imbuto"@it, "bóveda cónica"@es, "Hängegewölbe"@de;
  skos:broader :c_049c4c22;
  dct:created "2019-10-25T14:13:23.000"^^xsd:dateTime;
  dct:modified "2021-01-19T13:09:55.000"^^xsd:dateTime;
  :broaderByShape :c_049c4c22;
  :broaderByConstruction :c_049c4c22 .

:c_85769239 a skos:Concept;
  skos:definition "Geschlossenes oder offenes, kuppelähnliches Klostergewölbe mit spitzbogiger Wölblinie über einem vieleckigen Raum (vier-, fünf-, sechs- oder achteckig etc.). [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
