:c_eb7449d1 a skos:Concept;
  skos:definition "Glockenkasel f; rundherum gleich langer, weiter, ärmelloser, geschlossener Mantel mit Kopfdurchschlupf; die Naht auf der Vorderseite ist durch Vertikalbesatz (—> Kaselstab) verdeckt, den Rückenteil verziert bisweilen ein Kaselkreuz; bis etwa zum 13. Jh. war die Glockenkasel die übliche Form der Kasel. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "chasuble conique"@fr, "bell chasuble"@en, "Glockenkasel"@de;
