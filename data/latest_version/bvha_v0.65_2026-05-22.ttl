:c_ddcb8c64 a skos:Concept;
  skos:definition "Zuganker, ein meist eiserner Anker, der Zugspannungen aufzunehmen hat; aus Holz: Ankerbalken. [Koepf / Binding 2016]"@de,
    "Ein oft von Wand zu Wand reichender stabförmiger Anker aus Eisen oder Holz zur Absicherung des Gewölbes gegen den Seitenschub. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe;
  skos:prefLabel "tirante"@es, "Zuganker"@de, "tahová kotva"@cs, "tirant"@fr, "tie bar"@en;
  skos:altLabel "catena"@it, "táhlo"@cs, "Zugbalken"@de, "tie rod"@en, "timber bar"@en,
    "tension tie"@en, "anchor bolt"@en, "Zugstange"@de, "Ankerbaum"@de, "Ankerbinder"@de;
  skos:broader :c_a41833c5;
  skos:narrower :c_34c17184, :c_e5063280, :c_e7a5dd3c, :c_8593586c;
  dct:created "2019-05-07T14:17:25.000"^^xsd:dateTime;
  dct:modified "2020-12-01T14:12:42.000"^^xsd:dateTime .

:c_34c17184 a skos:Concept;
  skos:definition "Ankerbalken: horizontal verlaufendes Holz, das durch seine spezielle, auf Zug beanspruchte Endpunktverbindung ein Auseinanderweichen der Konstruktion verhindert; kann häufig auch Doppelfunktionen als Deckenbalken, Geschossriegel o. Ä. besitzen.  (Eißing et al. 2012) "@de;
  skos:scopeNote "Ankerbalken, hölzerner Zuganker zur Sicherung der Wände gegen den Schub des Dachwerks oder Gewölbes. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_1f14b4dd, :conceptScheme_19d56a39;
  skos:prefLabel "catena"@it, "entrait"@fr, "ancher beam"@en, "Ankerbalken"@de;
  skos:altLabel "tie beam"@en;
  skos:broader :c_ddcb8c64;
  dct:created "2019-05-27T17:33:43.000"^^xsd:dateTime;
  dct:modified "2020-02-13T11:33:56.000"^^xsd:dateTime .

:c_e5063280 a skos:Concept;
  skos:definition "Bogenanker, Anker zur Sicherung gegen die Schubwirkung eines Bogens. [Koepf / Binding 2016]"@de,
    "Stabilisierung bei Bogen, deren Widerlager zu schwach sind, um den Seitenschub aufzunehmen. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "ancrage de l\\'arc"@fr, "arch anchor"@en, "Bogenanker"@de;
  skos:broader :c_a41833c5, :c_ddcb8c64;
  dct:created "2019-09-24T12:18:23.000"^^xsd:dateTime;
  dct:modified "2020-08-05T12:04:20.000"^^xsd:dateTime .

:c_e7a5dd3c a skos:Concept;
  skos:definition "Anker, der die Balkenköpfe der Ankerbalken mit der Außenwand verbindet. [Glossarium Artis]"@de,
    "Balkenanker, Anker zur Verbindung von Holzbalken und Mauerwerk. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "ancrage de poutre"@fr, "beam anchor"@en, "Balkenanker"@de;
  skos:broader :c_ddcb8c64;
  dct:created "2020-08-05T11:48:50.000"^^xsd:dateTime;
  dct:modified "2020-09-02T16:31:59.000"^^xsd:dateTime .

:c_a3f1d1df a skos:Concept;
  skos:definition "Ringanker, Anker, der ein Gebäude einen Bauteil (Turmhelm, Kuppel) ringförmig umschließt. [Koepf / Binding 2016]"@de,
    "Kreisförmige oder auch polygonale Eisen- oder Holz einlagen, die in Schlitze gefügt und mit Blei vergossen werden. Sie dienen zur Absicherung gegen die z.B. am Fuße von Kuppeln und Klostergewölben auftretenden Ringspannungen . [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "ancrage en anneau"@fr, "ztužující věnec"@cs, "tension ring"@en, "tirante anulare"@it,
    " anclaje anular"@es, "Ringanker"@de;
  skos:altLabel "compression ring"@en, "armatura anulare"@it, "Ringbewehrung"@de, "kleštinový věnec"@cs,
    "pozední věnec"@cs, "věncové ztužení"@cs;
  skos:broader :c_a41833c5;
  dct:created "2019-05-07T14:17:35.000"^^xsd:dateTime;
  dct:modified "2020-11-26T13:37:28.000"^^xsd:dateTime .

:c_88b4f652 a skos:Concept;
  skos:definition "Die techn. Grundlage der Holzkonstruktion im Holzbau. H. dienen der zimmermannstechn. Verlängerung (Stoß, Blatt), Verbreiterung (Spundung, Nut und Feder), Verdickung (Verdübeln, Verzahnen, Verschränken), Winkelverbindung in einer Ebene (Stoß auf Gehrung, Blatt, Zapfen, Versatzung, Verzinkung) und Winkelverbindung nicht in einer Ebene (Kamm, Seitenzapfen, Klaue), auch mittels bes. Befestigungsmittel (Leim, Dübel, Metallelemente wie Schrauben, Nägel, Klammern). Im ingenieurmäßigen Holzbau werden die einzelnen Konstruktionsglieder an Knotenpunkten zusammengeführt und dort bei geringeren Belastungen durch berechnete Nagelungen oder einfache Bolzen mit breiten Unterlegscheiben verbunden. Bei weit gespannten Konstruktionen mit hohen Belastungen in den Verbindungsstellen wird die Sicherheit gegen Abscheren außer der Verbolzung durch eingepresste Dübel oder durch Verleimung der Verbindungsstellen erreicht. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_19d56a39;
  skos:prefLabel "Holzverbindung"@de, "spojení dřeva"@cs;
  skos:broader :c_0e26a85b;
  skos:narrower :c_4f44e0b0, :c_992f6701, :c_4cae559a, :c_df6f0460, :c_5a6bbbbc, :c_6dc3eb9b,
    :c_0916a2e0, :c_545d6420, :c_a4d7d18c, :c_941e3efe, :c_aa915a14, :c_ba9fe7ea, :c_1a13f79c,
    :c_32609f91, :c_0e49c61f, :c_8934bda5, :c_a32ccb15, :c_0fd116a0, :c_d5f3f3e0, :c_f7192b2a,
    :c_2e76ecb4, :c_eaa3b6a8, :c_c74a6017, :c_9d29a6f7, :c_11a903da, :c_838b4a0f, :c_b60827d2,
    :c_74cafc29, :c_4adca0cb, :c_1926adbc, :c_3849333a, :c_12e34719;
  skos:related :c_0e26a85b;
  dct:created "2019-05-15T09:30:24.000"^^xsd:dateTime;
  dct:modified "2021-03-19T20:06:41.000"^^xsd:dateTime .

