:c_8a367de6 a skos:Concept;
  skos:definition "Busung (gebust, busig), sphär. Ausbauchung des Gewölbes, bes. die überhöhung der Gewölbekappen des Kreuzgewölbes, so dass der Schnittpunkt der Kappen höher als der Scheitelpunkt der Gurtund Schildbogen liegt. Die B. der Gewölbekappen vermehrt die Verspannung des Gewölbes. B. ist zu unterscheiden vom Stich. [Koepf / Binding 2016]"@de,
    "Eine sphärische Ausformung der Gewölbekappen beim Kreuzgewölbe. Sie ergibt sich durch eine Krümmung der ansteigenden ScheitelIinien und bewirkt eine effektivere Verspannung des Gewölbes. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_1f14b4dd;
  skos:prefLabel "doming of severies"@en, "bombement des quartiers"@fr, "Busung"@de;
  skos:broader :c_3e25acca;
  skos:related :c_6ce4540b, :c_0422b318;
  dct:created "2020-02-05T14:26:19.000"^^xsd:dateTime;
  dct:modified "2021-01-19T13:16:52.000"^^xsd:dateTime .

:c_0422b318 a skos:Concept;
  skos:definition "Kreuzgewölbe mit sphärisch überhöhten Gewölbekappen. Die Scheitellinien steigen zur Mitte hin segmentbogenförmig an. Das gebuste Kreuzgewölbe ist eigentlich kein aus der Verschneidung zweier Tonnen entstandenes Gewölbe mehr, sondern es wird aus acht in allen Richtungen gekrümmten Gewölbekappen gebildet. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "domed cross vault"@en, "gebustes Kreuzgewölbe"@de, "voûte d\\'arêtes bombée"@fr;
  skos:altLabel "voûte d\\'ogives bombée "@fr, "voûte d\\'ogives a quartiers surhaussés "@fr,
    "voûte d\\'arêtes a quartiers surhaussés"@fr;
  skos:broader :c_5f9418c5, :c_4d2e0bec;
  skos:related :c_6ce4540b, :c_8a367de6;
  dct:created "2019-10-14T15:44:38.000"^^xsd:dateTime;
  dct:modified "2021-01-19T12:07:22.000"^^xsd:dateTime;
  :broaderByShape :c_5f9418c5, :c_4d2e0bec .

