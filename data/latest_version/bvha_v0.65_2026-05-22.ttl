:c_9b474e7e a skos:Concept;
  skos:definition "Die durch eine mittlere Stütze unterteilte Maueröffnung, Fenster. B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen]"@de,
    "Rozdělené středním sloupkem do dvou otvorů. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_50ec0c5e, :conceptScheme_c8a571d9, :conceptScheme_37522b74, :conceptScheme_1d7ba54b,
    :conceptScheme_be46b94e;
  skos:prefLabel "sdružené podvojné okno"@cs, "bifora"@it, "Zwillingsfenster"@de;
  skos:altLabel "Biforienfenster"@de, "Biforium"@de;
  skos:broader :c_869fcd2d;
  skos:narrower :c_a110fa01;
  dct:created "2020-08-05T09:47:03.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:11:18.000"^^xsd:dateTime .

:c_38b4531d a skos:Concept;
  skos:definition "Ein durch zwei Mittelsäulen oder -pfeiler unterteiltes Fenster oder drei Fenster, die durch einen übergreifenden Bogen, Blendbogen oder Entlastungsbogen, zusammengeschlossen sind. D. kommen v. a. in Kreuzgängen der roman. und frühgot. Epoche vor. [Koepf / Binding 2016]"@de,
    "Rozdělené dvěma sloupky do tří otvorů. [Koch 2008]"@cs, "Selten gebrauchte Bezeichnung für ein Drillingsfenster. Die Gesamtfensteröffnung wird dabei durch zwei eingestellte Säulen in drei Rundbogenöffnungen unterteilt. Diese Form findet man vor allem in Profanbauten des 12. und 13. Jhs. B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_37522b74,
    :conceptScheme_1d7ba54b;
  skos:prefLabel "Drillingsfenster"@de, "sdružené potrojné okno"@cs;
  skos:altLabel "Triforiumfenster"@de, "Triforienfenster"@de;
  skos:broader :c_869fcd2d;
  dct:created "2020-08-05T09:47:12.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:11:07.000"^^xsd:dateTime .

