  skos:broader :c_0fb5a1c3;
  skos:related :c_d2b7a17b;
  dct:created "2020-05-26T19:00:44.000"^^xsd:dateTime;
  dct:modified "2021-01-23T16:24:10.000"^^xsd:dateTime .

:c_1d45568a a skos:Concept;
  skos:definition "Katholische Kirche f; präzis, römisch-katholische die unter des Leitung des Papstes als des Nachfolgers des Urapostels Petrus stehende Kirche. Vor allem die abendländische Kirche, bzw. Westkirche, nach ihrer Trennung von der Ostkirche (1054) und die kath. Kirche nach der Trennung von den prot. Kirchen im 16. Jh. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "Roman Catholic Church"@en, "Eglise catholique romaine"@fr, "Katholische Kirche"@de;
  skos:altLabel "römisch-katholische Kirche"@de;
  skos:broader :c_fe387ba0;
  skos:narrower :c_6b36b369;
  skos:related :c_d2b7a17b;
  dct:created "2020-06-05T12:07:00.000"^^xsd:dateTime;
  dct:modified "2021-01-15T16:16:22.000"^^xsd:dateTime .

:c_71f0541b a skos:Concept;
  skos:definition "Mantum n, lat.; auch Papstmantel m; lat. chlamys purpurea; cappa; pluviale; mantus pontificalis: vorne offener, roter Mantel, ähnlich dem Pluviale, aber weiter geschnitten als dieses und mit langer Schleppe. Das Mantum ist Zeichen päpstlicher Würde. Die Bekleidung des Papstes nach seiner Wahl mit dem Mantum, lat. immantatio, galt zwischen dem 11. und 14. Jh. als Sinnbild der Investitur. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "manteau papal"@fr, "papal mantle"@en, "Mantum"@de, "chlamys purpurea"@la;
  skos:altLabel "mantum"@fr, "mantum"@en, "Papstmantel"@de, "mantus pontificalis"@la;
  skos:broader :c_86c8b719, :c_aa790c5e;
  skos:related :c_d2b7a17b, :c_48f83942;
  dct:created "2020-06-18T10:37:14.000"^^xsd:dateTime;
  dct:modified "2021-01-23T13:43:29.000"^^xsd:dateTime .

:c_be6adc64 a skos:Concept;
  skos:definition "Papstkelch m: ein nur bei Papstmessen benutzter Kelch mit einem großen, kunstvoll gearbeiteten Deckel. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "calice papal"@fr, "papal chalice"@en, "Papstkelch"@de;
  skos:broader :c_06414fbb;
  skos:related :c_d2b7a17b;
  dct:created "2020-07-28T16:53:36.000"^^xsd:dateTime;
  dct:modified "2021-01-24T13:03:22.000"^^xsd:dateTime .

:c_aaf2a23b a skos:Concept;
  skos:definition "Stellula f (lat.): ein MetallgestelI aus zwölf radial angeordneten, nach unten gekrümmten Bügeln, die lanzettförmigen Blättern ähneln. Es stand auf der Patene und schützte die konsekrierte Hostie gegen die Berührung durch das Velum. Die Stellula wurde bei der Papstmesse gebraucht, wenn dem thronenden Papst die Hostie gereicht wurde. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "astérisque"@fr, "asterisk"@en, "Stellula"@de;
  skos:altLabel "étoile"@fr, "star"@en;
  skos:broader :c_ef163f2f;
  skos:related :c_b6b48d98, :c_d2b7a17b, :c_c22ee248, :c_ce128b66;
  dct:created "2020-08-07T12:54:50.000"^^xsd:dateTime;
  dct:modified "2021-01-13T13:53:48.000"^^xsd:dateTime .

:c_7715254c a skos:Concept;
  skos:definition "Kreuzstab m: ein langschäftiger, in einem Kreuz endender Stab aus Edelmetall, den der Papst bei allen Zeremonien trug, bei denen für Bischöfe der Bischofsstab vorgeschrieben war. Im Mittelalter hatte das Kreuz manchmal zwei oder drei Querbalken. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "bâton papal"@fr, "cross-staff"@en, "Kreuzstab"@de;
  skos:broader :c_6cc4cec2;
  skos:related :c_d2b7a17b, :c_aa790c5e;
  dct:created "2020-08-09T18:55:54.000"^^xsd:dateTime;
  dct:modified "2021-01-23T13:34:43.000"^^xsd:dateTime .

:c_b4fe9fec a skos:Concept;
  skos:definition "Papstring m; Pontifikalring m; lat. anulus pontificalis: ein kostbarer Ring, den der Papst beim Pontifiikalamt trägt, wenn für die Bischöfe der Bischofsring vorgeschrieben ist. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "anneau papal"@fr, "pontifical ring"@en, "Papstring"@de, "anulus pontificalis"@la;
  skos:altLabel "Pontifikalring"@de, "anneau pontifical"@fr;
  skos:broader :c_aa790c5e, :c_bd2f1d31;
  skos:related :c_d2b7a17b;
  dct:created "2020-08-10T17:12:17.000"^^xsd:dateTime;
  dct:modified "2021-01-23T13:58:49.000"^^xsd:dateTime .

:c_5270d2e2 a skos:Concept;
  skos:scopeNote "Intitulierter Kleriker, Geistlicher mit festem kirchlichen Amt. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
