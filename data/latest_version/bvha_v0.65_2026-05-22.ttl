    "pera"@la, "domus corporalis"@la, "capsa corporalis"@la;
  skos:broader :c_02fc3080;
  skos:narrower :c_a3e668d3;
  skos:related :c_ef40cc12, :c_30831661, :c_d1a705c6;
  dct:created "2020-04-09T15:43:39.000"^^xsd:dateTime;
  dct:modified "2021-01-24T17:32:48.000"^^xsd:dateTime .

