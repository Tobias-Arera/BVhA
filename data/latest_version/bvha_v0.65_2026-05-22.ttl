:c_25b71ee6 a skos:Concept;
  skos:definition "Zerfall aufgrund von inneren Eigenschaften eines Materials, wie die chemische Zusammensetzung und/oder die physikalischen Eigenschaften. [EwaGlos]"@de,
    "Deterioration due to internal properties of a material, such as chemical composition and/or physical properties. [EwaGlos]"@en;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_ec8c77bf;
  skos:prefLabel "materialimmanente Schadensursache"@de, "intrinsic cause of deterioration"@en;
  skos:broader :c_43ba4a89;
  skos:narrower :c_4fe9f074;
  dct:created "2019-07-05T21:40:07.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:02:41.000"^^xsd:dateTime .

:c_5bb04825 a skos:Concept;
  skos:definition "External factors, which may be natural or anthropogenic, bringing about deterioration. [EwaGlos]"@en,
    "Externe Faktoren, die natürlich oder anthropogen sein können, verursachen Zerfall. [EwaGlos]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_ec8c77bf;
  skos:prefLabel "äußere Schadensursache"@de, "extrinsic cause of deterioration"@en;
  skos:broader :c_43ba4a89;
  dct:created "2019-07-05T21:44:29.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:12:03.000"^^xsd:dateTime .

:c_c2d76511 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_ec8c77bf;
  skos:prefLabel "umweltbedingte Schädigung"@de, "environmental deterioration"@en;
  skos:note "Deterioration (or decay) triggered or exacerbated by climatic factors such as temperature and humidity extremes, and their fluctuations. [EwaGlos]"@en,
    "Schädigung (oder Zerfall) ausgelöst oder verschlimmert durch klimatische Faktoren wie Temperatur- und Feuchtigkeitsextreme und deren Wechsel. [EwaGlos]"@de;
  skos:broader :c_43ba4a89;
  skos:narrower :c_rhrrwb0h;
  dct:created "2019-07-05T22:19:38.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:00:54.000"^^xsd:dateTime .

:c_63d87b7c a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_ec8c77bf;
  skos:prefLabel "vom Menschen verursachte Schädigung"@de, "anthropically induced deterioration"@en;
  skos:note "Usually damage caused by deliberate or unintentional human acts. [EwaGlos]"@en,
    "Üblicherweise Schädigungen durch vorsätzliche oder unbeabsichtigte menschliche Handlungen. [EwaGlos]"@de;
  skos:broader :c_43ba4a89;
  skos:narrower :c_edc95f19, :c_34310334, :c_74de7a96, :c_bbae6a9b, :c_rhrrwb0h;
  dct:created "2019-07-06T19:02:18.000"^^xsd:dateTime;
  dct:modified "2021-01-15T18:00:40.000"^^xsd:dateTime .

