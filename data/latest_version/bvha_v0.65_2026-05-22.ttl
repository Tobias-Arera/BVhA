:c_7e975dfa a skos:Concept;
  skos:definition "Bei der gestemmten Füllungstür die Rahmenhölzer, die man in Längsfries, Querfries und Mittelfries unterteilen kann. [Schrader / Voigt 2003]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_5bf6bcac;
