:c_af6fd357 a skos:Concept;
  skos:definition "Der Kriegsgrabstein ist ein liegend (horizontal) ausgerichteter Grabstein, der seine Inschrift nach oben trägt. Er überdeckt dabei nur das Kopfende bzw. nur einen kleinen Teil der Grabstelle. Kriegsgrabsteine sind eine Sonderform des → Kissensteins, die in sehr ähnlicher Form, Materialität und Ausprägung serienmäßig durch die Kriegsgräberführsorge gestellt werden. [BVHA]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_4fbab46c,
    :conceptScheme_3b8d7ed1;
  skos:prefLabel "Kriegsgrabstein"@de;
