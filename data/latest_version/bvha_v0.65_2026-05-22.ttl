:c_6564e064 a skos:Concept;
  skos:definition "Balkenkopf, das in oder auf einer Wand liegende oder über diese hinausragende Ende eines Balkens. Beim Fachwerkbau ist der sichtbare B. meist durch Profilierung, Schnitzerei und Bemalung verziert, vielfach auch konsolenartig ausgebildet. Eine Erinnerung an den B. des Holzbaus sind die Triglyphe und der Zahnschnitt an gr. Tempeln der Dorischen und der kleinasiat. Ionischen Ordnung. Sind B.e verschalt, so entsteht ein Balkengesims. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Balkenkopf (Fachwerk)"@de;
  skos:broader :c_174d6ba6;
  dct:created "2020-08-03T13:48:54.000"^^xsd:dateTime;
  dct:modified "2021-01-22T19:47:20.000"^^xsd:dateTime .

:c_6e1fa7a5 a skos:Concept;
  skos:definition "Ausfachung, Verschluss der einzelnen Gefache der Fachwerkwand durch Holzbohlen, Staken mit Lehm und Lehmbewurf (Ausstakung), Backsteine oder Bruchsteine. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Ausfachung"@de;
  skos:broader :c_174d6ba6;
  dct:created "2020-08-25T11:23:34.000"^^xsd:dateTime;
  dct:modified "2021-01-22T19:46:55.000"^^xsd:dateTime .

:c_40fc6bc5 a skos:Concept;
  skos:definition "Ausstakung, Verschluss der Gefache im Fachwerkbau, in dem zwischen die Horizontalhölzer des Gerüsts Stöcke (Staken) in Nuten eingesetzt werden, um die Weidenruten (Fachgerten) oder Strohseile gewunden und mit strohvermengtem Lehm verkleidet werden. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Ausstakung"@de;
  skos:broader :c_174d6ba6;
  dct:created "2020-08-25T11:53:02.000"^^xsd:dateTime;
  dct:modified "2021-01-22T19:47:07.000"^^xsd:dateTime .

:c_5ea86092 a skos:Concept;
  skos:definition "Brustriegel, im Fachwerkbau Riegel in Brüstungshöhe, der bes. als untere Begrenzung eines Fensters dient. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
