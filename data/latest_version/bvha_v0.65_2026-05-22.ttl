  dct:created "2020-09-29T16:21:52.000"^^xsd:dateTime;
  dct:modified "2021-01-30T22:56:00.000"^^xsd:dateTime .

:c_9410786c a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe;
  skos:prefLabel "Plastik"@de;
  skos:broader :c_90bb4120;
