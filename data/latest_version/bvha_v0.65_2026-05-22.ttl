:c_72986600 a skos:Concept;
  skos:definition "Mudejar (aus arab. mudaggin = wohnen bleiben [der Araber unter den Christen]), spanischer Dekorationsstil aus maurischen, gotischen und (später) Renaissanceformen. [Koch 2009]"@de,
    "Z arab. mudaggin = zůstat bydlet, Arabové mezi křesťany. Styl španělského dekoru z maurských, gotických a později renesančních prvků. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9;
  skos:prefLabel "Mudéjar"@de, "mudejárský sloh"@cs;
  skos:hiddenLabel "Mudejar"@de;
