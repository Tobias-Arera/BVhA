  dct:created "2020-07-23T16:39:46.000"^^xsd:dateTime;
  dct:modified "2021-01-15T17:40:47.000"^^xsd:dateTime .

:c_d9d23396 a skos:Concept;
  skos:scopeNote "Aspergill n; Weih(wasser)wedel m; auch Aspergorium n; Sprengwedel m; Weihquast m; lat. aspergillum; aspergorium: ein Stab, der an seinem vorderen Ende mit Borsten besetzt ist oder einen kleinen, perforierten Behälter mit Schwamm, gelegentlich auch ein Blätterbüschel (Ysopbüschel) trägt. Er dient dazu, das Weihwasser zu versprengen. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "aspergillum"@en, "Aspergill"@de, "aspergil"@cs, "aspersoir"@fr, "aspergillum"@la;
