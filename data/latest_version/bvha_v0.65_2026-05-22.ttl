:c_5e0c038f a skos:Concept;
  skos:definition "Dachlatte, Ziegellatte; auf die Dachsparren waagerecht aufgenagelte, schmale Vierkanthölzer, die die Dachziegel tragen. [Koepf / Binding 2016]"@de,
    "Dachlatte: auf den Sparren oder Rofen waagrecht befestigte schmale Hölzer, die als Träger für die Dachdeckung dienen.  (Eißing et al. 2012) "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "latte de toiture"@fr, "střešní lať"@cs, "listello del tetto"@it, "roof lath "@en,
    "listón de tejado"@es, "Dachlatte"@de;
  skos:broader :c_a9967019, :c_30ae2d69;
