:c_9587110f a skos:Concept;
  skos:definition "Fistula f (lat.); auch eucharistisches Saugröhrchen n; lat. pipa; pugillaris ; calamus; arundo: ein Röhrchen aus Edelmetall, auch aus Elfenbein oder Glas, meist mit einem Griff, das bei der Kelchkommunion verwendet wurde (7.-1 5. Jh.), um ein Verschütten des Messweines zu verhindern. Besonders kunstvoll ausgeführt ist die beim päpstlichen PontifikaIamt auch weiterhin verwendete Fistula. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "fistula"@fr, "fistula"@en, "Fistula"@de, "pipa"@la;
  skos:altLabel "chalumeau"@fr, "eucharistic cannula"@en, "eucharistic reed"@en, "eucharistisches Saugröhrchen"@de,
    "pugillaris"@la, "calamus"@la, "arunda"@la;
  skos:broader :c_af38f5d3;
  skos:related :c_ee7464eb;
  dct:created "2020-07-25T16:47:47.000"^^xsd:dateTime;
  dct:modified "2021-01-24T15:00:28.000"^^xsd:dateTime .

:c_ee7464eb a skos:Concept;
  skos:definition "Meßwein m; Abendmahlswein m; lat. sanguis dominicus; vinum Eucharisticum: das Symbol des Blutes Christi; unverfälschter Wein (vinum de vita), vom Priester in der Messe geweiht und im eucharistischen Kelch gereicht. In den Westkirchen wird weißer, in den Ostkirchen roter Wein bevorzugt. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "vin du Saint-Sacrement"@fr, "wine of the Blessed Sacrament "@en, "Messwein"@de,
    "sanguis dominicus"@la;
  skos:altLabel "vin eucharistique"@fr, "vin consacré"@fr, "vin de la messe"@fr, "consecrated wine"@en,
    "Abendmahlswein"@de, "vinum Eucharisticum"@la;
  skos:broader :c_73657b6d;
  skos:related :c_9587110f, :c_c95b4c24, :c_95448ae3;
  dct:created "2020-07-22T18:01:14.000"^^xsd:dateTime;
  dct:modified "2021-01-15T17:36:01.000"^^xsd:dateTime .

:c_67faa0fb a skos:Concept;
  skos:definition "Reliquienpyxis f; Büchsenreliquiar n; auch Pyxisreliquiar n; Reliquienbüchse f ; gr. pyxis ; lat. capsa, busta: eine runde oder eckige Dose zur Aufnahme von Reliquien. Die ältesten Reliquienpyxiden stammen aus Altargräbern des 4. Jh. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "pyxide-reliquaire"@fr, "pyx-reliquary"@en, "Reliquienpyxis"@de;
  skos:altLabel "Büchsenreliquiar"@de, "Pyxisreliquiar"@de, "Reliquienbüchse"@de, "boîte-reliquaire"@fr;
  skos:broader :c_b9eb688f;
  skos:related :c_14a349f2;
  dct:created "2020-08-07T09:33:21.000"^^xsd:dateTime;
  dct:modified "2020-09-23T19:46:16.000"^^xsd:dateTime .

:c_b9afb0f1 a skos:Concept;
  skos:definition "Zange f, eucharistische; lat. forcipes; furcheta; tenacula: eine silberne oder goldene Zange, mit der früher die Hostien an die Gläubigen ausgeteilt wurden, besonders an Kranke. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
