:c_54973614 a skos:Concept;
  skos:definition "Belfried (frz. Beffroi), hoher, schlanker Rathausturm, eingebaut oder freistehend in spätma. Städten Flanderns und Nordwestfrankreichs; er verkörpert die Macht der bürgerl. Selbstverwaltung. Fälschl. wird auch der Bergfried ma. Burgen B. genannt. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_c8a571d9;
  skos:prefLabel "Belfried"@de, "zvonice  "@cs;
  skos:broader :c_b4270b3f;
  dct:created "2020-08-28T10:51:11.000"^^xsd:dateTime;
  dct:modified "2021-01-27T00:17:14.000"^^xsd:dateTime .

:c_ab4cd457 a skos:Concept;
  skos:definition "Betsäule, Bildstock; im Freien, bes. an öffentl. Wegen errichtetes religiöses Wahrzeichen, meist in Form einer Säule oder eines Pfeilers mit einem religiösen Bildwerk in einer Nische, einem tabernakelähnl. Aufbau oder als Bekrönung. Steinerne B.n, in got. Zeit oft mit architekton. Zierrat, finden sich neben solchen aus Holz hauptsächl. in Franken, Schwaben und in den Alpenländern. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6;
  skos:prefLabel "Betsäule"@de;
  skos:broader :c_741a92a7;
  dct:created "2020-08-28T10:55:12.000"^^xsd:dateTime;
  dct:modified "2021-01-30T23:16:19.000"^^xsd:dateTime .

:c_bafb028b a skos:Concept;
  skos:definition "Armierung, die Bewehrung des Stahlbetons durch Eiseneinlagen nach stat. Berechnung. [Koepf / Binding 2016]"@de,
    "Bewehrung, die Armierung des Stahlbetons durch Eiseneinlagen. Man unterscheidet sog. schlaffe B. beim normal auf Biegung beanspruchten Stahlbeton, vorgespannte B. beim Spannbeton und Druckb. bei Stützen. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6;
  skos:prefLabel "Bewehrung"@de, "zesílení"@cs;
  skos:altLabel "Armierung"@de;
  skos:broader :c_07c0fe51;
  dct:created "2020-08-28T10:59:11.000"^^xsd:dateTime;
  dct:modified "2021-01-22T17:22:31.000"^^xsd:dateTime .

