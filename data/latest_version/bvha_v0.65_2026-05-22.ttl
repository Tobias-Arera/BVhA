:c_449295d4 a skos:Concept;
  skos:definition "Bildnerei, seit den Anfängen der Geschichte vorhandene körperbildende Kunst. Formen: Vollplastik und Relief (Bauplastik). Materialien: Bronze, Stein, Holz, Ton, Elfenbein, Wachs, Edelmetalle, Kunststoffe u. a. [Koch 2009]"@de,
    "Umění vytvářející od počátku dějin hmotná, trojrozměrná díla. Druhy: plná plastika a reliéf (viz architektonická plastika). Materiály: bronz, kámen, dřevo, hlína, slonovina, vosk, ušlechtilé kovy, plastické hmoty aj. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9;
  skos:prefLabel "sochařství"@cs, "Bildhauerkunst"@de;
  skos:broader :c_1d49f89c;
  dct:created "2020-08-03T15:24:58.000"^^xsd:dateTime;
  dct:modified "2021-01-15T15:59:39.000"^^xsd:dateTime .

