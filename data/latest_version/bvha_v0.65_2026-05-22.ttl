:c_76b8ad5e a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "runder Dreipassbogen"@de, "kruhový trojlistový oblouk"@cs;
  skos:broader :c_a0d94028;
