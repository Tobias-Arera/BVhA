:c_d2b38caf a skos:Concept;
  skos:definition "Blendarkade, Blendarkatur, als Gliederung einer Wandfläche aufgelegte Arkade ohne Zwischenraum zwischen Arkade und Wand, bes. in roman. und got. Zeit angewandt. [Koepf / Binding 2016]"@de,
    "SLEPÁ ARKÁDA, (též lichá), stěnu neotvírá, pouze ji dekorativně člení. [Koch 2008]"@cs,
    "Einer Mauerfläche direkt aufgelegte Bogenstellung ohne dahinterliegenden Gang. [Glossarium Artis]"@de,
    """Reihe von durch Säulen oder Pfeiler getragenen Bögen (Arkade), die einer Wand als Gliederung direkt aufgelegt sind. In der Wehrarchitektur werden konstruktiv ausgebildete B.n häufig als Subkonstruktionen eingesetzt. Die vor die Innenseite von Stadt- oder Ringmauern gelegten Strebepfeiler werden durch Rundbögen verbunden, wie an der im 14. Jh. entstandenen Nürnberger Stadtmauer BY noch zu sehen. Diese B. trägt den Wehrgang. Im Schlossbau können B.n auch schmale Gebäude tragen. Am Schloss Chambord F, beg. 1519, erheben sich die Seitenflügel über B.n. 	B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen]"""@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_37522b74, :conceptScheme_1f14b4dd, :conceptScheme_1d7ba54b;
  skos:prefLabel "arcade aveugle"@fr, "slepá arkáda"@cs, "blind arcade"@en, "arcata cieca"@it,
    "arcada ciega"@es, "Blendarkade"@de;
  skos:altLabel "arcade engagée"@fr, "arcade simulée"@fr, "lichá arkáda"@cs, "surface arcade"@en,
    "arcata finta"@it, "arcada simulada"@es, "Wandarkade"@de, "Blendarkatur"@de;
  skos:broader :c_b38a6b54, :c_804ab319;
  skos:narrower :c_76706966;
  skos:related :c_0596a3fc;
  dct:created "2019-10-21T18:05:07.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:03:36.000"^^xsd:dateTime .

:c_0596a3fc a skos:Concept;
  skos:definition "Eine Mischform von echter Arkade und Blendarkade; es kann sich um eine in nur sehr geringem Abstand vor eine Mauer gesetzte Bogenstellung handeln oder auch um die Nachbildung einer echten Arkade ohne voll ausgebildete Stützen, etwa unter Verwendung von Blendbogen mit hängendem Bogenanfall. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "pseudo-arcade"@en, "pseudo-arcade"@fr, "Scheinarkade"@de;
  skos:broader :c_b38a6b54;
  skos:related :c_d2b38caf;
  dct:created "2019-10-22T10:08:01.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:06:24.000"^^xsd:dateTime .

:c_f9ab680c a skos:Concept;
  skos:definition "An der Ecke eines Bauwerkes liegende bzw. um die Ecke herumführende Arkade. Beispiel: die Marktbasilika in Vicenza. [Glossarium Artis]"@de;
