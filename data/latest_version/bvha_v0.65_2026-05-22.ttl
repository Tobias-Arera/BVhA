:c_da43c970 a skos:Concept;
  skos:definition "Henkelkreuz n; ägyptisches Kreuz n; auch N ilschlüssel n; lat. crux ansata: ein Tau-Kreuz, bekrönt von einem runden oder ovalen \"Henkel\" als Symbol für die Sonne. Es entspricht dem ägyptischen Zeichen ankh (in der ΗierogIyphenschrift = Leben), das auf Darstellungen ägyptischer Gottheiten erscheint. Das Henkelkreuz ist bei den Kopten bekannt, auch im Frühchristentum und bei den Byzantinern. [Glossarium Artis]"@de,
    "Závěsný kříž (crux ansata), původně egyptský symbol života. [Koch 2008]"@cs;
  skos:scopeNote "Henkel-Kreuz (crux ansata), ursprünglich ägyptisches Lebenssymbol.[Koch 2009] "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9, :conceptScheme_1f14b4dd;
  skos:prefLabel "Henkelkreuz"@de, "závěsný kříž"@cs, "croix ansée"@fr, "crux ansata"@la,
    "ankh"@en;
  skos:altLabel "ägyptisches Kreuz"@de, "Nilschlüssel"@de, "handled cross"@en;
  skos:broader :c_46483b7b;
  skos:related :c_f2667fe2;
  dct:created "2019-09-11T12:29:35.000"^^xsd:dateTime;
  dct:modified "2021-01-26T11:30:07.000"^^xsd:dateTime .

