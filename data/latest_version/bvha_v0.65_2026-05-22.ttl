  dct:modified "2021-01-30T23:27:30.000"^^xsd:dateTime .

:c_9ecfe12c a skos:Concept;
  skos:definition "Künstlerische Gestaltung von Geräten oder Schmuck aus Gold, Silber, Platin, auch in Verbindung mit Email und Edelsteinen. Techniken: 1. Guss (selten) wie Bronze; 2. Treiben oder Hämmern (Treibarbeit, Toreutik): eine dünne Platte aus dehnbarem zähem Metall wird von der Rückseite her mit dem Treibhammer kalt bearbeitet; 3. die Oberfläche wird gern mit Feile Meißel, Stichel, Punze und Stempel durch Gravieren (eingraben) und Ziselieren (Treibarbeit von der Außen- zur Innenseite) verziert. Granulieren heißt das Auflöten von feinen Goldkörnchen. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_8c0441f9,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "opus aureum"@la, "Goldschmiedehandwerk"@de;
  skos:altLabel "Goldschmiedearbeit"@de, "opus ex auro probato"@la, "opus fabrefactum"@la,
    "Goldschmiedekunst"@de;
  skos:broader :c_d44a416f;
  skos:narrower :c_609c0173, :c_edd179a7, :c_ca9ef698;
  dct:created "2020-08-05T10:04:45.000"^^xsd:dateTime;
  dct:modified "2021-01-18T14:13:40.000"^^xsd:dateTime .

:c_609c0173 a skos:Concept;
  skos:definition "Filigran (]at. filum = Faden, granum = Korn), seit 2000 v. Chr. aus Troja bekannte Goldschmiedetechnik. Glatte, gekörnte oder gezwirnte Drähte aus Gold oder Silber werden in Ziermustern auf einen mit Gold- oder Silberkörnchen bedeckten Metallgrund gelötet. In neuerer Zeit gern ohne Unterlage zu einem feinen, durchbrochenen Gespinst geflochten und nur an den Berührungspunkten gelötet. [Koch 2009]"@de,
    "Lat. filum = nit, granum = zrno. Zlatnická technika známá již roku 2000 př. Kr. v Tróji; hladké, drsné nebo splétané drátky ze zlata nebo stříbra se letují v ozdobných vzorech na kovový podklad pokrytý zrníčky zlata nebo stříbra, v novější době většinou bez podkladu propletené do jemného přediva a sletované pouze na místech styku. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_37522b74,
    :conceptScheme_8c0441f9, :conceptScheme_1f14b4dd;
  skos:prefLabel "filigrán"@cs, "Filigran"@de, "opus veneticum ad filum"@la;
  skos:altLabel "Filigranarbeit"@de;
  skos:broader :c_9ecfe12c;
  dct:created "2020-08-05T10:05:10.000"^^xsd:dateTime;
  dct:modified "2021-01-18T14:13:49.000"^^xsd:dateTime .

