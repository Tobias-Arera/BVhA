:c_4850c487 a skos:Concept;
  skos:definition "Buleuterion, (gr. bouleuterion), das Rathaus der gr. Stadt, im Unterschied zum Sitz der städt. Beamten (Prytaneion) der Ort für die Vollversammlungen des Rats (Bule), meist in der Nähe des Marktes (Agora) gelegen. In hellenist. Zeit bestand das B. aus einem Vorhof, den man durch einen Torbau (Propylon) betrat, und dem eigentl. Rathaus, das im Innern halbkreisförmig ansteigende Sitzstufen wie im Theater (jedoch ohne Bühne), manchmal auch in U-förmiger Anordnung, besaß. Außen häufig durch Halbsäulen oder Pfeiler gegliedert, hoch liegende Fenster. [Koepf / Binding 2016]"@de,
    "Místo pro městská shromáždění, radnice v období řecké a helénistické antiky. [Koch 2008]"@cs,
    "Buleuterion, Bouleuterion (griech. bule = Rat), städtischer Versammlungsraum, Rathaus der griechischen und hellenistischen Antike. [Koch 2009]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_c8a571d9, :conceptScheme_37522b74, :conceptScheme_8c0441f9;
  skos:prefLabel "Buleuterion"@de, "buleuterion"@cs;
  skos:broader :c_a9fbb4e9;
  skos:related :c_a9fbb4e9;
  dct:created "2020-08-03T16:24:39.000"^^xsd:dateTime;
  dct:modified "2021-01-26T23:51:18.000"^^xsd:dateTime .

