  dct:modified "2021-01-15T16:52:26.000"^^xsd:dateTime .

:c_fac70203 a skos:Concept;
  skos:definition "Myrrhe f: ein Harz aus nordafrikanischen Bäumen, das bei der Glockenweihe als Räuchermittel verbrannt wird (seit 11. Jh.). [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_1f14b4dd;
  skos:prefLabel "myrrhe"@fr, "myrrh"@en, "Myrrhe"@de;
