  dct:created "2019-05-07T18:01:10.000"^^xsd:dateTime;
  dct:modified "2021-01-25T15:52:57.000"^^xsd:dateTime .

:c_d69ae75a a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_ec8c77bf;
  skos:prefLabel "levelling coat"@en, "vyrovnávací omítka"@cs, "Ausgleichsputz"@de;
  skos:altLabel "floating coat"@en, "coarse rendering"@en;
  skos:note "A single or multi-layered coat for architectural surfaces to compensate for irregularities in the masonry. [EwaGlos]"@en,
    "Eine einlagige oder mehrlagige Putzschicht für Architekturoberflächen zur Egalisierung von Unebenheiten im Mauerwerk. [EwaGlos]"@de;
  skos:broader :c_wdriolje;
  dct:created "2019-05-07T18:01:29.000"^^xsd:dateTime;
  dct:modified "2021-01-25T15:51:24.000"^^xsd:dateTime .

