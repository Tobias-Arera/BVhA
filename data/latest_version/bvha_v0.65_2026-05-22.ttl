  skos:prefLabel "Latin cross"@en, "latinský kříž"@cs, "Lateinisches Kreuz"@de, "croix latine"@fr,
    "cruz latina"@es, "crux immissa"@la, "croce latina"@it;
  skos:altLabel "crux capitata oblonga"@la, "Hochkreuz"@de, "Passionskreuz"@de, "stehendes Kreuz"@de;
  skos:broader :c_46483b7b;
  dct:created "2019-09-11T12:27:46.000"^^xsd:dateTime;
  dct:modified "2021-01-13T14:34:40.000"^^xsd:dateTime .

:c_81b2577d a skos:Concept;
  skos:definition "Andreaskreuz, Kreuz mit schräg gestellten Balken, benannt nach dem Apostel Andreas, der an ein solches Kreuz genagelt worden sein soll. Die Form des A.es befindet sich bes. beim Fachwerk als x-förmige Balkenverstrebung und zur Zierde. [Koepf / Binding 2016] "@de,
    "Ondřejský kříž, byl na něm ukřižován apoštol Ondřej. [Koch 2008]"@cs;
  skos:scopeNote "So wurde der Apostel Andreas gekreuzigt. [Koch 2009] "@de;
