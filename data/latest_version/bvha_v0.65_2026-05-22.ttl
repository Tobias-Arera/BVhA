:c_060e3028 a skos:Concept;
  skos:definition "Weihegrade m pl; Weihestufen f pl; lat. ordines: durch die Ordination vollzogene hierarchische Ordnung aller Kleriker der kath. Kirche bis hinauf zum Papst als dem Patriarchen des Abendlandes und souveränen Pontifex der Weltkirche. Man unterscheidet niedere und höhere Weihen. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_1f14b4dd;
  skos:prefLabel "ordres "@fr, "order"@en, "Weihegrad"@de, "ordines"@la;
