:c_1fb83d0f a skos:Concept;
  skos:definition "Eine Reihe schräg liegender Backsteine bei gewissen Mauer- oder Gewölbeverbänden. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_84fc24e6;
