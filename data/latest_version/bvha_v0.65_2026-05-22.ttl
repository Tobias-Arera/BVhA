:c_0da8a3da a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_37522b74, :conceptScheme_8c0441f9, :conceptScheme_1f14b4dd, :conceptScheme_ef0a8695,
    :conceptScheme_ec8c77bf;
  skos:prefLabel "estuco"@es, "stucco"@en, "štuk"@cs, "Stuck"@de, "stuc"@fr, "opus album"@la,
    "stucco"@it;
  skos:altLabel "parget"@en, "yeso de estucar"@es, "opus coronarium"@la, "štuková omítka "@cs,
    "tenkovrtstvá omítka"@cs;
  skos:note "The plastic moulding of all kinds of mortars on architectural surfaces for decorative purposes. [EwaGlos]"@en,
    "Schnell härtendes Gemisch aus Leimwasser und Gips, oft mit Zusätzen von Kalk oder Marmor etc. zum halbplastischen Verzieren von Decken und Wänden. [Glossarium Artis, Bd. 3, Bögen und Mauerwerk] "@de,
    "Stuck ist die plastische Ausformung von Mörteln aller Art auf Architekturoberflächen. [EwaGlos]"@de,
    "Stuck, ein mit Leimwasser angemachter Gipsmörtel. Je nach den Zusätzen (Kalk, Marmor) unterscheidet man Gipss., Weißs., S.marmor (Stucco lustro), Kalks., Zements. und Graus. S. ist nicht wetterfest (Gips!) und wird daher meist in Innenräumen verwendet. Seiner spezif. Eigenschaften wegen wird er bes. zur Herstellung frei aufgetragener Dekorationen, zum Ziehen von Profilen mit Schablone oder für geschliffenen und polierten Wandputz verwendet. [Koepf / Binding 2016]"@de,
    "Gemisch aus Gips, Kalk und Sand, gut formbar, aber schnell erhärtend, wird für Plastiken und plastische Wanddekoration verwendet. [Koch 2009]"@de,
    "Směs sádry, vápna a písku, dobře tvarovatelná, ale rychle tvrdnoucí, používá se pro plastiky a plastické dekorace stěn. [Koch 2008]"@cs;
  skos:broader :c_a1b21914, :c_jqmv6iaq;
  skos:narrower :c_f66e21eb, :c_5a138dc5;
  skos:related :c_pjvitn4h;
  dct:created "2019-07-15T09:05:54.000"^^xsd:dateTime;
  dct:modified "2021-01-30T15:07:55.000"^^xsd:dateTime .

:c_58a24ed4 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_84fc24e6, :conceptScheme_315cf028,
    :conceptScheme_ef0a8695, :conceptScheme_ec8c77bf;
  skos:prefLabel "Bindemittel"@de, "binder"@en;
  skos:altLabel "Binder"@de, "Medium"@de;
  skos:note "Material with adhesive and cohesive properties, which coats all particles of a filler or pigment and builds a coherent mass. [EwaGlos]"@en,
    "Material mit adhäsiven und kohäsiven Eigenschaften, das alle Partikel eines Füllstoffes oder Pigmentes benetzt und eine zusammenhängende Masse bildet. [EwaGlos]"@de,
    "Bindemittel, im Bauwesen pulverförmige mineral. Stoffe (Zement, Kalk, Gips) zur dauerhaften Verbindung von Baumaterialien, die, mit einer Flüssigkeit, zumeist Wasser, zu Mörtel angemacht, aufgrund chem. Vorgänge erhärten: hydraul. B. erhärten auch unter Wasser, während nichthydraul. B. nur an der Luft erhärten und auch keine wasserbeständigen Verbindungen bilden. [Koepf / Binding 2016]"@de;
  skos:broader :c_4mgalztg, :c_9jb9am2u, :c_39442c35;
  skos:narrower :c_4f3228a9, :c_bbe43d47;
  skos:related :c_pjvitn4h;
  dct:created "2019-05-15T17:44:07.000"^^xsd:dateTime;
  dct:modified "2025-11-04T22:40:39"^^xsd:dateTime .

:c_d0f56cb6 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ec8c77bf;
  skos:prefLabel "aggregate"@en, "ostřivo"@cs, "Zuschlag"@de;
  skos:altLabel "Zuschlagstoff"@de, "Magerungsmittel"@de, "Magerstoff"@de;
  skos:note "Granular, inert, hard material used together with a binding (or adhesive) material to give specific physical properties to concrete, mortar or plaster. [EwaGlos]"@en,
    "Körniges, inertes, hartes Material, das zusammen mit einem Bindemittel (oder Klebemittel) dazu benutzt wird, Beton, Mörtel oder Putz bestimmte physikalische Eigenschaften zu verleihen. [EwaGlos]"@de;
  skos:broader :c_4mgalztg;
  skos:narrower :c_18c8a9dc, :c_7f5c1093, :c_35ef5894, :c_9fdadf31, :c_f7274108, :c_11ec36ef,
    :c_f8e7242f, :c_2fceb100, :c_70779b43;
  skos:related :c_pjvitn4h;
  dct:created "2019-05-22T18:00:18.000"^^xsd:dateTime;
  dct:modified "2020-08-24T16:13:47.000"^^xsd:dateTime .

:c_a60695bc a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ef0a8695, :conceptScheme_ec8c77bf;
  skos:prefLabel "Zusatzmittel"@de, "additive"@en;
  skos:altLabel "Hilfsmittel"@de, "Additiv"@de;
  skos:note "Any organic or inorganic substance (or material) used in a very small quantity and mixed with paint, plaster, mortar or cement as an accelerator, plasticiser, stabiliser, fluidiser or retarder. [EwaGlos]"@en,
    "Organische oder anorganische Substanz, die in sehr kleinen Mengen als Beschleuniger, Weichmacher, Stabilisator, Fließmittel oder Verzögerer zu Farben, Putz, Mörtel oder Zement zugemischt wird. [EwaGlos]"@de;
  skos:broader :c_4mgalztg;
  skos:related :c_pjvitn4h;
  dct:created "2019-06-11T20:08:50.000"^^xsd:dateTime;
  dct:modified "2021-01-30T15:31:27.000"^^xsd:dateTime .

:c_2ff48823 a skos:Concept;
  skos:definition "Fugenschnitt, geometr. bzw. stereometr. Ausmittlung der Wölb-, Kopf-, Lager und Stoßflächen von Werksteinen, v. a. bei Bogen (Bogenquaderung) und Gewölbe. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe;
  skos:prefLabel "stéréotomie"@fr, "kamenořez"@cs, "stone cutting"@en, "lotomia"@it,
    "corte de piedras"@es, "Steinschnitt"@de;
  skos:altLabel "coupe de pierres"@fr, "taille de pierres"@fr;
  skos:broader :c_24f6ab7f;
  skos:narrower :c_0892a7ba;
  dct:created "2020-02-18T16:15:41.000"^^xsd:dateTime;
  dct:modified "2021-01-22T15:59:48.000"^^xsd:dateTime .

:c_bdd4cc1c a skos:Concept;
  skos:definition "Gussmauerwerk; auch Brockenverband; lat. opus implectum; opus caementicium; opus fusile: Mauerwerk, bei dem zwischen zwei im Steinverband ausgeführten Mauerschalen ein durch Mörtelguss zusammengehaltenes Gemenge unregelmäßiger Steine oder Steinbrocken, der sogenannte Gussbruch m, eingebracht wird. Die Ecken beim Gussmauerwerk sind gemauert. (Glossarium Artis, Bd. 3, Bögen und Mauerwerk)"@de,
    "Mauerwerk, das zwischen Schalungen gegossen wird oder bei größeren Mauerstücken durch Ausgießen des Zwischenraumes zweier gemauerter Wände entsteht. Die G.technik (opus incertum) war bereits den Römern bekannt und wurde ebenso wie das Gussgewölbe häufig ausgeführt. Die Gussmasse war ein mit Steinbrocken durchmischter Mörtel, der als Vorläufer des modernen Betons gelten kann. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "Gussmauerwerk"@de;
  skos:broader :c_a832bfbe;
  dct:created "2019-04-10T15:25:54.000"^^xsd:dateTime;
  dct:modified "2020-09-30T09:24:56.000"^^xsd:dateTime .

:c_a832bfbe a skos:Concept;
  skos:definition "Mauerwerk, bei dem nur die Außenseiten im Steinverband (zweihäuptig) ausgeführt sind. Das Innere ist mit lose geschichteten, unregelmäßigen Steinen, mit Schotter, Kies oder Asche etc. ausgefüllt. (Glossarium Artis, Bd. 3, Bögen und Mauerwerk)"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "zweischaliges Mauerwerk"@de, "dvouplášťové zdivo"@cs;
  skos:broader :c_k1vkpmvw;
  skos:narrower :c_bdd4cc1c, :c_ada19998, :c_bcuwbmo1;
  dct:created "2019-05-06T17:26:17.000"^^xsd:dateTime;
  dct:modified "2020-08-17T10:42:12.000"^^xsd:dateTime;
  :broaderByConstruction :c_k1vkpmvw .

:c_ada19998 a skos:Concept;
  skos:definition "Zweischalige Mauer mit einem inneren Hohlraum, dessen Luftschicht wärme- und feuchtigkeitsisolierend wirkt; zur Verbesserung der Isolierung werden neuerdings Dämmstoffe eingebracht. (Glossarium Artis, Bd. 3, Bögen und Mauerwerk)"@de,
    "Mauerwerk mit Hohlräumen im Gegensatz zum Vollmauerwerk. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "Hohlmauerwerk"@de;
  skos:broader :c_a832bfbe;
  dct:created "2019-04-10T15:28:01.000"^^xsd:dateTime;
  dct:modified "2020-09-30T11:34:26.000"^^xsd:dateTime .

:c_1408fe35 a skos:Concept;
  skos:definition "Lehmmauerwerk n: aus Lehm errichtetes Mauerwerk, namentlich bei frühen Bauten (9./10. Jh.) und bei Fundamentmauern. Aus gestampften Lehm- und Erdmassen bestehendes Mauerwerk, das besonders bei landwirtschaftlichen Bauten vorkommt, heißt Pisebau m. (Glossarium Artis, Bd. 3, Bögen und Mauerwerk)"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "Lehmmauerwerk"@de;
  skos:broader :c_k1vkpmvw;
  dct:created "2019-04-10T15:29:14.000"^^xsd:dateTime;
  dct:modified "2020-06-30T12:35:28.000"^^xsd:dateTime;
  :broaderByConstructionMaterial :c_k1vkpmvw .

:c_b3f740e6 a skos:Concept;
  skos:definition "Mauerwerk aus unterschiedlichen Steinen, sei es in der Ansichtsfläche, sei es in der Tiefe der Mauer. Der Wechsel kann in der Farbe oder im Material erfolgen, auch formal innerhalb einer Schicht oder zwischen den verschiedenen Schichten, z. B. wechselnde Quader- und Backsteinlagen. (Glossarium Artis, Bd. 3, Bögen und Mauerwerk)"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "Mischmauerwerk"@de;
  skos:broader :c_k1vkpmvw;
  dct:created "2019-04-10T15:33:13.000"^^xsd:dateTime;
  dct:modified "2020-06-30T12:37:11.000"^^xsd:dateTime;
  :broaderByConstructionMaterial :c_k1vkpmvw .

:c_d26a4890 a skos:Concept;
  skos:scopeNote "Mauerwerk,  bei dem  Mörtel zum Versatz verwendet wird"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe;
  skos:prefLabel "Mörtelmauerwerk"@de;
  skos:broader :c_k1vkpmvw;
  dct:created "2019-04-10T15:38:59.000"^^xsd:dateTime;
  dct:modified "2019-12-04T12:28:31.000"^^xsd:dateTime;
  :broaderByConstruction :c_k1vkpmvw .

:c_831298e5 a skos:Concept;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe;
  skos:prefLabel "Polsterquadermauerwerk"@de, "zdivo z kvádru s polštářovou bosou"@cs;
  skos:broader :c_1514fd0f;
  dct:created "2019-04-10T15:43:03.000"^^xsd:dateTime;
  dct:modified "2020-08-18T12:07:03.000"^^xsd:dateTime .

:c_3065d503 a skos:Concept;
  skos:definition "Quadermauerwerk, bei dem die Vorderseite der Steine einen schmalen      Randschlag      hat, ansonsten aber nur grob behauen ist.  Die Mauerfläche hat ein sehr unregelmäßiges Aussehen. Wegen ihres wehrhaften Charakters finden sich Rustikamauern oft bei Burgen der Stauferzeit und bei Palästen der Frührenaissance. (Glossarium Artis, Bd. 3, Bögen und Mauerwerk)"@de,
    "Quader, deren Ansichtsflächen in der Hauptsache als Bossen unbearbeitet stehen bleiben: unbearbeitete Buckelquader, die in der Regel nur Saum- bzw. Kantenschläge (Randschlag) erhalten. Bereits in antiken Bauten vorkommend, bes. in der ital. Renaissance (Toskana) verbreitet, erhalten bis zum Barock, im Verputz nachgeahmt und im 19./20. Jh. bei Repräsentationsbauten wiederaufgenommen. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_1f14b4dd;
  skos:prefLabel "Buckelquadermauerwerk"@de, "construcción rústica"@es, "opus rusticum"@it,
    "appareil à bossages "@fr, "rusticated  masonry"@en;
  skos:altLabel "bosáž"@cs, "Rustikamauerwerk"@de, "Bossenmauerwerk"@de, "rustika"@cs,
    " rustique"@fr, "opus rusticum"@ko, " rustication"@en;
  skos:broader :c_1514fd0f;
  skos:related :c_8cf58090;
  dct:created "2019-04-10T15:43:17.000"^^xsd:dateTime;
  dct:modified "2020-11-26T15:31:50.000"^^xsd:dateTime .

:c_8cf58090 a skos:Concept;
  skos:definition "Buckelquader, Buckelstein, Bossenquader; Quader, dessen Vorderseite nur roh behauen ist und daher mehr oder weniger stark vorspringt. Um exaktes Versetzen zu ermöglichen, erhalten die B. meist einen schmalen Randschlag mit gerader Kante. [Koepf / Binding 2016]"@de,
    "Quader mit Randschlag und grob bearbeiteter Vorderseite. [Glossarium Artis, Bd. 3, Bögen und Mauerwerk]"@de,
    "Ein vierseitig exakt behauener Quader, dessen Stirnseite bzw. Spiegel mit einem vorspringenden Buckel (»Bosse«; daher auch die synonyme Bezeichnung Bossenquader) versehen ist. Dieser Buckel ist zumeist von einem unterschiedlich breiten Randschlag umsäumt, wobei dieser Randschlag bis ins frühe 13. Jh. zumeist recht schmal ausfiel (3–5 cm Breite), dann aber breiter wurde. Der Buckel konnte unterschiedlich beschaffen sein: sehr roh (»Roh-B.«), sehr prall (»Prall-B.«) oder kissenförmig flach ( »Kissen-B.«). Daneben gibt es noch mehrere Sonderformen von B.n, die nur vereinzelt auftreten wie den Diamant-B. und den Polster-B., die dementsprechend geformte Spiegel aufweisen und bevorzugt während der Renaissance und während des Barock auftreten. Der B. tauchte zuerst gegen 1150, vermehrt dann ab der 2. Hälfte des 12. Jh.s im staufischen Herrschaftsraum sowie in den Kreuzfahrerstaaten auf und gilt als bewusste Reaktivierung eines antiken Bauelementes (der B. ist zumindest seit der Antike in Mittelmeerländern bezeugt). Wehrtechnisch nutzlos, ja sogar eher von Nachteil, lag seine Beliebtheit offenbar darin, dass der Adel im trutzigen, abweisenden, kraftvollen, stolzen Erscheinungsbild des B.-Mauerwerks mehrere Eigenschaften wiederfand, die er für sich selbst gerne in Anspruch nahm. Nach einer kurzen Phase des Bedeutungsrückganges im Laufe des 14. Jh.s kam es ab dem frühen 15. Jh. zu einem starken Wiederaufleben des B.-Mauerwerks. J. Z. [Wörterbuch der Burgen, Schlösser und Festungen]"@de,
    "Bossenquader, Buckelquader; an seiner Vorderseite nur roh bearbeiteter Quader oder Werkstein. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_84fc24e6,
    :conceptScheme_50ec0c5e, :conceptScheme_1f14b4dd, :conceptScheme_1d7ba54b;
  skos:prefLabel "carreau à bossage"@fr, "quarry-faced ashlar"@en, "Buckelquader"@de,
    "sillar almohadillado"@es;
  skos:altLabel "Bossenquader"@de, "Buckelstein"@de;
  skos:broader :c_0a02c60b;
  skos:narrower :c_604a31da, :c_24be091e;
  skos:related :c_3065d503, :c_3d90652a;
  dct:created "2019-07-15T13:09:42.000"^^xsd:dateTime;
  dct:modified "2021-01-27T16:09:59.000"^^xsd:dateTime;
  :broaderByProcessing :c_0a02c60b .

