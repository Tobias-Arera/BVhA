  skos:related :c_30831661;
  dct:created "2020-06-18T15:52:05.000"^^xsd:dateTime;
  dct:modified "2021-01-24T15:57:58.000"^^xsd:dateTime .

:c_9e7a3fc9 a skos:Concept;
  skos:definition "Mittelstück n, substratorium: als Unterlage für das Korporale dienendes, reich verziertes Tuch, das oft mit einer Darstellung der Kreuzigung oder des Lammes Gottes bestickt ist; früher in einigen Gegenden Deutschlands gebräuchlich. [Glossarium Artis]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_57be8ee8,
    :conceptScheme_1f14b4dd;
