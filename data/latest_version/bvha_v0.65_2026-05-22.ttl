:c_c8b79707 a skos:Concept;
  skos:definition "Tuskische Ordnung, etruskische Ordnung, eine der Römisch-dorischen Ordnung ähnl. antike Säulenordnung der Römer, deren Schaft oft keine Kanneluren, aber eine Basis hat. Unter dem Echinus liegt ein Halsring. Die Eck Triglyphen sind achsial auf die Ecksäulen bezogen, die Mutuli entfallen, während zusätzl. noch ein Zahnschnitt angeordnet sein kann. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_84fc24e6;
  skos:prefLabel "Toskanische Säulenordnung"@de, "orden arquitectónico toscano"@es,
    "ordine architettonico toscano"@it, "ordre toscan"@fr, "Tuscan order"@en;
  skos:altLabel "Tuskische Säulenordnung"@de;
  skos:broader :c_c80851cf;
  dct:created "2020-08-05T16:38:04.000"^^xsd:dateTime;
  dct:modified "2021-01-15T17:54:25.000"^^xsd:dateTime .

:c_0d3691e6 a skos:Concept;
  skos:definition "Französische Ordnung (frz. Säulenordnung), von dem frz. Baumeister und Architekturtheoretiker der Renaissance, Philibert Delorme, erfundene und zuerst praktizierte Manier, die Säulenschäfte mit breiten Rustikaringen zu gliedern oder sie aus verschieden ornamentierten Trommeln zusammenzusetzen. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8, :conceptScheme_84fc24e6;
  skos:prefLabel "Französische Ordnung"@de;
  skos:broader :c_c80851cf;
  dct:created "2020-09-25T10:52:07.000"^^xsd:dateTime;
  dct:modified "2021-01-15T17:51:48.000"^^xsd:dateTime .

:c_a2b9a729 a skos:Concept;
  skos:definition "Modifizierte gr. Dorische Ordnung, deren Säulen eine Basis und unter dem Echinus einen Halsring haben. Der R.-d. 0. ist die toskan. Ordnung ähnlich. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_57be8ee8;
  skos:prefLabel "Römisch Dorische Ordnung"@de;
  skos:broader :c_c80851cf;
  dct:created "2020-10-25T14:17:00.000"^^xsd:dateTime;
  dct:modified "2021-01-15T17:53:35.000"^^xsd:dateTime .

