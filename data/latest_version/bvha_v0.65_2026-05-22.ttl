:c_7e274bd7 a skos:Concept;
  skos:scopeNote "Skříň má na pravé i na levé straně křídla. Skříň, křídla a většinou i predela bývaly vybaveny řezbami (vyřezávaný oltář) nebo malbami. [Koch 2008]"@cs,
    "Zentraler Teil des Flügelretabels. Gliedert sich von unten nach oben in Fries, Gefach mit als Schnitzereien ausgeführten szenischen Darstellungen und Maßwerk. Größere Retabel können mehrere Gefache enthalten, die in verschiedene Register aufgegliedert sind. [Gliesmann 2011] "@de,
    "Altarschrein, hölzerner, kastenförmiger Mittelteil eines Flügelaltars. [Koepf / Binding 2016]"@de,
    "Schrein, hölzerner Behälter. Der Begriff wird vornehml. für bestimmte Behälter (Reliquiens., Heiligens., Kastenaltar), v. a. aber für den s.artigen Mittelteil eines Flügelaltars verwandt. [Koepf / Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ede8e468, :conceptScheme_ea998ebe,
    :conceptScheme_84fc24e6, :conceptScheme_37522b74, :conceptScheme_9fcb19ed;
