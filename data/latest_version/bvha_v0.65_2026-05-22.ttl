:c_166e8d32 a skos:Concept;
  skos:definition "Kehlriegel: Riegel im Querbund zwischen den geschossunterteilenden Balken, zu den Sparren verlaufend.  (Eißing et al. 2012) "@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe;
  skos:prefLabel "Kehlriegel"@de;
  skos:broader :c_45590240;
  skos:narrower :c_4ad18c80;
