:c_419c7510 a skos:Concept;
  skos:definition "Meist als Säulenarkade ausgebildete kleine Arkade an Zwerggalerien, den Laufgängen in der Mauer unter der Dachtraufe romanischer Kirchen. [Glossarium Artis]"@de,
    "TRPASLIČÍ ARKÁDY, naproti tomu vytvářejí chodbu pod hlavní římsou románských chórů, tzv.: trpasličí galerii. [Koch 2008]"@cs;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_37522b74,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "arcade de petite echelle"@fr, "dwarf arcade"@en, "Zwergarkade"@de,
    "trpasličí arkáda"@cs;
  skos:altLabel "small-scale arcade"@en;
  skos:broader :c_b38a6b54;
  dct:created "2019-10-22T10:54:08.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:06:34.000"^^xsd:dateTime .

:c_089caa1e a skos:Concept;
  skos:definition "1857 von H. Otte als Galerie mit kleinen (Zwerg-) Säulen in die kunstwissenschaftl. Literatur eingeführt, unter der Traufe herumgeführter Laufgang, der sich in Säulenarkaden, auch zwischen Pfeilern oder Mauerresten, öffnet und mit einer Längstonne (niederrhein. Z.) oder mit Quertonnen (ital.oberrhein. Z.) überdeckt ist. Am Niederrhein stehen die Säulen auf einer Brüstungsmauer, die außen einen Plattenfries tragen kann. [Koepf/Binding 2016]"@de;
  skos:inScheme :conceptScheme_7816b346, :conceptScheme_ea998ebe, :conceptScheme_37522b74,
    :conceptScheme_1f14b4dd;
  skos:prefLabel "ga!erie naine"@fr, "trpasličí galerie"@cs, "dwarf gallery"@en, "galleria ad arcatelle"@it,
    "galería con columnas enanas"@es, "Zwerggalerie"@de;
  skos:broader :c_b38a6b54;
  dct:created "2020-08-03T12:23:09.000"^^xsd:dateTime;
  dct:modified "2021-01-22T16:06:45.000"^^xsd:dateTime .

